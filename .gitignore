# Compiled bytecode. These are build artifacts produced by build_libs.sh, and
# release builds are Ed25519-signed - committing them would put signed binaries
# in history against a key that rotates. Build them locally, or download the
# published ones from https://www.flaris-lang.org
*.flx

# Build script output
libs/manifest.txt

# Native FFI plugins
*.so
*.dylib
*.dll
*.o

# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Python bytecode (test tooling)
__pycache__/
*.pyc
