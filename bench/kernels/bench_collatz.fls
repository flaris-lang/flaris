// bench_collatz.fls - total Collatz steps for n=1..1,000,000
// Use >> 1 for division by 2 to stay in integer domain (/ always returns float)
fn collatzSteps(n: int): int {
    let steps = 0;
    let x = n;
    while (x != 1) {
        if (x % 2 == 0) {
            x = x >> 1;
        } else {
            x = x * 3 + 1;
        }
        steps++;
    }
    return steps;
}

fn Main() {
    let N = 1_000_000;
    let start = Time.Millis();
    let total = 0;
    iter(n from 1 to N) {
        total += collatzSteps(n);
    }
    let elapsed = Time.Millis() - start;
    Console.WriteLine("result: ", total);
    Console.WriteLine("elapsed: ", elapsed, " ms");
    return 0;
}
