// bench_tailcall.fls - self-recursive tail call, depth 2,000,000
//
// Typed so the JIT can compile it. The JIT compiles a self-recursive tail
// call to a native loop-back branch (no call instruction, no native stack
// growth); the interpreter reuses the call frame instead. Both handle this
// depth with no bound.
fn tailsum(n: int, acc: int): int {
    if (n == 0) return acc;
    return tailsum(n - 1, acc + n);
}

fn Main() {
    let n = 2000000;
    let start = Time.Millis();
    let result = tailsum(n, 0);
    let elapsed = Time.Millis() - start;
    Console.WriteLine("result: ", result);
    Console.WriteLine("elapsed: ", elapsed, " ms");
    return 0;
}
