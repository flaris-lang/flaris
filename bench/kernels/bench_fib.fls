// bench_fib.fls - recursive Fibonacci, n=38
fn fib(n: int): int {
    if (n <= 1) return n;
    return fib(n - 1) + fib(n - 2);
}

fn Main() {
    let n = 38;
    let start = Time.Millis();
    let result = fib(n);
    let elapsed = Time.Millis() - start;
    Console.WriteLine("result: ", result);
    Console.WriteLine("elapsed: ", elapsed, " ms");
    return 0;
}
