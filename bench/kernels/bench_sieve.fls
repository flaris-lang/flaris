// bench_sieve.fls - Sieve of Eratosthenes, N=10,000,000
fn sieveCount(N: int): int {
    let flags: block = Buffer.Create(N + 1, 1);
    Buffer.Fill(flags, 1);

    let pMax = int(Math.Floor(Math.Sqrt(N)));

    iter(p from 2 to pMax + 1) {
        if (flags[p] == 1) {
            let i = p * p;
            while (i <= N) {
                flags[i] = 0;
                i += p;
            }
        }
    }

    let count = 0;
    iter(j from 2 to N) {
        if (flags[j] == 1) count++;
    }
    // N itself (10M) is not prime, so iter(j from 2 to N) gives j=2..N-1 = correct
    return count;
}

fn Main() {
    let N = 10_000_000;
    let start = Time.Millis();
    let count = sieveCount(N);
    let elapsed = Time.Millis() - start;
    Console.WriteLine("result: ", count);
    Console.WriteLine("elapsed: ", elapsed, " ms");
    return 0;
}
