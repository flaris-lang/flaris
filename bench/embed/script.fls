// The same script in every language: a top level that does real work, a getter
// so the host can prove the top level ran, and one cheap function for the
// per-call scenario. Update() is deliberately trivial - the point is to measure
// the host->script boundary, not the body.
fn Sum(n: int): int {
    let s: int = 0;
    for (let i: int = 1; i <= n; i++) { s = s + i; }
    return s;
}

global total: int = Sum(1000);

fn Total(): int { return total; }
fn Update(n: int): int { return n + 1; }
