// bench_method.fls - method calls on an instance, 6M of them.
// Dominated by finding and calling the method, not by the work inside it.
class Vec {
    var x = 0;
    var y = 0;
    fn Constructor(x, y) { this.x = x; this.y = y; }
    fn AddX(d: int) { this.x = this.x + d; }
    fn Dot(): int { return this.x * this.y; }
}
fn Main() {
    let v = new Vec(1, 3);
    let n = 6000000;
    let start = Time.Millis();
    let total = 0;
    for (let i = 0; i < n; i++) {
        v.AddX(1);
        total = total + v.Dot();
    }
    let elapsed = Time.Millis() - start;
    Console.WriteLine("result: ", total);
    Console.WriteLine("elapsed: ", elapsed, " ms");
    return 0;
}
