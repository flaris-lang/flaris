// bench_spectralnorm.fls - spectral norm of the infinite matrix A, size 800.
// Dominated by float multiply-adds in nested loops over float arrays, and the
// integer arithmetic that computes each element of A.
// Algorithm from The Computer Language Benchmarks Game, 10 power iterations of
// u = AtA v. result = round(sqrt(vBv / vv) * 1e9).
fn evalA(i: int, j: int): float {
    return 1.0 / ((i + j) * (i + j + 1) / 2 + i + 1);
}

fn mulAv(n: int, v: [float], av: [float]) {
    iter (i from 0 to n) {
        let s = 0.0;
        iter (j from 0 to n) {
            s += evalA(i, j) * v[j];
        }
        av[i] = s;
    }
}

fn mulAtv(n: int, v: [float], atv: [float]) {
    iter (i from 0 to n) {
        let s = 0.0;
        iter (j from 0 to n) {
            s += evalA(j, i) * v[j];
        }
        atv[i] = s;
    }
}

fn mulAtAv(n: int, v: [float], atav: [float], tmp: [float]) {
    mulAv(n, v, tmp);
    mulAtv(n, tmp, atav);
}

fn spectralNorm(n: int): float {
    let u = Array.Create(n, Type.Float);
    let v = Array.Create(n, Type.Float);
    let tmp = Array.Create(n, Type.Float);
    iter (i from 0 to n) {
        u[i] = 1.0;
    }
    iter (k from 0 to 10) {
        mulAtAv(n, u, v, tmp);
        mulAtAv(n, v, u, tmp);
    }
    let vBv = 0.0;
    let vv = 0.0;
    iter (i from 0 to n) {
        vBv += u[i] * v[i];
        vv += v[i] * v[i];
    }
    return Math.Sqrt(vBv / vv);
}

fn Main() {
    let n = 800;
    let start = Time.Millis();
    let norm = spectralNorm(n);
    let result = Math.Round(norm * 1e9);
    let elapsed = Time.Millis() - start;
    Console.WriteLine("result: ", result);
    Console.WriteLine("elapsed: ", elapsed, " ms");
    return 0;
}
