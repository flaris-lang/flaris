// bench_fannkuch.fls - fannkuch-redux over every permutation of 10 elements.
// Dominated by small integer-array reads, writes and swaps in short inner loops.
// Algorithm from The Computer Language Benchmarks Game: permutations in its
// rotation order, checksum = sum of the flip counts with the sign alternating per
// permutation index. result = checksum * 1000 + max flips.
fn fannkuch(n: int): int {
    let perm1 = Array.Create(n, Type.Int);
    let perm = Array.Create(n, Type.Int);
    let count = Array.Create(n, Type.Int);
    iter (i from 0 to n) {
        perm1[i] = i;
    }
    let maxFlips = 0;
    let checksum = 0;
    let sign = 1;
    let r = n;
    while (true) {
        while (r != 1) {
            count[r - 1] = r;
            r--;
        }
        iter (i from 0 to n) {
            perm[i] = perm1[i];
        }
        let flips = 0;
        let k = perm[0];
        while (k != 0) {
            let i = 0;
            let j = k;
            while (i < j) {
                let t = perm[i];
                perm[i] = perm[j];
                perm[j] = t;
                i++;
                j--;
            }
            flips++;
            k = perm[0];
        }
        if (flips > maxFlips) {
            maxFlips = flips;
        }
        checksum += sign * flips;
        sign = -sign;
        // Next permutation: rotate the first r + 1 elements left by one; when that
        // brings a prefix back to its start, move on to a longer prefix.
        while (true) {
            if (r == n) {
                return checksum * 1000 + maxFlips;
            }
            let first = perm1[0];
            iter (i from 0 to r) {
                perm1[i] = perm1[i + 1];
            }
            perm1[r] = first;
            count[r] -= 1;
            if (count[r] > 0) {
                break;
            }
            r++;
        }
    }
}

fn Main() {
    let n = 10;
    let start = Time.Millis();
    let result = fannkuch(n);
    let elapsed = Time.Millis() - start;
    Console.WriteLine("result: ", result);
    Console.WriteLine("elapsed: ", elapsed, " ms");
    return 0;
}
