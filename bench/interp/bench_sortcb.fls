// bench_sortcb.fls - sort 120k ints, 6 times, through a comparator written in
// the language. Every comparison is a user-level function call, so call cost
// weighs as heavily as the sort itself.
fn Main() {
    let n = 120000;
    let base = Array.Create(n, Type.Int);
    let seed = 12345;
    for (let i = 0; i < n; i++) {
        seed = (seed * 48271) % 2147483647;
        base[i] = seed % 1000000;
    }
    let start = Time.Millis();
    let total = 0;
    for (let pass = 0; pass < 6; pass++) {
        let arr = Array.Clone(base);
        Array.Sort(arr, fn(a, b) { return a < b; });
        total = total + arr[0] + arr[n - 1];
    }
    let elapsed = Time.Millis() - start;
    Console.WriteLine("result: ", total);
    Console.WriteLine("elapsed: ", elapsed, " ms");
    return 0;
}
