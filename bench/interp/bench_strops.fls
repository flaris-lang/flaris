// bench_strops.fls - split a CSV line, search it and re-join, 120k times.
// Dominated by the standard library's string routines.
fn Main() {
    let line = "alpha,beta,gamma,delta,epsilon,zeta,eta,theta";
    let n = 120000;
    let start = Time.Millis();
    let total = 0;
    for (let i = 0; i < n; i++) {
        let parts = String.Split(line, ",");
        total = total + len(parts);
        if (String.IndexOf(line, "delta") >= 0) { total = total + 1; }
        let joined = String.Join(parts, "|");
        total = total + String.Length(joined);
    }
    let elapsed = Time.Millis() - start;
    Console.WriteLine("result: ", total);
    Console.WriteLine("elapsed: ", elapsed, " ms");
    return 0;
}
