// bench_matmul.fls - 220x220 integer matrix multiply.
// Dominated by nested loops and two-dimensional indexing (`b[k][j]`).
fn Main() {
    let n = 220;
    let a = [];
    let b = [];
    for (let i = 0; i < n; i++) {
        let ra = Array.Create(n, Type.Int);
        let rb = Array.Create(n, Type.Int);
        for (let j = 0; j < n; j++) {
            ra[j] = (i + j) % 7;
            rb[j] = (i * j) % 5;
        }
        Array.Append(a, ra);
        Array.Append(b, rb);
    }
    let start = Time.Millis();
    let total = 0;
    for (let i = 0; i < n; i++) {
        let ai = a[i];
        for (let j = 0; j < n; j++) {
            let s = 0;
            for (let k = 0; k < n; k++) {
                s = s + ai[k] * b[k][j];
            }
            total = total + s;
        }
    }
    let elapsed = Time.Millis() - start;
    Console.WriteLine("result: ", total);
    Console.WriteLine("elapsed: ", elapsed, " ms");
    return 0;
}
