// bench_dict.fls - string-keyed map: build 200k entries, then look every key up
// three times. Dominated by string hashing and map lookup.
fn Main() {
    let n = 200000;
    let keys = [];
    for (let i = 0; i < n; i++) { Array.Append(keys, "key" + i); }
    let start = Time.Millis();
    let m = {};
    for (let i = 0; i < n; i++) { m[keys[i]] = i; }
    let total = 0;
    for (let pass = 0; pass < 3; pass++) {
        for (let i = 0; i < n; i++) { total = total + m[keys[i]]; }
    }
    let elapsed = Time.Millis() - start;
    Console.WriteLine("result: ", total);
    Console.WriteLine("elapsed: ", elapsed, " ms");
    return 0;
}
