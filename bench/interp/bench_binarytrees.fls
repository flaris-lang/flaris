// bench_binarytrees.fls - build and walk many short-lived tree nodes.
// Dominated by how cheaply the language creates and discards small objects.
class Node {
    var l = nil;
    var r = nil;
    fn Constructor(l, r) { this.l = l; this.r = r; }
}

fn bottomUp(d: int): Node {
    if (d <= 0) { return new Node(nil, nil); }
    return new Node(bottomUp(d - 1), bottomUp(d - 1));
}

fn check(n: Node): int {
    if (n.l == nil) { return 1; }
    return 1 + check(n.l) + check(n.r);
}

fn Main() {
    let maxDepth = 16;
    let start = Time.Millis();
    let total = 0;
    let d = 4;
    while (d <= maxDepth) {
        let iters = 1 << (maxDepth - d + 4);
        let i = 0;
        while (i < iters) {
            total = total + check(bottomUp(d));
            i++;
        }
        d = d + 2;
    }
    let elapsed = Time.Millis() - start;
    Console.WriteLine("result: ", total);
    Console.WriteLine("elapsed: ", elapsed, " ms");
    return 0;
}
