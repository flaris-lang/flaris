// bench_knucleotide.fls - k-nucleotide frequencies of a 2,000,000-base DNA string:
// every substring of length 1, 2, 3, 4, 6, 12 and 18 counted in a string-keyed
// map, then five fixed sequences looked up. Dominated by substring creation,
// string hashing and map update. Algorithm from The Computer Language
// Benchmarks Game; the input comes from an integer generator so that every
// language builds the same string.
// result = (r * 31 + v) % 1000000007 folded over the number of distinct keys
// for each length and the count of each fixed sequence.
const MOD = 1000000007;

fn dna(n: int): string {
    let bases = "ACGT";
    let parts = [];
    let seed = 42;
    iter (i from 0 to n) {
        seed = (seed * 3877 + 29573) % 139968;
        Array.Append(parts, bases[seed * 4 / 139968]);
    }
    return String.Join(parts, "");
}

fn count(seq: string, k: int): object {
    let counts = {};
    iter (i from 0 to String.Length(seq) - k + 1) {
        let key = String.Substr(seq, i, k);
        counts[key] = (counts[key] ?? 0) + 1;
    }
    return counts;
}

fn Main() {
    let seq = dna(2000000);
    let queries = ["GGT", "GGTA", "GGTATT", "GGTATTTTAATT", "GGTATTTTAATTTATAGT"];
    let start = Time.Millis();
    let r = 0;
    r = (r * 31 + Object.Count(count(seq, 1))) % MOD;
    r = (r * 31 + Object.Count(count(seq, 2))) % MOD;
    foreach (q in queries) {
        let counts = count(seq, String.Length(q));
        r = (r * 31 + Object.Count(counts)) % MOD;
        r = (r * 31 + (counts[q] ?? 0)) % MOD;
    }
    let elapsed = Time.Millis() - start;
    Console.WriteLine("result: ", r);
    Console.WriteLine("elapsed: ", elapsed, " ms");
    return 0;
}
