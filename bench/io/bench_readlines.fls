// Count lines and bytes, one line at a time. See bench_readlines.c for the
// result fold. ReadLine strips the terminator, so it is added back.
fn Main(): int {
    let t0 = Time.Ticks();
    let h = Stream.Open("io_input.txt", "r");
    var lines: int = 0;
    var total: int = 0;
    var line = Stream.ReadLine(h);
    while (line != nil) {
        lines = lines + 1;
        total = total + len(line) + 1;
        line = Stream.ReadLine(h);
    }
    Stream.Close(h);
    let ms = Time.TicksToMs(Time.Ticks() - t0);
    Console.WriteLine("result: " + (lines * 100000000 + total));
    Console.WriteLine("elapsed: " + Math.Round(ms));
    return 0;
}
