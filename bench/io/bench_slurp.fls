// Read the whole file into memory. See bench_slurp.c for what this measures.
fn Main(): int {
    let t0 = Time.Ticks();
    let data = File.ReadText("io_input.txt");
    let ms = Time.TicksToMs(Time.Ticks() - t0);
    Console.WriteLine("result: " + len(data));
    Console.WriteLine("elapsed: " + Math.Round(ms));
    return 0;
}
