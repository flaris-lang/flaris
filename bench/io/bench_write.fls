// Write a million formatted lines. See bench_write.c for what this measures.
fn Main(): int {
    let LINES = 1000000;
    let t0 = Time.Ticks();
    let f = Stream.Open("io_out_fls.txt", "w");
    iter (i from 0 to LINES) {
        Stream.WriteString(f, "" + i + " payload " + (i * 7 % 9973) + "\n");
    }
    Stream.Close(f);
    let ms = Time.TicksToMs(Time.Ticks() - t0);
    let size = File.Size("io_out_fls.txt");
    File.Delete("io_out_fls.txt");
    Console.WriteLine("result: " + size);
    Console.WriteLine("elapsed: " + Math.Round(ms));
    return 0;
}
