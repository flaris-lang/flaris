# Compiled benchmark binaries - rebuilt by the runners
bench_*_c
bench_*_rs
bench_*_go
bench_*_nim
nimcache/
csout_*/

# Generated benchmark input - recreated deterministically by the generators
realworld/bench_data.json
realworld/bench_corpus.txt
io/io_input.txt

# Output files the write benchmark produces and removes; listed so an
# interrupted run does not leave them staged.
io/io_out_*.txt
