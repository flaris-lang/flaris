// bench_json.fls - parse an 18 MB JSON array of 300k records, ITERS times,
// summing every record's value field. Exercises Json.Parse + object field
// access. File read is outside the timed region.
fn Main() {
    let text = File.ReadText("bench_data.json");
    let ITERS = 5;

    let start = Time.Millis();
    let total = 0;
    iter(k from 1 to ITERS) {
        let arr = Json.Parse(text);
        foreach (rec in arr) {
            total += rec.value;
        }
    }
    let elapsed = Time.Millis() - start;

    Console.WriteLine("result: ", total);
    Console.WriteLine("elapsed: ", elapsed, " ms");
    return 0;
}
