// bench_strbuild.fls - build a large string by naive s += piece, N times.
// This is the exact pattern str_append_in_place turned from O(n^2) into O(n):
// no StringBuilder, just the obvious code. result is the final byte length.
fn Main() {
    let N = 1_000_000;

    let start = Time.Millis();
    let s = "";
    iter(i from 0 to N - 1) {
        s += "item_" + i + ";";
    }
    let result = len(s);
    let elapsed = Time.Millis() - start;

    Console.WriteLine("result: ", result);
    Console.WriteLine("elapsed: ", elapsed, " ms");
    return 0;
}
