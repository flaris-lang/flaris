// bench_regex.fls - scan a 9.8 MB corpus for YYYY-MM-DD dates, SCANS times,
// counting all matches. Every 3rd line holds a real date; the rest are
// single-digit-month decoys that force the engine to advance past near-misses.
// File read is outside the timed region.
fn Main() {
    let text = File.ReadText("bench_corpus.txt");
    let SCANS = 5;
    let pattern = "\\b\\d{4}-\\d{2}-\\d{2}\\b";

    let start = Time.Millis();
    let total = 0;
    iter(k from 1 to SCANS) {
        let m = Regex.Matches(text, pattern);
        total += len(m);
    }
    let elapsed = Time.Millis() - start;

    Console.WriteLine("result: ", total);
    Console.WriteLine("elapsed: ", elapsed, " ms");
    return 0;
}
