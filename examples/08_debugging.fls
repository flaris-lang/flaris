//
// Demonstrates breakpoint-based debugging. Run with -v for more output, and with --unsafe to access memory

fn computeSum(n) {
    let sum = 0;

    for (let i = 0; i < n; i += 1) {
        if (i == 3) {
            // We want to inspect execution exactly here
            breakpoint 300;
        }
        sum += i;
    }

    return sum;
}

fn Main() {
    let result = computeSum(5);
    Console.WriteLine("Result:", result);

    // Example of how to trigger on a read/write on a specific address
    let buffer = Buffer.Create(1,1);
    let baddr = Buffer.GetAddress(buffer);
    Debug.GuardAddress(baddr);
    Memory.Read8(baddr); // Triggers read on guarded address. Execution halts, then adress guarding is reset


    return;
}