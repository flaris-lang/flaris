// 12_import_example.fls
// Demonstrates importing a compiled module
// Needs to compile ./flarisvm --compile ./examples/11_math_utils.fls ./examples/11_math_utils.flx
// or flarisvm --compile 11_math_utils.fls 11_math_utils.flx  if installed and in examples folder


// Or for static linking, whith library bundled into the binary: 
// ./flarisvm --compile ./examples/12_import_example.fls ./examples/12_import_example.flx  --bundle='./examples/11_math_utils.flx'

import { MathUtils } from library("11_math_utils", "1.0");

fn Main()
{
    let v: int = 7;

    let sq: int = MathUtils.square(v);
    let even: bool = MathUtils.isEven(v);

    Console.WriteLine("v     =", v);
    Console.WriteLine("square=", sq);
    Console.WriteLine("isEven=", even);

    return;
}
