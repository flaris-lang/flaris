// 10_error_handling_guard.fls
// Demonstrates nil-safety, guard(), and try/catch

fn getUserName(user: object|nil): string
{
    // guard enforces a required value
    let u: object = guard(user);
    let name: string = guard(u.name);
    return name;
}

fn Main()
{
    let user1: object = { name: "Ada" };
    let user2: object|nil = nil;

    // Safe call
    let name1: string = getUserName(user1);
    Console.WriteLine("user1 =", name1);

    // Failing call, caught explicitly
    try {
        let name2: string = getUserName(user2);
        Console.WriteLine("user2 =", name2);
    } catch (err) {
        Console.WriteLine("Caught error:", err.Error);
    } finally {
        Console.WriteLine("Cleaning up");
    }

    return;
}
