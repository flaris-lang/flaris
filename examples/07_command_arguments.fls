fn Main()
{
    Console.WriteLine("Test by providing different arguments after filename, also test the argument-value-parser by adding argument --test=<value>");
    let args = Os.Args();
    for(let i = 0; i < len(args); i++)
    {
        Console.WriteLine("Argument ", i, " = ", args[i]);
    }

    // Check if --test was provided with a value, syntax --test=<value>
    var def = Os.GetArgValue("--test", "default");
    Console.WriteLine("--test = ", def);

    return;
}