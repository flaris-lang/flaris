// 04_files_hash_integrity.fls
// Write a file, read it back, and verify its SHA-256 against a known digest.

const PATH: string = "example04_hash_temp.txt";
const CONTENT: string = "hello";
// SHA-256 of "hello"
const EXPECTED: string = "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824";

fn Main()
{
    // Create our own fixture so the example is self-contained.
    File.WriteText(PATH, CONTENT);

    let text: string = File.ReadText(PATH);
    Console.WriteLine("bytes=", len(text));

    // SHA-256 over the full file contents.
    let digest: string = Hash.Sha256(text);
    Console.WriteLine("sha256=", digest);

    if (digest == EXPECTED) {
        Console.WriteLine("OK - integrity verified");
    } else {
        Console.Warn("Hash mismatch for ", PATH);
    }

    File.Delete(PATH); // clean up the file this example created
    return;
}
