const PLUGIN_PATH = "./plugin.so";
const PLUGIN_SHA  = "...sha256...";

fn onData(value, label) {
    Console.WriteLine("callback: ", value, " ", label);
    return value * 2;
}

fn onChunk(checksum, bytes) {
     Console.WriteLine("chunk processed: ", bytes, " bytes, checksum=", checksum);
}

 fn Main() {
     let lib = Ffi.Load(PLUGIN_PATH, PLUGIN_SHA);

     Ffi.SetCallback(lib, "ondata",  onData);
     Ffi.SetCallback(lib, "onchunk", onChunk);

     let add          = Ffi.GetFunction(lib, "ffi_add");
     let greet        = Ffi.GetFunction(lib, "ffi_greet");
     let sum_block    = Ffi.GetFunction(lib, "ffi_sum_block");
     let make_pair    = Ffi.GetFunction(lib, "ffi_make_pair");
     let trigger      = Ffi.GetFunction(lib, "ffi_trigger");
     let process_blk  = Ffi.GetFunction(lib, "ffi_process_block");

     Console.WriteLine(add(10, 32));            // 42
     Console.WriteLine(greet("Flaris"));        // Hello, Flaris!
     Console.WriteLine(make_pair(7, 3.14));     // [7, 3.14]

     let buf = Buffer.Create(4,4);              // 4 float32 slots
     let addr = Buffer.GetAddress(buf);
     Memory.WriteFloat32(addr, 1.5, 0);
     Memory.WriteFloat32(addr, 2.5, 4);
     Memory.WriteFloat32(addr, 3.0, 8);
     Memory.WriteFloat32(addr, 4.0, 12);
     Console.WriteLine("Sum-test");
  
     Console.WriteLine(sum_block(buf));         // 11.0

     Console.WriteLine(trigger(99));            // fires onData(99, "processed") - 198
     Console.WriteLine(process_blk(buf));       // fires onChunk(checksum, 16) - 16

    // Check before calling
    if (Ffi.HasFunction(lib, "ffi_sum_block")) {
        Console.WriteLine("Library contains function 'ffi_sum_block'");
    }

    // One-off call - no intermediate object
    Debug.Assert( Ffi.Call(lib, "ffi_add", 10, 32), 42);

    let ver = Ffi.GetVersion(lib);
    Console.WriteLine("Library version: ", ver);

 }