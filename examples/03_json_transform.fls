// 03_json_transform.fls

fn encodeValue(v: any): string
{
    if (v == nil)   return "null";
    if (v == true)  return "true";
    if (v == false) return "false";

    // strings need basic escaping
    if (type(v) == Type.String ){
        let s: string = str(v);
        s = s.Replace("\\", "\\\\");
        s = s.Replace("\"", "\\\"");
        s = s.Replace("\n", "\\n");
        return "\"" + s + "\"";
    }

    if (type(v) == Type.Int || type(v) == Type.Float) {
        return str(v);
    }

    // array
    if (type(v) == Type.Array) {
        let out: string = "[";
        let i: int = 0;

        while (i < len(v)) {
            if (i > 0) out = out + ",";
            out = out + encodeValue(v[i]);
            i += 1;
        }

        return out + "]";
    }

    // object
    if (type(v) == Type.Object) {
        let out: string = "{";
        let entries: array = Object.Entries(v); // [[key, value], ...]
        let i: int = 0;

        while (i < len(entries)) {
            if (i > 0) out = out + ",";
            let kv: array = entries[i];
            let k: any = kv[0];
            let val: any = kv[1];
            out = out + encodeValue(k) + ":" + encodeValue(val);
            i += 1;
        }

        return out + "}";
    }

    // fallback
    return "\"<unsupported>\"";
}

global src: string = """
{
  "users": [
    {"id": 1, "name": "Ada", "active": true},
    {"id": 2, "name": "Bob", "active": false}
  ]
}
""";

fn Main()
{
    let doc: object = Json.Parse(src);
    Console.WriteLine(doc);
    Console.WriteLine("");

    // Transform: keep only active users, add "tag"
    let users: array = doc.users;

    // Anonymous functions cannot be typed yet
    let active: array = users.Where(fn(u) {
        return u.active;
    });

    Console.WriteLine("Active = ", active);

    let tagged: array = active.Select(fn(u) {
        u.tag = "active-user";
        return u;
    });

    let out: object = { ts: tagged };
    out.users = tagged;

    Console.WriteLine("Out = ", out);
    Console.WriteLine("Enc = ", encodeValue(out));
    Console.WriteLine("Done");

    return;
}
