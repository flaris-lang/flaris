// 09_switch_and_control_flow.fls
// Demonstrates switch/case semantics and fallthrough

fn classifyScore(score: int): string
{
    switch (score) {
        case 10:
            return "perfect";

        case 9:
        case 8:
            // fallthrough on purpose
            return "great";

        case 7:
        case 6:
            return "ok";

        default:
            return "needs work";
    }

    return "";
}

fn Main()
{
    let scores: array = [10, 9, 7, 3];

    foreach (s in scores) {
        let label: string = classifyScore(s);
        Console.WriteLine("score=", s, " => ", label);
    }

    return;
}
