// 05_classes_reflection.fls

class Animal
{
    let name = nil;
    fn Constructor(name: string)
    {
        this.name = name;
    }

    fn Speak(): string
    {
        return this.name + " makes a noise";
    }

    fn static Kind(): string
    {
        return "animal";
    }
}

class Dog : Animal
{
    fn Speak(): string
    {
        return this.name + " barks";
    }

    fn static Kind(): string
    {
        return "dog";
    }
}

// Resource class demonstrating Destructor.
// Destructor is called automatically when the last reference is released.
class TempBuffer
{
    let buf = nil;
    let size = nil;
    fn Constructor(size: int)
    {
        this.buf = Memory.Alloc(size);
        this.size = size;
        Console.WriteLine("TempBuffer allocated, size=", size);
    }

    fn Destructor()
    {
        Memory.Free(this.buf);
        Console.WriteLine("TempBuffer freed, size=", this.size);
    }
}

fn allocAndFree()
{
    let buf: instance = new TempBuffer(256);
    // buf is freed here when allocAndFree returns
}

fn Main()
{
    let a: instance = new Animal("Mimi");
    let d: instance = new Dog("Rex");

    Console.WriteLine(a.Speak());
    Console.WriteLine(d.Speak());
    Console.WriteLine(Animal.Kind(), " ", Dog.Kind());

    // Reflection helpers
    let dogName: string = Class.Name(Dog);
    Console.WriteLine("Dog name=", dogName);

    let isDog: bool = Class.InstanceOf(d, Dog);
    Console.WriteLine("d is Dog=", isDog);

    let isSubclass: bool = Class.SubclassOf(Dog, Animal);
    Console.WriteLine("Dog <: Animal =", isSubclass);

    // Dynamic call (string-based dispatch)
    // Invoke is inherently dynamic => 'any' is the honest type for the result.
    let speakResult: any = Class.Invoke(d, "Speak");
    Console.WriteLine(speakResult);

    let kindResult: any = Class.Invoke(Dog, "Kind");
    Console.WriteLine(kindResult);

    // Destructor demo: buf is released when the function returns
    allocAndFree();
    // "TempBuffer freed" is printed before this line

    return;
}
