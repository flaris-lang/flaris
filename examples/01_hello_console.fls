// 01_hello_console.fls
import { Logger } from library("Logger", "1.0");

fn Main()
{
    Console.WriteLine("Hello, Flaris!");

    var name: string = "Ada";
    var n: int = 3;
    
    Console.WriteLine("name=", name, " n=", n);

    // Expressions vs statements:
    // (x = 1) is a statement in Flaris, not an expression.
    let x: int = 10;
    x = x + 1;
    Console.WriteLine("x=", x);

    // Truthiness: nil and false are falsy, everything else truthy
    let v: nil = nil;
    if (v) {
        Console.WriteLine("won't print");
    } else {
        Console.WriteLine("nil is falsy");
    }

    var logger = new Logger();
    logger.Info("This is an info message");
    logger.Warn("This is a warning");
    logger.Error("This is an error");
    logger.Info("Example done");

    return;
}
