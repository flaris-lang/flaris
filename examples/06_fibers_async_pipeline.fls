// 06_fibers_async_pipeline.fls

fn worker(label: string, count: int): string
{
    let i: int = 0;

    while (i < count) {
        Console.WriteLine(label, " step ", i);
        yield i;          // cooperative handoff
        i += 1;
    }

    return label + " done";
}

// Async function returns a fiber immediately; await gives final result
fn async computeSum(n: int): int
{
    let s: int = 0;
    let i: int = 0;

    while (i <= n) {
        s += i;
        i += 1;
    }

    return s;
}

fn async Main()
{
    // Anonymous functions can't be typed yet.
    let f: fiber = Fiber.New(fn() { return worker("A", 3); });

    // Resume step-by-step: returns yield values and eventually return value.
    // Resume is inherently dynamic: yields can be ints and the final return can be a string.
    let r0: any = Fiber.Resume(f);
    Console.WriteLine("resume=", r0); // 0

    var r1: any = Fiber.Resume(f);
    Console.WriteLine("resume=", r1); // 1

    var r2: any = Fiber.Resume(f);
    Console.WriteLine("resume=", r2); // 2

    let r3: any = Fiber.Resume(f);
    Console.WriteLine("resume=", r3); // "A done"

    let task: fiber = computeSum(100);
    let result: int = await task;

    Console.WriteLine("sum(0..100)=", result);
    Debug.Assert(result, 5050);

    return;
}
