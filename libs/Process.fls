// ============================================================
//  Process.fls - Subprocess management for Flaris
//  Version: 1.0
// ============================================================
//
// Runs external programs, captures their output, and streams
// data to/from them. Built on top of Os.Spawn / Os.RunEx.
//
// QUICK START
// -----------
//   import { Process, Run, RunAsync, Shell, Spawn } from library("Process", "1.0");
//
//   // Blocking run - capture exit code + stdout + stderr
//   let r = Run("git", ["log", "--oneline", "-5"], { cwd: "/src/project" });
//   Console.WriteLine(r.Exit, r.Stdout);
//
//   // Shell string (sh -c on Unix, cmd /c on Windows)
//   let r = Shell("ls -la | grep .fls");
//
//   // The same run without holding up other fibers; both children run at once
//   let both = Fiber.AwaitAll([RunAsync("make", ["a"]), RunAsync("make", ["b"])]);
//
//   // Spawned process - interact while running
//   let p = Spawn("tail", ["-f", "/var/log/system.log"]);
//   if (p == nil) { Console.Error("spawn failed"); return 1; }
//
//   while (true) {
//       let line = p.ReadLine();
//       if (line == nil) break;
//       Console.WriteLine(line);
//   }
//   p.Close();
//
//   // Writing to stdin
//   let p = Spawn("cat");
//   p.Write("hello\n");
//   p.Write("world\n");
//   p.CloseStdin();
//   Console.WriteLine(p.ReadLine());  // "hello"
//   Console.WriteLine(p.ReadLine());  // "world"
//   p.Wait();
//   p.Close();
//
// API
// ---
//   Run(cmd, args?, opts?)      → Result - runs the child; every fiber waits
//   Shell(cmd, opts?)           → Result - sh -c / cmd /c, as Run
//   RunAsync(cmd, args?, opts?) → fiber resolving to a Result. Only the fiber that
//                                 awaits it waits; the others run meanwhile
//   Spawn(cmd, args?)           → Process | nil
//   Start(cmd, args?, opts?)    → Process | nil - Spawn with opts (cwd, env, mergeStderr)
//   StartAsync(cmd, args?, opts?) → fiber resolving to Start's Process | nil
//   WaitTimeout(pid, timeoutMs) → {Alive:bool, Exit:int, TimedOut:bool}
//
//   Result: {Exit:int, Stdout:string, Stderr:string, Success:bool, TimedOut:bool};
//   a program that cannot be started gives Exit 127.
//
//   opts (every key optional):
//     timeout      int     ms before the child is killed: Exit 124, TimedOut true.
//                          Run and Shell kill the child's whole process group;
//                          RunAsync kills the child itself
//     cwd          string  working directory of the child
//     env          object  variables merged over this process's environment
//                          (a nil value removes one)
//     stdin        string  text fed to the child's stdin, which is then closed.
//                          Without it Run and Shell share this process's stdin
//                          and RunAsync gives the child an empty one
//     mergeStderr  bool    stderr goes to Stdout, interleaved as written
//
//   p.Pid()               → int - process id
//   p.ReadLine()          → string | nil - next stdout line (blocks fiber, not VM)
//   p.ReadLineErr()       → string | nil - next stderr line
//   p.ReadAll()           → string - the rest of stdout, until the child closes it
//   p.Write(data)         - write string to stdin
//   p.WriteLine(data)     - write data and "\n"
//   p.CloseStdin()        - signal EOF to child's stdin
//   p.Wait()              → int - exit code; blocks fiber until child exits
//   p.WaitTimeout(ms)     → {Alive, Exit, TimedOut} - as WaitTimeout above
//   p.Kill(signal?)       - send signal (default SIGTERM = 15)
//   p.IsAlive()           → bool
//   p.Close()             - close the child's pipes

class Process {

    let _pid:int     = 0;
    // The child's pipes as streams. Every wait on them goes through an *Async
    // call, so it parks only the fiber that asked - the rest keep running.
    let _stdin       = nil;
    let _stdout      = nil;
    let _stderr      = nil;
    let _exited      = false;
    let _exitCode: int|nil = 0;

    fn WriteLine(data) {
        this.Write(data + "\n");
    }

    // Everything the child writes to stdout until it closes it, byte for byte.
    fn ReadAll() {
        if (this._stdout == nil) return "";
        let b = Fiber.Await(Stream.ReadAsync(this._stdout, 0));
        return b == nil ? "" : Buffer.ToString(b);
    }

    fn _init(handle) {
        this._pid    = handle.Pid;
        this._stdin  = handle.Stdin;
        this._stdout = handle.Stdout;
        this._stderr = handle.Stderr;
    }

    fn _poll() {
        if (this._exited) return;
        let s = Os.TryWait(this._pid);
        if (!s.Alive) {
            this._exited   = true;
            this._exitCode = s.Exit;
        }
    }

    fn Pid() {
        return this._pid;
    }

    fn IsAlive() {
        this._poll();
        return !this._exited;
    }

    fn Kill(signal?) {
        Os.KillChild(this._pid, signal ?? 15);
    }

    fn Wait() {
        while (!this._exited) {
            let r = Fiber.Await(Os.WaitAsync(this._pid));
            if (r != nil && !r.Alive) {
                this._exited   = true;
                this._exitCode = r.Exit;
            } else {
                this._poll(); // the wait was cancelled: look once, then wait again
            }
        }
        return this._exitCode;
    }

    fn WaitTimeout(timeoutMs:int) {
        return Os.WaitTimeout(this._pid, timeoutMs);
    }

    // Returns once all of `data` is in the pipe, however slowly the child reads.
    fn Write(data) {
        if (this._stdin != nil) { Fiber.Await(Stream.WriteAsync(this._stdin, data)); }
    }

    fn CloseStdin() {
        if (this._stdin != nil) { Stream.Close(this._stdin); this._stdin = nil; }
    }

    // The next stdout line without its line ending, or nil once the child has
    // closed stdout; an unterminated last line is handed over as it is.
    fn ReadLine() {
        return this._stdout == nil ? nil : Fiber.Await(Stream.ReadLineAsync(this._stdout));
    }

    fn ReadLineErr() {
        return this._stderr == nil ? nil : Fiber.Await(Stream.ReadLineAsync(this._stderr));
    }

    fn Close() {
        if (this._stdin  != nil) { Stream.Close(this._stdin);  this._stdin  = nil; }
        if (this._stdout != nil) { Stream.Close(this._stdout); this._stdout = nil; }
        if (this._stderr != nil) { Stream.Close(this._stderr); this._stderr = nil; }
    }
}

// opts (see the header) as Os.Spawn / Os.RunEx launch options.
fn _launchOptions(opts, withStdin:bool) {
    let o = {};
    if (opts == nil) return o;
    if (opts.cwd != nil)         o.Cwd = opts.cwd;
    if (opts.env != nil)         o.Env = opts.env;
    if (opts.mergeStderr != nil) o.MergeStderr = opts.mergeStderr;
    if (withStdin && opts.stdin != nil) o.Stdin = opts.stdin;
    return o;
}

fn _timeoutOf(opts): int {
    return (opts != nil && opts.timeout != nil) ? opts.timeout : 0;
}

fn _start(cmd, args, opts) {
    let handle = Os.Spawn(cmd, args ?? [], _launchOptions(opts, false));
    if (handle == nil) return nil;
    let p = new Process();
    p._init(handle);
    return p;
}

fn Spawn(cmd, args?) {
    return _start(cmd, args, nil);
}

fn Start(cmd, args?, opts?) {
    return _start(cmd, args, opts);
}

fn async StartAsync(cmd, args?, opts?) {
    return _start(cmd, args, opts);
}

fn _withProcessResult(raw) {
    let r = raw;
    if (r == nil) {
        return {
            Exit: 127,
            Stdout: "",
            Stderr: "",
            Success: false,
            TimedOut: false
        };
    }
    r.Success = (r.Exit == 0);
    r.TimedOut = r.TimedOut ?? false;
    return r;
}

fn Run(cmd, args?, opts?) {
    let timeout = _timeoutOf(opts);
    let o = _launchOptions(opts, true);
    let raw = (timeout > 0)
        ? Os.RunExTimeout(cmd, timeout, args ?? [], o)
        : Os.RunEx(cmd, args ?? [], o);
    return _withProcessResult(raw);
}

// The child's output as a string, read until it closes the pipe or the
// deadline passes (then what had arrived).
fn async _drain(s, timeout:int) {
    if (s == nil) return "";
    let b = await Stream.ReadAsync(s, 0, timeout);
    Stream.Close(s);
    return b == nil ? "" : Buffer.ToString(b);
}

fn async _feed(s, input) {
    if (input != nil && input != "") await Stream.WriteAsync(s, input);
    Stream.Close(s);
    return nil;
}

// Waits for the exit; past the deadline kills the child and reaps it.
fn async _reap(pid:int, timeout:int) {
    let r = timeout > 0 ? await Os.WaitAsync(pid, timeout) : await Os.WaitAsync(pid);
    if (r != nil && r.TimedOut) {
        Os.KillChild(pid, 9);
        await Os.WaitAsync(pid);
        return { Exit: 124, TimedOut: true };
    }
    return { Exit: r == nil ? nil : r.Exit, TimedOut: false };
}

// Run on pipes from Os.Spawn: stdout, stderr, stdin and the exit are each
// waited on by their own fiber, so a child that fills one pipe while another
// is unread cannot stall, and nothing waits outside the calling fiber.
fn _runSpawned(cmd, args, opts) {
    let h = Os.Spawn(cmd, args, _launchOptions(opts, false));
    if (h == nil) return _withProcessResult(nil);
    let timeout = _timeoutOf(opts);
    let done = Fiber.AwaitAll([
        _drain(h.Stdout, timeout),
        _drain(h.Stderr, timeout),
        _feed(h.Stdin, opts == nil ? nil : opts.stdin),
        _reap(h.Pid, timeout)
    ]);
    let exit = done[3];
    return _withProcessResult({
        Exit: exit.Exit,
        Stdout: done[0],
        Stderr: done[1],
        TimedOut: exit.TimedOut
    });
}

fn async RunAsync(cmd, args?, opts?) {
    return _runSpawned(cmd, args ?? [], opts);
}

fn Shell(cmd, opts?) {
    let isWin = Os.Name() == "Windows";
    let shell = isWin ? "cmd" : "sh";
    let flag  = isWin ? "/c"  : "-c";
    return Run(shell, [flag, cmd], opts);
}

fn WaitTimeout(pid:int, timeoutMs:int) {
    return Os.WaitTimeout(pid, timeoutMs);
}

export { Process, Spawn, Start, Run, RunAsync, Shell, StartAsync, WaitTimeout };
