// Linq.fls - Chainable array query library for Flaris.
// Version: 1.0
//
// Linq.From(array) returns a Query object. Chain filter/transform/sort
// methods and terminate with a materialising call (ToArray, Count, First, …).
// Each chain method returns a new Query and leaves the Query it was called on
// unchanged, so one Query can feed several chains; the source array is never
// modified. Work is done eagerly, step by step, mostly by the native Array.*
// functions.
//
// Usage:
//   import { Linq } from library("Linq", "1.0");
//
//   // Filter, transform, sort
//   let result = Linq.From([3, 1, 4, 1, 5, 9, 2, 6])
//       .Where(fn(x)  { return x > 2; })
//       .Select(fn(x) { return x * 10; })
//       .OrderBy(nil)         // nil = natural order
//       .ToArray();           // [30, 40, 50, 60, 90]
//
//   // One source, two independent queries
//   let q     = Linq.From([1, 2, 3, 4]);
//   let evens = q.Where(fn(x) { return x % 2 == 0; }).ToArray();   // [2, 4]
//   let odds  = q.Where(fn(x) { return x % 2 == 1; }).ToArray();   // [1, 3]
//
//   // Aggregation
//   let total = Linq.From(orders).Sum(fn(o) { return o.amount; });
//   let avg   = Linq.From(scores).Average(nil);   // nil = identity
//
//   // Grouping
//   let byDept = Linq.From(employees)
//       .GroupBy(fn(e) { return e.dept; });   // HashMap: dept -> array
//   byDept.Get("sales");
//
//   // Multi-key sort
//   let sorted = Linq.From(people)
//       .OrderBy(fn(p) { return p.last; })
//       .ThenByDesc(fn(p) { return p.age; })
//       .ToArray();
//
// Entry point:
//   Linq.From(array)   →  Query
//   Linq.Empty()       →  Query with no elements
//   Linq.Range(start, end, step?)  →  Query of ints in [start, end) (step default 1;
//                                     a negative step counts down to end, exclusive)
//   Linq.Repeat(value, n)          →  Query of n copies of value
//
// Filtering / slicing:
//   .Where(predicate)        - keep elements where predicate returns true
//   .Take(n)                 - first n elements
//   .Skip(n)                 - drop first n elements
//   .TakeWhile(predicate)    - take while predicate holds, then stop
//   .SkipWhile(predicate)    - skip while predicate holds, then take rest
//   .Distinct()              - remove duplicates (by value equality)
//   .DistinctBy(keyFn)       - remove duplicates by a key selector (keeps first)
//
// Transformation:
//   .Select(transform)       - map each element
//   .Flatten()               - one level of nested arrays into flat sequence
//   .SelectMany(transform)   - map then flatten (transform returns array)
//   .Chunk(size)             - split into chunks of size n (array of arrays)
//   .Reverse()               - reverse order
//   .Zip(other)              - pair elements: [[a0, b0], [a1, b1], …], as long
//                              as the shorter sequence
//
// Sorting (all sorts are stable: equal elements keep their order):
//   .OrderBy(cmpOrKey)       - ascending; nil = natural order
//   .OrderByDesc(cmpOrKey)   - descending
//   .ThenBy(cmpOrKey)        - after OrderBy/OrderByDesc/ThenBy*: order the
//   .ThenByDesc(cmpOrKey)      elements that tie on every earlier key
//     The callback may be either shape, told apart by how many arguments it
//     takes:
//       fn(x) -> key        key selector - order by that key
//       fn(a, b) -> bool    comparator   - true if a comes before b
//     A key selector is evaluated once per element, a comparator once per
//     comparison, so reach for the key selector whenever the order is simply
//     "by some field".
//       .OrderBy(fn(o)    { return o.amount; })       // by key
//       .OrderBy(fn(a, b) { return a.amt < b.amt; })  // by comparator
//
// Set operations:
//   .Concat(other)           - append another array or Query
//   .Append(item)            - append a single item
//   .Prepend(item)           - prepend a single item
//   .Intersect(other)        - distinct elements present in both sequences
//   .Except(other)           - distinct elements of this not in other
//   .Union(other)            - Concat + Distinct
//
// Scanning / folding:
//   .Scan(accumulator, seed) - running aggregate (returns Query of intermediates)
//   .Aggregate(fn, seed)     - fold to a single value; fn(acc, item) → acc
//   .ForEach(action)         - call action(item) for each element; no return
//   .DefaultIfEmpty(value)   - this Query, or a Query of [value] when empty
//
// Terminating (materialise):
//   .ToArray()               →  array (a new array each call)
//   .GroupBy(keyFn)          →  Collections.HashMap: key → array of elements.
//                               Keys compare by value and type, so 1, 1.0 and
//                               "1" are three groups; each array keeps the
//                               elements' order
//   .ToHashMap(keyFn, valFn) →  Collections.HashMap
//   .ToHashMapStrict(keyFn)  →  object: str(key) → element; raises on a duplicate key
//   .Partition(predicate)    →  { matching:array, rest:array }
//
// Aggregates (terminate):
//   .Count(predicate?)       →  int    - total, or count where predicate is true
//   .Sum(transform?)         →  number - nil transform = identity
//   .Min(transform?)         →  value
//   .Max(transform?)         →  value
//   .Average(transform?)     →  float
//   .MinBy(keyFn)            →  element with the smallest selector key (nil if empty)
//   .MaxBy(keyFn)            →  element with the largest selector key (nil if empty)
//   .CountBy(keyFn)          →  object mapping str(key) → count
//
// Statistics (terminate; optional transform, nil = identity):
//   .Median(transform?)        →  float - median value
//   .Variance(transform?)      →  float - population variance
//   .StdDev(transform?)        →  float - population standard deviation
//   .Percentile(p, transform?) →  float - p in [0,100], linear interpolation
//
// Search (terminate):
//   .First(predicate?)       →  first element (or nil if none matches)
//   .Last(predicate?)        →  last element
//   .ElementAt(index)        →  element at 0-based index
//   .IndexOf(value)          →  int  (-1 if not found)
//   .Contains(value)         →  bool
//   .Any(predicate?)         →  bool  - true if any element matches (or, with
//                                       no predicate, if there is any element)
//   .All(predicate)          →  bool  - true if all elements match
//   .Size()  .IsEmpty()
//
// Free functions over a plain array (no Query):
//   Linq.Any(arr, pred)  Linq.All(arr, pred)          →  bool
//   Linq.FindIndex(arr, pred)  Linq.FindLastIndex(arr, pred)  →  int (-1 if none)
//   Linq.FindLast(arr, pred)                          →  element or nil
//   Linq.GroupBy(arr, keyFn)   →  object: str(key) → array, in first-seen order
//   Linq.CountBy(arr, keyFn)   →  object: str(key) → count
//   Linq.FlatMap(arr, fn)      →  array; an array result is spread, others appended
//   Linq.Partition(arr, pred)  →  [matches, rest]
//   Linq.MinBy(arr, keyFn)  Linq.MaxBy(arr, keyFn)    →  element or nil
//   Linq.UniqueBy(arr, keyFn)  →  first element per distinct str(key)
//   Linq.ReduceRight(arr, fn, initial?)  →  fold right-to-left as fn(acc, elem)
//   Linq.RemoveIf(arr, pred)   →  int; removes matches from arr in place
//
// Callbacks may be closures or builtins (Linq.GroupBy(a, Type.Of),
// Linq.MinBy(a, String.Length)).

// ---------------------------------------------------------------------------
// Query - internal chaining object
// ---------------------------------------------------------------------------

class Query {
    let _data: array = nil;     // never mutated after construction
    let _src: array = nil;      // ordered Query: the input of the OrderBy chain
    let _levels: array = nil;   // ordered Query: [callback, descending] per sort key

    // Takes a copy of `arr`, or adopts it when `owned` (a fresh array nobody
    // else holds).
    fn Constructor(arr:array, owned?:bool) {
        this._data = (owned == true) ? arr : Array.Clone(arr);
    }

    fn static _Of(arr:array): instance { return new Query(arr, true); }

    fn static _AsArray(other): array {
        if (type(other) == Type.Instance) { return other._data; }
        return other;
    }

    // -----------------------------------------------------------------------
    // Filtering
    // -----------------------------------------------------------------------

    fn Where(predicate:fn): instance {
        return Query._Of(Array.Where(this._data, predicate));
    }

    // -----------------------------------------------------------------------
    // Projection
    // -----------------------------------------------------------------------

    fn Select(transform:fn): instance {
        return Query._Of(Array.Select(this._data, transform));
    }

    fn Flatten(): instance {
        return Query._Of(Array.Flatten(this._data));
    }

    fn SelectMany(transform:fn): instance {
        return Query._Of(Array.FlatMap(this._data, transform));
    }

    // -----------------------------------------------------------------------
    // Ordering
    //
    // An ordered Query remembers its unsorted input and its sort keys, so
    // ThenBy can re-sort by every key: stable sorts applied from the last key
    // to the first leave the first key most significant.
    // -----------------------------------------------------------------------

    fn OrderBy(comparator): instance {
        return Query._Ordered(this._data, [[comparator, false]]);
    }

    fn OrderByDesc(comparator): instance {
        return Query._Ordered(this._data, [[comparator, true]]);
    }

    fn ThenBy(comparator): instance {
        return Query._Ordered(this._ThenSource(), Array.Concat(this._levels, [[comparator, false]]));
    }

    fn ThenByDesc(comparator): instance {
        return Query._Ordered(this._ThenSource(), Array.Concat(this._levels, [[comparator, true]]));
    }

    fn _ThenSource(): array {
        if (this._levels == nil) {
            throw(1, "Linq: ThenBy / ThenByDesc must follow OrderBy or OrderByDesc");
        }
        return this._src;
    }

    fn static _Ordered(src:array, levels:array): instance {
        let data = Array.Clone(src);
        var i:int = len(levels) - 1;
        while (i >= 0) {
            let level = levels[i];
            Query._SortLevel(data, level[0], level[1]);
            i -= 1;
        }
        let q = Query._Of(data);
        q._src = src;
        q._levels = levels;
        return q;
    }

    // Stable in-place sort by one key, choosing the shape from the callback's
    // arity: one argument is a key selector (run once per element), two are a
    // comparator (run per comparison). Descending reverses, sorts ascending and
    // reverses back, which keeps equal elements in their original order.
    fn static _SortLevel(data:array, comparator, descending:bool) {
        if (descending) { Array.Reverse(data); }
        if (comparator == nil) {
            Array.Sort(data);
        } else if (VM.GetFunctionInfo(comparator).Arity == 1) {
            Array.SortBy(data, comparator);
        } else {
            Array.Sort(data, comparator);
        }
        if (descending) { Array.Reverse(data); }
    }

    fn Reverse(): instance {
        let data = Array.Clone(this._data);
        Array.Reverse(data);
        return Query._Of(data);
    }

    // -----------------------------------------------------------------------
    // Set operations
    // -----------------------------------------------------------------------

    fn Distinct(): instance {
        return Query._Of(Array.Distinct(this._data));
    }

    fn Concat(other): instance {
        return Query._Of(Array.Concat(this._data, Query._AsArray(other)));
    }

    fn Zip(other): instance {
        return Query._Of(Array.Zip(this._data, Query._AsArray(other)));
    }

    // Whether `x` occurs in `arr`, whose elements `set` holds. Numbers, strings
    // and bools hash by value, so the set answers for them; arrays and objects
    // hash by identity, so a miss falls back to the deep comparison
    // Array.Contains makes.
    fn static _In(set, arr:array, x, deepMask:int): bool {
        if (set.Has(x)) return true;
        return (type(x) & deepMask) != 0 && Array.Contains(arr, x);
    }

    // Elements present in both this and other (intersection, distinct).
    fn Intersect(other): instance {
        let otherArr:array = Query._AsArray(other);
        let set = Collections.Set(otherArr);
        let deep:int = Type.Array | Type.Object | Type.Instance;
        let result = [];
        foreach (x in this._data) {
            if (Query._In(set, otherArr, x, deep)) { Array.Append(result, x); }
        }
        return Query._Of(Array.Distinct(result));
    }

    // Elements in this but not in other (set difference, distinct).
    fn Except(other): instance {
        let otherArr:array = Query._AsArray(other);
        let set = Collections.Set(otherArr);
        let deep:int = Type.Array | Type.Object | Type.Instance;
        let result = [];
        foreach (x in this._data) {
            if (!Query._In(set, otherArr, x, deep)) { Array.Append(result, x); }
        }
        return Query._Of(Array.Distinct(result));
    }

    // Unique elements from both sequences (Concat + Distinct).
    fn Union(other): instance {
        return Query._Of(Array.Distinct(Array.Concat(this._data, Query._AsArray(other))));
    }

    // -----------------------------------------------------------------------
    // Slicing
    // -----------------------------------------------------------------------

    fn Take(n:int): instance {
        return Query._Of(Array.Take(this._data, n));
    }

    fn Skip(n:int): instance {
        return Query._Of(Array.Skip(this._data, n));
    }

    // Index of the first element failing `predicate`, or the length.
    fn _Prefix(predicate:fn): int {
        let data = this._data;
        let n:int = len(data);
        iter (i from 0 to n) {
            if (!predicate(data[i])) return i;
        }
        return n;
    }

    fn TakeWhile(predicate:fn): instance {
        return Query._Of(Array.Take(this._data, this._Prefix(predicate)));
    }

    fn SkipWhile(predicate:fn): instance {
        return Query._Of(Array.Skip(this._data, this._Prefix(predicate)));
    }

    // -----------------------------------------------------------------------
    // Single-element add
    // -----------------------------------------------------------------------

    // Add one item to the end.
    fn Append(item): instance {
        return Query._Of(Array.Concat(this._data, [item]));
    }

    // Add one item to the start.
    fn Prepend(item): instance {
        return Query._Of(Array.Concat([item], this._data));
    }

    // Split into sub-arrays of at most size elements (size < 1 counts as 1).
    fn Chunk(size:int): instance {
        if (size <= 0) { size = 1; }
        return Query._Of(Array.Chunk(this._data, size));
    }

    // -----------------------------------------------------------------------
    // Terminal - aggregation
    // -----------------------------------------------------------------------

    fn Count(predicate) {
        if (predicate == nil) return len(this._data);
        return Array.Count(this._data, predicate);
    }

    fn Sum(transform) {
        if (transform == nil) return Math.Sum(this._data);
        return Math.Sum(Array.Select(this._data, transform));
    }

    fn Min(transform) {
        if (transform == nil) return Math.MinOf(this._data);
        return Math.MinOf(Array.Select(this._data, transform));
    }

    fn Max(transform) {
        if (transform == nil) return Math.MaxOf(this._data);
        return Math.MaxOf(Array.Select(this._data, transform));
    }

    fn Average(transform) {
        if (transform == nil) return Array.Average(this._data);
        return Array.Average(Array.Select(this._data, transform));
    }

    fn Aggregate(accumulator:fn, seed) {
        var acc = seed;
        var n = len(this._data);
        iter (i from 0 to n) {
            acc = accumulator(acc, this._data[i]);
        }
        return acc;
    }

    // -----------------------------------------------------------------------
    // Key-based reducers and statistics
    // -----------------------------------------------------------------------

    // MinBy/MaxBy return the ELEMENT whose selector(element) is smallest/largest
    // (unlike Min/Max which return the value); the earliest one on a tie. nil
    // on empty.
    fn MinBy(selector:fn) { return Array.MinBy(this._data, selector); }

    fn MaxBy(selector:fn) { return Array.MaxBy(this._data, selector); }

    // DistinctBy keeps the first element for each distinct selector key. Chainable.
    fn DistinctBy(selector:fn): instance {
        return Query._Of(Linq.UniqueBy(this._data, selector));
    }

    // CountBy returns { keyString: count } grouped by selector(element). Terminal.
    fn CountBy(selector:fn): object {
        return Linq.CountBy(this._data, selector);
    }

    // Statistics (numeric data, or via optional selector). Variance/StdDev are
    // population statistics (divide by n), matching the header doc above.
    fn Median(transform) {
        var vals = this._data;
        if (transform != nil) { vals = Array.Select(vals, transform); }
        let n = len(vals);
        if (n == 0) return nil;
        let sorted = Array.Clone(vals);
        Array.Sort(sorted);
        if (n % 2 == 1) { return sorted[n / 2] + 0.0; }
        return (sorted[n / 2 - 1] + sorted[n / 2]) / 2.0;
    }

    fn Variance(transform) {
        var vals = this._data;
        if (transform != nil) { vals = Array.Select(vals, transform); }
        let n = len(vals);
        if (n == 0) return nil;
        let mean = Array.Average(vals);
        var sq = 0.0;
        var i = 0;
        while (i < n) { let d = vals[i] - mean; sq = sq + d * d; i = i + 1; }
        return sq / n;
    }

    fn StdDev(transform) {
        let v = Variance(transform);
        if (v == nil) return nil;
        return Math.Sqrt(v);
    }

    // Percentile(p) for 0..100, linear interpolation between closest ranks.
    fn Percentile(p:float, transform) {
        var vals = this._data;
        if (transform != nil) { vals = Array.Select(vals, transform); }
        let n = len(vals);
        if (n == 0) return nil;
        let sorted = Array.Clone(vals);
        Array.Sort(sorted);
        if (p <= 0)   { return sorted[0]; }
        if (p >= 100) { return sorted[n - 1]; }
        let rank = (p / 100.0) * (n - 1);
        let lo   = Convert.ToInt(rank);
        if (lo >= n - 1) { return sorted[n - 1]; }
        let frac = rank - lo;
        return sorted[lo] + (sorted[lo + 1] - sorted[lo]) * frac;
    }

    // -----------------------------------------------------------------------
    // Terminal - element access
    // -----------------------------------------------------------------------

    fn First(predicate) {
        if (predicate == nil) return Array.First(this._data);
        return Array.Find(this._data, predicate);
    }

    fn Last(predicate) {
        if (predicate == nil) return Array.Last(this._data);
        return Array.FindLast(this._data, predicate);
    }

    fn ElementAt(index:int) {
        if (index < 0 || index >= len(this._data)) return nil;
        return this._data[index];
    }

    // Index of first occurrence of value, or -1 if not found.
    fn IndexOf(value): int {
        var n = len(this._data);
        iter (i from 0 to n) {
            if (this._data[i] == value) return i;
        }
        return -1;
    }

    // -----------------------------------------------------------------------
    // Terminal - existence checks
    // -----------------------------------------------------------------------

    fn Any(predicate): bool {
        if (predicate == nil) return len(this._data) > 0;
        return Array.Any(this._data, predicate);
    }

    fn All(predicate:fn): bool {
        return Array.All(this._data, predicate);
    }

    fn Contains(value): bool {
        return Array.Contains(this._data, value);
    }

    // -----------------------------------------------------------------------
    // Terminal - side effects
    // -----------------------------------------------------------------------

    fn ForEach(action:fn) {
        Array.ForEach(this._data, action);
    }

    // -----------------------------------------------------------------------
    // Terminal - materializers
    // -----------------------------------------------------------------------

    fn ToArray(): array {
        return Array.Clone(this._data);
    }

    fn GroupBy(keyFn:fn) {
        let map = Collections.HashMap();
        foreach (g in Array.GroupBy(this._data, keyFn)) {
            map.Set(g.Key, g.Items);
        }
        return map;
    }

    fn ToHashMap(keyFn:fn, valFn:fn) {
        var map = Collections.HashMap();
        var n = len(this._data);
        iter (i from 0 to n) {
            var item = this._data[i];
            map.Set(keyFn(item), valFn(item));
        }
        return map;
    }

    // Split into two arrays in one pass.
    // Returns { matching: [...], rest: [...] }.
    fn Partition(predicate:fn) : object {
        let parts = Array.Partition(this._data, predicate);
        return { matching: parts[0], rest: parts[1] };
    }

    // Running aggregate - returns a new Query with the running values.
    fn Scan(accumulator:fn, seed) : instance {
        let result = [];
        var acc = seed;
        iter (i from 0 to len(this._data)) {
            acc = accumulator(acc, this._data[i]);
            Array.Append(result, acc);
        }
        return Query._Of(result);
    }

    // Return self if non-empty, else a Query containing just val.
    fn DefaultIfEmpty(val) : instance {
        if (len(this._data) > 0) return this;
        return Query._Of([val]);
    }

    // Like ToHashMap but throws on duplicate keys.
    fn ToHashMapStrict(keyFn:fn) : object {
        let result = {};
        iter (i from 0 to len(this._data)) {
            let item = this._data[i];
            let k    = str(keyFn(item));
            if (result[k] != nil) { throw(1, "ToHashMapStrict: duplicate key '" + k + "'"); }
            result[k] = item;
        }
        return result;
    }

    // -----------------------------------------------------------------------
    // Utility
    // -----------------------------------------------------------------------

    fn Size(): int    { return len(this._data); }
    fn IsEmpty(): bool { return len(this._data) == 0; }
}

// ---------------------------------------------------------------------------
// Linq - public factory namespace
// ---------------------------------------------------------------------------

class Linq {

    fn static From(arr:array): instance    { return new Query(arr); }
    fn static Empty(): instance            { return new Query([], true); }

    fn static Range(start:int, end:int, step?:int): instance {
        var arr = [];
        var i = start;
        if (step == nil || step == 0) step = 1;
        if (step > 0) {
            while (i < end) { Array.Append(arr, i); i += step; }
        } else {
            while (i > end) { Array.Append(arr, i); i += step; }
        }
        return new Query(arr, true);
    }

    fn static Repeat(value, n:int): instance {
        var arr = Array.Fill(Array.Create(n), value);
        return new Query(arr, true);
    }

    // ---------------------------------------------------------------------
    // Free-function forms: `Linq.X(arr, fn)` over a plain array, no Query
    // wrapper. Most are the Array.* builtin of the same meaning; the key of a
    // grouping is the string form of the selector result, matching how an
    // object keys its entries.
    // ---------------------------------------------------------------------

    fn static Any(arr: array, pred: fn): bool { return Array.Any(arr, pred); }

    fn static All(arr: array, pred: fn): bool { return Array.All(arr, pred); }

    fn static FindIndex(arr: array, pred: fn): int { return Array.FindIndex(arr, pred); }

    fn static FindLast(arr: array, pred: fn) { return Array.FindLast(arr, pred); }

    fn static FindLastIndex(arr: array, pred: fn): int { return Array.FindLastIndex(arr, pred); }

    // { key: [elements] }, insertion-ordered by first appearance of the key.
    fn static GroupBy(arr: array, keyFn: fn): object {
        let out = {};
        foreach (g in Array.GroupBy(arr, fn(x) { return str(keyFn(x)); })) {
            out[g.Key] = g.Items;
        }
        return out;
    }

    // { key: count } - GroupBy without retaining the elements.
    fn static CountBy(arr: array, keyFn: fn): object {
        return Array.Tally(Array.Select(arr, fn(x) { return str(keyFn(x)); }));
    }

    // One level of flattening: an array result is spread, anything else appended.
    fn static FlatMap(arr: array, fn_: fn): array { return Array.FlatMap(arr, fn_); }

    // [matches, rest]
    fn static Partition(arr: array, pred: fn): array { return Array.Partition(arr, pred); }

    // Element with the smallest / largest selector key (the earliest on a tie);
    // nil for an empty array.
    fn static MinBy(arr: array, keyFn: fn) { return Array.MinBy(arr, keyFn); }

    fn static MaxBy(arr: array, keyFn: fn) { return Array.MaxBy(arr, keyFn); }

    // First element per distinct selector key, order preserved.
    fn static UniqueBy(arr: array, keyFn: fn): array {
        let seen = {};
        let out  = [];
        foreach (x in arr) {
            let k = str(keyFn(x));
            if (!Object.HasKey(seen, k)) { seen[k] = true; Array.Append(out, x); }
        }
        return out;
    }

    // Folds right-to-left as fn(acc, elem). Without `initial` the last element
    // seeds the accumulator; an empty array yields `initial`, or nil.
    fn static ReduceRight(arr: array, fn_: fn, initial?) {
        let n: int = len(arr);
        if (n == 0) return initial;
        let i: int = n - 1;
        let acc = initial;
        if (initial == nil) { acc = arr[i]; i = i - 1; }
        while (i >= 0) { acc = fn_(acc, arr[i]); i = i - 1; }
        return acc;
    }

    // Removes matching elements IN PLACE (the caller's array is mutated) and
    // returns how many went. Survivors keep their relative order.
    fn static RemoveIf(arr: array, pred: fn): int { return Array.RemoveAll(arr, pred); }
}

export { Linq };
