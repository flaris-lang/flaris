// Promise.fls - Async composition with promises for Flaris.
// Version: 1.0
//
// A Promise represents a value that will be available in the future.
// Promises are fiber-based: Await() parks the current fiber (Fiber.Park)
// until the promise settles and wakes it, so the scheduler runs other fibers
// meanwhile and a waiting fiber uses no CPU.
//
// Usage:
//   import { Promise } from library("Promise", "1.0");
//
//   // Run work in a fiber: the worker takes its promise's id and settles it
//   let url = "http://example.com";
//   let p = Promise.Run(fn() {
//       let id = Promise.ReceiveId();
//       Promise.Notify(id, Http.Get(url));        // or Promise.Fail(id, reason)
//   });
//   let res = p.Await();
//
//   // Chain: Then / Catch / Finally
//   p.Then(fn(v) { Console.WriteLine("ok:", v); })
//    .Catch(fn(e) { Console.WriteLine("err:", e); });
//
//   // Combinators (blocking: yield until all settle)
//   let results = Promise.All([p1, p2, p3]);   // array of resolved values
//   let first   = Promise.Race([p1, p2]);       // first resolved value
//   let any     = Promise.Any([p1, p2, p3]);    // first non-rejected value
//
// Creating:
//   new Promise()                   - empty; call Resolve/Reject manually
//   Promise.Resolved(value)         - already-resolved promise
//   Promise.Rejected(reason)        - already-rejected promise
//   Promise.Canceled(reason)
//   Promise.From(value)             - wraps value if not already a Promise
//   Promise.Run(workFn)             - run workFn in a fiber; returns Promise.
//                                     workFn gets the promise's id from
//                                     Promise.ReceiveId() and settles it with
//                                     Promise.Notify(id, value) or
//                                     Promise.Fail(id, reason); its return
//                                     value is not used
//   Promise.Delay(ms, value?)       - resolves after ms milliseconds
//   Promise.RejectAfter(ms, reason)
//
// Settling (on an empty promise):
//   Resolve(value)  Reject(reason)  Cancel(reason)
//
// State:
//   IsPending()  IsResolved()  IsRejected()  IsCanceled()  IsSettled()
//   State()  →  string    Value()  →  any    Id()  →  int
//
// Chaining (returns new Promise):
//   Then(onFulfilled)               - called when resolved
//   Catch(onRejected)               - called when rejected
//   ThenCatch(onFulfilled, onRejected)
//   Finally(onFinally)              - called always on settle
//
// Awaiting:
//   Await()                         - blocks fiber; returns resolved value or throws:
//                                     a rejection whose reason is an Exception
//                                     rethrows that exception (class, Code and
//                                     message intact), any other reason throws
//                                     code 1 with the reason as its message
//   AwaitResult()                   →  { ok:bool, value, reason }  - never throws
//   TryAwait(defaultValue)          - returns defaultValue on rejection/cancel
//
// Timeout / cancellation:
//   Timeout(ms)                     - reject after ms if still pending
//   CancelAfter(ms)                 - cancel after ms if still pending
//   CancelNow()
//   Each timer (also Delay, RejectAfter, CancelAfterNew, Retry's pause) holds
//   one fiber while its promise is pending and lets it go as soon as the
//   promise settles, so timers on promises that settle early do not pile up
//   against the fiber limit.
//
// Combinators (static, blocking):
//   Promise.All(promises)           →  array of values; throws if any rejects
//   Promise.Race(promises)          →  first settled value
//   Promise.Any(promises)           →  first resolved value; throws if all reject
//   Promise.AllSettled(promises)    →  array of { ok, value, reason }
//   Promise.FirstSettled(promises)  →  { ok, value, reason }
//
// Closures:
//   Lambdas passed to Then/Catch/Finally/Run capture enclosing locals as any
//   closure does: by value when the lambda is made, arrays and objects by
//   reference. Assigning to a captured local inside one is not seen outside, so
//   hand a result back through the promise or a shared object.

global _pr_store = {};   // id -> Promise instance
global _pr_next  = 0;    // monotonic id counter

fn _PromiseRetryWorker() {
    let self = Fiber.FromId(Fiber.Id());
    while (!Fiber.HasMessage(self)) { Fiber.Park(); }

    let msg        = Fiber.GetMessage(self);
    let pid        = msg.id;
    let fn_        = msg.fn_;
    let maxAttempts = msg.maxAttempts;
    let delayMs    = msg.delayMs;

    var attempt = 0;
    var lastErr = nil;
    while (attempt < maxAttempts) {
        let p = _pr_store[str(pid)];
        if (p == nil) { return; }
        attempt = attempt + 1;
        try {
            let result = fn_();
            Promise.Notify(pid, result);
            return;
        } catch (e) {
            lastErr = e.Error;
            if (attempt < maxAttempts && delayMs > 0 && !p._ParkWhilePending(delayMs)) {
                return;
            }
        }
    }
    Promise.Fail(pid, lastErr);
}

fn _PromiseDelayedWorker() {
    let self = Fiber.FromId(Fiber.Id());
    while (!Fiber.HasMessage(self)) { Fiber.Park(); }

    let msg = Fiber.GetMessage(self);
    let pid = msg.id;
    let delay = msg.ms;
    let kind = msg.kind;
    let value = msg.value;

    let p = _pr_store[str(pid)];
    if (p == nil || !p._ParkWhilePending(delay)) { return; }

    if (kind == "resolve") {
        Promise.Notify(pid, value);
    } else if (kind == "reject") {
        Promise.Fail(pid, value);
    } else if (kind == "cancel") {
        Promise.CancelId(pid, value);
    }
}

class Promise {
    let _handlers = nil; 
    let _state: string = "pending"; 
    let _value = nil; 
    let _waiters = nil;
    let _timers = nil;
    let id = 0;

    fn Constructor() {
        _pr_next        = _pr_next + 1;
        this.id         = _pr_next;
        this._state     = "pending";   // "pending" | "resolved" | "rejected" | "canceled"
        this._value     = nil;
        this._handlers  = [];          // [{onFulfilled, onRejected, onFinally, next}]
        this._waiters   = [];          // ids of fibers parked until this settles
        this._timers    = [];          // ids of timer fibers parked until this settles or their time is up
        _pr_store[str(this.id)] = this;
    }

    // ── Inspection ────────────────────────────────────────────────────────────

    fn IsPending(): bool   { return this._state == "pending";  }
    fn IsResolved(): bool  { return this._state == "resolved"; }
    fn IsRejected(): bool  { return this._state == "rejected"; }
    fn IsCanceled(): bool  { return this._state == "canceled"; }
    fn IsSettled(): bool   { return this._state != "pending";  }
    fn State(): string     { return this._state; }
    fn Value()             { return this._value; }
    fn Id(): int           { return this.id; }

    fn ToString(): string {
        return "Promise{id=" + str(this.id) + ", state=" + this._state + "}";
    }

    // ── Settlement ────────────────────────────────────────────────────────────

    fn Resolve(v) {
        if (this._state != "pending") { return; }
        this._state = "resolved";
        this._value = v;
        this._Dispatch();
    }

    fn Reject(r) {
        if (this._state != "pending") { return; }
        this._state = "rejected";
        this._value = r;
        this._Dispatch();
    }

    fn Cancel(reason) {
        if (this._state != "pending") { return; }
        if (reason == nil) { reason = "canceled"; }
        this._state = "canceled";
        this._value = reason;
        this._Dispatch();
    }

    fn _PropagateTo(next:instance, state:string, value) {
        if (state == "resolved") {
            next.Resolve(value);
        } else if (state == "canceled") {
            next.Cancel(value);
        } else {
            next.Reject(value);
        }
    }

    fn _Dispatch() {
        let state = this._state;
        let value = this._value;

        foreach (h in this._handlers) {

            if (state == "resolved") {
                if (h.onFulfilled != nil) {
                    try {
                        let result = h.onFulfilled(value);

                        if (h.onFinally != nil) {
                            try {
                                h.onFinally();
                            } catch (e2) {
                                h.next.Reject(e2);
                                continue;
                            }
                        }

                        h.next.Resolve(result);
                    } catch (e) {
                        h.next.Reject(e);
                    }
                } else {
                    if (h.onFinally != nil) {
                        try {
                            h.onFinally();
                        } catch (e) {
                            h.next.Reject(e);
                            continue;
                        }
                    }
                    h.next.Resolve(value);
                }
            } else {
                if (h.onRejected != nil) {
                    try {
                        let result = h.onRejected(value);

                        if (h.onFinally != nil) {
                            try {
                                h.onFinally();
                            } catch (e2) {
                                h.next.Reject(e2);
                                continue;
                            }
                        }

                        h.next.Resolve(result);
                    } catch (e) {
                        h.next.Reject(e);
                    }
                } else {
                    if (h.onFinally != nil) {
                        try {
                            h.onFinally();
                        } catch (e) {
                            h.next.Reject(e);
                            continue;
                        }
                    }
                    this._PropagateTo(h.next, state, value);
                }
            }
        }

        this._handlers = [];
        Object.Delete(_pr_store, str(this.id));

        let waiters = this._waiters;
        this._waiters = [];
        foreach (w in waiters) { Fiber.Unpark(Fiber.FromId(w)); }
        let timers = this._timers;
        this._timers = [];
        foreach (t in timers) { Fiber.Unpark(Fiber.FromId(t)); }
    }

    // ── Chaining ──────────────────────────────────────────────────────────────

    fn Then(onFulfilled:fn): instance {
        let next = new Promise();
        Array.Append(this._handlers, {
            onFulfilled: onFulfilled,
            onRejected: nil,
            onFinally: nil,
            next: next
        });

        if (this._state != "pending") { this._Dispatch(); }
        return next;
    }

    fn Catch(onRejected:fn): instance {
        let next = new Promise();
        Array.Append(this._handlers, {
            onFulfilled: nil,
            onRejected: onRejected,
            onFinally: nil,
            next: next
        });

        if (this._state != "pending") { this._Dispatch(); }
        return next;
    }

    fn ThenCatch(onFulfilled:fn, onRejected:fn): instance {
        let next = new Promise();
        Array.Append(this._handlers, {
            onFulfilled: onFulfilled,
            onRejected: onRejected,
            onFinally: nil,
            next: next
        });

        if (this._state != "pending") { this._Dispatch(); }
        return next;
    }

    fn Finally(onFinally:fn): instance {
        let next = new Promise();
        Array.Append(this._handlers, {
            onFulfilled: nil,
            onRejected: nil,
            onFinally: onFinally,
            next: next
        });

        if (this._state != "pending") { this._Dispatch(); }
        return next;
    }

    // ── Waiting ───────────────────────────────────────────────────────────────
    // A waiter adds its fiber id to _waiters and parks; _Dispatch unparks every
    // one. Ids, not fibers: holding the fiber here would make a reference cycle
    // through the waiter's own locals.

    fn _Wait() {
        let me = Fiber.Id();
        while (this._state == "pending") {
            Array.Append(this._waiters, me);
            Fiber.Park();
            this._Forget(me);
        }
    }

    fn _Forget(id:int) {
        if (len(this._waiters) == 0) { return; }
        let kept = [];
        foreach (w in this._waiters) {
            if (w != id) { Array.Append(kept, w); }
        }
        this._waiters = kept;
    }

    // Park until `ms` have passed or this promise settles (_Dispatch wakes the
    // _timers); true when the time ran out with it still pending.
    fn _ParkWhilePending(ms:int): bool {
        let me = Fiber.Id();
        let t0:int = Time.Ticks();
        while (this._state == "pending") {
            let left:int = ms - int(Time.TicksToMs(Time.Ticks() - t0));
            if (left <= 0) { return true; }
            Array.Append(this._timers, me);
            Fiber.Park(left);
            this._timers = Promise._Without(this._timers, me);
        }
        return false;
    }

    fn static _Without(ids:array, id:int): array {
        if (len(ids) == 0) { return ids; }
        let kept = [];
        foreach (w in ids) {
            if (w != id) { Array.Append(kept, w); }
        }
        return kept;
    }

    // Park until one of `promises` that is still pending settles.
    fn static _WaitAny(promises:array) {
        let me = Fiber.Id();
        foreach (p in promises) {
            if (p._state == "pending") { Array.Append(p._waiters, me); }
        }
        Fiber.Park();
        foreach (p in promises) { p._Forget(me); }
    }

    fn Await() {
        this._Wait();
        if (this._state != "resolved") { Promise._Raise(this._value); }
        return this._value;
    }

    // Throws a rejection reason: an Exception as itself, anything else as code 1.
    fn static _Raise(reason) {
        if (reason is Exception) { throw reason; }
        throw(1, str(reason));
    }

    fn AwaitResult(): object {
        this._Wait();
        return {
            ok: this._state == "resolved",
            state: this._state,
            value: this._value
        };
    }

    fn TryAwait(defaultValue) {
        this._Wait();
        if (this._state == "resolved") { return this._value; }
        return defaultValue;
    }

    fn Timeout(ms:int): instance {
        if (this._state != "pending") { return this; }

        let fid = Fiber.Run(_PromiseDelayedWorker);
        Fiber.SendMessage(Fiber.FromId(fid), {
            id: this.id,
            ms: ms,
            kind: "reject",
            value: "timeout after " + str(ms) + "ms"
        });
        return this;
    }

    fn CancelAfter(ms:int): instance {
        if (this._state != "pending") { return this; }

        let fid = Fiber.Run(_PromiseDelayedWorker);
        Fiber.SendMessage(Fiber.FromId(fid), {
            id: this.id,
            ms: ms,
            kind: "cancel",
            value: "canceled after " + str(ms) + "ms"
        });
        return this;
    }

    fn CancelNow(): instance {
        this.Cancel("canceled");
        return this;
    }

    // ── Static: pre-settled promises ─────────────────────────────────────────

    fn static Resolved(value): instance {
        let p = new Promise();
        p.Resolve(value);
        return p;
    }

    fn static Rejected(reason): instance {
        let p = new Promise();
        p.Reject(reason);
        return p;
    }

    fn static Canceled(reason): instance {
        let p = new Promise();
        p.Cancel(reason);
        return p;
    }

    fn static From(value): instance {
        return Promise.Resolved(value);
    }

    // ── Static: delayed settlement helpers ───────────────────────────────────

    fn static Delay(ms:int, value): instance {
        let p = new Promise();
        let fid = Fiber.Run(_PromiseDelayedWorker);
        Fiber.SendMessage(Fiber.FromId(fid), {
            id: p.id,
            ms: ms,
            kind: "resolve",
            value: value
        });
        return p;
    }

    fn static RejectAfter(ms:int, reason): instance {
        let p = new Promise();
        let fid = Fiber.Run(_PromiseDelayedWorker);
        Fiber.SendMessage(Fiber.FromId(fid), {
            id: p.id,
            ms: ms,
            kind: "reject",
            value: reason
        });
        return p;
    }

    fn static CancelAfterNew(ms:int, reason): instance {
        let p = new Promise();
        let fid = Fiber.Run(_PromiseDelayedWorker);
        Fiber.SendMessage(Fiber.FromId(fid), {
            id: p.id,
            ms: ms,
            kind: "cancel",
            value: reason
        });
        return p;
    }

    // ── Static: combinators (blocking helpers) ───────────────────────────────

    fn static All(promises:array): array {
        foreach (p in promises) { p._Wait(); }

        let results = [];
        foreach (p in promises) {
            if (p._state == "rejected" || p._state == "canceled") {
                Promise._Raise(p._value);
            }
            Array.Append(results, p._value);
        }
        return results;
    }

    fn static Race(promises:array) {
        while (true) {
            foreach (p in promises) {
                if (p._state != "pending") {
                    if (p._state == "rejected" || p._state == "canceled") {
                        Promise._Raise(p._value);
                    }
                    return p._value;
                }
            }
            Promise._WaitAny(promises);
        }
    }

    fn static FirstSettled(promises:array): object {
        while (true) {
            foreach (p in promises) {
                if (p._state != "pending") {
                    return { state: p._state, value: p._value };
                }
            }
            Promise._WaitAny(promises);
        }
    }

    fn static AllSettled(promises:array): array {
        foreach (p in promises) { p._Wait(); }

        let results = [];
        foreach (p in promises) {
            Array.Append(results, { state: p._state, value: p._value });
        }
        return results;
    }

    fn static Any(promises:array) {
        if (len(promises) == 0) {
            throw(1, "Promise.Any: empty array");
        }

        while (true) {
            let allSettled = true;
            foreach (p in promises) {
                if (p._state == "resolved") { return p._value; }
                if (p._state == "pending")  { allSettled = false; }
            }
            if (allSettled) {
                throw(1, "Promise.Any: all promises rejected or canceled");
            }
            Promise._WaitAny(promises);
        }
    }

    // ── Static: fiber-based work helpers ──────────────────────────────────────

    fn static Run(workFn:fn): instance {
        let p = new Promise();
        let fid = Fiber.Run(workFn);
        Fiber.SendMessage(Fiber.FromId(fid), p.id);
        return p;
    }

    fn static ReceiveId() {
        let self = Fiber.FromId(Fiber.Id());
        while (!Fiber.HasMessage(self)) { Fiber.Park(); }
        return Fiber.GetMessage(self);
    }

    fn static Notify(id:int, value) {
        let p = _pr_store[str(id)];
        if (p != nil) { p.Resolve(value); }
    }

    fn static Fail(id:int, reason) {
        let p = _pr_store[str(id)];
        if (p != nil) { p.Reject(reason); }
    }

    fn static CancelId(id:int, reason) {
        let p = _pr_store[str(id)];
        if (p != nil) { p.Cancel(reason); }
    }

    // ── Static: retry helper ──────────────────────────────────────────────────

    fn static Retry(fn_:fn, maxAttempts:int, delayMs:int): instance {
        let p   = new Promise();
        let fid = Fiber.Run(_PromiseRetryWorker);
        Fiber.SendMessage(Fiber.FromId(fid), {
            id:          p.id,
            fn_:         fn_,
            maxAttempts: maxAttempts,
            delayMs:     delayMs
        });
        return p;
    }
}

export {Promise};
