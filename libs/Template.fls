// Template.fls - Mustache-style string template engine for Flaris.
// Version: 1.0
//
// Usage:
//   import { Template } from library("Template", "1.0");
//
//   // Compile once, render many times - the cheaper way to render repeatedly
//   let t = Template.Parse("Hello, {{name}}! You have {{count}} messages.");
//   Console.WriteLine(t.Render({ name: "Alice", count: 3 }));
//
//   // One-shot render (parse + render in a single call)
//   let html = Template.Apply("<ul>{{#each items}}<li>{{.}}</li>{{/each}}</ul>",
//                             { items: ["a", "b", "c"] });
//
//   // Partials - register a named sub-template, then include it with {{> name}}
//   Template.Register("nav", Template.Parse("<nav>{{title}}</nav>"));
//   let page = Template.Apply("{{> nav}}<main>{{body}}</main>",
//                             { title: "Home", body: "Welcome" });
//
// Template syntax:
//   {{key}}                     Variable - HTML-escaped (&, <, >, ", ')
//   {{{key}}}                   Raw variable - no escaping
//   {{key.nested.path}}         Dot-path: walks object properties
//   {{#if key}}…{{/if}}         Conditional (falsy: nil, false, 0, "", [])
//   {{#if key}}…{{#else}}…{{/if}}  Conditional with else branch
//   {{#unless key}}…{{/unless}} Inverse conditional (renders when key is falsy)
//   {{#each items}}…{{/each}}   Iteration over an array
//     Inside each:  {{.}}       current item value
//                   {{_index}}  0-based position
//                   {{_first}}  true on first iteration
//                   {{_last}}   true on last iteration
//                   {{_count}}  total number of items
//   {{> name}}                  Partial - renders a registered template by name
//   {{! comment }}              Comment - stripped from output
//
// Inside each, {{.}} on a nil item renders nothing. Parse (and Apply) raise
// TemplateError (Code Exception.InvalidArguments) when a close tag does not
// match the block it ends ({{#if a}}…{{/each}}), when {{/if}}, {{/each}},
// {{/unless}} or {{#else}} has no block of its own to end, and when a block is
// never closed. An unclosed "{{" is text.
//
// API:
//   Template.Parse(src)                →  Template instance
//   Template.Apply(src, data)          →  string  (parse + render in one call)
//   Template.Register(name, template)  - register a named partial globally
//   Template.GetPartial(name)          →  Template instance or nil
//   instance.Render(data)              →  string

global _tpl_partials = {};

class TemplateError : Exception {}

class Template {
    let _nodes = nil; 

    fn Constructor(nodes) {
        this._nodes = nodes;
    }

    // Compile a template source string into a reusable Template.
    fn static Parse(src:string) {
        let c = { s: src, p: 0, n: String.Length(src) };
        let r = Template._parseBlock(c, "");
        return new Template(r.nodes);
    }

    // Render this template with data as the root context.
    fn Render(data) {
        var parts = [];
        Template._render(this._nodes, data, parts);
        return String.Join(parts, "");
    }

    // One-shot: parse and render in a single call.
    fn static Apply(src:string, data) {
        return Template.Parse(src).Render(data);
    }

    // Register a named partial template for use with {{> name}}.
    fn static Register(name:string, tpl:instance) {
        _tpl_partials[name] = tpl;
    }

    // Look up a registered partial by name; returns nil if not found.
    fn static GetPartial(name:string) {
        return Object.TryGet(_tpl_partials, name, nil);
    }

    // =========================================================================
    // Parser - produces an AST (array of node objects)
    //
    // Node shapes. Every AST node carries two tags for the same thing: `t`, a
    // readable name that keeps a dumped AST self-describing, and `k`, the small
    // integer _render switches on. A new node kind has to set both.
    //
    //   k = 0 text   1 var   2 raw   3 if   4 unless   5 partial   6 each
    //
    //   { t:"x",       k:0, v:"..." }                 literal text
    //   { t:"var",     k:1, path:[...], m:bool }      escaped variable
    //   { t:"raw",     k:2, path:[...], m:bool }      unescaped variable
    //   { t:"if",      k:3, path:[...], m:bool, thn:[...], els:[...] }
    //   { t:"unless",  k:4, path:[...], m:bool, body:[...] }
    //   { t:"each",    k:6, path:[...], m:bool, body:[...] }
    //   { t:"partial", k:5, name:"..." }              partial reference
    //
    // m is true when path[0] is a loop meta-variable (_index, _first, _last, _count).
    //
    // The tags the parser consumes itself - "comment", "else", "end_if",
    // "end_each", "end_unless" - never reach the AST and carry no `k`.
    //
    // _parseBlock returns { nodes:[...], stop: nil | "else" | "end_if" | "end_each" | "end_unless" }
    // `open` names the block being read: "" at the top, "if", "else" (the else
    // part of an if), "unless" or "each"; a stop tag that does not end it raises.
    // =========================================================================

    fn static _parseBlock(c, open:string) {
        var nodes = [];
        while (c.p < c.n) {
            let tagPos = Template._find(c.s, "{{", c.p);
            if (tagPos < 0) {
                Array.Append(nodes, { t: "x", k: 0, v: String.Substr(c.s, c.p) });
                c.p = c.n;
                break;
            }
            if (tagPos > c.p) {
                Array.Append(nodes, { t: "x", k: 0, v: String.Substr(c.s, c.p, tagPos - c.p) });
            }
            c.p = tagPos;

            let tag = Template._readTag(c);

            if (tag.t == "x" || tag.t == "var" || tag.t == "raw" || tag.t == "partial") {
                Array.Append(nodes, tag);
            } else if (tag.t == "if") {
                let then_r = Template._parseBlock(c, "if");
                var els = [];
                if (then_r.stop == "else") {
                    let else_r = Template._parseBlock(c, "else");
                    els = else_r.nodes;
                }
                Array.Append(nodes, { t: "if", k: 3, path: tag.path, m: tag.m, thn: then_r.nodes, els: els });
            } else if (tag.t == "unless") {
                let body_r = Template._parseBlock(c, "unless");
                Array.Append(nodes, { t: "unless", k: 4, path: tag.path, m: tag.m, body: body_r.nodes });
            } else if (tag.t == "each") {
                let body_r = Template._parseBlock(c, "each");
                Array.Append(nodes, { t: "each", k: 6, path: tag.path, m: tag.m, body: body_r.nodes });
            } else if (tag.t == "else" || tag.t == "end_if" || tag.t == "end_each" || tag.t == "end_unless") {
                if (!Template._ends(open, tag.t)) {
                    let what = (open == "") ? " has no open block to end"
                                            : " does not end " + Template._openTag(open);
                    throw new TemplateError(Exception.InvalidArguments,
                        "Template: " + Template._stopTag(tag.t) + what + " (offset " + str(c.p) + ")");
                }
                return { nodes: nodes, stop: tag.t };
            }
            // tag.t == "comment" - stripped, no action
        }
        if (open != "") {
            throw new TemplateError(Exception.InvalidArguments,
                "Template: " + Template._openTag(open) + " is never closed");
        }
        return { nodes: nodes, stop: nil };
    }

    fn static _ends(open:string, stop:string): bool {
        if (stop == "else")       return open == "if";
        if (stop == "end_if")     return open == "if" || open == "else";
        if (stop == "end_each")   return open == "each";
        if (stop == "end_unless") return open == "unless";
        return false;
    }

    fn static _openTag(open:string): string {
        if (open == "else") return "{{#if}}…{{#else}}";
        return "{{#" + open + "}}";
    }

    fn static _stopTag(stop:string): string {
        if (stop == "else") return "{{#else}}";
        return "{{/" + String.Substr(stop, 4) + "}}";
    }

    // Read one tag starting at c.p (which must point at "{{").
    // Advances c.p past the closing "}}".
    fn static _readTag(c) {
        c.p += 2;
        let raw = c.p < c.n && String.CharAt(c.s, c.p) == '{';
        if (raw) c.p += 1;

        let closeStr = raw ? "}}}" : "}}";
        let closePos = Template._find(c.s, closeStr, c.p);
        if (closePos < 0) {
            let v = String.Substr(c.s, c.p - (raw ? 3 : 2));
            c.p = c.n;
            return { t: "x", k: 0, v: v };
        }

        let inner = String.Trim(String.Substr(c.s, c.p, closePos - c.p));
        c.p = closePos + String.Length(closeStr);

        if (raw)                                   return Template._pathTag("raw", 2, inner);
        if (String.StartsWith(inner, "!"))         return { t: "comment" };
        if (inner == "#else")                      return { t: "else" };
        if (inner == "/if")                        return { t: "end_if" };
        if (inner == "/each")                      return { t: "end_each" };
        if (inner == "/unless")                    return { t: "end_unless" };
        if (String.StartsWith(inner, "#if "))      return Template._pathTag("if",     3, String.Trim(String.Substr(inner, 4)));
        if (String.StartsWith(inner, "#unless "))  return Template._pathTag("unless", 4, String.Trim(String.Substr(inner, 8)));
        if (String.StartsWith(inner, "#each "))    return Template._pathTag("each",   6, String.Trim(String.Substr(inner, 6)));
        if (String.StartsWith(inner, "> "))        return { t: "partial", k: 5, name: String.Trim(String.Substr(inner, 2)) };
        return Template._pathTag("var", 1, inner);
    }

    // A tag naming a data path. Paths split on dots:
    // "user.name" - ["user", "name"],  "." - ["."],  "title" - ["title"]
    fn static _pathTag(t:string, k:int, key:string) {
        let path = (key != "." && String.Contains(key, ".")) ? String.Split(key, ".") : [key];
        let p0 = path[0];
        return { t: t, k: k, path: path, m: p0 == "_index" || p0 == "_first" || p0 == "_last" || p0 == "_count" };
    }

    fn static _isMeta(key:string): bool {
        return key == "_index" || key == "_first" || key == "_last" || key == "_count";
    }

    // Index of needle at or after pos, or -1 (also for pos past the end).
    fn static _find(src:string, needle:string, pos:int): int {
        if (pos >= String.Length(src)) return -1;
        return String.IndexOfFrom(src, needle, pos);
    }

    // =========================================================================
    // Renderer
    // =========================================================================

    fn static _render(nodes, ctx, parts) {
        iter (i from 0 to len(nodes)) {
            let node = nodes[i];

            let k = node.k;
            if (k == 0) {
                Array.Append(parts, node.v);

            } else if (k == 1) {
                let val = Template._resolve(node, ctx);
                if (val != nil) {
                    // Most values hold none of the five escaped characters and
                    // go out as they are.
                    let sv = str(val);
                    Array.Append(parts, (String.IndexOfAnyFrom(sv, "&<>\"'", 0) < 0) ? sv : Template._escape(sv));
                }

            } else if (k == 2) {
                let val = Template._resolve(node, ctx);
                if (val != nil) Array.Append(parts, str(val));

            } else if (k == 3) {
                if (Template._truthy(Template._resolve(node, ctx))) {
                    Template._render(node.thn, ctx, parts);
                } else {
                    Template._render(node.els, ctx, parts);
                }

            } else if (k == 4) {
                if (!Template._truthy(Template._resolve(node, ctx))) {
                    Template._render(node.body, ctx, parts);
                }

            } else if (k == 5) {
                let partial = Template.GetPartial(node.name);
                if (partial != nil) {
                    Template._render(partial._nodes, ctx, parts);
                }

            } else if (k == 6) {
                let items = Template._resolve(node, ctx);
                if (items != nil && type(items) == Type.Array) {
                    let count = len(items);
                    // One frame per loop, refilled per item. _parent is assigned,
                    // not written into the literal: a literal walks everything
                    // its values reach, and ctx reaches the whole data tree.
                    let frame = { _value: nil, _index: 0, _first: true, _last: false, _count: count };
                    frame._parent = ctx;
                    iter (j from 0 to count) {
                        frame._value = items[j];
                        frame._index = j;
                        frame._first = j == 0;
                        frame._last  = j == count - 1;
                        Template._render(node.body, frame, parts);
                    }
                }
            }
        }
    }

    // Resolve a dot-path against a context.
    //
    // ctx is either the root data object or an each-frame:
    //   { _value, _index, _first, _last, _count, _parent }
    //
    // Resolution order:
    //   "."              - current item (_value, or ctx itself at root)
    //   _index/_first/…  - loop meta-vars from the each-frame
    //   key              - property on _value (if object), then ctx, then _parent
    fn static _resolve(node, ctx) {
        return Template._resolveAt(node.path, 0, node.m, ctx);
    }

    // _resolve for the path segments from index `at` on; meta = path[at] is a
    // loop meta-variable.
    fn static _resolveAt(path, at:int, meta:bool, ctx) {
        if (ctx == nil || path == nil || len(path) <= at) return nil;
        if (type(ctx) != Type.Object) return nil;

        let key  = path[at];
        let more = len(path) - at > 1;

        // "." = the current iteration item - nil included - in an each-frame
        // (which always holds _value), the data itself at the root.
        if (key == ".") {
            let dot = Object.HasKey(ctx, "_value") ? ctx._value : ctx;
            if (more) return Template._resolveAt(path, at + 1, Template._isMeta(path[at + 1]), dot);
            return dot;
        }

        // Loop meta-variables
        if (meta) {
            let mv = Object.TryGet(ctx, key, nil);
            if (mv != nil) return mv;
            let par0 = Object.TryGet(ctx, "_parent", nil);
            if (par0 != nil) return Template._resolveAt(path, at, true, par0);
            return nil;
        }

        // Inside an each-frame: try the item's properties first
        var val = nil;
        let item = Object.TryGet(ctx, "_value", nil);
        if (item != nil && type(item) == Type.Object) {
            val = Object.TryGet(item, key, nil);
        }

        // Fall back to the context frame / root data, then walk up the parent chain
        if (val == nil) {
            val = Object.TryGet(ctx, key, nil);
            if (val == nil) {
                let par = Object.TryGet(ctx, "_parent", nil);
                if (par != nil) return Template._resolveAt(path, at, false, par);
                return nil;
            }
        }

        // Traverse remaining path segments into the resolved value
        if (more) return Template._resolveAt(path, at + 1, Template._isMeta(path[at + 1]), val);

        return val;
    }

    // Falsy: nil, false, 0, 0.0, "", [].  Everything else is truthy.
    fn static _truthy(val) {
        if (val == nil)   return false;
        if (val == false) return false;
        if (type(val) == Type.Int    && val == 0)   return false;
        if (type(val) == Type.Float  && val == 0.0) return false;
        if (type(val) == Type.String && val == "")  return false;
        if (type(val) == Type.Array  && len(val) == 0) return false;
        return true;
    }

    // HTML-escape: s with & < > " ' replaced by &amp; &lt; &gt; &quot; &#39;,
    // in one pass.
    fn static _escape(s:string): string {
        let n  = len(s);
        var sz = n;
        iter (i from 0 to n) {
            let c = s[i];
            if (c == '&' || c == '\'') {
                sz += 4;
            } else if (c == '<' || c == '>') {
                sz += 3;
            } else if (c == '"') {
                sz += 5;
            }
        }
        let out = String.Create(sz);
        var k   = 0;
        iter (i from 0 to n) {
            let c = s[i];
            if (c == '&' || c == '<' || c == '>' || c == '"' || c == '\'') {
                out[k] = '&';
                if (c == '&') {
                    out[k + 1] = 'a';
                    out[k + 2] = 'm';
                    out[k + 3] = 'p';
                    k += 4;
                } else if (c == '<' || c == '>') {
                    out[k + 1] = (c == '<') ? 'l' : 'g';
                    out[k + 2] = 't';
                    k += 3;
                } else if (c == '"') {
                    out[k + 1] = 'q';
                    out[k + 2] = 'u';
                    out[k + 3] = 'o';
                    out[k + 4] = 't';
                    k += 5;
                } else {
                    out[k + 1] = '#';
                    out[k + 2] = '3';
                    out[k + 3] = '9';
                    k += 4;
                }
                out[k] = ';';
                k += 1;
            } else {
                out[k] = c;
                k += 1;
            }
        }
        return out;
    }
}
export { Template, TemplateError };
