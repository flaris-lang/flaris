// Treemap.fls - Sorted key-value map for Flaris.
// Version: 1.0
//
// Keys are kept in ascending sorted order at all times.
// Backed by a sorted array of keys plus a HashMap of values. Get / Has are one
// hash lookup; ordered queries (Rank, Floor, Range, ...) binary-search the key
// array with Array.BinarySearch, so they are O(log n) (+ k for the entries a
// range returns). Inserting or deleting a new key is a native O(log n) search
// plus a memmove of the keys after it; updating an existing key is O(1).
//
// One key type per instance: int/bool/char, float, or string. Keys of
// different types cannot be mixed in the same map. Within the int/bool/char
// group the order is the language's default order (bools, then ints, then
// chars), so true, 1 and '1' are three distinct keys, as in a HashMap.
//
// Usage:
//   import { TreeMap } from library("Treemap", "1.0");
//
//   let m = new TreeMap();
//   m.Set("banana", 2).Set("apple", 5).Set("cherry", 1);
//   Console.WriteLine(m.MinKey());      // "apple"
//   Console.WriteLine(m.MaxKey());      // "cherry"
//
//   foreach (e in m.Entries()) {        // sorted: apple, banana, cherry
//       Console.WriteLine(e.Key, e.Value);
//   }
//
//   // Range: keys from "b" (inclusive) to "c" (exclusive)
//   let sub = m.Range("b", "c", true, false);
//
// Core operations:
//   Set(key, value)              - insert or update; returns this
//   Get(key)                     →  value or nil
//   GetOr(key, default)          →  value or default
//   Has(key)                     →  bool
//   Delete(key)                  →  bool
//   PutIfAbsent(key, value)      →  bool (true if inserted)
//   Replace(key, value)          →  bool (true if key existed)
//   Size()  IsEmpty()  Clear()
//   Clone()                      →  new TreeMap
//
// Min/max:
//   MinKey()  MaxKey()   - also aliased as FirstKey() / LastKey()
//   MinEntry()  MaxEntry()  - { Key, Value }
//   DeleteMin()  DeleteMax()  →  bool
//   PopMin()  PopMax()   →  { Key, Value } removed, or nil when empty
//
// Ordered access (every entry is an object { Key, Value }):
//   Keys()        →  array in ascending order (a copy)
//   Values()      →  array in key order
//   Entries()     →  array of { Key, Value } in key order
//   ReverseEntries()
//   Range(minKey, maxKey, includeMin?, includeMax?)  →  array of { Key, Value }
//                 (includeMin default true, includeMax default false: [minKey, maxKey))
//   HeadEntries(toKey, inclusive?)   - entries with key <= (or <) toKey; default inclusive
//   TailEntries(fromKey, inclusive?) - entries with key >= (or >) fromKey; default inclusive
//   CountRange(lo, hi)  →  int  - number of keys in [lo, hi]
//   Rank(key)     →  int  - number of keys strictly less than key (present or not)
//   Select(rank)  →  key at given rank
//   FloorKey(k) CeilKey(k)   - greatest key <= k / least key >= k, or nil
//   PrevKey(k)  NextKey(k)   - greatest key < k / least key > k, or nil
//                              (aliases LowerKey / HigherKey)
//
// Iteration:
//   ForEach(fn(key, value))          - ascending order; returns this
//   EachKey(fn(key))                 - returns this
//   EachValue(fn(value))             - returns this

class TreeMap {
    let _keyType: int = 0;      // key group of the keys held: 0 none yet, see _groupOf
    let _keys: array = nil;     // ascending, in the default order Array.BinarySearch uses
    let _map = nil;             // key -> value
    fn Constructor() {
        this._keys    = [];
        this._map     = Collections.HashMap();
        this._keyType = 0;
    }

    // ---------- Key groups ----------

    // 1 int/bool/char, 2 float, 3 string, -1 anything else.
    fn static _groupOf(key): int {
        let t = type(key);
        if (t == Type.Int || t == Type.Bool || t == Type.Char) return 1;
        if (t == Type.Float) return 2;
        if (t == Type.String) return 3;
        return -1;
    }

    // Raise unless `key` may live in this map. Only an insert passes `adopt`,
    // so a query on an empty map never sets the key group.
    fn _checkKeyType(key, adopt:bool) {
        let g:int = TreeMap._groupOf(key);
        if (g < 0) {
            throw(400, "TreeMap: invalid key type");
        }
        if (this._keyType == 0) {
            if (adopt) { this._keyType = g; }
            return;
        }
        if (this._keyType != g) {
            throw(400, "TreeMap: mixed key types not allowed");
        }
    }

    // Index of the first key >= key (inclusive) or > key (exclusive).
    fn _lowerIndex(key, inclusive:bool): int {
        let idx:int = Array.BinarySearch(this._keys, key);
        if (idx < 0) return 0 - idx - 1;
        return inclusive ? idx : idx + 1;
    }

    // Index just past the last key <= key (inclusive) or < key (exclusive).
    fn _upperIndex(key, inclusive:bool): int {
        let idx:int = Array.BinarySearch(this._keys, key);
        if (idx < 0) return 0 - idx - 1;
        return inclusive ? idx + 1 : idx;
    }

    fn _entryAt(index:int) {
        if (index < 0 || index >= len(this._keys)) return nil;
        let k = this._keys[index];
        return { Key: k, Value: this._map.Get(k) };
    }

    // Entries for key indexes [from, to).
    fn _entries(from:int, to:int): array {
        let result = [];
        let keys = this._keys;
        let map  = this._map;
        var i:int = from;
        while (i < to) {
            let k = keys[i];
            Array.Append(result, { Key: k, Value: map.Get(k) });
            i += 1;
        }
        return result;
    }

    // ---------- Core API ----------

    fn Set(key, value): instance {
        this._checkKeyType(key, true);
        if (!this._map.Has(key)) { Array.SortedInsert(this._keys, key); }
        this._map.Set(key, value);
        return this;
    }

    fn PutIfAbsent(key, value): bool {
        this._checkKeyType(key, true);
        if (this._map.Has(key)) return false;
        Array.SortedInsert(this._keys, key);
        this._map.Set(key, value);
        return true;
    }

    fn Replace(key, value): bool {
        if (!this._map.Has(key)) return false;
        this._map.Set(key, value);
        return true;
    }

    fn Get(key)                 { return this._map.Get(key); }
    fn GetOr(key, defaultValue) {
        let v = this._map.Get(key);
        if (v == nil) return defaultValue;
        return v;
    }

    fn Has(key): bool { return this._map.Has(key); }

    fn Delete(key): bool {
        if (!this._map.Has(key)) return false;
        Array.RemoveAt(this._keys, Array.BinarySearch(this._keys, key));
        this._map.Delete(key);

        if (len(this._keys) == 0) {
            this._keyType = 0;
        }
        return true;
    }

    fn DeleteMin(): bool {
        let k = this.MinKey();
        if (k == nil) return false;
        return this.Delete(k);
    }

    fn DeleteMax(): bool {
        let k = this.MaxKey();
        if (k == nil) return false;
        return this.Delete(k);
    }

    fn Clear() {
        this._keys    = [];
        this._map     = Collections.HashMap();
        this._keyType = 0;
    }

    // Values are shared with the original, not copied.
    fn Clone(): instance {
        let m = new TreeMap();
        m._keyType = this._keyType;
        m._keys    = Array.Clone(this._keys);
        let src = this._map;
        let dst = m._map;
        foreach (k in this._keys) {
            dst.Set(k, src.Get(k));
        }
        return m;
    }

    fn Size(): int      { return len(this._keys); }
    fn IsEmpty(): bool  { return len(this._keys) == 0; }

    // ---------- Ordered basics ----------

    fn MinKey() {
        if (len(this._keys) == 0) return nil;
        return this._keys[0];
    }

    fn MaxKey() {
        let n = len(this._keys);
        if (n == 0) return nil;
        return this._keys[n - 1];
    }

    fn FirstKey() { return this.MinKey(); }
    fn LastKey()  { return this.MaxKey(); }

    fn MinEntry() {
        return this._entryAt(0);
    }

    fn MaxEntry() {
        return this._entryAt(len(this._keys) - 1);
    }

    fn FirstEntry() { return this.MinEntry(); }
    fn LastEntry()  { return this.MaxEntry(); }

    fn Keys(): array { return Array.Clone(this._keys); }

    fn KeySet(): array { return this.Keys(); }

    fn Values(): array {
        let result = [];
        let map = this._map;
        foreach (k in this._keys) {
            Array.Append(result, map.Get(k));
        }
        return result;
    }

    fn Entries(): array { return this._entries(0, len(this._keys)); }

    fn ReverseEntries(): array {
        let result = this.Entries();
        Array.Reverse(result);
        return result;
    }

    fn Range(minKey, maxKey, includeMin?:bool, includeMax?:bool): array {
        if (includeMin == nil) includeMin = true;
        if (includeMax == nil) includeMax = false;

        this._checkKeyType(minKey, false);
        this._checkKeyType(maxKey, false);
        if (TreeMap._groupOf(minKey) != TreeMap._groupOf(maxKey)) {
            throw(400, "TreeMap: mixed key types not allowed");
        }

        let from:int = this._lowerIndex(minKey, includeMin);
        let to:int   = this._upperIndex(maxKey, includeMax);
        if (from >= to) return [];
        return this._entries(from, to);
    }

    fn HeadEntries(toKey, inclusive?:bool): array {
        if (inclusive == nil) inclusive = true;
        if (len(this._keys) == 0) return [];

        this._checkKeyType(toKey, false);
        return this._entries(0, this._upperIndex(toKey, inclusive));
    }

    fn TailEntries(fromKey, inclusive?:bool): array {
        if (inclusive == nil) inclusive = true;
        if (len(this._keys) == 0) return [];

        this._checkKeyType(fromKey, false);
        return this._entries(this._lowerIndex(fromKey, inclusive), len(this._keys));
    }

    fn ForEach(fnIter:fn): instance {
        foreach (k in this._keys) {
            fnIter(k, this._map.Get(k));
        }
        return this;
    }

    fn EachKey(fnIter:fn): instance {
        foreach (k in this._keys) {
            fnIter(k);
        }
        return this;
    }

    fn EachValue(fnIter:fn): instance {
        foreach (k in this._keys) {
            fnIter(this._map.Get(k));
        }
        return this;
    }

    // ---------- Rank / select ----------

    fn Rank(key): int { return this._lowerIndex(key, true); }

    fn Select(rank:int) {
        if (rank < 0 || rank >= len(this._keys)) return nil;
        return this._keys[rank];
    }

    fn SelectEntry(rank:int) {
        return this._entryAt(rank);
    }

    // ---------- Ordered neighbor helpers ----------

    fn FloorKey(key) {
        if (len(this._keys) == 0) return nil;
        this._checkKeyType(key, false);
        let i:int = this._upperIndex(key, true);
        if (i == 0) return nil;
        return this._keys[i - 1];
    }

    fn CeilKey(key) {
        if (len(this._keys) == 0) return nil;
        this._checkKeyType(key, false);
        let i:int = this._lowerIndex(key, true);
        if (i >= len(this._keys)) return nil;
        return this._keys[i];
    }

    fn PrevKey(key) {
        if (len(this._keys) == 0) return nil;
        this._checkKeyType(key, false);
        let i:int = this._lowerIndex(key, true);
        if (i == 0) return nil;
        return this._keys[i - 1];
    }

    fn NextKey(key) {
        if (len(this._keys) == 0) return nil;
        this._checkKeyType(key, false);
        let i:int = this._upperIndex(key, true);
        if (i >= len(this._keys)) return nil;
        return this._keys[i];
    }

    fn LowerKey(key)  { return this.PrevKey(key); }
    fn HigherKey(key) { return this.NextKey(key); }

    fn PopMin() {
        let k = this.MinKey();
        if (k == nil) return nil;
        let v = this._map.Get(k);
        this.Delete(k);
        return { Key: k, Value: v };
    }

    fn PopMax() {
        let k = this.MaxKey();
        if (k == nil) return nil;
        let v = this._map.Get(k);
        this.Delete(k);
        return { Key: k, Value: v };
    }

    // ---------- Search / utility ----------

    fn CountWhere(fnPred:fn): int {
        let count = 0;
        foreach (k in this._keys) {
            if (fnPred(k, this._map.Get(k))) {
                count = count + 1;
            }
        }
        return count;
    }

    fn Find(fnPred:fn) {
        foreach (k in this._keys) {
            let v = this._map.Get(k);
            if (fnPred(k, v)) {
                return { Key: k, Value: v };
            }
        }
        return nil;
    }

    fn Equals(other): bool {
        if (other == nil) return false;
        if (this.Size() != other.Size()) return false;

        let n = len(this._keys);
        iter (i from 0 to n) {
            let k = this._keys[i];
            if (other.Has(k) == false) return false;
            if (other.Get(k) != this._map.Get(k)) return false;
        }
        return true;
    }

    fn ToString(): string {
        let s = "{";
        let n = len(this._keys);
        iter (i from 0 to n) {
            let k = this._keys[i];
            if (i > 0) s = s + ", ";
            s = s + str(k) + ": " + str(this._map.Get(k));
        }
        s = s + "}";
        return s;
    }

    fn Merge(other:instance): instance {
        let entries = other.Entries();
        iter (i from 0 to len(entries)) {
            let e = entries[i];
            this.Set(e.Key, e.Value);
        }
        return this;
    }

    fn CountRange(lo, hi): int {
        let n:int = this._upperIndex(hi, true) - this._lowerIndex(lo, true);
        return (n > 0) ? n : 0;
    }

    fn static FromEntries(entries:array): instance {
        let tm = new TreeMap();
        iter (i from 0 to len(entries)) {
            tm.Set(entries[i][0], entries[i][1]);
        }
        return tm;
    }
}

export TreeMap;
