// WebSocket.fls - WebSocket client and server side for Flaris.
// Version: 1.0
//
// Implements RFC 6455 handshake and framing, for both directions: WebSocket
// connects as a client, and Ws.Accept upgrades a socket an HTTP server has
// handed over (see HttpResponse.Hijack in HttpServer). The two differ only in
// masking - a client masks what it sends, a server must not, and a server must
// refuse an unmasked frame from a client.
//
// Runs in the default sandbox: no --unsafe flag is needed.
// Supports text and binary frames, ping/pong, clean close, and ws:// + wss://
// (wss:// uses the OS-native TLS in Stream.ConnectTls - no extra setup).
// Limitations: no fragmentation, no compression.
//
// Usage:
//   import { Ws } from library("WebSocket", "1.0");
//
//   let ws = Ws.Connect("echo.websocket.org", 80, "/");
//   if (ws == nil) { Console.WriteLine("connection failed"); }
//
//   ws.SendText("hello");
//   let msg = ws.Receive();       // { opcode, data, isBinary }
//   Console.WriteLine(msg.data);  // "hello" (echo server)
//
//   ws.Ping();
//   ws.Close(1000, "bye");
//   ws.IsOpen();                  // false after close
//
// Connecting:
//   WebSocket.Connect(host, port, path?, extraHeaders?, secure?)  →  instance (throws on failure)
//   WebSocket.ConnectUrl(url, extraHeaders?)  →  instance   - "ws://..." or "wss://..."
//   - path defaults to "/"; secure=true upgrades the transport to TLS (wss://)
//   - extraHeaders is an optional object: { "Authorization": "Bearer ..." }
//   wss:// runs over Stream.ConnectTls (no plugin, no --unsafe).
//
// Sending:
//   SendText(text)       →  bool
//   SendBinary(block)    →  bool
//   SendJson(value)      →  bool  - Json.Stringify(value) then SendText
//
// Receiving:
//   Receive()            →  { opcode:int, data:string|block, isBinary:bool } or nil
//   ReceiveText()        →  string or nil  - expects text frame
//   ReceiveJson()        →  parsed object or nil
//   ReceiveWhenReady(timeoutMs?)     →  message or nil on timeout - suspends
//                                        only the calling fiber, so other
//                                        fibers keep running while it waits
//   ReceiveTextWhenReady(timeoutMs?) →  string or nil on timeout
//
// Limits:
//   SetMaxMessageBytes(bytes)  →  this  - largest payload accepted (default
//       16 MiB). A peer that declares more gets close code 1009 and the
//       connection ends without allocating the declared size.
//
// Control:
//   Ping(data?)          →  bool
//   Pong(data?)          →  bool
//   Close(code?, reason?) - sends close frame; code default 1000
//   IsOpen()             →  bool
//   CloseCode()          →  int
//   CloseReason()        →  string
//
// Opcodes (static constants):
//   Ws.OpcodeText()  Ws.OpcodeBinary()  Ws.OpcodePing()
//   Ws.OpcodePong()  Ws.OpcodeClose()   Ws.OpcodeCont()

import { Util } from library("Util", "1.0");

// Frame opcodes (RFC 6455 5.2), as the Ws.Opcode*() accessors return them.
const WS_OP_CONT   = 0x0;
const WS_OP_TEXT   = 0x1;
const WS_OP_BINARY = 0x2;
const WS_OP_CLOSE  = 0x8;
const WS_OP_PING   = 0x9;
const WS_OP_PONG   = 0xA;

class Ws {
    fn static Guid(): string {
        return "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
    }

    fn static OpcodeCont(): int   { return WS_OP_CONT; }
    fn static OpcodeText(): int   { return WS_OP_TEXT; }
    fn static OpcodeBinary(): int { return WS_OP_BINARY; }
    fn static OpcodeClose(): int  { return WS_OP_CLOSE; }
    fn static OpcodePing(): int   { return WS_OP_PING; }
    fn static OpcodePong(): int   { return WS_OP_PONG; }

    fn static EnsurePath(path: string): string {
        if (path == nil || path == "") return "/";
        if (String.StartsWith(path, "/")) return path;
        return "/" + path;
    }

    fn static MakeClientKey(): string {
        let raw = Crypto.RandomBytes(16);
        return Util.Base64Encode(raw);
    }

    fn static MakeAccept(clientKey: string): string {
        let sha1Hex = Hash.Sha1(clientKey + Ws.Guid());
        let raw = Util.HexToBin(sha1Hex);
        return Util.Base64Encode(raw);
    }

    fn static ParseHeaderLine(line: string): array {
        let idx = String.IndexOf(line, ":");
        if (idx < 0) return ["", ""];

        let name = String.ToLower(String.Trim(String.Left(line, idx)));
        let value = String.Trim(String.Substr(line, idx + 1));
        return [name, value];
    }

    fn static BuildRequest(host: string, path: string, key: string, extraHeaders): string {
        let lines = [];
        Array.Append(lines, "GET " + path + " HTTP/1.1");
        Array.Append(lines, "Host: " + host);
        Array.Append(lines, "Upgrade: websocket");
        Array.Append(lines, "Connection: Upgrade");
        Array.Append(lines, "Sec-WebSocket-Version: 13");
        Array.Append(lines, "Sec-WebSocket-Key: " + key);

        if (extraHeaders != nil) {
            foreach (v, k in extraHeaders) {
                Array.Append(lines, str(k) + ": " + str(v));
            }
        }

        return String.Join(lines, "\r\n") + "\r\n\r\n";
    }

    fn static ReadHttpHeaders(sock: stream): object {
        // Park until the peer has actually replied. A ReadLine on a blocking
        // socket would hold up every fiber while it waited - and against a
        // server sharing this VM, the server fiber would never get a turn to
        // write the reply. WaitReadable waits for this fiber alone, and leaves
        // the socket non-blocking so the reads after it park the same way.
        if (Stream.WaitReadable(sock, 15000) != true) {
            return { _statusLine: "" };
        }
        let statusLine = Stream.ReadLine(sock);
        let headers = { _statusLine: statusLine };

        while (true) {
            let line = Stream.ReadLine(sock);
            if (line == nil || line == "") break;

            let kv = Ws.ParseHeaderLine(line);
            if (kv[0] != "") {
                headers[kv[0]] = kv[1];
            }
        }

        return headers;
    }

    fn static StringToBlock(text: string): block {
        return Buffer.FromString(text);
    }

    fn static BlockToString(buf: block): string {
        return Buffer.ToString(buf);
    }

    fn static ReadU16BE(buf: block, off: int): int {
        let b0 = Buffer.ReadU8At(buf, off);
        let b1 = Buffer.ReadU8At(buf, off + 1);
        return u16((b0 << 8) | b1);
    }

    fn static WriteU16BE(buf: block, off: int, v: int) {
        Buffer.WriteU8At(buf, off, v >> 8);
        Buffer.WriteU8At(buf, off + 1, v);
    }

    fn static ReadU64BE(buf: block, off: int): int {
        let v = 0;
        let i = 0;
        while (i < 8) {
            v = (v << 8) | Buffer.ReadU8At(buf, off + i);
            i += 1;
        }
        return v;
    }

    fn static WriteU64BE(buf: block, off: int, v: int) {
        let i = 7;
        while (i >= 0) {
            Buffer.WriteU8At(buf, off + i, v);
            v = v >> 8;
            i -= 1;
        }
    }

    fn static XorMaskInPlace(buf: block, mask: block, count: int) {
        Ws.XorMaskRangeInPlace(buf, 0, mask, count);
    }

    fn static XorMaskRangeInPlace(buf: block, start: int, mask: block, count: int) {
        Ws.XorWordInPlace(buf, start, Buffer.ReadU32At(mask, 0), count);
    }

    // `m` is the masking key as Buffer.ReadU32At reads it (little-endian), so
    // key byte k is (m >> 8k) & 255. Four bytes per step: the payload read the
    // same way lines up with it byte for byte. The 0-3 bytes past the last
    // whole word go one at a time.
    fn static XorWordInPlace(buf: block, start: int, m: int, count: int): int {
        let end4: int = start + count - (count & 3);
        var off: int = start;
        while (off < end4) {
            Buffer.WriteU32At(buf, off, Buffer.ReadU32At(buf, off) ^ m);
            off += 4;
        }
        var sh: int = 0;
        while (off < start + count) {
            Buffer.WriteU8At(buf, off, Buffer.ReadU8At(buf, off) ^ ((m >> sh) & 255));
            off += 1;
            sh += 8;
        }
        return count;
    }

    fn static HeaderGet(headers: object, name: string): string {
        let key = String.ToLower(name);
        let v = headers[key];
        if (v == nil) return "";
        return str(v);
    }

    // Does this request want to become a WebSocket?
    fn static IsUpgrade(headers: object): bool {
        if (headers == nil) return false;
        let up = String.ToLower(Ws.HeaderGet(headers, "upgrade"));
        let cn = String.ToLower(Ws.HeaderGet(headers, "connection"));
        let k  = Ws.HeaderGet(headers, "sec-websocket-key");
        return up == "websocket" && String.Contains(cn, "upgrade") && String.Length(k) > 0;
    }

    // Server side of the RFC 6455 handshake, on a socket the HTTP server has
    // handed over. `headers` is the request header map with lowercased names -
    // exactly what HttpServer gives a handler.
    //
    // Writes the 101 and returns a connection, or writes the appropriate refusal
    // and returns nil. The caller owns the socket either way.
    //
    //   srv.Get("/ws", fn(req, res) {
    //       let sock = res.Hijack();
    //       let ws   = Ws.Accept(sock, req.headers);
    //       if (ws == nil) { Stream.Close(sock); return; }
    //       ...
    //   });
    fn static Accept(sock: stream, headers: object) {
        if (!Ws.IsUpgrade(headers)) {
            Stream.WriteAll(sock, "HTTP/1.1 400 Bad Request\r\n"
                + "Content-Length: 0\r\nConnection: close\r\n\r\n");
            return nil;
        }
        // Only version 13 exists; anything else is told what we speak.
        let ver = String.Trim(Ws.HeaderGet(headers, "sec-websocket-version"));
        if (ver != "13") {
            Stream.WriteAll(sock, "HTTP/1.1 426 Upgrade Required\r\n"
                + "Sec-WebSocket-Version: 13\r\n"
                + "Content-Length: 0\r\nConnection: close\r\n\r\n");
            return nil;
        }

        let key = String.Trim(Ws.HeaderGet(headers, "sec-websocket-key"));
        Stream.WriteAll(sock, "HTTP/1.1 101 Switching Protocols\r\n"
            + "Upgrade: websocket\r\nConnection: Upgrade\r\n"
            + "Sec-WebSocket-Accept: " + Ws.MakeAccept(key) + "\r\n\r\n");

        let ws = new WebSocketClient();
        ws.sock        = sock;
        ws.closed      = false;
        ws.closeCode   = 0;
        ws.closeReason = "";
        // The two directions are not symmetric: a server never masks what it
        // sends, and MUST reject an unmasked frame from a client. Unmasked
        // client frames are what make WebSocket traffic usable for poisoning
        // intermediary caches, which is the whole reason masking exists.
        ws.maskOut     = false;
        ws.requireMask = true;
        return ws;
    }

    fn static ValidateControlPayload(opcode:int, payloadLen:int) {
        if (opcode == WS_OP_CLOSE || opcode == WS_OP_PING || opcode == WS_OP_PONG) {
            if (payloadLen > 125) {
                throw(Exception.RuntimeError, "Control frame payload too large");
            }
        }
    }

    // --------------------------------------------------------
    //  Transport abstraction
    // --------------------------------------------------------
}

// How long _readExact waits for a frame that has not fully arrived yet.
global WS_READ_WAIT_MS:int = 5000;
// The default for SetMaxMessageBytes.
const WS_MAX_MESSAGE_BYTES = 16777216;

class WebSocketClient {
    let host = nil; 
    let path = nil; 
    let port = nil; 
    let secure = nil; 
    let sock = nil; 
    let closeCode = 0; 
    let closeReason: string = nil; 
    let closed = nil; 
    let maskOut = true;      // clients mask outgoing frames; servers must not
    let requireMask = false; // servers must refuse an unmasked client frame
    let maxMessageBytes:int = WS_MAX_MESSAGE_BYTES;
    fn static Connect(host: string, port: int, path, headers, secure): instance {
        // wss:// and ws:// differ only in how the stream is opened; the framing
        // below is identical for both. The connect (and TLS handshake) runs on
        // the I/O pool, so only this fiber waits for it.
        let sock = nil;
        if (secure == true) {
            sock = Fiber.Await(Stream.ConnectTlsAsync(host, port, { timeoutMs: 5000 }));
            if (sock == nil) {
                throw(Exception.IOError, "Failed to establish TLS connection: " +
                                         (Stream.TlsLastError() ?? "unknown"));
            }
        } else {
            sock = Fiber.Await(Stream.ConnectAsync("tcp", host, port, 5000));
            if (sock == nil) {
                throw(Exception.IOError, "Failed to connect socket");
            }
        }
        Stream.SetTimeout(sock, 5000, 5000);

        let reqPath = Ws.EnsurePath(path);
        let key = Ws.MakeClientKey();
        let request = Ws.BuildRequest(host, reqPath, key, headers);

        if (!Stream.WriteString(sock, request)) {
            Stream.Close(sock);
            throw(Exception.IOError, "Failed to write WebSocket handshake");
        }

        let response = Ws.ReadHttpHeaders(sock);
        let statusLine = response._statusLine ?? "";

        if (!String.StartsWith(statusLine, "HTTP/1.1 101") &&
            !String.StartsWith(statusLine, "HTTP/1.0 101")) {
            Stream.Close(sock);
            throw(Exception.RuntimeError, "WebSocket upgrade failed: " + statusLine);
        }

        let upgrade = String.ToLower(Ws.HeaderGet(response, "upgrade"));
        let connection = String.ToLower(Ws.HeaderGet(response, "connection"));
        let accept = Ws.HeaderGet(response, "sec-websocket-accept");
        let expected = Ws.MakeAccept(key);

        if (upgrade != "websocket") {
            Stream.Close(sock);
            throw(Exception.RuntimeError, "Missing or invalid Upgrade header");
        }

        if (String.IndexOf(connection, "upgrade") < 0) {
            Stream.Close(sock);
            throw(Exception.RuntimeError, "Missing or invalid Connection header");
        }

        if (accept != expected) {
            Stream.Close(sock);
            throw(Exception.RuntimeError, "Invalid Sec-WebSocket-Accept");
        }

        let ws = new WebSocketClient();
        ws.sock = sock;
        ws.secure = (secure == true);
        ws.host = host;
        ws.port = port;
        ws.path = reqPath;
        ws.closed = false;
        ws.closeCode = 0;
        ws.closeReason = "";
        return ws;
    }

    fn IsOpen(): bool {
        return !this.closed && Stream.IsOpen(this.sock);
    }

    // The largest frame payload this side accepts; fragments are refused, so
    // that is also the largest message. A peer that declares more gets close
    // code 1009 (message too big) and the connection ends before anything is
    // allocated for the payload.
    fn SetMaxMessageBytes(bytes: int) {
        this.maxMessageBytes = bytes;
        return this;
    }

    fn CloseCode(): int { return this.closeCode; }
    fn CloseReason(): string { return this.closeReason; }

    fn SendText(text: string): bool {
        return this.SendFrame(WS_OP_TEXT, text);
    }

    fn SendBinary(data: block): bool {
        return this.SendFrame(WS_OP_BINARY, data);
    }

    fn SendJson(value): bool {
        return this.SendText(Json.Stringify(value));
    }

    fn Ping(data): bool {
        let payload = nil;

        if (data != nil) {
            let t = type(data);
            if (t == Type.String) {
                payload = Ws.StringToBlock(data);
            } else {
                payload = data;
            }
        }

        if (payload != nil && len(payload) > 125) {
            throw(Exception.RuntimeError, "Ping payload too large");
        }

        return this.SendFrame(WS_OP_PING, payload);
    }

    fn Pong(data): bool {
        let payload = nil;

        if (data != nil) {
            let t = type(data);
            if (t == Type.String) {
                payload = Ws.StringToBlock(data);
            } else {
                payload = data;
            }
        }

        if (payload != nil && len(payload) > 125) {
            throw(Exception.RuntimeError, "Pong payload too large");
        }

        return this.SendFrame(WS_OP_PONG, payload);
    }

    fn Close(code, reason): bool {
        if (this.closed) {
            if (Stream.IsOpen(this.sock)) Stream.Close(this.sock);
            return true;
        }

        let payload = nil;

        if (code != nil) {
            let reasonText = reason ?? "";
            let reasonBlock = Ws.StringToBlock(reasonText);
            let l = len(reasonBlock);
            let total = 2 + l;

            if (total > 125) {
                throw(Exception.RuntimeError, "Close reason too large");
            }

            let buf = Buffer.Create(total, 1);
            Ws.WriteU16BE(buf, 0, code);

            if (l > 0) {
                Buffer.Copy(reasonBlock, 0, buf, 2, l);
            }

            payload = buf;
        }

        this.SendFrame(WS_OP_CLOSE, payload);
        this.closed = true;
        Stream.Close(this.sock);
        return true;
    }

    fn Abort(): bool {
        this.closed = true;
        if (Stream.IsOpen(this.sock)) {
            return Stream.Close(this.sock);
        }
        return true;
    }

    // `payload` is a block, a string (its bytes are sent as they are) or nil.
    fn SendFrame(opcode: int, payload): bool {
        if (this.closed) {
            throw(Exception.InvalidState, "WebSocket already closed");
        }

        let data = payload;
        let isText = data != nil && Type.IsString(data);
        let n:int = (data == nil) ? 0 : len(data);
        // Only a control frame (opcode 8 and up) has a size limit to check.
        if (opcode >= WS_OP_CLOSE && n > 125) { Ws.ValidateControlPayload(opcode, n); }

        let headerLen = 2;
        if (n >= 126 && n <= 65535) {
            headerLen = 4;
        } else if (n > 65535) {
            headerLen = 10;
        }

        // A server sends unmasked frames and carries no masking key at all, so
        // the frame is four bytes shorter and the mask bit stays clear.
        let maskLen = this.maskOut ? 4 : 0;
        let maskBit = this.maskOut ? 0x80 : 0x00;

        // Every byte is written below, so the frame is not cleared first.
        let frame = Buffer.Create(headerLen + maskLen + n, 1);

        let b0 = 0x80 | (opcode & 0x0F);
        if (n < 126) {
            Buffer.WriteU16At(frame, 0, (b0 << 8) | maskBit | n, true);
        } else if (n <= 65535) {
            Buffer.WriteU16At(frame, 0, (b0 << 8) | maskBit | 126, true);
            Buffer.WriteU16At(frame, 2, n, true);
        } else {
            Buffer.WriteU16At(frame, 0, (b0 << 8) | maskBit | 127, true);
            Ws.WriteU64BE(frame, 2, n);
        }

        let payloadOff = headerLen + maskLen;

        if (n > 0) {
            if (isText) { Buffer.CopyStringAt(frame, payloadOff, data, n); }
            else        { Buffer.Copy(data, 0, frame, payloadOff, n); }
        }
        if (this.maskOut) {
            let mask = Crypto.RandomBytes(4);
            Buffer.Copy(mask, 0, frame, headerLen, 4);
            if (n > 0) { Ws.XorMaskRangeInPlace(frame, payloadOff, mask, n); }
        }

        return Stream.WriteAll(this.sock, frame);
    }

    // Read exactly `count` bytes, or nil if the peer stops first.
    //
    // Stream.ReadBytes is "up to count", not "exactly count": it hands over
    // what has arrived, so a frame that spans several TCP segments takes
    // several reads. Each part gets WS_READ_WAIT_MS to arrive - a peer that
    // goes quiet mid-frame is dead - and a nil read means the peer closed.
    fn _readExact(count:int) {
        if (count == 0) { return Buffer.Create(0, 1); }
        var out = nil;
        var off:int = 0;
        while (off < count) {
            if (Stream.WaitReadable(this.sock, WS_READ_WAIT_MS) != true) { return nil; }
            let chunk = Stream.ReadBytes(this.sock, count - off);
            if (chunk == nil) { return nil; }
            // All of it in one read is the common case: that block is the result.
            if (off == 0 && len(chunk) == count) { return chunk; }
            if (out == nil) { out = Buffer.Create(count, 1); }
            Buffer.Copy(chunk, 0, out, off, len(chunk));
            off += len(chunk);
        }
        return out;
    }

    fn ReadFrame(): object {
        if (this.closed) {
            throw(Exception.InvalidState, "WebSocket already closed");
        }

        let head = this._readExact(2);
        if (head == nil) {
            this.closed = true;
            throw(Exception.IOError, "Failed to read WebSocket frame header");
        }

        let hv = Buffer.ReadU16At(head, 0, true);
        let b0 = hv >> 8;
        let b1 = hv & 0xFF;

        let fin = (b0 & 0x80) != 0;
        let rsv = b0 & 0x70;
        let opcode = b0 & 0x0F;
        let masked = (b1 & 0x80) != 0;
        let len7 = b1 & 0x7F;

        if (rsv != 0) {
            throw(Exception.RuntimeError, "RSV bits set but extensions not supported");
        }

        let payloadLen = 0;

        if (len7 < 126) {
            payloadLen = len7;
        } else if (len7 == 126) {
            let ext2 = this._readExact(2);
            if (ext2 == nil) {
                throw(Exception.IOError, "Failed to read extended payload length");
            }
            payloadLen = Buffer.ReadU16At(ext2, 0, true);
        } else {
            let ext8 = this._readExact(8);
            if (ext8 == nil) {
                throw(Exception.IOError, "Failed to read extended payload length");
            }
            payloadLen = Ws.ReadU64BE(ext8, 0);
        }

        if (opcode >= WS_OP_CLOSE && payloadLen > 125) { Ws.ValidateControlPayload(opcode, payloadLen); }

        // A 64-bit length with the top bit set reads as negative.
        if (payloadLen < 0 || payloadLen > this.maxMessageBytes) {
            let reason = "message of " + str(payloadLen) + " bytes exceeds the limit of "
                       + str(this.maxMessageBytes);
            if (Stream.IsOpen(this.sock)) { this.Close(1009, "message too big"); }
            this.closed      = true;
            this.closeCode   = 1009;
            this.closeReason = reason;
            throw(Exception.RuntimeError, reason);
        }

        if ((opcode == WS_OP_CLOSE || opcode == WS_OP_PING || opcode == WS_OP_PONG) && !fin) {
            throw(Exception.RuntimeError, "Fragmented control frames not allowed");
        }

        // RFC 6455 5.1: every frame a client sends must be masked. A server
        // that accepts an unmasked one has to fail the connection.
        if (this.requireMask && !masked) {
            throw(Exception.RuntimeError, "Unmasked frame from client");
        }

        var payload = nil;
        if (masked && payloadLen > 0 && payloadLen <= 1024) {
            // A small frame's key and payload come in one read; the copy out
            // costs less than a second read would.
            let both = this._readExact(4 + payloadLen);
            if (both == nil) {
                throw(Exception.IOError, "Failed to read frame payload");
            }
            Ws.XorWordInPlace(both, 4, Buffer.ReadU32At(both, 0), payloadLen);
            payload = Buffer.Slice(both, 4, payloadLen);
        } else {
            var m: int = 0;
            if (masked) {
                let maskKey = this._readExact(4);
                if (maskKey == nil) {
                    throw(Exception.IOError, "Failed to read masking key");
                }
                m = Buffer.ReadU32At(maskKey, 0);
            }
            payload = this._readExact(payloadLen);
            if (payload == nil) {
                throw(Exception.IOError, "Failed to read frame payload");
            }
            if (masked && payloadLen > 0) { Ws.XorWordInPlace(payload, 0, m, payloadLen); }
        }

        if (!fin) {
            throw(Exception.RuntimeError, "Fragmented WebSocket frames not supported yet");
        }

        let frame = {
            Fin: fin,
            Opcode: opcode,
            Payload: payload,
            Length: payloadLen,
            Masked: masked,
            Text: nil,
            Json: nil,
            CloseCode: nil,
            CloseReason: nil
        };

        if (opcode == WS_OP_TEXT) {
            frame.Text = Ws.BlockToString(payload);
        }

        if (opcode == WS_OP_CLOSE) {
            if (payloadLen == 1) {
                throw(Exception.RuntimeError, "Invalid close frame payload length");
            }

            if (payloadLen >= 2) {
                frame.CloseCode = Ws.ReadU16BE(payload, 0);
                if (payloadLen > 2) {
                    let reasonBuf = Buffer.Slice(payload, 2, payloadLen - 2);
                    frame.CloseReason = Ws.BlockToString(reasonBuf);
                } else {
                    frame.CloseReason = "";
                }
            }
        }

        return frame;
    }

    fn Receive(): object {
        while (true) {
            let frame = this.ReadFrame();

            if (frame.Opcode == WS_OP_PING) {
                this.Pong(frame.Payload);
                continue;
            }

            if (frame.Opcode == WS_OP_CLOSE) {
                this.closeCode = frame.CloseCode ?? 0;
                this.closeReason = frame.CloseReason ?? "";

                // The reply completes the close handshake; it goes out before
                // the connection is marked closed, since SendFrame refuses one
                // that is.
                if (Stream.IsOpen(this.sock)) {
                    this.SendFrame(WS_OP_CLOSE, nil);
                    Stream.Close(this.sock);
                }
                this.closed = true;

                return frame;
            }

            return frame;
        }
    }

    // Receive without stalling the scheduler: suspends only the calling fiber
    // until a frame arrives, so other fibers keep running. Returns nil if
    // timeoutMs passes with nothing received. Works for ws:// and wss://.
    //
    // No `await` is needed - the wait suspends this fiber on its own.
    //
    //   let msg = ws.ReceiveWhenReady(30000);
    //   if (msg == nil) { /* timed out */ }
    //
    // The frame itself is then read synchronously; one split across packets can
    // still block briefly, bounded by the stream's read timeout.
    fn ReceiveWhenReady(timeoutMs?): object {
        if (this.closed) {
            throw(Exception.InvalidState, "WebSocket already closed");
        }
        let ready = Stream.WaitReadable(this.sock, timeoutMs ?? -1);
        if (ready != true) { return nil; }      // timed out

        // A peer that vanishes mid-frame, and a peer that sends something
        // malformed, both end the connection - RFC 6455 says to fail it either
        // way. Report that as a close so a server loop reads
        // "while (ws.IsOpen()) { let m = ws.ReceiveWhenReady(t); if (m == nil) break; }"
        // instead of wrapping every iteration in try/catch. The reason is kept
        // on the connection: CloseCode() is 1006 (abnormal closure) and
        // CloseReason() carries the detail.
        try {
            return this.Receive();
        } catch (e) {
            this.closed      = true;
            this.closeCode   = (this.closeCode != 0) ? this.closeCode : 1006;
            this.closeReason = str(e);
            if (Stream.IsOpen(this.sock)) { Stream.Close(this.sock); }
            return nil;
        }
    }

    fn ReceiveTextWhenReady(timeoutMs?): string {
        let m = this.ReceiveWhenReady(timeoutMs);
        return (m == nil) ? nil : m.Text;
    }

    fn ReceiveText(): string {
        let frame = this.Receive();
        if (frame.Opcode != WS_OP_TEXT) {
            throw(Exception.RuntimeError, "Expected text frame");
        }
        return frame.Text;
    }

    fn ReceiveBinary(): block {
        let frame = this.Receive();
        if (frame.Opcode != WS_OP_BINARY) {
            throw(Exception.RuntimeError, "Expected binary frame");
        }
        return frame.Payload;
    }

    fn ReceiveJson() {
        let text = this.ReceiveText();
        return Json.Parse(text);
    }
}

class WebSocket {
    // secure? = true upgrades to TLS (wss://). Omit for plain ws:// (default).
    fn static Connect(host: string, port: int, path, headers, secure?): instance {
        return WebSocketClient.Connect(host, port, path ?? "/", headers, secure ?? false);
    }

    // Convenience: TLS (wss://) on host[:port], port defaulting to 443.
    fn static ConnectSecure(host: string, port, path, headers): instance {
        return WebSocketClient.Connect(host, port ?? 443, path ?? "/", headers, true);
    }

    // Connect from a "ws://host[:port]/path" or "wss://..." URL.
    fn static ConnectUrl(url: string, headers?): instance {
        let lower  = String.ToLower(url);
        let secure = false;
        let rest   = nil;
        if (String.StartsWith(lower, "wss://"))     { secure = true;  rest = String.Substr(url, 6); }
        else if (String.StartsWith(lower, "ws://")) { secure = false; rest = String.Substr(url, 5); }
        else { throw(Exception.RuntimeError, "WebSocket URL must start with ws:// or wss://"); }

        let slash     = String.IndexOf(rest, "/");
        let authority = (slash < 0) ? rest : String.Left(rest, slash);
        let path      = (slash < 0) ? "/"  : String.Substr(rest, slash);

        let host  = authority;
        let port  = secure ? 443 : 80;
        let colon = String.IndexOf(authority, ":");
        if (colon >= 0) {
            host = String.Left(authority, colon);
            port = Convert.ParseInt(String.Substr(authority, colon + 1));
        }
        return WebSocketClient.Connect(host, port, path, headers ?? nil, secure);
    }
}

export { WebSocket, Ws, WebSocketClient };
