// =============================================================================
// Png.fls - PNG encoder / decoder for Flaris.
// Version: 1.0
//
// A complete PNG codec written in Flaris, zlib stream included: IDAT data is
// inflated and deflated by Inflate.Zlib / Deflate.Zlib from Deflate.fls. The
// native `Hash.Crc32` computes the chunk CRCs the encoder writes; the decoder
// does not verify chunk CRCs - it skips them, so damage is caught only where it
// breaks the chunk structure or the zlib stream (whose Adler-32 is checked).
//
// Pixels are exchanged as a `block` of 32-bit `0xAARRGGBB` words, one word per
// pixel, row-major, stride == width. That is the same layout `Gfx` uses for its
// surfaces, so a decoded image can be handed straight to a canvas with
// `Buffer.Copy` and no per-pixel marshalling.
//
// Usage:
//   import { Png } from library("Png", "1.0");
//
//   let img = Png.Load("photo.png");          // { Width, Height, Pixels }
//   Console.WriteLine(img.Width, "x", img.Height);
//
//   Png.Save("out.png", img.Pixels, img.Width, img.Height);
//
//   // In memory, both directions
//   let bytes = Png.Encode(img.Pixels, img.Width, img.Height);
//   let again = Png.Decode(bytes);
//
// Decode support:
//   Colour types 0 (grayscale), 2 (RGB), 3 (palette), 4 (gray+alpha) and
//   6 (RGBA), at every bit depth the spec allows for each: 1/2/4/8/16 for
//   grayscale, 1/2/4/8 for palette, 8/16 for the rest. All five filter types
//   (None/Sub/Up/Average/Paeth) are reconstructed. Palette `tRNS` alpha is
//   applied. 16-bit samples are reduced to their high byte. Output is always
//   32-bit ARGB.
//
//   Interlaced (Adam7) images are rejected with `nil` rather than decoded as
//   if they were progressive - which would yield a scrambled image.
//
// Encode support:
//   32-bit ARGB in, colour type 6 (RGBA8) out, single IDAT, zlib level 6.
//
//   Rows are filtered adaptively: each row is tried against all five filter
//   types and the one with the smallest sum of absolute signed deviations is
//   kept (the heuristic from the PNG spec's own encoder notes). This is what
//   makes a PNG compress - a fixed filter leaves most of the redundancy in the
//   stream for deflate to find, and it never fully does.
//
//   Adaptive filtering costs five passes over the pixel data. `Png.Encode` and
//   `Png.Save` take an optional options object to trade it away:
//
//     Png.Save("out.png", px, w, h, { filter: Png.FILTER_NONE });
//
//   `Png.FILTER_ADAPTIVE` (the default) picks per row; `Png.FILTER_NONE`
//   writes filter 0 everywhere, which is markedly faster and markedly bigger.
//
// Limits:
//   Images are bounded to 16384 pixels per side, matching the `Gfx` surface cap.
//
// Constants:  Png.MAX_DIM  Png.FILTER_ADAPTIVE  Png.FILTER_NONE
// =============================================================================

import { Inflate, Deflate } from library("Deflate", "1.0");

class Png {

    // ----------------------------------------------------------------
    // Constants
    // ----------------------------------------------------------------

    const MAX_DIM = 16384;

    // Filter strategies for Encode/Save.
    const FILTER_ADAPTIVE = 0;
    const FILTER_NONE     = 1;

    // ----------------------------------------------------------------
    // Byte helpers
    //
    // A byte block reads back 0..255 and keeps the low byte of a stored
    // value, so the codec's own buffers need no masks. Reads of the caller's
    // `bytes` (and its PLTE/tRNS slices) go through (u8), so they stay
    // byte-sized whatever block is passed. Chunk types are compared as packed
    // big-endian ints rather than strings - no allocation per chunk.
    // ----------------------------------------------------------------

    fn static _be32(b:block, o:int):int {
        return (((u8)b[o] << 24) | ((u8)b[o + 1] << 16) |
                ((u8)b[o + 2] << 8) | (u8)b[o + 3]);
    }

    fn static _put32(b:block, o:int, v:int) {
        b[o]     = v >> 24;
        b[o + 1] = v >> 16;
        b[o + 2] = v >> 8;
        b[o + 3] = v;
        return;
    }

    // Sample `si` of a reconstructed row at bit depth `bd`. Returns the raw
    // value (0..2^bd-1), or the high byte when bd == 16.
    fn static _samp(row:block, base:int, si:int, bd:int):int {
        if (bd == 8)  { return row[base + si]; }
        if (bd == 16) { return row[base + si * 2]; }
        let bit   = si * bd;
        let shift = 8 - bd - (bit & 7);
        return (row[base + (bit >> 3)] >> shift) & ((1 << bd) - 1);
    }

    // Spread a sub-8-bit grayscale sample across the full 0..255 range.
    fn static _gray8(s:int, bd:int):int {
        if (bd >= 8) { return s; }
        return (s * 255) / ((1 << bd) - 1);
    }

    // ----------------------------------------------------------------
    // Decode
    // ----------------------------------------------------------------

    // Decode(bytes:block) -> { Width:int, Height:int, Pixels:block } or nil.
    // Pixels holds Width*Height 32-bit 0xAARRGGBB words.
    fn static Decode(bytes:block) : object|nil {
        if (bytes == nil) { return nil; }
        let n = len(bytes);
        if (n < 33) { return nil; }

        // 137 P N G \r \n 26 \n
        if ((u8)bytes[0] != 137 || (u8)bytes[1] != 80  ||
            (u8)bytes[2] != 78  || (u8)bytes[3] != 71  ||
            (u8)bytes[4] != 13  || (u8)bytes[5] != 10  ||
            (u8)bytes[6] != 26  || (u8)bytes[7] != 10) { return nil; }

        var w = 0;
        var h = 0;
        var bd = 0;
        var ct = -1;
        var interlace = 0;
        var gotIhdr = false;

        let idatOff:array = [];
        let idatSz:array  = [];
        var idatTotal = 0;

        var plte:block = nil;
        var plteN = 0;
        var trns:block = nil;
        var trnsN = 0;

        var p = 8;
        while (p + 12 <= n) {
            let clen = Png._be32(bytes, p);
            let tag  = Png._be32(bytes, p + 4);
            p = p + 8;
            // Compare lengths rather than forming p+clen, which a hostile
            // length could push past the block.
            if (clen < 0 || clen > n - p - 4) { break; }

            if (tag == 0x49484452 && clen >= 13) {          // IHDR
                w         = Png._be32(bytes, p);
                h         = Png._be32(bytes, p + 4);
                bd        = (u8)bytes[p + 8];
                ct        = (u8)bytes[p + 9];
                interlace = (u8)bytes[p + 12];
                gotIhdr   = true;
            } else if (tag == 0x49444154) {                 // IDAT
                Array.Append(idatOff, p);
                Array.Append(idatSz, clen);
                idatTotal = idatTotal + clen;
            } else if (tag == 0x504C5445) {                 // PLTE
                plteN = clen / 3;
                if (plteN > 256) { plteN = 256; }
                plte = Buffer.Slice(bytes, p, plteN * 3);
            } else if (tag == 0x74524E53) {                 // tRNS
                trnsN = clen;
                if (trnsN > 256) { trnsN = 256; }
                trns = Buffer.Slice(bytes, p, trnsN);
            } else if (tag == 0x49454E44) {                 // IEND
                break;
            }

            p = p + clen + 4;
        }

        if (!gotIhdr || idatTotal <= 0) { return nil; }
        if (w <= 0 || h <= 0) { return nil; }
        if (w > MAX_DIM || h > MAX_DIM) { return nil; }
        // Adam7 would need seven sub-image passes; decoding it as progressive
        // produces a scrambled image, so refuse instead.
        if (interlace != 0) { return nil; }

        var channels = 0;
        if (ct == 0)      { channels = 1; }
        else if (ct == 2) { channels = 3; }
        else if (ct == 3) { channels = 1; }
        else if (ct == 4) { channels = 2; }
        else if (ct == 6) { channels = 4; }
        else { return nil; }

        var okBd = false;
        if (ct == 0 && (bd == 1 || bd == 2 || bd == 4 || bd == 8 || bd == 16)) { okBd = true; }
        if (ct == 3 && (bd == 1 || bd == 2 || bd == 4 || bd == 8))             { okBd = true; }
        if ((ct == 2 || ct == 4 || ct == 6) && (bd == 8 || bd == 16))          { okBd = true; }
        if (!okBd) { return nil; }
        if (ct == 3 && plteN == 0) { return nil; }

        let bitsPp   = channels * bd;
        let rowBytes = (w * bitsPp + 7) / 8;
        var filtBpp  = (bitsPp + 7) / 8;
        if (filtBpp < 1) { filtBpp = 1; }

        // Gather the IDAT chunks into one zlib stream.
        let idat = Buffer.Create(idatTotal, 1);
        if (idat == nil) { return nil; }
        var at = 0;
        var i = 0;
        while (i < len(idatOff)) {
            Buffer.Copy(bytes, idatOff[i], idat, at, idatSz[i]);
            at = at + idatSz[i];
            i = i + 1;
        }

        let rawExpect = h * (1 + rowBytes);
        let raw = Inflate.Zlib(idat, rawExpect);
        // A truncated-but-well-formed stream inflates to fewer bytes than IHDR
        // promised; the filter loop would then read uninitialised buffer into
        // pixels, so demand the exact length.
        if (raw == nil || len(raw) != rawExpect) { return nil; }

        let out = Buffer.Create(w * h, 4);
        if (out == nil) { return nil; }

        // Claim an event only on the path that consumes it: an id that is
        // created and never signalled is never released back to the 64-slot
        // pool, and the scheduler still waits on it at shutdown.
        var fast = false;
        if (ct == 6 && bd == 8) {
            let id = Event.Create();
            if (id >= 0) {
                Buffer.ProcessEvent(Png._rgba8Kernel, raw, len(raw), rowBytes, id);
                Event.WaitFor([id]);
                Buffer.Copy(raw, 0, out, 0, w * h * 4);
                fast = true;
            }
        }
        if (!fast) {
            Png._unfilter(raw, h, rowBytes, filtBpp);
            Png._expand(raw, out, w, h, rowBytes, ct, bd, plte, plteN, trns, trnsN);
        }

        return { Width: w, Height: h, Pixels: out };
    }

    // Load(path:string) -> { Width, Height, Pixels } or nil.
    fn static Load(path:string) : object|nil {
        let bytes = File.ReadAllBytes(path);
        if (bytes == nil) { return nil; }
        return Png.Decode(bytes);
    }

    // Reconstruct all five filter types in place over the raw scanline buffer.
    // Safe in place: every filter references only bytes to the left in the
    // current row and bytes in the row above, all already reconstructed.
    //
    // The 8-bit RGBA case - by far the most common, and the one Gfx surfaces
    // round-trip through - goes via _rgba8Kernel instead, which does this plus
    // the pixel expansion as one offload kernel. The Paeth predictor therefore
    // exists twice: a kernel touches one block and cannot call helpers, so the
    // fast path cannot share this code. Any change here must be mirrored there.
    fn static _unfilter(raw:block, h:int, rowBytes:int, bpp:int) {
        var y = 0;
        while (y < h) {
            let base  = y * (1 + rowBytes);
            let ftype = raw[base];
            let cur   = base + 1;
            let up    = cur - (1 + rowBytes);

            if (ftype == 0) {
                y = y + 1;
                continue;
            }

            var x = 0;
            while (x < rowBytes) {
                var a = 0;
                var b = 0;
                var c = 0;
                if (x >= bpp) { a = raw[cur + x - bpp]; }
                if (y > 0)    { b = raw[up + x]; }
                if (x >= bpp && y > 0) { c = raw[up + x - bpp]; }

                var add = 0;
                if (ftype == 1)      { add = a; }
                else if (ftype == 2) { add = b; }
                else if (ftype == 3) { add = (a + b) >> 1; }
                else if (ftype == 4) {
                    // Paeth predictor (spec 9.4)
                    let pp = a + b - c;
                    var pa = pp - a; if (pa < 0) { pa = 0 - pa; }
                    var pb = pp - b; if (pb < 0) { pb = 0 - pb; }
                    var pc = pp - c; if (pc < 0) { pc = 0 - pc; }
                    if (pa <= pb && pa <= pc)  { add = a; }
                    else if (pb <= pc)          { add = b; }
                    else                        { add = c; }
                }

                raw[cur + x] = raw[cur + x] + add;
                x = x + 1;
            }
            y = y + 1;
        }
        return;
    }

    // Fused decode kernel for 8-bit RGBA (colour type 6, bit depth 8).
    //
    // Runs as one offload kernel over the single raw-scanline block: phase 1
    // reconstructs the filters, phase 2 compacts the rows (dropping the filter
    // byte) and swizzles RGBA into the byte order of a little-endian 0xAARRGGBB
    // word, so the caller can lift the pixels out with one native Buffer.Copy
    // instead of a per-pixel bytecode loop. Compaction is a forward move -
    // destination y*rowBytes is always below source y*(rowBytes+1)+1 - so it is
    // safe in place. bpp is fixed at 4 here, which frees the one scalar
    // parameter a kernel gets for rowBytes.
    fn static _rgba8Kernel(b:block, blen:int, rowBytes:int):int {
        let stride = rowBytes + 1;

        var base = 0;
        while (base + stride <= blen) {
            let ftype = b[base];
            if (ftype != 0) {
                let cur = base + 1;
                let up  = cur - stride;
                var x = 0;
                while (x < rowBytes) {
                    var a = 0;
                    var bb = 0;
                    var c = 0;
                    if (x >= 4) { a = b[cur + x - 4]; }
                    if (base > 0) { bb = b[up + x]; }
                    if (x >= 4 && base > 0) { c = b[up + x - 4]; }

                    var add = 0;
                    if (ftype == 1)      { add = a; }
                    else if (ftype == 2) { add = bb; }
                    else if (ftype == 3) { add = (a + bb) >> 1; }
                    else if (ftype == 4) {
                        let pp = a + bb - c;
                        var pa = pp - a;  if (pa < 0) { pa = 0 - pa; }
                        var pb = pp - bb; if (pb < 0) { pb = 0 - pb; }
                        var pc = pp - c;  if (pc < 0) { pc = 0 - pc; }
                        if (pa <= pb && pa <= pc) { add = a; }
                        else if (pb <= pc)        { add = bb; }
                        else                      { add = c; }
                    }

                    b[cur + x] = b[cur + x] + add;
                    x = x + 1;
                }
            }
            base = base + stride;
        }

        var src = 1;
        var dst = 0;
        while (src + rowBytes <= blen) {
            var x = 0;
            while (x < rowBytes) {
                let r  = b[src + x];
                let g  = b[src + x + 1];
                let bl = b[src + x + 2];
                let al = b[src + x + 3];
                b[dst]     = bl;
                b[dst + 1] = g;
                b[dst + 2] = r;
                b[dst + 3] = al;
                dst = dst + 4;
                x = x + 4;
            }
            src = src + rowBytes + 1;
        }
        return 0;
    }

    // Expand reconstructed scanlines to 32-bit ARGB words. Split per colour
    // type: the JIT takes at most 8 integer/pointer arguments per function.
    fn static _expand(raw:block, out:block, w:int, h:int, rowBytes:int,
                      ct:int, bd:int, plte:block, plteN:int,
                      trns:block, trnsN:int) {
        var step = 1;
        if (bd == 16) { step = 2; }
        if (ct == 0) {
            Png._expandGray(raw, out, w, h, rowBytes, bd);
        } else if (ct == 3) {
            Png._expandPal(raw, out, w, h, rowBytes, bd, Png._palette(plte, plteN, trns ?? plte, trnsN));
        } else {
            Png._expandRgb(raw, out, w, h, rowBytes, ct, step);
        }
        return;
    }

    // RGBA (6), RGB (2) and grayscale + alpha (4).
    fn static _expandRgb(raw:block, out:block, w:int, h:int, rowBytes:int, ct:int, step:int) {
        var y = 0;
        while (y < h) {
            let cur = y * (1 + rowBytes) + 1;
            let dst = y * w;
            var x = 0;

            if (ct == 6) {                                   // RGBA
                while (x < w) {
                    let s = cur + x * 4 * step;
                    out[dst + x] = ((raw[s + 3 * step] << 24) |
                                    (raw[s] << 16) |
                                    (raw[s + step] << 8) |
                                    raw[s + 2 * step]);
                    x = x + 1;
                }
            } else if (ct == 2) {                            // RGB
                while (x < w) {
                    let s = cur + x * 3 * step;
                    out[dst + x] = (0xFF000000 |
                                    (raw[s] << 16) |
                                    (raw[s + step] << 8) |
                                    raw[s + 2 * step]);
                    x = x + 1;
                }
            } else if (ct == 4) {                            // grayscale + alpha
                while (x < w) {
                    let s = cur + x * 2 * step;
                    let g = raw[s];
                    let a = raw[s + step];
                    out[dst + x] = ((a << 24) | (g << 16) | (g << 8) | g);
                    x = x + 1;
                }
            }
            y = y + 1;
        }
        return;
    }

    fn static _expandGray(raw:block, out:block, w:int, h:int, rowBytes:int, bd:int) {
        var y = 0;
        while (y < h) {
            let cur = y * (1 + rowBytes) + 1;
            let dst = y * w;
            var x = 0;
            while (x < w) {
                let g = Png._gray8(Png._samp(raw, cur, x, bd), bd);
                out[dst + x] = (0xFF000000 | (g << 16) | (g << 8) | g);
                x = x + 1;
            }
            y = y + 1;
        }
        return;
    }

    // 256-entry ARGB lookup: an index past the palette maps to entry 0, alpha
    // comes from tRNS where it has an entry.
    fn static _palette(plte:block, plteN:int, trns:block, trnsN:int) : block {
        let lut:block = Buffer.Create(256, 4);
        var i = 0;
        while (i < 256) {
            var idx = i;
            if (idx >= plteN) { idx = 0; }
            var a = 255;
            if (idx < trnsN) { a = (u8)trns[idx]; }
            lut[i] = ((a << 24) |
                      ((u8)plte[idx * 3] << 16) |
                      ((u8)plte[idx * 3 + 1] << 8) |
                      (u8)plte[idx * 3 + 2]);
            i = i + 1;
        }
        return lut;
    }

    fn static _expandPal(raw:block, out:block, w:int, h:int, rowBytes:int, bd:int, lut:block) {
        var y = 0;
        while (y < h) {
            let cur = y * (1 + rowBytes) + 1;
            let dst = y * w;
            var x = 0;
            while (x < w) {
                out[dst + x] = lut[Png._samp(raw, cur, x, bd)];
                x = x + 1;
            }
            y = y + 1;
        }
        return;
    }

    // ----------------------------------------------------------------
    // Encode
    // ----------------------------------------------------------------

    // Encode(pixels:block, w:int, h:int, opts?:object) -> block of PNG bytes,
    // or nil. `pixels` holds w*h 32-bit 0xAARRGGBB words. `opts.filter` selects
    // Png.FILTER_ADAPTIVE (default) or Png.FILTER_NONE.
    fn static Encode(pixels:block, w:int, h:int, opts?:object) : block|nil {
        if (pixels == nil) { return nil; }
        if (w <= 0 || h <= 0) { return nil; }
        if (w > MAX_DIM || h > MAX_DIM) { return nil; }
        if (len(pixels) < w * h) { return nil; }

        var strategy = FILTER_ADAPTIVE;
        if (opts != nil && opts.filter != nil) { strategy = opts.filter; }

        let rowBytes = w * 4;
        let raw = Buffer.Create(h * (1 + rowBytes), 1);
        if (raw == nil) { return nil; }

        if (strategy == FILTER_NONE) {
            Png._rowsUnfiltered(pixels, raw, w, h, rowBytes);
        } else {
            Png._rowsAdaptive(pixels, raw, w, h, rowBytes);
        }

        let comp = Deflate.Zlib(raw, 6);
        if (comp == nil) { return nil; }
        let clen = len(comp);

        // sig(8) + IHDR(12+13) + IDAT(12+clen) + IEND(12)
        let total = 8 + 25 + 12 + clen + 12;
        let out = Buffer.Create(total, 1);
        if (out == nil) { return nil; }

        out[0] = 137; out[1] = 80; out[2] = 78; out[3] = 71;
        out[4] = 13;  out[5] = 10; out[6] = 26; out[7] = 10;
        var at = 8;

        let ihdr = Buffer.Create(13, 1);
        Png._put32(ihdr, 0, w);
        Png._put32(ihdr, 4, h);
        ihdr[8]  = 8;   // bit depth
        ihdr[9]  = 6;   // colour type: RGBA
        ihdr[10] = 0;   // compression: deflate
        ihdr[11] = 0;   // filter method: adaptive
        ihdr[12] = 0;   // interlace: none
        at = Png._chunk(out, at, "IHDR", ihdr, 13);
        at = Png._chunk(out, at, "IDAT", comp, clen);
        at = Png._chunk(out, at, "IEND", nil, 0);

        return out;
    }

    // Save(path, pixels, w, h, opts?) -> bool
    fn static Save(path:string, pixels:block, w:int, h:int, opts?:object) : bool {
        let bytes = Png.Encode(pixels, w, h, opts);
        if (bytes == nil) { return false; }
        return File.WriteAllBytes(path, bytes);
    }

    // Write one chunk (length, type, data, CRC) at `at`; returns the new offset.
    // The CRC covers type+data, so both are staged in one block and handed to
    // the native Hash.Crc32.
    fn static _chunk(out:block, at:int, tag:string, data:block, dlen:int) : int {
        Png._put32(out, at, dlen);
        let tb = Buffer.FromString(tag);
        let crcSrc = Buffer.Create(4 + dlen, 1);
        Buffer.Copy(tb, 0, crcSrc, 0, 4);
        if (dlen > 0) { Buffer.Copy(data, 0, crcSrc, 4, dlen); }
        Buffer.Copy(crcSrc, 0, out, at + 4, 4 + dlen);
        Png._put32(out, at + 8 + dlen, Hash.Crc32(crcSrc));
        return at + 12 + dlen;
    }

    // Filter 0 for every row: straight ARGB -> RGBA byte order, no prediction.
    fn static _rowsUnfiltered(px:block, raw:block, w:int, h:int, rowBytes:int) {
        var y = 0;
        while (y < h) {
            let base = y * (1 + rowBytes);
            raw[base] = 0;
            let cur = base + 1;
            let src = y * w;
            var x = 0;
            while (x < w) {
                let v = px[src + x];
                let o = cur + x * 4;
                raw[o]     = v >> 16;
                raw[o + 1] = v >> 8;
                raw[o + 2] = v;
                raw[o + 3] = v >> 24;
                x = x + 1;
            }
            y = y + 1;
        }
        return;
    }

    // Per-row filter selection. Each row is filtered five ways; the candidate
    // with the smallest sum of absolute signed deviations wins, which is the
    // heuristic the PNG spec recommends and what every real encoder uses.
    // ln and pv hold this row and the previous one (RGBA) behind four zero
    // bytes, so the left neighbours of the first pixel read as 0 without an
    // edge test; pv is all zero for the first row.
    fn static _rowsAdaptive(px:block, raw:block, w:int, h:int, rowBytes:int) {
        let ln = Buffer.Create(rowBytes + 4, 1);
        let pv = Buffer.Create(rowBytes + 4, 1);
        let cand = Buffer.Create(rowBytes, 1);   // candidate under test
        let best = Buffer.Create(rowBytes, 1);   // best candidate so far
        Buffer.Fill(ln, 0);
        Buffer.Fill(pv, 0);

        var y = 0;
        while (y < h) {
            let src = y * w;
            var x = 0;
            while (x < w) {
                let v = px[src + x];
                let o = 4 + x * 4;
                ln[o]     = v >> 16;
                ln[o + 1] = v >> 8;
                ln[o + 2] = v;
                ln[o + 3] = v >> 24;
                x = x + 1;
            }

            var bestType = 0;
            var bestScore = Png._filterRow(ln, pv, rowBytes, 0, best);
            var f = 1;
            while (f < 5) {
                let score = Png._filterRow(ln, pv, rowBytes, f, cand);
                if (score < bestScore) {
                    bestScore = score;
                    bestType = f;
                    Buffer.Copy(cand, 0, best, 0, rowBytes);
                }
                f = f + 1;
            }

            let base = y * (1 + rowBytes);
            raw[base] = bestType;
            Buffer.Copy(best, 0, raw, base + 1, rowBytes);
            Buffer.Copy(ln, 4, pv, 4, rowBytes);
            y = y + 1;
        }
        return;
    }

    // Filter f (0-4) of the n-byte row in ln (laid out as in _rowsAdaptive)
    // into out[0..n); returns the sum of the filtered bytes read as signed,
    // absolute. One loop per filter keeps the filter test out of the byte loop.
    fn static _filterRow(ln:block, pv:block, n:int, f:int, out:block):int {
        var score = 0;
        var i = 4;
        let end = n + 4;
        if (f == 0) {
            while (i < end) {
                let d = ln[i];
                out[i - 4] = d;
                score += d < 128 ? d : 256 - d;
                i += 1;
            }
        } else if (f == 1) {
            while (i < end) {
                let d = (u8)(ln[i] - ln[i - 4]);
                out[i - 4] = d;
                score += d < 128 ? d : 256 - d;
                i += 1;
            }
        } else if (f == 2) {
            while (i < end) {
                let d = (u8)(ln[i] - pv[i]);
                out[i - 4] = d;
                score += d < 128 ? d : 256 - d;
                i += 1;
            }
        } else if (f == 3) {
            while (i < end) {
                let d = (u8)(ln[i] - ((ln[i - 4] + pv[i]) >> 1));
                out[i - 4] = d;
                score += d < 128 ? d : 256 - d;
                i += 1;
            }
        } else {
            while (i < end) {
                let a = ln[i - 4];
                let b = pv[i];
                let c = pv[i - 4];
                let pp = a + b - c;
                var pa = pp - a; if (pa < 0) { pa = 0 - pa; }
                var pb = pp - b; if (pb < 0) { pb = 0 - pb; }
                var pc = pp - c; if (pc < 0) { pc = 0 - pc; }
                var pred = c;
                if (pa <= pb && pa <= pc) { pred = a; }
                else if (pb <= pc)        { pred = b; }
                let d = (u8)(ln[i] - pred);
                out[i - 4] = d;
                score += d < 128 ? d : 256 - d;
                i += 1;
            }
        }
        return score;
    }
}

export { Png };
