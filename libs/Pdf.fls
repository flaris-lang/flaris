    722, 500, 611, 278, 611, 278, 611, 344, 611, 278, 722, 500, 722, 500, 722, 500,
    722, 500, 722, 500, 667, 333, 667, 333, 667, 333, 556, 389, 556, 389, 611, 278,
    611, 326, 722, 500, 722, 500, 722, 500, 722, 500, 611, 444, 611, 444, 556, 389,
