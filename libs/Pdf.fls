// =============================================================================
// Pdf.fls - PDF writer for Flaris: pages, vector drawing, text, images and a
// flowing layout with tables, headers and footers.
// Version: 1.0
//
// Writes PDF 1.4 documents from scratch, in Flaris: the object table, the
// cross-reference table and the content streams are assembled here, page
// content is compressed with Deflate.Zlib, and images either pass through
// unchanged (JPEG, and the PNGs a PDF reader can decode as they are) or are
// decoded by Png.fls. PdfWriter places everything at coordinates you give;
// PdfLayout (below) flows paragraphs and tables down the page for you.
//
// Usage:
//   import { PdfWriter, PdfLayout } from library("Pdf", "1.0");
//
//   let pdf = new PdfWriter({ size: "A4", unit: "mm" });
//   pdf.SetInfo({ title: "Invoice 1042", author: "Acme AB" });
//   pdf.SetFont("Helvetica", 18, "bold");
//   pdf.DrawText(20, 20, "Invoice 1042");
//   pdf.SetFont("Helvetica", 10);
//   pdf.DrawTextRight(190, 22, "2026-10-02");
//   pdf.SetStroke(0x999999);
//   pdf.Line(20, 32, 190, 32);
//   pdf.DrawImage("logo.png", 160, 40, 30);     // 30 mm wide, height from aspect
//   pdf.Save("invoice.pdf");
//
// Coordinates:
//   The origin is the top-left corner of the page and y grows downwards, as
//   on a screen. Every coordinate and length is in the document's unit; font
//   sizes are always points. DrawText's y is the top of the line: the
//   baseline sits one Ascent() below it.
//
// Options (constructor, all optional):
//   size       "A3" | "A4" (default) | "A5" | "Letter" | "Legal" | [w, h] in units
//   landscape  turn named sizes sideways (default false)
//   unit       "pt" (1/72 inch, default) | "mm" | "cm" | "in"
//   compress   deflate the page content streams (default true)
//
// Colours are 0xRRGGBB ints. The alpha byte of a 0xAARRGGBB value is ignored,
// so colours written for Graphics.fls work unchanged; transparency is
// SetOpacity. Outlines use the stroke colour and thickness, Fill* the fill
// colour, Draw* fill and then outline, text the text colour. All three
// default to black.
//
// Pages:
//   AddPage(size?, landscape?) -> index   PageCount()   PageIndex()   SetPage(i)
//   PageWidth()   PageHeight()
//   Drawing before the first AddPage starts page 0. SetPage returns to an
//   earlier page, which is how "Page 3 of 7" footers are written once the
//   page count is known.
//
// Style:
//   SetStroke(rgb)  SetFill(rgb)  SetTextColor(rgb)  SetThickness(t)
//   SetDash(on?, off?)   no arguments for a solid line
//   SetOpacity(a)        0.0 .. 1.0, for everything drawn afterwards
//   SaveStyle() -> style   RestoreStyle(style)   colours, line, opacity and font
//   PointsPerUnit()
//
// Shapes (point lists are flat [x0,y0, x1,y1, ...]; angles are degrees,
// clockwise from 3 o'clock, as in Graphics.fls):
//   Line(x0,y0,x1,y1)      Polyline(pts)   Polygon(pts)  FillPolygon  DrawPolygon
//   Rect(x,y,w,h)          FillRect        DrawRect
//   RoundRect(x,y,w,h,r)   FillRoundRect   DrawRoundRect
//   Circle(cx,cy,r)        FillCircle      DrawCircle
//   Ellipse(cx,cy,rx,ry)   FillEllipse     DrawEllipse
//   Arc(cx,cy,r,a0,a1)     Pie(cx,cy,r,a0,a1)   FillPie   DrawPie
//   MoveTo LineTo CurveTo ClosePath, then StrokePath | FillPath | DrawPath
//
// Text:
//   SetFont(name, size?, style?) -> bool
//       name "Helvetica" | "Times" | "Courier", or a full name such as
//       "Times-BoldItalic"; style "bold" | "italic" | "bolditalic" | "regular"
//   DrawText(x,y,text)   DrawTextRight(x,y,text)   DrawTextCenter(x,y,text)
//   TextWidth(text)   LineHeight()   Ascent()   Descent()   (lengths, positive)
//   WrapText(text, width) -> array of lines; "\n" forces a break
//   DrawTextBox(x, y, width, text, align?) -> height used
//       align "left" (default) | "right" | "center"
//
// Images:
//   LoadImage(pathOrBytes) -> id|nil     ImageSize(id) -> { Width, Height }
//   DrawImage(id|path|bytes, x, y, w?, h?) -> bool
//       Leave w or h nil to keep the aspect ratio; with both nil one pixel is
//       one point. An image is stored once however often it is drawn, and a
//       path is read once.
//   DrawCells(x, y, size, cells, n) -> bool
//       An n x n grid of ARGB values, darker-than-grey cells filled with the
//       fill colour - the shape QRCode.ToPixels(text, 1) returns:
//         let px = QRCode.ToPixels(url, 1);
//         pdf.DrawCells(150, 250, 40, px, QRCode.PixelSize(url, 1));
//
// Links:
//   Link(x, y, w, h, url)   a clickable area on the current page
//
// Output:
//   SetInfo({ title, author, subject, keywords, creator, created })
//       created is Unix seconds (default: when ToBlock runs)
//   ToBlock() -> block     Save(path) -> bool
//
// PdfLayout - content that flows down the page and onto new ones:
//   let doc = new PdfLayout(pdf, {
//       margins: [25, 18, 22, 18],                 // top, right, bottom, left
//       header:  { left: "Acme AB", right: "Report", rule: true },
//       footer:  { center: "Page {page} of {pages}" }
//   });
//   doc.Heading("Stock report");
//   doc.Paragraph("Values in SEK excluding VAT.");
//   doc.Table([{ title: "Item" }, { title: "Qty", width: 20, align: "right" }],
//             [["Bolt", "120"], ["Nut", "80"],
//              { cells: ["Total", "200"], style: "bold", fill: 0xDDE5F0 }],
//             { zebra: 0xF5F7FA });
//   doc.Finish();                                  // headers, footers, page count
//   pdf.Save("report.pdf");
//
//   new PdfLayout(pdf, opts?)   writes on the writer's current page (the first
//       one is added if there is none) and adds pages as they fill.
//       margins   one number, [vertical, horizontal] or [top, right, bottom,
//                 left]; default 20 mm
//       header, footer  { left, center, right, font, size (8), style,
//                 color (0x666666), rule, ruleColor } drawn in the margin by
//                 Finish; {page} and {pages} are replaced in the texts
//   Heading(text, level?, opts?)   bold 18/14/12 pt; never left alone at the
//       bottom of a page - it moves on with room for two lines after it
//   Paragraph(text, opts?)   opts: font, size, style, color, align, indent,
//       spaceAfter (default half a line)
//   Table(columns, rows, opts?) -> bool
//       columns  titles, or { title, width?, align? }; columns without a width
//                share what the fixed ones leave
//       rows     arrays of cells (any value, shown with str()), or
//                { cells, style?, fill?, color? } for a row such as a total
//       opts     size, padding, grid "rows" (default) | "all" | "none",
//                border, thickness, headerFill, headerColor, zebra,
//                repeatHeader (default true), spaceAfter
//       Cells wrap; a row that does not fit starts a new page, which repeats
//       the header row. A row taller than a whole page overflows it.
//   Image(src, w?, h?, align?) -> bool   at most the content width
//   Rule(opts?)   Space(h)   EnsureSpace(h) -> bool   NewPage()
//   Y()   SetY(y)   Left()   ContentWidth()   Bottom()   Remaining()   PageCount()
//   Finish(decorate?) -> page count
//       Draws header and footer on every page of the layout, then calls
//       decorate(pdf, index, count) per page for anything else (a logo, a
//       watermark). Runs once. Pass decorate here rather than keeping a
//       closure around: a closure that captures the layout and is stored on
//       it would be a reference cycle, which is never freed.
//   Styles set through opts last for that call only; the writer's style is
//   restored afterwards.
//
// Fonts and characters:
//   The twelve Latin standard fonts - Helvetica, Times and Courier in four
//   styles each - are built into every PDF reader, so nothing is embedded and
//   a page of text stays a few KB. They draw ASCII, Latin-1 (å ä ö é ü ß
//   ...), Latin Extended-A - Polish, Czech, Slovak, Hungarian, Romanian,
//   Turkish and Baltic letters (ł ś ż č ě ř ő ű ğ ş ș ț ā ų ...) - the euro
//   sign, typographic quotes and dashes, − ≤ ≥ ≠ ∑ √ ∂ Δ and the fi/fl
//   ligatures. Any other character (Greek, Cyrillic, CJK, emoji) becomes '?'.
//   Copied out of a reader, Romanian ș/ț come back as their cedilla forms
//   ş/ţ: the glyphs draw a comma, but their standard names map to cedillas.
//   The reader supplies these fonts, so a glyph its copy lacks shows as a
//   gap of the right width - macOS's Times Italic has no Latvian ķ ļ ņ.
//   TextWidth uses the fonts' published metrics, so measured text lines up
//   with what the reader draws.
//
// Image formats:
//   JPEG is embedded as it is (grayscale, RGB or CMYK; baseline or
//   progressive), and so is a non-interlaced grayscale (1-8 bit), RGB
//   (8 bit) or palette PNG without transparency. Any other PNG - alpha,
//   tRNS, 16-bit - is decoded and recompressed, its alpha becoming a soft
//   mask. Interlaced PNGs are not supported: LoadImage returns nil.
// =============================================================================

import { Png } from library("Png", "1.0");
import { Deflate } from library("Deflate", "1.0");

const MM = 72.0 / 25.4;

// Font id = family * 4 + style bits (1 bold, 2 italic). Resource /F<id+1>.
const FONT_NAMES = ["Helvetica", "Helvetica-Bold", "Helvetica-Oblique", "Helvetica-BoldOblique",
