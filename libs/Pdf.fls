];
const EXT_W_TIMES_I = [
    611, 500, 611, 500, 611, 500, 667, 444, 667, 444, 722, 544, 722, 500, 611, 444,
    611, 444, 611, 444, 611, 444, 722, 500, 722, 500, 333, 278, 333, 278, 333, 278,
    667, 444, 556, 278, 556, 278, 611, 300, 556, 278, 667, 500, 667, 500, 667, 500,
    722, 500, 722, 500, 611, 389, 611, 389, 611, 389, 500, 389, 500, 389, 556, 278,
