    556, 556
];
const EXT_W_TIMES_B = [
    722, 500, 722, 500, 722, 500, 722, 444, 722, 444, 722, 672, 722, 556, 667, 444,
    667, 444, 667, 444, 667, 444, 778, 500, 778, 500, 389, 278, 389, 278, 389, 278,
    778, 556, 667, 278, 667, 278, 667, 394, 667, 278, 722, 556, 722, 556, 722, 556,
