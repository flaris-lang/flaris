    667, 500, 611, 278, 611, 278, 611, 382, 611, 278, 722, 556, 722, 556, 722, 556,
    722, 500, 722, 500, 667, 389, 667, 389, 667, 389, 556, 389, 556, 389, 611, 278,
    611, 366, 722, 556, 722, 556, 722, 556, 722, 556, 611, 389, 611, 389, 556, 389,
    333, 333, 333, 333, 333, 333, 167, 494, 612, 600, 606, 549, 549, 549, 549, 494,
    556, 556
