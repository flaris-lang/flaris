global SHA384_IV: [int] = [
    -3766243637369397544, 7105036623409894663, -7973340178411365097, 1526699215303891257,
    7436329637833083697, -8163818279084223215, -2662702644619276377, 5167115440072839076 ];

global KECCAK_RC: [int] = [
    0x00000001, 0x00000000, 0x00008082, 0x00000000, 0x0000808a, 0x80000000, 0x80008000, 0x80000000,
    0x0000808b, 0x00000000, 0x80000001, 0x00000000, 0x80008081, 0x80000000, 0x00008009, 0x80000000,
    0x0000008a, 0x00000000, 0x00000088, 0x00000000, 0x80008009, 0x00000000, 0x8000000a, 0x00000000,
    0x8000808b, 0x00000000, 0x0000008b, 0x80000000, 0x00008089, 0x80000000, 0x00008003, 0x80000000,
    0x00008002, 0x80000000, 0x00000080, 0x80000000, 0x0000800a, 0x00000000, 0x8000000a, 0x80000000,
    0x80008081, 0x80000000, 0x00008080, 0x80000000, 0x80000001, 0x00000000, 0x80008008, 0x80000000 ];

// MD5's four rounds of 16 steps, unrolled with the step constants written
// in. st holds the 16 message words, then the working state a, b, c, d at
// 16..19.
fn _md5Round1(st: [int]) {
    let a: int = st[16]; let b: int = st[17]; let c: int = st[18]; let d: int = st[19];
    a = (u32)(a + (d ^ (b & (c ^ d))) + 0xd76aa478 + st[0]); a = (u32)(b + ((a << 7) | (a >>> 25)));
    d = (u32)(d + (c ^ (a & (b ^ c))) + 0xe8c7b756 + st[1]); d = (u32)(a + ((d << 12) | (d >>> 20)));
    c = (u32)(c + (b ^ (d & (a ^ b))) + 0x242070db + st[2]); c = (u32)(d + ((c << 17) | (c >>> 15)));
    b = (u32)(b + (a ^ (c & (d ^ a))) + 0xc1bdceee + st[3]); b = (u32)(c + ((b << 22) | (b >>> 10)));
    a = (u32)(a + (d ^ (b & (c ^ d))) + 0xf57c0faf + st[4]); a = (u32)(b + ((a << 7) | (a >>> 25)));
    d = (u32)(d + (c ^ (a & (b ^ c))) + 0x4787c62a + st[5]); d = (u32)(a + ((d << 12) | (d >>> 20)));
    c = (u32)(c + (b ^ (d & (a ^ b))) + 0xa8304613 + st[6]); c = (u32)(d + ((c << 17) | (c >>> 15)));
    b = (u32)(b + (a ^ (c & (d ^ a))) + 0xfd469501 + st[7]); b = (u32)(c + ((b << 22) | (b >>> 10)));
    a = (u32)(a + (d ^ (b & (c ^ d))) + 0x698098d8 + st[8]); a = (u32)(b + ((a << 7) | (a >>> 25)));
    d = (u32)(d + (c ^ (a & (b ^ c))) + 0x8b44f7af + st[9]); d = (u32)(a + ((d << 12) | (d >>> 20)));
    c = (u32)(c + (b ^ (d & (a ^ b))) + 0xffff5bb1 + st[10]); c = (u32)(d + ((c << 17) | (c >>> 15)));
    b = (u32)(b + (a ^ (c & (d ^ a))) + 0x895cd7be + st[11]); b = (u32)(c + ((b << 22) | (b >>> 10)));
    a = (u32)(a + (d ^ (b & (c ^ d))) + 0x6b901122 + st[12]); a = (u32)(b + ((a << 7) | (a >>> 25)));
    d = (u32)(d + (c ^ (a & (b ^ c))) + 0xfd987193 + st[13]); d = (u32)(a + ((d << 12) | (d >>> 20)));
    c = (u32)(c + (b ^ (d & (a ^ b))) + 0xa679438e + st[14]); c = (u32)(d + ((c << 17) | (c >>> 15)));
    b = (u32)(b + (a ^ (c & (d ^ a))) + 0x49b40821 + st[15]); b = (u32)(c + ((b << 22) | (b >>> 10)));
    st[16] = a; st[17] = b; st[18] = c; st[19] = d;
}

fn _md5Round2(st: [int]) {
    let a: int = st[16]; let b: int = st[17]; let c: int = st[18]; let d: int = st[19];
    a = (u32)(a + (c ^ (d & (b ^ c))) + 0xf61e2562 + st[1]); a = (u32)(b + ((a << 5) | (a >>> 27)));
    d = (u32)(d + (b ^ (c & (a ^ b))) + 0xc040b340 + st[6]); d = (u32)(a + ((d << 9) | (d >>> 23)));
    c = (u32)(c + (a ^ (b & (d ^ a))) + 0x265e5a51 + st[11]); c = (u32)(d + ((c << 14) | (c >>> 18)));
    b = (u32)(b + (d ^ (a & (c ^ d))) + 0xe9b6c7aa + st[0]); b = (u32)(c + ((b << 20) | (b >>> 12)));
    a = (u32)(a + (c ^ (d & (b ^ c))) + 0xd62f105d + st[5]); a = (u32)(b + ((a << 5) | (a >>> 27)));
    d = (u32)(d + (b ^ (c & (a ^ b))) + 0x02441453 + st[10]); d = (u32)(a + ((d << 9) | (d >>> 23)));
    c = (u32)(c + (a ^ (b & (d ^ a))) + 0xd8a1e681 + st[15]); c = (u32)(d + ((c << 14) | (c >>> 18)));
    b = (u32)(b + (d ^ (a & (c ^ d))) + 0xe7d3fbc8 + st[4]); b = (u32)(c + ((b << 20) | (b >>> 12)));
    a = (u32)(a + (c ^ (d & (b ^ c))) + 0x21e1cde6 + st[9]); a = (u32)(b + ((a << 5) | (a >>> 27)));
    d = (u32)(d + (b ^ (c & (a ^ b))) + 0xc33707d6 + st[14]); d = (u32)(a + ((d << 9) | (d >>> 23)));
    c = (u32)(c + (a ^ (b & (d ^ a))) + 0xf4d50d87 + st[3]); c = (u32)(d + ((c << 14) | (c >>> 18)));
    b = (u32)(b + (d ^ (a & (c ^ d))) + 0x455a14ed + st[8]); b = (u32)(c + ((b << 20) | (b >>> 12)));
    a = (u32)(a + (c ^ (d & (b ^ c))) + 0xa9e3e905 + st[13]); a = (u32)(b + ((a << 5) | (a >>> 27)));
    d = (u32)(d + (b ^ (c & (a ^ b))) + 0xfcefa3f8 + st[2]); d = (u32)(a + ((d << 9) | (d >>> 23)));
    c = (u32)(c + (a ^ (b & (d ^ a))) + 0x676f02d9 + st[7]); c = (u32)(d + ((c << 14) | (c >>> 18)));
    b = (u32)(b + (d ^ (a & (c ^ d))) + 0x8d2a4c8a + st[12]); b = (u32)(c + ((b << 20) | (b >>> 12)));
    st[16] = a; st[17] = b; st[18] = c; st[19] = d;
}

fn _md5Round3(st: [int]) {
    let a: int = st[16]; let b: int = st[17]; let c: int = st[18]; let d: int = st[19];
    a = (u32)(a + (b ^ c ^ d) + 0xfffa3942 + st[5]); a = (u32)(b + ((a << 4) | (a >>> 28)));
    d = (u32)(d + (a ^ b ^ c) + 0x8771f681 + st[8]); d = (u32)(a + ((d << 11) | (d >>> 21)));
    c = (u32)(c + (d ^ a ^ b) + 0x6d9d6122 + st[11]); c = (u32)(d + ((c << 16) | (c >>> 16)));
    b = (u32)(b + (c ^ d ^ a) + 0xfde5380c + st[14]); b = (u32)(c + ((b << 23) | (b >>> 9)));
    a = (u32)(a + (b ^ c ^ d) + 0xa4beea44 + st[1]); a = (u32)(b + ((a << 4) | (a >>> 28)));
    d = (u32)(d + (a ^ b ^ c) + 0x4bdecfa9 + st[4]); d = (u32)(a + ((d << 11) | (d >>> 21)));
    c = (u32)(c + (d ^ a ^ b) + 0xf6bb4b60 + st[7]); c = (u32)(d + ((c << 16) | (c >>> 16)));
    b = (u32)(b + (c ^ d ^ a) + 0xbebfbc70 + st[10]); b = (u32)(c + ((b << 23) | (b >>> 9)));
    a = (u32)(a + (b ^ c ^ d) + 0x289b7ec6 + st[13]); a = (u32)(b + ((a << 4) | (a >>> 28)));
    d = (u32)(d + (a ^ b ^ c) + 0xeaa127fa + st[0]); d = (u32)(a + ((d << 11) | (d >>> 21)));
    c = (u32)(c + (d ^ a ^ b) + 0xd4ef3085 + st[3]); c = (u32)(d + ((c << 16) | (c >>> 16)));
    b = (u32)(b + (c ^ d ^ a) + 0x04881d05 + st[6]); b = (u32)(c + ((b << 23) | (b >>> 9)));
    a = (u32)(a + (b ^ c ^ d) + 0xd9d4d039 + st[9]); a = (u32)(b + ((a << 4) | (a >>> 28)));
    d = (u32)(d + (a ^ b ^ c) + 0xe6db99e5 + st[12]); d = (u32)(a + ((d << 11) | (d >>> 21)));
    c = (u32)(c + (d ^ a ^ b) + 0x1fa27cf8 + st[15]); c = (u32)(d + ((c << 16) | (c >>> 16)));
    b = (u32)(b + (c ^ d ^ a) + 0xc4ac5665 + st[2]); b = (u32)(c + ((b << 23) | (b >>> 9)));
    st[16] = a; st[17] = b; st[18] = c; st[19] = d;
}

fn _md5Round4(st: [int]) {
    let a: int = st[16]; let b: int = st[17]; let c: int = st[18]; let d: int = st[19];
    a = (u32)(a + (c ^ (b | (d ^ M32))) + 0xf4292244 + st[0]); a = (u32)(b + ((a << 6) | (a >>> 26)));
    d = (u32)(d + (b ^ (a | (c ^ M32))) + 0x432aff97 + st[7]); d = (u32)(a + ((d << 10) | (d >>> 22)));
    c = (u32)(c + (a ^ (d | (b ^ M32))) + 0xab9423a7 + st[14]); c = (u32)(d + ((c << 15) | (c >>> 17)));
    b = (u32)(b + (d ^ (c | (a ^ M32))) + 0xfc93a039 + st[5]); b = (u32)(c + ((b << 21) | (b >>> 11)));
    a = (u32)(a + (c ^ (b | (d ^ M32))) + 0x655b59c3 + st[12]); a = (u32)(b + ((a << 6) | (a >>> 26)));
    d = (u32)(d + (b ^ (a | (c ^ M32))) + 0x8f0ccc92 + st[3]); d = (u32)(a + ((d << 10) | (d >>> 22)));
    c = (u32)(c + (a ^ (d | (b ^ M32))) + 0xffeff47d + st[10]); c = (u32)(d + ((c << 15) | (c >>> 17)));
    b = (u32)(b + (d ^ (c | (a ^ M32))) + 0x85845dd1 + st[1]); b = (u32)(c + ((b << 21) | (b >>> 11)));
    a = (u32)(a + (c ^ (b | (d ^ M32))) + 0x6fa87e4f + st[8]); a = (u32)(b + ((a << 6) | (a >>> 26)));
    d = (u32)(d + (b ^ (a | (c ^ M32))) + 0xfe2ce6e0 + st[15]); d = (u32)(a + ((d << 10) | (d >>> 22)));
    c = (u32)(c + (a ^ (d | (b ^ M32))) + 0xa3014314 + st[6]); c = (u32)(d + ((c << 15) | (c >>> 17)));
    b = (u32)(b + (d ^ (c | (a ^ M32))) + 0x4e0811a1 + st[13]); b = (u32)(c + ((b << 21) | (b >>> 11)));
    a = (u32)(a + (c ^ (b | (d ^ M32))) + 0xf7537e82 + st[4]); a = (u32)(b + ((a << 6) | (a >>> 26)));
    d = (u32)(d + (b ^ (a | (c ^ M32))) + 0xbd3af235 + st[11]); d = (u32)(a + ((d << 10) | (d >>> 22)));
    c = (u32)(c + (a ^ (d | (b ^ M32))) + 0x2ad7d2bb + st[2]); c = (u32)(d + ((c << 15) | (c >>> 17)));
    b = (u32)(b + (d ^ (c | (a ^ M32))) + 0xeb86d391 + st[9]); b = (u32)(c + ((b << 21) | (b >>> 11)));
    st[16] = a; st[17] = b; st[18] = c; st[19] = d;
}

// MD5 over `count` 64-byte blocks of data starting at off. h = 4 words,
// st = 20 words of scratch (see _md5Round1).
fn _md5Blocks(h: [int], data: block, off: int, count: int, st: [int]) {
    let n: int = 0;
    while (n < count) {
        let p: int = off + n * 64;
        let j: int = 0;
        while (j < 16) { st[j] = Buffer.ReadU32At(data, p + j * 4, false); j = j + 1; }
        st[16] = h[0]; st[17] = h[1]; st[18] = h[2]; st[19] = h[3];
        _md5Round1(st);
        _md5Round2(st);
        _md5Round3(st);
        _md5Round4(st);
        h[0] = (u32)(h[0] + st[16]); h[1] = (u32)(h[1] + st[17]);
        h[2] = (u32)(h[2] + st[18]); h[3] = (u32)(h[3] + st[19]);
        n = n + 1;
    }
}

// SHA-512/384 over `count` 128-byte blocks. h = 8 words, W = 80 scratch,
// K = SHA512_K. Rotates use `>>>` (logical shift), so this needs a VM with the
// tagged-range fix for [int] arrays (1.0.3.0+) - see the header note above.
fn _sha512Blocks(h: [int], data: block, off: int, count: int, W: [int], K: [int]) {
    let n: int = 0;
    while (n < count) {
        let p: int = off + n * 128;
        let t: int = 0;
        while (t < 16) { W[t] = Buffer.ReadU64At(data, p + t * 8, true); t = t + 1; }
        while (t < 80) {
            let w15: int = W[t - 15];
            let w2: int  = W[t - 2];
            let s0: int = ((w15 >>> 1) | (w15 << 63)) ^ ((w15 >>> 8) | (w15 << 56)) ^ (w15 >>> 7);
            let s1: int = ((w2 >>> 19) | (w2 << 45)) ^ ((w2 >>> 61) | (w2 << 3)) ^ (w2 >>> 6);
            W[t] = W[t - 16] + s0 + W[t - 7] + s1;
            t = t + 1;
        }
        let a: int = h[0]; let b: int = h[1]; let c: int = h[2]; let d: int = h[3];
        let e: int = h[4]; let f: int = h[5]; let g: int = h[6]; let hh: int = h[7];
        t = 0;
        while (t < 80) {
            let S1: int = ((e >>> 14) | (e << 50)) ^ ((e >>> 18) | (e << 46)) ^ ((e >>> 41) | (e << 23));
            let ch: int = (e & f) ^ ((~e) & g);
            let T1: int = hh + S1 + ch + K[t] + W[t];
            let S0: int = ((a >>> 28) | (a << 36)) ^ ((a >>> 34) | (a << 30)) ^ ((a >>> 39) | (a << 25));
            let maj: int = (a & b) ^ (a & c) ^ (b & c);
            let T2: int = S0 + maj;
            hh = g; g = f; f = e; e = d + T1; d = c; c = b; b = a; a = T1 + T2;
            t = t + 1;
        }
        h[0] = h[0] + a; h[1] = h[1] + b; h[2] = h[2] + c; h[3] = h[3] + d;
        h[4] = h[4] + e; h[5] = h[5] + f; h[6] = h[6] + g; h[7] = h[7] + hh;
        n = n + 1;
    }
}

// Keccak-f[1600] on a state of 25 64-bit lanes (index x + 5*y) held as 50
// 32-bit halves, s[2*i] the low and s[2*i + 1] the high half of lane i, so no
// value ever leaves the tagged int range. Theta mixes each column's parity
// into its two neighbours; rho/pi/chi/iota are unrolled with the rotate
// amounts and lane moves of the standard written in. A half rotated by 1..27
// bits is shifted and cut back with (u32); by 28..31 bits it is masked first,
// since the shifted value would leave the tagged range.
fn _keccakTheta(s: [int]) {
    let c0l: int = s[0] ^ s[10] ^ s[20] ^ s[30] ^ s[40];
    let c0h: int = s[1] ^ s[11] ^ s[21] ^ s[31] ^ s[41];
    let c1l: int = s[2] ^ s[12] ^ s[22] ^ s[32] ^ s[42];
    let c1h: int = s[3] ^ s[13] ^ s[23] ^ s[33] ^ s[43];
    let c2l: int = s[4] ^ s[14] ^ s[24] ^ s[34] ^ s[44];
    let c2h: int = s[5] ^ s[15] ^ s[25] ^ s[35] ^ s[45];
    let c3l: int = s[6] ^ s[16] ^ s[26] ^ s[36] ^ s[46];
    let c3h: int = s[7] ^ s[17] ^ s[27] ^ s[37] ^ s[47];
    let c4l: int = s[8] ^ s[18] ^ s[28] ^ s[38] ^ s[48];
    let c4h: int = s[9] ^ s[19] ^ s[29] ^ s[39] ^ s[49];
    let d0l: int = c4l ^ ((u32)(c1l << 1) | (c1h >>> 31));
    let d0h: int = c4h ^ ((u32)(c1h << 1) | (c1l >>> 31));
    let d1l: int = c0l ^ ((u32)(c2l << 1) | (c2h >>> 31));
    let d1h: int = c0h ^ ((u32)(c2h << 1) | (c2l >>> 31));
    let d2l: int = c1l ^ ((u32)(c3l << 1) | (c3h >>> 31));
    let d2h: int = c1h ^ ((u32)(c3h << 1) | (c3l >>> 31));
    let d3l: int = c2l ^ ((u32)(c4l << 1) | (c4h >>> 31));
    let d3h: int = c2h ^ ((u32)(c4h << 1) | (c4l >>> 31));
    let d4l: int = c3l ^ ((u32)(c0l << 1) | (c0h >>> 31));
    let d4h: int = c3h ^ ((u32)(c0h << 1) | (c0l >>> 31));
    s[0] ^= d0l; s[1] ^= d0h; s[2] ^= d1l; s[3] ^= d1h; s[4] ^= d2l; s[5] ^= d2h; s[6] ^= d3l; s[7] ^= d3h; s[8] ^= d4l; s[9] ^= d4h;
    s[10] ^= d0l; s[11] ^= d0h; s[12] ^= d1l; s[13] ^= d1h; s[14] ^= d2l; s[15] ^= d2h; s[16] ^= d3l; s[17] ^= d3h; s[18] ^= d4l; s[19] ^= d4h;
    s[20] ^= d0l; s[21] ^= d0h; s[22] ^= d1l; s[23] ^= d1h; s[24] ^= d2l; s[25] ^= d2h; s[26] ^= d3l; s[27] ^= d3h; s[28] ^= d4l; s[29] ^= d4h;
    s[30] ^= d0l; s[31] ^= d0h; s[32] ^= d1l; s[33] ^= d1h; s[34] ^= d2l; s[35] ^= d2h; s[36] ^= d3l; s[37] ^= d3h; s[38] ^= d4l; s[39] ^= d4h;
    s[40] ^= d0l; s[41] ^= d0h; s[42] ^= d1l; s[43] ^= d1h; s[44] ^= d2l; s[45] ^= d2h; s[46] ^= d3l; s[47] ^= d3h; s[48] ^= d4l; s[49] ^= d4h;
}

// Rho and pi into the locals b<lane>l/h, then chi back into s, with
// a ^ (~b & c) written as a ^ c ^ (b & c), and iota (rcl, rch) last.
fn _keccakRhoPiChi(s: [int], rcl: int, rch: int) {
    let a: int = 0;
    let b: int = 0;
    let b0l: int = s[0];
    let b0h: int = s[1];
    a = s[2]; b = s[3];
    let b10l: int = (u32)(a << 1) | (b >>> 31);
    let b10h: int = (u32)(b << 1) | (a >>> 31);
    a = s[4]; b = s[5];
    let b20l: int = ((b & 3) << 30) | (a >>> 2);
    let b20h: int = ((a & 3) << 30) | (b >>> 2);
    a = s[6]; b = s[7];
    let b5l: int = ((a & 15) << 28) | (b >>> 4);
    let b5h: int = ((b & 15) << 28) | (a >>> 4);
    a = s[8]; b = s[9];
    let b15l: int = (u32)(a << 27) | (b >>> 5);
    let b15h: int = (u32)(b << 27) | (a >>> 5);
    a = s[10]; b = s[11];
    let b16l: int = (u32)(b << 4) | (a >>> 28);
    let b16h: int = (u32)(a << 4) | (b >>> 28);
    a = s[12]; b = s[13];
    let b1l: int = (u32)(b << 12) | (a >>> 20);
    let b1h: int = (u32)(a << 12) | (b >>> 20);
    a = s[14]; b = s[15];
    let b11l: int = (u32)(a << 6) | (b >>> 26);
    let b11h: int = (u32)(b << 6) | (a >>> 26);
    a = s[16]; b = s[17];
    let b21l: int = (u32)(b << 23) | (a >>> 9);
    let b21h: int = (u32)(a << 23) | (b >>> 9);
    a = s[18]; b = s[19];
    let b6l: int = (u32)(a << 20) | (b >>> 12);
    let b6h: int = (u32)(b << 20) | (a >>> 12);
    a = s[20]; b = s[21];
    let b7l: int = (u32)(a << 3) | (b >>> 29);
    let b7h: int = (u32)(b << 3) | (a >>> 29);
    a = s[22]; b = s[23];
    let b17l: int = (u32)(a << 10) | (b >>> 22);
    let b17h: int = (u32)(b << 10) | (a >>> 22);
    a = s[24]; b = s[25];
    let b2l: int = (u32)(b << 11) | (a >>> 21);
    let b2h: int = (u32)(a << 11) | (b >>> 21);
    a = s[26]; b = s[27];
    let b12l: int = (u32)(a << 25) | (b >>> 7);
    let b12h: int = (u32)(b << 25) | (a >>> 7);
    a = s[28]; b = s[29];
    let b22l: int = (u32)(b << 7) | (a >>> 25);
    let b22h: int = (u32)(a << 7) | (b >>> 25);
    a = s[30]; b = s[31];
    let b23l: int = (u32)(b << 9) | (a >>> 23);
    let b23h: int = (u32)(a << 9) | (b >>> 23);
    a = s[32]; b = s[33];
    let b8l: int = (u32)(b << 13) | (a >>> 19);
    let b8h: int = (u32)(a << 13) | (b >>> 19);
    a = s[34]; b = s[35];
    let b18l: int = (u32)(a << 15) | (b >>> 17);
    let b18h: int = (u32)(b << 15) | (a >>> 17);
    a = s[36]; b = s[37];
    let b3l: int = (u32)(a << 21) | (b >>> 11);
    let b3h: int = (u32)(b << 21) | (a >>> 11);
    a = s[38]; b = s[39];
    let b13l: int = (u32)(a << 8) | (b >>> 24);
    let b13h: int = (u32)(b << 8) | (a >>> 24);
    a = s[40]; b = s[41];
    let b14l: int = (u32)(a << 18) | (b >>> 14);
    let b14h: int = (u32)(b << 18) | (a >>> 14);
    a = s[42]; b = s[43];
    let b24l: int = (u32)(a << 2) | (b >>> 30);
    let b24h: int = (u32)(b << 2) | (a >>> 30);
    a = s[44]; b = s[45];
    let b9l: int = ((b & 7) << 29) | (a >>> 3);
    let b9h: int = ((a & 7) << 29) | (b >>> 3);
    a = s[46]; b = s[47];
    let b19l: int = (u32)(b << 24) | (a >>> 8);
    let b19h: int = (u32)(a << 24) | (b >>> 8);
    a = s[48]; b = s[49];
    let b4l: int = (u32)(a << 14) | (b >>> 18);
    let b4h: int = (u32)(b << 14) | (a >>> 18);
    s[0] = b0l ^ b2l ^ (b1l & b2l);
    s[1] = b0h ^ b2h ^ (b1h & b2h);
    s[2] = b1l ^ b3l ^ (b2l & b3l);
    s[3] = b1h ^ b3h ^ (b2h & b3h);
    s[4] = b2l ^ b4l ^ (b3l & b4l);
    s[5] = b2h ^ b4h ^ (b3h & b4h);
    s[6] = b3l ^ b0l ^ (b4l & b0l);
    s[7] = b3h ^ b0h ^ (b4h & b0h);
    s[8] = b4l ^ b1l ^ (b0l & b1l);
    s[9] = b4h ^ b1h ^ (b0h & b1h);
    s[10] = b5l ^ b7l ^ (b6l & b7l);
    s[11] = b5h ^ b7h ^ (b6h & b7h);
    s[12] = b6l ^ b8l ^ (b7l & b8l);
    s[13] = b6h ^ b8h ^ (b7h & b8h);
    s[14] = b7l ^ b9l ^ (b8l & b9l);
    s[15] = b7h ^ b9h ^ (b8h & b9h);
    s[16] = b8l ^ b5l ^ (b9l & b5l);
    s[17] = b8h ^ b5h ^ (b9h & b5h);
    s[18] = b9l ^ b6l ^ (b5l & b6l);
    s[19] = b9h ^ b6h ^ (b5h & b6h);
    s[20] = b10l ^ b12l ^ (b11l & b12l);
    s[21] = b10h ^ b12h ^ (b11h & b12h);
    s[22] = b11l ^ b13l ^ (b12l & b13l);
    s[23] = b11h ^ b13h ^ (b12h & b13h);
    s[24] = b12l ^ b14l ^ (b13l & b14l);
    s[25] = b12h ^ b14h ^ (b13h & b14h);
    s[26] = b13l ^ b10l ^ (b14l & b10l);
    s[27] = b13h ^ b10h ^ (b14h & b10h);
    s[28] = b14l ^ b11l ^ (b10l & b11l);
    s[29] = b14h ^ b11h ^ (b10h & b11h);
    s[30] = b15l ^ b17l ^ (b16l & b17l);
    s[31] = b15h ^ b17h ^ (b16h & b17h);
    s[32] = b16l ^ b18l ^ (b17l & b18l);
    s[33] = b16h ^ b18h ^ (b17h & b18h);
    s[34] = b17l ^ b19l ^ (b18l & b19l);
    s[35] = b17h ^ b19h ^ (b18h & b19h);
    s[36] = b18l ^ b15l ^ (b19l & b15l);
    s[37] = b18h ^ b15h ^ (b19h & b15h);
    s[38] = b19l ^ b16l ^ (b15l & b16l);
    s[39] = b19h ^ b16h ^ (b15h & b16h);
    s[40] = b20l ^ b22l ^ (b21l & b22l);
    s[41] = b20h ^ b22h ^ (b21h & b22h);
    s[42] = b21l ^ b23l ^ (b22l & b23l);
    s[43] = b21h ^ b23h ^ (b22h & b23h);
    s[44] = b22l ^ b24l ^ (b23l & b24l);
    s[45] = b22h ^ b24h ^ (b23h & b24h);
    s[46] = b23l ^ b20l ^ (b24l & b20l);
    s[47] = b23h ^ b20h ^ (b24h & b20h);
    s[48] = b24l ^ b21l ^ (b20l & b21l);
    s[49] = b24h ^ b21h ^ (b20h & b21h);
    s[0] ^= rcl;
    s[1] ^= rch;
}

// The 24 rounds. RC is KECCAK_RC: the round constants as (low, high) pairs.
fn _keccakF(s: [int], RC: [int]) {
    let rnd: int = 0;
    while (rnd < 48) {
        _keccakTheta(s);
        _keccakRhoPiChi(s, RC[rnd], RC[rnd + 1]);
        rnd = rnd + 2;
    }
}

// Sponge absorb: XOR `count` blocks of laneCount*8 bytes of `data` (from
// `off`) into the rate lanes of `s`, permuting after each. laneCount is
// rate/8 (9/13/17/18/21 for the five rates this library uses).
fn _keccakAbsorb(s: [int], data: block, off: int, count: int, laneCount: int, RC: [int]) {
    let n: int = 0;
    let halves: int = laneCount * 2;
    while (n < count) {
        let p: int = off + n * (laneCount * 8);
        let i: int = 0;
        while (i < halves) {
            s[i] ^= Buffer.ReadU32At(data, p + i * 4, false);
            i = i + 1;
        }
        _keccakF(s, RC);
        n = n + 1;
    }
}

// Write the first n (1..8) little-endian bytes of the lane (lo, hi) to out[off..].
fn _writeLaneBytes(out: block, off: int, lo: int, hi: int, n: int) {
    let i: int = 0;
    while (i < n) {
        out[off + i] = i < 4 ? lo >>> (8 * i) : hi >>> (8 * (i - 4));
        i = i + 1;
    }
}

class Digest {
    let _algo = 0;          // DIGEST_*
    let _native = nil;      // Hash.Begin state for SHA-1/256/512; nil for the script algorithms
    let _h = nil;           // [int] state words (4/8 for MD5/SHA-384, 50 lane halves for Keccak)
    let _w = nil;           // [int] message schedule scratch (Keccak: unused)
    let _buf = nil;         // block(_blockSize): bytes not yet compressed
    let _bufLen = 0;
    let _total = 0;         // bytes hashed so far (a 64-bit byte count; see Final)
    let _result = nil;      // block: cached raw digest once Final ran
    let _finished = false;  // true once Final or Squeeze has run; blocks further Update
    let _blockSize = 64;    // 64 for MD5; 128 for SHA-384; the sponge
                             // "rate" in bytes for the Keccak family (72/104/136/144/168)
    let _lenBytes = 8;      // Merkle-Damgard trailing length field: 8 or 16 bytes
    let _outWords = 0;      // how many _h words Final emits (Merkle-Damgard family)
    let _wordBytes = 4;     // bytes per emitted word: 4 or 8 (Merkle-Damgard family)
    let _sponge = false;    // true for SHA3-*/Keccak256/SHAKE* (a Keccak sponge, not Merkle-Damgard)
    let _padByte = 0;       // sponge domain-separation + first pad bit: 0x06 SHA3, 0x01 Keccak256, 0x1F SHAKE
    let _outBytes = 0;      // fixed sponge output length in bytes; 0 for SHAKE (use Squeeze)

    fn Constructor(algo) {
        let name = (algo == nil || Type.Of(algo) != Type.String) ? "" : String.ToLower(algo);
        if (name == "md5") {
            this._algo = DIGEST_MD5; this._h = Array.Create(4, Type.Int); this._w = Array.Create(20, Type.Int);
            this._blockSize = 64; this._lenBytes = 8; this._outWords = 4; this._wordBytes = 4;
        } else if (name == "sha1" || name == "sha-1") {
            this._algo = DIGEST_SHA1;
        } else if (name == "sha256" || name == "sha-256") {
            this._algo = DIGEST_SHA256;
        } else if (name == "sha384" || name == "sha-384") {
            this._algo = DIGEST_SHA384; this._h = Array.Create(8, Type.Int); this._w = Array.Create(80, Type.Int);
            this._blockSize = 128; this._lenBytes = 16; this._outWords = 6; this._wordBytes = 8;
        } else if (name == "sha512" || name == "sha-512") {
            this._algo = DIGEST_SHA512;
        } else if (name == "sha3-224" || name == "sha3_224") {
            this._algo = DIGEST_SHA3_224; this._blockSize = 144; this._padByte = 0x06; this._outBytes = 28; this._sponge = true;
        } else if (name == "sha3-256" || name == "sha3_256") {
            this._algo = DIGEST_SHA3_256; this._blockSize = 136; this._padByte = 0x06; this._outBytes = 32; this._sponge = true;
        } else if (name == "sha3-384" || name == "sha3_384") {
            this._algo = DIGEST_SHA3_384; this._blockSize = 104; this._padByte = 0x06; this._outBytes = 48; this._sponge = true;
        } else if (name == "sha3-512" || name == "sha3_512") {
            this._algo = DIGEST_SHA3_512; this._blockSize = 72; this._padByte = 0x06; this._outBytes = 64; this._sponge = true;
        } else if (name == "keccak256" || name == "keccak-256" || name == "keccak_256") {
            this._algo = DIGEST_KECCAK256; this._blockSize = 136; this._padByte = 0x01; this._outBytes = 32; this._sponge = true;
        } else if (name == "shake128" || name == "shake-128" || name == "shake_128") {
            this._algo = DIGEST_SHAKE128; this._blockSize = 168; this._padByte = 0x1F; this._outBytes = 0; this._sponge = true;
        } else if (name == "shake256" || name == "shake-256" || name == "shake_256") {
            this._algo = DIGEST_SHAKE256; this._blockSize = 136; this._padByte = 0x1F; this._outBytes = 0; this._sponge = true;
        } else { this._algo = 0; }
        if (this._sponge) { this._h = Array.Create(50, Type.Int); }
        if (this._algo != DIGEST_SHA1 && this._algo != DIGEST_SHA256 && this._algo != DIGEST_SHA512) {
            this._buf = Buffer.Create(this._blockSize < 1 ? 1 : this._blockSize, 1);
        }
        this.Reset();
    }

    fn static Algorithms(): array {
        return ["md5", "sha1", "sha256", "sha384", "sha512",
                "sha3-224", "sha3-256", "sha3-384", "sha3-512", "keccak256", "shake128", "shake256"];
    }

    // One-shot MD5. hex by default; raw = true gives the 16 bytes.
    fn static Md5(data, raw?) {
        let d = new Digest("md5");
        if (d.Update(data) == nil) { return nil; }
        return d.Final(raw);
    }

    // One-shot Keccak-256 (Ethereum-style: same permutation as SHA3-256, the
    // 0x01 pre-standardization padding byte instead of NIST's 0x06 - a
    // genuinely different 32-byte hash from SHA3-256, not a naming variant).
    fn static Keccak256(data, raw?) {
        let d = new Digest("keccak256");
        if (d.Update(data) == nil) { return nil; }
        return d.Final(raw);
    }

    // One-shot SHAKE128/256 extendable-output hash: outLen bytes of output.
    fn static Shake128(data, outLen, raw?) {
        let d = new Digest("shake128");
        if (d.Update(data) == nil) { return nil; }
        return d.Squeeze(outLen, raw);
    }
    fn static Shake256(data, outLen, raw?) {
        let d = new Digest("shake256");
        if (d.Update(data) == nil) { return nil; }
        return d.Squeeze(outLen, raw);
    }

    fn Algorithm(): string {
        if (this._algo == DIGEST_MD5) { return "md5"; }
        if (this._algo == DIGEST_SHA1) { return "sha1"; }
        if (this._algo == DIGEST_SHA256) { return "sha256"; }
        if (this._algo == DIGEST_SHA384) { return "sha384"; }
        if (this._algo == DIGEST_SHA512) { return "sha512"; }
        if (this._algo == DIGEST_SHA3_224) { return "sha3-224"; }
        if (this._algo == DIGEST_SHA3_256) { return "sha3-256"; }
        if (this._algo == DIGEST_SHA3_384) { return "sha3-384"; }
        if (this._algo == DIGEST_SHA3_512) { return "sha3-512"; }
        if (this._algo == DIGEST_KECCAK256) { return "keccak256"; }
        if (this._algo == DIGEST_SHAKE128) { return "shake128"; }
        if (this._algo == DIGEST_SHAKE256) { return "shake256"; }
        return nil;
    }

    fn Reset(): Digest {
        this._bufLen = 0;
        this._total = 0;
        this._result = nil;
        this._finished = false;
        if (this._algo == DIGEST_SHA1 || this._algo == DIGEST_SHA256 || this._algo == DIGEST_SHA512) {
            this._native = Hash.Begin(this.Algorithm());
        } else if (this._sponge) {
            let i = 0; while (i < 50) { this._h[i] = 0; i = i + 1; }
        } else if (this._algo == DIGEST_MD5) {
            this._h[0] = 0x67452301; this._h[1] = 0xefcdab89; this._h[2] = 0x98badcfe; this._h[3] = 0x10325476;
        } else if (this._algo == DIGEST_SHA384) {
            let i = 0; while (i < 8) { this._h[i] = SHA384_IV[i]; i = i + 1; }
        }
        return this;
    }

    fn _compress(data, off: int, count: int) {
        if (this._algo == DIGEST_MD5)         { _md5Blocks(this._h, data, off, count, this._w); }
        else if (this._algo == DIGEST_SHA384) { _sha512Blocks(this._h, data, off, count, this._w, SHA512_K); }
        else if (this._sponge) { _keccakAbsorb(this._h, data, off, count, this._blockSize / 8, KECCAK_RC); }
    }

    // Feed more bytes (string or block). Returns this, or nil after Final,
    // after Squeeze, or on an unusable argument.
    fn Update(data): Digest {
        if (this._algo == 0 || this._finished) { return nil; }
        if (data == nil) { return this; }
        if (!_isBytes(data)) { return nil; }
        let n = len(data);
        if (n == 0) { return this; }
        if (this._native != nil) {
            Hash.Update(this._native, data);
            return this;
        }
        let b = _toBlock(data);
        let pos = 0;

        let bs = this._blockSize;
        if (this._bufLen > 0) {
            let fill = bs - this._bufLen;
            if (fill > n) { fill = n; }
            Buffer.Copy(b, 0, this._buf, this._bufLen, fill);
            this._bufLen = this._bufLen + fill;
            pos = fill;
            if (this._bufLen == bs) {
                this._compress(this._buf, 0, 1);
                this._bufLen = 0;
            }
        }
        let full = (n - pos) / bs;
        if (full > 0) {
            this._compress(b, pos, full);
            pos = pos + full * bs;
        }
        let rem = n - pos;
        if (rem > 0) {
            Buffer.Copy(b, pos, this._buf, 0, rem);
            this._bufLen = rem;
        }
        this._total = this._total + n;
        return this;
    }

    // Pad the buffered tail to exactly one rate-sized block (Keccak's
    // multi-rate pad10*1: `_padByte` at the first pad position, 0x80 at the
    // last byte of the block - the same byte when they coincide, which XOR
    // handles for free) and absorb it. Unlike Merkle-Damgard padding this
    // never needs a second block: the sponge carries no length field, so
    // there is always room for at least the pad byte plus the 0x80 in the
    // `_bufLen`..`_blockSize`-1 gap.
    fn _padAbsorb() {
        let bs = this._blockSize;
        let tail = Buffer.Create(bs, 1);
        Buffer.Fill(tail, 0);
        if (this._bufLen > 0) { Buffer.Copy(this._buf, 0, tail, 0, this._bufLen); }
        tail[this._bufLen] = tail[this._bufLen] ^ this._padByte;
        tail[bs - 1] = tail[bs - 1] ^ 0x80;
        this._compress(tail, 0, 1);
    }

    // Finish: pad, compress, and return the digest as hex (raw = true: block).
    // Calling it again returns the same digest; Update after it returns nil.
    // For SHAKE128/256 (arbitrary output length) this always returns nil -
    // use Squeeze(outLen) instead.
    // The RFC length field is 8 bytes (MD5/SHA-1/SHA-256) or 16 bytes
    // (SHA-384/512); the message length is tracked as a 64-bit byte count, so
    // the top 8 bytes of a 16-byte field are always zero - true for any
    // message that fits in memory or on disk.
    fn Final(raw?) {
        if (this._algo == 0) { return nil; }
        if (this._algo == DIGEST_SHAKE128 || this._algo == DIGEST_SHAKE256) { return nil; }
        this._finished = true;
        if (this._result == nil) {
            if (this._native != nil) {
                this._result = Hash.Final(this._native, true);
            } else if (this._sponge) {
                this._padAbsorb();
                let outBytes = this._outBytes;
                let out = Buffer.Create(outBytes, 1);
                let got = 0; let lane = 0;
                while (got < outBytes) {
                    let take = outBytes - got; if (take > 8) { take = 8; }
                    _writeLaneBytes(out, got, this._h[2 * lane], this._h[2 * lane + 1], take);
                    got = got + take; lane = lane + 1;
                }
                this._result = out;
            } else {
                let bs = this._blockSize;
                let lb = this._lenBytes;
                let tail = Buffer.Create(bs * 2, 1);
                Buffer.Fill(tail, 0);
                if (this._bufLen > 0) { Buffer.Copy(this._buf, 0, tail, 0, this._bufLen); }
                tail[this._bufLen] = 0x80;
                let padLen = (this._bufLen < bs - lb) ? bs : bs * 2;
                let bits = this._total * 8;
                let bigEndian = this._algo != DIGEST_MD5;
                if (lb == 16) { Buffer.WriteU64At(tail, padLen - 16, 0, true); }
                Buffer.WriteU64At(tail, padLen - 8, bits, bigEndian);
                this._compress(tail, 0, padLen / bs);

                let words = this._outWords;
                let wb = this._wordBytes;
                let out = Buffer.Create(words * wb, 1);
                let i = 0;
                while (i < words) {
                    if (wb == 8) { Buffer.WriteU64At(out, i * 8, this._h[i], bigEndian); }
                    else         { Buffer.WriteU32At(out, i * 4, this._h[i], bigEndian); }
                    i = i + 1;
                }
                this._result = out;
            }
        }
        if (raw == true) { return this._result; }
        return Util.BinToHex(this._result);
    }

    // SHAKE128/256 only: squeeze exactly outLen bytes of extendable output
    // (hex by default; raw = true gives the block). One-shot, like Final -
    // Update afterward returns nil, and a second Squeeze call (even with a
    // different outLen) returns nil rather than silently returning unrelated
    // output; Reset() first if a different length is needed. outLen beyond
    // the rate (168 bytes for SHAKE128, 136 for SHAKE256) runs the
    // permutation again to produce more output, exactly as the standard
    // defines - there is no length limit here beyond a sanity cap.
    fn Squeeze(outLen, raw?) {
        if (this._algo != DIGEST_SHAKE128 && this._algo != DIGEST_SHAKE256) { return nil; }
        if (this._finished) { return nil; }
        // outLen is deliberately untyped: a typed `int` parameter on a class
        // method (static or instance) raises an uncatchable native exception
        // when given a value of any other type instead of the compile-time
        // error a free function gets or a value this method could check and
        // reject - see the note in the header. Checking the type ourselves,
        // on an untyped parameter, is what keeps "bad input returns nil" true.
        if (outLen == nil || Type.Of(outLen) != Type.Int || outLen < 1 || outLen > 16777216) { return nil; }
        this._finished = true;
        this._padAbsorb();
        let laneCount = this._blockSize / 8;
        let out = Buffer.Create(outLen, 1);
        let got = 0;
        while (got < outLen) {
            let i = 0;
            while (i < laneCount && got < outLen) {
                let take = outLen - got; if (take > 8) { take = 8; }
                _writeLaneBytes(out, got, this._h[2 * i], this._h[2 * i + 1], take);
                got = got + take;
                i = i + 1;
            }
            if (got < outLen) { _keccakF(this._h, KECCAK_RC); }
        }
        if (raw == true) { return out; }
        return Util.BinToHex(out);
    }
}

export { Kdf, Otp, Password, Envelope, Digest };
