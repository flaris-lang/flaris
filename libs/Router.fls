// =============================================================================
// Router.fls - HTTP server router with middleware pipeline for Flaris.
// Version: 1.0
//
// Exports:
//   Router              - HTTP router (register routes, run server)
//   Response            - static response builder helpers
//   JwtMiddleware       - JWT Bearer token authentication
//   JwtSign(payload, secret, expirySecs)  - issue a signed HS256 JWT
//   LoggerMiddleware    - request/response logging
//   CorsMiddleware      - CORS response headers
//   RateLimitMiddleware - sliding-window rate limiter keyed on the client
//   SecurityHeadersMiddleware - browser-side defence headers in one place
//
// Usage:
//   import { Router, Response, LoggerMiddleware, CorsMiddleware, JwtMiddleware, JwtSign }
//       from library("Router", "1.0");
//
//   let app = new Router();
//   app.Use(fn(req, next) { return (new LoggerMiddleware()).Handle(req, next); });
//   app.Use(fn(req, next) { return (new CorsMiddleware("*")).Handle(req, next); });
//
//   app.Get("/", fn(req) { return Response.Text("Hello"); });
//   app.Post("/echo", fn(req) { return Response.Json(Json.Parse(req.body)); });
//
//   let api = app.Group("/api");
//   api.Use(fn(req, next) {
//       return (new JwtMiddleware("my-secret", ["/api/login"])).Handle(req, next);
//   });
//   api.Get("/users", fn(req) { return Response.Json([{ id: 1 }]); });
//
//   app.Listen(8080);
//
// Router:
//   new Router()
//   .Get(pattern, handler)      - register route; pattern can include :param segments
//   .Post(pattern, handler)
//   .Put(pattern, handler)
//   .Delete(pattern, handler)
//   .Patch(pattern, handler)
//   .Head(pattern, handler)
//   .Use(middleware)            - add global middleware (fn(req, next) → response)
//   .Group(prefix)  →  RouteGroup  - prefix-scoped sub-router
//   .Host(hostname) →  RouteGroup  - routes that answer only for that Host.
//       "*.example.com" covers any subdomain but not the bare domain;
//       comparison ignores case and the port. Routes registered directly on
//       the router still serve every host, and a host-scoped route wins over a
//       host-agnostic one for the same path.
//       let site = app.Host("shop.example.com");
//       site.Get("/", fn(req) { ... });
//   .Static(urlPrefix, rootDir, opts?) - serve files under rootDir (path-safe)
//       opts: { index:"index.html", fallback:"<file>", cacheControl:"<value>",
//               dotfiles:false, followSymlinks:false }
//       Dotfiles (.env, .git, ...) and symlinks leaving the root are refused
//       by default; ".well-known" stays reachable for ACME and security.txt.
//   .NotFound(handler)          - custom 404 handler
//   .Listen(port, opts?)        - start blocking HTTP server; opts pass through
//                                 to HttpServer (tls, streamBodies, timeouts...)
//   .OnAccess(handler)          - fn(entry) per completed request; pair with
//                                 HttpStatus.CombinedLogLine(entry)
//   .Stop(timeoutMs?)           - stop accepting, then wait for in-flight
//                                 requests to finish (default 5000 ms)
//
//   Dispatch: patterns are split once at registration, not per request. A
//   pattern with no ":param" and no "*" is answered from a map, so the route
//   table can grow without slowing those routes down; only parametric routes
//   are scanned in order, and each route caches its combined middleware chain
//   until Use() adds another. Matching stays lenient about empty and trailing
//   path segments, as before.
//
//   Note: global middleware also runs for unmatched routes, so CORS preflight
//   (OPTIONS) and logging apply even without a registered handler.
//
//   handler signature:  fn(req) → response
//   req object:  { method, path, rawPath, params, query, headers, cookies,
//                  form, peer, secure, body }
//   cookies:     parsed Cookie header (empty when the request sent none)
//   form:        parsed application/x-www-form-urlencoded body (empty otherwise)
//   params:      path parameters from :name segments (req.params.name)
//   headers:     readable under both spellings - req.headers["Content-Type"]
//                and req.headers["content-type"] both resolve
//   peer:        client address as "ip:port"; identify a caller with this
//                rather than a header, which the client controls
//   secure:      true when the connection terminated TLS
//
// RouteGroup (returned by Group or Host):
//   .Get / .Post / .Put / .Delete / .Patch(pattern, handler)
//   .Use(middleware)    - group-scoped middleware
//   .Group(prefix)      - nested prefix group, keeping this group's host and
//                         middleware:  app.Host("api.example").Group("/v1")
//
// Middleware:
//   fn(req, next) → response
//   Call next(req) to continue the chain; return early to short-circuit.
//   Can modify req before and/or response after calling next(req).
//
// Response (static builders):
//   Response.Json(data, status?)      - Content-Type: application/json
//   Response.Text(text, status?)      - Content-Type: text/plain
//   Response.Html(html, status?)      - Content-Type: text/html
//   Response.Error(status, message)   - JSON error body
//   Response.Redirect(url, status?)   - 302 by default
//   Response.NoContent()              - 204
//   Response.WithCookie(resp, name, value, opts?)  - attach a Set-Cookie
//   Response.ClearCookie(resp, name, opts?)        - expire one
//       opts: { maxAge, expires, path, domain, httpOnly, secure, sameSite }
//       Defaults are HttpOnly, SameSite=Lax, and Secure over TLS.
//   Response.File(path, contentType?) - serve a file. The response names the
//       file rather than carrying its bytes ({ status, file, headers }), so the
//       server can answer with ETag/Last-Modified, honour a conditional request
//       or a byte range, and send it without copying it through this VM.
//       Middleware still sees and can amend status and headers.
//
// Bundled middleware classes:
//   new LoggerMiddleware()
//   new CorsMiddleware(origin, opts?)  - origin: "*" or specific domain
//       - opts: { methods, headers, maxAge, credentials, exposeHeaders }
//   new JwtMiddleware(secret, skipPaths?, opts?)
//       - validates "Authorization: Bearer <token>"; adds req.jwt
//       - verifies the signature *and* the claims: an expired (exp) or
//         not-yet-valid (nbf) token is refused, not just a badly signed one
//       - skipPaths: array of exact paths that bypass auth
//       - opts: { leeway: seconds of clock skew to tolerate,
//                 requireExp: refuse a token that carries no expiry }
//   new RateLimitMiddleware(limit, windowSeconds, opts?)
//       - sliding window, so a caller cannot spend its whole allowance at the
//         end of one window and again at the start of the next
//       - keyed on req.peer (port stripped). X-Forwarded-For is honoured only
//         with { trustProxy: true }: without a proxy in front it is
//         client-controlled, and trusting it lets any caller mint identities
//       - opts: { keyFn, skip, trustProxy, maxKeys, headers, clock }
//       - emits RateLimit-Limit / -Remaining / -Reset, and Retry-After on 429
//       - bounded memory: idle buckets are swept at maxKeys (default 10000)
//       - .TrackedKeys() gauges the live set; .Reset() clears it
//   JwtSign(payload, secret, expirySecs)  →  token string
// =============================================================================

import { HttpServer } from library("HttpServer", "1.0");
import { Jwt } from library("Jwt", "1.0");
import { Logger } from library("Logger", "1.0");

global _jwt = new Jwt();

// Canonical spelling of a header name ("content-type" -> "Content-Type").
// Handlers conventionally write req.headers["Authorization"] while the parser
// hands us lowercase keys, so both spellings are exposed - but the split,
// capitalise and rejoin only has to happen once per distinct name, not once per
// header on every request. Cleared wholesale rather than evicted: it exists to
// catch the small set of names real clients send, and a peer inventing new ones
// must not grow it without bound.
global _MIME = {
            html: "text/html; charset=utf-8",
            htm:  "text/html; charset=utf-8",
            css:  "text/css; charset=utf-8",
            js:   "text/javascript; charset=utf-8",
            mjs:  "text/javascript; charset=utf-8",
            json: "application/json; charset=utf-8",
            xml:  "application/xml; charset=utf-8",
            txt:  "text/plain; charset=utf-8",
            md:   "text/markdown; charset=utf-8",
            csv:  "text/csv; charset=utf-8",
            svg:  "image/svg+xml",
            png:  "image/png",
            jpg:  "image/jpeg",
            jpeg: "image/jpeg",
            gif:  "image/gif",
            webp: "image/webp",
            ico:  "image/x-icon",
            bmp:  "image/bmp",
            woff: "font/woff",
            woff2:"font/woff2",
            ttf:  "font/ttf",
            otf:  "font/otf",
            eot:  "application/vnd.ms-fontobject",
            pdf:  "application/pdf",
            wasm: "application/wasm",
            mp4:  "video/mp4",
            webm: "video/webm",
            mp3:  "audio/mpeg",
            wav:  "audio/wav",
            ogg:  "audio/ogg",
            zip:  "application/zip",
            gz:   "application/gzip"
};

global _canonMemo = {};
global _canonMemoN:int = 0;

fn _canonName(k:string): string {
    let hit = Object.TryGet(_canonMemo, k, nil);
    if (hit != nil) { return hit; }

    let parts:array  = String.Split(k, "-");
    let canon:string = "";
    let j:int = 0;
    while (j < len(parts)) {
        let p:string = parts[j];
        if (String.Length(p) > 0) {
            p = String.ToUpper(String.Left(p, 1)) +
                String.Substr(p, 1, String.Length(p) - 1);
        }
        canon = (j == 0) ? p : canon + "-" + p;
        j += 1;
    }

    if (_canonMemoN >= 512) { _canonMemo = {}; _canonMemoN = 0; }
    _canonMemo[k] = canon;
    _canonMemoN = _canonMemoN + 1;
    return canon;
}

// =============================================================================
// _Pipeline - executes a middleware chain + terminal handler for one request.
//
// Chain entries: { handler: fn }  (each is fn(req, next) -> response)
// Terminal handler: fn(req) -> response
//
// A new _Pipeline instance is created per dispatch so _index is isolated.
// =============================================================================

class _Pipeline
{
    let _chain:array = [];
    let _terminal    = nil;
    let _index:int   = 0;

    fn Constructor(chain:array, terminal) {
        _chain    = chain;
        _terminal = terminal;
        _index    = 0;
    }

    fn Run(req) {
        if (_index >= len(_chain)) {
            return _terminal(req);
        }
        let entry = _chain[_index];
        _index++;
        return entry.handler(req, fn(r) {
            return this.Run(r);
        });
    }
}

// =============================================================================
// RouteGroup - prefix-scoped route registration with optional middleware
// =============================================================================

class RouteGroup
{
    let _router           = nil;
    let _prefix:string    = "";
    let _middleware:array = [];
    let _host             = nil;   // nil = serves every host

    fn Constructor(router, prefix:string, host?) {
        _router     = router;
        _prefix     = prefix;
        _middleware = [];
        _host       = host ?? nil;
    }

    // A nested prefix group, keeping this group's host and middleware:
    //   let api = app.Host("api.example").Group("/v1");
    fn Group(prefix:string) {
        let g = new RouteGroup(_router, _prefix + prefix, _host);
        foreach (m in _middleware) { g.Use(m.handler); }
        return g;
    }

    fn Get(pattern:string, handler:fn) {
        _router._addGroupRoute("GET", _prefix + pattern, handler, _middleware, _host);
    }

    fn Post(pattern:string, handler:fn) {
        _router._addGroupRoute("POST", _prefix + pattern, handler, _middleware, _host);
    }

    fn Put(pattern:string, handler:fn) {
        _router._addGroupRoute("PUT", _prefix + pattern, handler, _middleware, _host);
    }

    fn Delete(pattern:string, handler:fn) {
        _router._addGroupRoute("DELETE", _prefix + pattern, handler, _middleware, _host);
    }

    fn Patch(pattern:string, handler:fn) {
        _router._addGroupRoute("PATCH", _prefix + pattern, handler, _middleware, _host);
    }

    // Register middleware scoped to this group only: fn(req, next) -> response
    fn Use(middleware:fn) {
        Array.Append(_middleware, { handler: middleware });
    }
}

// =============================================================================
// Router
// =============================================================================

class Router
{
    let _routes:array     = [];   // dynamic routes (":param" or "*"), in order
    let _exact             = nil;  // "GET /api/users" -> route, for fixed patterns
    let _middleware:array = [];
    let _server            = nil;
    let _notFound          = nil;
    let _running           = true;
    let _gen:int          = 0;    // bumped by Use(); invalidates cached chains
    let _onAccess          = nil;
    let _hasHosts:bool     = false;  // any host-scoped routes at all?

    fn Constructor() {
        _routes     = [];
        _exact      = {};
        _middleware = [];
        _gen        = 0;
    }

    // ---- route registration ----

    fn Get(pattern:string, handler:fn) {
        _addRoute("GET", pattern, handler, []);
    }

    fn Post(pattern:string, handler:fn) {
        _addRoute("POST", pattern, handler, []);
    }

    fn Put(pattern:string, handler:fn) {
        _addRoute("PUT", pattern, handler, []);
    }

    fn Delete(pattern:string, handler:fn) {
        _addRoute("DELETE", pattern, handler, []);
    }

    fn Patch(pattern:string, handler:fn) {
        _addRoute("PATCH", pattern, handler, []);
    }

    fn Head(pattern:string, handler:fn) {
        _addRoute("HEAD", pattern, handler, []);
    }

    // Patterns are split once, at registration. The old matcher re-split both
    // the pattern *and* the request path for every route on every request.
    fn _addRoute(method:string, pattern:string, handler:fn, routeMiddleware:array, host?) {
        let raw = String.Split(pattern, "/");
        let segs:array    = [];
        let catchAll:bool = false;
        let dynamic:bool  = false;

        let i:int = 0;
        while (i < len(raw)) {
            let sg:string = raw[i];
            i += 1;
            if (String.Length(sg) == 0) { continue; }
            if (sg == "*") { catchAll = true; dynamic = true; continue; }
            if (String.CharAt(sg, 0) == ':') { dynamic = true; }
            Array.Append(segs, sg);
        }

        let h = host ?? nil;
        if (h != nil) { _hasHosts = true; }

        let route = {
            method:     method,
            pattern:    pattern,
            segs:       segs,
            catchAll:   catchAll,
            handler:    handler,
            middleware: routeMiddleware,
            host:       h,
            chain:      nil,
            chainGen:   -1
        };

        // A pattern with no ":param" and no "*" can only ever match one path,
        // so it answers from a map and never enters the segment loop. A
        // wildcard host cannot be hashed, so those routes are scanned instead.
        let wildHost = (h != nil) && String.StartsWith(h, "*");
        if (dynamic || wildHost) {
            Array.Append(_routes, route);
        } else {
            _exact[(h ?? "") + "\n" + method + " /" + String.Join(segs, "/")] = route;
        }
    }

    fn _addGroupRoute(method:string, pattern:string, handler:fn, routeMiddleware:array, host?) {
        _addRoute(method, pattern, handler, routeMiddleware, host ?? nil);
    }

    // ---- route groups ----

    fn Group(prefix:string) {
        return new RouteGroup(this, prefix, nil);
    }

    // ---- virtual hosts ----
    // Routes registered on the returned group answer only for that Host:
    //   let site = app.Host("shop.example.com");
    //   site.Get("/", fn(req) { ... });
    //
    // "*.example.com" covers any subdomain but not the bare domain. Comparison
    // ignores case and the port. A route registered directly on the router
    // (not through Host) keeps serving every host, and a host-scoped route
    // takes precedence over a host-agnostic one for the same path.
    fn Host(hostname:string) {
        _hasHosts = true;
        return new RouteGroup(this, "", String.ToLower(hostname));
    }

    // ---- static file serving ----
    // Mount a directory at urlPrefix and serve its files safely. Path traversal
    // (".." segments, backslashes) is rejected with 403. Directory requests fall
    // back to the index file. options (optional):
    //   { index: "index.html", fallback: "<path>", cacheControl: "<value>" }
    // `fallback` serves a single file for any unmatched path (SPA support).
    // Example: app.Static("/assets", "./public", { cacheControl: "max-age=3600" });
    fn Static(urlPrefix:string, rootDir:string, options) {
        let handler = new _StaticHandler(rootDir, options);
        let pattern = urlPrefix + "/*";
        _addRoute("GET",  pattern, fn(req) { return handler.Serve(req); }, []);
        _addRoute("HEAD", pattern, fn(req) { return handler.Serve(req); }, []);
        return this;
    }

    // ---- middleware ----
    // Signature: fn(req, next) -> response

    fn Use(middleware:fn) {
        Array.Append(_middleware, { handler: middleware });
        // Routes cache their combined chain; a middleware registered after the
        // routes were declared still has to apply to them.
        _gen = _gen + 1;
    }

    // ---- custom 404 handler ----

    fn NotFound(handler:fn) {
        _notFound = handler;
    }

    // fn(entry) once per completed request. Pair it with
    // HttpStatus.CombinedLogLine(entry) for a standard access log.
    fn OnAccess(handler:fn) {
        _onAccess = handler;
        return this;
    }

    // ---- combine global + route-scoped middleware into one chain ----

    fn _buildChain(routeMiddleware:array) {
        let combined:array = [];
        let i:int = 0;
        while (i < len(_middleware)) {
            Array.Append(combined, _middleware[i]);
            i += 1;
        }
        i = 0;
        while (i < len(routeMiddleware)) {
            Array.Append(combined, routeMiddleware[i]);
            i += 1;
        }
        return combined;
    }

    fn _cookiesOf(req): object {
        let h = req.Header("Cookie", nil);
        if (h == nil) { return {}; }
        return req.Cookies();
    }

    fn _formOf(req): object {
        let ct = String.ToLower(req.Header("Content-Type", "") ?? "");
        if (!String.Contains(ct, "application/x-www-form-urlencoded")) { return {}; }
        return req.Form();
    }

    // ---- dispatch ----

    // Match req.method/req.path against a pattern. ':name' captures into
    // req.params and a terminal '*' takes the rest. `req` may be a plain object
    // or a request instance.
    // HTTP header names are case-insensitive, but a plain object lookup is not.
    // The parser lowercases keys while handlers conventionally write
    // req.headers["Authorization"], so expose both spellings.
    fn _canonHeaders(src): object {
        let out = {};
        if (src == nil) { return out; }
        let keys = Object.Keys(src);
        let i:int = 0;
        while (i < len(keys)) {
            let k:string = keys[i];
            let v = src[k];
            out[k] = v;
            let c:string = _canonName(k);
            if (c != k) { out[c] = v; }
            i += 1;
        }
        return out;
    }

    // Split a request path into its non-empty segments. Once per request, not
    // once per request per route.
    fn _pathSegs(path:string): array {
        let raw = String.Split(path, "/");
        let out:array = [];
        let i:int = 0;
        while (i < len(raw)) {
            if (String.Length(raw[i]) > 0) { Array.Append(out, raw[i]); }
            i += 1;
        }
        return out;
    }

    // Match pre-split request segments against a pre-split route, filling
    // req.params on success. The params object is allocated only once a capture
    // actually happens, so a route that fails on its first literal costs nothing.
    fn _matchRoute(route, segs:array, req): bool {
        let rs:array = route.segs;
        let n:int    = len(rs);

        if (route.catchAll) {
            if (len(segs) < n) { return false; }
        } else if (len(segs) != n) {
            return false;
        }

        let params = nil;
        let i:int  = 0;
        while (i < n) {
            let ps:string = rs[i];
            if (String.CharAt(ps, 0) == ':') {
                if (params == nil) { params = {}; }
                params[String.Substr(ps, 1, String.Length(ps) - 1)] = segs[i];
            } else if (ps != segs[i]) {
                return false;
            }
            i += 1;
        }

        if (route.catchAll) {
            if (params == nil) { params = {}; }
            let rest:string = "";
            let j:int = n;
            while (j < len(segs)) {
                if (String.Length(rest) > 0) { rest = rest + "/"; }
                rest = rest + segs[j];
                j += 1;
            }
            params["*"] = rest;
        }

        req.params = (params == nil) ? {} : params;
        return true;
    }

    // The combined global + route-scoped chain, built once per route and reused
    // until Use() adds another middleware. The old code rebuilt and re-copied
    // this array on every single request.
    fn _chainFor(route) {
        if (route.chainGen != _gen) {
            route.chain    = this._buildChain(route.middleware);
            route.chainGen = _gen;
        }
        return route.chain;
    }

    fn _dispatch(req) {
        if (req == nil || req.method == nil || req.path == nil) {
            return Response.Error(400, "Bad Request");
        }

        let segs = this._pathSegs(req.path);
        let tail = req.method + " /" + String.Join(segs, "/");
        let host = _hasHosts ? _reqHostOf(req) : "";

        // Fixed patterns resolve in a single map lookup. Keying on the rejoined
        // segments keeps the old lenient behaviour, where "/a/b/" and "//a//b"
        // both match "/a/b". A route bound to this host is preferred over one
        // that serves every host.
        let hit = nil;
        if (_hasHosts) { hit = Object.TryGet(_exact, host + "\n" + tail, nil); }
        if (hit == nil) { hit = Object.TryGet(_exact, "\n" + tail, nil); }
        if (hit != nil) {
            req.params = {};
            let pipeline = new _Pipeline(this._chainFor(hit), hit.handler);
            return pipeline.Run(req);
        }

        // Two passes for the same reason: host-scoped routes first, then the
        // ones that serve any host. Skipped entirely when no host is in play.
        if (_hasHosts) {
            let hi:int = 0;
            while (hi < len(_routes)) {
                let hr = _routes[hi];
                if (hr.host != nil && hr.method == req.method
                    && _hostMatches(hr.host, host) && this._matchRoute(hr, segs, req)) {
                    let pipeline = new _Pipeline(this._chainFor(hr), hr.handler);
                    return pipeline.Run(req);
                }
                hi += 1;
            }
        }

        let i:int = 0;
        while (i < len(_routes)) {
            let route = _routes[i];
            if (route.host == nil && route.method == req.method
                && this._matchRoute(route, segs, req)) {
                let pipeline = new _Pipeline(this._chainFor(route), route.handler);
                return pipeline.Run(req);
            }
            i += 1;
        }

        // No route matched. Still run the global middleware chain so that
        // cross-cutting concerns (CORS preflight, logging, ...) apply to
        // unmatched requests too - in particular OPTIONS preflight requests
        // never match a GET/POST route. The chain terminates in the custom 404
        // handler when set, otherwise a default 404.
        let terminal = (_notFound != nil)
            ? _notFound
            : fn(_r) { return Response.Error(404, "Not Found"); };
        let pipeline = new _Pipeline(_middleware, terminal);
        return pipeline.Run(req);
    }

    // ---- server loop ----

    // Serves on HttpServer. Every request arrives through OnRequest, so Router
    // owns dispatch, middleware and 404 handling.
    // opts are passed straight through to HttpServer, so everything it offers -
    // tls, streamBodies, maxConnections, the timeouts - is reachable from here:
    //   app.Listen(8443, { tls: { pkcs12File: "s.p12", password: "..." } });
    fn Listen(port:int, opts?) {
        Console.WriteLine("Router listening on port ", port);
        let o = opts ?? {};
        o["port"] = port;
        let srv = new HttpServer(o);
        this._server = srv;
        this._running = true;
        if (_onAccess != nil) { srv.OnAccess(_onAccess); }

        srv.OnError(fn(_req, _res, e) {
            Console.Error("Router: handler error: ", e);
        });
        srv.OnRequest(fn(req, res) {
            // Handlers and middleware receive a plain request object whose
            // `body` is a string.
            let plain = {
                method:  req.method,
                path:    req.path,
                rawPath: req.rawPath,
                query:   req.query,
                headers: this._canonHeaders(req.headers),
                params:  {},
                // Parsed only when the request carries them, so an API call
                // with neither pays nothing.
                cookies: this._cookiesOf(req),
                form:    this._formOf(req),
                // The client address, which middleware needs to identify a peer
                // - a rate limiter keying on a header alone is keying on
                // something the client controls.
                peer:    req.peer,
                secure:  req.secure,
                body:    req.Text()
            };
            let r = this._dispatch(plain);
            if (r == nil) {
                res.Status(500).Text("Internal Server Error");
                return;
            }
            // Headers first: _send only supplies a Content-Type when none is
            // set, so the handler's own choice survives.
            let hdrs = r.headers ?? {};
            let keys = Object.Keys(hdrs);
            iter (i from 0 to len(keys) - 1) {
                res.Header(keys[i], hdrs[keys[i]]);
            }
            // Cookies are applied before the body is written, and go out as
            // one Set-Cookie line each rather than overwriting one another.
            let cookies = Object.TryGet(r, "cookies", nil);
            if (cookies != nil) {
                iter (ci from 0 to len(cookies) - 1) {
                    let ck = cookies[ci];
                    if (Object.TryGet(ck, "clear", false)) {
                        res.ClearCookie(ck.name, ck.opts);
                    } else {
                        res.SetCookie(ck.name, ck.value, ck.opts);
                    }
                }
            }

            // A response may name a file instead of carrying a body. Handing
            // the path down lets the server answer with validators, honour a
            // conditional request or a byte range, and send the bytes without
            // routing them through this VM at all.
            let ref = Object.TryGet(r, "file", nil);
            if (ref != nil) {
                // A middleware may have set its own status; File() only
                // overrides it for a 206 range or a 304 revalidation.
                let st = r.status ?? 200;
                if (st != 200) { res.Status(st); }
                res.File(ref, nil);
                return;
            }
            // Otherwise a block (images, generated binaries) or a string.
            let body = r.body ?? "";
            if (Type.Is(body, Type.Block)) {
                res.Bytes(body, nil, r.status ?? 200);
            } else {
                res.Text(body, r.status ?? 200);
            }
        });

        srv.Listen();
    }

    // Stop accepting and wait for the requests in flight to finish.
    // Returns true if they all completed within timeoutMs (default 5000).
    fn Stop(timeoutMs?) {
        Console.WriteLine("Router stopping...");
        this._running = false;
        let drained = true;
        if (this._server != nil) {
            drained = this._server.Stop(timeoutMs ?? 5000);
            this._server = nil;
        }
        return drained;
    }
}

// =============================================================================
// Response
// =============================================================================

class Response
{
    fn static Json(data, status) {
        let s:int = (status == nil) ? 200 : status;
        return {
            status:  s,
            body:    Json.Stringify(data),
            headers: { "Content-Type": "application/json" }
        };
    }

    fn static Text(text, status) {
        let s:int = (status == nil) ? 200 : status;
        return {
            status:  s,
            body:    text,
            headers: { "Content-Type": "text/plain" }
        };
    }

    fn static Html(html, status) {
        let s:int = (status == nil) ? 200 : status;
        return {
            status:  s,
            body:    html,
            headers: { "Content-Type": "text/html" }
        };
    }

    fn static Error(status, message) {
        return {
            status:  status,
            body:    Json.Stringify({ error: message }),
            headers: { "Content-Type": "application/json" }
        };
    }

    fn static Redirect(url, status) {
        let s:int = (status == nil) ? 302 : status;
        return {
            status:  s,
            body:    "",
            headers: { "Location": url }
        };
    }

    fn static NoContent() {
        return {
            status:  204,
            body:    "",
            headers: {}
        };
    }

    // Attach a cookie to any response these helpers build. Chainable:
    //   return Response.WithCookie(Response.Json(user), "sid", token,
    //                              { maxAge: 3600 });
    // Defaults come from the server: HttpOnly, SameSite=Lax, and Secure
    // whenever the request arrived over TLS.
    fn static WithCookie(resp, name:string, value, options) {
        if (resp == nil) { return resp; }
        if (!Object.HasKey(resp, "cookies") || resp.cookies == nil) { resp["cookies"] = []; }
        Array.Append(resp.cookies, { name: name, value: value, opts: options ?? nil });
        return resp;
    }

    // Expire a cookie. Path and Domain must match how it was set.
    fn static ClearCookie(resp, name:string, options) {
        if (resp == nil) { return resp; }
        if (!Object.HasKey(resp, "cookies") || resp.cookies == nil) { resp["cookies"] = []; }
        Array.Append(resp.cookies, { name: name, value: "", clear: true, opts: options ?? nil });
        return resp;
    }

    // Serve a single file. Content-Type is inferred from the extension unless
    // `contentType` is given. The body is the raw bytes, so binary assets
    // (images, fonts, ...) are transmitted intact. Returns 404 if missing.
    fn static File(path:string, contentType) {
        return _StaticHandler._serveFile(path, contentType);
    }
}

// =============================================================================
// _StaticHandler - path-safe static file server used by Router.Static().
// =============================================================================

class _StaticHandler
{
    let _root:string  = ".";
    let _index:string = "index.html";
    let _fallback     = nil;
    let _cache        = nil;
    let _dotfiles:bool       = false;
    let _followSymlinks:bool = false;

    fn Constructor(root:string, options) {
        if (root != nil and len(root) > 0) _root = root;
        if (options != nil) {
            if (Object.HasKey(options, "index"))          _index          = options.index;
            if (Object.HasKey(options, "fallback"))       _fallback       = options.fallback;
            if (Object.HasKey(options, "cacheControl"))   _cache          = options.cacheControl;
            // Both default to the safe answer; a deployment that needs them
            // opts in explicitly.
            if (Object.HasKey(options, "dotfiles"))       _dotfiles       = options.dotfiles;
            if (Object.HasKey(options, "followSymlinks")) _followSymlinks = options.followSymlinks;
        }
    }

    fn Serve(req) {
        var rel:string = "";
        if (req.params != nil and Object.HasKey(req.params, "*")) {
            rel = req.params["*"];
        }

        let safe = _StaticHandler._safeRel(rel);
        if (safe == nil) {
            return Response.Error(403, "Forbidden");
        }

        // 404 rather than 403: a distinct status would confirm the file is there.
        if (!_dotfiles and _hasDotSeg(safe)) {
            return Response.Error(404, "Not Found");
        }

        var path:string = _root;
        if (len(safe) > 0) path = _root + "/" + safe;

        // Belt as well as braces: _safeRel already rejects ".." segments, but
        // confirm the resolved path really lands inside the root. Path.Resolve
        // collapses "..", and the separator boundary stops a root of "./www"
        // from also accepting "./www-secret".
        let rootAbs = Path.Resolve(_root);
        let pathAbs = Path.Resolve(path);
        if (rootAbs == nil or pathAbs == nil) { return Response.Error(403, "Forbidden"); }
        if (pathAbs != rootAbs
            and !String.StartsWith(pathAbs, rootAbs + "/")
            and !String.StartsWith(pathAbs, rootAbs + "\\")) {
            return Response.Error(403, "Forbidden");
        }
        if (!_followSymlinks and _crossesLink(rootAbs, safe)) {
            return Response.Error(404, "Not Found");
        }

        // A directory request (including the mount root) serves the index file.
        // Directory.Exists() uses stat()+S_ISDIR; File.Exists() (fopen) is true for
        // directories too, so the regular-file check excludes them explicitly.
        if (len(safe) == 0 or Directory.Exists(path)) {
            path = path + "/" + _index;
        }

        if (File.Exists(path) and !Directory.Exists(path)) {
            return this._fileResponse(path);
        }

        // SPA fallback: serve a single entry file for any unmatched path.
        if (_fallback != nil and File.Exists(_fallback)) {
            return this._fileResponse(_fallback);
        }

        return Response.Error(404, "Not Found");
    }

    // Return a reference to the file rather than its bytes. The server then
    // does the validators, conditional revalidation, byte ranges and the
    // zero-copy send - none of which is possible once the body has already been
    // read into a block here.
    fn _fileResponse(path:string) {
        let headers = { "Content-Type": _StaticHandler._mimeFor(path) };
        if (_cache != nil) headers["Cache-Control"] = _cache;
        return { status: 200, file: path, headers: headers };
    }

    // Read a file and build a response with an inferred (or given) Content-Type.
    // Backs Response.File(); kept here so the File builtin is referenced outside
    // the Response class (which defines a static method also named File).
    fn static _serveFile(path:string, contentType) {
        if (!File.Exists(path) or Directory.Exists(path)) {
            return Response.Error(404, "Not Found");
        }
        let ct = (contentType == nil) ? _StaticHandler._mimeFor(path) : contentType;
        return { status: 200, file: path, headers: { "Content-Type": ct } };
    }

    // Validate a request-relative path. Returns the cleaned path, or nil if it
    // is unsafe (contains a ".." traversal segment or a backslash). The router's
    // matcher has already collapsed empty segments, so a non-nil result is safe
    // to append under the root directory.
    fn static _safeRel(rel) {
        if (rel == nil or rel == "") return "";
        if (String.Contains(rel, "\\")) return nil;   // no Windows separators
        let parts = String.Split(rel, "/");
        var i:int = 0;
        while (i < len(parts)) {
            if (parts[i] == "..") return nil;          // path-traversal attempt
            i = i + 1;
        }
        return rel;
    }

    // Map a file extension to a MIME type (defaults to octet-stream).
    // The table lives at module scope: built as a literal inside this function
    // it was a fresh 30-key object allocated on every single file served.
    fn static _mimeFor(path:string): string {
        let parts = String.Split(path, ".");
        let n:int = len(parts);
        if (n < 2) return "application/octet-stream";
        let ext = String.ToLower(parts[n - 1]);
        if (String.Contains(ext, "/")) return "application/octet-stream";

        if (Object.HasKey(_MIME, ext)) return _MIME[ext];
        return "application/octet-stream";
    }
}

// =============================================================================
// LoggerMiddleware
//
// Usage:
//   let logMw = new LoggerMiddleware();
//   app.Use(fn(req, next) { return logMw.Handle(req, next); });
// =============================================================================



class LoggerMiddleware
{
    let  _log:instance = nil;

    fn Constructor() {
        _log = new Logger();
    }

    fn Handle(req, next) {
        _log.Info("-->", { method: req.method, path: req.path });
        let resp = next(req);
        _log.Info("<--", { method: req.method, path: req.path, status: resp.status });
        return resp;
    }
}

// =============================================================================
// CorsMiddleware
//
// Usage:
//   let corsMw = new CorsMiddleware("*");
//   app.Use(fn(req, next) { return corsMw.Handle(req, next); });
//
// Optional second argument tunes the policy:
//   new CorsMiddleware("https://app.example.com", {
//       methods: "GET, POST",
//       headers: "Content-Type, Authorization, X-Token",
//       maxAge: 3600,
//       credentials: true,                 // Access-Control-Allow-Credentials
//       exposeHeaders: "X-Total-Count"     // Access-Control-Expose-Headers
//   });
// =============================================================================

class CorsMiddleware
{
    let _any:bool           = true;   // "*" - no allowlist
    let _origins:array      = [];
    let _methods:string     = "GET, POST, PUT, DELETE, PATCH, OPTIONS";
    let _headers:string     = "Content-Type, Authorization";
    let _maxAge:string      = "86400";
    let _credentials:bool   = false;
    let _exposeHeaders      = nil;

    // origin: "*", a single origin, or an array of allowed origins. With an
    // allowlist the request's own Origin is echoed back when it is on the list
    // and omitted when it is not - never reflected blindly, which would let any
    // site read authenticated responses.
    fn Constructor(origin, options) {
        _origins = [];
        if (origin == nil || origin == "*") {
            _any = true;
        } else if (Type.Is(origin, Type.Array)) {
            _any = false;
            foreach (o in origin) { Array.Append(_origins, o); }
        } else {
            _any = false;
            Array.Append(_origins, origin);
        }
        if (options != nil) {
            if (Object.HasKey(options, "methods"))       _methods       = options.methods;
            if (Object.HasKey(options, "headers"))       _headers       = options.headers;
            if (Object.HasKey(options, "maxAge"))        _maxAge        = str(options.maxAge);
            if (Object.HasKey(options, "credentials"))   _credentials   = options.credentials;
            if (Object.HasKey(options, "exposeHeaders")) _exposeHeaders = options.exposeHeaders;
        }

        // Fetch forbids "*" together with credentials and every browser rejects
        // the pair, so a server that sends both is silently doing no CORS at
        // all. Fail here rather than at 3am.
        if (_any and _credentials) {
            throw(1, "CorsMiddleware: credentials require an explicit origin list, not \"*\"");
        }
    }

    // The value to send for this request, or nil when the origin is not allowed.
    fn _allowedOrigin(req) {
        if (_any) { return "*"; }
        let o = Object.TryGet(req.headers ?? {}, "Origin", nil);
        if (o == nil) { return nil; }
        foreach (a in _origins) { if (a == o) { return o; } }
        return nil;
    }

    fn Handle(req, next) {
        let allow = this._allowedOrigin(req);

        if (req.method == "OPTIONS") {
            let h = {
                "Access-Control-Allow-Methods": _methods,
                "Access-Control-Allow-Headers": _headers,
                "Access-Control-Max-Age":       _maxAge
            };
            if (allow != nil) {
                h["Access-Control-Allow-Origin"] = allow;
                if (_credentials) h["Access-Control-Allow-Credentials"] = "true";
            }
            // The answer depends on the Origin, so a shared cache must not
            // serve one origin's approval to another.
            if (!_any) { h["Vary"] = "Origin"; }
            return { status: 204, body: "", headers: h };
        }

        let resp = next(req);
        if (resp == nil) { return resp; }
        if (resp.headers == nil) resp["headers"] = {};
        if (!_any) { resp.headers["Vary"] = "Origin"; }
        if (allow != nil) {
            resp.headers["Access-Control-Allow-Origin"] = allow;
            if (_credentials) resp.headers["Access-Control-Allow-Credentials"] = "true";
            if (_exposeHeaders != nil) resp.headers["Access-Control-Expose-Headers"] = _exposeHeaders;
        }
        return resp;
    }
}

// =============================================================================
// SecurityHeadersMiddleware - the response headers a browser needs in order to
// defend a page, applied in one place.
//
// Usage:
//   let sec = new SecurityHeadersMiddleware();
//   app.Use(fn(req, next) { return sec.Handle(req, next); });
//
// Options (defaults in brackets):
//   contentTypeOptions  [true]           X-Content-Type-Options: nosniff
//   frameOptions        ["DENY"]         X-Frame-Options; nil to omit
//   referrerPolicy      ["no-referrer"]  Referrer-Policy; nil to omit
//   crossOriginOpener   ["same-origin"]  Cross-Origin-Opener-Policy; nil to omit
//   csp                 [nil]            Content-Security-Policy
//   permissionsPolicy   [nil]            Permissions-Policy
//   hsts                [nil]            Strict-Transport-Security; true for a
//                                        year, or { maxAge, includeSubDomains,
//                                        preload }
//
// Two defaults are deliberately off. A Content-Security-Policy cannot be
// guessed for someone else's application - a wrong one silently breaks the page
// - and HSTS is remembered by the browser, so switching it on before TLS is
// actually working everywhere locks your own users out for maxAge seconds. Both
// are one option away.
//
// A header the handler already set is never overwritten.
// =============================================================================

class SecurityHeadersMiddleware
{
    let _nosniff:bool = true;
    let _frame        = "DENY";
    let _referrer     = "no-referrer";
    let _coop         = "same-origin";
    let _csp          = nil;
    let _permissions  = nil;
    let _hsts         = nil;

    fn Constructor(options?) {
        let o = options ?? nil;
        if (o != nil) {
            if (Object.HasKey(o, "contentTypeOptions")) _nosniff     = o.contentTypeOptions;
            if (Object.HasKey(o, "frameOptions"))       _frame       = o.frameOptions;
            if (Object.HasKey(o, "referrerPolicy"))     _referrer    = o.referrerPolicy;
            if (Object.HasKey(o, "crossOriginOpener"))  _coop        = o.crossOriginOpener;
            if (Object.HasKey(o, "csp"))                _csp         = o.csp;
            if (Object.HasKey(o, "permissionsPolicy"))  _permissions = o.permissionsPolicy;
            if (Object.HasKey(o, "hsts"))               _hsts        = SecurityHeadersMiddleware._hstsValue(o.hsts);
        }
    }

    fn static _hstsValue(h) {
        if (h == nil or h == false) { return nil; }
        let maxAge = 31536000;
        let sub    = false;
        let pre    = false;
        if (h != true) {
            if (Object.HasKey(h, "maxAge"))            maxAge = h.maxAge;
            if (Object.HasKey(h, "includeSubDomains")) sub    = h.includeSubDomains;
            if (Object.HasKey(h, "preload"))           pre    = h.preload;
        }
        let v = "max-age=" + str(maxAge);
        if (sub) { v = v + "; includeSubDomains"; }
        if (pre) { v = v + "; preload"; }
        return v;
    }

    fn _set(h, name:string, value) {
        if (value != nil and !Object.HasKey(h, name)) { h[name] = value; }
    }

    fn Handle(req, next) {
        let resp = next(req);
        if (resp == nil) { return resp; }
        if (resp.headers == nil) resp["headers"] = {};
        let h = resp.headers;

        if (_nosniff) { this._set(h, "X-Content-Type-Options", "nosniff"); }
        this._set(h, "X-Frame-Options",             _frame);
        this._set(h, "Referrer-Policy",             _referrer);
        this._set(h, "Cross-Origin-Opener-Policy",  _coop);
        this._set(h, "Content-Security-Policy",     _csp);
        this._set(h, "Permissions-Policy",          _permissions);

        // HSTS means something only over TLS, and the browser remembers it -
        // sending it from a plaintext listener would pin clients to a scheme
        // this deployment may not actually serve.
        if (_hsts != nil and req.secure == true) {
            this._set(h, "Strict-Transport-Security", _hsts);
        }
        return resp;
    }
}

// =============================================================================
// JwtMiddleware
//
// Usage:
//   let jwtMw = new JwtMiddleware(secret, ["/auth/login"]);
//   app.Use(fn(req, next) { return jwtMw.Handle(req, next); });
//
// On success: populates req.jwt with decoded payload, calls next.
// On failure: returns 401 without calling next.
// =============================================================================

class JwtMiddleware
{
    let _secret:string   = "";
    let _skipPaths:array = [];
    let _claimOpts        = nil;

    // options: { leeway:int, requireExp:bool }
    fn Constructor(secret:string, skipPaths, options?) {
        _secret    = secret;
        _skipPaths = (skipPaths == nil) ? [] : skipPaths;

        let o = options ?? nil;
        // exp and nbf are always enforced when the token carries them - that is
        // the entire point of giving a bearer token a lifetime. requireExp goes
        // further and refuses a token with no expiry at all.
        _claimOpts = {
            leeway:     (o != nil && Object.HasKey(o, "leeway"))     ? o.leeway     : 0,
            requireExp: (o != nil && Object.HasKey(o, "requireExp")) ? o.requireExp : false
        };
    }

    fn Handle(req, next) {
        iter (si from 0 to len(_skipPaths) - 1) {
            if (req.path == _skipPaths[si]) { return next(req); }
        }

        let auth = req.headers["Authorization"];
        if (auth == nil) {
            return Response.Error(401, "Missing Authorization header");
        }

        let prefix = "Bearer ";
        if (len(auth) <= len(prefix)) {
            return Response.Error(401, "Invalid Authorization header");
        }

        let token = String.Substr(auth, len(prefix), len(auth) - len(prefix));

        // Signature *and* claims. VerifyHS256 on its own checks only the
        // signature, so a token that expired months ago still verifies - which
        // makes every issued token a credential that never expires, including
        // any that have leaked.
        if (!Jwt.VerifyHS256WithClaims(token, _secret, _claimOpts)) {
            return Response.Error(401, "Invalid or expired token");
        }

        let decoded = _jwt.Decode(token);
        if (decoded != nil) {
            req.jwt = decoded.payload;
        }
        return next(req);
    }
}

// =============================================================================
// RateLimitMiddleware - in-memory rate limiter, sliding window.
//
// Usage:
//   let rateMw = new RateLimitMiddleware(100, 60);   // 100 requests / 60 s
//   app.Use(fn(req, next) { return rateMw.Handle(req, next); });
//
//   // Behind a reverse proxy, and keyed on the API key when there is one:
//   let rateMw = new RateLimitMiddleware(100, 60, {
//       trustProxy: true,
//       skip:       fn(req) { return req.path == "/health"; },
//       keyFn:      fn(req) { return req.headers["X-Api-Key"] ?? req.peer; }
//   });
//
// Options (all optional):
//   keyFn       fn(req) -> string   what to count per (default: client address)
//   skip        fn(req) -> bool     true bypasses the limiter entirely
//   trustProxy  bool                honour X-Forwarded-For (default false)
//   maxKeys     int                 cap on tracked clients (default 10000)
//   headers     bool                emit RateLimit-* headers (default true)
//   clock       fn() -> int         millisecond source; for tests
//
// Identity: by default the bucket is the client address from req.peer, with the
// port stripped - keep the port and every new connection is a fresh bucket, so
// the limit never binds. X-Forwarded-For is consulted only when trustProxy is
// set, because a client can put anything in it; without a proxy in front,
// trusting it lets any caller mint unlimited identities.
//
// Window: a sliding window rather than a fixed one. A fixed window lets a
// caller spend its whole allowance at the end of one window and again at the
// start of the next - twice the limit across the boundary. Here the previous
// window's count is carried over, weighted by how much of it is still in view.
//
// Memory: bounded. Idle buckets are swept once maxKeys is reached, and if the
// live set still exceeds the cap it is dropped wholesale. An unbounded map here
// is a denial-of-service vector, since the keys come from the network.
// =============================================================================

// A path segment beginning with "." marks a file that is conventionally private
// but perfectly readable: .env, .git, .htpasswd. ".well-known" is the standard
// exception - ACME challenges and security.txt live there.
fn _hasDotSeg(rel:string): bool {
    if (rel == nil or rel == "") { return false; }
    foreach (sg in String.Split(rel, "/")) {
        if (String.StartsWith(sg, ".") and sg != ".well-known") { return true; }
    }
    return false;
}

// A symlink below the mount root can point anywhere, and the containment check
// cannot see it - Path.Resolve is purely lexical. The final component alone is
// not enough either: a file reached *through* a symlinked directory stats with
// IsSymlink false. So every segment below the root is checked; the root itself
// is not, since "/var/www -> /data/www" is an ordinary deployment.
fn _crossesLink(root:string, rel:string): bool {
    if (rel == nil or rel == "") { return false; }
    let cur:string = root;
    foreach (sg in String.Split(rel, "/")) {
        if (String.Length(sg) > 0) {
            cur = cur + "/" + sg;
            let st = File.Stat(cur);
            if (st != nil and st.IsSymlink) { return true; }
        }
    }
    return false;
}

// The site a request is asking for: the Host header, lowercased and without its
// port, since "example.com" and "example.com:8080" are the same site.
fn _reqHostOf(req): string {
    let hdrs = req.headers ?? {};
    let h = Object.TryGet(hdrs, "Host", nil) ?? Object.TryGet(hdrs, "host", "");
    let t = String.ToLower(String.Trim(str(h ?? "")));
    if (String.StartsWith(t, "[")) {                 // IPv6 literal keeps its brackets
        let close = String.IndexOf(t, "]");
        return (close > 0) ? String.Left(t, close + 1) : t;
    }
    let colon = String.LastIndexOf(t, ":");
    return (colon > 0) ? String.Left(t, colon) : t;
}

// Does a route's configured host cover this request? nil means the route is not
// host-scoped and serves every host. A leading "*." matches any subdomain, at
// any depth, but never the bare domain - "*.example.com" is not "example.com".
fn _hostMatches(pattern, host:string): bool {
    if (pattern == nil) { return true; }
    if (pattern == host) { return true; }
    if (String.StartsWith(pattern, "*.")) {
        let suffix = String.Substr(pattern, 1);      // ".example.com"
        return String.EndsWith(host, suffix) && String.Length(host) > String.Length(suffix);
    }
    return false;
}

// "1.2.3.4:5678" -> "1.2.3.4"; "[::1]:5678" -> "[::1]".
fn _hostOf(peer): string {
    if (peer == nil || peer == "") { return "unknown"; }
    if (String.StartsWith(peer, "[")) {
        let close = String.IndexOf(peer, "]");
        if (close > 0) { return String.Substr(peer, 0, close + 1); }
        return peer;
    }
    let colon = String.LastIndexOf(peer, ":");
    if (colon > 0) { return String.Substr(peer, 0, colon); }
    return peer;
}

class RateLimitMiddleware
{
    let _limit:int       = 100;
    let _windowMs:int    = 60000;
    let _keyFn            = nil;
    let _skip             = nil;
    let _trustProxy:bool = false;
    let _maxKeys:int     = 10000;
    let _emit:bool       = true;
    let _clock            = nil;

    // key -> { start, cur, prev }: the current window's count and the previous
    // window's, which is what makes the window slide.
    let _buckets          = nil;
    let _nKeys:int       = 0;

    fn Constructor(limit:int, windowSeconds:int, options?) {
        _limit    = limit;
        _windowMs = windowSeconds * 1000;
        _buckets  = {};
        _nKeys    = 0;

        let o = options ?? nil;
        if (o != nil) {
            if (Object.HasKey(o, "keyFn"))      _keyFn      = o.keyFn;
            if (Object.HasKey(o, "skip"))       _skip       = o.skip;
            if (Object.HasKey(o, "trustProxy")) _trustProxy = o.trustProxy;
            if (Object.HasKey(o, "maxKeys"))    _maxKeys    = o.maxKeys;
            if (Object.HasKey(o, "headers"))    _emit       = o.headers;
            if (Object.HasKey(o, "clock"))      _clock      = o.clock;
        }
    }

    // Monotonic by default: a wall clock can step backwards under NTP, and only
    // deltas matter here.
    fn _now(): int {
        if (_clock != nil) { return _clock(); }
        return Time.Millis();
    }

    fn _key(req): string {
        if (_keyFn != nil) { return str(_keyFn(req)); }

        if (_trustProxy) {
            let hdrs = req.headers ?? {};
            let xff  = Object.TryGet(hdrs, "X-Forwarded-For", nil);
            if (xff != nil) {
                // The left-most entry is the original client; the rest are proxies.
                let comma = String.IndexOf(xff, ",");
                let first = String.Trim((comma >= 0) ? String.Substr(xff, 0, comma) : xff);
                if (String.Length(first) > 0) { return first; }
            }
        }
        return _hostOf(req.peer);
    }

    // Drop buckets whose window has fully passed. Called only when the cap is
    // reached, so the common path never walks the map.
    fn _sweep(now:int) {
        let keys = Object.Keys(_buckets);
        let kept = {};
        let n:int = 0;
        let i:int = 0;
        while (i < len(keys)) {
            let k = keys[i];
            let b = _buckets[k];
            if ((now - b.start) < (2 * _windowMs)) { kept[k] = b; n = n + 1; }
            i += 1;
        }
        // Still over the cap after sweeping: the live set itself is the problem,
        // so start clean rather than grow without bound.
        if (n > _maxKeys) { kept = {}; n = 0; }
        _buckets = kept;
        _nKeys   = n;
    }

    // Roll `b` forward to the window containing `now`.
    fn _advance(b, now:int) {
        let elapsed:int = now - b.start;
        if (elapsed >= (2 * _windowMs)) {
            b.prev  = 0;
            b.cur   = 0;
            b.start = now;
        } else if (elapsed >= _windowMs) {
            b.prev  = b.cur;
            b.cur   = 0;
            b.start = b.start + _windowMs;
        }
        return b;
    }

    fn Handle(req, next) {
        if (_skip != nil && _skip(req)) { return next(req); }

        let now:int = this._now();
        let key     = this._key(req);

        let b = Object.TryGet(_buckets, key, nil);
        if (b == nil) {
            if (_nKeys >= _maxKeys) { this._sweep(now); }
            b = { start: now, cur: 0, prev: 0 };
            _buckets[key] = b;
            _nKeys = _nKeys + 1;
        } else {
            this._advance(b, now);
        }

        // Sliding estimate: the part of the previous window still inside the
        // trailing window counts in proportion to how much of it remains.
        let into:int    = now - b.start;
        let weight      = float(_windowMs - into) / float(_windowMs);
        if (weight < 0.0) { weight = 0.0; }
        let estimate    = (float(b.prev) * weight) + float(b.cur);

        let resetSecs:int = ((_windowMs - into) + 999) / 1000;
        if (resetSecs < 1) { resetSecs = 1; }

        if (estimate >= float(_limit)) {
            let h = {
                "Content-Type": "application/json",
                "Retry-After":  str(resetSecs)
            };
            if (_emit) {
                h["RateLimit-Limit"]     = str(_limit);
                h["RateLimit-Remaining"] = "0";
                h["RateLimit-Reset"]     = str(resetSecs);
            }
            return {
                status:  429,
                body:    Json.Stringify({ error: "Too many requests" }),
                headers: h
            };
        }

        b.cur = b.cur + 1;

        let resp = next(req);
        if (_emit && resp != nil) {
            let remaining = _limit - int(estimate) - 1;
            if (remaining < 0) { remaining = 0; }
            if (resp.headers == nil) { resp["headers"] = {}; }
            resp.headers["RateLimit-Limit"]     = str(_limit);
            resp.headers["RateLimit-Remaining"] = str(remaining);
            resp.headers["RateLimit-Reset"]     = str(resetSecs);
        }
        return resp;
    }

    // Number of clients currently tracked - useful as a gauge, and to confirm
    // the bound is holding.
    fn TrackedKeys(): int { return _nKeys; }

    // Forget every bucket.
    fn Reset() { _buckets = {}; _nKeys = 0; return this; }
}

// =============================================================================
// JwtSign - issue a signed HS256 JWT
// =============================================================================

fn JwtSign(payload, secret, expirySeconds) {
    let options = nil;
    if (expirySeconds != nil) {
        let now:int = Time.Now();
        options = { iat: now, exp: now + expirySeconds };
    }
    return _jwt.EncodeHS256(payload, secret, options);
}

export { Router, Response, JwtMiddleware, JwtSign, LoggerMiddleware, CorsMiddleware,
         RateLimitMiddleware, SecurityHeadersMiddleware };
