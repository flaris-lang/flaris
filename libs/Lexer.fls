// Lexer.fls - General-purpose configurable lexer for Flaris.
// Version: 1.0
//
// Splits any source string into a token stream. Configure via a fluent
// builder API; use Lexer.Quick() for one-shot tokenisation.
//
// Token structure:  { type:string, val, line:int, col:int }
//   val is a string for word/op/string tokens; int or float for numbers.
//
// Usage:
//   import { Lexer } from library("Lexer", "1.0");
//
//   // Build once, tokenize many times
//   let lex = new Lexer()
//   lex.Word("a-zA-Z_", "a-zA-Z0-9_")
//      .Number()
//      .Quote("\"", "string")
//      .LineComment("//")
//      .BlockComment("/*", "*/")
//      .Operators("+-*/=<>!(){}[];,.")
//      .Keywords(["if","else","while","for","return","fn","let","var"], "keyword")
//      .Skip(" \t\n\r")
//
//   let tokens = lex.Tokenize(source)
//   // → [{type:"keyword", val:"if",  line:1, col:1},
//   //    {type:"op",      val:"(",   line:1, col:4}, ...]
//
//   // One-shot convenience - builds and discards the Lexer
//   let tokens = Lexer.Quick(source, {
//       word:        "a-zA-Z_",
//       number:      true,
//       string:      "\"",
//       lineComment: "//",
//       ops:         "+-*/=<>!(),;",
//       keywords:    ["if","else","while"],
//       skip:        " \t\n\r",
//   })
//
//   // Math expression example
//   let lex = new Lexer()
//   lex.Word("a-zA-Z", "a-zA-Z0-9")
//      .Number()
//      .Operators("+-*/^=()")
//      .Skip(" \t")
//   let toks = lex.Tokenize("sin(x) + 3.14 * y^2")
//
// Configuration - all methods return this for chaining:
//   Word(start, cont)             - identifier chars; "a-z" ranges are expanded
//   Number()                      - integer and float literals (val is int or float)
//   Quote(ch, type)               - quoted string; backslash escapes honoured
//   LineComment(prefix)           - skip from prefix to end of line
//   BlockComment(open, close)     - skip enclosed block
//   Operator(op)                  - add one operator string (any length)
//   Operators(chars)              - add each char in chars as a single-char operator
//   Keyword(word, type)           - override word token type for one word
//   Keywords(words:array, type)   - override for a list of words
//   Skip(chars)                   - silently consume these characters
//   Whitespace(chars, type)       - emit whitespace as tokens instead of skipping
//
// Static:
//   Lexer.Quick(src, opts)        - one-shot; opts keys: word, number, string,
//                                   lineComment, blockComment, ops, keywords, skip
//
// Token types (default names):
//   "word"    - identifier
//   "number"  - integer or float (val is numeric)
//   "string"  - quoted string content (quotes stripped, escapes resolved)
//   "op"      - operator
//   "keyword" - word matched by Keywords()
//   "ws"      - whitespace (only when Whitespace() used instead of Skip())
//   "unknown" - unrecognised character

class Lexer {

    // =========================================================================
    // Fields
    // =========================================================================

    let _wordStart:  string = "";
    let _wordCont:   string = "";
    let _wordStop:   string = "";     // complement - used with IndexOfAnyFrom
    let _wordOn:     bool   = false;

    let _numOn:      bool   = false;
    let _numStop:    string = "";

    let _quotes:     array  = [];     // [{ch, type}]
    let _lnCmts:     array  = [];     // [prefix, ...]
    let _blkCmts:    array  = [];     // [{open, close}, ...]
    let _keywords:   object = {};     // word → type string
    let _ops:        array  = [];     // sorted longest-first
    let _skipChars:  string = "";
    let _wsType:     string = "";     // non-empty → emit whitespace tokens

    let _ready:      bool   = false;

    // Scanner tables, rebuilt after any configuration change (see _tables).
    let _tablesOk:   bool   = false;
    let _cls                = nil;    // [int] per byte: 1 skip, 2 word start, 4 may open a comment,
                                      //   8 may start an operator, (quote index + 1) << 4
    let _lits:       string = "";     // comment delimiters and operators, back to back
    let _litOff             = nil;    // [int] [start, end) of each literal in _lits; end < start never matches
    let _cfg                = nil;    // [int] line comments, block comments, operators, number on, word on, emit ws

    // =========================================================================
    // Configuration API
    // =========================================================================

    fn Constructor() {
        this._quotes   = [];
        this._lnCmts   = [];
        this._blkCmts  = [];
        this._ops      = [];
        this._keywords = {};
    }

    // Word / identifier tokens.  start and cont accept ranges: "a-zA-Z_".
    fn Word(start: string, cont: string) : instance {
        this._wordStart = Lexer._expand(start);
        this._wordCont  = Lexer._expand(cont);
        this._wordOn    = true;
        this._ready     = false;
        this._tablesOk  = false;
        return this;
    }

    // Integer and float literals.  val will be int or float.
    fn Number() : instance {
        this._numOn    = true;
        this._ready    = false;
        this._tablesOk = false;
        return this;
    }

    // Quoted string.  ch is the delimiter (e.g. "\"").  Backslash escapes
    // \n \t \r \\ and \" / \' are resolved.  val is the content without quotes.
    fn Quote(ch: string, type: string) : instance {
        this._quotes   = Array.Append(this._quotes, { ch: ch, type: type });
        this._tablesOk = false;
        return this;
    }

    // Skip from prefix to end of line (inclusive of the newline).
    fn LineComment(prefix: string) : instance {
        this._lnCmts   = Array.Append(this._lnCmts, prefix);
        this._tablesOk = false;
        return this;
    }

    // Skip from open to close (both inclusive).
    fn BlockComment(open: string, close: string) : instance {
        this._blkCmts  = Array.Append(this._blkCmts, { open: open, close: close });
        this._tablesOk = false;
        return this;
    }

    // Add one operator string (may be multi-character, e.g. "==", "!=").
    fn Operator(op: string) : instance {
        this._ops      = Array.Append(this._ops, op);
        this._ready    = false;
        this._tablesOk = false;
        return this;
    }

    // Add every character in chars as a single-character operator.
    fn Operators(chars: string) : instance {
        var i: int = 0;
        let n: int = String.Length(chars);
        while (i < n) {
            this._ops = Array.Append(this._ops, String.Substr(chars, i, 1));
            i += 1;
        }
        this._ready    = false;
        this._tablesOk = false;
        return this;
    }

    // Override the type of a specific word token.
    fn Keyword(word: string, type: string) : instance {
        this._keywords[word] = type;
        return this;
    }

    // Override the type for every word in the array.
    fn Keywords(words: array, type: string) : instance {
        iter (i from 0 to len(words)) {
            this._keywords[words[i]] = type;
        }
        return this;
    }

    // Silently consume these characters (e.g. " \t\n\r").
    fn Skip(chars: string) : instance {
        this._skipChars = chars;
        this._wsType    = "";
        this._tablesOk  = false;
        return this;
    }

    // Like Skip but emit whitespace runs as a token of the given type.
    fn Whitespace(chars: string, type: string) : instance {
        this._skipChars = chars;
        this._wsType    = type;
        this._tablesOk  = false;
        return this;
    }

    // =========================================================================
    // Internal helpers
    // =========================================================================

    // Expand range notation: "a-zA-Z_" → full character set string.
    // Only handles printable ASCII ranges (codes 32–126).
    fn static _expand(spec: string) : string {
        if (!String.Contains(spec, "-")) return spec;
        let ascii: string = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
        var result: string = "";
        var i: int = 0;
        let n: int = String.Length(spec);
        while (i < n) {
            if (i + 2 < n and String.Substr(spec, i + 1, 1) == "-") {
                let c1: int = String.IndexOf(ascii, String.Substr(spec, i,     1));
                let c2: int = String.IndexOf(ascii, String.Substr(spec, i + 2, 1));
                var j: int = c1;
                while (j <= c2) {
                    result = result + String.Substr(ascii, j, 1);
                    j += 1;
                }
                i += 3;
            } else {
                result = result + String.Substr(spec, i, 1);
                i += 1;
            }
        }
        return result;
    }

    // Build a stop-set string: all printable ASCII (32–126) not in contChars.
    // Used with IndexOfAnyFrom to find word/number token boundaries in one C call.
    fn static _buildStop(contChars: string) : string {
        let ascii: string = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
        var stop: string = "";
        var i: int = 0;
        while (i < 95) {
            let ch: string = String.Substr(ascii, i, 1);
            if (!String.Contains(contChars, ch)) {
                stop = stop + ch;
            }
            i += 1;
        }
        return stop;
    }

    // Sort operator array longest-first (insertion sort - list is usually tiny).
    fn static _sortOpsDesc(ops: array) : array {
        let n: int = len(ops);
        iter (i from 1 to n) {
            let key: string = ops[i];
            var j: int = i - 1;
            while (j >= 0 and String.Length(ops[j]) < String.Length(key)) {
                ops[j + 1] = ops[j];
                j -= 1;
            }
            ops[j + 1] = key;
        }
        return ops;
    }

    // Prepare derived state; called once before first Tokenize.
    fn _finalize() {
        if (this._wordOn) {
            this._wordStop = Lexer._buildStop(this._wordCont);
            // _buildStop only covers printable ASCII (32-126).
            // Explicitly add skip chars and quote delimiters so the scanner
            // also stops at \n, \t, \r and quote boundaries.
            var si: int = 0;
            while (si < String.Length(this._skipChars)) {
                let sc: string = String.Substr(this._skipChars, si, 1);
                if (!String.Contains(this._wordStop, sc)) {
                    this._wordStop = this._wordStop + sc;
                }
                si += 1;
            }
            iter (qi from 0 to len(this._quotes)) {
                let qc: string = this._quotes[qi].ch;
                if (!String.Contains(this._wordStop, qc)) {
                    this._wordStop = this._wordStop + qc;
                }
            }
        }
        if (this._numOn) {
            this._numStop = Lexer._buildStop("0123456789.");
            // Same: add skip chars so numbers stop at \n, \t, etc.
            iter (si from 0 to String.Length(this._skipChars)) {
                let sc: string = String.Substr(this._skipChars, si, 1);
                if (!String.Contains(this._numStop, sc)) {
                    this._numStop = this._numStop + sc;
                }
            }
        }
        this._ops      = Lexer._sortOpsDesc(this._ops);
        this._ready    = true;
        this._tablesOk = false;
    }

    // =========================================================================
    // Tokenize
    // =========================================================================

    // Tokenize src and return an array of token objects.
    fn Tokenize(src: string) : array {
        if (!this._ready) this._finalize();
        if (!this._tablesOk) this._tables();

        let recs   = Lexer._scan(src, this._cls, this._lits, this._litOff, this._cfg, this._numStop, this._wordStop);
        let m      = len(recs);
        let tokens = Array.Create(m / 5);
        var i      = 0;
        var t      = 0;
        while (i < m) {
            let w    = recs[i];
            let kind = w & 15;
            let at   = recs[i + 1];
            let n    = recs[i + 2];
            let line = recs[i + 3];
            let col  = recs[i + 4];
            if (kind == 4) {
                let word  = String.Substr(src, at, n);
                let ktype = this._keywords[word];
                let wtype: string = (ktype != nil) ? ktype : "word";
                tokens[t] = { type: wtype, val: word, line: line, col: col };
            } else if (kind == 5) {
                tokens[t] = { type: "op", val: this._ops[w >> 8], line: line, col: col };
            } else if (kind == 3) {
                let raw = String.Substr(src, at, n);
                var numval = nil;
                if ((w & 16) != 0) {
                    numval = Convert.ParseFloat(raw);
                } else {
                    numval = Convert.ParseInt(raw);
                }
                tokens[t] = { type: "number", val: numval, line: line, col: col };
            } else if (kind == 2) {
                var val: string = "";
                if ((w & 16) != 0) {
                    val = Lexer._unescape(src, at, at + n);
                } else {
                    val = String.Substr(src, at, n);
                }
                tokens[t] = { type: this._quotes[w >> 8].type, val: val, line: line, col: col };
            } else if (kind == 1) {
                tokens[t] = { type: this._wsType, val: String.Substr(src, at, n), line: line, col: col };
            } else {
                tokens[t] = { type: "unknown", val: String.Substr(src, at, 1), line: line, col: col };
            }
            i += 5;
            t += 1;
        }
        return tokens;
    }

    // Rebuilds the scanner tables from the current configuration.
    fn _tables() {
        let nq = len(this._quotes);
        let quoteBytes = Array.Create(nq, Type.Int);
        iter (qi from 0 to nq) {
            let qc = this._quotes[qi].ch;
            if (type(qc) == Type.String && String.Length(qc) == 1) {
                quoteBytes[qi] = Char.Code(String.CharAt(qc, 0));
            } else {
                quoteBytes[qi] = -1;
            }
        }
        var parts = [];
        let offs  = Array.Create(0, Type.Int);
        var at    = 0;
        foreach (pfx in this._lnCmts) { at = Lexer._addLit(parts, offs, at, pfx); }
        foreach (bc in this._blkCmts) {
            at = Lexer._addLit(parts, offs, at, bc.open);
            at = Lexer._addLit(parts, offs, at, bc.close);
        }
        foreach (op in this._ops) { at = Lexer._addLit(parts, offs, at, op); }
        this._lits   = String.Join(parts, "");
        this._litOff = offs;

        let cfg = Array.Create(6, Type.Int);
        cfg[0] = len(this._lnCmts);
        cfg[1] = len(this._blkCmts);
        cfg[2] = len(this._ops);
        cfg[3] = this._numOn ? 1 : 0;
        cfg[4] = this._wordOn ? 1 : 0;
        cfg[5] = (this._wsType != "") ? 1 : 0;
        this._cfg      = cfg;
        this._cls      = Lexer._classes(this._skipChars, this._wordStart, quoteBytes, this._lits, offs, cfg);
        this._tablesOk = true;
    }

    // Records lit in parts/offs; a value that is not a string gets a range
    // that never matches, as comparing a source slice with it never does.
    fn static _addLit(parts: array, offs: [int], at: int, lit) : int {
        if (type(lit) != Type.String) {
            Array.Append(offs, at);
            Array.Append(offs, at - 1);
            return at;
        }
        let n = String.Length(lit);
        Array.Append(parts, lit);
        Array.Append(offs, at);
        Array.Append(offs, at + n);
        return at + n;
    }

    fn static _classes(skip: string, wordStart: string, quoteBytes: [int], lits: string, litOff: [int], cfg: [int]) : [int] {
        let cls = Array.Create(256, Type.Int);
        iter (i from 0 to len(skip)) {
            let b = Char.Code(skip[i]);
            cls[b] = cls[b] | 1;
        }
        iter (i from 0 to len(wordStart)) {
            let b = Char.Code(wordStart[i]);
            cls[b] = cls[b] | 2;
        }
        // Comment openers are the line comments and every other block-comment
        // literal; the operators follow them.
        let nLc   = cfg[0];
        let opAt  = nLc + 2 * cfg[1];
        let nLits = opAt + cfg[2];
        iter (li from 0 to nLits) {
            var bit = 8;
            if (li < opAt) {
                bit = 4;
                if (li >= nLc && (li - nLc) % 2 == 1) continue;
            }
            let a = litOff[2 * li];
            let b = litOff[2 * li + 1];
            if (b > a) {
                let first = Char.Code(lits[a]);
                cls[first] = cls[first] | bit;
            } else if (b == a) {
                iter (x from 0 to 256) { cls[x] = cls[x] | bit; }
            }
        }
        // Walk backwards so the quote registered first owns its byte.
        var qi = len(quoteBytes) - 1;
        while (qi >= 0) {
            let b = quoteBytes[qi];
            if (b >= 0) { cls[b] = (cls[b] & 15) | ((qi + 1) << 4); }
            qi -= 1;
        }
        return cls;
    }

    // true when literal lits[a, b) occurs in s at pos.
    fn static _at(s: string, pos: int, n: int, lits: string, a: int, b: int) : bool {
        let m = b - a;
        if (m < 0 || pos + m > n) return false;
        if (m > 0 && s[pos] != lits[a]) return false;
        iter (k from 1 to m) {
            if (s[pos + k] != lits[a + k]) return false;
        }
        return true;
    }

    fn static _rec(out: [int], w: int, at: int, n: int, line: int, col: int) : int {
        Array.Append(out, w);
        Array.Append(out, at);
        Array.Append(out, n);
        Array.Append(out, line);
        Array.Append(out, col);
        return 0;
    }

    // Scans s into token records of five ints, [kind | flag | index << 8,
    // start, length, line, col]:
    //   1 whitespace run, when whitespace is emitted
    //   2 quoted string: index = quote, range = content between the quotes;
    //     flag 16 = holds a backslash escape
    //   3 number; flag 16 = holds "."
    //   4 word
    //   5 operator: index = position in _ops
    //   6 unrecognised byte
    // Positions are bytes; col counts bytes from 1 and restarts after "\n".
    fn static _scan(s: string, cls: [int], lits: string, litOff: [int], cfg: [int], numStop: string, wordStop: string) : [int] {
        let out    = Array.Create(0, Type.Int);
        let n      = len(s);
        let nLc    = cfg[0];
        let nBc    = cfg[1];
        let opAt   = nLc + 2 * nBc;     // literal index of the first operator
        var pos    = 0;
        var line   = 1;
        var col    = 1;

        while (pos < n) {
            let c = cls[Char.Code(s[pos])];

            if ((c & 1) != 0) {
                if (cfg[5] != 0) {
                    let wl = line;
                    let wc = col;
                    let ws = pos;
                    while (pos < n && (cls[Char.Code(s[pos])] & 1) != 0) {
                        if (s[pos] == '\n') {
                            line += 1;
                            col = 1;
                        } else {
                            col += 1;
                        }
                        pos += 1;
                    }
                    Lexer._rec(out, 1, ws, pos - ws, wl, wc);
                } else {
                    if (s[pos] == '\n') {
                        line += 1;
                        col = 1;
                    } else {
                        col += 1;
                    }
                    pos += 1;
                }
                continue;
            }

            // Line comments run up to, not including, the newline; col is
            // left where the comment started.
            var skipped = false;
            iter (ci from 0 to ((c & 4) != 0 ? nLc : 0)) {
                if (Lexer._at(s, pos, n, lits, litOff[2 * ci], litOff[2 * ci + 1])) {
                    let e = String.IndexOfFrom(s, "\n", pos);
                    pos = (e < 0) ? n : e;
                    skipped = true;
                    break;
                }
            }
            if (skipped) continue;

            iter (bi from 0 to ((c & 4) != 0 ? nBc : 0)) {
                let li = nLc + 2 * bi;
                let oa = litOff[2 * li];
                let ob = litOff[2 * li + 1];
                if (Lexer._at(s, pos, n, lits, oa, ob)) {
                    let ca = litOff[2 * li + 2];
                    let cb = litOff[2 * li + 3];
                    var stop = n;
                    if (cb >= ca) {
                        let close = String.Substr(lits, ca, cb - ca);
                        let e = String.IndexOfFrom(s, close, pos + ob - oa);
                        if (e >= 0) { stop = e + cb - ca; }
                    }
                    iter (cp from pos to stop) {
                        if (s[cp] == '\n') {
                            line += 1;
                            col = 1;
                        } else {
                            col += 1;
                        }
                    }
                    pos = stop;
                    skipped = true;
                    break;
                }
            }
            if (skipped) continue;

            let tl = line;
            let tc = col;

            let qi = (c >> 4) - 1;
            if (qi >= 0) {
                let q = s[pos];
                pos += 1;
                col += 1;
                let qs = pos;
                var fl = 0;
                while (pos < n) {
                    let x = s[pos];
                    if (x == '\\') {
                        fl = 16;
                        pos += 1;
                        col += 1;
                        if (pos < n) {
                            pos += 1;
                            col += 1;
                        }
                    } else if (x == q) {
                        break;
                    } else {
                        if (x == '\n') {
                            line += 1;
                            col = 1;
                        } else {
                            col += 1;
                        }
                        pos += 1;
                    }
                }
                Lexer._rec(out, 2 | fl | (qi << 8), qs, pos - qs, tl, tc);
                if (pos < n) {
                    pos += 1;
                    col += 1;
                }
                continue;
            }

            let d = s[pos];
            if (cfg[3] != 0 && d >= '0' && d <= '9') {
                let e    = String.IndexOfAnyFrom(s, numStop, pos);
                let stop = (e < 0) ? n : e;
                var fl   = 0;
                iter (k from pos to stop) {
                    if (s[k] == '.') {
                        fl = 16;
                        break;
                    }
                }
                Lexer._rec(out, 3 | fl, pos, stop - pos, tl, tc);
                col += stop - pos;
                pos = stop;
                continue;
            }

            if (cfg[4] != 0 && (c & 2) != 0) {
                let e    = String.IndexOfAnyFrom(s, wordStop, pos);
                let stop = (e < 0) ? n : e;
                Lexer._rec(out, 4, pos, stop - pos, tl, tc);
                col += stop - pos;
                pos = stop;
                continue;
            }

            // Operators are sorted longest first.
            iter (oi from 0 to ((c & 8) != 0 ? cfg[2] : 0)) {
                let li = opAt + oi;
                let a  = litOff[2 * li];
                let b  = litOff[2 * li + 1];
                if (Lexer._at(s, pos, n, lits, a, b)) {
                    Lexer._rec(out, 5 | (oi << 8), pos, b - a, tl, tc);
                    col += b - a;
                    pos += b - a;
                    skipped = true;
                    break;
                }
            }
            if (skipped) continue;

            Lexer._rec(out, 6, pos, 1, tl, tc);
            col += 1;
            pos += 1;
        }
        return out;
    }

    // Content of a quoted string with its backslash escapes resolved: \n \t \r
    // become the control characters, \0 is dropped (a Flaris string holds no
    // NUL), and any other escaped byte stands for itself. A lone trailing
    // backslash is dropped.
    fn static _unescape(s: string, a: int, b: int) : string {
        let out = String.Create(b - a);
        var k   = 0;
        var p   = a;
        while (p < b) {
            let c = s[p];
            if (c == '\\') {
                p += 1;
                if (p < b) {
                    let e = s[p];
                    if (e == 'n') {
                        out[k] = '\n';
                        k += 1;
                    } else if (e == 't') {
                        out[k] = '\t';
                        k += 1;
                    } else if (e == 'r') {
                        out[k] = '\r';
                        k += 1;
                    } else if (e != '0') {
                        out[k] = e;
                        k += 1;
                    }
                    p += 1;
                }
            } else {
                out[k] = c;
                k += 1;
                p += 1;
            }
        }
        return String.Substr(out, 0, k);
    }

    // =========================================================================
    // Static convenience
    // =========================================================================

    // One-shot tokenize.  opts keys:
    //   word        : string - start+cont chars (same set), or {start, cont} object
    //   number      : bool
    //   string      : string or array - quote char(s); type defaults to "string"
    //   lineComment : string or array - line comment prefix(es)
    //   blockComment: array [open, close]
    //   ops         : string - single-char operators
    //   keywords    : array or object - if array, type = "keyword"
    //   skip        : string - characters to skip
    fn static Quick(src: string, opts: object) : array {
        let lex = new Lexer();

        if (opts.word != nil) {
            if (Type.Is(opts.word, Type.Object)) {
                lex.Word(opts.word.start, opts.word.cont);
            } else {
                lex.Word(opts.word, opts.word);
            }
        }

        if (opts.number == true) { lex.Number(); }

        if (opts.string != nil) {
            if (Type.Is(opts.string, Type.Array)) {
                iter (i from 0 to len(opts.string)) {
                    lex.Quote(opts.string[i], "string");
                }
            } else {
                lex.Quote(opts.string, "string");
            }
        }

        if (opts.lineComment != nil) {
            if (Type.Is(opts.lineComment, Type.Array)) {
                iter (i from 0 to len(opts.lineComment)) {
                    lex.LineComment(opts.lineComment[i]);
                }
            } else {
                lex.LineComment(opts.lineComment);
            }
        }

        if (opts.blockComment != nil) {
            lex.BlockComment(opts.blockComment[0], opts.blockComment[1]);
        }

        if (opts.ops != nil) { lex.Operators(opts.ops); }

        if (opts.keywords != nil) {
            if (Type.Is(opts.keywords, Type.Array)) {
                lex.Keywords(opts.keywords, "keyword");
            } else {
                // object: {word: type}
                let _ktype = opts.keywords;
                // iterate keys not directly supported - use Keywords with array if object
            }
        }

        if (opts.skip != nil) { lex.Skip(opts.skip); }

        return lex.Tokenize(src);
    }
}

export { Lexer };
