// =============================================================================
// Protobuf.fls - Protocol Buffers (proto3) for Flaris: wire codec + .proto reader.
// Version: 1.0
//
// Encodes and decodes protobuf wire-format bytes directly into and out of
// ordinary Flaris class instances. A message class is a normal class whose
// fields carry the message's data; a static Descriptor() method maps each
// field name to its field number and wire type.
//
// Message classes come from one of two places:
//
//   * written by hand, with a static Descriptor() - shown next;
//   * built from a .proto at runtime by Pb.LoadProto - see ".proto schemas"
//     below. That path needs no compiler, so it works on a runtime-only build.
//
//   import { Pb } from library("Protobuf", "1.0");
//
//   class Person {
//       let name   = "";
//       let id     = 0;
//       let emails = nil;          // repeated -> array
//       let home   = nil;          // nested message -> instance or nil
//
//       fn static Descriptor() {
//           return {
//               name:   { num: 1, kind: Pb.STRING },
//               id:     { num: 2, kind: Pb.INT32  },
//               emails: { num: 3, kind: Pb.STRING,  repeated: true },
//               home:   { num: 4, kind: Pb.MESSAGE, msg: Address    },
//           };
//       }
//   }
//
//   let p = new Person();
//   p.name = "Ada";
//   p.id   = 7;
//
//   let bytes = Pb.Encode(p);              // -> block
//   let back  = Pb.Decode(bytes, Person);  // -> Person instance
//
// Descriptor() is a static method, so it may reference message classes that are
// declared later in the file, and a message may reference itself - recursive and
// mutually recursive messages both work.
//
// -----------------------------------------------------------------------------
// Field specification
// -----------------------------------------------------------------------------
//   num:int          field number (required, 1..536870911)
//   kind:int         one of the Pb type constants below (required)
//   repeated:bool    field holds an array
//   packed:bool      override packing; proto3 packs repeated numeric scalars by
//                    default, and a decoder always accepts either form
//   msg:class        message class - required for MESSAGE, and for a MAP whose
//                    value is a MESSAGE
//   optional:bool    explicit presence: nil means absent, and a zero value is
//                    still written (proto3 `optional`)
//   oneof:string     name of the oneof group this field belongs to
//   key:int          MAP only - key type (an integral or STRING kind)
//   val:int          MAP only - value type
//
// Type constants (the numbering is protobuf's own FieldDescriptorProto.Type):
//
//   Pb.DOUBLE   Pb.FLOAT    Pb.INT64    Pb.UINT64   Pb.INT32
//   Pb.FIXED64  Pb.FIXED32  Pb.BOOL     Pb.STRING   Pb.MESSAGE
//   Pb.BYTES    Pb.UINT32   Pb.ENUM     Pb.SFIXED32 Pb.SFIXED64
//   Pb.SINT32   Pb.SINT64   Pb.MAP
//
// -----------------------------------------------------------------------------
// How Flaris values map to protobuf types
// -----------------------------------------------------------------------------
//   DOUBLE, FLOAT                      float
//   INT32/64, SINT32/64, SFIXED32/64   int
//   UINT32/64, FIXED32/64              int  (see "Unsigned 64-bit" below)
//   BOOL                               bool
//   STRING                             string   (UTF-8 bytes; NUL is allowed)
//   BYTES                              block
//   MESSAGE                            instance, or nil when absent
//   ENUM                               int
//   repeated X                         array of the above
//   map<K,V>                           object - see "Maps" below
//
// Presence (proto3 semantics):
//   A scalar equal to its type's zero value is not written, and an absent scalar
//   decodes to that zero value. A field marked `optional: true`, or one inside a
//   oneof, uses explicit presence instead: nil means absent, and a zero value is
//   written. A message field is always explicit - nil means absent.
//
// Maps:
//   A map field is a plain Flaris object, so its keys are strings. Integer and
//   bool keys appear in their decimal / "true" / "false" form, which is the same
//   convention protobuf's own canonical JSON mapping uses; the declared `key`
//   kind converts them back losslessly on encode. On the wire a map is the
//   repeated key/value entry message the spec defines, so this interoperates
//   with every other implementation.
//
//       tags: { num: 5, kind: Pb.MAP, key: Pb.STRING, val: Pb.INT32 }
//       m.tags = { "a": 1, "b": 2 };
//
// Unsigned 64-bit:
//   Flaris ints are signed 64-bit, so a uint64 or fixed64 above 2^63-1 reads
//   back as a negative int with the same bit pattern. The bytes round-trip
//   exactly; only the decimal rendering differs. Java's protobuf runtime makes
//   the same trade.
//
// Unknown fields:
//   A field the descriptor does not name is skipped. Declare a field named
//   `_unknown` (default nil) on a message class and those bytes are instead
//   retained verbatim and re-emitted when the message is encoded again, so a
//   proxy can forward a message it only partly understands without dropping data.
//
// -----------------------------------------------------------------------------
// Pb API - all static
// -----------------------------------------------------------------------------
//   Encode(msg:instance)                 -> block    wire bytes for msg
//   Decode(bytes:block, cls:class)       -> instance new instance of cls
//                                                    (a string payload is accepted
//                                                    too - same bytes)
//   Merge(msg:instance, bytes:block)     -> instance decode into an existing
//                                                    message (protobuf merge:
//                                                    scalars overwrite, repeated
//                                                    fields append, messages
//                                                    merge recursively)
//   EncodedSize(msg:instance)            -> int      byte length Encode returns
//
//   EncodeDelimited(msg:instance)        -> block    varint length + message
//   DecodeDelimited(r:PbReader, cls)     -> instance one length-prefixed message
//   ReadDelimited(s:stream, cls:class)   -> instance one message off a stream,
//                                                    or nil at a clean EOF
//   WriteDelimited(s:stream, msg)        -> bool     length-prefixed to a stream
//
//   WhichOneof(msg:instance, name:string) -> string  the set field's name, or nil
//   ClearOneof(msg:instance, name:string) -> bool    clear every member
//
//   Equals(a:instance, b:instance)       -> bool     wire-canonical comparison
//   Clone(msg:instance)                  -> instance deep copy via a round-trip
//
//   Register(cls, descriptor, fqName?)   -> class    give a class its descriptor
//                                                    explicitly (see below);
//                                                    fqName is the protobuf name
//                                                    ("pkg.Msg"), which only JSON
//                                                    needs
//   ClassFor(fqName:string)              -> class    the class registered under
//                                                    a fully-qualified name
//   ZeroFor(kind:int)                    -> any      the value a field of this
//                                                    kind holds when absent
//
//   ToJson(msg:instance, opts?)          -> string   canonical proto3 JSON
//   FromJson(text:string, cls:class)     -> instance parse canonical proto3 JSON
//
//   LoadProto(source:string, name?)      -> object   .proto text -> { name: class }
//   LoadProtoFile(path, includes?)       -> object   same, resolving imports
//   ParseProto(source:string, name?)     -> schema   parse only, as plain data
//   ParseProtoFile(path, includes?)      -> schema   parse a file and its imports
//   DefineSchema(schema)                 -> object   schema -> { name: class },
//                                                    plus a service descriptor
//                                                    per `service` (see below)
//
// -----------------------------------------------------------------------------
// JSON
// -----------------------------------------------------------------------------
// `ToJson` / `FromJson` implement protobuf's canonical proto3 JSON mapping - the
// same bytes Go's protojson, protobuf-java and protobuf-es produce, so a message
// written here reads anywhere:
//
//   Console.WriteLine(Pb.ToJson(person));   // {"name":"Ada","userId":"42"}
//   let p = Pb.FromJson(text, Person);
//
// The mapping is the specification, not a house style: field names become
// lowerCamelCase (or whatever `json_name` says), 64-bit integers become strings
// because a JSON number cannot hold them, bytes become base64, enums become
// their value name, NaN and the infinities become quoted strings, and a field
// holding its default is left out entirely.
//
// The well-known types have their own forms - a Timestamp is an RFC 3339 string,
// a Duration is "1.5s", a wrapper is the bare value, a Struct is a plain JSON
// object, a FieldMask is a comma-separated list, and an Any is its contents with
// an "@type" member added.
//
// Reading is deliberately more permissive than writing, as the specification
// requires: either spelling of a field name, an enum by name or by number, and a
// 64-bit integer as a string or a number are all accepted. A member the message
// does not declare is an error rather than something skipped silently, and a
// JSON null leaves a field at its default.
//
//   opts: { emitDefaults, useProtoNames, useEnumNumbers }
//
// Two limits worth knowing. `Any` is resolved through a process-wide table of
// fully-qualified names, so loading two schemas that define the same message
// name leaves the one registered last - `Pb.ClassFor(name)` reports which.
// And a float is written in the shortest form that reads back identically,
// found by trial rather than by a shortest-round-trip primitive the VM does not
// have; outside the range fixed-point renders sensibly it falls back to a full
// 17-digit form, which is exact but longer than other implementations print.
//
// -----------------------------------------------------------------------------
// Messages defined at runtime
// -----------------------------------------------------------------------------
// A class built by Class.Define has no body, so it cannot carry a static
// Descriptor(). Register one for it instead and everything else is identical -
// this is the path for a schema that arrives as data (a descriptor file, a gRPC
// reflection reply) rather than as generated code, and the only one available on
// a runtime-only build, which has no compiler.
//
//   let Person = Class.Define("Person", { name: Pb.ZeroFor(Pb.STRING),
//                                         id:   Pb.ZeroFor(Pb.INT32) });
//   Pb.Register(Person, { name: { num: 1, kind: Pb.STRING },
//                         id:   { num: 2, kind: Pb.INT32  } });
//
//   let p = Pb.Decode(bytes, Person);   // same call as a generated class
//   Console.WriteLine(p.name);
//
// Build every class first and register descriptors in a second pass, so a
// message can reference one defined later, or itself. A registered descriptor
// takes precedence over a Descriptor() method, so it also works as a deliberate
// override; re-registering replaces the previous one.
//
// Descriptors live in a side table rather than on the class on purpose: a
// schema's messages refer to each other, and a descriptor stored on the class it
// describes would close a reference cycle that is never reclaimed.
//
// Give a runtime-defined message an `_unknown` field like the generated classes
// have, and a partial schema still round-trips losslessly.
//
// -----------------------------------------------------------------------------
// .proto schemas
// -----------------------------------------------------------------------------
// A .proto file is data, so it can be read at runtime and turned into live
// classes - no code generation, no compiler, nothing new becomes executable:
//
//   let types = Pb.LoadProtoFile("api.proto", nil);
//   let msg   = Pb.Decode(bytes, types["Person"]);
//   Console.WriteLine(msg.name);
//
// LoadProto returns a map of name -> class. A nested type flattens
// (`Outer.Inner` becomes `Outer_Inner`), because a Flaris class cannot nest. An
// enum maps to a plain object of its values, so `types["Status"].ACTIVE` reads
// the way a Flaris enum would. Every message gets an `_unknown` field, so a
// partial schema still re-encodes losslessly.
//
// Every type is in the map twice: under its short name and under its fully
// qualified one. Two packages can flatten to the same short name - a schema of
// its own `Value` next to google.protobuf.Value - and then the short key goes to
// the file you loaded rather than to whatever it imported. The qualified name
// always resolves, so nothing is unreachable:
//
//   types["Value"]                    // yours
//   types["google.protobuf.Value"]    // the built-in one
//
// -----------------------------------------------------------------------------
// Well-known types
// -----------------------------------------------------------------------------
// The ten standard `google/protobuf/*.proto` schemas are built in, so importing
// one needs no file on disk and no include path - which matters, because a real
// schema usually imports at least one:
//
//   import "google/protobuf/timestamp.proto";
//   message Event { string id = 1; google.protobuf.Timestamp at = 2; }
//
// Built in: any, api, duration, empty, field_mask, source_context, struct,
// timestamp, type, wrappers - and whatever they import in turn. A copy on the
// include path wins over the built-in one, so vendoring your own still works.
// They are the canonical schemas with comments and file options stripped;
// package, message, field name, number and type - everything the wire depends
// on - are verbatim, and checked against the Go runtime.
//
// descriptor.proto is deliberately absent: it is proto2, which this parser
// rejects on purpose. Importing it says so rather than reporting a missing file.
//
// Because these need no filesystem, LoadProto follows them for an inline schema
// too; any other import still needs LoadProtoFile.
//
// Supported: package, import (public/weak), nested messages and enums,
// singular / repeated / proto3 optional, oneof, map<K,V>, reserved, and
// service/rpc including streaming. Field and file options parse but only
// `[packed = false]` changes behaviour. proto2 - `required`, groups,
// extensions - and proto editions are reported as errors rather than mis-read.
//
// A `service` lands in the same map as the messages, as data rather than a
// class - it declares calls, it is not one:
//
//   let api = Pb.LoadProtoFile("greet.proto", nil);
//   let m   = api["Greeter"].methods.SayHello;
//   m.path            // "/greet.Greeter/SayHello"  - gRPC and Connect both
//   m.input           // class Req                     address a method by this
//   m.output          // class Rep
//   m.clientStream    // false
//   m.serverStream    // false
//
// `svc.order` lists the method names as declared, so a transport can walk a
// service without relying on map order. A method names its service in
// `m.service`; it does not hold it, because a back-reference would be a cycle.
// Nothing here opens a socket - binding these to a wire protocol is a
// transport's job. The Connect library is one: `Connect.Call(m, msg)` takes a
// method descriptor straight from this map.
//
// ParseProto stops after parsing and hands back the schema as plain data, for
// inspection (`Json.Stringify`) or for building something else from it.
//
// PbWriter / PbReader are the low-level encoder and decoder. Reach for them to
// hand-write a codec for a hot message; Pb.Encode/Decode are built on them.
//
//   PbWriter: Tag(num, wire) VarInt(v) ZigZag(v) Fixed32(v) Fixed64(v)
//             Float(v) Double(v) Str(s) Bytes(blk) Raw(blk) Position() ToBuffer()
//   PbReader: Tag() VarInt() ZigZag() Fixed32() SFixed32() Fixed64() Float()
//             Double() Str(n) Bytes(n) Skip(wire) AtEnd() Position() Limit()
//
// Wire-type constants: Pb.WIRE_VARINT, WIRE_64, WIRE_LEN, WIRE_32.
//
// Limits: nesting is capped at 100 levels and a field number must be in
// 1..536870911; both raise rather than recurse or emit a malformed tag.
// =============================================================================


import { Util }  from library("Util", "1.0");
import { Lexer } from library("Lexer", "1.0");


// A payload that arrived as a string (an HTTP body, a file read) holds the same
// bytes; take a block view of it rather than failing later in the first typed
// read. Anything else is rejected here instead of silently decoding to nothing.
fn _pb_asBlock(v):block {
    if (type(v) == Type.Block)  { return v; }
    if (type(v) == Type.String) { return Buffer.FromString(v); }
    throw(1, "Protobuf: expected wire bytes as a block or string");
}


// =============================================================================
// PbWriter - growable block-backed encoder
// =============================================================================
class PbWriter
{
    let _buf:block = nil;
    let _cap:int   = 0;
    let _pos:int   = 0;

    fn Constructor(capacity:int|nil) {
        let c:int = 256;
        if (capacity != nil && capacity > 0) { c = capacity; }
        _buf = Buffer.Create(c, 1);
        _cap = c;
    }

    fn _grow(need:int) {
        let c:int = _cap;
        while (c < _pos + need) { c = c * 2; }
        Buffer.Reserve(_buf, c);
        _cap = c;
    }

    fn Position():int { return _pos; }

    // Filled bytes as a new block; the writer stays usable.
    fn ToBuffer():block { return Buffer.Slice(_buf, 0, _pos); }

    fn Reset() { _pos = 0; }

    fn VarInt(v:int) {
        if (_pos + 10 > _cap) { _grow(10); }
        _pos += Buffer.WriteVarintAt(_buf, _pos, v);
    }

    // LEB128 of the zigzag transform - the sint32/sint64 encoding.
    fn ZigZag(v:int) { VarInt((v << 1) ^ (v >> 63)); }

    fn Tag(num:int, wire:int) { VarInt((num << 3) | wire); }

    fn Fixed32(v:int) {
        if (_pos + 4 > _cap) { _grow(4); }
        Buffer.WriteU32At(_buf, _pos, v, false);
        _pos += 4;
    }

    fn Fixed64(v:int) {
        if (_pos + 8 > _cap) { _grow(8); }
        Buffer.WriteU64At(_buf, _pos, v, false);
        _pos += 8;
    }

    fn Float(v:float) {
        if (_pos + 4 > _cap) { _grow(4); }
        Buffer.WriteFloat32At(_buf, _pos, v, false);
        _pos += 4;
    }

    fn Double(v:float) {
        if (_pos + 8 > _cap) { _grow(8); }
        Buffer.WriteFloat64At(_buf, _pos, v, false);
        _pos += 8;
    }

    fn Byte(v:int) {
        if (_pos + 1 > _cap) { _grow(1); }
        Buffer.WriteU8At(_buf, _pos, v & 0xFF);
        _pos += 1;
    }

    // Length-delimited UTF-8. String bytes go straight in - no intermediate block.
    fn Str(s:string) {
        let n:int = len(s);
        VarInt(n);
        if (n == 0) { return; }
        if (_pos + n > _cap) { _grow(n); }
        Buffer.CopyStringAt(_buf, _pos, s, n);
        _pos += n;
    }

    fn Bytes(blk:block) {
        if (is_nil(blk)) { VarInt(0); return; }
        let n:int = len(blk);
        VarInt(n);
        if (n == 0) { return; }
        if (_pos + n > _cap) { _grow(n); }
        Buffer.Copy(blk, 0, _buf, _pos, n);
        _pos += n;
    }

    // Append raw bytes with no length prefix.
    fn Raw(blk:block) {
        if (is_nil(blk)) { return; }
        let n:int = len(blk);
        if (n == 0) { return; }
        if (_pos + n > _cap) { _grow(n); }
        Buffer.Copy(blk, 0, _buf, _pos, n);
        _pos += n;
    }
}


// =============================================================================
// PbReader - bounded cursor over a block
//
// _end is the exclusive limit of the region being read. A submessage decode
// narrows it and restores it afterwards, so nesting costs no allocation.
// =============================================================================
class PbReader
{
    let _buf:block = nil;
    let _pos:int   = 0;
    let _end:int   = 0;

    fn Constructor(buf, offset:int|nil, length:int|nil) {
        if (is_nil(buf)) { throw(1, "PbReader: buffer is nil"); }
        buf = _pb_asBlock(buf);
        _buf = buf;
        _pos = 0;
        if (offset != nil) { _pos = offset; }
        _end = len(buf);
        if (length != nil) { _end = _pos + length; }
        if (_end > len(buf)) { _end = len(buf); }
    }

    fn Position():int { return _pos; }
    fn Limit():int    { return _end; }
    fn AtEnd():bool   { return _pos >= _end; }
    fn Remaining():int { return _end - _pos; }

    fn Seek(p:int) { _pos = p; }

    // Narrow to a subregion and return the previous limit, for restoring.
    fn PushLimit(length:int):int {
        let prev:int = _end;
        let e:int = _pos + length;
        if (e > prev) { throw(2, "Protobuf: submessage length runs past its parent"); }
        _end = e;
        return prev;
    }

    fn PopLimit(prev:int) { _end = prev; }

    fn VarInt():int {
        let r = Buffer.ReadVarintAt(_buf, _pos);
        let n:int = r[1];
        if (n == 0 || _pos + n > _end) { throw(2, "Protobuf: truncated varint"); }
        _pos += n;
        return r[0];
    }

    fn ZigZag():int {
        let v:int = VarInt();
        return ((v >> 1) & 0x7FFFFFFFFFFFFFFF) ^ (0 - (v & 1));
    }

    fn Tag():int { return VarInt(); }

    fn Fixed32():int {
        if (_pos + 4 > _end) { throw(2, "Protobuf: truncated fixed32"); }
        let v:int = Buffer.ReadU32At(_buf, _pos, false);
        _pos += 4;
        return v;
    }

    fn SFixed32():int {
        if (_pos + 4 > _end) { throw(2, "Protobuf: truncated fixed32"); }
        let v:int = Buffer.ReadI32At(_buf, _pos, false);
        _pos += 4;
        return v;
    }

    fn Fixed64():int {
        if (_pos + 8 > _end) { throw(2, "Protobuf: truncated fixed64"); }
        let v:int = Buffer.ReadU64At(_buf, _pos, false);
        _pos += 8;
        return v;
    }

    fn Float():float {
        if (_pos + 4 > _end) { throw(2, "Protobuf: truncated float"); }
        let v:float = Buffer.ReadFloat32At(_buf, _pos, false);
        _pos += 4;
        return v;
    }

    fn Double():float {
        if (_pos + 8 > _end) { throw(2, "Protobuf: truncated double"); }
        let v:float = Buffer.ReadFloat64At(_buf, _pos, false);
        _pos += 8;
        return v;
    }

    fn Str(n:int):string {
        if (n < 0 || _pos + n > _end) { throw(2, "Protobuf: truncated string"); }
        if (n == 0) { return ""; }
        let s:string = Buffer.ToString(Buffer.Slice(_buf, _pos, n));
        _pos += n;
        return s;
    }

    fn Bytes(n:int):block {
        if (n < 0 || _pos + n > _end) { throw(2, "Protobuf: truncated bytes"); }
        let b:block = Buffer.Slice(_buf, _pos, n);
        _pos += n;
        return b;
    }

    // Consume one field's payload given its wire type.
    fn Skip(wire:int) {
        if (wire == 0) { VarInt(); return; }
        if (wire == 1) { if (_pos + 8 > _end) { throw(2, "Protobuf: truncated fixed64"); } _pos += 8; return; }
        if (wire == 5) { if (_pos + 4 > _end) { throw(2, "Protobuf: truncated fixed32"); } _pos += 4; return; }
        if (wire == 2) {
            let n:int = VarInt();
            if (n < 0 || _pos + n > _end) { throw(2, "Protobuf: truncated length-delimited field"); }
            _pos += n;
            return;
        }
        throw(2, "Protobuf: unsupported wire type " + str(wire));
    }

    // Raw bytes of one field including its tag - for unknown-field retention.
    fn SkipRaw(tagStart:int, wire:int):block {
        Skip(wire);
        return Buffer.Slice(_buf, tagStart, _pos - tagStart);
    }
}


class ProtoParser
{
    let _toks:array  = nil;
    let _pos:int     = 0;
    let _file:string = "";

    fn Constructor(source:string, filename:string|nil) {
        if (is_nil(filename)) { _file = "<input>"; } else { _file = filename; }
        // No keyword table: proto has no reserved words, so `message` and `map`
        // are legal field names and must stay plain word tokens.
        let lex = new Lexer();
        lex.Word("a-zA-Z_", "a-zA-Z0-9_")
           .Number()
           .Quote("\"", "string")
           .Quote("'", "string")
           .LineComment("//")
           .BlockComment("/*", "*/")
           .Operators("{}()[]<>=;,./-+")
           .Skip(" \t\n\r");
        _toks = lex.Tokenize(source);
        _pos  = 0;
    }

    // ---- cursor ----

    fn AtEnd():bool { return _pos >= len(_toks); }

    fn Peek(offset:int|nil) {
        let i:int = _pos + (offset ?? 0);
        if (i < 0 || i >= len(_toks)) { return nil; }
        return _toks[i];
    }

    fn Next() {
        let t = Peek(0);
        if (is_nil(t)) { Fail("unexpected end of file"); }
        _pos += 1;
        return t;
    }

    fn Line():int {
        let t = Peek(0);
        if (is_nil(t)) {
            if (len(_toks) == 0) { return 0; }
            return _toks[len(_toks) - 1].line;
        }
        return t.line;
    }

    fn Fail(msg:string) {
        throw(1, _file + ":" + str(Line()) + ": " + msg);
    }

    // True when the next token is this exact word or operator.
    fn Is(v:string):bool {
        let t = Peek(0);
        if (is_nil(t)) { return false; }
        if (t.type != "word" && t.type != "op") { return false; }
        return t.val == v;
    }

    fn Accept(v:string):bool {
        if (Is(v)) { _pos += 1; return true; }
        return false;
    }

    fn Expect(v:string) {
        if (!Accept(v)) {
            let t = Peek(0);
            let got:string = is_nil(t) ? "end of file" : ("'" + str(t.val) + "'");
            Fail("expected '" + v + "' but found " + got);
        }
    }

    fn Word():string {
        let t = Next();
        if (t.type != "word") { Fail("expected a name but found '" + str(t.val) + "'"); }
        return t.val;
    }

    fn Str():string {
        let t = Next();
        if (t.type != "string") { Fail("expected a quoted string"); }
        return t.val;
    }

    fn Int():int {
        let neg:bool = false;
        if (Accept("-")) { neg = true; }
        else { Accept("+"); }
        let t = Next();
        if (t.type != "number") { Fail("expected a number but found '" + str(t.val) + "'"); }
        let v:int = int(t.val);
        return neg ? (0 - v) : v;
    }

    // A dotted type reference: `.pkg.Msg`, `Msg`, `Outer.Inner`.
    fn TypeRef():string {
        let name:string = "";
        if (Accept(".")) { name = "."; }
        name = name + Word();
        while (Is(".")) {
            // A '.' only continues the reference when a name follows it.
            let after = Peek(1);
            if (is_nil(after) || after.type != "word") { break; }
            _pos += 1;
            name = name + "." + Word();
        }
        return name;
    }

    // A label word only counts as a label when a type name follows it; proto
    // lets a field be called `optional` or `repeated`.
    fn _IsLabel(v:string):bool {
        if (!Is(v)) { return false; }
        let after = Peek(1);
        if (is_nil(after)) { return false; }
        return after.type == "word" || after.val == ".";
    }

    // ---- grammar ----

    fn ParseFile() {
        let schema = {
            file:     _file,
            syntax:   "proto2",
            package:  "",
            imports:  [],
            messages: [],
            enums:    [],
            services: [],
        };

        while (!AtEnd()) {
            if (Accept(";")) { continue; }

            if (Accept("syntax")) {
                Expect("=");
                schema.syntax = Str();
                Expect(";");
                continue;
            }
            if (Accept("edition")) {
                Fail("proto editions are not supported; use syntax = \"proto3\"");
            }
            if (Accept("package")) {
                schema.package = TypeRef();
                Expect(";");
                continue;
            }
            if (Accept("import")) {
                let kind:string = "";
                if (Is("public") || Is("weak")) { kind = Word(); }
                let path:string = Str();
                Expect(";");
                Array.Append(schema.imports, { path: path, kind: kind });
                continue;
            }
            if (Accept("option"))  { _SkipOption(); continue; }
            if (Accept("message")) { Array.Append(schema.messages, _Message(schema.package)); continue; }
            if (Accept("enum"))    { Array.Append(schema.enums,    _Enum(schema.package));    continue; }
            if (Accept("service")) { Array.Append(schema.services, _Service(schema.package)); continue; }
            if (Is("extend")) { Fail("proto2 extensions are not supported"); }

            let t = Peek(0);
            Fail("unexpected '" + str(t.val) + "' at top level");
        }

        if (schema.syntax != "proto3") {
            throw(1, _file + ": syntax is \"" + schema.syntax
                   + "\"; only proto3 is supported");
        }
        return schema;
    }

    fn _Message(prefix:string) {
        let name:string = Word();
        let fq:string   = (prefix == "") ? name : (prefix + "." + name);
        Expect("{");

        let m = {
            name:          name,
            fqName:        fq,
            fields:        [],
            oneofs:        [],
            nested:        [],
            enums:         [],
            reservedNums:  [],
            reservedNames: [],
        };

        while (!Accept("}")) {
            if (AtEnd()) { Fail("unterminated message '" + name + "'"); }
            if (Accept(";")) { continue; }
            if (Accept("message"))  { Array.Append(m.nested, _Message(fq)); continue; }
            if (Accept("enum"))     { Array.Append(m.enums,  _Enum(fq));    continue; }
            if (Accept("option"))   { _SkipOption(); continue; }
            if (Accept("reserved")) { _Reserved(m.reservedNums, m.reservedNames); continue; }
            if (Accept("oneof"))    { _Oneof(m); continue; }
            if (Is("extensions"))   { Fail("proto2 extension ranges are not supported"); }
            if (Is("extend"))       { Fail("proto2 extensions are not supported"); }
            if (Is("group"))        { Fail("proto2 groups are not supported"); }
            Array.Append(m.fields, _Field(false));
        }
        return m;
    }

    // inOneof forbids a label, which proto does not allow inside a oneof.
    fn _Field(inOneof:bool) {
        let label:string = "singular";
        if (!inOneof) {
            if (_IsLabel("repeated"))      { Word(); label = "repeated"; }
            else if (_IsLabel("optional")) { Word(); label = "optional"; }
            else if (_IsLabel("required")) {
                Fail("proto2 'required' is not supported");
            }
        }

        // A group is `group Name = 1 { ... }` and appears where a type does, so
        // it has to be caught here rather than at the start of a member.
        if (Is("group")) { Fail("proto2 groups are not supported"); }

        // map<K,V> - a field may also simply be named `map`, hence the '<' test.
        if (Is("map")) {
            let after = Peek(1);
            if (!is_nil(after) && after.val == "<") {
                if (label != "singular") { Fail("a map field cannot be '" + label + "'"); }
                return _MapField();
            }
        }

        let typeName:string = TypeRef();
        let fname:string    = Word();
        Expect("=");
        let num:int = Int();
        let opts    = _FieldOptions();
        Expect(";");

        return {
            name:     fname,
            num:      num,
            label:    label,
            typeName: typeName,
            keyType:  nil,
            valType:  nil,
            oneof:    nil,
            opts:     opts,
        };
    }

    fn _MapField() {
        Expect("map");
        Expect("<");
        let keyType:string = Word();
        Expect(",");
        let valType:string = TypeRef();
        Expect(">");
        let fname:string = Word();
        Expect("=");
        let num:int = Int();
        let opts    = _FieldOptions();
        Expect(";");

        return {
            name:     fname,
            num:      num,
            label:    "map",
            typeName: nil,
            keyType:  keyType,
            valType:  valType,
            oneof:    nil,
            opts:     opts,
        };
    }

    fn _Oneof(m) {
        let oname:string = Word();
        Expect("{");
        let members:array = [];
        while (!Accept("}")) {
            if (AtEnd()) { Fail("unterminated oneof '" + oname + "'"); }
            if (Accept(";")) { continue; }
            if (Accept("option")) { _SkipOption(); continue; }
            let f = _Field(true);
            f.oneof = oname;
            Array.Append(m.fields, f);
            Array.Append(members, f.name);
        }
        Array.Append(m.oneofs, { name: oname, fields: members });
    }

    fn _Enum(prefix:string) {
        let name:string = Word();
        let fq:string   = (prefix == "") ? name : (prefix + "." + name);
        Expect("{");

        let e = {
            name:       name,
            fqName:     fq,
            values:     [],
            allowAlias: false,
            reservedNums:  [],
            reservedNames: [],
        };

        while (!Accept("}")) {
            if (AtEnd()) { Fail("unterminated enum '" + name + "'"); }
            if (Accept(";")) { continue; }
            if (Accept("reserved")) { _Reserved(e.reservedNums, e.reservedNames); continue; }
            if (Accept("option")) {
                if (Is("allow_alias")) {
                    Word();
                    Expect("=");
                    e.allowAlias = (Word() == "true");
                    Expect(";");
                } else {
                    _SkipOption();
                }
                continue;
            }
            let vname:string = Word();
            Expect("=");
            let vnum:int = Int();
            _FieldOptions();
            Expect(";");
            Array.Append(e.values, { name: vname, num: vnum });
        }
        return e;
    }

    fn _Service(prefix:string) {
        let name:string = Word();
        let fq:string   = (prefix == "") ? name : (prefix + "." + name);
        Expect("{");

        let svc = { name: name, fqName: fq, methods: [] };

        while (!Accept("}")) {
            if (AtEnd()) { Fail("unterminated service '" + name + "'"); }
            if (Accept(";")) { continue; }
            if (Accept("option")) { _SkipOption(); continue; }
            Expect("rpc");

            let mname:string = Word();
            Expect("(");
            let cstream:bool = _IsLabel("stream");
            if (cstream) { Word(); }
            let input:string = TypeRef();
            Expect(")");
            Expect("returns");
            Expect("(");
            let sstream:bool = _IsLabel("stream");
            if (sstream) { Word(); }
            let output:string = TypeRef();
            Expect(")");

            if (Accept("{")) {
                while (!Accept("}")) {
                    if (AtEnd()) { Fail("unterminated rpc '" + mname + "'"); }
                    if (Accept("option")) { _SkipOption(); continue; }
                    Next();
                }
            } else {
                Expect(";");
            }

            Array.Append(svc.methods, {
                name:         mname,
                input:        input,
                output:       output,
                clientStream: cstream,
                serverStream: sstream,
            });
        }
        return svc;
    }

    // `reserved 2, 9 to 11, 15;` or `reserved "foo", "bar";`
    fn _Reserved(nums:array, names:array) {
        let t = Peek(0);
        if (!is_nil(t) && t.type == "string") {
            while (true) {
                Array.Append(names, Str());
                if (!Accept(",")) { break; }
            }
            Expect(";");
            return;
        }
        while (true) {
            let lo:int = Int();
            let hi:int = lo;
            if (Is("to")) {
                Word();
                if (Is("max")) { Word(); hi = 536870911; }
                else           { hi = Int(); }
            }
            Array.Append(nums, [lo, hi]);
            if (!Accept(",")) { break; }
        }
        Expect(";");
    }

    // Everything after the `option` keyword, up to and including its `;`.
    // Option bodies are parsed only well enough to be stepped over - none are
    // applied, so a custom option can never silently change the output.
    fn _SkipOption() {
        let depth:int = 0;
        while (!AtEnd()) {
            let t = Next();
            if (t.type == "op") {
                if (t.val == "{" || t.val == "[" || t.val == "(") { depth += 1; }
                else if (t.val == "}" || t.val == "]" || t.val == ")") { depth -= 1; }
                else if (t.val == ";" && depth <= 0) { return; }
            }
        }
        Fail("unterminated option");
    }

    // `[packed = false, json_name = "x"]` - known keys are kept, the rest are
    // parsed and dropped.
    fn _FieldOptions() {
        let opts = {};
        if (!Accept("[")) { return opts; }

        while (true) {
            let key:string = "";
            if (Accept("(")) {
                // A custom option: (foo.bar) [.baz] - recorded under no name.
                let d:int = 1;
                while (d > 0 && !AtEnd()) {
                    let t = Next();
                    if (t.val == "(") { d += 1; }
                    if (t.val == ")") { d -= 1; }
                }
                while (Accept(".")) { Word(); }
                key = "";
            } else {
                key = Word();
                while (Accept(".")) { key = key + "." + Word(); }
            }
            Expect("=");
            let v = _OptionValue();
            if (key != "") { opts[key] = v; }
            if (!Accept(",")) { break; }
        }
        Expect("]");
        return opts;
    }

    fn _OptionValue() {
        if (Accept("{")) {
            let d:int = 1;
            while (d > 0 && !AtEnd()) {
                let t = Next();
                if (t.val == "{") { d += 1; }
                if (t.val == "}") { d -= 1; }
            }
            return nil;
        }
        let t = Peek(0);
        if (is_nil(t)) { Fail("expected an option value"); }
        if (t.type == "string") { return Str(); }
        if (t.type == "number" || t.val == "-" || t.val == "+") { return Int(); }
        let w:string = Word();
        while (Accept(".")) { w = w + "." + Word(); }
        if (w == "true")  { return true; }
        if (w == "false") { return false; }
        return w;
    }
}


// =============================================================================
// Protogen - resolution and code generation
// =============================================================================


// Prepared descriptors live here rather than on the class: a class body holds
// only consts, which cannot be reassigned.
global _pb_prepCache = nil;

// Descriptors registered for classes that have no static Descriptor() - the
// runtime-defined case (Class.Define). Kept in a side table rather than attached
// to the class: a schema's messages refer to each other, so a descriptor stored
// ON the class it describes would close a reference cycle that is never
// reclaimed. table -> class and table -> descriptor -> class has no way back.
global _pb_registry = nil;

// proto scalar type name -> Pb kind. Built once, on first use.
global _pb_scalarKinds = nil;

// The standard google/protobuf schemas, so `import "google/protobuf/*.proto"`
// resolves with no file on disk. Built once, on first use.
global _pb_wellKnown = nil;

// class -> fully-qualified protobuf name, for the JSON layer's well-known-type
// dispatch. Only populated for classes registered with one.
global _pb_fqNames = nil;

// The reverse: fully-qualified name -> class, so an Any's type URL can be
// resolved back to the message it names.
global _pb_byName = nil;


// =============================================================================
// Pb - static facade: descriptor preparation, sizing, encoding, decoding
// =============================================================================
class Pb
{
    // Field types - protobuf's own FieldDescriptorProto.Type numbering, so a
    // descriptor set read from protoc maps across unchanged. MAP is Flaris
    // sugar: 19 is unused upstream, and on the wire it is the repeated
    // key/value entry message the spec defines.
    const DOUBLE   = 1;
    const FLOAT    = 2;
    const INT64    = 3;
    const UINT64   = 4;
    const INT32    = 5;
    const FIXED64  = 6;
    const FIXED32  = 7;
    const BOOL     = 8;
    const STRING   = 9;
    const MESSAGE  = 11;
    const BYTES    = 12;
    const UINT32   = 13;
    const ENUM     = 14;
    const SFIXED32 = 15;
    const SFIXED64 = 16;
    const SINT32   = 17;
    const SINT64   = 18;
    const MAP      = 19;

    const WIRE_VARINT = 0;
    const WIRE_64     = 1;
    const WIRE_LEN    = 2;
    const WIRE_32     = 5;

    const MAX_DEPTH     = 100;
    const MAX_FIELD_NUM = 536870911;

    // -------------------------------------------------------------------------
    // Descriptor preparation
    // -------------------------------------------------------------------------

    // The wire type a field kind travels as.
    fn static WireFor(kind:int):int {
        if (kind == Pb.DOUBLE   || kind == Pb.FIXED64 || kind == Pb.SFIXED64) { return Pb.WIRE_64; }
        if (kind == Pb.FLOAT    || kind == Pb.FIXED32 || kind == Pb.SFIXED32) { return Pb.WIRE_32; }
        if (kind == Pb.STRING   || kind == Pb.BYTES   || kind == Pb.MESSAGE
                                || kind == Pb.MAP)                            { return Pb.WIRE_LEN; }
        return Pb.WIRE_VARINT;
    }

    // Prepared descriptors, keyed by class object (heap values hash by identity).
    // Preparing the same class twice yields an equivalent result, so a fiber
    // switch mid-prepare can only cost duplicate work, never a wrong descriptor.
    fn static _Cache() {
        if (is_nil(_pb_prepCache)) { _pb_prepCache = Collections.HashMap(); }
        return _pb_prepCache;
    }

    // Resolve cls's Descriptor() into the flat form the codec walks: fields in
    // declaration order with their tags precomputed, plus a field-number index
    // for decoding and the oneof groupings.
    // Register(cls, descriptor) - give a class its wire descriptor explicitly,
    // for a class built at runtime by Class.Define which cannot carry a static
    // Descriptor() method. Same descriptor shape as Descriptor() returns.
    // Re-registering replaces the previous one and drops the prepared cache
    // entry, so a schema can be reloaded without restarting.
    // `fqName` is the message's fully-qualified protobuf name
    // ("google.protobuf.Timestamp"). It is optional and only JSON needs it: the
    // well-known types have their own JSON forms and are recognised by name.
    fn static Register(cls, descriptor, fqName?) {
        if (is_nil(cls) || !Class.IsClass(cls)) {
            throw(1, "Pb.Register: expected a message class");
        }
        if (is_nil(descriptor) || !is_object(descriptor)) {
            throw(1, "Pb.Register: expected a descriptor object");
        }
        if (is_nil(_pb_registry)) { _pb_registry = Collections.HashMap(); }
        _pb_registry.Set(cls, descriptor);
        if (!is_nil(fqName)) {
            if (is_nil(_pb_fqNames)) { _pb_fqNames = Collections.HashMap(); }
            _pb_fqNames.Set(cls, fqName);
            if (is_nil(_pb_byName)) { _pb_byName = Collections.HashMap(); }
            _pb_byName.Set(fqName, cls);
        }
        Pb._Cache().Delete(cls);
        return cls;
    }

    // The class registered under a fully-qualified protobuf name, or nil.
    // DefineSchema registers every message it builds, so a loaded .proto makes
    // its types resolvable here - which is what expanding an Any needs.
    fn static ClassFor(fqName:string) {
        if (is_nil(_pb_byName)) { return nil; }
        return _pb_byName.Get(fqName);
    }

    // The value a field of this kind holds when absent - what Class.Define
    // should use as the field's default.
    fn static ZeroFor(kind:int) {
        return Pb._ZeroFor(kind);
    }

    fn static Prepare(cls) {
        if (is_nil(cls) || !Class.IsClass(cls)) {
            throw(1, "Protobuf: expected a message class");
        }
        let cache = Pb._Cache();
        let hit = cache.Get(cls);
        if (!is_nil(hit)) { return hit; }

        // A registered descriptor wins: a runtime-defined class has no method
        // to carry one, and an explicit Register is a deliberate override.
        let raw = nil;
        if (!is_nil(_pb_registry)) { raw = _pb_registry.Get(cls); }
        if (is_nil(raw)) {
            if (!Class.HasMethod(cls, "Descriptor")) {
                throw(1, "Protobuf: class '" + Class.GetName(cls)
                       + "' has no static Descriptor() and none was registered"
                       + " with Pb.Register");
            }
            raw = Class.Invoke(cls, "Descriptor");
        }
        if (is_nil(raw)) {
            throw(1, "Protobuf: descriptor for '" + Class.GetName(cls) + "' is nil");
        }

        let names  = Object.Keys(raw);
        let fields = [];
        let byNum  = Collections.HashMap();
        let oneofs = {};

        let i:int = 0;
        while (i < len(names)) {
            let fname:string = names[i];
            let spec = raw[fname];
            i += 1;

            let num:int = spec.num ?? 0;
            if (num < 1 || num > Pb.MAX_FIELD_NUM) {
                throw(1, "Protobuf: field '" + fname + "' has an out-of-range number " + str(num));
            }
            if (!is_nil(byNum.Get(num))) {
                throw(1, "Protobuf: field number " + str(num) + " is used twice in "
                       + Class.GetName(cls));
            }

            let kind:int = spec.kind ?? 0;
            if (kind == 0) {
                throw(1, "Protobuf: field '" + fname + "' has no kind");
            }
            let isMap:bool = (kind == Pb.MAP);
            let rep:bool   = (spec.repeated == true);

            if ((kind == Pb.MESSAGE || (isMap && spec.val == Pb.MESSAGE)) && is_nil(spec.msg)) {
                throw(1, "Protobuf: field '" + fname + "' is a message but names no msg class");
            }

            // proto3 packs repeated numeric scalars by default; length-delimited
            // element types can never be packed.
            let wire:int = Pb.WireFor(kind);
            let packable:bool = rep && !isMap && wire != Pb.WIRE_LEN;
            let packed:bool = packable;
            if (spec.packed != nil) { packed = (spec.packed == true) && packable; }

            let oneof = spec.oneof;
            if (!is_nil(oneof)) {
                if (is_nil(oneofs[oneof])) { oneofs[oneof] = []; }
                Array.Append(oneofs[oneof], fname);
            }

            let e = {
                name:    fname,
                num:     num,
                kind:    kind,
                wire:    wire,
                tag:     (num << 3) | wire,
                lenTag:  (num << 3) | Pb.WIRE_LEN,
                rep:     rep,
                isMap:   isMap,
                packed:  packed,
                packable: packable,
                msg:     spec.msg,
                keyKind: spec.key ?? Pb.STRING,
                valKind: spec.val ?? Pb.STRING,
                kTag:    (1 << 3) | Pb.WireFor(spec.key ?? Pb.STRING),
                vTag:    (2 << 3) | Pb.WireFor(spec.val ?? Pb.STRING),
                // Explicit presence: nil means absent and a zero value is still
                // written. Message fields are always explicit.
                explicit: (spec.optional == true) || !is_nil(oneof) || kind == Pb.MESSAGE,
                oneof:   oneof,
                // JSON: the name proto3 canonical JSON uses, and the enum's
                // value names when the field is one. Both are absent from a
                // hand-written descriptor that predates them, and both have
                // legal fallbacks, so neither is required.
                jsonName:   spec.jsonName ?? Pb._JsonCamel(fname),
                enumValues: spec.enumValues,
            };
            Array.Append(fields, e);
            byNum.Set(num, e);
        }

        // True when some field's length cannot be known until its content has
        // been written - a submessage, a map entry or a packed run. _WriteMsg
        // consumes ctx only inside exactly those branches, so when this is false
        // the writing pass needs no sizing pass and no context at all.
        let twoPass:bool = false;
        let k:int = 0;
        while (k < len(fields)) {
            let fe = fields[k];
            k += 1;
            if (fe.isMap || fe.packed || fe.kind == Pb.MESSAGE) { twoPass = true; }
        }

        let byJson = Collections.HashMap();
        var bi:int = 0;
        while (bi < len(fields)) {
            let fe = fields[bi];
            bi += 1;
            byJson.Set(fe.jsonName, fe);
            byJson.Set(fe.name, fe);        // the proto name is accepted too
        }

        let prep = {
            cls:        cls,
            name:       Class.GetName(cls),
            fields:     fields,
            byNum:      byNum,
            oneofs:     oneofs,
            twoPass:    twoPass,
            byJson:     byJson,
            hasUnknown: Pb._HasField(cls, "_unknown"),
            fqName:     is_nil(_pb_fqNames) ? nil : _pb_fqNames.Get(cls),
        };
        cache.Set(cls, prep);
        return prep;
    }

    // proto's field-name -> JSON-name rule: drop underscores, and uppercase a
    // lowercase letter that followed one. Matches protobuf's own JSONCamelCase,
    // including its quirks - "a__b" is "aB", and a letter already uppercase is
    // left alone.
    fn static _JsonCamel(name:string):string {
        var out:string = "";
        var up:bool = false;
        var i:int = 0;
        while (i < len(name)) {
            let c = name[i];                             // a char, not an int
            i += 1;
            if (c == 95) { up = true; continue; }        // '_'
            if (up && c >= 97 && c <= 122) {             // 'a'..'z'
                out = out + Char.FromInt(Convert.ToInt(c) - 32);
            } else {
                out = out + c;
            }
            up = false;
        }
        return out;
    }

    // The prepared descriptor of a message field's type. Deliberately NOT cached
    // on the entry: for a self-recursive message that would make the entry point
    // at the descriptor that owns it, and a reference cycle is never reclaimed.
    // Prepare's own cache already makes this a single hashmap lookup.
    fn static _PrepOf(e) {
        return Pb.Prepare(e.msg);
    }

    fn static _HasField(cls, name:string):bool {
        let probe = Pb._NewMessage(cls);
        let f = Class.Fields(probe);
        let i:int = 0;
        while (i < len(f)) {
            if (f[i] == name) { return true; }
            i += 1;
        }
        return false;
    }

    // A message instance carrying only its declared field defaults. Constructor()
    // is deliberately not run: a decoded message's state comes from the wire, and
    // a constructor that demands arguments must not make a class undecodable.
    fn static _NewMessage(cls) {
        let inst = Class.Instantiate(Class.GetName(cls));
        if (!is_nil(inst) && Class.Of(inst) == cls) { return inst; }
        // The class is not reachable under that global name (imported, or
        // shadowed by another of the same name) - fall back to the constructor.
        inst = Class.New(cls);
        if (is_nil(inst)) {
            throw(1, "Protobuf: cannot instantiate '" + Class.GetName(cls) + "'");
        }
        return inst;
    }

    // -------------------------------------------------------------------------
    // Defaults and sizes
    // -------------------------------------------------------------------------

    fn static _IsDefault(kind:int, v):bool {
        if (is_nil(v)) { return true; }
        if (kind == Pb.STRING) { return len(v) == 0; }
        if (kind == Pb.BYTES)  { return len(v) == 0; }
        if (kind == Pb.BOOL)   { return v == false; }
        if (kind == Pb.MESSAGE) { return false; }
        return v == 0;
    }

    fn static _ZeroFor(kind:int) {
        if (kind == Pb.STRING) { return ""; }
        if (kind == Pb.BYTES)  { return nil; }
        if (kind == Pb.BOOL)   { return false; }
        if (kind == Pb.DOUBLE || kind == Pb.FLOAT) { return 0.0; }
        if (kind == Pb.MESSAGE) { return nil; }
        return 0;
    }

    fn static _SizeVarint(v:int):int {
        if (v < 0)                  { return 10; }
        if (v < 0x80)               { return 1; }
        if (v < 0x4000)             { return 2; }
        if (v < 0x200000)           { return 3; }
        if (v < 0x10000000)         { return 4; }
        if (v < 0x800000000)        { return 5; }
        if (v < 0x40000000000)      { return 6; }
        if (v < 0x2000000000000)    { return 7; }
        if (v < 0x100000000000000)  { return 8; }
        return 9;
    }

    // Payload bytes for one scalar - no tag, no length prefix.
    fn static _SizeScalar(kind:int, v):int {
        if (kind == Pb.BOOL)     { return 1; }
        if (kind == Pb.FLOAT || kind == Pb.FIXED32 || kind == Pb.SFIXED32)  { return 4; }
        if (kind == Pb.DOUBLE || kind == Pb.FIXED64 || kind == Pb.SFIXED64) { return 8; }
        if (kind == Pb.SINT32 || kind == Pb.SINT64) {
            let n:int = v ?? 0;
            return Pb._SizeVarint((n << 1) ^ (n >> 63));
        }
        if (kind == Pb.STRING) {
            let n:int = len(v ?? "");
            return Pb._SizeVarint(n) + n;
        }
        if (kind == Pb.BYTES) {
            let n:int = 0;
            if (!is_nil(v)) { n = len(v); }
            return Pb._SizeVarint(n) + n;
        }
        return Pb._SizeVarint(v ?? 0);
    }

    // -------------------------------------------------------------------------
    // Sizing pass
    //
    // Every length-delimited region needs its byte count before its bytes, so
    // encoding is two passes. The sizing pass appends each computed length to
    // ctx.sizes and each map's key order to ctx.keys; the writing pass walks the
    // message in the identical order and consumes both queues by index. The
    // traversals must therefore stay structurally identical - a branch added to
    // one belongs in the other.
    // -------------------------------------------------------------------------

    fn static _NewCtx() {
        return { sizes: [], idx: 0, keys: [], kidx: 0 };
    }

    fn static _SizeSub(ctx, v, e, depth:int):int {
        let slot:int = len(ctx.sizes);
        Array.Append(ctx.sizes, 0);
        let sub:int = 0;
        if (!is_nil(v)) { sub = Pb._SizeMsg(ctx, v, Pb._PrepOf(e), depth + 1); }
        ctx.sizes[slot] = sub;
        return sub;
    }

    fn static _SizeMsg(ctx, msg, prep, depth:int):int {
        if (depth > Pb.MAX_DEPTH) {
            throw(2, "Protobuf: message nests deeper than " + str(Pb.MAX_DEPTH) + " levels");
        }
        let total:int = 0;
        let fs = prep.fields;
        let i:int = 0;
        while (i < len(fs)) {
            let e = fs[i];
            i += 1;
            let v = Class.GetField(msg, e.name);

            if (e.isMap) {
                if (is_nil(v)) { continue; }
                let keys = Object.Keys(v);
                Array.Append(ctx.keys, keys);
                let kTag:int = Pb._SizeVarint(e.kTag);
                let vTag:int = Pb._SizeVarint(e.vTag);
                let j:int = 0;
                while (j < len(keys)) {
                    let k:string = keys[j];
                    j += 1;
                    let slot:int = len(ctx.sizes);
                    Array.Append(ctx.sizes, 0);
                    let entry:int = kTag + Pb._SizeScalar(e.keyKind, Pb._MapKeyIn(e.keyKind, k)) + vTag;
                    if (e.valKind == Pb.MESSAGE) {
                        let sub:int = Pb._SizeSub(ctx, v[k], e, depth);
                        entry += Pb._SizeVarint(sub) + sub;
                    } else {
                        entry += Pb._SizeScalar(e.valKind, v[k]);
                    }
                    ctx.sizes[slot] = entry;
                    total += Pb._SizeVarint(e.lenTag) + Pb._SizeVarint(entry) + entry;
                }
                continue;
            }

            if (e.rep) {
                if (is_nil(v) || len(v) == 0) { continue; }
                let n:int = len(v);
                if (e.packed) {
                    let slot:int = len(ctx.sizes);
                    Array.Append(ctx.sizes, 0);
                    let payload:int = 0;
                    let j:int = 0;
                    while (j < n) { payload += Pb._SizeScalar(e.kind, v[j]); j += 1; }
                    ctx.sizes[slot] = payload;
                    total += Pb._SizeVarint(e.lenTag) + Pb._SizeVarint(payload) + payload;
                } else {
                    let j:int = 0;
                    while (j < n) {
                        total += Pb._SizeVarint(e.tag);
                        if (e.kind == Pb.MESSAGE) {
                            let sub:int = Pb._SizeSub(ctx, v[j], e, depth);
                            total += Pb._SizeVarint(sub) + sub;
                        } else {
                            total += Pb._SizeScalar(e.kind, v[j]);
                        }
                        j += 1;
                    }
                }
                continue;
            }

            if (is_nil(v)) { continue; }
            if (!e.explicit && Pb._IsDefault(e.kind, v)) { continue; }

            total += Pb._SizeVarint(e.tag);
            if (e.kind == Pb.MESSAGE) {
                let sub:int = Pb._SizeSub(ctx, v, e, depth);
                total += Pb._SizeVarint(sub) + sub;
            } else {
                total += Pb._SizeScalar(e.kind, v);
            }
        }

        if (prep.hasUnknown) {
            let u = Class.GetField(msg, "_unknown");
            if (!is_nil(u)) { total += len(u); }
        }
        return total;
    }

    // -------------------------------------------------------------------------
    // Writing pass - mirrors _SizeMsg step for step
    // -------------------------------------------------------------------------

    fn static _NextSize(ctx):int {
        let s:int = ctx.sizes[ctx.idx];
        ctx.idx += 1;
        return s;
    }

    fn static _WriteScalar(w, kind:int, v) {
        if (kind == Pb.BOOL)     { w.VarInt(v == true ? 1 : 0); return; }
        if (kind == Pb.FLOAT)    { w.Float(float(v ?? 0)); return; }
        if (kind == Pb.DOUBLE)   { w.Double(float(v ?? 0)); return; }
        if (kind == Pb.FIXED32 || kind == Pb.SFIXED32) { w.Fixed32(v ?? 0); return; }
        if (kind == Pb.FIXED64 || kind == Pb.SFIXED64) { w.Fixed64(v ?? 0); return; }
        if (kind == Pb.SINT32 || kind == Pb.SINT64)    { w.ZigZag(v ?? 0); return; }
        if (kind == Pb.STRING)   { w.Str(v ?? ""); return; }
        if (kind == Pb.BYTES)    { w.Bytes(v); return; }
        w.VarInt(v ?? 0);
    }

    fn static _WriteSub(ctx, w, v, e, depth:int) {
        let sub:int = Pb._NextSize(ctx);
        w.VarInt(sub);
        if (sub > 0) { Pb._WriteMsg(ctx, w, v, Pb._PrepOf(e), depth + 1); }
    }

    fn static _WriteMsg(ctx, w, msg, prep, depth:int) {
        let fs = prep.fields;
        let i:int = 0;
        while (i < len(fs)) {
            let e = fs[i];
            i += 1;
            let v = Class.GetField(msg, e.name);

            if (e.isMap) {
                if (is_nil(v)) { continue; }
                let keys = ctx.keys[ctx.kidx];
                ctx.kidx += 1;
                let kTag:int = e.kTag;
                let vTag:int = e.vTag;
                let j:int = 0;
                while (j < len(keys)) {
                    let k:string = keys[j];
                    j += 1;
                    w.VarInt(e.lenTag);
                    w.VarInt(Pb._NextSize(ctx));
                    w.VarInt(kTag);
                    Pb._WriteScalar(w, e.keyKind, Pb._MapKeyIn(e.keyKind, k));
                    w.VarInt(vTag);
                    if (e.valKind == Pb.MESSAGE) { Pb._WriteSub(ctx, w, v[k], e, depth); }
                    else                         { Pb._WriteScalar(w, e.valKind, v[k]); }
                }
                continue;
            }

            if (e.rep) {
                if (is_nil(v) || len(v) == 0) { continue; }
                let n:int = len(v);
                if (e.packed) {
                    w.VarInt(e.lenTag);
                    w.VarInt(Pb._NextSize(ctx));
                    let j:int = 0;
                    while (j < n) { Pb._WriteScalar(w, e.kind, v[j]); j += 1; }
                } else {
                    let j:int = 0;
                    while (j < n) {
                        w.VarInt(e.tag);
                        if (e.kind == Pb.MESSAGE) { Pb._WriteSub(ctx, w, v[j], e, depth); }
                        else                      { Pb._WriteScalar(w, e.kind, v[j]); }
                        j += 1;
                    }
                }
                continue;
            }

            if (is_nil(v)) { continue; }
            if (!e.explicit && Pb._IsDefault(e.kind, v)) { continue; }

            w.VarInt(e.tag);
            if (e.kind == Pb.MESSAGE) { Pb._WriteSub(ctx, w, v, e, depth); }
            else                      { Pb._WriteScalar(w, e.kind, v); }
        }

        if (prep.hasUnknown) {
            let u = Class.GetField(msg, "_unknown");
            if (!is_nil(u)) { w.Raw(u); }
        }
    }

    // -------------------------------------------------------------------------
    // Map keys
    //
    // A Flaris object has string keys, so an integral or bool map key lives in
    // its decimal / "true" / "false" form - the same convention protobuf's
    // canonical JSON mapping uses. These two convert in each direction.
    // -------------------------------------------------------------------------

    fn static _MapKeyIn(kind:int, k:string) {
        if (kind == Pb.STRING) { return k; }
        if (kind == Pb.BOOL)   { return k == "true"; }
        return int(k);
    }

    fn static _MapKeyOut(kind:int, v):string {
        if (kind == Pb.STRING) { return v ?? ""; }
        if (kind == Pb.BOOL)   { return (v == true) ? "true" : "false"; }
        return str(v ?? 0);
    }

    // -------------------------------------------------------------------------
    // Decoding
    // -------------------------------------------------------------------------

    fn static _ReadScalar(r, kind:int) {
        if (kind == Pb.BOOL)     { return r.VarInt() != 0; }
        if (kind == Pb.INT32)    { return i32(r.VarInt()); }
        if (kind == Pb.UINT32)   { return u32(r.VarInt()); }
        if (kind == Pb.SINT32)   { return i32(r.ZigZag()); }
        if (kind == Pb.SINT64)   { return r.ZigZag(); }
        if (kind == Pb.FIXED32)  { return r.Fixed32(); }
        if (kind == Pb.SFIXED32) { return r.SFixed32(); }
        if (kind == Pb.FIXED64 || kind == Pb.SFIXED64) { return r.Fixed64(); }
        if (kind == Pb.FLOAT)    { return r.Float(); }
        if (kind == Pb.DOUBLE)   { return r.Double(); }
        if (kind == Pb.STRING)   { return r.Str(r.VarInt()); }
        if (kind == Pb.BYTES)    { return r.Bytes(r.VarInt()); }
        return r.VarInt();
    }

    fn static _ReadMsg(r, msg, prep, depth:int) {
        if (depth > Pb.MAX_DEPTH) {
            throw(2, "Protobuf: message nests deeper than " + str(Pb.MAX_DEPTH) + " levels");
        }
        let unknown = nil;
        while (!r.AtEnd()) {
            let start:int = r.Position();
            let tag:int   = r.Tag();
            let num:int   = tag >> 3;
            let wire:int  = tag & 7;
            if (num < 1) { throw(2, "Protobuf: field number 0 is not valid"); }
            if (wire == 3 || wire == 4) { throw(2, "Protobuf: groups are not supported"); }

            let e = prep.byNum.Get(num);
            // An unrecognised field, or one whose wire type contradicts the
            // descriptor, is not decodable here - keep the bytes if the message
            // retains unknowns, otherwise step over them.
            if (is_nil(e) || !Pb._WireOk(e, wire)) {
                if (prep.hasUnknown) {
                    if (is_nil(unknown)) { unknown = new PbWriter(32); }
                    unknown.Raw(r.SkipRaw(start, wire));
                } else {
                    r.Skip(wire);
                }
                continue;
            }
            Pb._ReadField(r, msg, prep, e, wire, depth);
        }

        if (!is_nil(unknown) && unknown.Position() > 0) {
            let prev = Class.GetField(msg, "_unknown");
            if (is_nil(prev)) {
                Class.SetField(msg, "_unknown", unknown.ToBuffer());
            } else {
                let m = new PbWriter(len(prev) + unknown.Position());
                m.Raw(prev);
                m.Raw(unknown.ToBuffer());
                Class.SetField(msg, "_unknown", m.ToBuffer());
            }
        }
    }

    // A packable repeated field legitimately arrives either packed (WIRE_LEN) or
    // as one tag per element, so both are accepted for it.
    fn static _WireOk(e, wire:int):bool {
        if (wire == e.wire) { return true; }
        return e.packable && wire == Pb.WIRE_LEN;
    }

    fn static _ReadField(r, msg, prep, e, wire:int, depth:int) {
        if (e.isMap) { Pb._ReadMapEntry(r, msg, e, depth); return; }

        if (e.rep) {
            let arr = Class.GetField(msg, e.name);
            if (is_nil(arr)) { arr = []; Class.SetField(msg, e.name, arr); }
            if (e.kind == Pb.MESSAGE) {
                Array.Append(arr, Pb._ReadSub(r, nil, e, depth));
                return;
            }
            if (e.packable && wire == Pb.WIRE_LEN) {
                let n:int = r.VarInt();
                let prevLimit:int = r.PushLimit(n);
                while (!r.AtEnd()) { Array.Append(arr, Pb._ReadScalar(r, e.kind)); }
                r.PopLimit(prevLimit);
            } else {
                Array.Append(arr, Pb._ReadScalar(r, e.kind));
            }
            return;
        }

        if (e.kind == Pb.MESSAGE) {
            // Repeated occurrences of a singular message field merge, per spec.
            let cur = Class.GetField(msg, e.name);
            if (!is_nil(cur) && Class.Of(cur) != e.msg) { cur = nil; }
            Class.SetField(msg, e.name, Pb._ReadSub(r, cur, e, depth));
        } else {
            Class.SetField(msg, e.name, Pb._ReadScalar(r, e.kind));
        }

        if (!is_nil(e.oneof)) { Pb._ClearSiblings(msg, prep, e); }
    }

    // Read one length-delimited submessage into `into` (or a fresh instance).
    fn static _ReadSub(r, into, e, depth:int) {
        let n:int = r.VarInt();
        let prevLimit:int = r.PushLimit(n);
        let m = into;
        if (is_nil(m)) { m = Pb._NewMessage(e.msg); }
        Pb._ReadMsg(r, m, Pb._PrepOf(e), depth + 1);
        r.PopLimit(prevLimit);
        return m;
    }

    fn static _ReadMapEntry(r, msg, e, depth:int) {
        let n:int = r.VarInt();
        let prevLimit:int = r.PushLimit(n);

        // An entry may omit a default key or value; the spec has the reader
        // supply the zero value in that case.
        let k = Pb._ZeroFor(e.keyKind);
        let v = Pb._ZeroFor(e.valKind);
        while (!r.AtEnd()) {
            let tag:int  = r.Tag();
            let num:int  = tag >> 3;
            let wire:int = tag & 7;
            if (num == 1 && wire == (e.kTag & 7)) {
                k = Pb._ReadScalar(r, e.keyKind);
            } else if (num == 2 && wire == (e.vTag & 7)) {
                if (e.valKind == Pb.MESSAGE) { v = Pb._ReadSub(r, nil, e, depth); }
                else                         { v = Pb._ReadScalar(r, e.valKind); }
            } else {
                r.Skip(wire);
            }
        }
        r.PopLimit(prevLimit);

        let m = Class.GetField(msg, e.name);
        if (is_nil(m)) { m = {}; Class.SetField(msg, e.name, m); }
        m[Pb._MapKeyOut(e.keyKind, k)] = v;
    }

    fn static _ClearSiblings(msg, prep, e) {
        let group = prep.oneofs[e.oneof];
        if (is_nil(group)) { return; }
        let i:int = 0;
        while (i < len(group)) {
            if (group[i] != e.name) { Class.SetField(msg, group[i], nil); }
            i += 1;
        }
    }

    // -------------------------------------------------------------------------
    // .proto schemas at runtime
    //
    // A .proto file is DATA. Parsing it and defining classes from it needs no
    // compiler, so this works on a runtime-only build: ship the .proto next to
    // the signed bytecode and load it there.
    // -------------------------------------------------------------------------

    fn static _ScalarKinds() {
        if (is_nil(_pb_scalarKinds)) {
            _pb_scalarKinds = {
                double:   Pb.DOUBLE,   float:    Pb.FLOAT,
                int32:    Pb.INT32,    int64:    Pb.INT64,
                uint32:   Pb.UINT32,   uint64:   Pb.UINT64,
                sint32:   Pb.SINT32,   sint64:   Pb.SINT64,
                fixed32:  Pb.FIXED32,  fixed64:  Pb.FIXED64,
                sfixed32: Pb.SFIXED32, sfixed64: Pb.SFIXED64,
                bool:     Pb.BOOL,     string:   Pb.STRING, bytes: Pb.BYTES,
            };
        }
        return _pb_scalarKinds;
    }

    // Parse one .proto file's text into a plain-data schema. Inspect it with
    // Json.Stringify, or hand it to DefineSchema.
    fn static ParseProto(source:string, name:string|nil) {
        let p = new ProtoParser(source, name);
        return p.ParseFile();
    }

    // Parse a .proto and every file it imports. `includes` lists the directories
    // searched; the file's own directory is always searched last. Imported
    // schemas land in `schema.deps`.
    fn static ParseProtoFile(path:string, includes:array|nil) {
        let inc:array = includes ?? [Path.GetDirectoryName(path)];
        let seen = {};
        let root = Pb._ReadProto(path, seen);
        let queue:array = [root];
        let deps:array  = [];

        let qi:int = 0;
        while (qi < len(queue)) {
            let cur = queue[qi];
            qi += 1;
            let i:int = 0;
            while (i < len(cur.imports)) {
                let imp = cur.imports[i];
                i += 1;
                let resolved = Pb._FindProto(imp.path, inc, cur.file);
                if (is_nil(resolved)) {
                    throw(1, cur.file + ": cannot find imported file '" + imp.path + "'");
                }
                imp.resolved = resolved;
                if (seen[resolved] == true) { continue; }
                let sub = Pb._ReadProto(resolved, seen);
                Array.Append(queue, sub);
                Array.Append(deps, sub);
            }
        }
        // deps holds imports only - never root, which would make the schema
        // self-referential and leak.
        root.deps = deps;
        return root;
    }

    fn static _ReadProto(path:string, seen:object) {
        seen[path] = true;
        let wk = Pb._WellKnown(path);
        if (!is_nil(wk)) { return Pb.ParseProto(wk, path); }
        if (!File.Exists(path)) { throw(1, "Protobuf: no such .proto file '" + path + "'"); }
        let text = File.ReadText(path);
        if (is_nil(text)) { throw(1, "Protobuf: cannot read '" + path + "'"); }
        return Pb.ParseProto(text, path);
    }

    // A copy on the include path wins over the built-in one, so a project that
    // vendors its own google/protobuf tree keeps using it.
    fn static _FindProto(rel:string, includes:array, fromPath:string) {
        let i:int = 0;
        while (i < len(includes)) {
            let cand:string = Path.Combine(includes[i], rel);
            if (File.Exists(cand)) { return cand; }
            i += 1;
        }
        let sibling:string = Path.Combine(Path.GetDirectoryName(fromPath), rel);
        if (File.Exists(sibling)) { return sibling; }
        if (!is_nil(Pb._WellKnown(rel))) { return rel; }
        Pb._RejectProto2Import(rel);
        return nil;
    }

    // The one standard import deliberately not built in, and the reason is worth
    // saying: "file not found" would send the reader looking for a file that was
    // never going to help.
    fn static _RejectProto2Import(rel:string) {
        if (rel == "google/protobuf/descriptor.proto") {
            throw(1, "Protobuf: google/protobuf/descriptor.proto is proto2, which "
                   + "this parser does not read; supply your own copy on the "
                   + "include path if you need it");
        }
    }

    // The built-in source for a `google/protobuf/*.proto` import, or nil if the
    // path is not one of them.
    fn static _WellKnown(path:string) {
        return Pb._WellKnownSources()[path];
    }

    // The ten standard google/protobuf schemas, verbatim in package, message,
    // field name, number and type - the wire contract. Comments and file-level
    // options are stripped: neither reaches the wire, and they would be four
    // times the size of the declarations. descriptor.proto is deliberately
    // absent - it is proto2, which this parser rejects on purpose.
    fn static _WellKnownSources() {
        if (!is_nil(_pb_wellKnown)) { return _pb_wellKnown; }
        _pb_wellKnown = {
            "google/protobuf/any.proto":
                "syntax = \"proto3\";\n"
                  + "package google.protobuf;\n"
                  + "message Any {\n"
                  + "string type_url = 1;\n"
                  + "bytes value = 2;\n"
                  + "}\n",
            "google/protobuf/api.proto":
                "syntax = \"proto3\";\n"
                  + "package google.protobuf;\n"
                  + "import \"google/protobuf/source_context.proto\";\n"
                  + "import \"google/protobuf/type.proto\";\n"
                  + "message Api {\n"
                  + "string name = 1;\n"
                  + "repeated Method methods = 2;\n"
                  + "repeated Option options = 3;\n"
                  + "string version = 4;\n"
                  + "SourceContext source_context = 5;\n"
                  + "repeated Mixin mixins = 6;\n"
                  + "Syntax syntax = 7;\n"
                  + "}\n"
                  + "message Method {\n"
                  + "string name = 1;\n"
                  + "string request_type_url = 2;\n"
                  + "bool request_streaming = 3;\n"
                  + "string response_type_url = 4;\n"
                  + "bool response_streaming = 5;\n"
                  + "repeated Option options = 6;\n"
                  + "Syntax syntax = 7;\n"
                  + "}\n"
                  + "message Mixin {\n"
                  + "string name = 1;\n"
                  + "string root = 2;\n"
                  + "}\n",
            "google/protobuf/duration.proto":
                "syntax = \"proto3\";\n"
                  + "package google.protobuf;\n"
                  + "message Duration {\n"
                  + "int64 seconds = 1;\n"
                  + "int32 nanos = 2;\n"
                  + "}\n",
            "google/protobuf/empty.proto":
                "syntax = \"proto3\";\n"
                  + "package google.protobuf;\n"
                  + "message Empty {}\n",
            "google/protobuf/field_mask.proto":
                "syntax = \"proto3\";\n"
                  + "package google.protobuf;\n"
                  + "message FieldMask {\n"
                  + "repeated string paths = 1;\n"
                  + "}\n",
            "google/protobuf/source_context.proto":
                "syntax = \"proto3\";\n"
                  + "package google.protobuf;\n"
                  + "message SourceContext {\n"
                  + "string file_name = 1;\n"
                  + "}\n",
            "google/protobuf/struct.proto":
                "syntax = \"proto3\";\n"
                  + "package google.protobuf;\n"
                  + "message Struct {\n"
                  + "map<string, Value> fields = 1;\n"
                  + "}\n"
                  + "message Value {\n"
                  + "oneof kind {\n"
                  + "NullValue null_value = 1;\n"
                  + "double number_value = 2;\n"
                  + "string string_value = 3;\n"
                  + "bool bool_value = 4;\n"
                  + "Struct struct_value = 5;\n"
                  + "ListValue list_value = 6;\n"
                  + "}\n"
                  + "}\n"
                  + "enum NullValue {\n"
                  + "NULL_VALUE = 0;\n"
                  + "}\n"
                  + "message ListValue {\n"
                  + "repeated Value values = 1;\n"
                  + "}\n",
            "google/protobuf/timestamp.proto":
                "syntax = \"proto3\";\n"
                  + "package google.protobuf;\n"
                  + "message Timestamp {\n"
                  + "int64 seconds = 1;\n"
                  + "int32 nanos = 2;\n"
                  + "}\n",
            "google/protobuf/type.proto":
                "syntax = \"proto3\";\n"
                  + "package google.protobuf;\n"
                  + "import \"google/protobuf/any.proto\";\n"
                  + "import \"google/protobuf/source_context.proto\";\n"
                  + "message Type {\n"
                  + "string name = 1;\n"
                  + "repeated Field fields = 2;\n"
                  + "repeated string oneofs = 3;\n"
                  + "repeated Option options = 4;\n"
                  + "SourceContext source_context = 5;\n"
                  + "Syntax syntax = 6;\n"
                  + "string edition = 7;\n"
                  + "}\n"
                  + "message Field {\n"
                  + "enum Kind {\n"
                  + "TYPE_UNKNOWN = 0;\n"
                  + "TYPE_DOUBLE = 1;\n"
                  + "TYPE_FLOAT = 2;\n"
                  + "TYPE_INT64 = 3;\n"
                  + "TYPE_UINT64 = 4;\n"
                  + "TYPE_INT32 = 5;\n"
                  + "TYPE_FIXED64 = 6;\n"
                  + "TYPE_FIXED32 = 7;\n"
                  + "TYPE_BOOL = 8;\n"
                  + "TYPE_STRING = 9;\n"
                  + "TYPE_GROUP = 10;\n"
                  + "TYPE_MESSAGE = 11;\n"
                  + "TYPE_BYTES = 12;\n"
                  + "TYPE_UINT32 = 13;\n"
                  + "TYPE_ENUM = 14;\n"
                  + "TYPE_SFIXED32 = 15;\n"
                  + "TYPE_SFIXED64 = 16;\n"
                  + "TYPE_SINT32 = 17;\n"
                  + "TYPE_SINT64 = 18;\n"
                  + "}\n"
                  + "enum Cardinality {\n"
                  + "CARDINALITY_UNKNOWN = 0;\n"
                  + "CARDINALITY_OPTIONAL = 1;\n"
                  + "CARDINALITY_REQUIRED = 2;\n"
                  + "CARDINALITY_REPEATED = 3;\n"
                  + "}\n"
                  + "Kind kind = 1;\n"
                  + "Cardinality cardinality = 2;\n"
                  + "int32 number = 3;\n"
                  + "string name = 4;\n"
                  + "string type_url = 6;\n"
                  + "int32 oneof_index = 7;\n"
                  + "bool packed = 8;\n"
                  + "repeated Option options = 9;\n"
                  + "string json_name = 10;\n"
                  + "string default_value = 11;\n"
                  + "}\n"
                  + "message Enum {\n"
                  + "string name = 1;\n"
                  + "repeated EnumValue enumvalue = 2;\n"
                  + "repeated Option options = 3;\n"
                  + "SourceContext source_context = 4;\n"
                  + "Syntax syntax = 5;\n"
                  + "string edition = 6;\n"
                  + "}\n"
                  + "message EnumValue {\n"
                  + "string name = 1;\n"
                  + "int32 number = 2;\n"
                  + "repeated Option options = 3;\n"
                  + "}\n"
                  + "message Option {\n"
                  + "string name = 1;\n"
                  + "Any value = 2;\n"
                  + "}\n"
                  + "enum Syntax {\n"
                  + "SYNTAX_PROTO2 = 0;\n"
                  + "SYNTAX_PROTO3 = 1;\n"
                  + "SYNTAX_EDITIONS = 2;\n"
                  + "}\n",
            "google/protobuf/wrappers.proto":
                "syntax = \"proto3\";\n"
                  + "package google.protobuf;\n"
                  + "message DoubleValue {\n"
                  + "double value = 1;\n"
                  + "}\n"
                  + "message FloatValue {\n"
                  + "float value = 1;\n"
                  + "}\n"
                  + "message Int64Value {\n"
                  + "int64 value = 1;\n"
                  + "}\n"
                  + "message UInt64Value {\n"
                  + "uint64 value = 1;\n"
                  + "}\n"
                  + "message Int32Value {\n"
                  + "int32 value = 1;\n"
                  + "}\n"
                  + "message UInt32Value {\n"
                  + "uint32 value = 1;\n"
                  + "}\n"
                  + "message BoolValue {\n"
                  + "bool value = 1;\n"
                  + "}\n"
                  + "message StringValue {\n"
                  + "string value = 1;\n"
                  + "}\n"
                  + "message BytesValue {\n"
                  + "bytes value = 1;\n"
                  + "}\n",
        };
        return _pb_wellKnown;
    }


    // Build a class for every message in `schema` (and its imports) and register
    // each one's descriptor. Returns a map of name -> class; an enum maps to a
    // plain object of its values, so `types["Status"].ACTIVE` reads the way a
    // Flaris enum would.
    //
    // Nested types flatten - `Outer.Inner` becomes `Outer_Inner` - because a
    // Flaris class cannot nest. Classes are created first and descriptors
    // registered second, so a message may reference one declared later, or
    // itself.
    fn static DefineSchema(schema) {
        let files:array = [schema];
        let deps:array  = schema.deps ?? [];
        let di:int = 0;
        while (di < len(deps)) { Array.Append(files, deps[di]); di += 1; }

        let types = {};
        let order:array = [];
        let fi:int = 0;
        while (fi < len(files)) {
            let f = files[fi];
            fi += 1;
            let pkg:string = f.package ?? "";
            let mi:int = 0;
            while (mi < len(f.messages)) { Pb._CollectMsg(f.messages[mi], types, order, pkg); mi += 1; }
            let ei:int = 0;
            while (ei < len(f.enums)) { Pb._CollectEnum(f.enums[ei], types, order, pkg); ei += 1; }
        }

        // Pass 1: a class per message, an object per enum.
        let out = {};
        let i:int = 0;
        while (i < len(order)) {
            let t = order[i];
            i += 1;
            if (t.kind == "enum") {
                let vals = {};
                let vi:int = 0;
                while (vi < len(t.node.values)) {
                    vals[t.node.values[vi].name] = t.node.values[vi].num;
                    vi += 1;
                }
                t.value = vals;
            } else {
                t.value = Class.Define(t.flat, Pb._FieldDefaults(t, types));
            }
            // Two packages may flatten to the same short name - a schema of its
            // own `Value` alongside google.protobuf.Value, say. The short key
            // goes to whoever claims it first, and `order` puts the root file's
            // types before its imports', so the root file wins. The qualified
            // name always resolves, so nothing becomes unreachable.
            if (is_nil(out[t.flat])) { out[t.flat] = t.value; }
            if (t.fqName != t.flat)  { out[t.fqName] = t.value; }
        }

        // Pass 2: descriptors, now that every class exists.
        i = 0;
        while (i < len(order)) {
            let t = order[i];
            i += 1;
            if (t.kind == "enum") { continue; }
            Pb.Register(t.value, Pb._SpecFor(t, types), t.fqName);
        }

        // Pass 3: services, whose methods point at the classes just built.
        fi = 0;
        while (fi < len(files)) {
            let f = files[fi];
            fi += 1;
            let pkg:string = f.package ?? "";
            let si:int = 0;
            while (si < len(f.services)) {
                let s = f.services[si];
                si += 1;
                if (!is_nil(types[s.fqName])) {
                    throw(1, "Protobuf: '" + s.fqName + "' collides with another "
                           + "type of the same name");
                }
                let svc = Pb._DefineService(s, types, pkg);
                if (is_nil(out[s.name])) { out[s.name] = svc; }
                if (s.fqName != s.name)  { out[s.fqName] = svc; }
            }
        }
        return out;
    }

    // One service as a plain object: methods by name, plus `order` to walk them
    // as declared. A method names its service rather than holding it - the
    // back-reference would close a cycle, and cycles are never reclaimed.
    fn static _DefineService(s, types, pkg:string) {
        let methods = {};
        let order:array = [];
        let i:int = 0;
        while (i < len(s.methods)) {
            let m = s.methods[i];
            i += 1;
            if (!is_nil(methods[m.name])) {
                throw(1, "Protobuf: rpc '" + m.name + "' is declared twice in "
                       + "service '" + s.fqName + "'");
            }
            methods[m.name] = {
                name:         m.name,
                service:      s.name,
                fqName:       s.fqName + "." + m.name,
                // The RPC path gRPC and Connect both address a method by.
                path:         "/" + s.fqName + "/" + m.name,
                input:        Pb._ResolveMsg(types, m.input,  pkg, s.fqName, m.name),
                output:       Pb._ResolveMsg(types, m.output, pkg, s.fqName, m.name),
                clientStream: m.clientStream,
                serverStream: m.serverStream,
            };
            Array.Append(order, m.name);
        }
        return {
            kind:    "service",
            name:    s.name,
            fqName:  s.fqName,
            methods: methods,
            order:   order,
        };
    }

    // The class an rpc's input/output names. Only a message is legal there.
    fn static _ResolveMsg(types, ref:string, scope:string, svc:string, method:string) {
        let t = Pb._ResolveType(types, ref, scope);
        if (is_nil(t)) {
            throw(1, "Protobuf: rpc " + svc + "." + method
                   + " names unknown type '" + ref + "'");
        }
        if (t.kind != "message") {
            throw(1, "Protobuf: rpc " + svc + "." + method + " names '" + ref
                   + "', which is an enum; an rpc takes and returns messages");
        }
        return t.value;
    }

    // ParseProto + DefineSchema. There is no file to resolve imports against,
    // so only the built-in google/protobuf ones are followed; any other import
    // is left alone and its types simply stay unknown. Use LoadProtoFile when
    // the schema imports a file of your own.
    fn static LoadProto(source:string, name:string|nil) {
        let root = Pb.ParseProto(source, name);
        root.deps = Pb._WellKnownDeps(root);
        return Pb.DefineSchema(root);
    }

    // Every built-in schema reachable from `root`, transitively, parsed once
    // each. Nothing points back at root, so the schema stays acyclic.
    fn static _WellKnownDeps(root) {
        let deps:array  = [];
        let seen        = {};
        let queue:array = [root];
        let qi:int = 0;
        while (qi < len(queue)) {
            let cur = queue[qi];
            qi += 1;
            let i:int = 0;
            while (i < len(cur.imports)) {
                let path:string = cur.imports[i].path;
                i += 1;
                if (seen[path] == true) { continue; }
                let src = Pb._WellKnown(path);
                if (is_nil(src)) { Pb._RejectProto2Import(path); continue; }
                seen[path] = true;
                cur.imports[i - 1].resolved = path;
                let sub = Pb.ParseProto(src, path);
                Array.Append(queue, sub);
                Array.Append(deps, sub);
            }
        }
        return deps;
    }

    // ParseProtoFile + DefineSchema.
    fn static LoadProtoFile(path:string, includes:array|nil) {
        return Pb.DefineSchema(Pb.ParseProtoFile(path, includes));
    }

    fn static _CollectMsg(m, types, order:array, pkg:string) {
        Pb._AddType(types, order, { kind: "message", node: m, fqName: m.fqName, pkg: pkg });
        let i:int = 0;
        while (i < len(m.nested)) { Pb._CollectMsg(m.nested[i], types, order, pkg); i += 1; }
        let j:int = 0;
        while (j < len(m.enums)) { Pb._CollectEnum(m.enums[j], types, order, pkg); j += 1; }
    }

    fn static _CollectEnum(e, types, order:array, pkg:string) {
        Pb._AddType(types, order, { kind: "enum", node: e, fqName: e.fqName, pkg: pkg });
    }

    fn static _AddType(types, order:array, t) {
        if (!is_nil(types[t.fqName])) {
            throw(1, "Protobuf: '" + t.fqName + "' is declared twice");
        }
        // Strip the package, then flatten the nesting: Outer.Inner -> Outer_Inner.
        let n:string = t.fqName;
        if (t.pkg != "" && String.StartsWith(n, t.pkg + ".")) {
            n = String.Substr(n, len(t.pkg) + 1, len(n) - len(t.pkg) - 1);
        }
        t.flat = String.Replace(n, ".", "_");
        t.value = nil;
        types[t.fqName] = t;
        Array.Append(order, t);
    }

    // proto's relative scoping: innermost enclosing scope outwards. A leading
    // '.' means the reference is already fully qualified.
    fn static _ResolveType(types, ref:string, scope:string) {
        if (String.StartsWith(ref, ".")) {
            return types[String.Substr(ref, 1, len(ref) - 1)];
        }
        let cur:string = scope;
        while (true) {
            let cand:string = (cur == "") ? ref : (cur + "." + ref);
            let hit = types[cand];
            if (!is_nil(hit)) { return hit; }
            if (cur == "") { break; }
            let dot:int = String.LastIndexOf(cur, ".");
            if (dot < 0) { cur = ""; } else { cur = String.Substr(cur, 0, dot); }
        }
        return nil;
    }

    // A field's kind, plus the type entry when it names a message or enum.
    fn static _KindOfField(t, f, types, typeName:string) {
        let direct = Pb._ScalarKinds()[typeName];
        if (!is_nil(direct)) { return { kind: direct, ref: nil }; }
        let hit = Pb._ResolveType(types, typeName, t.fqName);
        if (is_nil(hit)) {
            throw(1, "Protobuf: " + t.fqName + "." + f.name
                   + " refers to unknown type '" + typeName + "'");
        }
        if (hit.kind == "enum") { return { kind: Pb.ENUM, ref: hit }; }
        return { kind: Pb.MESSAGE, ref: hit };
    }

    fn static _FieldDefaults(t, types) {
        let fields = {};
        let fs:array = t.node.fields;
        let i:int = 0;
        while (i < len(fs)) {
            let f = fs[i];
            i += 1;
            if (f.label == "repeated" || f.label == "map"
                || f.label == "optional" || !is_nil(f.oneof)) {
                fields[f.name] = nil;
                continue;
            }
            let info = Pb._KindOfField(t, f, types, f.typeName);
            if (info.kind == Pb.MESSAGE)   { fields[f.name] = nil; }
            else if (info.kind == Pb.ENUM) { fields[f.name] = 0; }
            else                            { fields[f.name] = Pb._ZeroFor(info.kind); }
        }
        // Retain fields this schema does not describe, so a partial view of a
        // message still re-encodes losslessly.
        fields["_unknown"] = nil;
        return fields;
    }

    fn static _SpecFor(t, types) {
        let spec = {};
        let seenNum = {};
        let fs:array = t.node.fields;
        let i:int = 0;
        while (i < len(fs)) {
            let f = fs[i];
            i += 1;
            if (f.num < 1 || f.num > Pb.MAX_FIELD_NUM) {
                throw(1, "Protobuf: " + t.fqName + "." + f.name
                       + " has field number " + str(f.num) + ", outside 1..536870911");
            }
            if (seenNum[str(f.num)] == true) {
                throw(1, "Protobuf: " + t.fqName + " uses field number "
                       + str(f.num) + " twice");
            }
            seenNum[str(f.num)] = true;

            let e = { num: f.num };
            if (f.label == "map") {
                let keyKind = Pb._ScalarKinds()[f.keyType];
                if (is_nil(keyKind) || keyKind == Pb.DOUBLE || keyKind == Pb.FLOAT
                    || keyKind == Pb.BYTES) {
                    throw(1, "Protobuf: " + t.fqName + "." + f.name
                           + " has map key type '" + f.keyType
                           + "'; protobuf allows only integral, bool and string keys");
                }
                let vi = Pb._KindOfField(t, f, types, f.valType);
                e.kind = Pb.MAP;
                e.key  = keyKind;
                e.val  = vi.kind;
                if (vi.kind == Pb.MESSAGE) { e.msg = vi.ref.value; }
                if (vi.kind == Pb.ENUM)    { e.enumValues = vi.ref.value; }
            } else {
                let info = Pb._KindOfField(t, f, types, f.typeName);
                e.kind = info.kind;
                if (info.kind == Pb.MESSAGE) { e.msg = info.ref.value; }
                // The value names, for JSON: proto3 JSON writes an enum by name.
                // A hand-written descriptor may omit this and still encode - JSON
                // then falls back to the number, which is also legal.
                if (info.kind == Pb.ENUM) { e.enumValues = info.ref.value; }
                if (f.label == "repeated") {
                    e.repeated = true;
                    if (f.opts.packed == false) { e.packed = false; }
                } else if (!is_nil(f.oneof)) {
                    e.oneof = f.oneof;
                } else if (f.label == "optional") {
                    e.optional = true;
                }
            }
            spec[f.name] = e;
        }
        return spec;
    }

    // -------------------------------------------------------------------------
    // Public API
    // -------------------------------------------------------------------------

    // Wire bytes for `msg`. The buffer is sized exactly by the sizing pass, so
    // encoding never reallocates.
    // The parsed form of a well-known type, or nil when `cls` is not one.
    fn static _JsonReadWellKnown(jv, cls, prep, o, depth:int) {
        let n:string = prep.fqName;
        if (!String.StartsWith(n, "google.protobuf.")) { return nil; }
        let t:string = String.Substr(n, 16, len(n) - 16);

        if (t == "Timestamp" || t == "Duration") {
            let msg = Pb._NewMessage(cls);
            let parts = (t == "Timestamp") ? Pb._ParseTimestamp(Convert.ToString(jv))
                                           : Pb._ParseDuration(Convert.ToString(jv));
            Class.SetField(msg, "seconds", parts.seconds);
            Class.SetField(msg, "nanos",   parts.nanos);
            return msg;
        }
        if (t == "Empty") { return Pb._NewMessage(cls); }
        if (t == "FieldMask") {
            let msg = Pb._NewMessage(cls);
            let raw:string = Convert.ToString(jv);
            let paths:array = [];
            if (raw != "") {
                let segs:array = String.Split(raw, ",");
                var i:int = 0;
                while (i < len(segs)) {
                    // JSON carries camelCase paths; the message stores proto ones.
                    let dotted:array = String.Split(segs[i], ".");
                    var outSeg:array = [];
                    var j:int = 0;
                    while (j < len(dotted)) {
                        Array.Append(outSeg, Pb._JsonSnake(dotted[j]));
                        j += 1;
                    }
                    Array.Append(paths, String.Join(outSeg, "."));
                    i += 1;
                }
            }
            Class.SetField(msg, "paths", paths);
            return msg;
        }
        // Struct, Value and ListValue refer to each other. Resolve those through
        // this message's own descriptor, never through the global name table:
        // two loaded schemas each define a google.protobuf.Value, and the table
        // holds only the one registered last.
        if (t == "Struct") {
            let msg = Pb._NewMessage(cls);
            let fields = {};
            let vcls = prep.byNum.Get(1).msg;
            foreach (v, k in jv) { fields[k] = Pb._JsonRead(v, vcls, o, depth + 1); }
            Class.SetField(msg, "fields", fields);
            return msg;
        }
        if (t == "ListValue") {
            let msg = Pb._NewMessage(cls);
            let vcls = prep.byNum.Get(1).msg;
            let arr:array = [];
            var i:int = 0;
            while (i < len(jv)) {
                Array.Append(arr, Pb._JsonRead(jv[i], vcls, o, depth + 1));
                i += 1;
            }
            Class.SetField(msg, "values", arr);
            return msg;
        }
        if (t == "Value") {
            let msg = Pb._NewMessage(cls);
            if (is_nil(jv))                     { Class.SetField(msg, "null_value", 0); }
            else if (jv == true || jv == false) { Class.SetField(msg, "bool_value", jv); }
            else if (Type.Is(jv, Type.String))  { Class.SetField(msg, "string_value", jv); }
            else if (is_array(jv)) {
                Class.SetField(msg, "list_value",
                    Pb._JsonRead(jv, prep.byNum.Get(6).msg, o, depth + 1));
            } else if (is_object(jv)) {
                Class.SetField(msg, "struct_value",
                    Pb._JsonRead(jv, prep.byNum.Get(5).msg, o, depth + 1));
            } else {
                Class.SetField(msg, "number_value", float(jv));
            }
            return msg;
        }
        if (t == "Any") {
            if (!is_object(jv) || is_nil(jv["@type"])) {
                throw(1, "Pb.FromJson: an Any needs an \"@type\" member");
            }
            let url:string = Convert.ToString(jv["@type"]);
            let slash:int  = String.LastIndexOf(url, "/");
            let tname:string = (slash < 0) ? url
                             : String.Substr(url, slash + 1, len(url) - slash - 1);
            let icls = Pb.ClassFor(tname);
            if (is_nil(icls)) {
                throw(1, "Pb.FromJson: Any names '" + tname + "', which no loaded "
                       + "schema defines");
            }
            let iprep = Pb.Prepare(icls);
            var inner = nil;
            if (!is_nil(jv["value"]) && !is_nil(iprep.fqName)
                && String.StartsWith(iprep.fqName, "google.protobuf.")) {
                inner = Pb._JsonRead(jv["value"], icls, o, depth + 1);
            } else {
                let body = {};
                foreach (v, k in jv) { if (k != "@type") { body[k] = v; } }
                inner = Pb._JsonRead(body, icls, o, depth + 1);
            }
            let msg = Pb._NewMessage(cls);
            Class.SetField(msg, "type_url", url);
            Class.SetField(msg, "value", Pb.Encode(inner));
            return msg;
        }
        if (t == "DoubleValue" || t == "FloatValue" || t == "Int64Value"
            || t == "UInt64Value" || t == "Int32Value" || t == "UInt32Value"
            || t == "BoolValue" || t == "StringValue" || t == "BytesValue") {
            let msg = Pb._NewMessage(cls);
            let e = prep.byNum.Get(1);
            Class.SetField(msg, "value", Pb._JsonValue(jv, e.kind, e, o, depth));
            return msg;
        }
        return nil;
    }

    // "2025-01-01T00:00:00.250Z" -> { seconds, nanos }. An explicit +hh:mm or
    // -hh:mm offset is accepted and folded into the seconds, as the spec asks.
    fn static _ParseTimestamp(sIn:string) {
        var s:string = sIn;
        var offset:int = 0;
        if (String.EndsWith(s, "Z") || String.EndsWith(s, "z")) {
            s = String.Substr(s, 0, len(s) - 1);
        } else {
            let plus:int = String.LastIndexOf(s, "+");
            var minus:int = String.LastIndexOf(s, "-");
            if (minus < 10) { minus = -1; }          // the date's own hyphens
            let at:int = (plus > minus) ? plus : minus;
            if (at > 0) {
                let tz:string = String.Substr(s, at + 1, len(s) - at - 1);
                let hh:int = Convert.ParseInt(String.Substr(tz, 0, 2)) ?? 0;
                let mm:int = Convert.ParseInt(String.Substr(tz, 3, 2)) ?? 0;
                offset = hh * 3600 + mm * 60;
                if (String.Substr(s, at, 1) == "+") { offset = -offset; }
                s = String.Substr(s, 0, at);
            }
        }
        var nanos:int = 0;
        let dot:int = String.IndexOf(s, ".");
        if (dot >= 0) {
            nanos = Pb._FracNanos(String.Substr(s, dot + 1, len(s) - dot - 1));
            s = String.Substr(s, 0, dot);
        }
        let secs = Time.Parse(s, "ISO");
        if (is_nil(secs)) {
            throw(1, "Pb.FromJson: '" + sIn + "' is not an RFC 3339 timestamp");
        }
        return { seconds: secs + offset, nanos: nanos };
    }

    // "-3.000000500s" -> { seconds, nanos }, both carrying the sign.
    fn static _ParseDuration(sIn:string) {
        if (!String.EndsWith(sIn, "s")) {
            throw(1, "Pb.FromJson: a Duration must end in 's', got '" + sIn + "'");
        }
        var s:string = String.Substr(sIn, 0, len(sIn) - 1);
        var neg:bool = false;
        if (String.StartsWith(s, "-")) { neg = true; s = String.Substr(s, 1, len(s) - 1); }
        var nanos:int = 0;
        let dot:int = String.IndexOf(s, ".");
        if (dot >= 0) {
            nanos = Pb._FracNanos(String.Substr(s, dot + 1, len(s) - dot - 1));
            s = String.Substr(s, 0, dot);
        }
        let secs = Convert.ParseInt(s == "" ? "0" : s);
        if (is_nil(secs)) {
            throw(1, "Pb.FromJson: '" + sIn + "' is not a Duration");
        }
        if (neg) { return { seconds: -secs, nanos: -nanos }; }
        return { seconds: secs, nanos: nanos };
    }

    // A fractional-second string, right-padded to nanosecond precision.
    fn static _FracNanos(frac:string):int {
        var d:string = frac;
        while (len(d) < 9) { d = d + "0"; }
        if (len(d) > 9) { d = String.Substr(d, 0, 9); }
        return Convert.ParseInt(d) ?? 0;
    }

    // The inverse of _JsonCamel, for a FieldMask path coming back from JSON.
    fn static _JsonSnake(name:string):string {
        var out:string = "";
        var i:int = 0;
        while (i < len(name)) {
            let c = name[i];
            i += 1;
            if (c >= 65 && c <= 90) { out = out + "_" + Char.FromInt(Convert.ToInt(c) + 32); }
            else                    { out = out + c; }
        }
        return out;
    }

    // Canonical proto3 JSON -> a message of `cls`. Accepts either spelling of a
    // field name, an enum as its name or its number, and a 64-bit integer as a
    // string or a number - all of which the specification requires a parser to
    // take, even though a writer only ever emits one of each.
    fn static FromJson(text:string, cls, opts?) {
        let v = Json.Parse(text);
        if (is_nil(v)) { throw(1, "Pb.FromJson: not valid JSON"); }
        return Pb._JsonRead(v, cls, Pb._JsonOpts(opts), 0);
    }

    fn static _JsonRead(jv, cls, o, depth:int) {
        if (depth > Pb.MAX_DEPTH) {
            throw(2, "Pb.FromJson: nesting deeper than " + str(Pb.MAX_DEPTH) + " levels");
        }
        let prep = Pb.Prepare(cls);
        if (!is_nil(prep.fqName)) {
            let wk = Pb._JsonReadWellKnown(jv, cls, prep, o, depth);
            if (!is_nil(wk)) { return wk; }
        }
        if (!is_object(jv)) {
            throw(1, "Pb.FromJson: expected a JSON object for "
                   + (prep.fqName ?? prep.name));
        }

        let msg = Pb._NewMessage(cls);
        foreach (val, key in jv) {
            let e = prep.byJson.Get(key);
            if (is_nil(e)) {
                throw(1, "Pb.FromJson: " + (prep.fqName ?? prep.name)
                       + " has no field '" + key + "'");
            }
            if (is_nil(val)) { continue; }      // JSON null leaves it unset

            if (e.isMap) {
                let m = {};
                foreach (mv, mk in val) {
                    m[mk] = Pb._JsonValue(mv, e.valKind, e, o, depth);
                }
                Class.SetField(msg, e.name, m);
            } else if (e.rep) {
                let arr:array = [];
                var i:int = 0;
                while (i < len(val)) {
                    Array.Append(arr, Pb._JsonValue(val[i], e.kind, e, o, depth));
                    i += 1;
                }
                Class.SetField(msg, e.name, arr);
            } else {
                Class.SetField(msg, e.name, Pb._JsonValue(val, e.kind, e, o, depth));
                if (!is_nil(e.oneof)) { Pb._ClearSiblings(msg, prep, e); }
            }
        }
        return msg;
    }

    fn static _JsonValue(jv, kind:int, e, o, depth:int) {
        if (kind == Pb.MESSAGE) {
            if (is_nil(jv)) { return nil; }
            return Pb._JsonRead(jv, e.msg, o, depth + 1);
        }
        if (kind == Pb.BOOL)   { return (jv == true); }
        if (kind == Pb.STRING) { return Convert.ToString(jv); }
        if (kind == Pb.BYTES) {
            let b = Util.Base64DecodeBlock(Convert.ToString(jv));
            if (is_nil(b)) { throw(1, "Pb.FromJson: field '" + e.name
                                   + "' is not valid base64"); }
            return b;
        }
        if (kind == Pb.ENUM) {
            if (Type.Is(jv, Type.String)) {
                if (!is_nil(e.enumValues) && !is_nil(e.enumValues[jv])) {
                    return int(e.enumValues[jv]);
                }
                throw(1, "Pb.FromJson: '" + jv + "' is not a value of the enum on '"
                       + e.name + "'");
            }
            return int(jv);
        }
        if (kind == Pb.DOUBLE || kind == Pb.FLOAT) {
            if (Type.Is(jv, Type.String)) {
                if (jv == "NaN")       { return Math.NaN; }
                if (jv == "Infinity")  { return Math.Infinity; }
                if (jv == "-Infinity") { return -Math.Infinity; }
                let f = Convert.ParseFloat(jv);
                if (is_nil(f)) { throw(1, "Pb.FromJson: '" + jv + "' is not a number"); }
                return f;
            }
            return float(jv);
        }
        if (kind == Pb.UINT64 || kind == Pb.FIXED64) {
            return Pb._ParseUnsigned(Convert.ToString(jv));
        }
        // Every remaining kind is an integer; a JSON string form is legal too.
        if (Type.Is(jv, Type.String)) {
            let n = Convert.ParseInt(jv);
            if (is_nil(n)) { throw(1, "Pb.FromJson: '" + jv + "' is not an integer"); }
            return n;
        }
        return int(jv);
    }

    // A decimal string that may exceed int64, as the two's-complement value the
    // unsigned kinds are stored in.
    fn static _ParseUnsigned(s:string):int {
        let direct = Convert.ParseInt(s);
        if (!is_nil(direct) && direct >= 0) { return direct; }
        if (String.StartsWith(s, "-")) {
            if (is_nil(direct)) { throw(1, "Pb.FromJson: '" + s + "' is out of range"); }
            return direct;
        }
        let diff:string = Pb._DecSub("18446744073709551616", s);
        // 2^63 is the one value that cannot be reached by negating a positive.
        if (diff == "9223372036854775808") { return -9223372036854775807 - 1; }
        let d = Convert.ParseInt(diff);
        if (is_nil(d)) { throw(1, "Pb.FromJson: '" + s + "' is out of range for a 64-bit field"); }
        return -d;
    }

    // =========================================================================
    // JSON - proto3's canonical mapping
    // =========================================================================
    // Field names become lowerCamelCase, 64-bit integers become strings (a JSON
    // number cannot hold them), bytes become base64, enums become their value
    // name, and a field holding its default is omitted. All of that is the
    // specification, not a choice; the options below cover the parts the
    // specification leaves to the caller.

    fn static _JsonOpts(opts) {
        return {
            emitDefaults:   (opts != nil) && (opts.emitDefaults == true),
            useProtoNames:  (opts != nil) && (opts.useProtoNames == true),
            useEnumNumbers: (opts != nil) && (opts.useEnumNumbers == true),
        };
    }

    // A message as canonical proto3 JSON.
    fn static ToJson(msg, opts?):string {
        if (is_nil(msg) || !Class.IsInstance(msg)) {
            throw(1, "Pb.ToJson: expected a message instance");
        }
        let parts:array = [];
        Pb._JsonMsg(parts, msg, Pb.Prepare(Class.Of(msg)), Pb._JsonOpts(opts), 0);
        return String.Join(parts, "");
    }

    fn static _JsonMsg(out:array, msg, prep, o, depth:int) {
        if (depth > Pb.MAX_DEPTH) {
            throw(2, "Pb.ToJson: nesting deeper than " + str(Pb.MAX_DEPTH) + " levels");
        }
        // The well-known types are not objects in JSON - a Timestamp is a
        // string, a wrapper is the bare value, a Struct is a plain object.
        if (!is_nil(prep.fqName) && Pb._JsonWellKnown(out, msg, prep, o, depth)) {
            return;
        }
        Array.Append(out, "{");
        var first:bool = true;
        let fs = prep.fields;
        var i:int = 0;
        while (i < len(fs)) {
            let e = fs[i];
            i += 1;
            let v = Class.GetField(msg, e.name);

            // Absent is absent: a oneof member that is not the set one, an
            // optional field never assigned, an empty list or map.
            if (is_nil(v)) { continue; }
            if (e.isMap && len(Object.Keys(v)) == 0 && !o.emitDefaults) { continue; }
            if (e.rep && !e.isMap && len(v) == 0 && !o.emitDefaults) { continue; }
            if (!e.rep && !e.isMap && !e.explicit && !o.emitDefaults
                && Pb._IsDefault(e.kind, v)) { continue; }

            if (!first) { Array.Append(out, ","); }
            first = false;
            Array.Append(out, Json.Stringify(o.useProtoNames ? e.name : e.jsonName));
            Array.Append(out, ":");

            if (e.isMap) {
                Pb._JsonMap(out, v, e, o, depth);
            } else if (e.rep) {
                Array.Append(out, "[");
                var j:int = 0;
                while (j < len(v)) {
                    if (j > 0) { Array.Append(out, ","); }
                    Pb._JsonOne(out, v[j], e.kind, e, o, depth);
                    j += 1;
                }
                Array.Append(out, "]");
            } else {
                Pb._JsonOne(out, v, e.kind, e, o, depth);
            }
        }
        Array.Append(out, "}");
    }

    // Writes the special JSON form for a well-known type and returns true, or
    // returns false for anything else so the caller falls back to an object.
    fn static _JsonWellKnown(out:array, msg, prep, o, depth:int):bool {
        let n:string = prep.fqName;
        if (!String.StartsWith(n, "google.protobuf.")) { return false; }
        let t:string = String.Substr(n, 16, len(n) - 16);

        if (t == "Timestamp") {
            Array.Append(out, Json.Stringify(Pb._JsonTimestamp(
                int(Class.GetField(msg, "seconds") ?? 0),
                int(Class.GetField(msg, "nanos") ?? 0))));
            return true;
        }
        if (t == "Duration") {
            Array.Append(out, Json.Stringify(Pb._JsonDuration(
                int(Class.GetField(msg, "seconds") ?? 0),
                int(Class.GetField(msg, "nanos") ?? 0))));
            return true;
        }
        if (t == "Empty") { Array.Append(out, "{}"); return true; }

        if (t == "FieldMask") {
            let paths = Class.GetField(msg, "paths") ?? [];
            let camel:array = [];
            var i:int = 0;
            while (i < len(paths)) {
                // Each dotted segment camel-cases independently.
                let segs:array = String.Split(paths[i], ".");
                var outSeg:array = [];
                var j:int = 0;
                while (j < len(segs)) { Array.Append(outSeg, Pb._JsonCamel(segs[j])); j += 1; }
                Array.Append(camel, String.Join(outSeg, "."));
                i += 1;
            }
            Array.Append(out, Json.Stringify(String.Join(camel, ",")));
            return true;
        }

        // Struct / Value / ListValue map onto plain JSON.
        if (t == "Struct") {
            let fields = Class.GetField(msg, "fields") ?? {};
            Array.Append(out, "{");
            var first:bool = true;
            foreach (v, k in fields) {
                if (!first) { Array.Append(out, ","); }
                first = false;
                Array.Append(out, Json.Stringify(k));
                Array.Append(out, ":");
                Pb._JsonMsg(out, v, Pb.Prepare(Class.Of(v)), o, depth + 1);
            }
            Array.Append(out, "}");
            return true;
        }
        if (t == "ListValue") {
            let vals = Class.GetField(msg, "values") ?? [];
            Array.Append(out, "[");
            var i2:int = 0;
            while (i2 < len(vals)) {
                if (i2 > 0) { Array.Append(out, ","); }
                Pb._JsonMsg(out, vals[i2], Pb.Prepare(Class.Of(vals[i2])), o, depth + 1);
                i2 += 1;
            }
            Array.Append(out, "]");
            return true;
        }
        if (t == "Value") {
            let set:string = Pb.WhichOneof(msg, "kind");
            if (is_nil(set) || set == "null_value") { Array.Append(out, "null"); return true; }
            let v = Class.GetField(msg, set);
            if (set == "number_value") { Array.Append(out, Pb._JsonFloat(float(v))); return true; }
            if (set == "string_value") { Array.Append(out, Json.Stringify(v)); return true; }
            if (set == "bool_value")   { Array.Append(out, (v == true) ? "true" : "false"); return true; }
            Pb._JsonMsg(out, v, Pb.Prepare(Class.Of(v)), o, depth + 1);
            return true;
        }

        if (t == "Any") {
            let url:string = Class.GetField(msg, "type_url") ?? "";
            let slash:int  = String.LastIndexOf(url, "/");
            let tname:string = (slash < 0) ? url
                             : String.Substr(url, slash + 1, len(url) - slash - 1);
            let cls = Pb.ClassFor(tname);
            if (is_nil(cls)) {
                throw(1, "Pb.ToJson: Any names '" + tname + "', which no loaded "
                       + "schema defines - load it, or register it with Pb.Register");
            }
            let innerPrep = Pb.Prepare(cls);
            let inner = Pb.Decode(Class.GetField(msg, "value") ?? "", cls);
            let sub:array = [];
            let special:bool = !is_nil(innerPrep.fqName)
                             && Pb._JsonWellKnown(sub, inner, innerPrep, o, depth + 1);
            if (!special) { Pb._JsonMsg(sub, inner, innerPrep, o, depth + 1); }
            let body:string = String.Join(sub, "");
            Array.Append(out, "{");
            Array.Append(out, Json.Stringify("@type"));
            Array.Append(out, ":");
            Array.Append(out, Json.Stringify(url));
            if (special) {
                // A type with its own JSON form cannot be spliced into the
                // object, so it goes under "value" - the specification's rule.
                Array.Append(out, ",\"value\":");
                Array.Append(out, body);
            } else if (body != "{}") {
                Array.Append(out, ",");
                Array.Append(out, String.Substr(body, 1, len(body) - 2));
            }
            Array.Append(out, "}");
            return true;
        }

        // The wrappers are just their `value` field.
        if (t == "DoubleValue" || t == "FloatValue" || t == "Int64Value"
            || t == "UInt64Value" || t == "Int32Value" || t == "UInt32Value"
            || t == "BoolValue" || t == "StringValue" || t == "BytesValue") {
            let e = prep.byNum.Get(1);
            Pb._JsonOne(out, Class.GetField(msg, "value"), e.kind, e, o, depth);
            return true;
        }
        return false;
    }

    // RFC 3339 in UTC with 0, 3, 6 or 9 fractional digits - the precision the
    // value actually needs, which is what the specification asks for.
    fn static _JsonTimestamp(secs:int, nanos:int):string {
        let base:string = Time.Format(secs, "%Y-%m-%dT%H:%M:%S");
        return base + Pb._JsonFrac(nanos) + "Z";
    }

    fn static _JsonDuration(secs:int, nanos:int):string {
        var sign:string = "";
        var sv:int = secs;
        var nv:int = nanos;
        if (sv < 0 || nv < 0) { sign = "-"; sv = -sv; nv = -nv; }
        return sign + Convert.ToString(sv) + Pb._JsonFrac(nv) + "s";
    }

    // "" / ".mmm" / ".uuuuuu" / ".nnnnnnnnn" - trailing zero groups dropped.
    fn static _JsonFrac(nanos:int):string {
        if (nanos == 0) { return ""; }
        var d:string = Convert.ToString(nanos);
        while (len(d) < 9) { d = "0" + d; }
        if (String.EndsWith(d, "000000")) { return "." + String.Substr(d, 0, 3); }
        if (String.EndsWith(d, "000"))    { return "." + String.Substr(d, 0, 6); }
        return "." + d;
    }

    fn static _JsonMap(out:array, v, e, o, depth:int) {
        Array.Append(out, "{");
        var first:bool = true;
        // Map keys are always JSON strings, whatever the key type is on the wire.
        foreach (val, k in v) {
            if (!first) { Array.Append(out, ","); }
            first = false;
            Array.Append(out, Json.Stringify(k));
            Array.Append(out, ":");
            Pb._JsonOne(out, val, e.valKind, e, o, depth);
        }
        Array.Append(out, "}");
    }

    fn static _JsonOne(out:array, v, kind:int, e, o, depth:int) {
        if (kind == Pb.MESSAGE) {
            if (is_nil(v)) { Array.Append(out, "null"); return; }
            Pb._JsonMsg(out, v, Pb._PrepOf(e), o, depth + 1);
            return;
        }
        if (kind == Pb.BOOL)   { Array.Append(out, (v == true) ? "true" : "false"); return; }
        if (kind == Pb.STRING) { Array.Append(out, Json.Stringify(v ?? "")); return; }
        if (kind == Pb.BYTES)  { Array.Append(out, Json.Stringify(Util.Base64Encode(v))); return; }

        if (kind == Pb.ENUM) {
            let n:int = int(v ?? 0);
            if (!o.useEnumNumbers && !is_nil(e.enumValues)) {
                // The name, when the descriptor knows it. A number with no name
                // stays a number - that is what the specification says to do
                // with a value the schema does not list.
                foreach (num, name in e.enumValues) {
                    if (num == n) { Array.Append(out, Json.Stringify(name)); return; }
                }
            }
            Array.Append(out, Convert.ToString(n));
            return;
        }

        // 64-bit integers do not survive a JSON number, so they go as strings.
        if (kind == Pb.UINT64 || kind == Pb.FIXED64) {
            Array.Append(out, Json.Stringify(Pb._UnsignedDec(int(v ?? 0))));
            return;
        }
        if (kind == Pb.INT64 || kind == Pb.SINT64 || kind == Pb.SFIXED64) {
            Array.Append(out, Json.Stringify(Convert.ToString(int(v ?? 0))));
            return;
        }
        if (kind == Pb.DOUBLE || kind == Pb.FLOAT) {
            Array.Append(out, Pb._JsonFloat(float(v ?? 0.0)));
            return;
        }
        Array.Append(out, Convert.ToString(int(v ?? 0)));
    }

    // A uint64 held in a signed 64-bit slot, as its unsigned decimal string.
    // The top half of the range is negative here, and 2^64 does not fit in an
    // int, so the conversion is done on the digits: 2^64 minus the magnitude.
    fn static _UnsignedDec(v:int):string {
        if (v >= 0) { return Convert.ToString(v); }
        let mag:string = String.Substr(Convert.ToString(v), 1,
                                       len(Convert.ToString(v)) - 1);
        return Pb._DecSub("18446744073709551616", mag);
    }

    // a - b for non-negative decimal strings, where a >= b.
    fn static _DecSub(a:string, b:string):string {
        var out:string = "";
        var borrow:int = 0;
        var i:int = len(a) - 1;
        var j:int = len(b) - 1;
        while (i >= 0) {
            let da:int = Convert.ToInt(a[i]) - 48;
            let db:int = (j >= 0) ? (Convert.ToInt(b[j]) - 48) : 0;
            var d:int = da - db - borrow;
            if (d < 0) { d += 10; borrow = 1; } else { borrow = 0; }
            out = Char.FromInt(48 + d) + out;
            i -= 1;
            j -= 1;
        }
        var k:int = 0;
        while (k < len(out) - 1 && out[k] == 48) { k += 1; }
        return String.Substr(out, k, len(out) - k);
    }

    // The shortest decimal form that reads back as the same double, which is
    // what canonical JSON emits. Flaris can format fixed-point or full %.17g but
    // has no shortest-round-trip primitive, so try increasing precision and stop
    // at the first that survives a round trip. Outside the range fixed-point
    // renders sensibly, fall back to %.17g - still exact, just longer.
    fn static _JsonFloat(v:float):string {
        // The three non-finite values are quoted strings in proto3 JSON - a
        // bare NaN or Infinity is not valid JSON.
        if (Math.IsNaN(v))    { return "\"NaN\""; }
        if (!Math.IsFinite(v)) { return (v < 0.0) ? "\"-Infinity\"" : "\"Infinity\""; }

        let mag:float = (v < 0.0) ? -v : v;
        if (mag >= 1.0e-4 && mag < 1.0e16) {
            var p:int = 1;
            while (p <= 17) {
                let cand:string = String.FormatArray("{0:." + str(p) + "f}", [v]);
                // flaris-ignore[float-eq]
                if (!is_nil(cand) && Convert.ParseFloat(cand) == v) {
                    return Pb._TrimFloat(cand);
                }
                p += 1;
            }
        }
        return Convert.ToString(v);
    }

    // Drop a trailing ".0" and any trailing zeros a fixed-point render added.
    fn static _TrimFloat(s:string):string {
        if (!String.Contains(s, ".")) { return s; }
        var out:string = s;
        while (String.EndsWith(out, "0")) { out = String.Substr(out, 0, len(out) - 1); }
        if (String.EndsWith(out, ".")) { out = String.Substr(out, 0, len(out) - 1); }
        return out;
    }

    fn static Encode(msg):block {
        if (is_nil(msg) || !Class.IsInstance(msg)) {
            throw(1, "Pb.Encode: expected a message instance");
        }
        let prep = Pb.Prepare(Class.Of(msg));
        if (!prep.twoPass) {
            let wd = new PbWriter(64);
            Pb._WriteMsg(nil, wd, msg, prep, 0);
            return wd.ToBuffer();
        }
        let ctx = Pb._NewCtx();
        let total:int = Pb._SizeMsg(ctx, msg, prep, 0);
        ctx.idx  = 0;
        ctx.kidx = 0;
        let w = new PbWriter(total > 0 ? total : 16);
        Pb._WriteMsg(ctx, w, msg, prep, 0);
        return w.ToBuffer();
    }

    // Byte length Encode would produce, without building the bytes.
    fn static EncodedSize(msg):int {
        if (is_nil(msg) || !Class.IsInstance(msg)) {
            throw(1, "Pb.EncodedSize: expected a message instance");
        }
        return Pb._SizeMsg(Pb._NewCtx(), msg, Pb.Prepare(Class.Of(msg)), 0);
    }

    // A new instance of `cls` decoded from `bytes`.
    fn static Decode(bytes, cls) {
        let prep = Pb.Prepare(cls);
        let msg  = Pb._NewMessage(cls);
        if (is_nil(bytes)) { return msg; }
        let blk:block = _pb_asBlock(bytes);
        if (len(blk) > 0) { Pb._ReadMsg(new PbReader(blk, nil, nil), msg, prep, 0); }
        return msg;
    }

    // Decode into an existing message, protobuf merge semantics: scalars
    // overwrite, repeated fields append, submessages merge field by field.
    // Returns `msg`.
    fn static Merge(msg, bytes) {
        if (is_nil(msg) || !Class.IsInstance(msg)) {
            throw(1, "Pb.Merge: expected a message instance");
        }
        if (is_nil(bytes)) { return msg; }
        let blk:block = _pb_asBlock(bytes);
        if (len(blk) > 0) {
            Pb._ReadMsg(new PbReader(blk, nil, nil), msg, Pb.Prepare(Class.Of(msg)), 0);
        }
        return msg;
    }

    // Varint length prefix followed by the message - the framing used to put
    // several messages in one file or on one socket.
    fn static EncodeDelimited(msg):block {
        let body:block = Pb.Encode(msg);
        let w = new PbWriter(len(body) + 10);
        w.Bytes(body);
        return w.ToBuffer();
    }

    // One length-prefixed message off a reader positioned at the length.
    fn static DecodeDelimited(r, cls) {
        let n:int = r.VarInt();
        let prevLimit:int = r.PushLimit(n);
        let msg = Pb._NewMessage(cls);
        Pb._ReadMsg(r, msg, Pb.Prepare(cls), 0);
        r.PopLimit(prevLimit);
        return msg;
    }

    // One length-prefixed message off a stream, or nil at a clean end of input.
    fn static ReadDelimited(s:stream, cls) {
        let n = Stream.ReadVarint(s);
        if (is_nil(n)) { return nil; }
        if (n < 0) { throw(2, "Pb.ReadDelimited: negative length prefix"); }
        if (n == 0) { return Pb._NewMessage(cls); }
        let body:block = Stream.ReadBytes(s, n);
        if (is_nil(body) || len(body) < n) {
            throw(2, "Pb.ReadDelimited: stream ended inside a message");
        }
        return Pb.Decode(body, cls);
    }

    fn static WriteDelimited(s:stream, msg):bool {
        let body:block = Pb.Encode(msg);
        if (!Stream.WriteVarint(s, len(body))) { return false; }
        if (len(body) == 0) { return true; }
        return Stream.WriteBytes(s, body, len(body)) == len(body);
    }

    // The name of the set field in oneof `name`, or nil when none is set.
    fn static WhichOneof(msg, name:string) {
        let prep  = Pb.Prepare(Class.Of(msg));
        let group = prep.oneofs[name];
        if (is_nil(group)) { return nil; }
        let i:int = 0;
        while (i < len(group)) {
            if (!is_nil(Class.GetField(msg, group[i]))) { return group[i]; }
            i += 1;
        }
        return nil;
    }

    fn static ClearOneof(msg, name:string):bool {
        let prep  = Pb.Prepare(Class.Of(msg));
        let group = prep.oneofs[name];
        if (is_nil(group)) { return false; }
        let i:int = 0;
        while (i < len(group)) {
            Class.SetField(msg, group[i], nil);
            i += 1;
        }
        return true;
    }

    // Field-by-field comparison. Encoded bytes are not compared: protobuf
    // serialization is not canonical, and a map's key order in particular is
    // not stable, so equal messages can encode to different bytes.
    fn static Equals(a, b):bool {
        if (is_nil(a) || is_nil(b)) { return is_nil(a) && is_nil(b); }
        if (!Class.IsInstance(a) || !Class.IsInstance(b)) { return false; }
        let cls = Class.Of(a);
        if (Class.Of(b) != cls) { return false; }

        let prep = Pb.Prepare(cls);
        let fs   = prep.fields;
        let i:int = 0;
        while (i < len(fs)) {
            let e = fs[i];
            i += 1;
            let va = Class.GetField(a, e.name);
            let vb = Class.GetField(b, e.name);

            if (e.isMap) {
                let ka = is_nil(va) ? [] : Object.Keys(va);
                let kb = is_nil(vb) ? [] : Object.Keys(vb);
                if (len(ka) != len(kb)) { return false; }
                let j:int = 0;
                while (j < len(ka)) {
                    let k:string = ka[j];
                    j += 1;
                    if (is_nil(vb) || is_nil(vb[k])) {
                        if (!is_nil(va[k])) { return false; }
                        continue;
                    }
                    if (!Pb._ValueEq(e.valKind, va[k], vb[k])) { return false; }
                }
                continue;
            }

            if (e.rep) {
                let na:int = is_nil(va) ? 0 : len(va);
                let nb:int = is_nil(vb) ? 0 : len(vb);
                if (na != nb) { return false; }
                let j:int = 0;
                while (j < na) {
                    if (!Pb._ValueEq(e.kind, va[j], vb[j])) { return false; }
                    j += 1;
                }
                continue;
            }

            // Implicit-presence fields treat nil and the zero value as the same
            // state, because that is exactly what the wire cannot tell apart.
            if (!e.explicit) {
                if (Pb._IsDefault(e.kind, va) && Pb._IsDefault(e.kind, vb)) { continue; }
            }
            if (!Pb._ValueEq(e.kind, va, vb)) { return false; }
        }
        return true;
    }

    fn static _ValueEq(kind:int, x, y):bool {
        if (kind == Pb.MESSAGE) { return Pb.Equals(x, y); }
        if (kind == Pb.BYTES) {
            if (is_nil(x) || is_nil(y)) { return is_nil(x) && is_nil(y); }
            return Buffer.Equals(x, y);
        }
        return x == y;
    }

    // Deep copy, via a wire round-trip.
    fn static Clone(msg) {
        if (is_nil(msg)) { return nil; }
        return Pb.Decode(Pb.Encode(msg), Class.Of(msg));
    }
}

export { Pb, PbWriter, PbReader, ProtoParser };
