// Config.fls - TOML and YAML configuration file parser for Flaris.
// Version: 1.0
//
// Parses TOML (primary) and a YAML subset. Supports: string, int, float, bool,
// array, inline table, [sections], [[array of tables]], dotted and quoted keys,
// multi-line strings, \uXXXX/\UXXXXXXXX escapes, hex/octal/binary integer literals.
// TOML dates and times (1979-05-27T07:32:00Z, 1979-05-27, 07:32:00) load as
// their text, a string, and save as a quoted string. Arrays and inline tables
// nest to any depth and save the same way. A value that does not parse (a bare
// word, an array or inline table holding one, or one left unclosed) loads as
// nil and the rest of its line is skipped; Load never raises on bad input.
// YAML: block mappings and sequences (also "- item" at the key's own indent),
// flow {}/[], quoted strings with escapes, | and > blocks with -/+ chomping.
// A "#" starts a comment at the line start or after a space or tab, so
// "http://x/#frag" and "a#b" are values.
//
// Usage:
//   import { Config } from library("Config", "1.0");
//
//   let c = new Config();
//   c.LoadFile("app.toml");
//
//   let host = c.GetString("database.host", "localhost");
//   let port  = c.GetInt("database.port", 5432);
//   let debug = c.GetBool("app.debug", false);
//   c.Set("app.version", "2.0");
//   c.Save("app.toml");
//
// Loading:
//   Load(text)           - parse TOML string; returns this
//   LoadFile(path)       - read and parse TOML file; returns this
//   LoadYaml(text)       - parse YAML string; returns this
//   LoadYamlFile(path)   - read and parse YAML file; returns this
//   LoadEnv(text, interpolate?)     - parse dotenv text (KEY=VALUE); returns this
//   LoadEnvFile(path, interpolate?) - read and parse a .env file; returns this
//       - supports: comments (#), `export KEY=...`, "double"/'single' quotes,
//         inline comments. Interpolation (default on) expands ${VAR},
//         ${VAR:-default} and $VAR against earlier keys + the OS environment;
//         single-quoted values are literal. "\$" is a literal dollar sign.
//   Interpolate(extraVars?)         - expand ${VAR}/$VAR in all top-level string
//                                     values (config keys, then extraVars, then env)
//   static FromObject(obj)  →  Config instance from a plain object
//
// Reading (keys support dot notation: "section.key"):
//   Get(key)                          →  any or nil
//   GetString(key, default?)          →  string
//   GetInt(key, default?)             →  int
//   GetFloat(key, default?)           →  float
//   GetBool(key, default?)            →  bool
//   GetArray(key)                     →  array (or [] if missing)
//   Has(key)                          →  bool
//   Sections()                        →  array of top-level section names
//   GetSection(name)                  →  object with all keys in section
//   Keys(section?)                    →  array of key names (in section, or all top-level)
//
// Writing:
//   Set(key, value)                   - set or update a value; returns this
//   Remove(key)                       →  bool
//   Merge(other:Config)               - copy all keys from other; returns this
//   Defaults(obj)                     - set keys only if not already present; returns this
//
// Serialization:
//   ToString()                        →  TOML string representation
//   Save(path)                        - write TOML to file; returns this

class Config {
    let p = nil; 
    let _data: object = nil; 

    fn Constructor() {
        this._data = {};
    }

    // =========================================================================
    // Cursor - lightweight position object over a source string
    // =========================================================================

    fn static _cNew(src:string) {
        return { s: src, p: 0, n: String.Length(src) };
    }

    fn static _cCh(c): string {
        if (c.p >= c.n) return "";
        return String.Substr(c.s, c.p, 1);
    }

    fn static _cAhead(c, k:int): string {
        if (c.p >= c.n) return "";
        if (c.p + k > c.n) {
            let rem = c.n - c.p;
            if (rem <= 0) return "";
            return String.Substr(c.s, c.p, rem);
        }
        return String.Substr(c.s, c.p, k);
    }

    fn static _cAdv(c): string {
        if (c.p >= c.n) return "";
        let ch = String.Substr(c.s, c.p, 1);
        c.p += 1;
        return ch;
    }

    fn static _cSkipIws(c) {
        c.p = Config._iwsEnd(c.s, c.p, c.n);
    }

    fn static _cSkipWs(c) {
        c.p = Config._wsEnd(c.s, c.p, c.n);
    }

    // The scanners below take the cursor's fields as typed values, so they
    // compile to native code; each returns the position it stopped at.

    // First position at or after p, below n, that is not a space or a tab.
    fn static _iwsEnd(s:string, p:int, n:int): int {
        while (p < n) {
            let b = s[p];
            if (b != ' ' && b != '\t') break;
            p += 1;
        }
        return p;
    }

    // As _iwsEnd, also stepping over line breaks and "#" comments.
    fn static _wsEnd(s:string, p:int, n:int): int {
        while (p < n) {
            let b = s[p];
            if (b == ' ' || b == '\t' || b == '\n' || b == '\r') {
                p += 1;
            } else if (b == '#') {
                p = Config._eolAt(s, p, n);
            } else {
                break;
            }
        }
        return p;
    }

    // Position of the next "\n" at or after p, or n.
    fn static _eolAt(s:string, p:int, n:int): int {
        while (p < n && s[p] != '\n') p += 1;
        return p;
    }

    // End of the run of bare-key bytes (A-Z a-z 0-9 - _) starting at p.
    fn static _bareEnd(s:string, p:int, n:int): int {
        while (p < n) {
            let b = s[p];
            if ((b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') ||
                (b >= '0' && b <= '9') || b == '-' || b == '_') {
                p += 1;
            } else break;
        }
        return p;
    }

    // Position of the next `stop` or backslash at or after p, or n.
    fn static _runEnd(s:string, p:int, n:int, stop:char): int {
        while (p < n) {
            let b = s[p];
            if (b == stop || b == '\\') break;
            p += 1;
        }
        return p;
    }

    // =========================================================================
    // Escape helper
    // =========================================================================

    fn static _escChar(ch:string): string {
        if (ch == "n")  return "\n";
        if (ch == "t")  return "\t";
        if (ch == "r")  return "\r";
        if (ch == "\\") return "\\";
        if (ch == "\"") return "\"";
        if (ch == "b")  return "\b";
        if (ch == "f")  return "\f";
        if (ch == "e")  return "\x1b";
        if (ch == "a")  return "\a";
        if (ch == "v")  return "\v";
        if (ch == "0")  return "\uFFFD";
        return ch;
    }

    // Reads the escape after a backslash (TOML and YAML double-quoted forms).
    // An unknown escape yields its letter; a code point a string cannot hold
    // (U+0000, a surrogate) yields U+FFFD.
    fn static _escape(c): string {
        let ch = Config._cAdv(c);
        if (ch == "u") return Config._hexCp(c, 4, ch);
        if (ch == "U") return Config._hexCp(c, 8, ch);
        if (ch == "x") return Config._hexCp(c, 2, ch);
        return Config._escChar(ch);
    }

    fn static _hexCp(c, k:int, letter:string): string {
        let hex = Config._cAhead(c, k);
        if (String.Length(hex) != k) return letter;
        var cp = 0;
        iter (i from 0 to k) {
            let v = String.IndexOf("0123456789abcdef", String.ToLower(String.Substr(hex, i, 1)));
            if (v < 0) return letter;
            cp = cp * 16 + v;
        }
        c.p += k;
        return String.Utf8Concat(cp) ?? "\uFFFD";
    }

    // =========================================================================
    // String parsers
    // =========================================================================

    fn static _parseBasicStr(c): string {
        c.p += 1;
        var s = "";
        while (c.p < c.n) {
            let e = Config._runEnd(c.s, c.p, c.n, '"');
            if (e > c.p) {
                let run = String.Substr(c.s, c.p, e - c.p);
                s += run;
                c.p = e;
                if (c.p >= c.n) break;
            }
            let ch = Config._cAdv(c);
            if (ch == "\"") return s;
            s += Config._escape(c);
        }
        return s;
    }

    fn static _parseMlBasicStr(c): string {
        c.p += 3;
        if (Config._cAhead(c, 2) == "\r\n") c.p += 2;
        else if (Config._cCh(c) == "\n")    c.p += 1;
        var s = "";
        while (c.p < c.n) {
            if (Config._cAhead(c, 3) == "\"\"\"") { c.p += 3; return s; }
            let ch = Config._cAdv(c);
            if (ch == "\\") {
                let nxt = Config._cCh(c);
                if (nxt == "\n" || nxt == "\r" || nxt == " " || nxt == "\t") {
                    while (c.p < c.n) {
                        let w = Config._cCh(c);
                        if (w == " " || w == "\t" || w == "\n" || w == "\r") c.p += 1;
                        else break;
                    }
                } else {
                    s += Config._escape(c);
                }
            } else {
                s += ch;
            }
        }
        return s;
    }

    fn static _parseLiteralStr(c): string {
        c.p += 1;
        let q = String.IndexOfFrom(c.s, "'", c.p);
        if (q < 0 || q >= c.n) {
            let rest = String.Substr(c.s, c.p, c.n - c.p);
            c.p = c.n;
            return rest;
        }
        let s = String.Substr(c.s, c.p, q - c.p);
        c.p = q + 1;
        return s;
    }

    fn static _parseMlLiteralStr(c): string {
        c.p += 3;
        if (Config._cAhead(c, 2) == "\r\n") c.p += 2;
        else if (Config._cCh(c) == "\n")    c.p += 1;
        var s = "";
        while (c.p < c.n) {
            if (Config._cAhead(c, 3) == "'''") { c.p += 3; return s; }
            s += Config._cAdv(c);
        }
        return s;
    }

    // =========================================================================
    // Number parser
    // =========================================================================

    fn static _isDigit(ch:string): bool {
        return ch >= "0" && ch <= "9";
    }

    // "1979-05-27..." or "07:32:00..." ahead of the cursor
    fn static _atDateTime(c): bool {
        let a = Config._cAhead(c, 5);
        if (String.Length(a) < 3 || !Config._isDigit(String.Substr(a, 0, 1)) || !Config._isDigit(String.Substr(a, 1, 1))) return false;
        if (String.Substr(a, 2, 1) == ":") return true;
        return String.Length(a) == 5 && Config._isDigit(String.Substr(a, 2, 1)) &&
               Config._isDigit(String.Substr(a, 3, 1)) && String.Substr(a, 4, 1) == "-";
    }

    fn static _parseDateTime(c): string {
        let start = c.p;
        while (c.p < c.n) {
            let d = Config._cCh(c);
            if (Config._isDigit(d) || d == "-" || d == ":" || d == "." || d == "+" ||
                d == "T" || d == "t" || d == "Z" || d == "z") {
                c.p += 1;
            } else if (d == " " && c.p - start == 10 && c.p + 1 < c.n &&
                       Config._isDigit(String.Substr(c.s, c.p + 1, 1))) {
                c.p += 1;
            } else break;
        }
        return String.Substr(c.s, start, c.p - start);
    }

    fn static _parseNumber(c) {
        if (Config._atDateTime(c)) return Config._parseDateTime(c);
        var s = "";
        let sign = Config._cCh(c);
        if (sign == "+" || sign == "-") s += Config._cAdv(c);

        let a3 = Config._cAhead(c, 3);
        if (a3 == "inf") {
            c.p += 3;
            if (s == "-") return -Math.Infinity;
            return Math.Infinity;
        }
        if (a3 == "nan") { c.p += 3; return Math.NaN; }

        let a2 = Config._cAhead(c, 2);
        if (a2 == "0x" || a2 == "0o" || a2 == "0b") {
            var digits = a2;
            c.p += 2;
            while (c.p < c.n) {
                let d = Config._cCh(c);
                if (d == "_") { c.p += 1; continue; }
                if ((d >= "0" && d <= "9") || (d >= "a" && d <= "f") || (d >= "A" && d <= "F")) {
                    digits += Config._cAdv(c);
                } else break;
            }
            return Convert.ParseInt(digits);
        }

        var isFloat = false;
        while (c.p < c.n) {
            let d = Config._cCh(c);
            if (d >= "0" && d <= "9") {
                s += Config._cAdv(c);
            } else if (d == "_") {
                c.p += 1;
            } else if (d == "." || d == "e" || d == "E") {
                isFloat = true;
                s += Config._cAdv(c);
            } else if ((d == "+" || d == "-") &&
                       (String.EndsWith(s, "e") || String.EndsWith(s, "E"))) {
                s += Config._cAdv(c);
            } else {
                break;
            }
        }

        if (isFloat) return Convert.ParseFloat(s);
        return Convert.ParseInt(s);
    }

    // =========================================================================
    // Key parsers
    // =========================================================================

    fn static _parseBareKey(c): string {
        let start = c.p;
        c.p = Config._bareEnd(c.s, start, c.n);
        return String.Substr(c.s, start, c.p - start);
    }

    fn static _parseSimpleKey(c): string {
        if (Config._cAhead(c, 3) == "\"\"\"") return Config._parseMlBasicStr(c);
        let ch = Config._cCh(c);
        if (ch == "\"") return Config._parseBasicStr(c);
        if (ch == "'")  return Config._parseLiteralStr(c);
        return Config._parseBareKey(c);
    }

    fn static _parseKeyParts(c) {
        var parts = [];
        while (true) {
            Config._cSkipIws(c);

            let k = Config._parseSimpleKey(c);
            Array.Append(parts, k);
            Config._cSkipIws(c);
            if (Config._cCh(c) == ".") c.p += 1;
            else break;
        }
        return parts;
    }


    // =========================================================================
    // Object path helpers
    // =========================================================================

    fn static _setDotted(obj, parts, value) {
        var o   = obj;
        var n   = len(parts);
        var idx = 0;
        foreach (p in parts) {
            if (idx == n - 1) {
                o[p] = value;
            } else {
                if (o[p] == nil || !Type.Is(o[p], Type.Object)) o[p] = {};
                o = o[p];
            }
            idx += 1;
        }
    }

    // An array of tables on the path resolves to its last table, as in TOML.
    fn static _ensurePath(root, parts) {
        var o = root;
        foreach (p in parts) {
            let v = o[p];
            if (Config._isAoT(v)) {
                o = v[len(v) - 1];
            } else {
                if (v == nil || !Type.Is(v, Type.Object)) o[p] = {};
                o = o[p];
            }
        }
        return o;
    }

    // =========================================================================
    // Value parser - recursive
    // =========================================================================

    // A TOML value is never nil: nil from _parseValue marks text that is not a
    // value, and an array or inline table holding one (or left unclosed) is nil.
    fn static _parseArray(c) {
        c.p += 1;
        var arr = [];
        while (c.p < c.n) {
            Config._cSkipWs(c);
            let ch = Config._cCh(c);
            if (ch == "]") { c.p += 1; return arr; }
            if (ch == ",") { c.p += 1; continue; }
            let val = Config._parseValue(c);
            if (val == nil) return nil;
            Array.Append(arr, val);
        }
        return nil;
    }

    fn static _parseInlineTable(c) {
        c.p += 1;
        var obj = {};
        while (c.p < c.n) {
            Config._cSkipWs(c);
            let ch = Config._cCh(c);
            if (ch == "}") { c.p += 1; return obj; }
            if (ch == ",") { c.p += 1; continue; }
            let parts = Config._parseKeyParts(c);
            Config._cSkipIws(c);
            if (Config._cCh(c) != "=") return nil;
            c.p += 1;
            let val = Config._parseValue(c);
            if (val == nil) return nil;
            Config._setDotted(obj, parts, val);
        }
        return nil;
    }

    fn static _parseValue(c) {
        Config._cSkipIws(c);
        let a3 = Config._cAhead(c, 3);
        if (a3 == "\"\"\"") return Config._parseMlBasicStr(c);
        if (a3 == "'''")    return Config._parseMlLiteralStr(c);
        let ch = Config._cCh(c);
        if (ch == "\"")     return Config._parseBasicStr(c);
        if (ch == "'")      return Config._parseLiteralStr(c);
        if (ch == "[")      return Config._parseArray(c);
        if (ch == "{")      return Config._parseInlineTable(c);
        if (Config._cAhead(c, 4) == "true")  { c.p += 4; return true; }
        if (Config._cAhead(c, 5) == "false") { c.p += 5; return false; }
        return Config._parseNumber(c);
    }

    // =========================================================================
    // Document parser
    // =========================================================================

    fn static _parseToml(text:string) {
        var data    = {};
        var current = data;
        let c = Config._cNew(text);

        while (c.p < c.n) {
            Config._cSkipWs(c);
            if (c.p >= c.n) break;
            let ch = Config._cCh(c);

            if (Config._cAhead(c, 2) == "[[") {
                c.p += 2;
                let parts = Config._parseKeyParts(c);
                while (c.p < c.n && Config._cAhead(c, 2) != "]]") c.p += 1;
                c.p += 2;
                let last = parts[len(parts) - 1];
                Array.RemoveAt(parts, len(parts) - 1);
                let parent = Config._ensurePath(data, parts);
                if (!Type.Is(parent[last], Type.Array)) parent[last] = [];
                var tbl = {};
                Array.Append(parent[last], tbl);
                current = tbl;
                continue;
            }

            if (ch == "[") {
                c.p += 1;
                let parts = Config._parseKeyParts(c);
                while (c.p < c.n && Config._cCh(c) != "]") c.p += 1;
                c.p += 1;
                current = Config._ensurePath(data, parts);
                continue;
            }

            let keyParts = Config._parseKeyParts(c);
            Config._cSkipIws(c);
            if (Config._cCh(c) != "=") {
                c.p = Config._eolAt(c.s, c.p, c.n);
                continue;
            }
            c.p += 1;
            let val = Config._parseValue(c);
            Config._setDotted(current, keyParts, val);
            Config._cSkipIws(c);
            if (val == nil || Config._cCh(c) == "#") c.p = Config._eolAt(c.s, c.p, c.n);
        }
        return data;
    }

    // =========================================================================
    // Serializer
    // =========================================================================

    fn static _escapeStr(v:string): string {
        let s  = String.Replace(v,  "\\", "\\\\");
        let s2 = String.Replace(s,  "\"", "\\\"");
        let s3 = String.Replace(s2, "\n", "\\n");
        let s4 = String.Replace(s3, "\t", "\\t");
        let s5 = String.Replace(s4, "\r", "\\r");
        return "\"" + s5 + "\"";
    }

    fn static _scalar(v): string {
        if (v == nil)               return "\"\"";
        if (type(v) == Type.Bool)   return v ? "true" : "false";
        if (type(v) == Type.Int)    return str(v);
        if (type(v) == Type.Float) {
            if (Math.IsNaN(v))       return "nan";
            if (v == Math.Infinity)  return "inf";
            if (v == -Math.Infinity) return "-inf";
            return Json.Stringify(v);
        }
        if (type(v) == Type.String) return Config._escapeStr(v);
        return "\"\"";
    }

    fn static _key(k:string): string {
        if (k == "") return "\"\"";
        foreach (ch in k) {
            if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
                  (ch >= '0' && ch <= '9') || ch == '-' || ch == '_')) return Config._escapeStr(k);
        }
        return k;
    }

    fn static _isAoT(v): bool {
        if (!Type.Is(v, Type.Array) || len(v) == 0) return false;
        foreach (item in v) {
            if (!Type.Is(item, Type.Object)) return false;
        }
        return true;
    }

    // A value in inline form: arrays and tables nest, the rest is a scalar.
    fn static _inline(v): string {
        if (Type.Is(v, Type.Array)) {
            var parts = [];
            foreach (item in v) Array.Append(parts, Config._inline(item));
            return "[" + String.Join(parts, ", ") + "]";
        }
        if (Type.Is(v, Type.Object)) {
            var parts = [];
            foreach (entry in Object.Entries(v)) {
                if (entry[1] != nil) Array.Append(parts, Config._key(entry[0]) + " = " + Config._inline(entry[1]));
            }
            if (len(parts) == 0) return "{}";
            return "{ " + String.Join(parts, ", ") + " }";
        }
        return Config._scalar(v);
    }

    fn static _serializeSection(obj, prefix:string): string {
        var out = "";
        // Pass 1: scalars and plain arrays in this object
        foreach (entry in Object.Entries(obj)) {
            let v = entry[1];
            if (v == nil || Type.Is(v, Type.Object) || Config._isAoT(v)) continue;
            let k = Config._key(entry[0]);
            out += k + " = " + Config._inline(v) + "\n";
        }
        // Pass 2: subsections and array-of-tables
        foreach (entry in Object.Entries(obj)) {
            let v = entry[1];
            if (v == nil) continue;
            let k = Config._key(entry[0]);
            let fp = prefix == "" ? k : prefix + "." + k;
            if (Type.Is(v, Type.Object)) {
                out += "\n[" + fp + "]\n";
                out += Config._serializeSection(v, fp);
            } else if (Config._isAoT(v)) {
                foreach (item in v) {
                    out += "\n[[" + fp + "]]\n";
                    out += Config._serializeSection(item, fp);
                }
            }
        }
        return out;
    }

    // =========================================================================
    // YAML parsing
    // Supports: scalars, block mappings/sequences, inline flow ({}/[]),
    //           quoted strings, multiline literal (|) and folded (>) blocks
    //           with chomping (-/+), booleans, null, numbers, inline comments.
    // Not supported: anchors/aliases, multiple documents, complex tags.
    // =========================================================================

    fn static _yScalar(v:string) {
        let s = String.Trim(v);
        if (s == "" || s == "null" || s == "~") { return nil; }
        if (s == "true"  || s == "yes" || s == "on")  { return true; }
        if (s == "false" || s == "no"  || s == "off") { return false; }
        let n = String.Length(s);
        if (n >= 2) {
            let f = String.Substr(s, 0, 1);
            let l = String.Substr(s, n - 1, 1);
            if (f == "\"" && l == "\"") return Config._yUnescape(String.Substr(s, 1, n - 2));
            if (f == "'" && l == "'")   return String.Replace(String.Substr(s, 1, n - 2), "''", "'");
        }
        let iv = Convert.TryParseInt(s);
        if (iv != nil) { return iv; }
        let fv = Convert.TryParseFloat(s);
        if (fv != nil) { return fv; }
        return s;
    }

    fn static _yUnescape(s:string): string {
        if (String.IndexOf(s, "\\") < 0) return s;
        let c = Config._cNew(s);
        var out = "";
        while (c.p < c.n) {
            let ch = Config._cAdv(c);
            if (ch == "\\") out += Config._escape(c);
            else             out += ch;
        }
        return out;
    }

    fn static _yIndent(line:string):int {
        let n = 0;
        let m = String.Length(line);
        while (n < m && String.Substr(line, n, 1) == " ") { n += 1; }
        return n;
    }

    fn static _yStripComment(s:string):string {
        let n = String.Length(s);
        let at = Config._yCommentAt(s, n);
        if (at == n) return s;
        return String.Substr(s, 0, at);
    }

    // Position of the "#" that starts a comment, or n. A comment starts at the
    // line start or after a space or tab, never inside quotes; a quote opens a
    // quoted scalar only where a scalar starts, so "it's" and "a#b" are plain.
    fn static _yCommentAt(s:string, n:int): int {
        var dq = false;
        var sq = false;
        var prev = ' ';
        var i = 0;
        while (i < n) {
            let b = s[i];
            if (dq) {
                if (b == '\\') i += 1;
                else if (b == '"') dq = false;
            } else if (sq) {
                if (b == '\'') {
                    if (i + 1 < n && s[i + 1] == '\'') i += 1;
                    else sq = false;
                }
            } else if (b == '#') {
                if (prev == ' ' || prev == '\t') return i;
            } else if ((b == '"' || b == '\'') &&
                       (prev == ' ' || prev == '\t' || prev == '[' || prev == '{' || prev == ',')) {
                if (b == '"') dq = true;
                else sq = true;
            }
            prev = b;
            i += 1;
        }
        return n;
    }

    fn static _yFindColon(s:string):int {
        let dq = false; let sq = false;
        let n = String.Length(s); let i = 0;
        while (i < n) {
            let ch = String.Substr(s, i, 1);
            if      (ch == "\\" && dq)  { i += 1; }
            else if (ch == "\"" && !sq) { dq = !dq; }
            else if (ch == "'"  && !dq) { sq = !sq; }
            else if (ch == ":"  && !dq && !sq) {
                if (i + 1 >= n || String.Substr(s, i + 1, 1) == " ") { return i; }
            }
            i += 1;
        }
        return -1;
    }

    fn static _yFlow(s:string, pos:int, end_ch:string) {
        let n = String.Length(s);
        let is_arr = (end_ch == "]");
        let result = is_arr ? [] : {};
        let cur_key = nil; let cur_val = "";
        let dq = false; let sq = false;
        while (pos < n) {
            let ch = String.Substr(s, pos, 1); pos += 1;
            if (dq) {
                cur_val += ch;
                if (ch == "\\" && pos < n) { cur_val += String.Substr(s, pos, 1); pos += 1; }
                else if (ch == "\"") { dq = false; }
                continue;
            }
            if (sq) { cur_val += ch; if (ch == "'")  { sq = false; } continue; }
            if (ch == "\"") { dq = true;  cur_val += ch; continue; }
            if (ch == "'")  { sq = true;  cur_val += ch; continue; }
            if (ch == "[") {
                let r = Config._yFlow(s, pos, "]"); pos = r.end;
                if (is_arr) { Array.Append(result, r.val); }
                else if (cur_key != nil) { result[cur_key] = r.val; cur_key = nil; }
                continue;
            }
            if (ch == "{") {
                let r = Config._yFlow(s, pos, "}"); pos = r.end;
                if (is_arr) { Array.Append(result, r.val); }
                else if (cur_key != nil) { result[cur_key] = r.val; cur_key = nil; }
                continue;
            }
            if (ch == end_ch) {
                let v = String.Trim(cur_val);
                if (is_arr) { if (v != "") { Array.Append(result, Config._yScalar(v)); } }
                else if (cur_key != nil) { result[cur_key] = Config._yScalar(v); }
                return { val: result, end: pos };
            }
            if (ch == ",") {
                let v = String.Trim(cur_val);
                if (is_arr) { if (v != "") { Array.Append(result, Config._yScalar(v)); } }
                else if (cur_key != nil) { result[cur_key] = Config._yScalar(v); cur_key = nil; }
                cur_val = ""; continue;
            }
            if (!is_arr && ch == ":") {
                if (pos < n && String.Substr(s, pos, 1) == " ") { pos += 1; }
                cur_key = String.Trim(cur_val); cur_val = ""; continue;
            }
            cur_val += ch;
        }
        return { val: result, end: pos };
    }

    // "|" or ">" with an optional chomping indicator (- strip, + keep) and
    // indentation digit, in either order.
    fn static _yIsBlockHeader(v:string): bool {
        let n = String.Length(v);
        if (n == 0 || n > 3) return false;
        let f = String.Substr(v, 0, 1);
        if (f != "|" && f != ">") return false;
        var chomp = 0; var digit = 0;
        iter (j from 1 to n) {
            let ch = String.Substr(v, j, 1);
            if (ch == "-" || ch == "+") chomp += 1;
            else if (ch >= "1" && ch <= "9") digit += 1;
            else return false;
        }
        return chomp <= 1 && digit <= 1;
    }

    // Reads the block scalar whose header ends the line before lines[i]; the
    // content is indented deeper than parentInd. Returns {val, next}.
    fn static _yBlock(lines, i:int, header:string, parentInd:int) {
        let nlines = len(lines);
        let isLit = String.StartsWith(header, "|");
        let strip = String.Contains(header, "-");
        let keep  = String.Contains(header, "+");
        var base = -1;
        let hn = String.Length(header);
        iter (j from 1 to hn) {
            let ch = String.Substr(header, j, 1);
            if (ch >= "1" && ch <= "9") base = parentInd + Convert.ParseInt(ch);
        }
        let ml = [];
        while (i < nlines) {
            let nl = lines[i];
            let ni = Config._yIndent(nl);
            if (String.Trim(nl) == "") {
                Array.Append(ml, ""); i += 1;
            } else if ((base < 0 && ni > parentInd) || (base >= 0 && ni >= base)) {
                if (base < 0) base = ni;
                Array.Append(ml, String.Substr(nl, base, String.Length(nl) - base));
                i += 1;
            } else {
                break;
            }
        }
        var end = len(ml);
        while (end > 0 && ml[end - 1] == "") end -= 1;
        var body = "";
        if (isLit) {
            iter (j from 0 to end) {
                if (j > 0) body += "\n";
                body += ml[j];
            }
        } else {
            iter (j from 0 to end) {
                let ml_line = ml[j];
                if (ml_line == "") { body += "\n"; }
                else if (body == "" || String.EndsWith(body, "\n")) { body += ml_line; }
                else { body += " " + ml_line; }
            }
        }
        if (!strip && end > 0) body += "\n";
        if (keep) body += String.Repeat("\n", len(ml) - end);
        return { val: body, next: i };
    }

    fn static _parseYaml(src:string) {
        let lines = String.SplitLines(src);
        let nlines = len(lines);
        let root = {};
        // Stack frame: {indent, obj, stype, pending, pind}
        //   indent:  min indent of items in this container (-1 = root)
        //   stype:   "map" or "seq"
        //   pending: pending map key seen as "key:" with no inline value
        //   pind:    indent of the pending key line (-1 = none)
        let stack = [{indent: -1, obj: root, stype: "map", pending: nil, pind: -1}];
        let i = 0;
        while (i < nlines) {
            let line = lines[i]; i += 1;
            let ind = Config._yIndent(line);
            let s   = String.Trim(Config._yStripComment(line));
            // Skip blanks, comments, and document markers
            if (s != "" && s != "---" && s != "...") {
                let isItem = String.StartsWith(s, "- ") || s == "-";
                // Pop frames whose items live at a deeper indent than current line;
                // a sequence at its key's own indent ends at the first non-item line.
                while (len(stack) > 1) {
                    let f = stack[len(stack) - 1];
                    if (f.indent > ind || (!isItem && f.stype == "seq" && f.indent == ind)) {
                        Array.RemoveAt(stack, len(stack) - 1);
                    } else break;
                }
                var top = stack[len(stack) - 1];

                // Resolve pending key: is this line the start of its value?
                // ("key:" followed by "- item" at the key's indent is a sequence too)
                if (top.pending != nil) {
                    if (ind > top.pind || (isItem && ind == top.pind)) {
                        let child  = isItem ? [] : {};
                        top.obj[top.pending] = child;
                        top.pending = nil; top.pind = -1;
                        let frame = {indent: ind, obj: child, stype: isItem ? "seq" : "map", pending: nil, pind: -1};
                        Array.Append(stack, frame);
                        top = frame;
                    } else {
                        top.pending = nil; top.pind = -1;
                    }
                }

                // ── Sequence item ─────────────────────────────────────────
                if (top.stype == "seq" || isItem) {
                    if (Type.Is(top.obj, Type.Array) && isItem) {
                        let val_s = s == "-" ? "" : String.Trim(String.Substr(s, 2, String.Length(s) - 2));
                        if (val_s == "") {
                            let child = {};
                            Array.Append(top.obj, child);
                            Array.Append(stack, {indent: ind + 2, obj: child, stype: "map", pending: nil, pind: -1});
                        } else if (Config._yIsBlockHeader(val_s)) {
                            let r = Config._yBlock(lines, i, val_s, ind);
                            Array.Append(top.obj, r.val); i = r.next;
                        } else if (String.StartsWith(val_s, "[")) {
                            let r = Config._yFlow(val_s, 1, "]"); Array.Append(top.obj, r.val);
                        } else if (String.StartsWith(val_s, "{")) {
                            let r = Config._yFlow(val_s, 1, "}"); Array.Append(top.obj, r.val);
                        } else {
                            let ci = Config._yFindColon(val_s);
                            if (ci >= 0) {
                                let vlen = String.Length(val_s);
                                let k = String.Trim(String.Substr(val_s, 0, ci));
                                let v = ci + 2 <= vlen ? String.Trim(String.Substr(val_s, ci + 2, vlen - ci - 2)) : "";
                                let child = {};
                                if (Config._yIsBlockHeader(v)) {
                                    let r = Config._yBlock(lines, i, v, ind + 2);
                                    child[k] = r.val; i = r.next;
                                } else if (v != "") {
                                    child[k] = Config._yScalar(v);
                                }
                                Array.Append(top.obj, child);
                                Array.Append(stack, {indent: ind + 2, obj: child, stype: "map",
                                                     pending: (v == "" ? k : nil), pind: (v == "" ? ind + 2 : -1)});
                            } else {
                                Array.Append(top.obj, Config._yScalar(val_s));
                            }
                        }
                    }
                } else {
                    // ── Mapping entry ─────────────────────────────────────
                    let ci = Config._yFindColon(s);
                    if (ci >= 0) {
                        let slen  = String.Length(s);
                        let key   = String.Trim(String.Substr(s, 0, ci));
                        let val_s = ci + 2 <= slen ? String.Trim(String.Substr(s, ci + 2, slen - ci - 2)) : "";

                        if (val_s == "") {
                            top.obj[key] = nil;
                            top.pending = key; top.pind = ind;
                        } else if (Config._yIsBlockHeader(val_s)) {
                            let r = Config._yBlock(lines, i, val_s, ind);
                            top.obj[key] = r.val; i = r.next;
                        } else if (String.StartsWith(val_s, "[")) {
                            let r = Config._yFlow(val_s, 1, "]"); top.obj[key] = r.val;
                        } else if (String.StartsWith(val_s, "{")) {
                            let r = Config._yFlow(val_s, 1, "}"); top.obj[key] = r.val;
                        } else {
                            top.obj[key] = Config._yScalar(val_s);
                        }
                    }
                }
            }
        }
        return root;
    }

    // =========================================================================
    // Public API - loading
    // =========================================================================

    // =========================================================================
    // .env (dotenv) loading and ${VAR} interpolation
    // =========================================================================

    fn static _isIdentStart(c:string): bool {
        if (c == "") return false;
        return String.Contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c);
    }

    fn static _isIdentChar(c:string): bool {
        if (c == "") return false;
        return String.Contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", c);
    }

    // Resolve a variable name: already-loaded data, then caller extras, then OS
    // environment. Returns nil if undefined anywhere.
    fn static _lookupVar(name:string, dataObj, extraVars) {
        if (dataObj != nil && Object.HasKey(dataObj, name))   { return dataObj[name]; }
        if (extraVars != nil && Object.HasKey(extraVars, name)) { return extraVars[name]; }
        return Os.Getenv(name);
    }

    // Expand ${VAR}, ${VAR:-default} and $VAR references in a string. "\$" is a
    // literal dollar sign. Undefined variables become "" (or their default).
    fn static _expandVars(s:string, dataObj, extraVars): string {
        var out:string = "";
        var i:int      = 0;
        let n:int      = String.Length(s);
        while (i < n) {
            let ch = String.Substr(s, i, 1);
            let nx = (i + 1 < n) ? String.Substr(s, i + 1, 1) : "";
            if (ch == "\\" && nx == "$") {
                out = out + "$";
                i = i + 2;
            } else if (ch == "$" && nx == "{") {
                let close = String.IndexOfFrom(s, "}", i + 2);
                if (close < 0) {
                    out = out + ch;
                    i = i + 1;
                } else {
                    let inner = String.Substr(s, i + 2, close - (i + 2));
                    var name = inner;
                    var def  = nil;
                    let dd = String.IndexOf(inner, ":-");
                    if (dd >= 0) {
                        name = String.Substr(inner, 0, dd);
                        def  = String.Substr(inner, dd + 2, String.Length(inner) - (dd + 2));
                    }
                    var val = Config._lookupVar(name, dataObj, extraVars);
                    if (val == nil) { val = (def != nil) ? def : ""; }
                    out = out + Convert.ToString(val);
                    i = close + 1;
                }
            } else if (ch == "$" && Config._isIdentStart(nx)) {
                var j:int    = i + 1;
                var name:string = "";
                while (j < n && Config._isIdentChar(String.Substr(s, j, 1))) {
                    name = name + String.Substr(s, j, 1);
                    j = j + 1;
                }
                let val = Config._lookupVar(name, dataObj, extraVars);
                out = out + ((val == nil) ? "" : Convert.ToString(val));
                i = j;
            } else {
                out = out + ch;
                i = i + 1;
            }
        }
        return out;
    }

    // Unescape common sequences inside a double-quoted .env value.
    fn static _envUnescape(s:string): string {
        var r = String.Replace(s, "\\n", "\n");
        r = String.Replace(r, "\\t", "\t");
        r = String.Replace(r, "\\r", "\r");
        r = String.Replace(r, "\\\"", "\"");
        return r;
    }

    // Drop an inline " # comment" from an unquoted value.
    fn static _stripInlineComment(s:string): string {
        let idx = String.IndexOf(s, " #");
        if (idx >= 0) { return String.Substr(s, 0, idx); }
        return s;
    }

    // Parse dotenv text into a flat key->value object. Single-quoted values are
    // taken literally; double-quoted and bare values are interpolated when
    // `interpolate` is true (referencing earlier keys + OS env).
    fn static _parseEnv(text:string, interpolate:bool): object {
        let result = {};
        let lines = String.Split(text, "\n");
        foreach (rawLine in lines) {
            var line = String.Trim(rawLine);
            if (line != "" && !String.StartsWith(line, "#")) {
                if (String.StartsWith(line, "export ")) {
                    line = String.Trim(String.Substr(line, 7, String.Length(line) - 7));
                }
                let eq = String.IndexOf(line, "=");
                if (eq > 0) {
                    let key = String.Trim(String.Substr(line, 0, eq));
                    let tv  = String.Trim(String.Substr(line, eq + 1, String.Length(line) - eq - 1));
                    var val:string  = "";
                    var doInterp    = interpolate;
                    let tvLen = String.Length(tv);
                    if (tvLen >= 2 && String.StartsWith(tv, "\"") && String.EndsWith(tv, "\"")) {
                        val = Config._envUnescape(String.Substr(tv, 1, tvLen - 2));
                    } else if (tvLen >= 2 && String.StartsWith(tv, "'") && String.EndsWith(tv, "'")) {
                        val = String.Substr(tv, 1, tvLen - 2);
                        doInterp = false;                       // literal, no interpolation
                    } else {
                        val = String.Trim(Config._stripInlineComment(tv));
                    }
                    if (doInterp) { val = Config._expandVars(val, result, nil); }
                    if (key != "") { result[key] = val; }
                }
            }
        }
        return result;
    }

    // Load dotenv-format text. Keys are merged (flat) into the config. When
    // `interpolate` is omitted or true, ${VAR}/$VAR references are expanded
    // against earlier keys and the OS environment.
    fn LoadEnv(text:string, interpolate?: bool): instance {
        let interp = (interpolate == nil) ? true : interpolate;
        let parsed = Config._parseEnv(text, interp);
        foreach (v, k in parsed) { this._data[k] = v; }
        return this;
    }

    fn LoadEnvFile(path:string, interpolate?: bool): instance {
        return this.LoadEnv(File.ReadText(path), interpolate);
    }

    // Re-expand ${VAR}/$VAR references in all top-level string values, resolving
    // against the config itself, optional extraVars, then the OS environment.
    fn Interpolate(extraVars?): instance {
        let keys = Object.Keys(this._data);
        foreach (k in keys) {
            let v = this._data[k];
            if (Type.Is(v, Type.String)) {
                this._data[k] = Config._expandVars(v, this._data, extraVars ?? nil);
            }
        }
        return this;
    }

    fn Load(text:string): instance {
        this._data = Config._parseToml(text);
        return this;
    }

    fn LoadFile(path:string): instance {
        return this.Load(File.ReadText(path));
    }

    fn LoadYaml(text:string): instance {
        this._data = Config._parseYaml(text);
        return this;
    }

    fn LoadYamlFile(path:string): instance {
        return this.LoadYaml(File.ReadText(path));
    }

    // =========================================================================
    // Public API - reading
    //
    // All typed getters take an explicit default_val.
    // Pass nil if you want nil returned when key is missing.
    // =========================================================================

    fn Get(key:string) {
        let parts = String.Split(key, ".");
        var o = this._data;
        foreach (p in parts) {
            if (o == nil || !Type.Is(o, Type.Object)) return nil;
            o = o[p];
        }
        return o;
    }

    fn GetString(key:string, default_val?) {
        let v = this.Get(key);
        if (v == nil) return default_val ?? nil;
        return str(v);
    }

    fn GetInt(key:string, default_val?) {
        let v = this.Get(key);
        if (v == nil) return default_val ?? nil;
        return Convert.ToInt(v);
    }

    fn GetFloat(key:string, default_val?) {
        let v = this.Get(key);
        if (v == nil) return default_val ?? nil;
        return Convert.ToFloat(v);
    }

    fn GetBool(key:string, default_val?) {
        let v = this.Get(key);
        if (v == nil) return default_val ?? nil;
        return v == true || v == 1;
    }

    fn GetArray(key:string): array {
        let v = this.Get(key);
        if (!Type.Is(v, Type.Array)) return [];
        return v;
    }

    fn Has(key:string): bool {
        return this.Get(key) != nil;
    }

    // =========================================================================
    // Public API - writing
    // =========================================================================

    fn Set(key:string, value): instance {
        Config._setDotted(this._data, String.Split(key, "."), value);
        return this;
    }

    fn Remove(key:string): bool {
        let parts = String.Split(key, ".");
        var o   = this._data;
        var n   = len(parts);
        var idx = 0;
        foreach (p in parts) {
            if (idx == n - 1) break;
            o = o[p];
            if (o == nil) return false;
            idx += 1;
        }
        let last = parts[n - 1];
        if (!Object.HasKey(o, last)) return false;
        Object.Delete(o, last);
        return true;
    }

    // =========================================================================
    // Public API - sections
    // =========================================================================

    fn Sections(): array {
        var result = [];
        foreach (entry in Object.Entries(this._data)) {
            if (Type.Is(entry[1], Type.Object)) Array.Append(result, entry[0]);
        }
        return result;
    }

    fn GetSection(name:string): object {
        let v = this.Get(name);
        if (v == nil) return {};
        return v;
    }

    // Keys in a section (or top-level if section is nil / "")
    fn Keys(section?:string): array {
        var obj = this._data;
        if (section != nil && section != "") {
            obj = this.GetSection(section);
        }
        var result = [];
        foreach (entry in Object.Entries(obj)) {
            Array.Append(result, entry[0]);
        }
        return result;
    }

    // Merge all keys from another Config into this one (other wins on conflict)
    fn Merge(other:instance): instance {
        foreach (entry in Object.Entries(other._data)) {
            this._data[entry[0]] = entry[1];
        }
        return this;
    }

    // For each key in obj that is NOT already set in this._data, set it.
    // Existing (non-nil) top-level keys are left untouched. Returns this.
    fn Defaults(obj): instance {
        foreach (entry in Object.Entries(obj)) {
            let k = entry[0];
            if (!Object.HasKey(this._data, k) || this._data[k] == nil) {
                this._data[k] = entry[1];
            }
        }
        return this;
    }

    // Create a Config instance wrapping an existing object.
    fn static FromObject(obj): instance {
        let c = new Config();
        c._data = obj;
        return c;
    }

    // =========================================================================
    // Public API - serializing
    // =========================================================================

    fn ToString(): string {
        var s = Config._serializeSection(this._data, "");
        // trim any leading newline that appears when first key is a section
        if (String.StartsWith(s, "\n")) {
            s = String.Substr(s, 1, String.Length(s) - 1);
        }
        return s;
    }

    fn Save(path:string): instance {
        File.WriteText(path, this.ToString());
        return this;
    }
}

export { Config };
