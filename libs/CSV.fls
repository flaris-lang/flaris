// CSV.fls - CSV parser and serializer for Flaris.
// Version: 1.0
//
// RFC 4180: quoted fields, embedded delimiters, embedded newlines, doubled
// quotes, and LF, CRLF or CR line endings. Blank lines are skipped and a UTF-8
// byte-order mark at the start of the input is dropped. TSV: pass
// { delimiter: "\t" }. The delimiter, quote and comment options are single
// characters.
//
// Records that do not contain the quote character are split natively
// (String.SplitLines + String.Split); only records that do contain it go
// through the RFC 4180 state machine.
//
// Usage:
//   import { CSV } from library("CSV", "1.0");
//
//   // Parse string - with header row → array of objects
//   let rows = CSV.Parse("name,age\nAlice,30\nBob,25", { headers: true });
//   Console.WriteLine(rows[0].name);   // "Alice"
//   Console.WriteLine(rows[0].age);    // "30" (or 30 if types:true)
//
//   // Parse without headers → array of arrays of strings
//   let grid = CSV.Parse("1,2\n3,4");                   // [["1","2"],["3","4"]]
//   let nums = CSV.Parse("1,2\n3,4", { types: true });  // [[1,2],[3,4]]
//
//   // Parse directly from a file
//   let rows = CSV.ParseFile("data.csv", { headers: true, types: true });
//
//   // Serialize array of objects or arrays back to CSV string
//   let csv = CSV.Stringify(rows);          // headers auto-detected from object keys
//   CSV.WriteFile("out.csv", rows);         // write to file
//   CSV.AppendFile("log.csv", newRows);     // append; suppresses duplicate header row
//
//   // Stream a large file: it is read 64 KB at a time, so memory stays bounded
//   CSV.ForEachFile("big.csv", fn(row, i) {
//       Console.WriteLine(row.name);
//   }, { headers: true });
//
//   // Read only the first n data rows of a file (the header row is not counted)
//   let preview = CSV.Head("data.csv", 5, { headers: true });
//
//   // Look up a column index by name
//   let idx = CSV.ColumnIndex(["name","age","city"], "age");  // => 1
//
// Options (opts object, all optional):
//   delimiter : string  - field separator; default ","
//   quote     : string  - quote character; default "\""; "" turns quoting off
//   headers   : bool|array - Parse: true = use first row as header (returns objects)
//                            Stringify/Write: array of column names sets order
//   trim      : bool    - Parse: strip whitespace from each field
//   types     : bool    - Parse: convert numbers and booleans (rule below)
//   nullValues: array   - Parse (with types): field strings to treat as nil
//                         (e.g. ["", "NA", "null"]); default keeps "" as ""
//   comment   : string  - Parse: skip lines starting with this char (e.g. "#")
//   crlf      : bool    - Stringify/Write: use \r\n line endings (RFC 4180 strict)
//   quoting   : string  - Stringify/Write: which fields are quoted
//                           "minimal"    (default) fields that contain the
//                                        delimiter, the quote, CR or LF
//                           "all"        every field
//                           "nonnumeric" every field that is not an int or float
//   sanitize  : bool    - Stringify/Write: escape formula-injection in string
//                         fields (prefix a leading = + - @ TAB or CR with ');
//                         numbers untouched
//
// Type inference (types: true, and CSV.Infer):
//   "true" / "false" in any case                    → bool
//   optional "-", digits, no leading zero ("0" ok)  → int (float beyond int64)
//   the same plus a fraction and/or an exponent
//   ("2.50", "-0.5", "1e-3")                        → float
//   anything else stays the original string, so "007", "+5", "0x1F", " 12",
//   "1.", "nan" and "Inf" are strings.
//
// Writing: nil is an empty field, a float is written in the shortest form that
// reads back as the same float ("0.1", "2.0"; NaN and the infinities as "nan",
// "inf", "-inf"), and a char as the character itself.
//
// API:
//   CSV.Parse(src:string, opts?)            →  array of objects (headers) or arrays
//   CSV.ParseFile(path:string, opts?)       →  same, reads from file
//   CSV.ParseLine(line:string, delim?, quote?) →  array of field strings (one row)
//   CSV.ForEach(src:string, fn(row,i), opts?)  - call fn for each data row
//   CSV.ForEachFile(path, fn(row,i), opts?)    - same, streaming the file
//   CSV.Head(path:string, n:int, opts?)     →  first n data rows of the file
//   CSV.Stringify(rows:array, opts?)        →  CSV string
//   CSV.WriteFile(path, rows, opts?)        - write CSV to file
//   CSV.AppendFile(path, rows, opts?)       - append to file (no duplicate header)
//   CSV.ColumnIndex(headers:array, name)    →  int  (-1 if not found)
//   CSV.Infer(s:string)                     →  inferred scalar (bool/int/float/string)
//
// In ForEach / ForEachFile, i is the 0-based data-row index; it is passed only
// to a callback that declares a second parameter, so fn(row) works too.

class CSV {

    // Bytes of input per scan step, and per read when streaming a file.
    const _CHUNK = 65536;

    // =========================================================================
    // Options and cursor
    // =========================================================================

    fn static _cur(src:string) {
        return { s: src, p: 0, n: String.Length(src) };
    }

    // Byte value of a single-character option string ("," -> 44); -1 when the
    // option is empty so it can never match a real byte.
    fn static _optByte(s:string): int {
        if (String.Length(s) == 0) return -1;
        return int(s[0]);   // s[i] is a char; the byte scanners compare against ints
    }

    fn static _on(v): bool { return v != nil && v != false; }

    // Parse options, resolved once per call.
    fn static _readOpts(opts?) {
        let delim   = (opts != nil and opts.delimiter != nil) ? opts.delimiter : ",";
        let quote   = (opts != nil and opts.quote     != nil) ? opts.quote     : "\"";
        let comment = (opts != nil and opts.comment   != nil) ? opts.comment   : "";
        return {
            delim:    delim,
            quote:    quote,
            delimB:   CSV._optByte(delim),
            quoteB:   CSV._optByte(quote),
            commentB: CSV._optByte(comment),
            stopSet:  delim + "\r\n",
            headers:  opts != nil and CSV._on(opts.headers),
            trim:     opts != nil and CSV._on(opts.trim),
            types:    opts != nil and CSV._on(opts.types),
            nulls:    (opts != nil) ? opts.nullValues : nil,
        };
    }

    // Length of a leading UTF-8 byte-order mark: 3 or 0.
    fn static _bomLen(s:string): int {
        return String.StartsWith(s, "\u{FEFF}") ? 3 : 0;
    }

    // =========================================================================
    // RFC 4180 state machine - used for records that contain the quote
    //
    // The scanners work on raw bytes (s[i] returns an int) so the hot loops
    // allocate nothing; field text is materialized with a single Substr per
    // run.
    // =========================================================================

    // Skip one newline sequence (LF or CRLF) at current cursor position.
    fn static _skipNl(c) {
        if (c.p >= c.n) return;
        let b = c.s[c.p];
        if (b == 13) {                                   // \r
            c.p += 1;
            if (c.p < c.n and c.s[c.p] == 10) c.p += 1;  // \n
        } else if (b == 10) {                            // \n
            c.p += 1;
        }
    }

    // Parse one field from the cursor. Returns the field string and leaves the
    // cursor on the trailing delimiter or line ending.
    //
    // The scan moves run to run rather than byte by byte: String.IndexOfAnyFrom
    // finds the next delimiter, CR or LF that ends an unquoted field, and
    // String.IndexOfFrom the next quote inside a quoted one, so each stretch of
    // ordinary text is copied out in a single Substr. stopSet (the delimiter
    // plus CR and LF) and quoteS are assembled once per parse by the caller and
    // passed down, since they are the same for every field in the document.
    fn static _parseField(c, quoteB:int, stopSet:string, quoteS:string): string {
        let src = c.s;
        let n   = c.n;
        let p   = c.p;

        if (p < n and src[p] == quoteB) {
            // Quoted field - consume everything up to the closing quote.
            // A doubled quote inside is an escaped quote character.
            p += 1;
            let out = "";
            let runStart = p;
            while (true) {
                let q = String.IndexOfFrom(src, quoteS, p);
                if (q < 0) {
                    let tail = String.Substr(src, runStart, n - runStart);
                    out += tail;
                    p = n;
                    break;
                }
                p = q;
                if (p + 1 < n and src[p + 1] == quoteB) {
                    // Escaped quote: keep the run plus one quote byte.
                    let run = String.Substr(src, runStart, p - runStart + 1);
                    out += run;
                    p += 2;
                    runStart = p;
                } else {
                    let run = String.Substr(src, runStart, p - runStart);
                    out += run;
                    p += 1;
                    break;
                }
            }
            c.p = p;
            return out;
        }

        // Unquoted field - read until delimiter, CR, LF, or end.
        let start = p;
        let stop  = String.IndexOfAnyFrom(src, stopSet, p);
        p = (stop < 0) ? n : stop;
        c.p = p;
        return String.Substr(src, start, p - start);
    }

    // Parse one complete row. Returns array of field strings, or nil at EOF.
    fn static _parseRow(c, delimB:int, quoteB:int, stopSet:string, quoteS:string) {
        let src = c.s;
        let n   = c.n;
        if (c.p >= n) return nil;
        let row = [];
        while (true) {
            let field = CSV._parseField(c, quoteB, stopSet, quoteS);
            Array.Append(row, field);
            let p = c.p;
            if (p >= n) break;
            if (src[p] == delimB) {
                c.p = p + 1;   // consume delimiter and read next field
            } else {
                CSV._skipNl(c);
                break;
            }
        }
        return row;
    }

    // =========================================================================
    // Type coercion
    // =========================================================================

    // The value a field takes under the type-inference rule in the header.
    // Fields listed in `nullSet` (when given) become nil.
    fn static _coerceVal(s:string, nullSet) {
        if (nullSet != nil && Array.Contains(nullSet, s)) return nil;
        let n:int = len(s);
        if (n == 0) return s;
        let fv = Convert.ParseFloat(s);
        if (fv != nil) {
            // ParseFloat also takes whitespace, a "+", hex, "inf" and "nan";
            // this shape check admits plain decimals only.
            let i:int = (s[0] == 45) ? 1 : 0;                  // '-'
            if (i >= n || s[i] < 48 || s[i] > 57) return s;
            let last = s[n - 1];
            if (last < 48 || last > 57) return s;
            if (s[i] == 48 && i + 1 < n) {
                let d = s[i + 1];
                if (d != 46 && d != 101 && d != 69) return s;  // '.', 'e', 'E'
            }
            let iv = Convert.ParseInt(s);
            if (iv != nil) return iv;
            return fv;
        }
        if (n == 4 || n == 5) {
            if (String.EqualsIgnoreCase(s, "true"))  return true;
            if (String.EqualsIgnoreCase(s, "false")) return false;
        }
        return s;
    }

    // Public single-value type inference (booleans, ints, floats, else string).
    fn static Infer(s:string) { return CSV._coerceVal(s, nil); }

    // Apply type inference to every element of a row array in-place.
    fn static _coerceRow(row:array, nullSet) {
        iter (i from 0 to len(row)) {
            row[i] = CSV._coerceVal(row[i], nullSet);
        }
    }

    // =========================================================================
    // Record scanner
    //
    // A record without the quote character cannot hold a quoted delimiter or
    // line break, so a stretch of such records is split natively. Only a record
    // that contains the quote goes through _parseRow.
    // =========================================================================

    // Parse about one chunk of records from byte `p` into `out` (an array of
    // field strings per record) and return the offset to resume from. Unless
    // `final`, a record is taken only once its line break is in `src`, so a
    // streaming caller can append input and resume at the returned offset.
    fn static _scan(src:string, p:int, out:array, o, final:bool): int {
        let n:int = len(src);
        var safe:int = n;
        if (!final) {
            safe = String.LastIndexOfAny(src, "\r\n");
            if (safe < 0) return p;
        }
        let budget:int   = p + CSV._CHUNK;
        let delim:string = o.delim;
        let quote:string = o.quote;
        let quoteB:int   = o.quoteB;
        let commentB:int = o.commentB;
        let split:bool   = len(delim) > 0;

        while (p < safe && p < budget) {
            let q:int = (quoteB < 0) ? -1 : String.IndexOfFrom(src, quote, p);
            var stop:int = (q < 0 || q > safe) ? safe : q;
            if (stop > budget) {
                let e:int = String.IndexOfAnyFrom(src, "\r\n", budget);
                if (e >= 0 && e < stop) { stop = e; }
            }

            // Quote-free records in [p, stop). When the stretch ends at a quote
            // mid-line, its last line is the start of the quoted record.
            var next:int = stop;
            if (stop > p) {
                let lines = String.SplitLines(String.Substr(src, p, stop - p));
                var m:int = len(lines);
                if (stop == q && m > 0) {
                    let prev = src[stop - 1];
                    if (prev != 10 && prev != 13) {
                        m -= 1;
                        next = stop - len(lines[m]);
                    }
                }
                iter (i from 0 to m) {
                    let line:string = lines[i];
                    if (len(line) == 0 || line[0] == commentB) { continue; }
                    if (split) { Array.Append(out, String.Split(line, delim)); }
                    else       { Array.Append(out, [line]); }
                }
            }
            if (stop != q) { p = stop; continue; }

            p = next;
            if (src[p] == commentB) {
                let e:int = String.IndexOfAnyFrom(src, "\r\n", p);
                p = (e < 0) ? n : e;
                continue;
            }
            let c = { s: src, p: p, n: n };
            let row = CSV._parseRow(c, o.delimB, quoteB, o.stopSet, quote);
            if (!final && c.p >= n) { return p; }
            Array.Append(out, row);
            p = c.p;
        }
        return p;
    }

    // =========================================================================
    // Row shaping: trim, header row, objects, types
    // =========================================================================

    // Append the finished form of each raw row to `sink`. With headers on, the
    // first row seen becomes st.hdrs and is not emitted.
    fn static _shape(raw:array, o, st, sink:array) {
        let doTrim:bool  = o.trim;
        let doTypes:bool = o.types;
        let nulls = o.nulls;
        foreach (row in raw) {
            if (doTrim) { Array.Process(row, String.Trim); }
            if (o.headers && st.hdrs == nil) {
                st.hdrs = row;
                continue;
            }
            let hdrs = st.hdrs;
            if (hdrs != nil) {
                let nh:int = len(hdrs);
                while (len(row) < nh) { Array.Append(row, ""); }
                if (doTypes) { CSV._coerceRow(row, nulls); }
                let obj = {};
                iter (i from 0 to nh) { obj[hdrs[i]] = row[i]; }
                Array.Append(sink, obj);
            } else {
                if (doTypes) { CSV._coerceRow(row, nulls); }
                Array.Append(sink, row);
            }
        }
    }

    fn static _plain(o): bool { return !o.trim && !o.headers && !o.types; }

    // True when `callback` declares a second parameter for the row index.
    fn static _takesIndex(callback): bool {
        let info = VM.GetFunctionInfo(callback);
        return info != nil && info.Arity >= 2;
    }

    fn static _call(callback, withIndex:bool, rows:array, first:int) {
        var i:int = first;
        foreach (row in rows) {
            if (withIndex) { callback(row, i); } else { callback(row); }
            i += 1;
        }
    }

    // Stream a file through _scan one chunk at a time. Rows go to `callback`,
    // or, when it is nil, to `sink` until it holds `limit` rows (limit < 0: all).
    fn static _fileRows(path:string, o, callback, sink:array, limit:int) {
        let s = Stream.Open(path, "r");
        if (s == nil) { return; }
        let withIndex:bool = (callback != nil) && CSV._takesIndex(callback);
        let st     = { hdrs: nil };
        let batch  = [];
        let shaped = [];
        var buf:string = "";
        var first:bool = true;
        var final:bool = false;
        var count:int = 0;
        while (!final) {
            let chunk = Stream.ReadString(s, CSV._CHUNK);
            if (chunk == nil) {
                final = true;
            } else {
                if (first) { chunk = String.Substr(chunk, CSV._bomLen(chunk)); }
                buf += chunk;
            }
            first = false;
            let n:int = len(buf);
            var p:int = 0;
            while (p < n) {
                let next:int = CSV._scan(buf, p, batch, o, final);
                if (next == p) { break; }
                p = next;
            }
            buf = (p >= n) ? "" : String.Substr(buf, p);
            CSV._shape(batch, o, st, shaped);
            Array.Clear(batch);
            if (callback != nil) {
                CSV._call(callback, withIndex, shaped, count);
                count += len(shaped);
            } else {
                foreach (row in shaped) {
                    if (limit >= 0 && len(sink) >= limit) { break; }
                    Array.Append(sink, row);
                }
                if (limit >= 0 && len(sink) >= limit) { break; }
            }
            Array.Clear(shaped);
        }
        Stream.Close(s);
    }

    // =========================================================================
    // Public API - parsing
    // =========================================================================

    // Parse a single line of CSV text. Useful for one-off / streaming use.
    // delim: field separator (default ",")
    // quote: quote character (default "\"")
    fn static ParseLine(line:string, delim?:string, quote?:string) {
        let d = (delim != nil) ? delim : ",";
        let q = (quote != nil) ? quote : "\"";
        let c = CSV._cur(line);
        let row = CSV._parseRow(c, CSV._optByte(d), CSV._optByte(q), d + "\r\n", q);
        return (row != nil) ? row : [];
    }

    // Parse a CSV string. Returns array of arrays (default) or array of objects
    // when opts.headers is true (first row becomes property names).
    fn static Parse(src:string, opts?) {
        let result = [];
        if (src == nil) { return result; }
        let o = CSV._readOpts(opts);
        let n:int = len(src);
        var p:int = CSV._bomLen(src);
        if (CSV._plain(o)) {
            while (p < n) { p = CSV._scan(src, p, result, o, true); }
            return result;
        }
        let st = { hdrs: nil };
        let batch = [];
        while (p < n) {
            p = CSV._scan(src, p, batch, o, true);
            CSV._shape(batch, o, st, result);
            Array.Clear(batch);
        }
        return result;
    }

    // Read a file and parse its contents as CSV.
    fn static ParseFile(path:string, opts?) {
        return CSV.Parse(File.ReadText(path), opts);
    }

    // Call callback(row) or callback(row, i) for each data row.
    fn static ForEach(src:string, callback, opts?) {
        if (src == nil) { return; }
        let o = CSV._readOpts(opts);
        let withIndex:bool = CSV._takesIndex(callback);
        let st = { hdrs: nil };
        let batch  = [];
        let shaped = [];
        let n:int = len(src);
        var p:int = CSV._bomLen(src);
        var count:int = 0;
        while (p < n) {
            p = CSV._scan(src, p, batch, o, true);
            CSV._shape(batch, o, st, shaped);
            Array.Clear(batch);
            CSV._call(callback, withIndex, shaped, count);
            count += len(shaped);
            Array.Clear(shaped);
        }
    }

    // ForEach over a file, read 64 KB at a time. A missing file yields no rows.
    fn static ForEachFile(path:string, callback, opts?) {
        CSV._fileRows(path, CSV._readOpts(opts), callback, nil, -1);
    }

    // The first n data rows of a file; reading stops once they are parsed.
    fn static Head(path:string, n:int, opts?) {
        let result = [];
        if (n <= 0) { return result; }
        CSV._fileRows(path, CSV._readOpts(opts), nil, result, n);
        return result;
    }

    // =========================================================================
    // Public API - serialization
    // =========================================================================

    // Writer options, resolved once per call. mode: 0 minimal, 1 all, 2 nonnumeric.
    fn static _writeOpts(opts?) {
        let delim = (opts != nil and opts.delimiter != nil) ? opts.delimiter : ",";
        let quote = (opts != nil and opts.quote     != nil) ? opts.quote     : "\"";
        let quoting = (opts != nil) ? opts.quoting : nil;
        var mode:int = 0;
        if (quoting == "all") {
            mode = 1;
        } else if (quoting == "nonnumeric") {
            mode = 2;
        } else if (quoting != nil && quoting != "minimal") {
            throw(1, "CSV: unknown quoting mode '" + str(quoting) + "'");
        }
        return {
            delim:    delim,
            quote:    quote,
            special:  delim + quote + "\r\n",
            mode:     mode,
            sanitize: opts != nil and CSV._on(opts.sanitize),
            nl:       (opts != nil and CSV._on(opts.crlf)) ? "\r\n" : "\n",
        };
    }

    // Defuse CSV formula injection: a spreadsheet treats a cell beginning with
    // = + - @ (or TAB/CR) as a formula, so prefix such string fields with a
    // single quote. Only applied to string values - numbers are left intact.
    fn static _sanitizeField(field:string): string {
        if (field == "") return field;
        let c = String.Substr(field, 0, 1);
        if (c == "=" or c == "+" or c == "-" or c == "@" or c == "\t" or c == "\r") {
            return "'" + field;
        }
        return field;
    }

    // Field text of a value that is not a string, before quoting.
    fn static _text(v): string {
        let t = type(v);
        if (t == Type.Nil) return "";
        if (t == Type.Float) {
            let s:string = Json.Stringify(v);   // shortest text that reads back as v
            return (s == "null") ? Convert.ToString(v) : s;   // nan, inf, -inf
        }
        if (t == Type.Char) return "" + v;
        return str(v);
    }

    // One row (array of values) as a CSV line, field by field.
    fn static _line(row:array, w): string {
        let quote:string   = w.quote;
        let special:string = w.special;
        let mode:int       = w.mode;
        let doSan:bool     = w.sanitize;
        let n:int = len(row);
        let parts = Array.Create(n);
        iter (i from 0 to n) {
            let v = row[i];
            let t = type(v);
            var f:string = "";
            if (t == Type.String) {
                f = doSan ? CSV._sanitizeField(v) : v;
            } else {
                f = CSV._text(v);
            }
            if (quote != "" && (mode == 1 || (mode == 2 && t != Type.Int && t != Type.Float)
                                || String.IndexOfAnyFrom(f, special, 0) >= 0)) {
                f = quote + String.Replace(f, quote, quote + quote) + quote;
            }
            parts[i] = f;
        }
        return String.Join(parts, w.delim);
    }

    // Append the CSV line of each row to `lines`; object rows are laid out in
    // `keys` order. A row of plain strings that needs no quoting is joined in
    // one native call.
    fn static _lines(rows:array, keys, isObjs:bool, w, lines:array) {
        let fast:bool = (w.mode == 0) && !w.sanitize;
        let delim:string = w.delim;
        let others:string = w.quote + "\r\n";   // the special bytes besides the delimiter
        let nk:int = (keys != nil) ? len(keys) : 0;
        foreach (row in rows) {
            var r = row;
            if (isObjs) {
                r = Array.Create(nk);
                iter (j from 0 to nk) { r[j] = row[keys[j]]; }
            }
            if (fast && Array.All(r, Type.IsString)) {
                let line:string = String.Join(r, delim);
                if (String.IndexOfAnyFrom(line, others, 0) < 0
                        && String.Count(line, delim) == len(r) - 1) {
                    Array.Append(lines, line);
                    continue;
                }
            }
            Array.Append(lines, CSV._line(r, w));
        }
    }

    // Serialize rows to a CSV string.
    //   rows: array of arrays  - written as-is
    //   rows: array of objects - opts.headers sets column order;
    //                            falls back to Object.Keys(rows[0])
    fn static Stringify(rows:array, opts?): string {
        if (len(rows) == 0) return "";
        let w = CSV._writeOpts(opts);
        var hdrKeys = (opts != nil) ? opts.headers : nil;
        if (type(hdrKeys) != Type.Array) { hdrKeys = nil; }
        let isObjs:bool = type(rows[0]) == Type.Object;
        if (isObjs and hdrKeys == nil) {
            hdrKeys = Object.Keys(rows[0]);
        }
        let lines = [];
        if (hdrKeys != nil) { Array.Append(lines, CSV._line(hdrKeys, w)); }
        CSV._lines(rows, hdrKeys, isObjs, w, lines);
        Array.Append(lines, "");        // so the text ends with a line break
        return String.Join(lines, w.nl);
    }

    // Serialize and write directly to a file.
    fn static WriteFile(path:string, rows:array, opts?) {
        return File.WriteText(path, CSV.Stringify(rows, opts));
    }

    // Append rows to an existing CSV file, or create it if it does not exist.
    // When the file already has content the header row is suppressed: object
    // rows are laid out in the order of the existing header line. When the file
    // is new (or empty) rows are written with opts as-is (headers included by
    // default for object rows).
    fn static AppendFile(path:string, rows:array, opts?) {
        let size = File.Size(path);
        if (size == nil || size == 0) { return CSV.WriteFile(path, rows, opts); }
        if (len(rows) == 0) return true;
        let w = CSV._writeOpts(opts);
        let s = Stream.Open(path, "r");
        if (s == nil) return false;
        let header = Stream.ReadLine(s);
        Stream.Seek(s, size - 1);
        let lastByte = Stream.ReadByte(s);
        Stream.Close(s);
        let isObjs:bool = type(rows[0]) == Type.Object;
        var keys = nil;
        if (isObjs) {
            keys = CSV.ParseLine(String.Substr(header, CSV._bomLen(header)), w.delim, w.quote);
        }
        let lines = [];
        CSV._lines(rows, keys, isObjs, w, lines);
        Array.Append(lines, "");
        var text:string = String.Join(lines, w.nl);
        if (lastByte != 10 && lastByte != 13) { text = w.nl + text; }
        return File.AppendText(path, text);
    }

    // Return the zero-based index of `name` in the headers array,
    // or -1 if not found.
    fn static ColumnIndex(headers:array, name:string) : int {
        iter (i from 0 to len(headers)) {
            if (str(headers[i]) == name) return i;
        }
        return -1;
    }
}

export { CSV };
