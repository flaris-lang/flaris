// Logger.fls - Structured logger for Flaris.
// Version: 1.0
//
// Levels (lowest to highest): DEBUG(0)  INFO(1)  WARN(2)  ERROR(3)  FATAL(4)
// Only messages at or above the current level are written.
//
// Usage:
//   import { Logger } from library("Logger", "1.0");
//
//   let log = new Logger();
//   log.SetLevel("info");               // or Logger.INFO
//   log.Info("server started", { port: 8080 });
//   log.Warn("high memory");
//   log.Error("db error", { code: 500 });
//
//   // Output to file
//   log.SetOutput("file", "app.log");
//
//   // Child logger with inherited level + prefix
//   let dbLog = log.Child("[db]");
//   dbLog.Debug("query", { sql: "SELECT ..." });
//
//   // Context fields carried by every record of a derived logger
//   let reqLog = log.With({ request: "a1f3", user: 42 });
//   reqLog.Info("served", { status: 200 });   // [INF] served {"request":"a1f3","user":42,"status":200}
//
//   // More destinations, each with its own level and format
//   log.AddSink("file", { path: "app.log", level: "debug", format: "json" });
//   log.AddSink("syslog", { host: "10.0.0.5", level: "error" });
//
//   // Your own line format
//   log.SetFormatter(fn(r) { return r.levelName + " " + r.msg; });
//
// API:
//   SetLevel(level:int|string)          - "debug"/"info"/"warn"/"error"/"fatal" or int
//   GetLevel()  →  int
//   SetOutput(sink, path?)              - "console" (default), "file" (needs path), "syslog"
//   SetSyslog(host, port?)              - UDP syslog; default port 514
//   Enable() / Disable() / IsEnabled()
//   SetPrefix(s)                        - string prepended to every message
//   SetTimestamp(bool)                  - prepend ISO timestamp
//   SetColor(bool)                      - ANSI level colors (console only)
//   SetJson(bool)                       - emit one JSON object per line
//                                         ({ time, level, msg, ...fields })
//   SetRotation(maxBytes, maxFiles?)    - rotate the file sink at maxBytes,
//                                         keeping maxFiles backups (<file>.1 …)
//   Log(level, msg, obj?)               - generic log
//   Debug(msg, obj?)  Info(msg, obj?)  Warn(msg, obj?)
//   Error(msg, obj?)  Fatal(msg, obj?)
//   DebugWith(msg, fields)  InfoWith(msg, fields)    - structured key/value fields
//   WarnWith(msg, fields)   ErrorWith(msg, fields)
//   Child(prefix)  →  Logger            - inherits level and format, adds prefix,
//                                         and writes through this logger's sink
//   With(fields)   →  Logger            - like Child without a prefix: every record
//                                         carries fields (and this logger's own),
//                                         a record's own fields winning on a clash
//   AddSink(kind, opts?)                - one more destination for this logger's
//                                         records: "stdout", "stderr", "file"
//                                         (opts.path) or "syslog" (opts.host,
//                                         opts.port, default 514). opts:
//                                           level     - its own minimum level
//                                                       (default: the logger's now)
//                                           format    - "text", "json" or a
//                                                       formatter fn(record) (default:
//                                                       whatever the writing logger uses)
//                                           timestamp - prepend the time (text format;
//                                                       default: the logger's setting now)
//                                           color     - ANSI level colors on a console
//                                           maxBytes, maxFiles - rotation of a file
//                                         A syslog sink sends "flaris: [TAG] msg fields"
//                                         unless its format is "json" or a function.
//   RemoveSinks()                       - close and drop the sinks AddSink added
//   SetFormatter(fn(record))            - render every record with fn; nil restores
//                                         the text / JSON format. record is
//                                         { time, level, levelName, msg, logger, fields }
//                                         (time in Unix seconds, logger the prefix,
//                                         fields an object or nil; msg and fields
//                                         as given, not escaped); fn returns the
//                                         line, or nil to drop the record
//   static LevelName(int)  →  string    - "DEBUG", "INFO", etc.
//
// Constants:  Logger.DEBUG  Logger.INFO  Logger.WARN  Logger.ERROR  Logger.FATAL
//
// Sinks: the destination (console, file, syslog) and the file's rotation live
// in a sink that a logger and all its children (Child, With) share, so a
// rotation by any of them moves every writer to the new file and syslog
// reaches theirs too. The sinks AddSink adds hang off that shared sink, so the
// children write to them as well. SetRotation, SetSyslog, AddSink, RemoveSinks
// and Flush act on the shared sink; SetOutput on a child gives the child a sink
// of its own (without the added ones) and leaves the parent's alone; Close on a
// child flushes but leaves the shared sink open for the others.

// Where records go: console, file (with its rotation state) and syslog. Shared
// between a logger and its children; it holds no reference back to them.
class _LogSink {
    let kind:int      = 0;      // 0 stdout, 1 stderr, 2 file, 3 syslog alone
    let file:string   = nil;
    let stream        = nil;    // open stream for the file sink (avoids open/close per call)
    let syslog        = nil;
    let syshost:string = "";
    let maxBytes:int  = 0;      // rotation threshold (0 = disabled)
    let maxFiles:int  = 5;      // number of rotated backups to keep
    let written:int   = 0;      // bytes written to the current file since open
    let more          = nil;    // the sinks AddSink added (an array), or nil
    let moreMin:int   = 99;     // the lowest level among them
    // An added sink's own settings.
    let level:int     = 0;
    let format        = nil;    // nil (the writing logger's), "text", "json" or fn(record)
    let color:bool    = false;
    let timestamp:bool = false;

    fn CloseFile() {
        if (this.stream != nil) {
            Stream.Close(this.stream);
            this.stream = nil;
        }
    }

    fn CloseSyslog() {
        if (this.syslog != nil) {
            Stream.Close(this.syslog);
            this.syslog  = nil;
            this.syshost = "";
        }
    }

    fn Emit(line: string) {
        if      (this.kind == 0) { Console.Write(line); }
        else if (this.kind == 1) { Console.Error(line); }
        else                     { this.WriteFile(line); }
    }

    fn WriteFile(line: string) {
        if (this.stream == nil) { return; }
        Stream.WriteString(this.stream, line);
        // A log record must be visible to a reader - a tail, a test, a
        // process that outlives this one - as soon as it is written, so
        // the file's write buffer is handed over per record.
        Stream.Flush(this.stream);
        this.written = this.written + len(line);
        if (this.maxBytes > 0 && this.written >= this.maxBytes) {
            this.Rotate();
        }
    }

    // <file>.<maxFiles> is dropped, each <file>.<k> shifts to <file>.<k+1>,
    // the active file becomes <file>.1, and a fresh file opens.
    fn Rotate() {
        if (this.kind != 2 || this.file == nil) { return; }
        this.CloseFile();

        let oldest = this.file + "." + str(this.maxFiles);
        if (File.Exists(oldest)) { File.Delete(oldest); }

        var k = this.maxFiles - 1;
        while (k >= 1) {
            let src = this.file + "." + str(k);
            let dst = this.file + "." + str(k + 1);
            if (File.Exists(src)) { File.Move(src, dst); }
            k -= 1;
        }
        if (File.Exists(this.file)) { File.Move(this.file, this.file + ".1"); }

        this.stream = Stream.Open(this.file, "a");
        this.written = 0;
    }
}

class Logger {

    const TRACE = -1;
    const DEBUG = 0;
    const INFO  = 1;
    const WARN  = 2;
    const ERROR = 3;
    const FATAL = 4;

    let _level:int     = 1;
    let _enabled:bool  = true;
    let _out           = nil;    // the _LogSink, shared with children
    let _ownsSink:bool = true;   // false for a child until it calls SetOutput
    let _prefix:string = "";
    let _timestamp:bool = false;
    let _useColor:bool  = false;
    let _json:bool      = false;  // structured JSON output
    let _format         = nil;    // SetFormatter's fn, or nil
    let _fields         = nil;    // With's context fields (an object), or nil

    fn Constructor() {
        this._out = new _LogSink();
    }

    fn SetLevel(level: int|string) {
        this._level = Logger._levelOf(level, "Logger.SetLevel");
    }

    // level as 0-4: an int (clamped) or a name; raises "<who>: invalid level".
    fn static _levelOf(level, who: string): int {
        let lvl = -1;
        if (type(level) == Type.Int) {
            lvl = level;
            if (lvl < 0) lvl = 0;
            if (lvl > 4) lvl = 4;
        } else if (type(level) == Type.String) {
            let s = String.ToLower(level);
            if (s == "trace")      { lvl = 0; }
            else if (s == "debug") { lvl = 0; }
            else if (s == "info")  { lvl = 1; }
            else if (s == "notice"){ lvl = 2; }
            else if (s == "warn")  { lvl = 2; }
            else if (s == "error") { lvl = 3; }
            else if (s == "fatal") { lvl = 4; }
        }
        if (lvl < 0) throw(1, who + ": invalid level");
        return lvl;
    }

    fn GetLevel(): int {
        return this._level;
    }

    fn SetOutput(sink: int|string, path?: string): bool {
        let kind = -1;
        if      (sink == "stdout" || sink == 0) { kind = 0; }
        else if (sink == "stderr" || sink == 1) { kind = 1; }
        else if (sink == "file"   || sink == 2) { kind = 2; }
        else { throw(1, "Logger.SetOutput: unknown sink"); }
        if (kind == 2 && (path == nil || path == "")) {
            throw(1, "Logger.SetOutput: file path required");
        }

        // A child that names its own destination stops writing through the
        // parent's sink; the parent's file stays open for the others.
        if (!this._ownsSink) {
            this._out = new _LogSink();
            this._ownsSink = true;
        }
        let o = this._out;
        o.CloseFile();
        o.kind = kind;
        o.file = nil;
        if (kind == 2) {
            o.file = path;
            o.stream = Stream.Open(path, "a");
            if (o.stream == nil) {
                throw(1, "Logger.SetOutput: could not open file: " + path);
            }
            // Account for any pre-existing content so rotation triggers correctly.
            o.written = File.Exists(path) ? File.Size(path) : 0;
        }
        return true;
    }

    fn SetSyslog(host: string, port?: int): bool {
        let o = this._out;
        o.CloseSyslog();
        if (host == nil || host == "" || host == "none") return true;

        let p = port ?? 514;
        let s = Stream.Connect("udp", host, p);
        if (s == nil) return false;

        o.syslog  = s;
        o.syshost = host;
        return true;
    }

    fn Enable()          { this._enabled = true;  }
    fn Disable()         { this._enabled = false; }
    fn IsEnabled(): bool { return this._enabled; }

    // Escaped here rather than per write: the prefix is set once and printed on
    // every line, so the cost belongs at the setter.
    fn SetPrefix(prefix:string) {
        this._prefix = (prefix == nil ? "" : Logger._safe(prefix));
    }

    fn SetTimestamp(enabled:bool) {
        this._timestamp = (enabled == true);
    }

    fn SetColor(enabled:bool) {
        this._useColor = (enabled == true);
    }

    // Emit one JSON object per line ({ time, level, msg, ...fields }) instead of
    // the human-readable text format. Color is suppressed in JSON mode.
    fn SetJson(enabled:bool) {
        this._json = (enabled == true);
    }

    // Enable size-based rotation of the file sink. When the active log file
    // reaches maxBytes, it is renamed to "<file>.1" (existing backups shift up
    // to "<file>.<maxFiles>", oldest discarded) and a fresh file is opened.
    // maxBytes <= 0 disables rotation.
    fn SetRotation(maxBytes:int, maxFiles?:int) {
        this._out.maxBytes = (maxBytes == nil) ? 0 : maxBytes;
        if (maxFiles != nil && maxFiles >= 1) { this._out.maxFiles = maxFiles; }
    }

    // f is held by this logger: a formatter that refers to the logger keeps
    // it alive, as any reference cycle does.
    fn SetFormatter(f) {
        if (f != nil && !Type.IsFunction(f)) throw(1, "Logger.SetFormatter: not a function");
        this._format = f;
    }

    fn AddSink(kind: string, opts?): bool {
        let o = opts ?? {};
        let lvl = (o.level == nil) ? this._level : Logger._levelOf(o.level, "Logger.AddSink");
        let f = o.format;
        if (f != nil && f != "text" && f != "json" && !Type.IsFunction(f)) {
            throw(1, "Logger.AddSink: format must be \"text\", \"json\" or a function");
        }
        let s = new _LogSink();
        if      (kind == "stdout") { s.kind = 0; }
        else if (kind == "stderr") { s.kind = 1; }
        else if (kind == "file") {
            if (o.path == nil || o.path == "") throw(1, "Logger.AddSink: file path required");
            s.kind = 2;
            s.file = o.path;
            s.stream = Stream.Open(o.path, "a");
            if (s.stream == nil) throw(1, "Logger.AddSink: could not open file: " + o.path);
            s.written = File.Exists(o.path) ? File.Size(o.path) : 0;
            if (o.maxBytes != nil) { s.maxBytes = o.maxBytes; }
            if (o.maxFiles != nil && o.maxFiles >= 1) { s.maxFiles = o.maxFiles; }
        } else if (kind == "syslog") {
            if (o.host == nil || o.host == "") throw(1, "Logger.AddSink: syslog host required");
            s.kind = 3;
            s.syslog = Stream.Connect("udp", o.host, o.port ?? 514);
            if (s.syslog == nil) throw(1, "Logger.AddSink: could not open syslog to " + o.host);
            s.syshost = o.host;
        } else {
            throw(1, "Logger.AddSink: unknown sink");
        }
        s.level = lvl;
        s.format = f;
        s.color = (o.color == true);
        s.timestamp = (o.timestamp == nil) ? this._timestamp : (o.timestamp == true);
        let out = this._out;
        if (out.more == nil) { out.more = []; }
        Array.Append(out.more, s);
        if (lvl < out.moreMin) { out.moreMin = lvl; }
        return true;
    }

    fn RemoveSinks() {
        let out = this._out;
        if (out.more != nil) {
            foreach (s in out.more) {
                s.CloseFile();
                s.CloseSyslog();
            }
        }
        out.more = nil;
        out.moreMin = 99;
    }

    // A log is a line-oriented record, so a newline inside a message is not
    // formatting - it is a second record that the message's author gets to
    // author. A username of "bob\n[ERR] payment refunded" lands in the file as
    // its own ERR line and no reader can tell it apart from a real one. ESC is
    // escaped for the same reason one step further out: a message replayed to a
    // terminal with `cat` can otherwise repaint what is already on screen.
    //
    // Rendered as visible escapes rather than dropped, so the message still
    // says what it said. This is a display encoding, not a reversible one -
    // SetJson(true) is the mode to use when something has to parse the output
    // back, and it needs no help here because Json.Stringify already escapes.
    fn static _safe(v): string {
        let t = str(v);
        // One strcspn pass decides it; the overwhelming majority of messages
        // hold none of these and return without allocating.
        if (String.IndexOfAnyFrom(t, "\r\n\x1b", 0) < 0) { return t; }
        var r = String.Replace(t, "\r", "\\r");
        r     = String.Replace(r, "\n", "\\n");
        r     = String.Replace(r, "\x1b", "\\e");
        return r;
    }

    fn static LevelName(lvl:int): string {
        if (lvl == 0) return "DEBUG";
        if (lvl == 1) return "INFO";
        if (lvl == 2) return "WARN";
        if (lvl == 3) return "ERROR";
        if (lvl == 4) return "FATAL";
        return "UNKNOWN";
    }

    // `obj` is the raw structured-fields object (or nil). In text mode it is
    // JSON-stringified and appended; in JSON mode its keys are merged into the
    // log entry. The context fields of With come first.
    fn _write(lvl: int, msg: string, obj?) {
        if (!this._enabled) return;
        let o = this._out;
        let main = lvl >= this._level;
        if (!main && lvl < o.moreMin) return;
        var fields = obj ?? nil;
        if (this._fields != nil) { fields = Logger._merge(this._fields, fields); }

        if (main) {
            let line = (this._format != nil)
                ? this._custom(this._format, lvl, msg, fields)
                : this._render(lvl, msg, fields, this._json, this._useColor && o.kind != 2, this._timestamp);
            if (line != nil) { o.Emit(line); }
            if (o.syslog != nil) {
                Stream.WriteString(o.syslog, Logger._syslogPri(lvl) + Logger._syslogText(lvl, msg, fields));
            }
        }
        if (o.more != nil) {
            foreach (s in o.more) {
                if (lvl >= s.level) { this._emitTo(s, lvl, msg, fields); }
            }
        }

        if (lvl == 4) {
            Console.Error("FATAL error, terminating.\n");
            VM.Exit(1);
        }
    }

    // A record rendered as text or JSON, newline included.
    fn _render(lvl: int, msg: string, fields, json: bool, color: bool, timestamp: bool): string {
        if (json) {
            let entry = { };
            entry["time"]  = Time.Format(Time.Now(), "%Y-%m-%dT%H:%M:%S");
            entry["level"] = Logger.LevelName(lvl);
            if (this._prefix != "") { entry["logger"] = this._prefix; }
            entry["msg"] = msg;
            if (fields != nil) {
                foreach (v, k in fields) { entry[k] = v; }
            }
            return Json.Stringify(entry) + "\n";
        }
        var line = "";
        if (timestamp) {
            line = Time.Format(Time.Now(), "%Y-%m-%dT%H:%M:%S") + " ";
        }
        if (this._prefix != "") {
            line = line + this._prefix + " ";
        }
        var levelTag = "[" + Logger._tag(lvl) + "]";
        if (color) {
            let ansi = "\x1b[0m";
            if      (lvl == 0) { ansi = "\x1b[90m"; }
            else if (lvl == 1) { ansi = "\x1b[32m"; }
            else if (lvl == 2) { ansi = "\x1b[33m"; }
            else if (lvl == 3) { ansi = "\x1b[31m"; }
            else if (lvl == 4) { ansi = "\x1b[35m"; }
            levelTag = ansi + levelTag + "\x1b[0m";
        }
        let fieldsStr = (fields != nil) ? Json.Stringify(fields) : nil;
        return line + levelTag + " " + Logger._safe(msg) + (fieldsStr != nil ? " " + fieldsStr : "") + "\n";
    }

    // A record rendered by formatter f, newline included; nil when f drops it.
    // msg and fields reach f as given, unescaped.
    fn _custom(f, lvl: int, msg: string, fields): string|nil {
        let r = f({ time: Time.Now(), level: lvl, levelName: Logger.LevelName(lvl),
                    msg: msg, logger: this._prefix, fields: fields });
        if (r == nil) return nil;
        let line = str(r);
        return String.EndsWith(line, "\n") ? line : line + "\n";
    }

    // A record to an added sink s, in s's format or else this logger's.
    fn _emitTo(s, lvl: int, msg: string, fields) {
        let f = s.format;
        if (s.kind == 3) {
            if (s.syslog == nil) return;
            var body = nil;
            if (f == "json") {
                body = this._render(lvl, msg, fields, true, false, false);
            } else if (f != nil && f != "text") {
                body = this._custom(f, lvl, msg, fields);
            } else {
                body = Logger._syslogText(lvl, msg, fields);
            }
            if (body != nil) { Stream.WriteString(s.syslog, Logger._syslogPri(lvl) + String.TrimRight(body, "\n")); }
            return;
        }
        var line = nil;
        let color = s.color && s.kind != 2;
        if (f == nil) {
            line = (this._format != nil)
                ? this._custom(this._format, lvl, msg, fields)
                : this._render(lvl, msg, fields, this._json, color, s.timestamp);
        } else if (f == "text") {
            line = this._render(lvl, msg, fields, false, color, s.timestamp);
        } else if (f == "json") {
            line = this._render(lvl, msg, fields, true, false, false);
        } else {
            line = this._custom(f, lvl, msg, fields);
        }
        if (line != nil) { s.Emit(line); }
    }

    fn static _tag(lvl: int): string {
        if (lvl == 0) return "DBG";
        if (lvl == 1) return "INF";
        if (lvl == 2) return "WRN";
        if (lvl == 3) return "ERR";
        if (lvl == 4) return "FTL";
        return "???";
    }

    // "<PRI>" for a user-level record of lvl (RFC 3164: facility 1).
    fn static _syslogPri(lvl: int): string {
        let sev = 6;
        if      (lvl == 0) { sev = 7; }
        else if (lvl == 2) { sev = 4; }
        else if (lvl == 3) { sev = 3; }
        else if (lvl == 4) { sev = 2; }
        return "<" + str(8 + sev) + ">";
    }

    fn static _syslogText(lvl: int, msg: string, fields): string {
        let text = "flaris: [" + Logger._tag(lvl) + "] " + Logger._safe(msg);
        return (fields != nil) ? text + " " + Json.Stringify(fields) : text;
    }

    // A new object with a's keys, then b's (b nil: a's alone).
    fn static _merge(a, b) {
        let r = {};
        foreach (v, k in a) { r[k] = v; }
        if (b != nil) {
            foreach (v, k in b) { r[k] = v; }
        }
        return r;
    }

    fn Log(level: int|string, msg: string, obj?: object) {
        let lvl = -1;
        if (type(level) == Type.Int) {
            lvl = level;
            if (lvl < 0) lvl = 0;
            if (lvl > 4) lvl = 4;
        } else if (type(level) == Type.String) {
            let s = String.ToLower(level);
            if      (s == "trace")   { lvl = 0; }
            else if (s == "debug")  { lvl = 0; }
            else if (s == "info")   { lvl = 1; }
            else if (s == "notice") { lvl = 2; }
            else if (s == "warn")   { lvl = 2; }
            else if (s == "error")  { lvl = 3; }
            else if (s == "fatal")  { lvl = 4; }
            else { throw(1, "Logger.Log: invalid level"); }
        }
        if (lvl < 0) throw(1, "Logger.Log: invalid level");
        this._write(lvl, msg, obj ?? nil);
    }

    // The level test is repeated here so a filtered record costs one call, not
    // two; an added sink with a lower level lets the record through.
    fn Trace(msg: string, obj?: object) { if (this._enabled && (this._level <= 0 || this._out.moreMin <= 0)) this._write(0, msg, obj ?? nil); }
    fn Debug(msg: string, obj?: object) { if (this._enabled && (this._level <= 0 || this._out.moreMin <= 0)) this._write(0, msg, obj ?? nil); }
    fn Info (msg: string, obj?: object) { if (this._enabled && (this._level <= 1 || this._out.moreMin <= 1)) this._write(1, msg, obj ?? nil); }
    fn Notice(msg: string, obj?: object) { if (this._enabled && (this._level <= 2 || this._out.moreMin <= 2)) this._write(2, msg, obj ?? nil); }
    fn Warn (msg: string, obj?: object) { if (this._enabled && (this._level <= 2 || this._out.moreMin <= 2)) this._write(2, msg, obj ?? nil); }
    fn Error(msg: string, obj?: object) { if (this._enabled && (this._level <= 3 || this._out.moreMin <= 3)) this._write(3, msg, obj ?? nil); }
    fn Fatal(msg: string, obj?: object) { this._write(4, msg, obj ?? nil); }

    // Records are already delivered as they are written; this makes them
    // durable on the device as well.
    fn Flush(): bool {
        let o = this._out;
        if (o.stream != nil) { Stream.Sync(o.stream); }
        if (o.syslog != nil) { Stream.Flush(o.syslog); }
        if (o.more != nil) {
            foreach (s in o.more) {
                if (s.stream != nil) { Stream.Sync(s.stream); }
                if (s.syslog != nil) { Stream.Flush(s.syslog); }
            }
        }
        return true;
    }

    // A child does not own the sink it shares, so its Close only flushes.
    fn Close(): bool {
        this.Flush();
        if (this._ownsSink) {
            let o = this._out;
            o.CloseFile();
            o.CloseSyslog();
            if (o.more != nil) {
                foreach (s in o.more) {
                    s.CloseFile();
                    s.CloseSyslog();
                }
            }
        }
        return true;
    }

    fn Child(prefix:string) : instance {
        return this._derive((this._prefix != "" ? this._prefix + "." : "") + Logger._safe(prefix), nil);
    }

    // fields is copied: changing the object later does not change the records.
    fn With(fields: object): instance {
        let merged = (this._fields == nil) ? Logger._merge(fields, nil) : Logger._merge(this._fields, fields);
        return this._derive(this._prefix, merged);
    }

    // A logger writing through this one's sink with its settings, prefix and
    // context fields (nil: this logger's).
    fn _derive(prefix: string, fields) : instance {
        let child = new Logger();
        child._level     = this._level;
        child._out       = this._out;
        child._ownsSink  = false;
        child._prefix    = prefix;
        child._timestamp = this._timestamp;
        child._useColor  = this._useColor;
        child._enabled   = this._enabled;
        child._json      = this._json;
        child._format    = this._format;
        child._fields    = (fields == nil) ? this._fields : fields;
        return child;
    }

    // Both halves are escaped: a field *name* is as likely to come from caller
    // data as its value, and either one carrying a newline splits the line.
    fn _formatFields(fields:object) : string {
        var s = "";
        foreach (entry in Object.Entries(fields)) {
            s = s + " " + Logger._safe(entry[0]) + "=" + Logger._safe(entry[1]);
        }
        return s;
    }

    // In JSON mode the fields are carried structurally; in text mode they are
    // appended as " key=value" pairs.
    fn InfoWith(msg:string, fields:object)  { if (this._json) { this.Info(msg, fields); }  else { this.Info(msg + this._formatFields(fields)); } }
    fn DebugWith(msg:string, fields:object) { if (this._json) { this.Debug(msg, fields); } else { this.Debug(msg + this._formatFields(fields)); } }
    fn WarnWith(msg:string, fields:object)  { if (this._json) { this.Warn(msg, fields); }  else { this.Warn(msg + this._formatFields(fields)); } }
    fn ErrorWith(msg:string, fields:object) { if (this._json) { this.Error(msg, fields); } else { this.Error(msg + this._formatFields(fields)); } }
}

export Logger;
