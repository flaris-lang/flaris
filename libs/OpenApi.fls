      form.appendChild(ta);
    }

    var responses = o.op.responses || {};
    var codes = Object.keys(responses);
    if (codes.length) {
      var rlist = h("div", { class: "responses" });
      codes.forEach(function (code) {
        var r = resolveIn("responses", responses[code]) || {};
        var content = r.content || {}, ct = Object.keys(content)[0];
        var block = h("div", { class: "resp" },
          h("div", { class: "resp-head" },
            h("span", { class: "status s" + code.charAt(0), text: code }),
            h("span", { text: r.description || "" }),
            ct ? h("code", { class: "ctype-label", text: ct }) : null));
        if (ct && content[ct].schema) {
          block.appendChild(h("details", { class: "schema-box" },
            h("summary", { text: "Schema: " + typeLabel(content[ct].schema) }),
            schemaTree(content[ct].schema, {}),
            h("details", null, h("summary", { text: "Example" }), h("pre", { text: JSON.stringify(exampleOf(content[ct].schema), null, 2) }))));
        }
        if (r.headers) {
          block.appendChild(h("div", { class: "resp-headers" }, "Headers: ",
            Object.keys(r.headers).map(function (n) { return [h("code", { text: n + ": " + typeLabel((r.headers[n] || {}).schema) }), " "]; })));
        }
        rlist.appendChild(block);
      });
      form.appendChild(h("h4", { text: "Responses" }));
      form.appendChild(rlist);
    }

    form.appendChild(h("div", { class: "actions" },
      h("button", { type: "submit", class: "send", text: "Send request" }),
      h("button", { type: "button", class: "ghost", text: "Copy as curl", onclick: function () {
        var r = buildRequest(o, form);
        if (!r) return;
        curl.textContent = toCurl(r);
        curl.style.display = "block";
        if (navigator.clipboard) navigator.clipboard.writeText(curl.textContent).catch(function () { /* clipboard blocked */ });
      } }),
      h("span", { class: "target", text: state.server || location.origin })));
    form.appendChild(curl);
    form.appendChild(result);
    body.appendChild(form);
    return body;
  }
  function firstExample(examples) { var k = Object.keys(examples)[0]; return k ? examples[k].value : null; }

  function buildRequest(o, form) {
    var path = o.path, query = [], headers = {}, cookies = [], missing = [];
    Array.prototype.forEach.call(form.querySelectorAll("[data-pin]"), function (inp) {
      var where = inp.dataset.pin, name = inp.dataset.pname, val = inp.value;
      if (val === "") { if (inp.required) missing.push(name); return; }
      if (where === "path") path = path.split("{" + name + "}").join(val.split("/").map(encodeURIComponent).join("/"));
      else if (where === "query") query.push(encodeURIComponent(name) + "=" + encodeURIComponent(val));
      else if (where === "header") headers[name] = val;
      else if (where === "cookie") cookies.push(name + "=" + val);
    });
    if (missing.length) { alert("Missing required parameter(s): " + missing.join(", ")); return null; }
