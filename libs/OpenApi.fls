    var body = null;
    if (bodyEl && bodyEl.value !== "") {
      var ct = ctEl ? ctEl.value : "application/json";
      headers["Content-Type"] = ct;
      body = bodyEl.value;
      if (ct.indexOf("x-www-form-urlencoded") >= 0) {
        try {
          var obj = JSON.parse(body);
          body = Object.keys(obj).map(function (k) { return encodeURIComponent(k) + "=" + encodeURIComponent(obj[k]); }).join("&");
        } catch (e) { /* send as typed */ }
      }
    }
    applyAuth(o, headers, query, cookies);
    if (cookies.length) headers["Cookie"] = cookies.join("; ");
    var url = (state.server || "") + path + (query.length ? "?" + query.join("&") : "");
    return { method: o.method.toUpperCase(), url: url, headers: headers, body: body };
  }
  function applyAuth(o, headers, query, cookies) {
    var schemes = components("securitySchemes"), reqs = securityFor(o);
    if (!Array.isArray(reqs)) return;
    var used = {};
    reqs.forEach(function (req) {
      Object.keys(req).forEach(function (name) {
        if (used[name]) return;
        var sc = schemes[name], v = state.auth[name];
        if (!sc || !v) return;
        used[name] = true;
        var scheme = (sc.scheme || "").toLowerCase();
        if (sc.type === "http" && scheme === "basic") headers["Authorization"] = "Basic " + btoa(v);
        else if (sc.type === "http") headers["Authorization"] = (scheme && scheme !== "bearer" ? sc.scheme + " " : "Bearer ") + v;
        else if (sc.type === "apiKey") {
          if (sc["in"] === "query") query.push(encodeURIComponent(sc.name) + "=" + encodeURIComponent(v));
          else if (sc["in"] === "cookie") cookies.push(sc.name + "=" + v);
