// =============================================================================
// OpenApi.fls - OpenAPI 3 document builder and interactive API docs for Router.
// Version: 1.0
//
// Describe your Router routes once and get a standards-conformant OpenAPI 3
// document (JSON) plus a self-contained "Try it out" documentation page, with
// no build step and no external dependency.
//
// Exports:
//   OpenApi        - the document builder; also a documenting facade over Router
//   OpenApiGroup   - prefix-scoped facade returned by OpenApi.Group()
//
// Usage:
//   import { Router, Response } from library("Router", "1.0");
//   import { OpenApi }          from library("OpenApi", "1.0");
//
//   let app = new Router();
//   let api = OpenApi.For(app, { title: "Pet Store", version: "1.0.0" });
//
//   api.Schema("Pet", { id: "int", name: "string", "tag?": "string" });
//
//   api.Get("/pets", {
//       summary:   "List pets",
//       tags:      ["pets"],
//       query:     { limit: { type: "int", description: "Page size" } },
//       responses: { "200": "[Pet]" }
//   }, fn(req) { return Response.Json(store.All()); });
//
//   api.Post("/pets", { summary: "Create a pet", body: "Pet", responses: { "201": "Pet" } },
//            fn(req) { return Response.Json(store.Add(Json.Parse(req.body)), 201); });
//
//   api.Get("/pets/:id", { summary: "Fetch one pet", responses: { "200": "Pet", "404": "Not found" } },
//           fn(req) { return Response.Json(store.Get(req.params.id)); });
//
//   Console.WriteLine(api.ToJson(true)); // the OpenAPI document, pretty-printed
//   app.Listen(8080);
//
// Registering through the facade both documents the operation and registers
// the handler on the Router, so the document and the routes cannot drift apart.
// Pass no handler to document an operation registered elsewhere, or call
// Discover() to pick up every Router route that has no documentation yet.
//
// OpenApi:
//   new OpenApi(info?)            - info: object or a title string (see Info)
//   OpenApi.For(router, info?)    - same, attached to a Router
//   .Info(info)                   - merge into info: { title, version, description,
//                                   termsOfService, contact, license }
//   .Server(url, description?)    - add a servers[] entry
//   .Tag(name, description?)      - declare a tag (order = order in the docs page)
//   .ExternalDocs(url, description?)
//   .Version(v)                   - "3.0.3" (default) or "3.1.0"
//   .Extension(key, value)        - root-level "x-..." field
//
//   .Get / .Post / .Put / .Patch / .Delete / .Head(pattern, doc?, handler?)
//       pattern: Router syntax - ":id" and "*" become "{id}" and "{path}"
//       doc:     operation description (below); may be omitted
//       handler: fn(req) -> response; registered on the attached Router
//       Returns this, so calls chain.
//   .Operation(method, pattern, doc?) - document without registering
//   .Group(prefix, opts?)         - OpenApiGroup; opts: a tag name, or
//                                   { tag, tags, description }
//   .Discover(router?)            - document every route on the Router that is
//                                   not documented yet (path, method, path params)
//
//   .Schema(name, schema)         - register components.schemas[name]; returns
//                                   the $ref object for it
//   .SchemaOf(name, instance, opts?) - infer a schema from a class instance's
//                                   field values: int -> integer, float -> number,
//                                   string, bool, array (items from the first
//                                   element), object (recursive), nil -> nullable
//                                   untyped. opts: { required: [names],
//                                   descriptions: { field: text }, example: bool,
//                                   description }
//   OpenApi.Ref(name)             - { "$ref": "#/components/schemas/<name>" }
//   .SecurityScheme(name, scheme) - register components.securitySchemes[name]
//   OpenApi.Bearer(format?)       - { type: "http", scheme: "bearer", bearerFormat }
//   OpenApi.Basic()               - { type: "http", scheme: "basic" }
//   OpenApi.ApiKey(name, in?)     - { type: "apiKey", name, in: "header" }
//   .Security(requirements)       - document-wide requirement: ["bearerAuth"] or
//                                   [{ oauth: ["read"] }]; [] makes everything public
//
//   .Spec()                       - the document as a plain object
//   .ToJson(pretty?)              - the document as JSON text. Keys come out in
//                                   the conventional order (openapi, info, servers,
//                                   tags, paths, components, ...), paths and
//                                   schemas in registration order, so the output
//                                   is stable and diff-friendly.
//
//   .Serve(opts?)                 - register GET <specPath> (the document, with
//                                   ETag / 304 and CORS "*") and GET <docsPath>
//                                   (the docs page) on the attached Router
//       opts: { specPath: "/openapi.json", docsPath: "/docs",
//               ui: "builtin" | "swagger" | "redoc" | false,
//               title, cdn, pretty: true, cors: true }
//       "builtin" is the self-contained explorer described below; "swagger" and
//       "redoc" serve a small page that loads Swagger UI / ReDoc from a CDN (set
//       cdn to point elsewhere). Anything registered or changed after Serve()
//       is picked up by the next request.
//   .Unserve()                    - stop answering; both routes then return 410
//   OpenApi.DocsHtml(specUrl, opts?)    - the explorer page for any spec URL;
//                                         opts: { title }
//   OpenApi.SwaggerHtml(specUrl, opts?) - Swagger UI shell; opts: { title, cdn }
//   OpenApi.RedocHtml(specUrl, opts?)   - ReDoc shell;      opts: { title, cdn }
//   OpenApi.Load(json, router?)   - an OpenApi from an existing document (JSON
//                                   text or parsed object): extend it, Serve()
//                                   docs for it, or just reformat it
//   OpenApi.LoadFile(path, router?)
//
// The explorer page: operations grouped by tag with a filter box, parameter
// tables with inputs, a request-body editor prefilled from the schema,
// response schemas with generated examples, a schema browser, an Authorize
// panel for every security scheme (values stay in the browser's localStorage)
// and "Send request", which calls the API from the browser and shows status,
// headers, body, timing and the equivalent curl command. Requests go to the
// page's own origin unless a server from servers[] is picked, so no CORS setup
// is needed for the common case. Everything is inlined: no CDN, no build step.
//
//   .Validate(opts?)              - Router middleware: app.Use(api.Validate()).
//                                   Checks every documented request before its
//                                   handler runs - path, query, header and
//                                   cookie parameters (coerced to the declared
//                                   type: "42" becomes 42) and the JSON or form
//                                   body against its schema. A violation answers
//                                   400 with { error, details: [{ path, message }] }
//                                   and the handler never runs. The handler gets
//                                   req.validated = { params, query, headers,
//                                   cookies, body } with typed values.
//       opts: { status: 400, coerce: true (write typed values back to
//               req.params / req.query), responses: false (also check the
//               handler's answer: an undeclared status or a body that does not
//               match its schema becomes a 500 naming the mismatch) }
//       Undocumented routes pass through untouched.
//   .Learn(opts?)                 - Router middleware that fills the document
//                                   in from live traffic: query parameters,
//                                   request-body and response schemas per
//                                   status code, all marked "x-learned": true
//                                   and widened as more samples arrive.
//                                   Declared schemas are never changed. Call
//                                   Discover() first so every route has an
//                                   operation; open the docs page while using
//                                   the API and watch it fill in.
//       opts: { maxSamples: 50, examples: false, query: true, bodies: true,
//               responses: true }
//   .Contract(opts?)              - calls every documented operation on the
//                                   attached Router (no sockets) with values
//                                   derived from the document - path and
//                                   required query parameters from examples or
//                                   schemas, a body generated from the request
//                                   schema - and checks that each answer is a
//                                   declared status whose JSON body matches the
//                                   declared schema.
//       returns { ok, passed, failed, results: [{ method, path, request,
//                 operationId, status, ok, errors: [{ path, message }] }] }
//       opts: { values: { paramName: value }, headers: { "X-Api-Key": "..." },
//               bodies: { operationId: body }, only: [operationId], skip: [...] }
//   OpenApi.ValidateValue(value, schema, schemas?) - the validator on its own:
//       [{ path, message }], empty when valid. Supports type (incl. 3.1 arrays
//       and "null"), nullable, enum, const, required, properties,
//       additionalProperties, items, min/max for length, items, properties and
//       numbers (3.0 boolean and 3.1 numeric exclusive bounds), multipleOf,
//       pattern, uniqueItems, allOf / anyOf / oneOf / not, $ref into
//       components.schemas, and the formats date, date-time, uuid, email, uri,
//       ipv4. Class instances validate by their fields.
//
// Operation doc object - every key is optional:
//   summary, description, operationId, deprecated, tags ("pets" or ["pets"])
//   params:     { id: "int", ... }          path parameters (name -> type/schema)
//   query:      { limit: "int?", q: {...} } query parameters
//   headers:    { "X-Trace": "string" }     header parameters
//   cookies:    { session: "string" }       cookie parameters
//   parameters: [ ...full OpenAPI parameter objects... ]  appended as-is
//       A parameter value is a type shorthand (below) or an object:
//       { type, schema, description, required, deprecated, example, enum, ... }
//       Path parameters are always required; other "?" types are optional.
//   body:       "Pet" | { schema, description, required, contentType, example }
//       requestBody; contentType defaults to application/json
//   responses:  { "200": "Pet", "201": { schema: "Pet", description: "Created" },
//                 404: "Not found", "204": nil }
//       A string that names a type or schema is the response schema; any other
//       string is the description. The description defaults to the standard
//       reason phrase. Long form: { description, schema, contentType, headers,
//       example }. Without responses the operation gets 200 "OK".
//   security:   false (public) | ["bearerAuth"] | [{ oauth: ["scope"] }]
//   Any "x-..." key, plus externalDocs, servers and callbacks pass through.
//
// Type shorthand (accepted wherever a schema is expected):
//   "int" "integer" "int32" "int64" "float" "double" "number" "string" "bool"
//   "boolean" "any" "object" "date" "datetime" "uuid" "email" "uri" "binary"
//   "Pet"        - $ref to components.schemas.Pet (any other capitalised name)
//   "[Pet]"      - array of Pet;  "[int]" - array of integers
//   "string?"    - optional and nullable
//   { id: "int", "tag?": "string" } - inline object; keys are required unless
//                the key or its type ends in "?"
//   { type: "string", enum: ["a", "b"] } - a schema object is used as-is, with
//                shorthand expanded inside items / properties / oneOf / ...
//
// OpenApiGroup (from Group):
//   .Get / .Post / .Put / .Patch / .Delete(pattern, doc?, handler?)
//   .Use(middleware)  - group-scoped Router middleware
//   .Group(prefix, opts?)
//   Operations inherit the group's tags when the doc names none.
// =============================================================================

// Preferred key order for JSON output. Anything not listed sorts after these,
// alphabetically, so two builds of the same document are byte-identical.
global _KEY_ORDER = [
    "openapi", "name", "url", "in", "title", "version", "info", "servers", "tags",
    "summary", "description", "termsOfService", "contact", "license", "email",
    "operationId", "deprecated", "required", "schema", "externalDocs", "paths",
    "webhooks", "components", "schemas", "parameters", "requestBody", "requestBodies",
    "responses", "headers", "content", "examples", "securitySchemes", "security",
    "links", "callbacks", "$ref", "type", "format", "nullable", "enum", "const",
    "default", "example", "properties", "additionalProperties", "items", "allOf",
    "oneOf", "anyOf", "not", "minimum", "maximum", "exclusiveMinimum",
    "exclusiveMaximum", "multipleOf", "minLength", "maxLength", "pattern",
    "minItems", "maxItems", "uniqueItems", "minProperties", "maxProperties",
    "readOnly", "writeOnly", "scheme", "bearerFormat", "flows", "openIdConnectUrl",
    "style", "explode", "allowEmptyValue", "allowReserved"
];
global _RANK = nil;

// Inside a schema (or security scheme) object the natural reading order
// differs: type first, then shape, then constraints, examples last.
global _KEY_ORDER_SCHEMA = [
    "$ref", "title", "type", "name", "in", "scheme", "bearerFormat", "format", "nullable",
    "description", "deprecated", "readOnly", "writeOnly", "properties", "required",
    "additionalProperties", "items", "allOf", "oneOf", "anyOf", "not", "discriminator",
    "enum", "const", "default", "minimum", "maximum", "exclusiveMinimum",
    "exclusiveMaximum", "multipleOf", "minLength", "maxLength", "pattern", "minItems",
    "maxItems", "uniqueItems", "minProperties", "maxProperties", "example", "examples",
    "xml", "externalDocs"
];
global _RANK_SCHEMA = nil;

// Methods in the order a path item conventionally lists them.
global _METHOD_ORDER = ["get", "put", "post", "delete", "options", "head", "patch", "trace"];

// Documents currently served through Serve(), by key. The route handlers hold
// only the key, so a Router never references the OpenApi that references it.
global _servedRegistry = {};
global _servedNext:int = 1;

global _STATUS_TEXT = {
    "100": "Continue", "101": "Switching Protocols",
    "200": "OK", "201": "Created", "202": "Accepted", "204": "No Content",
    "206": "Partial Content", "301": "Moved Permanently", "302": "Found",
    "303": "See Other", "304": "Not Modified", "307": "Temporary Redirect",
    "308": "Permanent Redirect", "400": "Bad Request", "401": "Unauthorized",
    "402": "Payment Required", "403": "Forbidden", "404": "Not Found",
    "405": "Method Not Allowed", "406": "Not Acceptable", "408": "Request Timeout",
    "409": "Conflict", "410": "Gone", "412": "Precondition Failed",
    "413": "Payload Too Large", "415": "Unsupported Media Type",
    "422": "Unprocessable Entity", "429": "Too Many Requests",
    "500": "Internal Server Error", "501": "Not Implemented",
    "502": "Bad Gateway", "503": "Service Unavailable", "504": "Gateway Timeout",
    "default": "Unexpected error"
};

// Shorthand type names and the schema each expands to.
global _TYPE_MAP = {
    "int":      { type: "integer" },
    "integer":  { type: "integer" },
    "int32":    { type: "integer", format: "int32" },
    "int64":    { type: "integer", format: "int64" },
    "float":    { type: "number" },
    "double":   { type: "number", format: "double" },
    "number":   { type: "number" },
    "string":   { type: "string" },
    "str":      { type: "string" },
    "bool":     { type: "boolean" },
    "boolean":  { type: "boolean" },
    "any":      {},
    "object":   { type: "object" },
    "array":    { type: "array", items: {} },
    "date":     { type: "string", format: "date" },
    "datetime": { type: "string", format: "date-time" },
    "date-time": { type: "string", format: "date-time" },
    "uuid":     { type: "string", format: "uuid" },
    "email":    { type: "string", format: "email" },
    "uri":      { type: "string", format: "uri" },
    "url":      { type: "string", format: "uri" },
    "binary":   { type: "string", format: "binary" },
    "byte":     { type: "string", format: "byte" },
    "password": { type: "string", format: "password" }
};

// Formats the validator checks; anything else passes.
global _FORMAT_RE = {
    "date":      """^[0-9]{4}-[0-9]{2}-[0-9]{2}$""",
    "date-time": """^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt ][0-9]{2}:[0-9]{2}(:[0-9]{2}(\.[0-9]+)?)?([Zz]|[+-][0-9]{2}:?[0-9]{2})?$""",
    "uuid":      """^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$""",
    "email":     """^[^@\s]+@[^@\s]+\.[^@\s]+$""",
    "uri":       """^[A-Za-z][A-Za-z0-9+.-]*:[^\s]*$""",
    "ipv4":      """^([0-9]{1,3}\.){3}[0-9]{1,3}$"""
};

fn _fail(errors:array, path:string, message:string) {
    Array.Append(errors, { path: path, message: message });
}

// Keys whose presence marks an object as a schema rather than a property map.
global _SCHEMA_MARKERS = ["$ref", "type", "enum", "oneOf", "anyOf", "allOf", "not",
                          "properties", "items", "additionalProperties", "const"];

fn _rankOf(k:string): int {
    if (_RANK == nil) {
        _RANK = {};
        foreach (key, i in _KEY_ORDER) {
            if (!Object.HasKey(_RANK, key)) { _RANK[key] = i; }
        }
    }
    return Object.TryGet(_RANK, k, 100000);
}

fn _rankSchemaOf(k:string): int {
    if (_RANK_SCHEMA == nil) {
        _RANK_SCHEMA = {};
        foreach (key, i in _KEY_ORDER_SCHEMA) {
            if (!Object.HasKey(_RANK_SCHEMA, key)) { _RANK_SCHEMA[key] = i; }
        }
    }
    return Object.TryGet(_RANK_SCHEMA, k, 100000);
}

fn _keyBefore(a, b): bool {
    let ra:int = _rankOf(a);
    let rb:int = _rankOf(b);
    if (ra != rb) { return ra < rb; }
    return a < b;
}

fn _schemaKeyBefore(a, b): bool {
    let ra:int = _rankSchemaOf(a);
    let rb:int = _rankSchemaOf(b);
    if (ra != rb) { return ra < rb; }
    return a < b;
}

fn _sortedKeys(o): array { return Array.Sort(Object.Keys(o), fn(a, b) => a < b); }

fn _htmlEscape(s:string): string {
    var t = String.Replace(s, "&", "&amp;");
    t = String.Replace(t, "<", "&lt;");
    t = String.Replace(t, ">", "&gt;");
    t = String.Replace(t, "\"", "&quot;");
    return String.Replace(t, "'", "&#39;");
}

// A JSON string literal that cannot close a surrounding <script> block.
fn _jsString(s:string): string {
    return String.Replace(Json.Stringify(s), "<", "\\u003c");
}

// Route handlers registered by Serve() land here with the registry key.
fn _serveFromRegistry(key:string, what:string, req) {
    let api = Object.TryGet(_servedRegistry, key, nil);
    if (api == nil) {
        return { status: 410, headers: { "Content-Type": "application/json" },
                 body: Json.Stringify({ error: "This API documentation is no longer served" }) };
    }
    return (what == "spec") ? api._serveSpec(req) : api._serveDocs(req);
}

fn _pascal(s:string): string {
    if (String.Length(s) == 0) { return s; }
    return String.ToUpper(String.Substr(s, 0, 1)) + String.Substr(s, 1);
}

// "Pet?" -> "Pet"; anything else unchanged.
fn _baseWord(t:string): string {
    if (String.EndsWith(t, "?")) { return String.Substr(t, 0, String.Length(t) - 1); }
    return t;
}

fn _isSchemaObject(o): bool {
    foreach (k in _SCHEMA_MARKERS) {
        if (Object.HasKey(o, k)) { return true; }
    }
    return false;
}

// True for a string that the shorthand grammar can turn into a schema: a known
// type name, "[T]", or a capitalised schema name - each optionally ending in "?".
fn _isTypeWord(s:string): bool {
    var t = s;
    if (String.EndsWith(t, "?")) { t = String.Substr(t, 0, String.Length(t) - 1); }
    if (String.StartsWith(t, "[") && String.EndsWith(t, "]")) {
        return _isTypeWord(String.Substr(t, 1, String.Length(t) - 2));
    }
    if (Object.HasKey(_TYPE_MAP, t)) { return true; }
    return Regex.IsMatch(t, """^[A-Z][A-Za-z0-9_.]*$""");
}

// =============================================================================
// _Ordered - an object that remembers insertion order, for paths and components
// =============================================================================

class _Ordered
{
    let keys:array = [];
    let map        = nil;

    fn Constructor() {
        keys = [];
        map  = {};
    }

    fn Set(k:string, v) {
        if (!Object.HasKey(map, k)) { Array.Append(keys, k); }
        map[k] = v;
    }

    fn Get(k:string) { return Object.TryGet(map, k, nil); }
    fn Has(k:string): bool { return Object.HasKey(map, k); }
    fn Count(): int { return len(keys); }
}

// Deep-copies a document tree, turning every _Ordered into a plain object.
fn _plain(v) {
    if (v == nil) { return nil; }
    if (Type.IsArray(v)) {
        let out = [];
        foreach (e in v) { Array.Append(out, _plain(e)); }
        return out;
    }
    if (Class.IsInstance(v) && v is _Ordered) {
        let o = {};
        foreach (k in v.keys) { o[k] = _plain(v.map[k]); }
        return o;
    }
    if (Type.IsObject(v)) {
        let o = {};
        foreach (val, k in v) { o[k] = _plain(val); }
        return o;
    }
    return v;
}

// =============================================================================
// JSON writer - conventional key order, insertion order for _Ordered, optional
// two-space pretty printing. Scalars are escaped by Json.Stringify.
// =============================================================================

fn _writeObj(keys:array, src, pretty:bool, depth:int, out:array) {
    if (len(keys) == 0) { Array.Append(out, "{}"); return; }
    let pad     = pretty ? String.Repeat("  ", depth + 1) : "";
    let padEnd  = pretty ? String.Repeat("  ", depth) : "";
    let nl      = pretty ? "\n" : "";
    let colon   = pretty ? ": " : ":";
    Array.Append(out, "{" + nl);
    foreach (k, i in keys) {
        Array.Append(out, pad + Json.Stringify(k) + colon);
        _writeVal(src[k], pretty, depth + 1, out);
        Array.Append(out, (i < len(keys) - 1 ? "," : "") + nl);
    }
    Array.Append(out, padEnd + "}");
}

fn _writeVal(v, pretty:bool, depth:int, out:array) {
    if (v == nil) { Array.Append(out, "null"); return; }
    if (Type.IsString(v) || Type.IsBool(v) || Type.IsInt(v) || Type.IsFloat(v)) {
        Array.Append(out, Json.Stringify(v));
        return;
    }
    if (Type.IsArray(v)) {
        if (len(v) == 0) { Array.Append(out, "[]"); return; }
        let pad    = pretty ? String.Repeat("  ", depth + 1) : "";
        let padEnd = pretty ? String.Repeat("  ", depth) : "";
        let nl     = pretty ? "\n" : "";
        Array.Append(out, "[" + nl);
        foreach (e, i in v) {
            Array.Append(out, pad);
            _writeVal(e, pretty, depth + 1, out);
            Array.Append(out, (i < len(v) - 1 ? "," : "") + nl);
        }
        Array.Append(out, padEnd + "]");
        return;
    }
    if (Class.IsInstance(v) && v is _Ordered) {
        _writeObj(v.keys, v.map, pretty, depth, out);
        return;
    }
    if (Type.IsObject(v)) {
        let keys = Array.Sort(Object.Keys(v), _isSchemaObject(v) ? _schemaKeyBefore : _keyBefore);
        _writeObj(keys, v, pretty, depth, out);
        return;
    }
    if (Class.IsInstance(v)) {
        _writeVal(Json.Parse(Json.Stringify(v)), pretty, depth, out);
        return;
    }
    Array.Append(out, "null");
}

fn _writeJson(v, pretty:bool): string {
    let out = [];
    _writeVal(v, pretty, 0, out);
    return String.Join(out, "");
}

// =============================================================================
// Explorer page assets. Each literal stays under the 64 KB string cap; the
// page is assembled by OpenApi.DocsHtml.
// =============================================================================

global _DOCS_CSS = """
:root {
  --bg: #f6f7f9; --fg: #1f2430; --muted: #6b7280; --line: #dfe3ea; --card: #ffffff;
  --accent: #2f6fed; --accent-fg: #ffffff; --code-bg: #eef1f6; --side-bg: #ffffff;
  --get: #2f80ed; --post: #27ae60; --put: #f2994a; --patch: #16a5a5; --delete: #eb5757;
  --head: #7b8794; --options: #7b8794; --trace: #7b8794;
  --ok: #1f9d55; --warn: #c27c0e; --err: #c0392b;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #12151c; --fg: #e6e9ef; --muted: #98a2b3; --line: #2a3140; --card: #1a1f2a;
    --accent: #6ea0ff; --accent-fg: #0b1020; --code-bg: #232a38; --side-bg: #161b25;
  }
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body { background: var(--bg); color: var(--fg); font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }
code, pre, .path, .method, .nav-path, .sch-type, .sch-name { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
code { background: var(--code-bg); padding: 1px 5px; border-radius: 4px; font-size: 0.92em; }
pre { background: var(--code-bg); padding: 10px 12px; border-radius: 6px; overflow: auto; font-size: 13px; line-height: 1.45; margin: 8px 0; white-space: pre-wrap; word-break: break-word; }
h1 { font-size: 20px; margin: 0; }
h2 { font-size: 18px; margin: 28px 0 8px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
h4 { margin: 18px 0 6px; font-size: 13px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
.muted { color: var(--muted); font-size: 13px; }
.badge { display: inline-block; font-size: 11px; padding: 2px 7px; border-radius: 999px; background: var(--code-bg); color: var(--muted); margin-left: 6px; vertical-align: middle; }
.badge.warn { background: #fdf1d6; color: #8a5a00; }
.badge.ver { background: var(--accent); color: var(--accent-fg); }
.loading, .error { padding: 60px 20px; text-align: center; color: var(--muted); }
.error h1 { color: var(--err); }

.top { position: sticky; top: 0; z-index: 5; display: flex; flex-wrap: wrap; gap: 10px 18px; align-items: center; justify-content: space-between; padding: 10px 20px; background: var(--card); border-bottom: 1px solid var(--line); }
.brand { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.spec-link { font-size: 13px; margin-left: 8px; }
.tools { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.tools select, .tools input, .try input, .try select, .try textarea, .auth input {
  font: inherit; font-size: 13px; color: var(--fg); background: var(--bg); border: 1px solid var(--line); border-radius: 6px; padding: 6px 8px;
}
.try textarea { width: 100%; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; resize: vertical; }
.tools .filter { min-width: 220px; }
button { font: inherit; font-size: 13px; cursor: pointer; border-radius: 6px; padding: 6px 12px; border: 1px solid var(--line); background: var(--card); color: var(--fg); }
button.send { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); font-weight: 600; }
button:hover { filter: brightness(0.96); }

.layout { display: grid; grid-template-columns: 290px minmax(0, 1fr); gap: 0; }
.side { position: sticky; top: 57px; height: calc(100vh - 57px); overflow: auto; padding: 14px 10px 30px; background: var(--side-bg); border-right: 1px solid var(--line); }
.nav-group { margin-bottom: 14px; }
.nav-tag { display: block; font-weight: 600; font-size: 13px; padding: 4px 8px; color: var(--fg); }
.nav-op { display: flex; gap: 8px; align-items: center; padding: 4px 8px; border-radius: 6px; color: var(--fg); font-size: 12.5px; }
.nav-op:hover { background: var(--code-bg); text-decoration: none; }
.nav-path { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.main { padding: 10px 28px 60px; min-width: 0; }
.intro { margin-top: 14px; }
.md p { margin: 6px 0; }
.foot { padding: 20px; text-align: center; color: var(--muted); font-size: 12px; border-top: 1px solid var(--line); }

.method { display: inline-block; min-width: 62px; text-align: center; font-weight: 700; font-size: 12px; padding: 5px 8px; border-radius: 5px; color: #fff; }
.method.mini { min-width: 46px; font-size: 10px; padding: 2px 4px; }
.method.get { background: var(--get); } .method.post { background: var(--post); } .method.put { background: var(--put); }
.method.patch { background: var(--patch); } .method.delete { background: var(--delete); } .method.head { background: var(--head); }
.method.options { background: var(--options); } .method.trace { background: var(--trace); }

.op { background: var(--card); border: 1px solid var(--line); border-left: 4px solid var(--head); border-radius: 8px; margin: 10px 0; }
.op-get { border-left-color: var(--get); } .op-post { border-left-color: var(--post); } .op-put { border-left-color: var(--put); }
.op-patch { border-left-color: var(--patch); } .op-delete { border-left-color: var(--delete); }
.op-head { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; padding: 10px 14px; cursor: pointer; user-select: none; }
.op-head .path { font-weight: 600; font-size: 14px; word-break: break-all; }
.op-head .summary { color: var(--muted); font-size: 14px; flex: 1 1 200px; }
.op-head .lock { font-size: 13px; }
.op-body { display: none; padding: 4px 16px 18px; border-top: 1px solid var(--line); }
.op.open .op-body { display: block; }

table.params { width: 100%; border-collapse: collapse; font-size: 13.5px; }
table.params th, table.params td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
table.params th { font-size: 12px; color: var(--muted); font-weight: 600; }
table.params input, table.params select { width: 100%; min-width: 120px; }
.sch-req { color: var(--err); font-weight: 700; margin-left: 2px; }
.sch { margin: 2px 0; }
.sch-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline; font-size: 13.5px; padding: 2px 0; }
.sch-name { font-weight: 600; }
.sch-type { color: var(--accent); font-size: 12.5px; }
.sch-enum { color: var(--muted); font-size: 12px; }
.sch-desc { color: var(--muted); font-size: 13px; flex-basis: 100%; }
.sch-children, .sch details { margin-left: 18px; padding-left: 10px; border-left: 1px dashed var(--line); }
.sch summary { cursor: pointer; font-size: 12.5px; color: var(--muted); }
details.schema-box { margin: 6px 0; }
details.schema-box > summary { cursor: pointer; font-size: 13px; color: var(--muted); }
.schema-card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 8px 14px; margin: 8px 0; }
.schema-card > summary { cursor: pointer; display: flex; gap: 10px; align-items: center; }

.responses .resp { padding: 8px 0; border-bottom: 1px solid var(--line); }
.resp-head { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.ctype-label { font-size: 12px; }
.resp-headers { font-size: 13px; color: var(--muted); margin-top: 4px; }
.status { font-weight: 700; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
.status.s1, .status.s3 { color: var(--muted); } .status.s2 { color: var(--ok); } .status.s4 { color: var(--warn); } .status.s5 { color: var(--err); }

.actions { display: flex; gap: 10px; align-items: center; margin-top: 16px; flex-wrap: wrap; }
.actions .target { color: var(--muted); font-size: 12px; margin-left: auto; }
.curl { display: none; }
.result-head { display: flex; gap: 12px; align-items: baseline; margin-top: 12px; }
.resp-hdrs summary { cursor: pointer; font-size: 13px; color: var(--muted); }
.resp-body { max-height: 480px; }

.auth { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 8px 14px; margin: 14px 0; }
.auth summary { cursor: pointer; font-weight: 600; }
.auth-row { display: grid; grid-template-columns: 220px 1fr; gap: 6px 14px; align-items: center; padding: 8px 0; border-top: 1px solid var(--line); font-size: 13.5px; }
.auth-row .muted { grid-column: 2; }
.meta { margin: 4px 0 0; }

@media (max-width: 900px) {
  .layout { grid-template-columns: 1fr; }
  .side { display: none; }
  .main { padding: 10px 14px 40px; }
  .auth-row { grid-template-columns: 1fr; }
}
""";

