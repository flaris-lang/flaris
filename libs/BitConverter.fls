// BitConverter.fls - Binary ↔ numeric type conversions for Flaris.
// Version: 1.0
//
// Converts between Flaris numeric types and raw byte blocks (block).
// All functions are static - use BitConverter directly, no instance needed.
// Byte order is little-endian by default; pass bigEndian=true to any method to reverse.
// Floats are exact IEEE 754 (the sign of -0.0 and a NaN's payload survive; float32
// rounds half-to-even). A read past the end of the block returns 0 (false for ToBool).
//
// Usage:
//   import { BitConverter } from library("BitConverter", "1.0");
//
//   // Encode a 32-bit integer to bytes
//   let blk = BitConverter.GetBytesInt32(0x12345678);
//   Console.WriteLine(BitConverter.ToString(blk));    // "78-56-34-12" (LE)
//   Console.WriteLine(BitConverter.ToHex(blk));       // "78563412"
//
//   // Decode back
//   Console.WriteLine(BitConverter.ToInt32(blk, 0));  // 305419896
//
//   // Float round-trip
//   let fb   = BitConverter.GetBytesFloat64(3.14159);
//   let back = BitConverter.ToFloat64(fb, 0);         // ≈ 3.14159
//
//   // Read from a larger block at an offset
//   let ToInt32 = BitConverter.ToInt32(largeBlk, 8);  // read at byte offset 8
//
// Encoding (return a new block):
//   GetBytesInt16(v, bigEndian?)    →  2-byte block
//   GetBytesInt32(v, bigEndian?)    →  4-byte block
//   GetBytesInt64(v, bigEndian?)    →  8-byte block
//   GetBytesUInt16(v, bigEndian?)   →  2-byte block (unsigned)
//   GetBytesUInt32(v, bigEndian?)   →  4-byte block (unsigned)
//   GetBytesFloat32(v, bigEndian?)  →  4-byte block
//   GetBytesFloat64(v, bigEndian?)  →  8-byte block
//   GetBytesBool(v)                 →  1-byte block (0 or 1)
//
// Decoding (read from block at byte offset):
//   ToInt16(blk, offset, bigEndian?)    →  int
//   ToInt32(blk, offset, bigEndian?)    →  int
//   ToInt64(blk, offset, bigEndian?)    →  int
//   ToUInt16(blk, offset, bigEndian?)   →  int
//   ToUInt32(blk, offset, bigEndian?)   →  int
//   ToFloat32(blk, offset, bigEndian?)  →  float
//   ToFloat64(blk, offset, bigEndian?)  →  float
//   ToBool(blk, offset)                 →  bool  (byte != 0)
//
// Formatting:
//   ToString(blk)     →  string  - "XX-XX-XX-…" uppercase hex with dashes
//   ToHex(blk)        →  string  - uppercase hex without separator
//   FromHex(s)        →  block   - parse hex string, either case (spaces and
//                                  dashes ignored); an empty block when the
//                                  input is empty, has an odd digit count or
//                                  holds a non-hex character
//
// Utility:
//   IsLittleEndian()  →  bool    - the host's byte order, detected at run time
//                                  (false on big-endian targets such as MIPS)

import { Util } from library("Util", "1.0");

class BitConverter {

    // =========================================================================
    // Internal helpers
    // =========================================================================

    // Build a block from an array of byte values (0–255).
    fn static _block(bytes:array):block {
        let n:int = len(bytes);
        let blk:block = Buffer.Create(n, 1);
        Buffer.FromArray(blk, bytes);
        return blk;
    }

    // =========================================================================
    // GetBytes - numeric - block
    // =========================================================================

    // GetBytesInt64(v, bigEndian?) - block  (8 bytes, signed 64-bit)
    fn static GetBytesInt64(v:int, bigEndian?:bool):block {
        let blk:block = Buffer.Create(8, 1);
        Buffer.WriteU64At(blk, 0, v, bigEndian == true);
        return blk;
    }

    // GetBytesInt32(v, bigEndian?) - block  (4 bytes, signed 32-bit)
    fn static GetBytesInt32(v:int, bigEndian?:bool):block {
        let blk:block = Buffer.Create(4, 1);
        Buffer.WriteU32At(blk, 0, v, bigEndian == true);
        return blk;
    }

    // GetBytesInt16(v, bigEndian?) - block  (2 bytes, signed 16-bit)
    fn static GetBytesInt16(v:int, bigEndian?:bool):block {
        let blk:block = Buffer.Create(2, 1);
        Buffer.WriteU16At(blk, 0, v, bigEndian == true);
        return blk;
    }

    // GetBytesFloat64(v, bigEndian?) - block  (8 bytes, IEEE 754 double)
    fn static GetBytesFloat64(v, bigEndian?:bool):block {
        let blk:block = Buffer.Create(8, 1);
        Buffer.WriteFloat64At(blk, 0, float(v), bigEndian == true);
        return blk;
    }

    // GetBytesFloat32(v, bigEndian?) - block  (4 bytes, IEEE 754 single)
    fn static GetBytesFloat32(v, bigEndian?:bool):block {
        let blk:block = Buffer.Create(4, 1);
        Buffer.WriteFloat32At(blk, 0, float(v), bigEndian == true);
        return blk;
    }

    // GetBytesBool(v) - block  (1 byte: 0x00 or 0x01)
    fn static GetBytesBool(v:bool):block {
        return _block([v == true ? 1 : 0]);
    }

    // GetBytesUInt16(v, bigEndian?) - block  (2 bytes, unsigned 16-bit, 0–65535)
    fn static GetBytesUInt16(v:int, bigEndian?:bool):block {
        let blk:block = Buffer.Create(2, 1);
        Buffer.WriteU16At(blk, 0, v, bigEndian == true);
        return blk;
    }

    // GetBytesUInt32(v, bigEndian?) - block  (4 bytes, unsigned 32-bit, 0–4294967295)
    fn static GetBytesUInt32(v:int, bigEndian?:bool):block {
        let blk:block = Buffer.Create(4, 1);
        Buffer.WriteU32At(blk, 0, v, bigEndian == true);
        return blk;
    }

    // =========================================================================
    // To* - block - numeric
    // =========================================================================

    // ToInt64(blk, offset, bigEndian?) - int  (signed 64-bit)
    fn static ToInt64(blk:block, offset:int, bigEndian?:bool):int {
        return Buffer.ReadU64At(blk, offset, bigEndian == true);
    }

    // ToInt32(blk, offset, bigEndian?) - int  (signed 32-bit)
    fn static ToInt32(blk:block, offset:int, bigEndian?:bool):int {
        return Buffer.ReadI32At(blk, offset, bigEndian == true);
    }

    // ToInt16(blk, offset, bigEndian?) - int  (signed 16-bit)
    fn static ToInt16(blk:block, offset:int, bigEndian?:bool):int {
        return Buffer.ReadI16At(blk, offset, bigEndian == true);
    }

    // ToUInt16(blk, offset, bigEndian?) - int  (unsigned 16-bit, 0–65535)
    fn static ToUInt16(blk:block, offset:int, bigEndian?:bool):int {
        return Buffer.ReadU16At(blk, offset, bigEndian == true);
    }

    // ToUInt32(blk, offset, bigEndian?) - int  (unsigned 32-bit, 0–4294967295)
    fn static ToUInt32(blk:block, offset:int, bigEndian?:bool):int {
        return Buffer.ReadU32At(blk, offset, bigEndian == true);
    }

    // ToFloat64(blk, offset, bigEndian?) - float  (IEEE 754 double)
    fn static ToFloat64(blk:block, offset:int, bigEndian?:bool):float {
        return Buffer.ReadFloat64At(blk, offset, bigEndian == true);
    }

    // ToFloat32(blk, offset, bigEndian?) - float  (IEEE 754 single - float64)
    fn static ToFloat32(blk:block, offset:int, bigEndian?:bool):float {
        return Buffer.ReadFloat32At(blk, offset, bigEndian == true);
    }

    // ToBool(blk, offset) - bool  (0x00 = false, anything else = true)
    fn static ToBool(blk:block, offset:int):bool {
        return Buffer.ReadU8At(blk, offset) != 0;
    }

    // =========================================================================
    // Utility
    // =========================================================================

    // ToString(blk) - string  - "FF-0A-3B-..." uppercase hex pairs with dashes.
    fn static ToString(blk:block):string {
        let n:int = len(blk);
        if (n == 0) { return ""; }
        let hex:block = Buffer.FromString(ToHex(blk));
        let out:block = Buffer.Create(n * 3, 1);
        _dashInto(hex, n, out);
        return String.Substr(Buffer.ToString(out), 0, n * 3 - 1);
    }

    // Copy the n hex pairs in `hex` to `out` as "XX-" triples. Typed leaf.
    fn static _dashInto(hex:block, n:int, out:block):int {
        iter (i from 0 to n) {
            let o:int = i * 3;
            Buffer.WriteU8At(out, o, Buffer.ReadU8At(hex, i * 2));
            Buffer.WriteU8At(out, o + 1, Buffer.ReadU8At(hex, i * 2 + 1));
            Buffer.WriteU8At(out, o + 2, 45);                 // '-'
        }
        return n;
    }

    // ToHex(blk) - string  - "FF0A3B..." uppercase hex pairs, no separator.
    fn static ToHex(blk:block):string {
        if (len(blk) == 0) { return ""; }
        return String.ToUpper(Util.BinToHex(blk));
    }

    // FromHex(s) - block  - parse hex string (with or without dashes/spaces) into a block.
    // Each pair of hex chars is one byte. Returns an empty block for empty/invalid input.
    fn static FromHex(s:string):block {
        if (s == nil) { return Buffer.FromString(""); }
        var digits:string = s;
        if (String.IndexOfAnyFrom(digits, "- ", 0) >= 0) {
            digits = String.Replace(String.Replace(digits, "-", ""), " ", "");
        }
        let blk = Util.HexToBin(digits);
        if (blk == nil) { return Buffer.FromString(""); }
        return blk;
    }

    // IsLittleEndian() - bool  - a subscript store writes in host byte order, so
    // the low byte of a stored 1 lands first only on a little-endian host.
    fn static IsLittleEndian():bool {
        let probe:block = Buffer.Create(1, 2);
        probe[0] = 1;
        return Buffer.ReadU8At(probe, 0) == 1;
    }
}

export { BitConverter };
