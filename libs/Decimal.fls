// Decimal.fls - Arbitrary-precision decimal numbers for Flaris.
// Version: 1.0
//
// Avoids floating-point rounding errors for financial and exact arithmetic.
// All values are immutable objects. All methods are static - use Decimal.Xxx().
//
// Usage:
//   import { Decimal } from library("Decimal", "1.0");
//
//   let price = Decimal.From("19.99");
//   let tax   = Decimal.From("0.08");
//   let total = Decimal.Add(price, Decimal.Mul(price, tax));
//   Console.WriteLine(Decimal.ToString(total));   // "21.5892"
//   Console.WriteLine(Decimal.ToString(Decimal.Round(total, 2)));  // "21.59"
//
//   // Comparisons
//   if (Decimal.Gt(price, Decimal.From("10"))) { ... }
//
//   // Chaining via intermediate values
//   let result = Decimal.Round(Decimal.Div(Decimal.From("1"), Decimal.From("3"), 10), 4);
//   Console.WriteLine(Decimal.ToString(result));  // "0.3333"
//
// Creating:
//   Decimal.From(value)          - from an int, a float or a string. A string is
//                                  [sign] digits [. digits] [e|E [sign] digits]
//                                  ("3.14", "-.5", "1.5e3", "2E-7"); an exponent
//                                  of more than 100000 in magnitude, or any other
//                                  malformed string, gives 0. A float becomes the
//                                  shortest decimal that reads back as the same
//                                  float (From(0.1) is 0.1; a subnormal float keeps
//                                  17 significant digits); NaN and infinity give nil
//   Decimal.Parse(s)             →  Decimal or nil  - like From for strings, but
//                                  nil when s is malformed
//   Decimal.Zero()               - 0
//   Decimal.One()                - 1
//
// Arithmetic:
//   Decimal.Add(a, b)             →  Decimal  - scale: the larger of the two
//   Decimal.Sub(a, b)             →  Decimal
//   Decimal.Mul(a, b)             →  Decimal  - scale: the sum of the two
//   Decimal.Div(a, b, precision?) →  Decimal  - truncated to `precision` fractional
//                                   digits (default 28); a negative precision
//                                   truncates to tens, hundreds, ...; nil if b is 0
//   Decimal.Pow(d, exp:int)       →  Decimal  - integer exponent only; nil if exp < 0
//   Decimal.Neg(d)                →  Decimal  - unary negation
//   Decimal.Abs(d)                →  Decimal
//
// Rounding (places may be negative: -2 rounds to hundreds; a value that
// already has no more than `places` fractional digits is returned unchanged):
//   Decimal.Round(d, places)         →  Decimal  - half away from zero
//   Decimal.RoundHalfEven(d, places) →  Decimal  - banker's rounding
//   Decimal.Truncate(d, places)      →  Decimal  - toward zero
//   Decimal.Floor(d)                 →  Decimal  - round toward -∞
//   Decimal.Ceil(d)                  →  Decimal  - round toward +∞
//
// Comparison:
//   Decimal.Cmp(a, b)    →  int    - -1, 0, or 1
//   Decimal.Eq(a, b)     →  bool
//   Decimal.Lt(a, b)     →  bool
//   Decimal.Lte(a, b)    →  bool
//   Decimal.Gt(a, b)     →  bool
//   Decimal.Gte(a, b)    →  bool
//   Decimal.Min(a, b)    →  Decimal
//   Decimal.Max(a, b)    →  Decimal
//   Decimal.Sign(d)      →  int    - -1, 0, or 1
//   Decimal.IsZero(d)    →  bool
//   Decimal.IsNeg(d)     →  bool
//   Decimal.IsPos(d)     →  bool
//   Decimal.IsInteger(d) →  bool   - true if every fractional digit is zero
//
// Conversion:
//   Decimal.ToString(d)  →  string  - exact decimal string, e.g. "-3.14"
//   Decimal.ToFloat(d)   →  float   - nearest float; nil if d overflows a float or
//                                   is a non-zero value below 2.2e-308
//   Decimal.ToInt(d)     →  int     - truncates the fraction; nil outside the int64 range
//
// Internal representation (for reference):
//   { sign:int, limbs:[int], scale:int }
//   sign=1 (non-negative, including zero) or -1; limbs: little-endian base-10⁸
//   digits of the unscaled value, no leading zero limbs; scale >= 0;
//   value = sign × unscaled × 10^(-scale)

class Decimal {

    const _BASE      = 100000000;
    const _DIGITS    = 8;
    const _PRECISION = 28;         // fractional digits Div keeps when none is given
    const _MAX_EXP   = 100000;     // largest exponent magnitude a string may carry

    // ----------------------------------------------------------------
    // Internal helpers
    //
    // The typed kernels (limb arrays and ints in, int or [int] out) are
    // JIT-compiled; the untyped functions around them build the objects.
    // Limb arrays are always created with Array.Create(n, Type.Int) (or copied
    // with Array.Clone/Take) so that they stay [int] - see "Typed arrays: how
    // an array becomes one" in doc/reference.md.
    // ----------------------------------------------------------------

    fn static _make(sign, ls, sc) {
        if (len(ls) == 1 && ls[0] == 0) { return { sign: 1, limbs: ls, scale: sc }; }
        return { sign: sign, limbs: ls, scale: sc };
    }
    fn static _zero()  { return { sign: 1, limbs: Array.Create(1, Type.Int), scale: 0 }; }
    fn static _one()   { let ls = Array.Create(1, Type.Int); ls[0] = 1; return { sign: 1, limbs: ls, scale: 0 }; }
    fn static _isZeroL(ls: [int]): bool { return len(ls) == 1 && ls[0] == 0; }

    // Limbs of a non-negative int.
    fn static _intL(u: int): [int] {
        if (u < _BASE) { let r = Array.Create(1, Type.Int); r[0] = u; return r; }
        if (u < _BASE * _BASE) {
            let r = Array.Create(2, Type.Int);
            r[1] = u / _BASE;
            r[0] = u - r[1] * _BASE;
            return r;
        }
        let r = Array.Create(3, Type.Int);
        r[2] = u / (_BASE * _BASE);
        let rest = u - r[2] * _BASE * _BASE;
        r[1] = rest / _BASE;
        r[0] = rest - r[1] * _BASE;
        return r;
    }

    fn static _pow10(k: int): int {
        var p = 1;
        iter (i from 0 to k) { p *= 10; }
        return p;
    }

    fn static _topL(ls: [int], top: int): int {
        var t = top;
        while (t > 0 && ls[t] == 0) { t -= 1; }
        return t;
    }

    // Drops leading zero limbs; a long run is cut with one copy.
    fn static _trim(ls: [int]): [int] {
        let top = Decimal._topL(ls, len(ls) - 1);
        var n = len(ls);
        if (n - top > 4) { return Array.Take(ls, top + 1); }
        while (n - 1 > top) { n -= 1; Array.RemoveAt(ls, n); }
        return ls;
    }

    fn static _cmpL(a: [int], b: [int]): int {
        let na = len(a); let nb = len(b);
        if (na != nb) { return na < nb ? -1 : 1; }
        var i = na - 1;
        while (i >= 0) {
            if (a[i] != b[i]) { return a[i] < b[i] ? -1 : 1; }
            i -= 1;
        }
        return 0;
    }

    // r[0..n) = a + b mod _BASE^n, n = the longer length; returns the carry out.
    fn static _addTo(a: [int], b: [int], r: [int]): int {
        let na = len(a); let nb = len(b);
        let n = na > nb ? na : nb;
        var carry = 0;
        iter (i from 0 to n) {
            let s = (i < na ? a[i] : 0) + (i < nb ? b[i] : 0) + carry;
            let ov = (_BASE - 1 - s) >> 63;        // -1 when s >= _BASE
            r[i] = s - (ov & _BASE);
            carry = -ov;
        }
        return carry;
    }

    // r[0..len(a)) = a - b for a >= b.
    fn static _subTo(a: [int], b: [int], r: [int]): int {
        let na = len(a); let nb = len(b);
        var borrow = 0;
        iter (i from 0 to na) {
            let d = a[i] - (i < nb ? b[i] : 0) - borrow;
            let neg = d >> 63;                     // -1 when d < 0
            r[i] = d + (neg & _BASE);
            borrow = -neg;
        }
        return 0;
    }

    // x[xo .. xo+n) += y[0..n); returns the carry out.
    fn static _addBackInto(x: [int], xo: int, y: [int], n: int): int {
        var carry = 0;
        iter (i from 0 to n) {
            let s = x[xo + i] + y[i] + carry;
            let ov = (_BASE - 1 - s) >> 63;
            x[xo + i] = s - (ov & _BASE);
            carry = -ov;
        }
        return carry;
    }

    // r[ro .. ro+n] = ls[0..n) * m + add for m, add <= 2^36; returns the carry
    // out (also stored in r[ro+n]).
    fn static _mulSmallInto(ls: [int], r: [int], ro: int, m: int, add: int): int {
        let n = len(ls);
        var carry = add;
        iter (i from 0 to n) {
            let cur = ls[i] * m + carry;
            carry = cur / _BASE;
            r[ro + i] = cur - carry * _BASE;
        }
        r[ro + n] = carry;
        return carry;
    }

    // ls[from .. ] / d in place for 1 <= d <= 2^36, top limb first; returns
    // the remainder.
    fn static _divSmallL(ls: [int], from: int, d: int): int {
        var rem = 0;
        var i = len(ls) - 1;
        while (i >= from) {
            let cur = rem * _BASE + ls[i];
            let q = cur / d;
            ls[i] = q;
            rem   = cur - q * d;
            i -= 1;
        }
        return rem;
    }

    // r[0 .. na+nb) = a * b, one row of b's limbs per pass; the column sums
    // are carried out every 512 rows so that none can overflow an int.
    fn static _mulTo(a: [int], b: [int], r: [int]): int {
        let nb = len(b);
        var rows = 0;
        iter (i from 0 to nb) {
            Decimal._rowInto(b[i], a, r, i);
            rows += 1;
            if (rows == 512) { Decimal._carryInto(r); rows = 0; }
        }
        Decimal._carryInto(r);
        return 0;
    }

    // r[ro .. ro+len(a)) += m * a.
    fn static _rowInto(m: int, a: [int], r: [int], ro: int): int {
        let n = len(a);
        var t = 0;
        while (t < n) { r[ro + t] += m * a[t]; t += 1; }
        return 0;
    }

    // Normalises r (non-negative column sums below 2^63) to limbs.
    fn static _carryInto(r: [int]): int {
        var carry = 0;
        iter (k from 0 to len(r)) {
            let v = r[k] + carry;
            carry = v / _BASE;
            r[k] = v - carry * _BASE;
        }
        return carry;
    }

    // u[uo .. uo+n) -= qhat * v[0..n); returns the borrow out. The borrow is
    // resolved without branches, which on random limbs would mispredict.
    fn static _subMulInto(u: [int], uo: int, v: [int], n: int, qhat: int): int {
        var borrow = 0;
        iter (i from 0 to n) {
            let p  = qhat * v[i];
            let ph = p / _BASE;
            let t  = u[uo + i] - (p - ph * _BASE) - borrow;
            let m1 = t >> 63;                  // -1 when t < 0
            let m2 = (t + _BASE) >> 63;        // -1 when t < -_BASE
            u[uo + i] = t + (m1 & _BASE) + (m2 & _BASE);
            borrow = ph - m1 - m2;
        }
        return borrow;
    }

    // Knuth, TAOCP vol. 2, 4.3.1, Algorithm D, as in BigInt: u (m+n+1 limbs)
    // and v (n >= 2 limbs) are normalised so that v[n-1] >= _BASE/2; the m+1
    // quotient limbs go to q and the normalised remainder stays in u[0..n).
    fn static _divKnuthL(u: [int], v: [int], q: [int], n: int, m: int): int {
        let vTop  = v[n - 1];
        let vNext = v[n - 2];
        var j = m;
        while (j >= 0) {
            let num = u[j + n] * _BASE + u[j + n - 1];
            var qhat = num / vTop;
            var rhat = num - qhat * vTop;
            while (rhat < _BASE && (qhat >= _BASE || qhat * vNext > rhat * _BASE + u[j + n - 2])) {
                qhat -= 1;
                rhat += vTop;
            }
            let top = u[j + n] - Decimal._subMulInto(u, j, v, n, qhat);
            if (top < 0) {
                qhat -= 1;
                u[j + n] = top + Decimal._addBackInto(u, j, v, n);
            } else {
                u[j + n] = top;
            }
            q[j] = qhat;
            j -= 1;
        }
        return 0;
    }

    // Sized from the top limbs: when they cannot carry, the result has
    // exactly the longer length and needs no trimming.
    fn static _addL(a: [int], b: [int]): [int] {
        let na = len(a); let nb = len(b);
        let n = na > nb ? na : nb;
        let top = (na == n ? a[n - 1] : 0) + (nb == n ? b[n - 1] : 0);
        if (top < _BASE - 1) {
            let r = Array.Create(n, Type.Int);
            Decimal._addTo(a, b, r);
            return r;
        }
        let r = Array.Create(n + 1, Type.Int);
        r[n] = Decimal._addTo(a, b, r);
        if (r[n] == 0) { Array.RemoveAt(r, n); }
        return r;
    }

    fn static _subL(a: [int], b: [int]): [int] {     // a >= b
        let r = Array.Create(len(a), Type.Int);
        Decimal._subTo(a, b, r);
        return Decimal._trim(r);
    }

    fn static _mulL(a: [int], b: [int]): [int] {
        let n = len(a) + len(b);
        let r = Array.Create(n, Type.Int);
        Decimal._mulTo(a, b, r);
        if (r[n - 1] == 0) { Array.RemoveAt(r, n - 1); }
        return r;
    }

    // ls * 10^k (ls normalised, so at most the spare top limb stays zero).
    fn static _scaleUpL(ls: [int], k: int): [int] {
        if (k == 0 || (len(ls) == 1 && ls[0] == 0)) { return ls; }
        let limbs = k / _DIGITS;
        let n = len(ls) + limbs + 1;
        let r = Array.Create(n, Type.Int);
        if (Decimal._mulSmallInto(ls, r, limbs, Decimal._pow10(k % _DIGITS), 0) == 0 && n > 1) {
            Array.RemoveAt(r, n - 1);
        }
        return r;
    }

    // floor(ls / 10^k).
    fn static _scaleDownL(ls: [int], k: int): [int] {
        if (k == 0) { return ls; }
        let limbs = k / _DIGITS;
        if (limbs >= len(ls)) { return Array.Create(1, Type.Int); }
        let r = Array.Skip(ls, limbs);
        let d = Decimal._pow10(k % _DIGITS);
        if (d > 1) { Decimal._divSmallL(r, 0, d); }
        return Decimal._trim(r);
    }

    // What dividing ls by 10^k (k >= 1) throws away: 0 nothing, 1 less than
    // half, 2 exactly half, 3 more than half.
    fn static _dropKindL(ls: [int], k: int): int {
        let p = k - 1;                               // position of the first dropped digit
        let li = p / _DIGITS;
        if (li >= len(ls)) { return Decimal._isZeroL(ls) ? 0 : 1; }
        let unit = Decimal._pow10(p % _DIGITS);
        let limb = ls[li];
        let first = (limb / unit) % 10;
        var rest = limb % unit != 0;
        var i = 0;
        while (!rest && i < li) { if (ls[i] != 0) { rest = true; } i += 1; }
        if (first == 0) { return rest ? 1 : 0; }
        if (first < 5) { return 1; }
        if (first == 5 && !rest) { return 2; }
        return 3;
    }

    // |a| / |b| truncated and |a| mod |b|, as limb arrays { q, r }; b != 0.
    fn static _divmodL(a: [int], b: [int]) {
        if (Decimal._cmpL(a, b) < 0) { return { q: Array.Create(1, Type.Int), r: a }; }
        let n = len(b);
        if (n == 1) {
            let q = Array.Clone(a);
            let rem = Decimal._divSmallL(q, 0, b[0]);
            return { q: Decimal._trim(q), r: Decimal._intL(rem) };
        }
        let m = len(a) - n;
        let d = _BASE / (b[n - 1] + 1);
        let u = Array.Create(len(a) + 1, Type.Int);
        let v = Array.Create(n + 1, Type.Int);
        Decimal._mulSmallInto(a, u, 0, d, 0);
        Decimal._mulSmallInto(b, v, 0, d, 0);
        let q = Array.Create(m + 1, Type.Int);
        Decimal._divKnuthL(u, v, q, n, m);
        let r = Array.Take(u, n);
        if (d > 1) { Decimal._divSmallL(r, 0, d); }
        return { q: Decimal._trim(q), r: Decimal._trim(r) };
    }

    // Scans [sign] digits [. digits] [e|E [sign] digits] and writes the
    // digits, point ignored, to ls as limbs (ls sized len(s)/8 + 1). Returns
    // -1 if malformed, else (scale + 2^30) * 2^24 + limbCount * 2 + negative,
    // where limbCount leaves out leading zero limbs and scale = fraction
    // digits - exponent, which may be negative.
    fn static _parseInto(s: string, ls: [int]): int {
        let n = len(s);
        var i = 0;
        var neg = 0;
        if (n > 0) {
            let c0 = String.CharAt(s, 0);
            if (c0 == '-') { neg = 1; i = 1; } else if (c0 == '+') { i = 1; }
        }
        var dot = -1;
        var end = i;
        var digits = 0;
        while (end < n) {
            let c = int(String.CharAt(s, end));
            if (c >= 48 && c <= 57) { digits += 1; }
            else if (c == 46 && dot < 0) { dot = end; }
            else { break; }
            end += 1;
        }
        if (digits == 0) { return -1; }
        var exp = 0;
        if (end < n) {
            let ce = String.CharAt(s, end);
            if (ce != 'e' && ce != 'E') { return -1; }
            var j = end + 1;
            var eneg = false;
            if (j < n && String.CharAt(s, j) == '-') { eneg = true; j += 1; }
            else if (j < n && String.CharAt(s, j) == '+') { j += 1; }
            if (j >= n) { return -1; }
            while (j < n) {
                let c = int(String.CharAt(s, j)) - 48;
                if (c < 0 || c > 9) { return -1; }
                exp = exp * 10 + c;
                if (exp > _MAX_EXP) { return -1; }
                j += 1;
            }
            if (eneg) { exp = -exp; }
        }
        var frac = 0;
        if (dot >= 0) { frac = end - dot - 1; }
        var k = 0;
        var v = 0;
        var mul = 1;
        var p = end - 1;
        while (p >= i) {
            let c = int(String.CharAt(s, p));
            if (c != 46) {
                v += (c - 48) * mul;
                mul *= 10;
                if (mul == _BASE) { ls[k] = v; k += 1; v = 0; mul = 1; }
            }
            p -= 1;
        }
        if (mul > 1) { ls[k] = v; k += 1; }
        while (k > 1 && ls[k - 1] == 0) { k -= 1; }
        return (frac - exp + 1073741824) * 16777216 + k * 2 + neg;
    }

    // Decimal string of the unscaled integer (no sign, no decimal point).
    fn static _unscaledStr(ls) {
        let k = len(ls);
        if (k == 1) { return Convert.ToString(ls[0]); }
        let parts = Array.Create(k);
        parts[0] = Convert.ToString(ls[k - 1]);
        var i = k - 2;
        var j = 1;
        while (i >= 0) {
            parts[j] = String.PadLeft(Convert.ToString(ls[i]), _DIGITS, '0');
            i -= 1; j += 1;
        }
        return String.Join(parts, "");
    }

    // Both unscaled values at the larger scale: { al, bl, scale }.
    fn static _align(a, b) {
        if (a.scale == b.scale) { return { al: a.limbs, bl: b.limbs, scale: a.scale }; }
        if (a.scale < b.scale) {
            return { al: Decimal._scaleUpL(a.limbs, b.scale - a.scale), bl: b.limbs, scale: b.scale };
        }
        return { al: a.limbs, bl: Decimal._scaleUpL(b.limbs, a.scale - b.scale), scale: a.scale };
    }

    // ----------------------------------------------------------------
    // Construction
    // ----------------------------------------------------------------

    fn static From(value) {
        if (Type.Is(value, Type.Int)) {
            if (value >= 0) { return { sign: 1, limbs: Decimal._intL(value), scale: 0 }; }
            return Decimal._fromInt(value);
        }
        if (Type.Is(value, Type.Float))  { return Decimal._fromFloat(value); }
        if (Type.Is(value, Type.String)) {
            let d = Decimal._parseStr(value);
            if (d != nil) { return d; }
        }
        return Decimal._zero();
    }

    fn static Parse(s: string) { return Decimal._parseStr(s); }

    fn static _fromInt(v: int) {
        if (v == 0) { return Decimal._zero(); }
        if (v == -9223372036854775807 - 1) { return Decimal._parseStr("-9223372036854775808"); }
        if (v < 0) { return { sign: -1, limbs: Decimal._intL(-v), scale: 0 }; }
        return { sign: 1, limbs: Decimal._intL(v), scale: 0 };
    }

    fn static _parseStr(s: string) {
        if (s == nil) { return nil; }
        var ls = Array.Create(len(s) / _DIGITS + 1, Type.Int);
        let code = Decimal._parseInto(s, ls);
        if (code < 0) { return nil; }
        let k = (code / 2) % 8388608;
        var n = len(ls);
        if (n - k > 4) { ls = Array.Take(ls, k); }
        while (n > k) { n -= 1; Array.RemoveAt(ls, n); }
        var scale = code / 16777216 - 1073741824;
        if (scale < 0) { ls = Decimal._scaleUpL(ls, -scale); scale = 0; }
        if ((code & 1) == 1 && (k > 1 || ls[0] != 0)) { return { sign: -1, limbs: ls, scale: scale }; }
        return { sign: 1, limbs: ls, scale: scale };
    }

    // The shortest decimal that reads back as f: start from the 17
    // significant digits every double round-trips through, then round to 1,
    // 2, ... digits and keep the first that parses back to f. Two doubles
    // are compared through their 17-digit forms, which are equal exactly
    // when the doubles are.
    fn static _fromFloat(f: float) {
        if (!Math.IsFinite(f)) { return nil; }
        let exact = Convert.ToString(f);
        let full = Decimal._parseStr(exact);
        let digits = len(Decimal._unscaledStr(full.limbs));
        iter (p from 1 to digits) {
            let r = Decimal._roundDigits(full, digits - p, false);
            if (Convert.ToString(Convert.ParseFloat(Decimal.ToString(r))) == exact) {
                return Decimal._stripZeros(r);
            }
        }
        return Decimal._stripZeros(full);
    }

    // d without trailing zeros in its fraction.
    fn static _stripZeros(d) {
        var ls = d.limbs;
        var sc = d.scale;
        while (sc > 0 && !Decimal._isZeroL(ls) && Decimal._dropKindL(ls, 1) == 0) {
            ls = Decimal._scaleDownL(ls, 1);
            sc -= 1;
        }
        return Decimal._make(d.sign, ls, sc);
    }

    fn static Zero() { return Decimal._zero(); }
    fn static One()  { return Decimal._one(); }

    // ----------------------------------------------------------------
    // Output
    // ----------------------------------------------------------------

    fn static ToString(d) {
        let raw = Decimal._unscaledStr(d.limbs);
        let sc = d.scale;
        var result = raw;
        if (sc > 0) {
            if (len(raw) > sc) {
                result = String.Substr(raw, 0, len(raw) - sc) + "." + String.Substr(raw, len(raw) - sc);
            } else {
                result = "0." + String.PadLeft(raw, sc, '0');
            }
        }
        return d.sign == -1 ? "-" + result : result;
    }

    fn static ToFloat(d) {
        return Convert.ParseFloat(Decimal.ToString(d));
    }

    // Returns the integer part (truncated toward zero) as a Flaris int,
    // or nil if the value does not fit in int64.
    fn static ToInt(d) {
        let ls = Decimal._scaleDownL(d.limbs, d.scale);
        let k = len(ls);
        if (k > 3) { return nil; }
        // 2^63 = 922 33720368 54775808 in limbs; a negative value may reach it.
        if (k == 3) {
            let lim = d.sign == -1 ? 54775808 : 54775807;
            if (ls[2] > 922) { return nil; }
            if (ls[2] == 922 && (ls[1] > 33720368 || (ls[1] == 33720368 && ls[0] > lim))) { return nil; }
        }
        var res = 0;
        var i = k - 1;
        while (i >= 0) { res = res * _BASE - ls[i]; i -= 1; }
        return d.sign == -1 ? res : -res;
    }

    // ----------------------------------------------------------------
    // Comparison
    // ----------------------------------------------------------------

    fn static Cmp(a, b) {
        let az = Decimal._isZeroL(a.limbs); let bz = Decimal._isZeroL(b.limbs);
        if (az && bz) { return 0; }
        if (a.sign != b.sign || az || bz) {
            let sa = az ? 0 : a.sign; let sb = bz ? 0 : b.sign;
            return sa > sb ? 1 : (sa < sb ? -1 : 0);
        }
        let p = Decimal._align(a, b);
        let c = Decimal._cmpL(p.al, p.bl);
        return a.sign == 1 ? c : -c;
    }

    fn static Eq(a, b)  { return Decimal.Cmp(a, b) == 0; }
    fn static Lt(a, b)  { return Decimal.Cmp(a, b) <  0; }
    fn static Lte(a, b) { return Decimal.Cmp(a, b) <= 0; }
    fn static Gt(a, b)  { return Decimal.Cmp(a, b) >  0; }
    fn static Gte(a, b) { return Decimal.Cmp(a, b) >= 0; }

    fn static IsZero(d) { return Decimal._isZeroL(d.limbs); }
    fn static IsNeg(d)  { return d.sign == -1 && !Decimal._isZeroL(d.limbs); }
    fn static IsPos(d)  { return d.sign == 1  && !Decimal._isZeroL(d.limbs); }

    // ----------------------------------------------------------------
    // Arithmetic
    // ----------------------------------------------------------------

    fn static Neg(d) {
        if (Decimal._isZeroL(d.limbs)) { return d; }
        return { sign: -d.sign, limbs: d.limbs, scale: d.scale };
    }

    fn static Abs(d) { return { sign: 1, limbs: d.limbs, scale: d.scale }; }

    fn static Add(a, b) {
        var al = a.limbs; var bl = b.limbs; var sc = a.scale;
        if (a.scale < b.scale)      { al = Decimal._scaleUpL(al, b.scale - a.scale); sc = b.scale; }
        else if (b.scale < a.scale) { bl = Decimal._scaleUpL(bl, a.scale - b.scale); }
        // Equal signs: the sum is zero only when both are, and zero has sign 1.
        if (a.sign == b.sign) { return { sign: a.sign, limbs: Decimal._addL(al, bl), scale: sc }; }
        let c = Decimal._cmpL(al, bl);
        if (c == 0) { return { sign: 1, limbs: Array.Create(1, Type.Int), scale: sc }; }
        if (c  > 0) { return Decimal._make(a.sign, Decimal._subL(al, bl), sc); }
        return Decimal._make(b.sign, Decimal._subL(bl, al), sc);
    }

    fn static Sub(a, b) { return Decimal.Add(a, Decimal.Neg(b)); }

    fn static Mul(a, b) {
        let al = a.limbs; let bl = b.limbs;
        let sc = a.scale + b.scale;
        if ((len(al) == 1 && al[0] == 0) || (len(bl) == 1 && bl[0] == 0)) {
            return { sign: 1, limbs: Array.Create(1, Type.Int), scale: sc };
        }
        let sign = a.sign == b.sign ? 1 : -1;
        if (len(al) == 1 && len(bl) == 1) { return { sign: sign, limbs: Decimal._intL(al[0] * bl[0]), scale: sc }; }
        return { sign: sign, limbs: Decimal._mulL(al, bl), scale: sc };
    }

    // Divide a by b, keeping `precision` fractional digits (default 28) and
    // truncating the rest. Returns nil for division by zero.
    fn static Div(a, b, precision?: int) {
        if (Decimal._isZeroL(b.limbs)) { return nil; }
        if (precision == nil) { precision = _PRECISION; }
        if (precision < 0) { return Decimal.Truncate(Decimal.Div(a, b, 0), precision); }
        // unscaled result = a.unscaled * 10^shift / b.unscaled
        let shift = precision + b.scale - a.scale;
        var num = a.limbs; var den = b.limbs;
        if (shift >= 0) { num = Decimal._scaleUpL(num, shift); }
        else            { den = Decimal._scaleUpL(den, -shift); }
        var q = nil;
        if (len(den) == 1) {
            // One-limb divisor: the quotient has at most one leading zero limb.
            q = Array.Clone(num);
            Decimal._divSmallL(q, 0, den[0]);
            let n = len(q);
            if (n > 1 && q[n - 1] == 0) { Array.RemoveAt(q, n - 1); }
        } else {
            q = Decimal._divmodL(num, den).q;
        }
        return Decimal._make(a.sign == b.sign ? 1 : -1, q, precision);
    }

    // Integer exponentiation. exp must be a non-negative Flaris int.
    // Returns nil for negative exp.
    fn static Pow(d, exp: int) {
        if (exp < 0) { return nil; }
        var result = Decimal._one(); var cur = d;
        while (exp > 0) {
            if (exp % 2 == 1) { result = Decimal.Mul(result, cur); }
            exp = exp / 2;
            if (exp > 0) { cur = Decimal.Mul(cur, cur); }
        }
        return result;
    }

    // ----------------------------------------------------------------
    // Rounding
    // ----------------------------------------------------------------

    // d with `drop` (> 0) fewer digits of unscaled value, rounded half away from
    // zero, or half to even when halfEven is true.
    fn static _roundDigits(d, drop: int, halfEven: bool) {
        if (drop <= 0) { return d; }
        let kind = Decimal._dropKindL(d.limbs, drop);
        var q = Decimal._scaleDownL(d.limbs, drop);
        var up = kind == 3 || (kind == 2 && (!halfEven || q[0] % 2 == 1));
        if (up) { q = Decimal._addL(q, Decimal._intL(1)); }
        var sc = d.scale - drop;
        if (sc < 0) { q = Decimal._scaleUpL(q, -sc); sc = 0; }
        return Decimal._make(d.sign, q, sc);
    }

    // Truncate toward zero to `places` fractional digits.
    fn static Truncate(d, places: int) {
        if (d.scale <= places) { return d; }
        let drop = d.scale - places;
        var q = Decimal._scaleDownL(d.limbs, drop);
        var sc = places;
        if (sc < 0) { q = Decimal._scaleUpL(q, -sc); sc = 0; }
        return Decimal._make(d.sign, q, sc);
    }

    // Round half-up (away from zero on ties) to `places` fractional digits.
    fn static Round(d, places: int) {
        if (d.scale <= places) { return d; }
        return Decimal._roundDigits(d, d.scale - places, false);
    }

    // Round d to `places` fractional digits using round-half-to-even: a
    // discarded part of exactly half moves the last kept digit to the nearest
    // even value; otherwise it matches Round.
    fn static RoundHalfEven(d, places: int) {
        if (d.scale <= places) { return d; }
        return Decimal._roundDigits(d, d.scale - places, true);
    }

    // Largest integer <= d.
    fn static Floor(d) {
        let t = Decimal.Truncate(d, 0);
        if (d.sign == 1 || d.scale == 0 || Decimal._dropKindL(d.limbs, d.scale) == 0) { return t; }
        return Decimal._make(-1, Decimal._addL(t.limbs, Decimal._intL(1)), 0);
    }

    // Smallest integer >= d.
    fn static Ceil(d) {
        let t = Decimal.Truncate(d, 0);
        if (d.sign == -1 || d.scale == 0 || Decimal._dropKindL(d.limbs, d.scale) == 0) { return t; }
        return Decimal._make(1, Decimal._addL(t.limbs, Decimal._intL(1)), 0);
    }

    // ----------------------------------------------------------------
    // Sign / comparison helpers
    // ----------------------------------------------------------------

    // Return -1 if negative, 0 if zero, 1 if positive.
    fn static Sign(d) {
        if (Decimal._isZeroL(d.limbs)) { return 0; }
        return d.sign;
    }

    // Return whichever of a, b is greater (or a if equal).
    fn static Max(a, b) {
        return Decimal.Cmp(a, b) >= 0 ? a : b;
    }

    // Return whichever of a, b is smaller (or a if equal).
    fn static Min(a, b) {
        return Decimal.Cmp(a, b) <= 0 ? a : b;
    }

    // True if d has no fractional part (scale == 0, or all fractional digits are zero).
    fn static IsInteger(d) {
        if (d.scale == 0) { return true; }
        return Decimal._dropKindL(d.limbs, d.scale) == 0;
    }
}
export { Decimal };
