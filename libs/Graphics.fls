// =============================================================================
// Graphics.fls - 2D drawing for Flaris.
// Version: 1.0
//
// A complete software rasteriser written in Flaris: shapes, text, image
// compositing and PNG output, with a stateful style context so you set stroke,
// fill and thickness once instead of passing them to every call.
//
// Usage:
//   import { Graphics } from library("Graphics", "1.0");
//
//   let g = new Graphics(800, 600);
//   g.Clear(0xFFFFFFFF);              // white background
//   g.SetStroke(Graphics.RGB(0, 0, 0));
//   g.SetFill(Graphics.RGB(220, 60, 60));
//   g.SetThickness(2);
//   g.Circle(400, 300, 100);          // filled + outlined
//   g.DrawText(10, 10, "Hello");
//   g.Save("output.png");
//
//   let photo = Graphics.FromFile("photo.png");
//   photo.GrayscaleAll();
//   photo.Save("gray.png");
//
// Colour format: 0xAARRGGBB. Fully opaque is 0xFF______. A fill of 0 means "no
// fill" - outline only. Anything drawn with an alpha below 255 is composited
// over what is already there; alpha 0 draws nothing.
//
//   Graphics.RGB(r, g, b)        Graphics.RGBA(r, g, b, a)
//   Graphics.HSL(hue, sat, light)   hue in degrees, sat/light in 0..1
//
// Construction:
//   new Graphics(width, height)      Graphics.Create(width, height)
//   Graphics.FromFile(path)          Graphics.LoadImage(path)     -> instance|nil
//
// Style:
//   SetStroke(argb)   SetFill(argb)   SetThickness(n)
//   StrokeColor()     FillColor()     Thickness()
//
// Shapes - outline uses stroke + thickness, fills use fill:
//   Clear(colour)                     Pixel(x, y, colour)   GetPixel(x, y)
//   Line(x0,y0,x1,y1)                 HLine(x0,y,x1)        VLine(x,y0,y1)
//   Polyline(pts)                     Polygon(pts)          FillPolygon(pts)
//   Rect(x,y,w,h)                     FillRect(x,y,w,h)
//   RoundRect(x,y,w,h,r)              DrawRoundRect(...)    FillRoundRect(...)
//   Circle(cx,cy,r)                   DrawCircle(...)       FillCircle(...)
//   Ellipse(cx,cy,rx,ry)              FillEllipse(...)
//   Arc(cx,cy,r,a0,a1)                ArcButt(...)
//   Pie(cx,cy,r,a0,a1)                FillPie(...)
//
// Point lists are flat: [x0,y0, x1,y1, ...], not nested pairs.
//
// Text - an 8x8 bitmap font, integer-scaled, drawn opaquely:
//   DrawChar(x,y,code)                DrawCharScaled(x,y,code,scale)
//   DrawText(x,y,text)                DrawTextEx(x,y,text,scale)
//   TextWidth(text,scale)             TextHeight(scale)     TextMetrics(...)
//
// Images and compositing:
//   DrawImage(path,x,y,w,h)           DrawImageNearest(path,x,y,w,h)
//   Blit(x,y,w,h,pixels)              Draw(src,x,y)         DrawGfx(handle,x,y)
//   BlendRect(src,dx,dy,alpha)        Blend(src,dx,dy)
//   CopyRect(x,y,w,h) -> instance     Resize(w,h)           Rescale(sx,sy)
//
// Effects - each has an ...All() form covering the whole canvas:
//   Grayscale(x,y,w,h)                Brightness(x,y,w,h,factor)
//   Filter(fn,x,y,w,h)                fn(pixel) -> pixel, or nil to keep it
//   FilterCallback(fn,x,y,w,h,cb)     FilterEvent(fn,x,y,w,h,eventId)
//
// Output:
//   Save(path) -> bool                ToBlock() -> block of PNG bytes
//
// Notes:
//   - Both DrawImage and DrawImageNearest currently resample with
//     nearest-neighbour; smooth (bilinear) scaling is not implemented yet.
//   - Filter runs your callback per pixel as ordinary code. FilterCallback and
//     FilterEvent hand the region to an offload kernel instead, which runs on
//     another core when it qualifies - see FilterRegion on the rasteriser for
//     the descriptor a kernel receives.
// =============================================================================

import { Png } from library("Png", "1.0");

class Raster {

    // Commands are variable length: [op][size] then payload, size counting the
    // header. Rect ops carry dst/stride/x/y/w/h/colour (9 words); LINE also
    // needs the surface extent, because a line clips per pixel rather than up
    // front like a rect (11 words).
    fn static CmdRect():int { return 9; }
    fn static CmdLine():int { return 11; }
    fn static CmdStamp():int { return 12; }
    fn static CmdComposite():int { return 9; }
    fn static CmdScale():int     { return 10; }
    fn static CmdGlyph():int     { return 12; }
    fn static CmdFilter():int    { return 10; }
    fn static CmdRing():int      { return 11; }
    fn static MaxCmdWords():int { return 13; }

    // 256 glyphs x 8 rows, two rows-packed words each.
    fn static FontWords():int { return 512; }

    // 256-entry channel lookup, rebuilt per Brightness call.
    fn static LutWords():int { return 256; }

    fn static OpFill():int  { return 1; }
    fn static OpBlend():int { return 2; }
    fn static OpLine():int  { return 3; }
    fn static OpStamp():int { return 4; }
    fn static OpComposite():int { return 5; }
    fn static OpScale():int     { return 6; }
    fn static OpGlyph():int     { return 7; }
    fn static OpFilter():int    { return 8; }
    fn static OpRing():int      { return 9; }

    // Row replication pays off once a fill spans the full stride and is more
    // than a few rows; below that the per-call overhead beats the kernel.
    fn static ReplicateMinRows():int { return 8; }

    let _arena:block = nil;
    let _cap:int     = 0;
    let _next:int    = 0;
    let _cmdCap:int  = 0;
    let _nCmd:int    = 0;
    let _cmdEnd:int  = 1;
    let _fontBase:int = 0;
    let _freeOff:array = [];
    let _freeLen:array = [];
    let _lutBase:int  = 0;

    fn Constructor(pixelWords:int, cmdSlots:int) {
        this._cmdCap = cmdSlots;
        this._fontBase = 1 + cmdSlots * Raster.MaxCmdWords();
        this._lutBase  = _fontBase + Raster.FontWords();
        this._next   = _lutBase + Raster.LutWords();
        this._cap    = _next + pixelWords;
        this._arena  = Buffer.Create(_cap, 4);
        this._arena[0] = 0;
        this._nCmd   = 0;
        this._cmdEnd = 1;
        // The font lives in the arena so a glyph blit reads glyph and surface
        // from one block - a kernel is handed exactly one.
        let f = Raster._font();
        var k = 0;
        while (k < Raster.FontWords()) { this._arena[_fontBase + k] = f[k]; k = k + 1; }
    }

    fn Arena():block { return _arena; }

    // NewSurface(w, h) -> { off, w, h } or nil when the arena cannot fit it.
    fn NewSurface(w:int, h:int) : object|nil {
        if (w <= 0 || h <= 0) { return nil; }
        if (w > Raster.MaxSide() || h > Raster.MaxSide()) { return nil; }
        if (w * h > Raster.MaxPixels()) { return nil; }
        let off = this._reserve(w * h);
        if (off < 0) { return nil; }
        return { off: off, w: w, h: h };
    }

    // Surface allocation.
    //
    // Every surface must live in the one arena - that is what lets an operation
    // reading one surface and writing another stay a single-block kernel. But
    // surfaces are created and released in any order, so a bump pointer alone
    // would leak: freed space would never come back and NewSurface would
    // eventually return nil, at which point drawing silently does nothing.
    //
    // So: bump for fresh space, plus a free list of released spans for reuse.
    // Spans are coalesced on release, and a span adjacent to the bump pointer
    // gives the space back outright. Surfaces are few and large, so first fit
    // over a short list costs nothing worth optimising.
    //
    // Mark/Release remain for the scratch case (CopyRect, Resize, Blit staging),
    // where strict LIFO is known and cheaper than touching the free list.
    fn Mark():int { return _next; }
    fn Release(mark:int) {
        if (mark >= 0 && mark <= _next) { _next = mark; }
        return;
    }

    fn _reserve(words:int):int {
        // First fit over the free list.
        var i = 0;
        while (i < len(_freeOff)) {
            if (_freeLen[i] >= words) {
                let off = _freeOff[i];
                if (_freeLen[i] == words) {
                    Array.RemoveAt(_freeOff, i);
                    Array.RemoveAt(_freeLen, i);
                } else {
                    _freeOff[i] = off + words;
                    _freeLen[i] = _freeLen[i] - words;
                }
                return off;
            }
            i = i + 1;
        }
        if (_next + words > _cap) { return 0 - 1; }
        let off = _next;
        _next = _next + words;
        return off;
    }

    // FreeSurface(s) - return a surface's span to the arena. Pending drawing is
    // flushed first, because queued commands still reference the span.
    fn FreeSurface(s:object) {
        if (s == nil) { return; }
        this.Flush();
        let off = s.off;
        let n = s.w * s.h;
        if (off + n == _next) { _next = off; this._reclaim(); return; }
        Array.Append(_freeOff, off);
        Array.Append(_freeLen, n);
        this._coalesce();
        return;
    }

    // Merge adjacent free spans, then hand back anything touching the bump.
    fn _coalesce() {
        var changed = 1;
        while (changed == 1) {
            changed = 0;
            var i = 0;
            while (i < len(_freeOff)) {
                var j = 0;
                while (j < len(_freeOff)) {
                    if (i != j && _freeOff[i] + _freeLen[i] == _freeOff[j]) {
                        _freeLen[i] = _freeLen[i] + _freeLen[j];
                        Array.RemoveAt(_freeOff, j);
                        Array.RemoveAt(_freeLen, j);
                        changed = 1;
                        j = len(_freeOff);
                        i = len(_freeOff);
                    } else { j = j + 1; }
                }
                i = i + 1;
            }
        }
        this._reclaim();
        return;
    }

    fn _reclaim() {
        var i = 0;
        while (i < len(_freeOff)) {
            if (_freeOff[i] + _freeLen[i] == _next) {
                _next = _freeOff[i];
                Array.RemoveAt(_freeOff, i);
                Array.RemoveAt(_freeLen, i);
                i = 0;
            } else { i = i + 1; }
        }
        return;
    }

    // Free words still available without growing.
    fn Cap():int { return _cap; }

    // Upper bounds on a single surface. Without them a hostile or mistaken
    // width*height overflows the allocation maths.
    fn static MaxSide():int   { return 16384; }
    fn static MaxPixels():int { return 268435456; }

    // Make room for `words` more pixels, growing the arena if needed.
    fn EnsureFree(words:int):bool {
        if (this.Available() >= words) { return true; }
        return this.Grow(_cap + words * 2);
    }

    fn Available():int {
        var n = _cap - _next;
        var i = 0;
        while (i < len(_freeLen)) { n = n + _freeLen[i]; i = i + 1; }
        return n;
    }

    // Grow the arena to at least `words` of pixel space. Surfaces hold offsets,
    // not pointers, so copying into a larger block keeps every one of them valid.
    fn Grow(words:int):bool {
        if (words <= _cap) { return true; }
        if (words > Raster.MaxPixels()) { return false; }
        this.Flush();
        let bigger = Buffer.Create(words, 4);
        if (bigger == nil) { return false; }
        Buffer.Copy(_arena, 0, bigger, 0, _cap * 4);
        _arena = bigger;
        _cap = words;
        return true;
    }

    // Clip, then queue. Clipping here means the kernel never re-checks bounds
    // per pixel for a rect.
    fn _push(op:int, s:object, x:int, y:int, w:int, h:int, col:int) {
        var x0 = x;
        var y0 = y;
        var x1 = x + w;
        var y1 = y + h;
        if (x0 < 0) { x0 = 0; }
        if (y0 < 0) { y0 = 0; }
        if (x1 > s.w) { x1 = s.w; }
        if (y1 > s.h) { y1 = s.h; }
        if (x1 <= x0 || y1 <= y0) { return; }
        this._emitRect(op, s, x0, y0, x1 - x0, y1 - y0, col);
        return;
    }

    // Append a pre-clipped rect command.
    fn _emitRect(op:int, s:object, x:int, y:int, w:int, h:int, col:int) {
        if (_nCmd >= _cmdCap) { this.Flush(); }
        let p = _cmdEnd;
        _arena[p]     = op;
        _arena[p + 1] = Raster.CmdRect();
        _arena[p + 2] = s.off;
        _arena[p + 3] = s.w;
        _arena[p + 4] = x;
        _arena[p + 5] = y;
        _arena[p + 6] = w;
        _arena[p + 7] = h;
        _arena[p + 8] = col;
        _cmdEnd = p + Raster.CmdRect();
        _nCmd = _nCmd + 1;
        return;
    }

    // Append a thin-line command. Lines clip per pixel inside the kernel, so
    // the surface extent travels with the command.
    fn _emitLine(s:object, x0:int, y0:int, x1:int, y1:int, col:int) {
        if (_nCmd >= _cmdCap) { this.Flush(); }
        let p = _cmdEnd;
        _arena[p]      = Raster.OpLine();
        _arena[p + 1]  = Raster.CmdLine();
        _arena[p + 2]  = s.off;
        _arena[p + 3]  = s.w;
        _arena[p + 4]  = s.w;
        _arena[p + 5]  = s.h;
        _arena[p + 6]  = x0;
        _arena[p + 7]  = y0;
        _arena[p + 8]  = x1;
        _arena[p + 9]  = y1;
        _arena[p + 10] = col;
        _cmdEnd = p + Raster.CmdLine();
        _nCmd = _nCmd + 1;
        return;
    }


    // Append a stamped-segment command: disks of radius r along (x0,y0)-(x1,y1).
    // A lone disk is the degenerate case where both endpoints coincide. Doing
    // this in the kernel rather than expanding to spans here is the difference
    // between one command and 2r+1 per sample.
    fn _emitStamp(s:object, x0:int, y0:int, x1:int, y1:int, r:int, col:int) {
        if (_nCmd >= _cmdCap) { this.Flush(); }
        let p = _cmdEnd;
        _arena[p]      = Raster.OpStamp();
        _arena[p + 1]  = Raster.CmdStamp();
        _arena[p + 2]  = s.off;
        _arena[p + 3]  = s.w;
        _arena[p + 4]  = s.w;
        _arena[p + 5]  = s.h;
        _arena[p + 6]  = x0;
        _arena[p + 7]  = y0;
        _arena[p + 8]  = x1;
        _arena[p + 9]  = y1;
        _arena[p + 10] = r;
        _arena[p + 11] = col;
        _cmdEnd = p + Raster.CmdStamp();
        _nCmd = _nCmd + 1;
        return;
    }

    // Span semantics shared by every primitive except Clear.
    fn _span(s:object, x:int, y:int, w:int, h:int, col:int) {
        if (w <= 0 || h <= 0) { return; }
        let sa = (col >> 24) & 0xFF;
        if (sa == 0) { return; }
        if (sa != 255) { this._push(Raster.OpBlend(), s, x, y, w, h, col); return; }

        var x0 = x; var y0 = y;
        var x1 = x + w; var y1 = y + h;
        if (x0 < 0) { x0 = 0; }
        if (y0 < 0) { y0 = 0; }
        if (x1 > s.w) { x1 = s.w; }
        if (y1 > s.h) { y1 = s.h; }
        if (x1 <= x0 || y1 <= y0) { return; }

        if (x1 - x0 == s.w && y1 - y0 >= Raster.ReplicateMinRows()) {
            this.Flush();                       // queued work must land first
            this._store(s, y0, y1 - y0, col);
            return;
        }
        this._push(Raster.OpFill(), s, x0, y0, x1 - x0, y1 - y0, col);
        return;
    }

    // Full-stride store: rows are contiguous, so one row is written in bytecode
    // and then doubled onto itself with native copies.
    fn _store(s:object, y:int, rows:int, col:int) {
        let base = s.off + y * s.w;
        var i = 0;
        while (i < s.w) { _arena[base + i] = col; i = i + 1; }
        var done = 1;
        while (done < rows) {
            var n = done;
            if (done + n > rows) { n = rows - done; }
            Buffer.Copy(_arena, base * 4, _arena, (base + done * s.w) * 4, n * s.w * 4);
            done = done + n;
        }
        return;
    }

    // ----------------------------------------------------------------
    // Primitives
    // ----------------------------------------------------------------

    // Direct store at any alpha: Clear bypasses span logic, so unlike FillRect
    // it can write a fully transparent surface.
    fn Clear(s:object, col:int) {
        this.Flush();
        this._store(s, 0, s.h, col);
        return;
    }

    fn FillRect(s:object, x:int, y:int, w:int, h:int, col:int)  { this._span(s, x, y, w, h, col); return; }
    fn BlendRect(s:object, x:int, y:int, w:int, h:int, col:int) { this._span(s, x, y, w, h, col); return; }
    fn SetPixel(s:object, x:int, y:int, col:int)                { this._span(s, x, y, 1, 1, col); return; }

    // x1 / y1 are INCLUSIVE end coordinates. Thickness extends downward (HLine)
    // or rightward (VLine), so a thick line is a filled rect.
    fn HLine(s:object, x0:int, y:int, x1:int, col:int, thickness:int) {
        var a = x0; var b = x1;
        if (a > b) { let t = a; a = b; b = t; }
        var th = thickness;
        if (th < 1) { th = 1; }
        this._span(s, a, y, b - a + 1, th, col);
        return;
    }

    fn VLine(s:object, x:int, y0:int, y1:int, col:int, thickness:int) {
        var a = y0; var b = y1;
        if (a > b) { let t = a; a = b; b = t; }
        var th = thickness;
        if (th < 1) { th = 1; }
        this._span(s, x, a, th, b - a + 1, col);
        return;
    }

    // Outline. A border thicker than half the box degenerates to a solid fill.
    fn DrawRect(s:object, x:int, y:int, w:int, h:int, col:int, t:int) {
        if (w <= 0 || h <= 0) { return; }
        var th = t;
        if (th < 1) { th = 1; }
        if (th * 2 >= w || th * 2 >= h) { this._span(s, x, y, w, h, col); return; }
        this._span(s, x, y, w, th, col);
        this._span(s, x, y + h - th, w, th, col);
        this._span(s, x, y + th, th, h - 2 * th, col);
        this._span(s, x + w - th, y + th, th, h - 2 * th, col);
        return;
    }


    // Integer square root - exact, so circle spans are reproducible on every
    // platform rather than depending on a floating-point sqrt.
    fn static _isqrt(v:int):int {
        if (v <= 0) { return 0; }
        var x = 0;
        while ((x + 1) * (x + 1) <= v) { x = x + 1; }
        return x;
    }

    // Filled disk: one stamp command with coincident endpoints.
    fn _disk(s:object, cx:int, cy:int, r:int, col:int) {
        if (((col >> 24) & 0xFF) == 0) { return; }
        this._emitStamp(s, cx, cy, cx, cy, r, col);
        return;
    }

    // DrawLine(x0,y0,x1,y1,colour,thickness). Thickness 1 is integer Bresenham;
    // thicker lines stamp disks of the matching radius along the segment.
    fn DrawLine(s:object, x0:int, y0:int, x1:int, y1:int, col:int, thickness:int) {
        if (((col >> 24) & 0xFF) == 0) { return; }
        var t = thickness;
        if (t < 1) { t = 1; }
        if (t == 1) { this._emitLine(s, x0, y0, x1, y1, col); return; }
        this._emitStamp(s, x0, y0, x1, y1, Raster._ceilHalf(t - 1), col);
        return;
    }

    // ceil(n/2) for a non-negative n - the disk radius for a given thickness.
    fn static _ceilHalf(n:int):int { return (n + 1) / 2; }

    // One stroked segment. A zero-length segment draws nothing (unlike
    // DrawLine, where a degenerate thick line still stamps one disk). A round
    // cap re-stamps the far endpoint.
    fn _strokeSegment(s:object, x0:int, y0:int, x1:int, y1:int, r:int, cap:int, col:int) {
        if (x0 == x1 && y0 == y1) { return; }
        this._emitStamp(s, x0, y0, x1, y1, r, col);
        if (cap == 1) { this._emitStamp(s, x1, y1, x1, y1, r, col); }
        return;
    }

    // StrokePath(points, colour, thickness, cap, closed). `pts` is a flat
    // [x0,y0,x1,y1,...] array. Radius is (thickness-1)/2 truncated, which is
    // NOT the same rule DrawLine uses, which rounds up instead.
    fn StrokePath(s:object, pts:array, col:int, thickness:int, cap:int, closed:int) {
        let nflat = len(pts);
        if (nflat < 4 || (nflat & 1) == 1) { return; }
        var t = thickness;
        if (t < 1) { t = 1; }
        let r = (t - 1) / 2;
        let npts = nflat / 2;
        var i = 0;
        while (i < npts - 1) {
            this._strokeSegment(s, int(pts[i * 2]), int(pts[i * 2 + 1]),
                                int(pts[(i + 1) * 2]), int(pts[(i + 1) * 2 + 1]), r, cap, col);
            i = i + 1;
        }
        if (closed != 0 && npts > 2) {
            this._strokeSegment(s, int(pts[(npts - 1) * 2]), int(pts[(npts - 1) * 2 + 1]),
                                int(pts[0]), int(pts[1]), r, cap, col);
        }
        return;
    }

    // An INCLUSIVE horizontal run - the primitive every filled shape bottoms
    // out in. Endpoints may arrive in either order.
    fn _hspan(s:object, x1:int, x2:int, y:int, col:int) {
        var a = x1; var b = x2;
        if (a > b) { let t = a; a = b; b = t; }
        this._span(s, a, y, b - a + 1, 1, col);
        return;
    }

    fn FillCircle(s:object, cx:int, cy:int, r:int, col:int) {
        this._disk(s, cx, cy, r, col);
        return;
    }

    // DrawCircle(cx, cy, r, colour, thickness, fill). A zero or over-thick
    // border, or an explicit fill, gives a solid disk; otherwise a ring between
    // radii r and r-thickness.
    fn DrawCircle(s:object, cx:int, cy:int, r:int, col:int, thickness:int, fill:int) {
        if (r <= 0) { return; }
        var t = thickness;
        if (t < 0) { t = 0; }
        if (fill != 0 || t == 0 || t >= r) { this._disk(s, cx, cy, r, col); return; }
        if (((col >> 24) & 0xFF) == 0) { return; }
        if (_nCmd >= _cmdCap) { this.Flush(); }
        let q = _cmdEnd;
        _arena[q]     = Raster.OpRing();
        _arena[q + 1] = Raster.CmdRing();
        _arena[q + 2] = s.off;
        _arena[q + 3] = s.w;
        _arena[q + 4] = s.w;
        _arena[q + 5] = s.h;
        _arena[q + 6] = cx;
        _arena[q + 7] = cy;
        _arena[q + 8] = r;
        _arena[q + 9] = r - t;
        _arena[q + 10] = col;
        _cmdEnd = q + Raster.CmdRing();
        _nCmd = _nCmd + 1;
        return;
    }

    // FillPolygon(points, colour) - scanline fill over an active edge table.
    // Coordinates may be int or float; floats truncate to whole pixels.
    // The edge table is built and advanced here rather than in a kernel: it
    // allocates, and a kernel may not. Only the resulting spans cross into the
    // kernel, as ordinary fill commands.
    fn FillPolygon(s:object, pts:array, col:int) {
        let nflat = len(pts);
        if (nflat < 6 || (nflat & 1) == 1) { return; }
        let npts = nflat / 2;

        let eYmax:array = [];
        let eYmin:array = [];
        let eX:array    = [];
        let eInv:array  = [];

        var i = 0;
        while (i < npts) {
            let j = (i + 1) % npts;
            let x0 = int(pts[i * 2]);      let y0 = int(pts[i * 2 + 1]);
            let x1 = int(pts[j * 2]);      let y1 = int(pts[j * 2 + 1]);
            if (y0 != y1) {
                var ymin = y0; var ymax = y1; var xs0 = x0;
                var inv = float(x1 - x0) / float(y1 - y0);
                if (y0 >= y1) {
                    ymin = y1; ymax = y0; xs0 = x1;
                    inv = float(x0 - x1) / float(y0 - y1);
                }
                if (ymax > 0 && ymin < s.h) {
                    var fx = float(xs0);
                    if (ymin < 0) {
                        fx = fx + inv * float(0 - ymin);
                        ymin = 0;
                    }
                    var ye = ymax;
                    if (ye > s.h) { ye = s.h; }
                    Array.Append(eYmin, ymin);
                    Array.Append(eYmax, ye);
                    Array.Append(eX, fx);
                    Array.Append(eInv, inv);
                }
            }
            i = i + 1;
        }

        let ne = len(eYmin);
        if (ne == 0) { return; }

        // Scan only the band the edges cover, not the whole canvas.
        var yTop = s.h;
        var yBot = 0;
        var k = 0;
        while (k < ne) {
            if (eYmin[k] < yTop) { yTop = eYmin[k]; }
            if (eYmax[k] > yBot) { yBot = eYmax[k]; }
            k = k + 1;
        }
        if (yTop < 0) { yTop = 0; }
        if (yBot > s.h) { yBot = s.h; }
        if (yTop >= yBot) { return; }

        // At most one crossing per edge, so one buffer sized to the edge list
        // serves every scanline - the crossings are inserted in order into the
        // first nx entries rather than into a fresh array per row.
        let xs:array = [];
        k = 0;
        while (k < ne) { Array.Append(xs, 0.0); k = k + 1; }

        var y = yTop;
        while (y < yBot) {
            var nx = 0;
            k = 0;
            while (k < ne) {
                if (eYmin[k] <= y && y < eYmax[k]) {
                    let v = eX[k];
                    var q = nx;
                    while (q > 0 && xs[q - 1] > v) { xs[q] = xs[q - 1]; q = q - 1; }
                    xs[q] = v;
                    nx = nx + 1;
                    eX[k] = v + eInv[k];   // advance while the edge is in hand
                }
                k = k + 1;
            }
            var c = 0;
            while (c + 1 < nx) {
                let a = int(Math.Floor(xs[c] + 0.5));
                let b = int(Math.Floor(xs[c + 1] + 0.5));
                if (b > a) { this._hspan(s, a, b, y, col); }
                c = c + 2;
            }
            y = y + 1;
        }
        return;
    }

    // Source-over composite of `src` onto this surface at (dx,dy), with an
    // optional global alpha modulating the source. The overlap is computed
    // here; the kernel just walks it. Both surfaces live in the same arena, so
    // this is still a single-block kernel - that is the whole point of the
    // arena.
    fn BlendSurface(s:object, src:object, dx:int, dy:int, ga:int) {
        var a = ga;
        if (a < 0) { a = 0; }
        if (a > 255) { a = 255; }
        var sx0 = 0; var sy0 = 0;
        var bw = src.w; var bh = src.h;
        var ddx = dx; var ddy = dy;
        if (ddx < 0) { sx0 = sx0 - ddx; bw = bw + ddx; ddx = 0; }
        if (ddy < 0) { sy0 = sy0 - ddy; bh = bh + ddy; ddy = 0; }
        if (ddx + bw > s.w) { bw = s.w - ddx; }
        if (ddy + bh > s.h) { bh = s.h - ddy; }
        if (bw <= 0 || bh <= 0) { return; }

        if (_nCmd >= _cmdCap) { this.Flush(); }
        let p = _cmdEnd;
        _arena[p]     = Raster.OpComposite();
        _arena[p + 1] = Raster.CmdComposite();
        _arena[p + 2] = s.off + ddy * s.w + ddx;
        _arena[p + 3] = s.w;
        _arena[p + 4] = src.off + sy0 * src.w + sx0;
        _arena[p + 5] = src.w;
        _arena[p + 6] = bw;
        _arena[p + 7] = bh;
        _arena[p + 8] = a;
        _cmdEnd = p + Raster.CmdComposite();
        _nCmd = _nCmd + 1;
        return;
    }

    fn DrawImage(s:object, x:int, y:int, src:object) {
        this.BlendSurface(s, src, x, y, 255);
        return;
    }

    // CopyRect(x,y,w,h) -> a new surface holding that sub-rectangle. An opaque
    // copy needs no kernel: each row is one native Buffer.Copy.
    fn CopyRect(s:object, x:int, y:int, w:int, h:int) : object|nil {
        var x0 = x; var y0 = y;
        var x1 = x + w; var y1 = y + h;
        if (x0 < 0) { x0 = 0; }
        if (y0 < 0) { y0 = 0; }
        if (x1 > s.w) { x1 = s.w; }
        if (y1 > s.h) { y1 = s.h; }
        if (x1 <= x0 || y1 <= y0) { return nil; }
        let cw = x1 - x0;
        let chh = y1 - y0;
        let out = this.NewSurface(cw, chh);
        if (out == nil) { return nil; }
        this.Flush();
        var yy = 0;
        while (yy < chh) {
            Buffer.Copy(_arena, (s.off + (y0 + yy) * s.w + x0) * 4,
                        _arena, (out.off + yy * cw) * 4, cw * 4);
            yy = yy + 1;
        }
        return out;
    }

    // Resize(newW,newH) -> a new surface, nearest-neighbour. The sample index
    // is computed as ((2d+1)*old) / (2*new), i.e. floor((d+0.5)*old/new) in
    // exact integer arithmetic - no floating point, so it is reproducible.
    fn Resize(s:object, newW:int, newH:int) : object|nil {
        if (newW <= 0 || newH <= 0) { return nil; }
        let out = this.NewSurface(newW, newH);
        if (out == nil) { return nil; }
        if (_nCmd >= _cmdCap) { this.Flush(); }
        let p = _cmdEnd;
        _arena[p]     = Raster.OpScale();
        _arena[p + 1] = Raster.CmdScale();
        _arena[p + 2] = out.off;
        _arena[p + 3] = newW;
        _arena[p + 4] = s.off;
        _arena[p + 5] = s.w;
        _arena[p + 6] = newW;
        _arena[p + 7] = newH;
        _arena[p + 8] = s.w;
        _arena[p + 9] = s.h;
        _cmdEnd = p + Raster.CmdScale();
        _nCmd = _nCmd + 1;
        return out;
    }

    // Independent x and y scale factors.
    fn Rescale(s:object, sx:float, sy:float) : object|nil {
        let nw = int(float(s.w) * sx + 0.5);
        let nh = int(float(s.h) * sy + 0.5);
        return this.Resize(s, nw, nh);
    }

    // 8x8 bitmap font covering ASCII and a CP437 box-drawing subset; codes with
    // no glyph render as a space. Two words per code: rows 0-3 then rows 4-7,
    // one row per byte, bit 7 leftmost.
