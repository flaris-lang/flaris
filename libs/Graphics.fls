    fn _emitGlyph(s:object, x:int, y:int, code:int, scale:int, col:int) {
        if (_nCmd >= _cmdCap) { this.Flush(); }
        let p = _cmdEnd;
        _arena[p]      = Raster.OpGlyph();
        _arena[p + 1]  = Raster.CmdGlyph();
        _arena[p + 2]  = s.off;
        _arena[p + 3]  = s.w;
        _arena[p + 4]  = s.w;
        _arena[p + 5]  = s.h;
        _arena[p + 6]  = x;
        _arena[p + 7]  = y;
        _arena[p + 8]  = code;
        _arena[p + 9]  = scale;
        _arena[p + 10] = _fontBase;
        _arena[p + 11] = col;
        _cmdEnd = p + Raster.CmdGlyph();
        _nCmd = _nCmd + 1;
        return;
    }

    // Glyphs are stored opaquely; text is never alpha-blended.
    fn DrawChar(s:object, x:int, y:int, code:int, col:int, scale:int) {
        var sc = scale;
        if (sc < 1) { sc = 1; }
        var c = code;
        if (c < 0) { c = 0; }
        if (c > 255) { c = c & 0xFF; }
        this._emitGlyph(s, x, y, c, sc, col);
        return;
    }

    // DrawText: newline returns the pen and advances a line; tab advances four
    // cells.
    fn DrawText(s:object, x:int, y:int, text:string, col:int, scale:int, lspace:int, linesp:int) {
        var sc = scale;   if (sc < 1) { sc = 1; }
        var ls = lspace;  if (ls < 0) { ls = 0; }
        var lp = linesp;  if (lp < 0) { lp = 0; }
        let adv = 8 * sc + ls;
        let lineAdv = 8 * sc + lp;
        var penX = x;
        var penY = y;
        // Read the raw bytes once; DrawTextRun indexes bytes, not codepoints.
        let bytes = Buffer.FromString(text);
        let n = len(bytes);
        var i = 0;
        while (i < n) {
            let b = bytes[i] & 0xFF;
            if (b == 10) { penX = x; penY = penY + lineAdv; }
            else if (b == 9) { penX = penX + adv * 4; }
            else {
                this._emitGlyph(s, penX, penY, b, sc, col);
                penX = penX + adv;
            }
            i = i + 1;
        }
        return;
    }

    // ---- colour helpers (pure integer / double maths, no surface touched) ----

    fn static RGB(r:int, g:int, b:int):int {
        return 0xFF000000 | ((r & 0xFF) << 16) | ((g & 0xFF) << 8) | (b & 0xFF);
    }

    fn static RGBA(r:int, g:int, b:int, a:int):int {
        return ((a & 0xFF) << 24) | ((r & 0xFF) << 16) | ((g & 0xFF) << 8) | (b & 0xFF);
    }

    fn static _clamp255(v:int):int {
        if (v < 0) { return 0; }
        if (v > 255) { return 255; }
        return v;
    }

    // HSL -> 0xAARRGGBB. Hue in degrees; saturation and lightness in 0..1.
    fn static HSL(h:float, sa:float, l:float):int {
        if (sa <= 0.0) {
            let v = Raster._clamp255(int(l * 255.0 + 0.5));
            return 0xFF000000 | (v << 16) | (v << 8) | v;
        }
        var ab = 2.0 * l - 1.0;
        if (ab < 0.0) { ab = 0.0 - ab; }
        let c = (1.0 - ab) * sa;
        let m = l - c * 0.5;
        let h6 = h / 60.0;
        let sector = int(h6) % 6;
        let f = h6 - Math.Floor(h6);
        let xu = c * f;
        let xd = c * (1.0 - f);
        var r = 0.0; var g = 0.0; var b = 0.0;
        if (sector == 0)      { r = c;   g = xu;  b = 0.0; }
        else if (sector == 1) { r = xd;  g = c;   b = 0.0; }
        else if (sector == 2) { r = 0.0; g = c;   b = xu;  }
        else if (sector == 3) { r = 0.0; g = xd;  b = c;   }
        else if (sector == 4) { r = xu;  g = 0.0; b = c;   }
        else                  { r = c;   g = 0.0; b = xd;  }
        let ri = Raster._clamp255(int((r + m) * 255.0 + 0.5));
        let gi = Raster._clamp255(int((g + m) * 255.0 + 0.5));
        let bi = Raster._clamp255(int((b + m) * 255.0 + 0.5));
        return 0xFF000000 | (ri << 16) | (gi << 8) | bi;
    }

    // ---- accessors ----

    fn GetPixel(s:object, x:int, y:int):int {
        if (x < 0 || y < 0 || x >= s.w || y >= s.h) { return 0; }
        this.Flush();
        return _arena[s.off + y * s.w + x] & 0xFFFFFFFF;
    }

    // ---- region filters ----

    fn _clipRegion(s:object, x:int, y:int, w:int, h:int):object|nil {
        var x0 = x; var y0 = y;
        var x1 = x + w; var y1 = y + h;
        if (x0 < 0) { x0 = 0; }
        if (y0 < 0) { y0 = 0; }
        if (x1 > s.w) { x1 = s.w; }
        if (y1 > s.h) { y1 = s.h; }
        if (x1 <= x0 || y1 <= y0) { return nil; }
        return { x: x0, y: y0, w: x1 - x0, h: y1 - y0 };
    }

    fn _emitFilter(s:object, rgn:object, mode:int) {
        if (_nCmd >= _cmdCap) { this.Flush(); }
        let p = _cmdEnd;
        _arena[p]     = Raster.OpFilter();
        _arena[p + 1] = Raster.CmdFilter();
        _arena[p + 2] = s.off;
        _arena[p + 3] = s.w;
        _arena[p + 4] = rgn.x;
        _arena[p + 5] = rgn.y;
        _arena[p + 6] = rgn.w;
        _arena[p + 7] = rgn.h;
        _arena[p + 8] = mode;
        _arena[p + 9] = _lutBase;
        _cmdEnd = p + Raster.CmdFilter();
        _nCmd = _nCmd + 1;
        return;
    }

    // BT.601 luminance, alpha preserved.
    fn Grayscale(s:object, x:int, y:int, w:int, h:int) {
        let rgn = this._clipRegion(s, x, y, w, h);
        if (rgn == nil) { return; }
        this._emitFilter(s, rgn, 1);
        return;
    }

    // Multiply RGB by `factor`, clamped, alpha preserved. The 256-entry table
    // is shared, so pending work is flushed before it is rewritten.
    fn Brightness(s:object, x:int, y:int, w:int, h:int, factor:float) {
        let rgn = this._clipRegion(s, x, y, w, h);
        if (rgn == nil) { return; }
        this.Flush();
        var i = 0;
        while (i < 256) {
            _arena[_lutBase + i] = Raster._clamp255(int(float(i) * factor + 0.5));
            i = i + 1;
        }
        this._emitFilter(s, rgn, 2);
        return;
    }

    // Per-pixel callback fn(pixel:int) -> int, nil leaving the pixel alone. A
    // kernel may not call a function, so this one runs as ordinary bytecode.
    // Use FilterRegion for the offloaded equivalent.
    fn Filter(s:object, fn0:function, x:int, y:int, w:int, h:int) {
        let rgn = this._clipRegion(s, x, y, w, h);
        if (rgn == nil) { return; }
        this.Flush();
        var yy = 0;
        while (yy < rgn.h) {
            let ro = s.off + (rgn.y + yy) * s.w + rgn.x;
            var xx = 0;
            while (xx < rgn.w) {
                let nv = fn0(_arena[ro + xx] & 0xFFFFFFFF);
                if (nv != nil) { _arena[ro + xx] = nv; }
                xx = xx + 1;
            }
            yy = yy + 1;
        }
        return;
    }

    // Draw(src, dx, dy) - source-over blit of one surface onto another at full
    // source alpha.
    fn Draw(s:object, src:object, dx:int, dy:int) {
        this.BlendSurface(s, src, dx, dy, 255);
        return;
    }

    // Blit(dx, dy, w, h, pixels) - composite a flat ARGB *array* (QRCode.ToPixels
    // and friends). The array is staged into a scratch arena surface in one
    // bytecode pass, then composited by the kernel; per-pixel commands would be
    // far worse. The scratch surface is released again before returning.
    fn Blit(s:object, dx:int, dy:int, w:int, h:int, pixels:array) {
        if (w <= 0 || h <= 0) { return; }
        if (w * h > len(pixels)) { return; }
        let mark = this.Mark();
        let tmp = this.NewSurface(w, h);
        if (tmp == nil) { return; }
        let n = w * h;
        // Stage the source through a scratch buffer: FromArray + Copy move the
        // whole rectangle in two native passes, where the element-by-element
        // loop below costs one bytecode iteration per pixel. The loop stays as
        // the fallback for a source that cannot be transferred wholesale.
        var bulk = false;
        let src = (len(pixels) == n) ? pixels : Array.Slice(pixels, 0, n);
        let stage = Buffer.Create(n, 4);
        if (stage != nil && Buffer.FromArray(stage, src)) {
            bulk = Buffer.Copy(stage, 0, _arena, tmp.off * 4, n * 4);
        }
        if (!bulk) {
            var i = 0;
            while (i < n) {
                _arena[tmp.off + i] = pixels[i];
                i = i + 1;
            }
        }
        this.BlendSurface(s, tmp, dx, dy, 255);
        this.Flush();
        this.Release(mark);
        return;
    }

    // DrawTextOpts(x, y, text, opts) - opts fields color/scale/spacing/
    // lineSpacing, each with a sensible default (colour defaults to opaque
    // white).
    fn DrawTextOpts(s:object, x:int, y:int, text:string, opts:object|nil) {
        var col = 0xFFFFFFFF;
        var sc = 1;
        var sp = 0;
        var lsp = 0;
        if (opts != nil) {
            if (opts.color != nil)       { col = opts.color; }
            if (opts.scale != nil)       { sc = opts.scale; }
            if (opts.spacing != nil)     { sp = opts.spacing; }
            if (opts.lineSpacing != nil) { lsp = opts.lineSpacing; }
        }
        this.DrawText(s, x, y, text, col, sc, sp, lsp);
        return;
    }

    // Hand a region of the arena to a user offload kernel.
    //
    // A kernel gets one block and one scalar, so the region descriptor is
    // written into the arena and the kernel is passed its offset:
    //
    //   fn myKernel(a:block, len:int, hdr:int):int {
    //       let off = a[hdr]; let stride = a[hdr+1];
    //       let x = a[hdr+2]; let y = a[hdr+3];
    //       let w = a[hdr+4]; let h = a[hdr+5];
    //       // pixel (x+dx, y+dy) is a[off + (y+dy)*stride + (x+dx)]
    //   }
    //
    // The kernel runs on another core when it qualifies (touches only the
    // block, plain integer maths, no calls or allocation).
    fn FilterRegion(s:object, fn0:function, x:int, y:int, w:int, h:int, eventId:int):int {
        let rgn = this._clipRegion(s, x, y, w, h);
        if (rgn == nil) { return 0 - 1; }
        this.Flush();
        let hdr = _lutBase;                 // reused as a scratch descriptor
        _arena[hdr]     = s.off;
        _arena[hdr + 1] = s.w;
        _arena[hdr + 2] = rgn.x;
        _arena[hdr + 3] = rgn.y;
        _arena[hdr + 4] = rgn.w;
        _arena[hdr + 5] = rgn.h;
        var id = eventId;
        if (id < 0) { id = Event.Create(); }
        if (id < 0) { return 0 - 1; }
        Buffer.ProcessEvent(fn0, _arena, _cap, hdr, id);
        return id;
    }

    // Commands queue in draw order but each op class has its own kernel, so a
    // flush walks the queue and dispatches one kernel per maximal run of the
    // same class. Order is preserved; a mixed queue just costs more dispatches,
    // and a dispatch is ~0.01 ms.
    fn static _class(op:int):int {
        if (op <= 2) { return 1; }
        if (op == 3) { return 2; }
        if (op == 4) { return 3; }
        if (op == 5) { return 4; }
        if (op == 6) { return 5; }
        if (op == 7) { return 6; }
        if (op == 8) { return 7; }
        return 8;
    }

    fn Flush() {
        if (_nCmd <= 0) { return; }
        var p = 1;
        var done = 0;
        while (done < _nCmd) {
            let cls = Raster._class(_arena[p]);
            var q = p;
            var run = 0;
            var scanning = 1;
            while (scanning == 1) {
                if (done + run >= _nCmd) { scanning = 0; }
                else if (Raster._class(_arena[q]) != cls) { scanning = 0; }
                else { q = q + _arena[q + 1]; run = run + 1; }
            }
            _arena[0] = run;
            let id = Event.Create();
            if (id >= 0) {
                if (cls == 1)      { Buffer.ProcessEvent(Raster._kernelRect,  _arena, _cap, p, id); }
                else if (cls == 2) { Buffer.ProcessEvent(Raster._kernelLine,  _arena, _cap, p, id); }
                else if (cls == 3) { Buffer.ProcessEvent(Raster._kernelStamp, _arena, _cap, p, id); }
                else if (cls == 4) { Buffer.ProcessEvent(Raster._kernelBlit,  _arena, _cap, p, id); }
                else if (cls == 5) { Buffer.ProcessEvent(Raster._kernelScale, _arena, _cap, p, id); }
                else if (cls == 6) { Buffer.ProcessEvent(Raster._kernelGlyph, _arena, _cap, p, id); }
                else if (cls == 7) { Buffer.ProcessEvent(Raster._kernelFilter, _arena, _cap, p, id); }
                else               { Buffer.ProcessEvent(Raster._kernelRing,   _arena, _cap, p, id); }
                Event.WaitFor([id]);
            } else {
                if (cls == 1)      { Raster._kernelRect(_arena, _cap, p); }
                else if (cls == 2) { Raster._kernelLine(_arena, _cap, p); }
                else if (cls == 3) { Raster._kernelStamp(_arena, _cap, p); }
                else if (cls == 4) { Raster._kernelBlit(_arena, _cap, p); }
                else if (cls == 5) { Raster._kernelScale(_arena, _cap, p); }
                else if (cls == 6) { Raster._kernelGlyph(_arena, _cap, p); }
                else if (cls == 7) { Raster._kernelFilter(_arena, _cap, p); }
                else               { Raster._kernelRing(_arena, _cap, p); }
            }
            p = q;
            done = done + run;
        }
        _arena[0] = 0;
        _nCmd = 0;
        _cmdEnd = 1;
        return;
    }

    // ----------------------------------------------------------------
    // The kernel. Straight-line integer work over one block: no calls, no
    // allocation, so it compiles to native code.
    // ----------------------------------------------------------------
    // Composite kernel: source-over of one arena region onto another, with an
    // optional global alpha scaling the source alpha first.
    fn static _kernelBlit(b:block, _blen:int, start:int):int {
        let n = b[0];
        var i = 0;
        var p = start;
        while (i < n) {
            let sz = b[p + 1];
            let dOff = b[p + 2]; let dStr = b[p + 3];
            let sOff = b[p + 4]; let sStr = b[p + 5];
            let bw = b[p + 6]; let bh = b[p + 7];
            let ga = b[p + 8];
            var y = 0;
            while (y < bh) {
                let dr = dOff + y * dStr;
                let sr = sOff + y * sStr;
                var x = 0;
                while (x < bw) {
                    let sp = b[sr + x];
                    var sa = (sp >> 24) & 0xFF;
                    if (ga != 255) { sa = (sa * ga + 127) / 255; }
                    if (sa != 0) {
                        if (sa == 255) {
                            b[dr + x] = sp;
                        } else {
                            let ia  = 255 - sa;
                            let srb = (sp & 0x00FF00FF) * sa + 0x007F007F;
                            let sg  = ((sp >> 8) & 0xFF) * sa + 127;
                            let d = b[dr + x];
                            var rb = (d & 0x00FF00FF) * ia + srb;
                            rb = ((rb + 0x00010001 + ((rb >> 8) & 0x00FF00FF)) >> 8) & 0x00FF00FF;
                            var gg = ((d >> 8) & 0xFF) * ia + sg;
                            gg = ((gg + 1 + (gg >> 8)) >> 8) & 0xFF;
                            var aa = ((d >> 24) & 0xFF) * ia + 127;
                            aa = sa + ((aa + 1 + (aa >> 8)) >> 8);
                            b[dr + x] = ((aa & 0xFF) << 24) | rb | (gg << 8);
                        }
                    }
                    x = x + 1;
                }
                y = y + 1;
            }
            p = p + sz;
            i = i + 1;
        }
        return 0;
    }

    // Nearest-neighbour scale kernel. Sample index is the exact integer form of
    // floor((d + 0.5) * old / new), in exact integer arithmetic.
    fn static _kernelScale(b:block, _blen:int, start:int):int {
        let n = b[0];
        var i = 0;
        var p = start;
        while (i < n) {
            let sz = b[p + 1];
            let dOff = b[p + 2]; let dStr = b[p + 3];
            let sOff = b[p + 4]; let sStr = b[p + 5];
            let dw = b[p + 6]; let dh = b[p + 7];
            let sw = b[p + 8]; let sh = b[p + 9];
            var y = 0;
            while (y < dh) {
                var sy = ((2 * y + 1) * sh) / (2 * dh);
                if (sy < 0) { sy = 0; }
                if (sy >= sh) { sy = sh - 1; }
                let dr = dOff + y * dStr;
                let sr = sOff + sy * sStr;
                var x = 0;
                while (x < dw) {
                    var sx = ((2 * x + 1) * sw) / (2 * dw);
                    if (sx < 0) { sx = 0; }
                    if (sx >= sw) { sx = sw - 1; }
                    b[dr + x] = b[sr + sx];
                    x = x + 1;
                }
                y = y + 1;
            }
            p = p + sz;
            i = i + 1;
        }
        return 0;
    }

    // Glyph kernel: 8x8 bitmap expanded by `scale`, opaque store.
    fn static _kernelGlyph(b:block, _blen:int, start:int):int {
        let n = b[0];
        var i = 0;
        var p = start;
        while (i < n) {
            let sz = b[p + 1];
            let dOff = b[p + 2]; let dStr = b[p + 3];
            let cw = b[p + 4];   let ch = b[p + 5];
            let gx = b[p + 6];   let gy = b[p + 7];
            let code = b[p + 8]; let sc = b[p + 9];
            let fb = b[p + 10];  let col = b[p + 11];
            var ry = 0;
            var stop = 0;
            while (ry < 8 && stop == 0) {
                let y0 = gy + ry * sc;
                if (y0 >= ch) { stop = 1; }
                else {
                    let row = (b[fb + code * 2 + (ry >> 2)] >> ((ry & 3) * 8)) & 0xFF;
                    if (row != 0) {
                        var rx = 0;
                        while (rx < 8) {
                            if ((row & (128 >> rx)) != 0) {
                                let x0 = gx + rx * sc;
                                var sy = 0;
                                while (sy < sc) {
                                    let yy = y0 + sy;
                                    if (yy >= 0 && yy < ch) {
                                        var xl = x0;
                                        var xr = x0 + sc - 1;
                                        if (xl < 0) { xl = 0; }
                                        if (xr >= cw) { xr = cw - 1; }
                                        var xx = xl;
                                        while (xx <= xr) {
                                            b[dOff + yy * dStr + xx] = col;
                                            xx = xx + 1;
                                        }
                                    }
                                    sy = sy + 1;
                                }
                            }
                            rx = rx + 1;
                        }
                    }
                }
                ry = ry + 1;
            }
            p = p + sz;
            i = i + 1;
        }
        return 0;
    }

    // Region filter kernel. Mode 1 = BT.601 grayscale, mode 2 = channel lookup
    // (Brightness). Alpha is preserved in both.
    fn static _kernelFilter(b:block, _blen:int, start:int):int {
        let n = b[0];
        var i = 0;
        var p = start;
        while (i < n) {
            let sz = b[p + 1];
            let dOff = b[p + 2]; let dStr = b[p + 3];
            let rx = b[p + 4];   let ry = b[p + 5];
            let rw = b[p + 6];   let rh = b[p + 7];
            let mode = b[p + 8]; let lut = b[p + 9];
            var y = 0;
            while (y < rh) {
                let ro = dOff + (ry + y) * dStr + rx;
                var x = 0;
                while (x < rw) {
                    let px = b[ro + x];
                    let a = (px >> 24) & 0xFF;
                    let r = (px >> 16) & 0xFF;
                    let g = (px >> 8) & 0xFF;
                    let bl = px & 0xFF;
                    if (mode == 1) {
                        let lm = (r * 77 + g * 150 + bl * 29) >> 8;
                        b[ro + x] = (a << 24) | ((lm & 0xFF) << 16) | ((lm & 0xFF) << 8) | (lm & 0xFF);
                    } else {
                        b[ro + x] = (a << 24) | ((b[lut + r] & 0xFF) << 16) |
                                    ((b[lut + g] & 0xFF) << 8) | (b[lut + bl] & 0xFF);
                    }
                    x = x + 1;
                }
                y = y + 1;
            }
            p = p + sz;
            i = i + 1;
        }
        return 0;
    }

    // Ring kernel: the annulus between radii ro and ri. A ring is always a
    // single centred shape, never swept along a segment, so it needs none of
    // the stamp kernel's stepping - which is why it lives in its own kernel
    // rather than as a flag on that one: a kernel carrying both exceeds the
    // per-function virtual-register budget and stops being compiled.
    fn static _kernelRing(b:block, _blen:int, start:int):int {
        let n = b[0];
        var i = 0;
        var p = start;
        while (i < n) {
            let sz     = b[p + 1];
            let dst    = b[p + 2];
            let stride = b[p + 3];
            let cw = b[p + 4]; let ch = b[p + 5];
            let cx = b[p + 6]; let cy = b[p + 7];
            let ro = b[p + 8]; let ri = b[p + 9];
            let col = b[p + 10];
            let sa  = (col >> 24) & 0xFF;
            let ia  = 255 - sa;
            let srb = (col & 0x00FF00FF) * sa + 0x007F007F;
            let sg  = ((col >> 8) & 0xFF) * sa + 127;
            let ro2 = ro * ro;
            let ri2 = ri * ri;
            var half = 0;
            var ihalf = 0;
            var dyy = 0 - ro;
            while (dyy <= ro) {
                let d2 = ro2 - dyy * dyy;
                while ((half + 1) * (half + 1) <= d2) { half = half + 1; }
                while (half > 0 && half * half > d2) { half = half - 1; }
                var xin = 0;
                var ya = dyy; if (ya < 0) { ya = 0 - ya; }
                if (ya < ri) {
                    let d2i = ri2 - dyy * dyy;
                    while ((ihalf + 1) * (ihalf + 1) <= d2i) { ihalf = ihalf + 1; }
                    while (ihalf > 0 && ihalf * ihalf > d2i) { ihalf = ihalf - 1; }
                    xin = ihalf;
                } else { ihalf = 0; }
                let yy = cy + dyy;
                if (yy >= 0 && yy < ch) {
                    // Two spans. Where the inner radius does not reach this row
                    // they meet at cx and overlap by one pixel, which is
                    // visible for a translucent colour.
                    var sp = 0;
                    while (sp < 2) {
                        var xa = cx - half;
                        var xb = cx - xin;
                        if (sp == 1) { xa = cx + xin; xb = cx + half; }
                        if (xa < 0) { xa = 0; }
                        if (xb >= cw) { xb = cw - 1; }
                        let rowo = dst + yy * stride;
                        var xj = xa;
                        while (xj <= xb) {
                            let o = rowo + xj;
                            if (sa == 255) {
                                b[o] = col;
                            } else {
                                let d = b[o];
                                var rb = (d & 0x00FF00FF) * ia + srb;
                                rb = ((rb + 0x00010001 + ((rb >> 8) & 0x00FF00FF)) >> 8) & 0x00FF00FF;
                                var gg = ((d >> 8) & 0xFF) * ia + sg;
                                gg = ((gg + 1 + (gg >> 8)) >> 8) & 0xFF;
                                var aa = ((d >> 24) & 0xFF) * ia + 127;
                                aa = sa + ((aa + 1 + (aa >> 8)) >> 8);
                                b[o] = ((aa & 0xFF) << 24) | rb | (gg << 8);
                            }
                            xj = xj + 1;
                        }
                        sp = sp + 1;
                    }
                }
                dyy = dyy + 1;
            }
            p = p + sz;
            i = i + 1;
        }
        return 0;
    }

    // Rect kernel: opaque store and source-over blend.
    //
    // Register allocation is per function and a function is capped at 64 virtual
    // registers, so each op class gets its own kernel. One kernel carrying every
    // op exceeds that cap, at which point it stops being compiled and silently
    // runs an order of magnitude slower.
    fn static _kernelRect(b:block, _blen:int, start:int):int {
        let n = b[0];
        var i = 0;
        var p = start;
        while (i < n) {
            let sz     = b[p + 1];
            let dst    = b[p + 2];
            let stride = b[p + 3];
            let col    = b[p + sz - 1];
            let op = b[p];
            if (op == 1) {
                let x = b[p + 4]; let y = b[p + 5];
                let w = b[p + 6]; let h = b[p + 7];
                var yy = 0;
                while (yy < h) {
                    let ro = dst + (y + yy) * stride + x;
                    var xx = 0;
                    while (xx < w) {
                        b[ro + xx] = col;
                        xx = xx + 1;
                    }
                    yy = yy + 1;
                }
            } else {
                // Source-over:
                //   out  = (src*sa + dst*inv + 127) / 255,  inv = 255 - sa
                //   outA = sa + (dstA*inv + 127) / 255
                // R and B ride in one value as two 16-bit lanes (a lane peaks
                // at 255*255+127 = 65152, so neither carries into the other),
                // and the divide uses the identity y/255 == (y+1+(y>>8))>>8,
                // exact over that range - three integer divisions per pixel
                // would otherwise dominate. Block elements read back
                // sign-extended; every use masks after shifting.
                let x = b[p + 4]; let y = b[p + 5];
                let w = b[p + 6]; let h = b[p + 7];
                let sa  = (col >> 24) & 0xFF;
                let ia  = 255 - sa;
                let srb = (col & 0x00FF00FF) * sa + 0x007F007F;
                let sg  = ((col >> 8) & 0xFF) * sa + 127;
                var yy = 0;
                while (yy < h) {
                    let ro = dst + (y + yy) * stride + x;
                    var xx = 0;
                    while (xx < w) {
                        let d = b[ro + xx];
                        var rb = (d & 0x00FF00FF) * ia + srb;
                        rb = ((rb + 0x00010001 + ((rb >> 8) & 0x00FF00FF)) >> 8) & 0x00FF00FF;
                        var gg = ((d >> 8) & 0xFF) * ia + sg;
                        gg = ((gg + 1 + (gg >> 8)) >> 8) & 0xFF;
                        var aa = ((d >> 24) & 0xFF) * ia + 127;
                        aa = sa + ((aa + 1 + (aa >> 8)) >> 8);
                        b[ro + xx] = ((aa & 0xFF) << 24) | rb | (gg << 8);
                        xx = xx + 1;
                    }
                    yy = yy + 1;
                }
            }
            p = p + sz;
            i = i + 1;
        }
        return 0;
    }

    // Thin-line kernel: integer Bresenham, clipped and blended per pixel.
    fn static _kernelLine(b:block, _blen:int, start:int):int {
        let n = b[0];
        var i = 0;
        var p = start;
        while (i < n) {
            let sz     = b[p + 1];
            let dst    = b[p + 2];
            let stride = b[p + 3];
            let col    = b[p + sz - 1];
            {
                // Thin line: integer Bresenham with the per-pixel clip and
                // blend. Clipping is per pixel rather than up front, because
                // clipping the endpoints would change the error term.
                let cw = b[p + 4]; let ch = b[p + 5];
                var lx = b[p + 6]; var ly = b[p + 7];
                let ex = b[p + 8]; let ey = b[p + 9];
                let sa  = (col >> 24) & 0xFF;
                let ia  = 255 - sa;
                let srb = (col & 0x00FF00FF) * sa + 0x007F007F;
                let sg  = ((col >> 8) & 0xFF) * sa + 127;
                var dx = ex - lx; if (dx < 0) { dx = 0 - dx; }
                var dn = ey - ly; if (dn < 0) { dn = 0 - dn; }
                dn = 0 - dn;
                var sx = 0 - 1; if (lx < ex) { sx = 1; }
                var sy = 0 - 1; if (ly < ey) { sy = 1; }
                var err = dx + dn;
                var run = 1;
                while (run == 1) {
                    if (lx >= 0 && lx < cw && ly >= 0 && ly < ch) {
                        let o = dst + ly * stride + lx;
                        if (sa == 255) {
                            b[o] = col;
                        } else {
                            let d = b[o];
                            var rb = (d & 0x00FF00FF) * ia + srb;
                            rb = ((rb + 0x00010001 + ((rb >> 8) & 0x00FF00FF)) >> 8) & 0x00FF00FF;
                            var gg = ((d >> 8) & 0xFF) * ia + sg;
                            gg = ((gg + 1 + (gg >> 8)) >> 8) & 0xFF;
                            var aa = ((d >> 24) & 0xFF) * ia + 127;
                            aa = sa + ((aa + 1 + (aa >> 8)) >> 8);
                            b[o] = ((aa & 0xFF) << 24) | rb | (gg << 8);
                        }
                    }
                    if (lx == ex && ly == ey) {
                        run = 0;
                    } else {
                        let e2 = 2 * err;
                        if (e2 >= dn) { err = err + dn; lx = lx + sx; }
                        if (e2 <= dx) { err = err + dx; ly = ly + sy; }
                    }
                }
            }
            p = p + sz;
            i = i + 1;
        }
        return 0;
    }

    // Stamped-segment kernel: filled disks (or rings) of radius rr sampled
    // along a segment - the shape behind thick lines, strokes and circles.
    //
    // Row half-widths are carried across rows instead of re-derived per row:
    // sqrt(rr^2 - dy^2) rises to rr and falls back, so the two adjust loops
    // together step O(rr) times per disk rather than the O(rr^2) a per-row
    // scan costs.
    //
    // Sample positions use exact rational rounding (half away from zero) rather
    // than a floating-point accumulator, so a long segment cannot drift.
    fn static _kernelStamp(b:block, _blen:int, start:int):int {
        let n = b[0];
        var i = 0;
        var p = start;
        while (i < n) {
            let sz     = b[p + 1];
            let dst    = b[p + 2];
            let stride = b[p + 3];
            let col    = b[p + sz - 1];
            let cw = b[p + 4]; let ch = b[p + 5];
            let x0 = b[p + 6]; let y0 = b[p + 7];
            let x1 = b[p + 8]; let y1 = b[p + 9];
            let rr = b[p + 10];
            let sa  = (col >> 24) & 0xFF;
            let ia  = 255 - sa;
            let srb = (col & 0x00FF00FF) * sa + 0x007F007F;
            let sg  = ((col >> 8) & 0xFF) * sa + 127;
            let ddx = x1 - x0;
            let ddy = y1 - y0;
            var adx = ddx; if (adx < 0) { adx = 0 - adx; }
            var ady = ddy; if (ady < 0) { ady = 0 - ady; }
            var steps = adx;
            if (ady > adx) { steps = ady; }
            let r2 = rr * rr;
            var k = 0;
            while (k <= steps) {
                var cx = x0;
                var cy = y0;
                if (steps > 0) {
                    var na = ddx * k * 2;
                    if (na >= 0) { cx = x0 + (na + steps) / (steps * 2); }
                    else         { cx = x0 - ((0 - na) + steps) / (steps * 2); }
                    var nb = ddy * k * 2;
                    if (nb >= 0) { cy = y0 + (nb + steps) / (steps * 2); }
                    else         { cy = y0 - ((0 - nb) + steps) / (steps * 2); }
                }
                if (rr <= 0) {
                    if (cx >= 0 && cx < cw && cy >= 0 && cy < ch) {
                        let o = dst + cy * stride + cx;
                        if (sa == 255) {
                            b[o] = col;
                        } else {
                            let d = b[o];
                            var rb = (d & 0x00FF00FF) * ia + srb;
                            rb = ((rb + 0x00010001 + ((rb >> 8) & 0x00FF00FF)) >> 8) & 0x00FF00FF;
                            var gg = ((d >> 8) & 0xFF) * ia + sg;
                            gg = ((gg + 1 + (gg >> 8)) >> 8) & 0xFF;
                            var aa = ((d >> 24) & 0xFF) * ia + 127;
                            aa = sa + ((aa + 1 + (aa >> 8)) >> 8);
                            b[o] = ((aa & 0xFF) << 24) | rb | (gg << 8);
                        }
                    }
                } else {
                    var half = 0;
                    var dyy = 0 - rr;
                    while (dyy <= rr) {
                        let d2 = r2 - dyy * dyy;
                        while ((half + 1) * (half + 1) <= d2) { half = half + 1; }
                        while (half > 0 && half * half > d2) { half = half - 1; }
                        let yy = cy + dyy;
                        if (yy >= 0 && yy < ch) {
                            {
                                var xa = cx - half;
                                var xb = cx + half;
                                if (xa < 0) { xa = 0; }
                                if (xb >= cw) { xb = cw - 1; }
                                let ro = dst + yy * stride;
                                var xj = xa;
                                while (xj <= xb) {
                                    let o = ro + xj;
                                    if (sa == 255) {
                                        b[o] = col;
                                    } else {
                                        let d = b[o];
                                        var rb = (d & 0x00FF00FF) * ia + srb;
                                        rb = ((rb + 0x00010001 + ((rb >> 8) & 0x00FF00FF)) >> 8) & 0x00FF00FF;
                                        var gg = ((d >> 8) & 0xFF) * ia + sg;
                                        gg = ((gg + 1 + (gg >> 8)) >> 8) & 0xFF;
                                        var aa = ((d >> 24) & 0xFF) * ia + 127;
                                        aa = sa + ((aa + 1 + (aa >> 8)) >> 8);
                                        b[o] = ((aa & 0xFF) << 24) | rb | (gg << 8);
                                    }
                                    xj = xj + 1;
                                }
                            }
                        }
                        dyy = dyy + 1;
                    }
                }
                k = k + 1;
            }
            p = p + sz;
            i = i + 1;
        }
        return 0;
    }

}

// ---------------------------------------------------------------------------
// Every canvas is a region of one shared surface arena. Keeping them together
// is what lets an operation that reads one canvas and writes another run as a
// single offload kernel, with no copying between them.
// ---------------------------------------------------------------------------

global _rasterEngine = nil;

fn _r() : Raster {
    if (_rasterEngine == nil) {
        _rasterEngine = new Raster(1048576, 8192);
    }
    return _rasterEngine;
}

// Allocate a canvas-sized surface, growing the arena if it will not fit.
fn _newSurface(w:int, h:int) : object|nil {
    let e = _r();
    var s = e.NewSurface(w, h);
    if (s == nil) {
        e.EnsureFree(w * h);
        s = e.NewSurface(w, h);
    }
    // A canvas that could not be allocated degrades to 1x1 rather than nil, so
    // every method stays safe to call and drawing simply clips away.
    if (s == nil) { s = e.NewSurface(1, 1); }
    return s;
}

class Graphics {

    // ----------------------------------------------------------------
    // Instance fields
    // ----------------------------------------------------------------
    let _width:int    = 1;
    let _height:int   = 1;
    let _s:object = nil;

    let _stroke:int    = 0xFFFFFFFF;  // default: opaque white
    let _fill:int      = 0;           // 0 = no fill
    let _thickness:int = 1;

    // ----------------------------------------------------------------
    // Construction
    // ----------------------------------------------------------------

    // Dimensions are clamped to 1..16384 per side. A canvas too large to
    // allocate degrades to 1x1 instead of becoming unusable.
    fn Constructor(w:int, h:int) {
        this._width  = Math.Min(Raster.MaxSide(), Math.Max(1, w));
        this._height = Math.Min(Raster.MaxSide(), Math.Max(1, h));
        this._s      = _newSurface(_width, _height);
        if (_s != nil) {
            this._width  = _s.w;
            this._height = _s.h;
        }
    }
    fn static Create(w:int, h:int) : instance {
        return new Graphics(w, h);
    }

    fn static FromFile(file:string) : instance|nil {
        let img = Png.Load(file);
        if (img == nil) return nil;
        let gi = new Graphics(img.Width, img.Height);
        if (gi._s == nil) return nil;
        Buffer.Copy(img.Pixels, 0, _r().Arena(), gi._s.off * 4,
                    img.Width * img.Height * 4);
        return gi;
    }
    fn Width()  : int { return _width;  }
    fn Height() : int { return _height; }
    fn GetGfx() : object|nil { return _s; }

    // ----------------------------------------------------------------
    // Style
    // ----------------------------------------------------------------

    fn SetStroke(argb:int) {
        _stroke = argb;
        return;
    }

    fn SetFill(argb:int) {
        _fill = argb;
        return;
    }

    fn SetThickness(t:int) {
        _thickness = Math.Max(1, t);
        return;
    }

    fn StrokeColor() : int { return _stroke;    }
    fn FillColor()   : int { return _fill;      }
    fn Thickness()   : int { return _thickness; }

    // ----------------------------------------------------------------
    // Pixel operations
    // ----------------------------------------------------------------

    fn Clear(color:int) {
        _r().Clear(_s, color);
        return;
    }

    fn Pixel(x:int, y:int, color:int) {
        _r().SetPixel(_s, x, y, color);
        return;
    }

    // Returns nil outside the canvas rather than a colour, so a caller can
    // tell "transparent black" from "off the edge".
    fn GetPixel(x:int, y:int) {
        if (x < 0 || y < 0 || x >= _width || y >= _height) return nil;
        return _r().GetPixel(_s, x, y);
    }

    // ----------------------------------------------------------------
    // Lines
    // ----------------------------------------------------------------

    fn Line(x0:int, y0:int, x1:int, y1:int) {
        _r().DrawLine(_s, x0, y0, x1, y1, _stroke, _thickness);
        return;
    }

    fn HLine(x0:int, y:int, x1:int) {
        _r().HLine(_s, x0, y, x1, _stroke, _thickness);
        return;
    }

    fn VLine(x:int, y0:int, y1:int) {
        _r().VLine(_s, x, y0, y1, _stroke, _thickness);
        return;
    }

    fn Polyline(pts:array) {
        _r().StrokePath(_s, pts, _stroke, _thickness, 1, 0);  // cap=round, open
        return;
    }

    // ----------------------------------------------------------------
    // Rectangles
    // ----------------------------------------------------------------

    fn Rect(x:int, y:int, w:int, h:int) {
        _r().DrawRect(_s, x, y, w, h, _stroke, _thickness);
        return;
    }

    fn FillRect(x:int, y:int, w:int, h:int) {
        if (_fill == 0) return;
        _r().FillRect(_s, x, y, w, h, _fill);
        return;
    }

    // Outlined rounded rectangle.
    // Straight edges via HLine/VLine; corners via ArcButt (pure Flaris).
    fn RoundRect(x:int, y:int, w:int, h:int, r:int) {
        let maxr = Math.Min(w, h) / 2;
        if (r > maxr) r = maxr;
        if (r < 1) {
            Rect(x, y, w, h);
            return;
        }

        _r().HLine(_s, x + r,     y,         x + w - r - 1, _stroke, _thickness);
        _r().HLine(_s, x + r,     y + h - 1, x + w - r - 1, _stroke, _thickness);
        _r().VLine(_s, x,         y + r,     y + h - r - 1,  _stroke, _thickness);
        _r().VLine(_s, x + w - 1, y + r,     y + h - r - 1,  _stroke, _thickness);

        ArcButt(x + r,         y + r,         r, 180, 270);
        ArcButt(x + w - r - 1, y + r,         r, 270, 360);
        ArcButt(x + w - r - 1, y + h - r - 1, r,   0,  90);
        ArcButt(x + r,         y + h - r - 1, r,  90, 180);
        return;
    }

    // Filled rounded rectangle.
    // 3 FillRect bands + 4 FillPie corner quarters (pure Flaris).
    // Fill then stroke a rounded rectangle in one call.
    fn DrawRoundRect(x:int, y:int, w:int, h:int, r:int) {
        if (_fill != 0) FillRoundRect(x, y, w, h, r);
        RoundRect(x, y, w, h, r);
        return;
    }

    fn FillRoundRect(x:int, y:int, w:int, h:int, r:int) {
        if (_fill == 0) return;
        let maxr = Math.Min(w, h) / 2;
        if (r > maxr) r = maxr;
        if (r < 1) {
            FillRect(x, y, w, h);
            return;
        }

        _r().FillRect(_s, x,     y + r,     w,         h - r * 2, _fill);
        _r().FillRect(_s, x + r, y,         w - r * 2, r,         _fill);
        _r().FillRect(_s, x + r, y + h - r, w - r * 2, r,         _fill);

        FillPie(x + r,         y + r,         r, 180, 270);
        FillPie(x + w - r - 1, y + r,         r, 270, 360);
        FillPie(x + w - r - 1, y + h - r - 1, r,   0,  90);
        FillPie(x + r,         y + h - r - 1, r,  90, 180);
        return;
    }

    // ----------------------------------------------------------------
    // Circles
    // ----------------------------------------------------------------

    fn Circle(cx:int, cy:int, r:int) {
        _r().DrawCircle(_s, cx, cy, r, _stroke, _thickness, 0);
        return;
    }

    fn FillCircle(cx:int, cy:int, r:int) {
        if (_fill == 0) return;
        _r().DrawCircle(_s, cx, cy, r, _fill, 0, 0);
        return;
    }

    // Fill then stroke in one call (skips each if the respective color is 0).
    fn DrawCircle(cx:int, cy:int, r:int) {
        if (_fill != 0) _r().DrawCircle(_s, cx, cy, r, _fill, 0, 0);
        _r().DrawCircle(_s, cx, cy, r, _stroke, _thickness, 0);
        return;
    }

    // ----------------------------------------------------------------
    // Ellipses  (pure Flaris)
    // ----------------------------------------------------------------

    fn _ellipsePts(cx:int, cy:int, rx:int, ry:int) : array {
        let maxr  = Math.Max(rx, ry);
        let steps = maxr * 2;
        if (steps < 32)  steps = 32;
        if (steps > 360) steps = 360;

        let pts = [];
        let i = 0;
        while (i < steps) {
            let rad = Math.Rad((i * 360) / steps);
            let px  = cx + Convert.ToInt(Math.Round(rx * Math.Cos(rad)));
            let py  = cy + Convert.ToInt(Math.Round(ry * Math.Sin(rad)));
            Array.Append(pts, px);
            Array.Append(pts, py);
            i = i + 1;
        }
        return pts;
    }

    fn Ellipse(cx:int, cy:int, rx:int, ry:int) {
        let pts = _ellipsePts(cx, cy, rx, ry);
        _r().StrokePath(_s, pts, _stroke, _thickness, 0, 1);  // cap=butt, closed
        return;
    }

    fn FillEllipse(cx:int, cy:int, rx:int, ry:int) {
        if (_fill == 0) return;
        let pts = _ellipsePts(cx, cy, rx, ry);
        _r().FillPolygon(_s, pts, _fill);
        return;
    }

    // ----------------------------------------------------------------
    // Arcs  (pure Flaris)
    // ----------------------------------------------------------------

    fn _arcPts(cx:int, cy:int, r:int, startDeg:int, endDeg:int) : array {
        let a0 = startDeg;
        let a1 = endDeg;
        if (a1 < a0) a1 = a1 + 360;

        let sweep = a1 - a0;
        let steps = sweep;
        if (steps < 8)   steps = 8;
        if (steps > 720) steps = 720;

        let pts = [];
        let i = 0;
        while (i <= steps) {
            let deg = a0 + (sweep * i) / steps;
            let rad = Math.Rad(deg);
            let px  = cx + Convert.ToInt(Math.Round(r * Math.Cos(rad)));
            let py  = cy + Convert.ToInt(Math.Round(r * Math.Sin(rad)));
            Array.Append(pts, px);
            Array.Append(pts, py);
            i = i + 1;
        }
        return pts;
    }

    fn Arc(cx:int, cy:int, r:int, startDeg:int, endDeg:int) {
        let pts = _arcPts(cx, cy, r, startDeg, endDeg);
        _r().StrokePath(_s, pts, _stroke, _thickness, 1, 0);  // cap=round, open
        return;
    }

    fn ArcButt(cx:int, cy:int, r:int, startDeg:int, endDeg:int) {
        let pts = _arcPts(cx, cy, r, startDeg, endDeg);
        _r().StrokePath(_s, pts, _stroke, _thickness, 0, 0);  // cap=butt, open
        return;
    }

    // ----------------------------------------------------------------
    // Pies  (pure Flaris)
    // ----------------------------------------------------------------

    fn Pie(cx:int, cy:int, r:int, startDeg:int, endDeg:int) {
        let arc = _arcPts(cx, cy, r, startDeg, endDeg);
        let pts = Array.Concat([cx, cy], arc);
        _r().StrokePath(_s, pts, _stroke, _thickness, 0, 1);  // cap=butt, closed
        return;
    }

    fn FillPie(cx:int, cy:int, r:int, startDeg:int, endDeg:int) {
        if (_fill == 0) return;
        let arc = _arcPts(cx, cy, r, startDeg, endDeg);
        let pts = Array.Concat([cx, cy], arc);
        _r().FillPolygon(_s, pts, _fill);
        return;
    }

    // ----------------------------------------------------------------
    // Polygons  (pure Flaris outline; fill uses C)
    // ----------------------------------------------------------------

    fn Polygon(pts:array) {
        _r().StrokePath(_s, pts, _stroke, _thickness, 0, 1);  // cap=butt, closed
        return;
    }

    fn FillPolygon(pts:array) {
        if (_fill == 0) return;
        _r().FillPolygon(_s, pts, _fill);
        return;
    }

    // ----------------------------------------------------------------
    // Text
    // ----------------------------------------------------------------

    fn DrawChar(x:int, y:int, code:int) {
        _r().DrawChar(_s, x, y, code, _stroke, 1);
        return;
    }

    fn DrawCharScaled(x:int, y:int, code:int, scale:int) {
        _r().DrawChar(_s, x, y, code, _stroke, scale);
        return;
    }

    fn DrawText(x:int, y:int, text:string) {
        _r().DrawText(_s, x, y, text, _stroke, 1, 0, 0);
        return;
    }

    fn DrawTextEx(x:int, y:int, text:string, scale:int) {
        _r().DrawText(_s, x, y, text, _stroke, scale, 0, 0);
        return;
    }

    // lspace: extra pixels between characters (default 0, matches DrawText).
    fn static TextWidth(text:string, scale:int, lspace) : int {
        let l = (lspace == nil || lspace < 0) ? 0 : int(lspace);
        return len(text) * (8 * scale + l);
    }

    fn static TextHeight(scale:int) : int {
        return 8 * scale;
    }

    // Returns { width, height } for layout calculations.
    fn static TextMetrics(text:string, scale:int, lspace) : object {
        let l = (lspace == nil || lspace < 0) ? 0 : int(lspace);
        return { width: len(text) * (8 * scale + l), height: 8 * scale };
    }

    // ----------------------------------------------------------------
    // Images & compositing
    // ----------------------------------------------------------------

    fn DrawImage(file:string, x:int, y:int, w:int, h:int) {
        this._drawFile(file, x, y, w, h);
        return;
    }
    fn DrawImageNearest(file:string, x:int, y:int, w:int, h:int) {
        this._drawFile(file, x, y, w, h);
        return;
    }
    fn Blit(x:int, y:int, w:int, h:int, pixels:array) {
        _r().Blit(_s, x, y, w, h, pixels);
        return;
    }

    fn Draw(src:instance, x:int, y:int) {
        _r().Draw(_s, src.GetGfx(), x, y);
        return;
    }

    fn DrawGfx(srcGfx:object, x:int, y:int) {
        _r().Draw(_s, srcGfx, x, y);
        return;
    }

    fn CopyRect(x:int, y:int, w:int, h:int) : instance {
        let sub = _r().CopyRect(_s, x, y, w, h);
        let gi  = new Graphics(1, 1);
        if (sub != nil) {
            _r().FreeSurface(gi._s);
            gi._s      = sub;
            gi._width  = sub.w;
            gi._height = sub.h;
        }
        return gi;
    }
    // Returns true on success, nil on failure (a missing directory, say) - it
    // never raises.
    fn Save(path:string) {
        if (Png.Save(path, this._pixels(), _width, _height, nil)) { return true; }
        return nil;
    }
    fn ToBlock() {
        return Png.Encode(this._pixels(), _width, _height, nil);
    }
    fn Resize(w:int, h:int) {
        let out = _r().Resize(_s, w, h);
        if (out == nil) return;
        _r().Flush();
        _r().FreeSurface(_s);
        _s      = out;
        _width  = w;
        _height = h;
        return;
    }
    fn Rescale(sx:float, sy:float) {
        let out = _r().Rescale(_s, sx, sy);
        if (out == nil) return;
        _r().Flush();
        _r().FreeSurface(_s);
        _s      = out;
        _width  = out.w;
        _height = out.h;
        return;
    }
    fn RescaleUniform(s:float) {
        this.Rescale(s, s);
        return;
    }
    fn Filter(callback:fn, x:int, y:int, w:int, h:int) {
        _r().Filter(_s, callback, x, y, w, h);
        return;
    }

    fn FilterAll(callback:fn) {
        _r().Filter(_s, callback, 0, 0, _width, _height);
        return;
    }

    // Offload a region kernel fn(pixels, x, y, w, h, stride) -> scalar to a
    // worker thread (threadsafe JIT kernel + --jit) or run it inline, then fire
    // cb(surface, result). `pixels` is the 32-bit ARGB block; index a region
    // pixel as pixels[(y+dy)*stride + (x+dx)]. `surface` handed to cb is the
    // underlying Gfx image. See Buffer.ProcessCallback for the kernel rules.
    // The kernel keeps its documented shape - fn(pixels, x, y, w, h, stride),
    // returning a value handed to the callback - so it is run over a snapshot
    // of this canvas and the result copied back. Use Raster.FilterRegion when
    // you want the work pushed to another core instead.
    fn _runKernel(kernel:function, x:int, y:int, w:int, h:int) {
        _r().Flush();
        let px = Buffer.Slice(_r().Arena(), _s.off, _width * _height);
        let res = kernel(px, x, y, w, h, _width);
        Buffer.Copy(px, 0, _r().Arena(), _s.off * 4, _width * _height * 4);
        return res;
    }

    fn FilterCallback(kernel:function, x:int, y:int, w:int, h:int, cb:function) {
        let res = this._runKernel(kernel, x, y, w, h);
        cb(this, res);
        return;
    }

    fn FilterCallbackAll(kernel:function, cb:function) {
        let res = this._runKernel(kernel, 0, 0, _width, _height);
        cb(this, res);
        return;
    }

    fn FilterEvent(kernel:function, x:int, y:int, w:int, h:int, eventId:int) {
        let res = this._runKernel(kernel, x, y, w, h);
        Event.Set(eventId, res);
        return;
    }

    fn FilterEventAll(kernel:function, eventId:int) {
        let res = this._runKernel(kernel, 0, 0, _width, _height);
        Event.Set(eventId, res);
        return;
    }
    fn Grayscale(x:int, y:int, w:int, h:int) {
        _r().Grayscale(_s, x, y, w, h);
        return;
    }

    fn GrayscaleAll() {
        _r().Grayscale(_s, 0, 0, _width, _height);
        return;
    }

    fn Brightness(x:int, y:int, w:int, h:int, factor:float) {
        _r().Brightness(_s, x, y, w, h, factor);
        return;
    }

    fn BrightnessAll(factor:float) {
        _r().Brightness(_s, 0, 0, _width, _height, factor);
        return;
    }

    fn BlendRect(src:instance, dx:int, dy:int, alpha:int) {
        _r().BlendSurface(_s, src.GetGfx(), dx, dy, alpha);
        return;
    }

    fn Blend(src:instance, dx:int, dy:int) {
        _r().BlendSurface(_s, src.GetGfx(), dx, dy, 255);
        return;
    }

    // ----------------------------------------------------------------
    // Color helpers  (static, return 0xAARRGGBB)
    // ----------------------------------------------------------------

    // All three implemented in gfx.c.
    fn static RGB(r:int, g:int, b:int) : int {
        return Raster.RGB(r, g, b);
    }

    fn static RGBA(r:int, g:int, b:int, a:int) : int {
        return Raster.RGBA(r, g, b, a);
    }

    // h: 0-360, s: 0.0-1.0, l: 0.0-1.0
    fn static HSL(h:float, s:float, l:float) : int {
        return Raster.HSL(h, s, l);
    }

    // ----------------------------------------------------------------
    // Image loading
    // ----------------------------------------------------------------

    // Load an image file into a Graphics instance for compositing.
    // Use g.Draw(loaded, x, y) or g.Blend(loaded, x, y) to composite it.
    fn static LoadImage(path:string) : instance|nil {
        return Graphics.FromFile(path);
    }

    // ----------------------------------------------------------------
    // Internals
    // ----------------------------------------------------------------

    // This canvas's pixels as a standalone block, for the PNG encoder.
    fn _pixels() : block {
        _r().Flush();
        return Buffer.Slice(_r().Arena(), _s.off, _width * _height);
    }

    // Load a PNG, scale it to w x h if needed, and composite it at (x, y).
    fn _drawFile(file:string, x:int, y:int, w:int, h:int) {
        let img = Png.Load(file);
        if (img == nil) return;
        let tmp = _newSurface(img.Width, img.Height);
        if (tmp == nil) return;
        Buffer.Copy(img.Pixels, 0, _r().Arena(), tmp.off * 4,
                    img.Width * img.Height * 4);
        if (w == img.Width && h == img.Height) {
            _r().Draw(_s, tmp, x, y);
            _r().Flush();
        } else {
            let sc = _r().Resize(tmp, w, h);
            if (sc != nil) {
                _r().Draw(_s, sc, x, y);
                _r().Flush();
                _r().FreeSurface(sc);
            }
        }
        _r().FreeSurface(tmp);
        return;
    }
}

export { Graphics };
