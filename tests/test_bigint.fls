// test_bigint.fls - Tests for BigInt.fls

import { BigInt } from library("BigInt", "1.0");

global passed = 0;
global failed = 0;
global _sink  = 0;

fn bench(name: string, f: fn, n: int) {
    f(); f(); f();
    let t0: int = Time.Ticks();
    iter (i from 0 to n) { f(); }
    let dt: int = Time.Ticks() - t0;
    let ms: float = Time.TicksToMs(dt);
    let us: float = Time.TicksToUs(dt) / float(n);
    Console.WriteLine(
        String.PadRight(name, 48),
        String.PadLeft(String.FormatArray("{0:.2f}", [ms]),   9), " ms  ",
        String.PadLeft(String.FormatArray("{0:.4f}", [us]),  11), " µs/call"
    );
}

fn benchSep() { Console.WriteLine(String.Repeat("-", 74)); }

fn eq(name, a, b) {
    if (a == b) {
        Console.WriteLine("[PASS] " + name);
        passed += 1;
    } else {
        Console.WriteLine("[FAIL] " + name + "  got=" + Convert.ToString(a) + "  want=" + Convert.ToString(b));
        failed += 1;
    }
}

fn beq(name, a, b) {
    eq(name, BigInt.ToString(a), BigInt.ToString(b));
}

fn bstr(name, a, want) {
    eq(name, BigInt.ToString(a), want);
}

fn ok(name, cond) {
    if (cond) {
        Console.WriteLine("[PASS] " + name);
        passed += 1;
    } else {
        Console.WriteLine("[FAIL] " + name);
        failed += 1;
    }
}

// ================================================================
// Construction and ToString
// ================================================================

fn test_construction() {
    Console.WriteLine("-- construction");

    bstr("From(0)",               BigInt.From(0),   "0");
    bstr("From(1)",               BigInt.From(1),   "1");
    bstr("From(-1)",              BigInt.From(-1),  "-1");
    bstr("From(9999)",            BigInt.From(9999), "9999");
    bstr("From(10000)",           BigInt.From(10000), "10000");
    bstr("From(1000000000)",      BigInt.From(1000000000), "1000000000");
    bstr("From(-999999999)",      BigInt.From(-999999999), "-999999999");

    bstr("From str small",        BigInt.From("42"),    "42");
    bstr("From str negative",     BigInt.From("-99"),   "-99");
    bstr("From str big",
        BigInt.From("12345678901234567890"),
        "12345678901234567890");
    bstr("From str leading zeros",  BigInt.From("00042"),  "42");
    bstr("From str just zeros",     BigInt.From("000"),    "0");
    bstr("From str neg zero",       BigInt.From("-0"),     "0");
    bstr("Zero()",                  BigInt.Zero(),         "0");
    bstr("One()",                   BigInt.One(),          "1");
}

// ================================================================
// ToInt
// ================================================================

fn test_toint() {
    Console.WriteLine("-- ToInt");

    eq("ToInt(0)",   BigInt.ToInt(BigInt.From(0)),   0);
    eq("ToInt(1)",   BigInt.ToInt(BigInt.From(1)),   1);
    eq("ToInt(-1)",  BigInt.ToInt(BigInt.From(-1)), -1);
    eq("ToInt(9999999999)",
        BigInt.ToInt(BigInt.From(9999999999)),
        9999999999);
    ok("ToInt huge returns nil",
        BigInt.ToInt(BigInt.From("99999999999999999999")) == nil);
}

// ================================================================
// Comparison
// ================================================================

fn test_comparison() {
    Console.WriteLine("-- comparison");

    var a = BigInt.From(5);
    var b = BigInt.From(3);
    var c = BigInt.From(5);
    var neg = BigInt.From(-5);

    eq("Cmp(5,3)=1",   BigInt.Cmp(a, b),  1);
    eq("Cmp(3,5)=-1",  BigInt.Cmp(b, a), -1);
    eq("Cmp(5,5)=0",   BigInt.Cmp(a, c),  0);
    eq("Cmp(-5,3)=-1", BigInt.Cmp(neg, b), -1);
    eq("Cmp(3,-5)=1",  BigInt.Cmp(b, neg), 1);

    ok("Eq true",   BigInt.Eq(a, c));
    ok("Eq false",  !BigInt.Eq(a, b));
    ok("Lt true",   BigInt.Lt(b, a));
    ok("Lt false",  !BigInt.Lt(a, b));
    ok("Lte equal", BigInt.Lte(a, c));
    ok("Gt true",   BigInt.Gt(a, b));
    ok("Gte equal", BigInt.Gte(a, c));

    ok("IsZero true",  BigInt.IsZero(BigInt.Zero()));
    ok("IsZero false", !BigInt.IsZero(a));
    ok("IsNeg true",   BigInt.IsNeg(neg));
    ok("IsNeg false",  !BigInt.IsNeg(a));
    ok("IsPos true",   BigInt.IsPos(a));
    ok("IsPos false",  !BigInt.IsPos(BigInt.Zero()));

    // Large number comparison
    var big1 = BigInt.From("99999999999999999999");
    var big2 = BigInt.From("100000000000000000000");
    ok("big Lt", BigInt.Lt(big1, big2));
    ok("big Gt", BigInt.Gt(big2, big1));
}

// ================================================================
// Neg / Abs
// ================================================================

fn test_neg_abs() {
    Console.WriteLine("-- Neg / Abs");

    bstr("Neg(5)='-5'",    BigInt.Neg(BigInt.From(5)),  "-5");
    bstr("Neg(-5)='5'",    BigInt.Neg(BigInt.From(-5)), "5");
    bstr("Neg(0)='0'",     BigInt.Neg(BigInt.Zero()),   "0");
    bstr("Abs(5)='5'",     BigInt.Abs(BigInt.From(5)),  "5");
    bstr("Abs(-5)='5'",    BigInt.Abs(BigInt.From(-5)), "5");
    bstr("Abs(0)='0'",     BigInt.Abs(BigInt.Zero()),   "0");
}

// ================================================================
// Addition
// ================================================================

fn test_add() {
    Console.WriteLine("-- Add");

    beq("0+0",     BigInt.Add(BigInt.From(0),   BigInt.From(0)),   BigInt.From(0));
    beq("1+1",     BigInt.Add(BigInt.From(1),   BigInt.From(1)),   BigInt.From(2));
    beq("999+1",   BigInt.Add(BigInt.From(999), BigInt.From(1)),   BigInt.From(1000));
    beq("9999+1",  BigInt.Add(BigInt.From(9999), BigInt.From(1)),  BigInt.From(10000));

    // Cross-sign
    beq("5+(-3)",  BigInt.Add(BigInt.From(5),  BigInt.From(-3)),  BigInt.From(2));
    beq("3+(-5)",  BigInt.Add(BigInt.From(3),  BigInt.From(-5)),  BigInt.From(-2));
    beq("-3+(-5)", BigInt.Add(BigInt.From(-3), BigInt.From(-5)),  BigInt.From(-8));
    beq("5+(-5)",  BigInt.Add(BigInt.From(5),  BigInt.From(-5)),  BigInt.Zero());

    // Large
    bstr("big add carry",
        BigInt.Add(BigInt.From("9999999999999999"), BigInt.From(1)),
        "10000000000000000");
}

// ================================================================
// Subtraction
// ================================================================

fn test_sub() {
    Console.WriteLine("-- Sub");

    beq("10-3",    BigInt.Sub(BigInt.From(10), BigInt.From(3)),   BigInt.From(7));
    beq("3-10",    BigInt.Sub(BigInt.From(3),  BigInt.From(10)),  BigInt.From(-7));
    beq("0-0",     BigInt.Sub(BigInt.Zero(),   BigInt.Zero()),    BigInt.Zero());
    beq("5-5",     BigInt.Sub(BigInt.From(5),  BigInt.From(5)),   BigInt.Zero());
    beq("-3-2",    BigInt.Sub(BigInt.From(-3), BigInt.From(2)),   BigInt.From(-5));

    bstr("big borrow",
        BigInt.Sub(BigInt.From("10000000000000000"), BigInt.From(1)),
        "9999999999999999");
}

// ================================================================
// Multiplication
// ================================================================

fn test_mul() {
    Console.WriteLine("-- Mul");

    beq("0*99",    BigInt.Mul(BigInt.Zero(), BigInt.From(99)),   BigInt.Zero());
    beq("1*42",    BigInt.Mul(BigInt.One(),  BigInt.From(42)),   BigInt.From(42));
    beq("3*4",     BigInt.Mul(BigInt.From(3), BigInt.From(4)),   BigInt.From(12));
    beq("-3*4",    BigInt.Mul(BigInt.From(-3), BigInt.From(4)),  BigInt.From(-12));
    beq("-3*-4",   BigInt.Mul(BigInt.From(-3), BigInt.From(-4)), BigInt.From(12));

    // 123456789 * 987654321 = 121932631112635269
    bstr("large mul",
        BigInt.Mul(BigInt.From(123456789), BigInt.From(987654321)),
        "121932631112635269");
}

// ================================================================
// Division and Modulo
// ================================================================

fn test_div_mod() {
    Console.WriteLine("-- Div / Mod");

    beq("10/3",    BigInt.Div(BigInt.From(10), BigInt.From(3)),  BigInt.From(3));
    beq("10%3",    BigInt.Mod(BigInt.From(10), BigInt.From(3)),  BigInt.From(1));
    beq("9/3",     BigInt.Div(BigInt.From(9),  BigInt.From(3)),  BigInt.From(3));
    beq("9%3",     BigInt.Mod(BigInt.From(9),  BigInt.From(3)),  BigInt.Zero());
    beq("0/5",     BigInt.Div(BigInt.Zero(),   BigInt.From(5)),  BigInt.Zero());
    beq("0%5",     BigInt.Mod(BigInt.Zero(),   BigInt.From(5)),  BigInt.Zero());
    beq("1/1",     BigInt.Div(BigInt.One(),    BigInt.One()),     BigInt.One());

    // Negative: truncates toward zero
    beq("-10/3",   BigInt.Div(BigInt.From(-10), BigInt.From(3)),  BigInt.From(-3));
    beq("-10%3",   BigInt.Mod(BigInt.From(-10), BigInt.From(3)),  BigInt.From(-1));
    beq("10/-3",   BigInt.Div(BigInt.From(10),  BigInt.From(-3)), BigInt.From(-3));

    // Division by zero returns nil
    ok("div by zero nil", BigInt.Div(BigInt.From(5), BigInt.Zero()) == nil);
    ok("mod by zero nil", BigInt.Mod(BigInt.From(5), BigInt.Zero()) == nil);

    // DivMod
    var dm = BigInt.DivMod(BigInt.From(17), BigInt.From(5));
    beq("DivMod q", dm.q, BigInt.From(3));
    beq("DivMod r", dm.r, BigInt.From(2));
    ok("DivMod zero divisor nil", BigInt.DivMod(BigInt.From(1), BigInt.Zero()) == nil);

    // Large division
    bstr("big div",
        BigInt.Div(BigInt.From("121932631112635269"), BigInt.From(987654321)),
        "123456789");
}

// ================================================================
// Power
// ================================================================

fn test_pow() {
    Console.WriteLine("-- Pow");

    bstr("2^0",   BigInt.Pow(BigInt.From(2), 0),  "1");
    bstr("2^1",   BigInt.Pow(BigInt.From(2), 1),  "2");
    bstr("2^10",  BigInt.Pow(BigInt.From(2), 10), "1024");
    bstr("2^32",  BigInt.Pow(BigInt.From(2), 32), "4294967296");
    bstr("2^64",  BigInt.Pow(BigInt.From(2), 64), "18446744073709551616");
    bstr("2^100", BigInt.Pow(BigInt.From(2), 100),
        "1267650600228229401496703205376");
    bstr("10^20", BigInt.Pow(BigInt.From(10), 20), "100000000000000000000");
    bstr("(-2)^3", BigInt.Pow(BigInt.From(-2), 3), "-8");
    bstr("(-2)^4", BigInt.Pow(BigInt.From(-2), 4), "16");
    ok("Pow neg exp nil", BigInt.Pow(BigInt.From(2), -1) == nil);
}

// ================================================================
// GCD
// ================================================================

fn test_gcd() {
    Console.WriteLine("-- Gcd");

    bstr("Gcd(48,18)=6",      BigInt.Gcd(BigInt.From(48), BigInt.From(18)),  "6");
    bstr("Gcd(100,75)=25",    BigInt.Gcd(BigInt.From(100), BigInt.From(75)), "25");
    bstr("Gcd(7,13)=1",       BigInt.Gcd(BigInt.From(7),   BigInt.From(13)), "1");
    bstr("Gcd(0,5)=5",        BigInt.Gcd(BigInt.Zero(),    BigInt.From(5)),  "5");
    bstr("Gcd(neg,pos)",      BigInt.Gcd(BigInt.From(-12), BigInt.From(8)),  "4");
}

// ================================================================
// Factorial
// ================================================================

fn test_factorial() {
    Console.WriteLine("-- Factorial");

    bstr("0!",  BigInt.Factorial(0),  "1");
    bstr("1!",  BigInt.Factorial(1),  "1");
    bstr("5!",  BigInt.Factorial(5),  "120");
    bstr("10!", BigInt.Factorial(10), "3628800");
    bstr("20!", BigInt.Factorial(20), "2432902008176640000");
    bstr("50!", BigInt.Factorial(50),
        "30414093201713378043612608166064768844377641568960512000000000000");
    ok("neg factorial nil", BigInt.Factorial(-1) == nil);
}

// ================================================================
// Fibonacci
// ================================================================

fn test_fibonacci() {
    Console.WriteLine("-- Fibonacci");

    bstr("F(0)=0",   BigInt.Fibonacci(0),  "0");
    bstr("F(1)=1",   BigInt.Fibonacci(1),  "1");
    bstr("F(2)=1",   BigInt.Fibonacci(2),  "1");
    bstr("F(3)=2",   BigInt.Fibonacci(3),  "2");
    bstr("F(5)=5",   BigInt.Fibonacci(5),  "5");
    bstr("F(10)=55", BigInt.Fibonacci(10), "55");
    bstr("F(50)",    BigInt.Fibonacci(50), "12586269025");
    bstr("F(100)",   BigInt.Fibonacci(100),
        "354224848179261915075");
    ok("neg fib nil", BigInt.Fibonacci(-1) == nil);
}

// ================================================================
// IsEven / IsOdd
// ================================================================

fn test_iseven_isodd() {
    Console.WriteLine("-- IsEven / IsOdd");

    ok("IsEven(0)",    BigInt.IsEven(BigInt.Zero()));
    ok("IsEven(2)",    BigInt.IsEven(BigInt.From(2)));
    ok("IsEven(-4)",   BigInt.IsEven(BigInt.From(-4)));
    ok("IsEven(big)",  BigInt.IsEven(BigInt.From("123456789012345678")));
    ok("IsOdd(1)",     BigInt.IsOdd(BigInt.From(1)));
    ok("IsOdd(-3)",    BigInt.IsOdd(BigInt.From(-3)));
    ok("IsOdd(big)",   BigInt.IsOdd(BigInt.From("123456789012345679")));
    ok("!IsEven(1)",   !BigInt.IsEven(BigInt.From(1)));
    ok("!IsOdd(2)",    !BigInt.IsOdd(BigInt.From(2)));
}

// ================================================================
// ModPow
// ================================================================

fn test_modpow() {
    Console.WriteLine("-- ModPow");

    // 2^10 mod 1000 = 24
    bstr("2^10 mod 1000",
        BigInt.ModPow(BigInt.From(2), BigInt.From(10), BigInt.From(1000)),
        "24");

    // 3^100 mod 50 = 1
    bstr("3^100 mod 50",
        BigInt.ModPow(BigInt.From(3), BigInt.From(100), BigInt.From(50)),
        "1");

    // Base larger than mod: 17^3 mod 5 = (17 mod 5)^3 mod 5 = 2^3 mod 5 = 3
    bstr("17^3 mod 5",
        BigInt.ModPow(BigInt.From(17), BigInt.From(3), BigInt.From(5)),
        "3");

    // exp = 0: anything^0 mod m = 1 (for m > 1)
    bstr("5^0 mod 7",
        BigInt.ModPow(BigInt.From(5), BigInt.Zero(), BigInt.From(7)),
        "1");

    // RSA-scale: 2^(2^31) mod large prime (just check it runs without crash)
    var bigExp = BigInt.Pow(BigInt.From(2), 31);
    var bigMod = BigInt.From(1000000007);
    ok("RSA-scale runs", BigInt.ModPow(BigInt.From(2), bigExp, bigMod) != nil);

    // mod = 0 returns nil
    ok("ModPow mod=0 nil",
        BigInt.ModPow(BigInt.From(2), BigInt.From(10), BigInt.Zero()) == nil);

    // negative exp returns nil
    ok("ModPow neg exp nil",
        BigInt.ModPow(BigInt.From(2), BigInt.From(-1), BigInt.From(7)) == nil);
}

// ================================================================
// ModInverse
// ================================================================

fn test_modinverse() {
    Console.WriteLine("-- ModInverse");

    // 3 * 4 = 12 ≡ 1 (mod 11) - inverse of 3 mod 11 is 4
    bstr("inv(3, 11) = 4",
        BigInt.ModInverse(BigInt.From(3), BigInt.From(11)),
        "4");

    // inverse of 1 mod m is always 1
    bstr("inv(1, 7) = 1",
        BigInt.ModInverse(BigInt.From(1), BigInt.From(7)),
        "1");

    // inverse of m-1 mod m is always m-1 (since (m-1)^2 = m^2-2m+1 ≡ 1)
    bstr("inv(6, 7) = 6",
        BigInt.ModInverse(BigInt.From(6), BigInt.From(7)),
        "6");

    // gcd(a,m) != 1 - no inverse
    ok("inv(4, 6) nil - gcd=2",
        BigInt.ModInverse(BigInt.From(4), BigInt.From(6)) == nil);

    // m = 0 - nil
    ok("inv(3, 0) nil",
        BigInt.ModInverse(BigInt.From(3), BigInt.Zero()) == nil);

    // Large prime modulus: inverse of 123456789 mod (10^9+7)
    var p  = BigInt.From(1000000007);
    var a  = BigInt.From(123456789);
    var ai = BigInt.ModInverse(a, p);
    ok("inv large: a * inv(a) ≡ 1 (mod p)",
        BigInt.Eq(BigInt.Mod(BigInt.Mul(a, ai), p), BigInt._one()));
}

// ================================================================
// IsPrime
// ================================================================

fn test_isprime() {
    Console.WriteLine("-- IsPrime");

    ok("0 not prime",   !BigInt.IsPrime(BigInt.Zero()));
    ok("1 not prime",   !BigInt.IsPrime(BigInt.One()));
    ok("2 is prime",     BigInt.IsPrime(BigInt.From(2)));
    ok("3 is prime",     BigInt.IsPrime(BigInt.From(3)));
    ok("4 not prime",   !BigInt.IsPrime(BigInt.From(4)));
    ok("5 is prime",     BigInt.IsPrime(BigInt.From(5)));
    ok("97 is prime",    BigInt.IsPrime(BigInt.From(97)));
    ok("100 not prime", !BigInt.IsPrime(BigInt.From(100)));
    ok("561 not prime", !BigInt.IsPrime(BigInt.From(561)));  // Carmichael number

    // Known large primes
    ok("1000000007 prime",  BigInt.IsPrime(BigInt.From(1000000007)));
    ok("998244353 prime",   BigInt.IsPrime(BigInt.From(998244353)));

    // Known composites
    ok("1009*1013 not prime", !BigInt.IsPrime(BigInt.Mul(BigInt.From(1009), BigInt.From(1013))));
    ok("2^32+1 not prime",
        !BigInt.IsPrime(BigInt.Add(BigInt.Pow(BigInt.From(2), 32), BigInt.One())));

    // Mersenne prime: 2^31 - 1 = 2147483647
    ok("2^31-1 prime",
        BigInt.IsPrime(BigInt.Sub(BigInt.Pow(BigInt.From(2), 31), BigInt.One())));
}

// ================================================================
// Lcm
// ================================================================

fn test_lcm() {
    Console.WriteLine("-- Lcm");

    bstr("Lcm(4,6)=12",     BigInt.Lcm(BigInt.From(4),   BigInt.From(6)),   "12");
    bstr("Lcm(12,18)=36",   BigInt.Lcm(BigInt.From(12),  BigInt.From(18)),  "36");
    bstr("Lcm(7,5)=35",     BigInt.Lcm(BigInt.From(7),   BigInt.From(5)),   "35");
    bstr("Lcm(1,n)=n",      BigInt.Lcm(BigInt.One(),      BigInt.From(99)),  "99");
    bstr("Lcm(n,n)=n",      BigInt.Lcm(BigInt.From(42),  BigInt.From(42)),  "42");
    bstr("Lcm(0,5)=0",      BigInt.Lcm(BigInt.Zero(),     BigInt.From(5)),   "0");
    bstr("Lcm(5,0)=0",      BigInt.Lcm(BigInt.From(5),   BigInt.Zero()),    "0");
    // Negatives: result is always non-negative
    bstr("Lcm(-4,6)=12",    BigInt.Lcm(BigInt.From(-4),  BigInt.From(6)),   "12");
    bstr("Lcm(-4,-6)=12",   BigInt.Lcm(BigInt.From(-4),  BigInt.From(-6)),  "12");
}

// ================================================================
// Sqrt
// ================================================================

fn test_sqrt() {
    Console.WriteLine("-- Sqrt");

    bstr("Sqrt(0)=0",        BigInt.Sqrt(BigInt.Zero()),          "0");
    bstr("Sqrt(1)=1",        BigInt.Sqrt(BigInt.One()),           "1");
    bstr("Sqrt(4)=2",        BigInt.Sqrt(BigInt.From(4)),         "2");
    bstr("Sqrt(9)=3",        BigInt.Sqrt(BigInt.From(9)),         "3");
    bstr("Sqrt(16)=4",       BigInt.Sqrt(BigInt.From(16)),        "4");
    bstr("Sqrt(25)=5",       BigInt.Sqrt(BigInt.From(25)),        "5");
    // Non-perfect squares: floor result
    bstr("Sqrt(2)=1",        BigInt.Sqrt(BigInt.From(2)),         "1");
    bstr("Sqrt(3)=1",        BigInt.Sqrt(BigInt.From(3)),         "1");
    bstr("Sqrt(8)=2",        BigInt.Sqrt(BigInt.From(8)),         "2");
    bstr("Sqrt(15)=3",       BigInt.Sqrt(BigInt.From(15)),        "3");
    bstr("Sqrt(99)=9",       BigInt.Sqrt(BigInt.From(99)),        "9");
    bstr("Sqrt(100)=10",     BigInt.Sqrt(BigInt.From(100)),       "10");
    // Large perfect square: 10^12
    bstr("Sqrt(10^12)=10^6",
        BigInt.Sqrt(BigInt.Pow(BigInt.From(10), 12)),
        "1000000");
    // Large non-perfect: floor(sqrt(10^12 + 1)) = 10^6
    bstr("Sqrt(10^12+1)=10^6",
        BigInt.Sqrt(BigInt.Add(BigInt.Pow(BigInt.From(10), 12), BigInt.One())),
        "1000000");
    // Negative returns nil
    ok("Sqrt(-1) nil", BigInt.Sqrt(BigInt.From(-1)) == nil);
}

// ================================================================
// BitLength
// ================================================================

fn test_bitlength() {
    Console.WriteLine("-- BitLength");

    eq("BitLength(0)=0",   BigInt.BitLength(BigInt.Zero()),      0);
    eq("BitLength(1)=1",   BigInt.BitLength(BigInt.One()),       1);
    eq("BitLength(2)=2",   BigInt.BitLength(BigInt.From(2)),     2);
    eq("BitLength(3)=2",   BigInt.BitLength(BigInt.From(3)),     2);
    eq("BitLength(4)=3",   BigInt.BitLength(BigInt.From(4)),     3);
    eq("BitLength(7)=3",   BigInt.BitLength(BigInt.From(7)),     3);
    eq("BitLength(8)=4",   BigInt.BitLength(BigInt.From(8)),     4);
    eq("BitLength(255)=8", BigInt.BitLength(BigInt.From(255)),   8);
    eq("BitLength(256)=9", BigInt.BitLength(BigInt.From(256)),   9);
    // 2^32 needs 33 bits
    eq("BitLength(2^32)=33",
        BigInt.BitLength(BigInt.Pow(BigInt.From(2), 32)),
        33);
    // Negative: same as positive (absolute value)
    eq("BitLength(-8)=4",  BigInt.BitLength(BigInt.From(-8)),    4);
}

// ================================================================
// ToHex / FromHex
// ================================================================

fn test_hex() {
    Console.WriteLine("-- ToHex / FromHex");

    // ToHex
    eq("ToHex(0)",      BigInt.ToHex(BigInt.Zero()),         "0");
    eq("ToHex(1)",      BigInt.ToHex(BigInt.One()),          "1");
    eq("ToHex(15)",     BigInt.ToHex(BigInt.From(15)),       "f");
    eq("ToHex(16)",     BigInt.ToHex(BigInt.From(16)),       "10");
    eq("ToHex(255)",    BigInt.ToHex(BigInt.From(255)),      "ff");
    eq("ToHex(256)",    BigInt.ToHex(BigInt.From(256)),      "100");
    eq("ToHex(65535)",  BigInt.ToHex(BigInt.From(65535)),    "ffff");
    eq("ToHex(-255)",   BigInt.ToHex(BigInt.From(-255)),     "-ff");
    eq("ToHex(16777215)",
        BigInt.ToHex(BigInt.From(16777215)),
        "ffffff");

    // FromHex
    bstr("FromHex('0')=0",      BigInt.FromHex("0"),    "0");
    bstr("FromHex('f')=15",     BigInt.FromHex("f"),    "15");
    bstr("FromHex('10')=16",    BigInt.FromHex("10"),   "16");
    bstr("FromHex('ff')=255",   BigInt.FromHex("ff"),   "255");
    bstr("FromHex('FF')=255",   BigInt.FromHex("FF"),   "255");
    bstr("FromHex('0xff')=255", BigInt.FromHex("0xff"), "255");
    bstr("FromHex('0xFF')=255", BigInt.FromHex("0xFF"), "255");
    bstr("FromHex('-ff')=-255", BigInt.FromHex("-ff"),  "-255");

    // Round-trip: ToHex -> FromHex
    let n = BigInt.From(123456789);
    bstr("round-trip 123456789",
        BigInt.FromHex(BigInt.ToHex(n)),
        "123456789");

    let nbig = BigInt.From("9999999999999999999999");
    bstr("round-trip big",
        BigInt.FromHex(BigInt.ToHex(nbig)),
        "9999999999999999999999");
}

// ================================================================
// Bitwise
// ================================================================

fn test_bitwise() {
    Console.WriteLine("\n-- Bitwise --");

    bstr("12 & 10", BigInt.And(BigInt.From(12), BigInt.From(10)), "8");
    bstr("12 | 10", BigInt.Or(BigInt.From(12), BigInt.From(10)),  "14");
    bstr("12 ^ 10", BigInt.Xor(BigInt.From(12), BigInt.From(10)), "6");
    bstr("0xF0 & 0x0F", BigInt.And(BigInt.From(240), BigInt.From(15)), "0");
    bstr("~12", BigInt.Not(BigInt.From(12)), "-13");
    bstr("~0",  BigInt.Not(BigInt.From(0)),  "-1");

    bstr("1 << 8",   BigInt.Shl(BigInt.From(1), 8),   "256");
    bstr("1 << 100", BigInt.Shl(BigInt.From(1), 100), "1267650600228229401496703205376");
    bstr("5 << 0",   BigInt.Shl(BigInt.From(5), 0),   "5");
    bstr("1024 >> 3", BigInt.Shr(BigInt.From(1024), 3), "128");
    bstr("(1<<100)>>100", BigInt.Shr(BigInt.Shl(BigInt.From(1), 100), 100), "1");
    bstr("7 >> 10",  BigInt.Shr(BigInt.From(7), 10), "0");
    ok("Shl negative -> nil", BigInt.Shl(BigInt.From(5), -1) == nil);
    ok("Shr negative -> nil", BigInt.Shr(BigInt.From(5), -1) == nil);

    // Large-number bitwise: (2^64 - 1) & 2^32 == 2^32
    let mask64 = BigInt.Sub(BigInt.Shl(BigInt.From(1), 64), BigInt.From(1));
    beq("(2^64-1) & 2^32", BigInt.And(mask64, BigInt.Shl(BigInt.From(1), 32)),
        BigInt.Shl(BigInt.From(1), 32));
    // OR of disjoint high/low bits reconstructs the sum
    beq("2^100 | 1", BigInt.Or(BigInt.Shl(BigInt.From(1), 100), BigInt.From(1)),
        BigInt.Add(BigInt.Shl(BigInt.From(1), 100), BigInt.From(1)));
    // XOR with itself is zero
    bstr("x ^ x", BigInt.Xor(BigInt.From("123456789012345"), BigInt.From("123456789012345")), "0");

    ok("TestBit(2^100, 100)", BigInt.TestBit(BigInt.Shl(BigInt.From(1), 100), 100));
    ok("TestBit(2^100, 99) false", !BigInt.TestBit(BigInt.Shl(BigInt.From(1), 100), 99));
    ok("TestBit(13, 0)", BigInt.TestBit(BigInt.From(13), 0));   // 1101
    ok("TestBit(13, 1) false", !BigInt.TestBit(BigInt.From(13), 1));
    ok("TestBit(13, 2)", BigInt.TestBit(BigInt.From(13), 2));
}

// ================================================================
// Byte conversion
// ================================================================

fn test_bytes() {
    Console.WriteLine("\n-- Bytes --");

    // 0x123456789 = 4886718345 -> [0x01,0x23,0x45,0x67,0x89] big-endian
    let n = BigInt.From("4886718345");
    let be = BigInt.ToBytes(n, false);
    eq("ToBytes BE length", len(be), 5);
    eq("ToBytes BE[0]", be[0], 1);
    eq("ToBytes BE[1]", be[1], 35);
    eq("ToBytes BE[4]", be[4], 137);
    bstr("FromBytes(BE)", BigInt.FromBytes(be, false), "4886718345");

    let le = BigInt.ToBytes(n, true);
    eq("ToBytes LE[0]", le[0], 137);
    bstr("FromBytes(LE)", BigInt.FromBytes(le, true), "4886718345");

    // explicit big-endian array
    bstr("FromBytes([1,255])", BigInt.FromBytes([1, 255], false), "511");
    bstr("FromBytes([255,1] LE)", BigInt.FromBytes([255, 1], true), "511");

    // zero
    eq("ToBytes(0) length", len(BigInt.ToBytes(BigInt.From(0), false)), 1);
    eq("ToBytes(0)[0]", BigInt.ToBytes(BigInt.From(0), false)[0], 0);
    bstr("FromBytes([0])", BigInt.FromBytes([0], false), "0");

    // round-trip a large random-ish number both endian
    let big = BigInt.From("987654321098765432109876543210");
    bstr("BE round-trip", BigInt.FromBytes(BigInt.ToBytes(big, false), false),
         "987654321098765432109876543210");
    bstr("LE round-trip", BigInt.FromBytes(BigInt.ToBytes(big, true), true),
         "987654321098765432109876543210");

    // sign is not encoded (magnitude only)
    bstr("ToBytes ignores sign", BigInt.FromBytes(BigInt.ToBytes(BigInt.From(-255), false), false), "255");
}


// ---------------------------------------------------------------
// Base conversion across limb boundaries
//
// ToHex/ToBytes/FromHex/FromBytes are built on limb-level short division and
// short multiplication rather than the general DivMod/Mul. That is far faster
// but it is also where an off-by-one in the carry would hide, so these walk
// the powers of the 10^8 limb base and round-trip a long run of widths.
// ---------------------------------------------------------------

fn test_base_conversion() {
    Console.WriteLine("-- base conversion across limb boundaries");

    // Exactly at, either side of, and two limbs past the base.
    eq("ToHex(99999999)",         BigInt.ToHex(BigInt.From("99999999")),         "5f5e0ff");
    eq("ToHex(100000000)",        BigInt.ToHex(BigInt.From("100000000")),        "5f5e100");
    eq("ToHex(100000001)",        BigInt.ToHex(BigInt.From("100000001")),        "5f5e101");
    eq("ToHex(9999999999999999)", BigInt.ToHex(BigInt.From("9999999999999999")), "2386f26fc0ffff");
    eq("ToHex(10^16)",            BigInt.ToHex(BigInt.From("10000000000000000")), "2386f26fc10000");
    eq("ToHex(999999)",           BigInt.ToHex(BigInt.From("999999")),           "f423f");
    eq("ToHex(1000000000000)",    BigInt.ToHex(BigInt.From("1000000000000")),    "e8d4a51000");

    bstr("FromHex round-trips the base",  BigInt.FromHex("5f5e100"),        "100000000");
    bstr("FromHex round-trips two limbs", BigInt.FromHex("2386f26fc10000"), "10000000000000000");

    // Big-endian byte layout, checked against a value whose bytes are 1,2,3,4.
    let b = BigInt.ToBytes(BigInt.From(16909060));
    eq("ToBytes length",  len(b), 4);
    eq("ToBytes[0]",      b[0],   1);
    eq("ToBytes[3]",      b[3],   4);
    let l = BigInt.ToBytes(BigInt.From(16909060), true);
    eq("ToBytes LE[0]",   l[0],   4);
    eq("ToBytes LE[3]",   l[3],   1);

    // Round-trip every width from 1 to 200 digits through both encodings.
    var hexBad = 0; var beBad = 0; var leBad = 0;
    iter (d from 1 to 201) {
        var dec = "";
        iter (i from 0 to d) { dec = dec + str((i * 7 + 3) % 10); }
        while (len(dec) > 1 && String.StartsWith(dec, "0")) { dec = String.Substr(dec, 1); }
        let v = BigInt.From(dec);
        if (BigInt.ToString(BigInt.FromHex(BigInt.ToHex(v)))                 != dec) { hexBad += 1; }
        if (BigInt.ToString(BigInt.FromBytes(BigInt.ToBytes(v)))             != dec) { beBad  += 1; }
        if (BigInt.ToString(BigInt.FromBytes(BigInt.ToBytes(v, true), true)) != dec) { leBad  += 1; }
    }
    eq("hex round-trip, widths 1-200",           hexBad, 0);
    eq("big-endian round-trip, widths 1-200",    beBad,  0);
    eq("little-endian round-trip, widths 1-200", leBad,  0);

    // A 2048-bit-scale value: the size these conversions are used for in practice.
    var big = "";
    iter (i from 0 to 617) { big = big + str((i * 3 + 1) % 10); }
    while (len(big) > 1 && String.StartsWith(big, "0")) { big = String.Substr(big, 1); }
    let n = BigInt.From(big);
    let t0 = Time.Ticks();
    let h = BigInt.ToHex(n);
    let dt = Time.TicksToMs(Time.Ticks() - t0);
    eq("617-digit hex round-trips", BigInt.ToString(BigInt.FromHex(h)), big);
    ok("617-digit ToHex under 500 ms", dt < 500.0);
}

// ================================================================
// Reference-value helpers
//
// Large operands come from a small linear congruential generator, so the
// tests need no long literals. The expected values were computed with
// Python's int and are compared through the first 16 hex digits of the
// SHA-256 of the decimal string.
// ================================================================

fn genDigits(seed: int, n: int, lead: int): string {
    let parts = Array.Create(n);
    var x = seed;
    iter (i from 0 to n) {
        x = (x * 1103515245 + 12345) % 2147483648;
        var d = (x >> 16) % 10;
        if (i == 0) {
            if (lead > 0) { d = lead; } else if (d == 0) { d = 7; }
        }
        parts[i] = str(d);
    }
    return String.Join(parts, "");
}

fn gen(seed: int, n: int, neg: bool, lead: int) {
    let v = BigInt.From(genDigits(seed, n, lead));
    return neg ? BigInt.Neg(v) : v;
}

fn h(x): string {
    if (x == nil) { return "nil"; }
    return String.Left(Hash.Sha256(BigInt.ToString(x)), 16);
}

fn big(name, x, want) { eq(name, h(x), want); }

fn checkPair(label: string, a, b, want) {
    let dm = BigInt.DivMod(a, b);
    eq(label + " Mul",      h(BigInt.Mul(a, b)),      want[0]);
    eq(label + " Add",      h(BigInt.Add(a, b)),      want[1]);
    eq(label + " Sub",      h(BigInt.Sub(a, b)),      want[2]);
    eq(label + " Div",      h(BigInt.Div(a, b)),      want[3]);
    eq(label + " Mod",      h(BigInt.Mod(a, b)),      want[4]);
    eq(label + " FloorDiv", h(BigInt.FloorDiv(a, b)), want[5]);
    eq(label + " FloorMod", h(BigInt.FloorMod(a, b)), want[6]);
    eq(label + " DivMod",   h(dm.q) + h(dm.r),        want[3] + want[4]);
}

fn divCase(u: string, v: string, q: string, r: string) {
    let a = BigInt.From(u); let b = BigInt.From(v);
    bstr("Div " + u + " / " + v, BigInt.Div(a, b), q);
    bstr("Mod " + u + " % " + v, BigInt.Mod(a, b), r);
}

fn mpCase(label: string, b, e, m, want: string) {
    eq("ModPow " + label, h(BigInt.ModPow(b, e, m)), want);
}

// ================================================================
// Parsing, radix conversion and int range
// ================================================================

fn test_parse_radix() {
    Console.WriteLine("-- Parse / radix / ToInt range");

    bstr("From('0x1F')",          BigInt.From("0x1F"),      "31");
    bstr("From('-0x1f')",         BigInt.From("-0x1f"),     "-31");
    bstr("From('0b101')",         BigInt.From("0b101"),     "5");
    bstr("From('0o17')",          BigInt.From("0o17"),      "15");
    bstr("From('+42')",           BigInt.From("+42"),       "42");
    bstr("From malformed '1-12345' is 0", BigInt.From("1-12345"), "0");
    bstr("From malformed '12 345' is 0",  BigInt.From("12 345"),  "0");
    bstr("From('-') is 0",        BigInt.From("-"),         "0");
    bstr("From(Int64Min)",        BigInt.From(-9223372036854775807 - 1), "-9223372036854775808");

    bstr("Parse decimal",         BigInt.Parse("-123456789012345678901234567890"), "-123456789012345678901234567890");
    bstr("Parse('ff', 16)",       BigInt.Parse("ff", 16),   "255");
    bstr("Parse('FF', 16)",       BigInt.Parse("FF", 16),   "255");
    bstr("Parse('zz', 36)",       BigInt.Parse("zz", 36),   "1295");
    bstr("Parse('-7fffffffffffffff', 16)", BigInt.Parse("-7fffffffffffffff", 16), "-9223372036854775807");
    ok("Parse('1-12345') nil",    BigInt.Parse("1-12345") == nil);
    ok("Parse('12a') nil",        BigInt.Parse("12a") == nil);
    ok("Parse('') nil",           BigInt.Parse("") == nil);
    ok("Parse('0x1f') nil (no prefix)", BigInt.Parse("0x1f", 16) == nil);
    ok("Parse('19', 8) nil",      BigInt.Parse("19", 8) == nil);
    ok("Parse base 1 nil",        BigInt.Parse("1", 1) == nil);
    ok("Parse base 37 nil",       BigInt.Parse("1", 37) == nil);

    eq("ToString(255, 2)",        BigInt.ToString(BigInt.From(255), 2),   "11111111");
    eq("ToString(-255, 16)",      BigInt.ToString(BigInt.From(-255), 16), "-ff");
    eq("ToString(0, 7)",          BigInt.ToString(BigInt.Zero(), 7),      "0");
    eq("ToString(1295, 36)",      BigInt.ToString(BigInt.From(1295), 36), "zz");
    eq("ToString(n, 10)",         BigInt.ToString(BigInt.From(-1234), 10), "-1234");
    ok("ToString base 1 nil",     BigInt.ToString(BigInt.From(5), 1) == nil);

    eq("ToInt(10^18)",            BigInt.ToInt(BigInt.From("1000000000000000000")), 1000000000000000000);
    eq("ToInt(2^63-1)",           BigInt.ToInt(BigInt.From("9223372036854775807")), 9223372036854775807);
    eq("ToInt(-2^63)",            BigInt.ToInt(BigInt.From("-9223372036854775808")), -9223372036854775807 - 1);
    eq("ToInt(-10^17-3)",         BigInt.ToInt(BigInt.From("-100000000000000003")), -100000000000000003);
    ok("ToInt(2^63) nil",         BigInt.ToInt(BigInt.From("9223372036854775808")) == nil);
    ok("ToInt(-2^63-1) nil",      BigInt.ToInt(BigInt.From("-9223372036854775809")) == nil);

    // Every base, round trip through a 300-digit value.
    let n = gen(89, 300, true, 0);
    var bad = 0;
    iter (b from 2 to 37) {
        if (!BigInt.Eq(BigInt.Parse(BigInt.ToString(n, b), b), n)) { bad += 1; }
    }
    eq("radix round trip, bases 2-36", bad, 0);
    eq("ToString(n, 2)",  String.Left(Hash.Sha256(BigInt.ToString(n, 2)), 16),  "b947be98a0dfdc31");
    eq("ToString(n, 3)",  String.Left(Hash.Sha256(BigInt.ToString(n, 3)), 16),  "38292d8ddfd93da4");
    eq("ToString(n, 7)",  String.Left(Hash.Sha256(BigInt.ToString(n, 7)), 16),  "07d5aeec0dfdd1d3");
    eq("ToString(n, 16)", String.Left(Hash.Sha256(BigInt.ToString(n, 16)), 16), "b65a37a0d11e83f5");
    eq("ToString(n, 36)", String.Left(Hash.Sha256(BigInt.ToString(n, 36)), 16), "4e9d6fa4bf9c2a03");

    var hex = "";
    let hd = "0123456789abcdefABCDEF";
    iter (i from 0 to 500) { hex = hex + String.Substr(hd, (i * 7 + 3) % 22, 1); }
    big("Parse 500 hex digits", BigInt.Parse(hex, 16), "12922c5f8a1f719f");
    big("FromHex 500 hex digits", BigInt.FromHex("0x" + hex), "12922c5f8a1f719f");
}

// ================================================================
// Division signs: Div/Mod truncate, FloorDiv/FloorMod round down
// ================================================================

fn test_division_signs() {
    Console.WriteLine("-- division signs");

    let cases = [[7, 3, 2, 1, 2, 1], [7, -3, -2, 1, -3, -2], [-7, 3, -2, -1, -3, 2],
                 [-7, -3, 2, -1, 2, -1], [-6, 3, -2, 0, -2, 0], [-6, -3, 2, 0, 2, 0]];
    foreach (c in cases) {
        let a = BigInt.From(c[0]); let b = BigInt.From(c[1]);
        let tag = str(c[0]) + "," + str(c[1]);
        bstr("Div(" + tag + ")",      BigInt.Div(a, b),      str(c[2]));
        bstr("Mod(" + tag + ")",      BigInt.Mod(a, b),      str(c[3]));
        bstr("FloorDiv(" + tag + ")", BigInt.FloorDiv(a, b), str(c[4]));
        bstr("FloorMod(" + tag + ")", BigInt.FloorMod(a, b), str(c[5]));
    }
    ok("FloorDiv by zero nil", BigInt.FloorDiv(BigInt.One(), BigInt.Zero()) == nil);
    ok("FloorMod by zero nil", BigInt.FloorMod(BigInt.One(), BigInt.Zero()) == nil);
    let dm = BigInt.DivMod(BigInt.From(-7), BigInt.From(3));
    bstr("DivMod(-7,3).q", dm.q, "-2");
    bstr("DivMod(-7,3).r", dm.r, "-1");
    bstr("Shr(-5, 1) truncates", BigInt.Shr(BigInt.From(-5), 1), "-2");
}

// ================================================================
// Large operands against reference values
// ================================================================

fn test_large_reference() {
    Console.WriteLine("-- large operands against reference values");

    // Schoolbook, Karatsuba on equal and uneven lengths, one-limb and
    // multi-limb divisors (a small top limb needs the largest scaling in
    // Algorithm D, a large one none), and a divisor longer than the dividend.
    // Expected: Mul, Add, Sub, Div, Mod, FloorDiv, FloorMod.
    checkPair("30 by 20 digits", gen(11, 30, false, 0), gen(12, 20, false, 0), ["3d501f88eeb59ebc", "af6cbf9071aa1455", "0931164105e8f5f8", "e759ab8d6d396693", "850515fc5befe307", "e759ab8d6d396693", "850515fc5befe307"]);
    checkPair("200 by 7 (one-limb divisor)", gen(13, 200, true, 0), gen(14, 7, false, 0), ["2686e0b4504260d4", "abec169126fb7553", "f8cec2d39eeb5825", "3f65c2b312084701", "c8f20373e5e27360", "523872700f4fa1eb", "ed57335219935676"]);
    checkPair("1100 by 1100 (Karatsuba)", gen(15, 1100, true, 0), gen(16, 1100, false, 0), ["7ede850ea1bd3568", "90c2dd81a6351301", "0f940d26fc4986d7", "5feceb66ffc86f38", "134b1a373996a60e", "1bad6b8cf97131fc", "90c2dd81a6351301"]);
    checkPair("2600 by 1030 (uneven)", gen(17, 2600, false, 0), gen(18, 1030, true, 0), ["60199eb852e084c3", "7e9d95f745a20fd5", "f7e188df4a781567", "0988e159a54300ac", "de2aa92d0a938090", "8876e05a6052baf2", "ab86c2fa52c2d79d"]);
    checkPair("6500 by 1700 (uneven, long tail)", gen(19, 6500, true, 0), gen(20, 1700, true, 0), ["22c5a64fc63264f1", "3020cc86781df5d6", "6824407b34a99608", "9f5a408f2513da21", "ebd1ae0c6343c528", "9f5a408f2513da21", "ebd1ae0c6343c528"]);
    checkPair("2001 by 993 (small top limb)", gen(21, 2001, false, 0), gen(22, 993, false, 1), ["f4266a5fff6dffaf", "1d1d8f1f2c5e76cc", "76e617047500b9a4", "f71b627aa52ea67d", "da2347a80333109e", "f71b627aa52ea67d", "da2347a80333109e"]);
    checkPair("2001 by 992 (large top limb)", gen(23, 2001, true, 0), gen(24, 992, false, 9), ["194c74b46bb8e1a1", "5b6fd8eee56b8c84", "3766927717d5542d", "c92d23b0bfb6ab0a", "437f68c93a710bd2", "347ff2285c9344f7", "d6d84596a553bb4a"]);
    checkPair("500 by 800 (divisor longer)", gen(25, 500, false, 0), gen(26, 800, true, 0), ["7a710058adfe454e", "c203eaa411b947f0", "699c44f75c43d537", "5feceb66ffc86f38", "f1ae0e3747f3c2d0", "1bad6b8cf97131fc", "c203eaa411b947f0"]);

    let x = gen(31, 1500, false, 0);
    let y = gen(32, 1400, true, 0);
    big("exact division (x*y)/y", BigInt.Div(BigInt.Mul(x, y), y), "f6205538a18c80aa");
    bstr("exact division remainder", BigInt.Mod(BigInt.Mul(x, y), y), "0");

    // Quotient limbs whose first estimate passes the two-limb test yet is one
    // too large, so Algorithm D has to add the divisor back (step D6). Found
    // by searching with a Python model of the same algorithm; the last case
    // puts that step at the top of a longer division.
    divCase("35970477155873724408237282140057", "991696769999999899999999", "36271648", "991696768035402118411705");
    divCase("8599552898213275394607578837278933957506", "87126038999999989907261912253286", "98702442", "87126038390785474564289883233094");
    divCase("156483503567365449203372451", "5709999999903866755", "27405166", "5709999996740716121");
    divCase("53911147805122423004671821", "5156857810552730829", "10454262", "5156857810102828623");
    divCase("359704771558737244082372821400582345678901234567", "991696769999999899999999", "362716489999999980189531", "303602200364631981424098");

    // Both ModPow paths (Montgomery for moduli coprime to 10 up to 512 limbs,
    // square-and-multiply otherwise), moduli of 4 to 7 limbs, a one-limb
    // modulus and a negative base.
    mpCase("even modulus", gen(70, 400, true, 0), gen(71, 60, false, 0), gen(42, 150, false, 0), "1aacb9154afdd76c");
    mpCase("modulus ending in 5", gen(70, 400, true, 0), gen(71, 60, false, 0), gen(55, 150, false, 0), "e57970fdaca5a8e7");
    mpCase("32-digit odd modulus", gen(70, 400, true, 0), gen(71, 60, false, 0), gen(95, 32, false, 0), "1f7d5ab68bc1f542");
    mpCase("40-digit odd modulus", gen(70, 400, true, 0), gen(71, 60, false, 0), gen(161, 40, false, 0), "d74cc679c0099f2c");
    mpCase("48-digit odd modulus", gen(70, 400, true, 0), gen(71, 60, false, 0), gen(109, 48, false, 0), "890478deff32c1c8");
    mpCase("56-digit odd modulus", gen(70, 400, true, 0), gen(71, 60, false, 0), gen(118, 56, false, 0), "f35928746fd0fd64");
    mpCase("one-limb modulus", gen(70, 400, true, 0), gen(71, 60, false, 0), gen(90, 7, false, 0), "26727c7a639d3938");
    mpCase("4200-digit odd modulus", gen(70, 400, true, 0), gen(72, 15, false, 0), gen(95, 4200, false, 0), "8f9d3c09fa4af63a");
    let m521 = BigInt.Sub(BigInt.Pow(BigInt.From(2), 521), BigInt.One());
    mpCase("2^521-1, 300-digit exponent", gen(74, 100, false, 0), gen(73, 300, false, 0), m521, "fbdb1a869934bdd0");
    let m1024 = BigInt.Sub(BigInt.Pow(BigInt.From(2), 1024), BigInt.From(105));
    mpCase("2^1024-105, exponent 2^1023-1", BigInt.From(65537), BigInt.Sub(BigInt.Pow(BigInt.From(2), 1023), BigInt.One()), m1024, "f4f6891f21afeb94");
    mpCase("negative modulus", gen(75, 50, true, 0), gen(76, 40, false, 0), gen(77, 45, true, 0), "fae8a20e173f44bf");
    bstr("ModPow exp 0", BigInt.ModPow(gen(75, 50, false, 0), BigInt.Zero(), m521), "1");
    bstr("ModPow mod 1", BigInt.ModPow(gen(75, 50, false, 0), BigInt.From(5), BigInt.One()), "0");

    big("Sqrt of a 3001-digit value", BigInt.Sqrt(gen(80, 3001, false, 0)), "a908959f63d98230");
    let r = gen(81, 900, false, 0);
    big("Sqrt of a perfect square", BigInt.Sqrt(BigInt.Mul(r, r)), "3e15237784cff5aa");
    let g = gen(82, 300, false, 0);
    big("Gcd of 1000-digit values", BigInt.Gcd(BigInt.Mul(gen(83, 700, false, 0), g), BigInt.Mul(gen(84, 650, false, 0), g)), "d02dcacc13677d86");
    big("ModInverse mod 2^521-1", BigInt.ModInverse(gen(85, 150, false, 0), m521), "7241eb3aaced813f");
    eq("BitLength of a 1000-digit value", BigInt.BitLength(gen(86, 1000, false, 0)), 3321);
    let p = gen(87, 700, false, 0); let q = gen(88, 500, false, 0);
    big("And of large values", BigInt.And(p, q), "ed5df195f1f10c4f");
    big("Or of large values",  BigInt.Or(p, q),  "40a0dc06551e8f81");
    big("Xor of large values", BigInt.Xor(p, q), "f45a56e69ee943f8");
    big("Shl by 333",          BigInt.Shl(gen(92, 100, false, 0), 333), "8bf194de6d0f941d");
    big("Shr of a negative by 777", BigInt.Shr(gen(93, 300, true, 0), 777), "240c3807c5f56f7f");
    let tb = gen(94, 200, false, 0);
    let bits = [0, 1, 31, 32, 33, 500, 663, 664, 700];
    let want = [0, 0, 1, 1, 1, 1, 1, 0, 0];
    var tbBad = 0;
    iter (i from 0 to len(bits)) { if (BigInt.TestBit(tb, bits[i]) != (want[i] == 1)) { tbBad += 1; } }
    eq("TestBit across word boundaries", tbBad, 0);
    let bb = gen(91, 400, false, 0);
    let bytes = BigInt.ToBytes(bb);
    eq("ToBytes length of a 400-digit value", len(bytes), 167);
    eq("ToBytes first byte", bytes[0], 1);
    eq("ToBytes last byte", bytes[166], 162);
    ok("FromBytes round trip", BigInt.Eq(BigInt.FromBytes(bytes), bb));
    ok("FromBytes little-endian round trip", BigInt.Eq(BigInt.FromBytes(BigInt.ToBytes(bb, true), true), bb));

    big("Factorial(1000)", BigInt.Factorial(1000), "cc336cf135d690c1");
    big("Fibonacci(10000)", BigInt.Fibonacci(10000), "e9c83559a05641cf");
    big("Pow(120-digit, 37)", BigInt.Pow(gen(90, 120, false, 0), 37), "e7741d62c226a7ed");

    ok("2^127-1 prime", BigInt.IsPrime(BigInt.Sub(BigInt.Pow(BigInt.From(2), 127), BigInt.One())));
    ok("2^521-1 prime", BigInt.IsPrime(m521));
    ok("strong pseudoprime to bases 2-23 is composite", !BigInt.IsPrime(BigInt.From("3825123056546413051")));
    ok("strong pseudoprime to bases 2-37 is composite", !BigInt.IsPrime(BigInt.From("318665857834031151167461")));
    ok("negative not prime", !BigInt.IsPrime(BigInt.From(-7)));
}

// ================================================================
// Main
// ================================================================

fn Main() {
    Console.WriteLine("=== BigInt test suite ===");

    test_construction();
    test_toint();
    test_comparison();
    test_neg_abs();
    test_add();
    test_sub();
    test_mul();
    test_div_mod();
    test_pow();
    test_gcd();
    test_factorial();
    test_fibonacci();
    test_iseven_isodd();
    test_modpow();
    test_modinverse();
    test_isprime();
    test_lcm();
    test_sqrt();
    test_bitlength();
    test_hex();
    test_base_conversion();
    test_bitwise();
    test_bytes();
    test_parse_radix();
    test_division_signs();
    test_large_reference();

    Console.WriteLine("");
    Console.WriteLine("Results: " + Convert.ToString(passed) + " passed, " + Convert.ToString(failed) + " failed.");
    if (failed > 0) {
        Console.Error("Some BigInt tests FAILED.");
        return 1;
    }
    Console.Ok("All BigInt tests passed!");

    // ── pre-computed values (reused across bench calls) ──────────────────
    let bi_a   = BigInt.From(123456789);
    let bi_b   = BigInt.From(987654321);
    let bi_med = BigInt.From("12345678901234567890");
    let bi_big = BigInt.From("99999999999999999999999999999999999999999999999999");
    let bi_two = BigInt.From(2);
    let bi_prm = BigInt.From(1000000007);

    Console.WriteLine("\n\n=== BigInt Benchmarks ===");
    Console.WriteLine(String.PadRight("benchmark", 48), String.PadLeft("total", 9), "      ", String.PadLeft("µs/call", 11));
    benchSep();

    Console.WriteLine("\n[ Construction ]");
    bench("From  small int (123456789)", fn() {
        let v = BigInt.From(123456789); _sink = _sink + 1;
    }, 2000);
    bench("From  large string (50 digits)", fn() {
        let v = BigInt.From("99999999999999999999999999999999999999999999999999");
        _sink = _sink + 1;
    }, 500);

    Console.WriteLine("\n[ Arithmetic - small numbers ]");
    bench("Add   small + small", fn() {
        let r = BigInt.Add(bi_a, bi_b); _sink = _sink + 1;
    }, 2000);
    bench("Mul   small × small", fn() {
        let r = BigInt.Mul(bi_a, bi_b); _sink = _sink + 1;
    }, 1000);
    bench("Gcd   small, small", fn() {
        let r = BigInt.Gcd(bi_a, bi_b); _sink = _sink + 1;
    }, 1000);

    Console.WriteLine("\n[ Arithmetic - 20-digit numbers ]");
    bench("Add   20-digit + 20-digit", fn() {
        let r = BigInt.Add(bi_med, bi_med); _sink = _sink + 1;
    }, 1000);
    bench("Mul   20-digit × 20-digit", fn() {
        let r = BigInt.Mul(bi_med, bi_med); _sink = _sink + 1;
    }, 300);

    Console.WriteLine("\n[ Other ]");
    bench("Pow   2^64", fn() {
        let r = BigInt.Pow(bi_two, 64); _sink = _sink + 1;
    }, 100);
    bench("ToString  50-digit", fn() {
        let s = BigInt.ToString(bi_big); _sink = _sink + 1;
    }, 1000);
    bench("IsPrime  1000000007 (prime)", fn() {
        let b = BigInt.IsPrime(bi_prm); _sink = _sink + 1;
    }, 20);
    bench("Lcm   small, small", fn() {
        let r = BigInt.Lcm(bi_a, bi_b); _sink = _sink + 1;
    }, 1000);
    bench("Sqrt  small (987654321)", fn() {
        let r = BigInt.Sqrt(bi_b); _sink = _sink + 1;
    }, 200);
    bench("BitLength  50-digit", fn() {
        let r = BigInt.BitLength(bi_big); _sink = _sink + 1;
    }, 500);
    bench("ToHex  50-digit", fn() {
        let s = BigInt.ToHex(bi_big); _sink = _sink + 1;
    }, 200);

    let bl_a   = gen(15, 1100, false, 0);
    let bl_b   = gen(16, 1100, false, 0);
    let bl_n   = gen(21, 2001, false, 0);
    let bl_d   = gen(22, 1000, false, 0);
    let bl_m   = BigInt.Sub(BigInt.Pow(BigInt.From(2), 1024), BigInt.From(105));
    let bl_e   = BigInt.Sub(BigInt.Pow(BigInt.From(2), 1023), BigInt.One());
    let bl_g   = BigInt.From(65537);

    Console.WriteLine("\n[ Large numbers ]");
    bench("Mul   1100 × 1100 digits (Karatsuba)", fn() {
        let r = BigInt.Mul(bl_a, bl_b); _sink = _sink + 1;
    }, 50);
    bench("Div   2001 / 1000 digits", fn() {
        let r = BigInt.Div(bl_n, bl_d); _sink = _sink + 1;
    }, 50);
    bench("ModPow 1024-bit modulus, 1023-bit exponent", fn() {
        let r = BigInt.ModPow(bl_g, bl_e, bl_m); _sink = _sink + 1;
    }, 5);
    bench("Factorial(1000)", fn() {
        let r = BigInt.Factorial(1000); _sink = _sink + 1;
    }, 20);
    bench("ToString 2001 digits, base 16", fn() {
        let s = BigInt.ToString(bl_n, 16); _sink = _sink + 1;
    }, 20);

    benchSep();
    Console.WriteLine("_sink=" + str(_sink));
    return 0;
}
