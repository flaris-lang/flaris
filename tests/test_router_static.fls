// test_router_static.fls
// Static file serving + CORS. Run via tests/test_router_static.sh, which sets
// up the web root, starts this server, then drives it with curl.
//
//   flarisvm --unsafe ./tests/test_router_static.fls --libs='./libs'

import { Router, Response, CorsMiddleware }
    from library("Router", "1.0");

global app = nil;

fn Main() {
    app = new Router();

    // CORS with a specific origin + credentials + an exposed header. Every
    // response must carry these headers - which only works because the builtin
    // HTTP server now emits all of resp.headers, not just Content-Type.
    global corsMw = new CorsMiddleware("https://app.example.com", {
        credentials:   true,
        exposeHeaders: "X-Total-Count"
    });
    app.Use(fn(req, next) { return corsMw.Handle(req, next); });

    app.Get("/api/ping", fn(_req) {
        return Response.Json({ pong: true }, nil);
    });

    // Mount the web root prepared by the .sh harness at /static.
    app.Static("/static", "/tmp/flaris_static_test", {
        cacheControl: "public, max-age=60"
    });

    VM.OnSignal(2, fn(a) {
        app.Stop();
        return 0;
    });

    Console.WriteLine("Static server on http://localhost:8091");
    app.Listen(8091);
}
