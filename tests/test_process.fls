// test_process.fls - Test suite for Process.fls
// Run: flarisvm tests/test_process.fls --libs='./libs'

import { Run, Shell, Spawn, Start, RunAsync, StartAsync, WaitTimeout } from library("Process", "1.0");

global passed = 0;
global failed = 0;

fn check(label: string, cond: bool) {
    if (cond) {
        passed = passed + 1;
    } else {
        failed = failed + 1;
        Console.WriteLine("[FAIL] " + label);
    }
}

// ============================================================

fn test_run_basic() {
    Console.WriteLine("--- 1. Run basic ---");
    let r = Run("echo", ["hello"]);
    check("Run returns object",       r != nil);
    check("Run exit 0",               r.Exit == 0);
    check("Run stdout has text",      String.IndexOf(r.Stdout, "hello") >= 0);
    check("Run stderr empty",         r.Stderr == "");
}

fn test_run_nonzero() {
    Console.WriteLine("--- 2. Run non-zero exit ---");
    let r = Run("ls", ["/path_that_does_not_exist_xyz"]);
    check("Run non-zero exit != 0",   r.Exit != 0);
    check("Run stderr not empty",     String.Length(r.Stderr) > 0);
    check("Run stdout empty",         r.Stdout == "");
}

fn test_run_not_found() {
    Console.WriteLine("--- 3. Run command not found ---");
    let r = Run("__cmd_that_does_not_exist__");
    check("Run no-cmd exit 127",      r.Exit == 127);
}

fn test_shell_basic() {
    Console.WriteLine("--- 4. Shell basic ---");
    let r = Shell("echo shelltest");
    check("Shell exit 0",             r.Exit == 0);
    check("Shell stdout has output",  String.IndexOf(r.Stdout, "shelltest") >= 0);
}

fn test_shell_pipeline() {
    Console.WriteLine("--- 5. Shell pipeline ---");
    let r = Shell("printf 'a\\nb\\nc\\n' | wc -l");
    check("Shell pipeline exit 0",    r.Exit == 0);
    check("Shell pipeline count 3",   String.IndexOf(r.Stdout, "3") >= 0);
}

fn test_spawn_readline() {
    Console.WriteLine("--- 6. Spawn ReadLine ---");
    let p = Spawn("printf", ["line1\\nline2\\nline3\\n"]);
    check("Spawn returns Process",    p != nil);
    let l1 = p.ReadLine();
    let l2 = p.ReadLine();
    let l3 = p.ReadLine();
    let l4 = p.ReadLine();
    check("ReadLine l1",              l1 == "line1");
    check("ReadLine l2",              l2 == "line2");
    check("ReadLine l3",              l3 == "line3");
    check("ReadLine EOF is nil",      l4 == nil);
    p.Close();
}

fn test_spawn_stdin() {
    Console.WriteLine("--- 7. Spawn stdin/stdout ---");
    let p = Spawn("cat");
    p.Write("alpha\n");
    p.Write("beta\n");
    p.CloseStdin();
    let a = p.ReadLine();
    let b = p.ReadLine();
    let c = p.ReadLine();
    check("Write+ReadLine a",         a == "alpha");
    check("Write+ReadLine b",         b == "beta");
    check("Write+ReadLine EOF nil",   c == nil);
    p.Close();
}

fn test_spawn_wait() {
    Console.WriteLine("--- 8. Spawn Wait + exit code ---");
    let p = Spawn("sh", ["-c", "exit 42"]);
    let code = p.Wait();
    check("Wait exit code 42",        code == 42);
    check("IsAlive false after Wait", !p.IsAlive());
    p.Close();
}

fn test_spawn_kill() {
    Console.WriteLine("--- 9. Spawn Kill + IsAlive ---");
    let p = Spawn("sleep", ["5"]);
    check("IsAlive true initially",   p.IsAlive());
    p.Kill();
    Os.Wait(p.Pid());
    check("IsAlive false after Kill", !p.IsAlive());
    p.Close();
}

fn test_spawn_stderr() {
    Console.WriteLine("--- 10. Spawn stderr ---");
    let p = Spawn("sh", ["-c", "echo err_msg >&2"]);
    p.Wait();
    let line = p.ReadLineErr();
    check("ReadLineErr captures stderr", line == "err_msg");
    p.Close();
}

fn test_spawn_wait_timeout() {
    Console.WriteLine("--- 11. Spawn WaitTimeout ---");
    let p = Spawn("sleep", ["1"]);
    let r = WaitTimeout(p.Pid(), 10);
    check("WaitTimeout reports timeout", r.TimedOut == true);
    check("WaitTimeout keeps process alive", r.Alive == true);
    p.Kill();
    Os.Wait(p.Pid());
    p.Close();
}

fn test_spawn_partial_line_eof() {
    Console.WriteLine("--- 12. Spawn partial line EOF ---");
    let p = Spawn("printf", ["tail"]);
    let line = p.ReadLine();
    let eof  = p.ReadLine();
    check("ReadLine returns trailing partial", line == "tail");
    check("ReadLine EOF after trailing partial", eof == nil);
    p.Close();
}

fn test_getenv_all() {
    Console.WriteLine("--- 13. Os.GetEnvAll ---");
    let env = Os.GetEnvAll();
    check("GetEnvAll not nil",       env != nil);
    check("GetEnvAll has PATH",      env.PATH != nil);
    check("GetEnvAll has HOME",      env.HOME != nil);
    check("HOME matches Getenv",     env.HOME == Os.Getenv("HOME"));
}

fn test_run_multiline() {
    Console.WriteLine("--- 14. Run multiline stdout ---");
    let r = Run("printf", ["a\\nb\\nc\\n"]);
    check("Multiline exit 0",        r.Exit == 0);
    let lines = String.Split(r.Stdout, "\n");
    check("Multiline line 0",        lines[0] == "a");
    check("Multiline line 1",        lines[1] == "b");
    check("Multiline line 2",        lines[2] == "c");
}

// ============================================================
// Benchmarks (subprocess spawn cost - keep iteration count low)
// ============================================================

fn test_benchmarks() {
    Console.WriteLine("=== Process benchmarks ===");

    let iters = 10;

    let t0 = Time.Ticks();
    iter (i from 0 to iters) {
        let _r = Run("echo", ["hi"]);
    }
    Console.WriteLine("Run echo x", iters, ": ",
                      String.FormatArray("{0:.2f}", [Time.TicksToMs(Time.Ticks() - t0)]), " ms");

    let t1 = Time.Ticks();
    iter (i from 0 to iters) {
        let _r = Shell("echo hi");
    }
    Console.WriteLine("Shell echo x", iters, ": ",
                      String.FormatArray("{0:.2f}", [Time.TicksToMs(Time.Ticks() - t1)]), " ms");

    let t2 = Time.Ticks();
    iter (i from 0 to iters) {
        let _r = Fiber.Await(RunAsync("echo", ["hi"]));
    }
    Console.WriteLine("RunAsync echo x", iters, ": ",
                      String.FormatArray("{0:.2f}", [Time.TicksToMs(Time.Ticks() - t2)]), " ms");

    let t3 = Time.Ticks();
    var batch = [];
    iter (i from 0 to iters) { Array.Append(batch, RunAsync("echo", ["hi"])); }
    let _all = Fiber.AwaitAll(batch);
    Console.WriteLine("RunAsync echo x", iters, " at once: ",
                      String.FormatArray("{0:.2f}", [Time.TicksToMs(Time.Ticks() - t3)]), " ms");

    Console.WriteLine("=== benchmarks done ===");
}

fn test_process_extended_helpers() {
    Console.WriteLine("--- 15. Process extended helpers ---");
    let r = Run("printf", ["hello\n"]);
    check("extended Run provides Success", r.Success == true);
    check("extended Run provides TimedOut false", r.TimedOut == false);

    let timeoutRun = Run("sleep", ["1"], { timeout: 100 });
    check("Run timeout reports TimedOut", timeoutRun.TimedOut == true);
    check("Run timeout exit code", timeoutRun.Exit == 124);

    let p = Start("cat");
    check("Start returns Process", p != nil);
    p.WriteLine("alpha\n");
    p.CloseStdin();
    let text = p.ReadAll();
    check("ReadAll captures stdout", String.IndexOf(text, "alpha") >= 0);
    p.Close();

    let asyncResult = Fiber.Await(RunAsync("printf", ["async-ok\n"], { timeout: 2000 }));
    check("RunAsync returns result", asyncResult != nil);
    check("RunAsync success", asyncResult.Success == true);
    check("RunAsync stdout", asyncResult.Stdout == "async-ok\n");

    let asyncProc = Fiber.Await(StartAsync("printf", ["async-proc\n"]));
    check("StartAsync returns Process", asyncProc != nil);
    check("StartAsync process output", asyncProc.ReadLine() == "async-proc");
    asyncProc.Wait();
    asyncProc.Close();
}

global _ticks = 0;

fn async ticker(ms: int) {
    let t0 = Time.Ticks();
    while (Time.TicksToMs(Time.Ticks() - t0) < float(ms)) {
        _ticks = _ticks + 1;
        Fiber.Sleep(10);
    }
    return _ticks;
}

fn test_run_async_overlaps() {
    Console.WriteLine("--- 16. RunAsync leaves other fibers running ---");
    let t0 = Time.Ticks();
    let rs = Fiber.AwaitAll([
        RunAsync("sleep", ["0.3"]),
        RunAsync("sh", ["-c", "sleep 0.3; echo out; echo err >&2; exit 3"]),
        ticker(200)
    ]);
    let ms = Time.TicksToMs(Time.Ticks() - t0);
    check("two 300 ms children take about 300 ms, not 600", ms >= 290.0 && ms < 550.0);
    check("another fiber ran meanwhile", rs[2] >= 5);
    check("first child exit 0",      rs[0].Exit == 0 && rs[0].Success);
    check("second child exit code",  rs[1].Exit == 3 && !rs[1].Success);
    check("second child stdout",     rs[1].Stdout == "out\n");
    check("second child stderr",     rs[1].Stderr == "err\n");

    let t1 = Time.Ticks();
    let slow = Fiber.Await(RunAsync("sleep", ["5"], { timeout: 150 }));
    check("RunAsync timeout returns early", Time.TicksToMs(Time.Ticks() - t1) < 1000.0);
    check("RunAsync timeout TimedOut",      slow.TimedOut == true);
    check("RunAsync timeout exit 124",      slow.Exit == 124);

    let missing = Fiber.Await(RunAsync("__cmd_that_does_not_exist__"));
    check("RunAsync no-cmd exit 127",       missing.Exit == 127);

    let big = Fiber.Await(RunAsync("sh", ["-c", "head -c 200000 /dev/zero | tr '\\0' a; head -c 100000 /dev/zero | tr '\\0' b >&2"]));
    check("RunAsync reads both pipes in full", len(big.Stdout) == 200000 && len(big.Stderr) == 100000);
}

fn test_launch_options() {
    Console.WriteLine("--- 17. cwd / env / stdin / mergeStderr ---");
    let opts = { cwd: "/", env: { PROCESS_TEST_VAR: "v1" }, stdin: "fed\n" };
    let script = "pwd; echo $PROCESS_TEST_VAR; cat; echo e >&2";
    let r = Run("sh", ["-c", script], opts);
    check("Run cwd",          String.StartsWith(r.Stdout, "/\n"));
    check("Run env + stdin",  r.Stdout == "/\nv1\nfed\n");
    check("Run stderr apart", r.Stderr == "e\n");

    let a = Fiber.Await(RunAsync("sh", ["-c", script], opts));
    check("RunAsync cwd + env + stdin", a.Stdout == "/\nv1\nfed\n");
    check("RunAsync stderr apart",      a.Stderr == "e\n");

    let m = Fiber.Await(RunAsync("sh", ["-c", "echo o; echo e >&2"], { mergeStderr: true }));
    check("RunAsync mergeStderr", m.Stdout == "o\ne\n" && m.Stderr == "");
    let ms = Run("sh", ["-c", "echo o; echo e >&2"], { mergeStderr: true });
    check("Run mergeStderr",      ms.Stdout == "o\ne\n" && ms.Stderr == "");

    let sh = Shell("echo $PROCESS_TEST_VAR", { env: { PROCESS_TEST_VAR: "v2" } });
    check("Shell env", sh.Stdout == "v2\n");

    let p = Start("pwd", [], { cwd: "/" });
    check("Start cwd", p.ReadLine() == "/");
    p.Wait();
    p.Close();
}

fn Main() {
    test_run_basic();
    test_run_nonzero();
    test_run_not_found();
    test_shell_basic();
    test_shell_pipeline();
    test_spawn_readline();
    test_spawn_stdin();
    test_spawn_wait();
    test_spawn_kill();
    test_spawn_stderr();
    test_spawn_wait_timeout();
    test_spawn_partial_line_eof();
    test_getenv_all();
    test_run_multiline();
    test_process_extended_helpers();
    test_run_async_overlaps();
    test_launch_options();
    test_benchmarks();

    Console.WriteLine("");
    Console.WriteLine("Results: " + passed + " passed, " + failed + " failed.");
    if (failed > 0) { return 1; }
}
