// test_test.fls - Self-test of the Test framework.
// Run: ./flarisvm tests/test_test.fls --libs='./libs'

import { Test } from library("Test", "1.0");

fn Main() {

    // ── Suite 1: all assertions that should pass ───────────────────────────

    let t = Test.Suite("Core assertions");

    t.it("eq - int", fn() { t.eq(1 + 1, 2); });
    t.it("eq - string concat", fn() { t.eq("foo" + "bar", "foobar"); });
    t.it("eq - float", fn() { t.eq(0.5 + 0.5, 1.0); });
    t.it("eq - nil", fn() { t.eq(nil, nil); });
    t.it("eq - bool", fn() { t.eq(true, true); t.eq(false, false); });

    t.it("neq", fn() {
        t.neq(1, 2);
        t.neq("a", "b");
        t.neq(nil, 0);
        t.neq(true, false);
    });

    t.it("ok - truthy values", fn() {
        t.ok(true);
        t.ok(1);
        t.ok(-1);
        t.ok("x");
    });

    t.it("notOk - falsy values", fn() {
        t.notOk(false);
        t.notOk(nil);
    });

    t.it("isNil", fn() { t.isNil(nil); });

    t.it("notNil", fn() {
        t.notNil(0);
        t.notNil(false);
        t.notNil("");
        t.notNil([]);
    });

    t.it("gt / gte / lt / lte", fn() {
        t.gt(5, 3);
        t.gt(5, -1);
        t.gte(5, 5);
        t.gte(6, 5);
        t.lt(3, 5);
        t.lt(-1, 0);
        t.lte(5, 5);
        t.lte(4, 5);
    });

    t.it("approxEq", fn() {
        t.approxEq(3.14159, 3.14, 0.01);
        t.approxEq(1.0, 1.0, 0.0);
        t.approxEq(-1.5, -1.5, 0.001);
    });

    t.it("contains", fn() {
        t.contains("hello world", "world");
        t.contains("flaris-lang", "-");
        t.contains("abc", "abc");
    });

    t.it("startsWith", fn() {
        t.startsWith("hello world", "hello");
        t.startsWith("test.fls", "test");
    });

    t.it("endsWith", fn() {
        t.endsWith("hello world", "world");
        t.endsWith("test.fls", ".fls");
    });

    t.it("throws", fn() {
        t.throws(fn() { throw(1, "expected"); });
    });

    t.it("notThrows", fn() {
        t.notThrows(fn() { let x = 1 + 1; });
    });

    t.it("label appears in failure message", fn() {
        var msg = "";
        try { t.eq(1, 2, "my label"); } catch (e) { msg = str(e.Error); }
        t.contains(msg, "my label");
        t.contains(msg, "eq:");
    });

    let f1 = t.run();

    // ── Suite 2: verify each assertion fires correctly on bad input ────────

    let t2 = Test.Suite("Failure detection");

    t2.it("eq throws on mismatch", fn() {
        var fired = false;
        try { t2.eq(1, 99); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("neq throws on match", fn() {
        var fired = false;
        try { t2.neq(5, 5); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("ok throws on false", fn() {
        var fired = false;
        try { t2.ok(false); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("notOk throws on true", fn() {
        var fired = false;
        try { t2.notOk(true); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("isNil throws on non-nil", fn() {
        var fired = false;
        try { t2.isNil(42); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("notNil throws on nil", fn() {
        var fired = false;
        try { t2.notNil(nil); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("gt throws when not greater", fn() {
        var fired = false;
        try { t2.gt(3, 5); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("lt throws when not less", fn() {
        var fired = false;
        try { t2.lt(5, 3); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("approxEq throws when outside eps", fn() {
        var fired = false;
        try { t2.approxEq(1.0, 2.0, 0.5); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("contains throws when missing", fn() {
        var fired = false;
        try { t2.contains("hello", "xyz"); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("throws fires when fn does NOT throw", fn() {
        var fired = false;
        try { t2.throws(fn() { let x = 1; }); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("notThrows fires when fn DOES throw", fn() {
        var fired = false;
        try { t2.notThrows(fn() { throw(1, "oops"); }); } catch (e) { fired = true; }
        t2.ok(fired, "notThrows should fire");
    });

    let f2 = t2.run();

    // ── Suite 3: new features ─────────────────────────────────────────────

    let t3 = Test.Suite("New features");

    // approxEq with default epsilon
    t3.it("approxEq default eps", fn() {
        t3.approxEq(1.0, 1.0, nil);
        t3.approxEq(1.0, 1.0 + 1e-10, nil);
    });

    // deepEq for arrays
    t3.it("deepEq equal arrays", fn() {
        t3.deepEq([1, 2, 3], [1, 2, 3]);
    });

    t3.it("deepEq nested arrays", fn() {
        t3.deepEq([[1,2],[3,4]], [[1,2],[3,4]]);
    });

    t3.it("deepEq fires on mismatch", fn() {
        var fired = false;
        try { t3.deepEq([1, 2], [1, 9]); } catch (e) { fired = true; }
        t3.ok(fired);
    });

    t3.it("deepEq fires on length mismatch", fn() {
        var fired = false;
        try { t3.deepEq([1, 2], [1, 2, 3]); } catch (e) { fired = true; }
        t3.ok(fired);
    });

    // throwsCode
    t3.it("throwsCode passes on correct code", fn() {
        t3.throwsCode(fn() { throw(42, "msg"); }, 42);
    });

    t3.it("throwsCode fires on wrong code", fn() {
        var fired = false;
        try { t3.throwsCode(fn() { throw(1, "msg"); }, 99); } catch (e) { fired = true; }
        t3.ok(fired);
    });

    t3.it("throwsCode fires when nothing thrown", fn() {
        var fired = false;
        try { t3.throwsCode(fn() { let x = 1; }, 1); } catch (e) { fired = true; }
        t3.ok(fired);
    });

    // matches
    t3.it("matches passes on matching pattern", fn() {
        t3.matches("hello123", "[0-9]+");
    });

    t3.it("matches fires on non-matching pattern", fn() {
        var fired = false;
        try { t3.matches("hello", "^[0-9]+$"); } catch (e) { fired = true; }
        t3.ok(fired);
    });

    // skip - just verify it doesn't error and is counted
    t3.skip("this test is pending", fn() {
        t3.ok(false);  // should never run
    });

    // beforeEach / afterEach
    var hookLog = [];
    let th = Test.Suite("hook suite");
    th.beforeEach(fn() { hookLog = Array.Append(hookLog, "before"); });
    th.afterEach(fn()  { hookLog = Array.Append(hookLog, "after");  });
    th.it("test A", fn() { hookLog = Array.Append(hookLog, "A"); });
    th.it("test B", fn() { hookLog = Array.Append(hookLog, "B"); });
    th.run();

    t3.it("beforeEach ran before each test", fn() {
        t3.eq(hookLog[0], "before");
        t3.eq(hookLog[3], "before");
    });

    t3.it("afterEach ran after each test", fn() {
        t3.eq(hookLog[2], "after");
        t3.eq(hookLog[5], "after");
    });

    t3.it("hook order is before→test→after", fn() {
        t3.eq(hookLog[0], "before");
        t3.eq(hookLog[1], "A");
        t3.eq(hookLog[2], "after");
        t3.eq(hookLog[3], "before");
        t3.eq(hookLog[4], "B");
        t3.eq(hookLog[5], "after");
    });

    // error vs failure categorization
    t3.it("unexpected error counted as failure", fn() {
        let bad = Test.Suite("bad");
        bad.it("runtime error", fn() { throw(999, "unexpected"); });
        let failed = bad.run();
        t3.eq(failed, 1);
    });

    let f3 = t3.run();

    // ── RunAll aggregator ─────────────────────────────────────────────────

    let ra1 = Test.Suite("RunAll A");
    ra1.it("pass", fn() { ra1.eq(1, 1); });
    let ra2 = Test.Suite("RunAll B");
    ra2.it("pass", fn() { ra2.ok(true); });

    let aggFailed = Test.RunAll([ra1, ra2]);

    let tAgg = Test.Suite("RunAll");
    tAgg.it("RunAll returns 0 when all pass", fn() { tAgg.eq(aggFailed, 0); });
    let f4 = tAgg.run();

    // ── Benchmarks: assertion throughput ──────────────────────────────────

    Console.WriteLine("=== Test framework benchmarks ===");

    let tb = Test.Suite("bench");
    let bIters = 5000;

    let b0 = Time.Ticks();
    iter (i from 0 to bIters - 1) {
        tb.eq(i, i);
        tb.ok(true);
        tb.lt(i, bIters + 1);
        tb.notNil(i);
    }
    Console.WriteLine("scalar assertions x", bIters * 4, ": ",
                      String.FormatArray("{0:.2f}", [Time.TicksToMs(Time.Ticks() - b0)]), " ms");

    let b1 = Time.Ticks();
    iter (i from 0 to bIters - 1) {
        tb.contains("hello world", "world");
        tb.startsWith("hello world", "hello");
        tb.endsWith("hello world", "world");
    }
    Console.WriteLine("string assertions x", bIters * 3, ": ",
                      String.FormatArray("{0:.2f}", [Time.TicksToMs(Time.Ticks() - b1)]), " ms");

    Console.WriteLine("=== benchmarks done ===");

    return (f1 + f2 + f3 + f4) > 0 ? 1 : 0;
}
