// test_test.fls - Self-test of the Test framework.
// Run: ./flarisvm tests/test_test.fls --libs='./libs'

import { Test } from library("Test", "1.0");

class DeepPoint { let x = 1; let y = 2; }
class DeepOther { let x = 1; let y = 2; }

// The message deepEq fails with, or "" when it passes.
fn deepEqMessage(t, actual, expected): string {
    var msg = "";
    try { t.deepEq(actual, expected); } catch (e) { msg = str(e.Error); }
    return msg;
}

fn Main() {

    // ── Suite 1: all assertions that should pass ───────────────────────────

    let t = Test.Suite("Core assertions");

    t.it("eq - int", fn() { t.eq(1 + 1, 2); });
    t.it("eq - string concat", fn() { t.eq("foo" + "bar", "foobar"); });
    t.it("eq - float", fn() { t.eq(0.5 + 0.5, 1.0); });
    t.it("eq - nil", fn() { t.eq(nil, nil); });
    t.it("eq - bool", fn() { t.eq(true, true); t.eq(false, false); });

    t.it("neq", fn() {
        t.neq(1, 2);
        t.neq("a", "b");
        t.neq(nil, 0);
        t.neq(true, false);
    });

    t.it("ok - truthy values", fn() {
        t.ok(true);
        t.ok(1);
        t.ok(-1);
        t.ok("x");
    });

    t.it("notOk - falsy values", fn() {
        t.notOk(false);
        t.notOk(nil);
    });

    t.it("isNil", fn() { t.isNil(nil); });

    t.it("notNil", fn() {
        t.notNil(0);
        t.notNil(false);
        t.notNil("");
        t.notNil([]);
    });

    t.it("gt / gte / lt / lte", fn() {
        t.gt(5, 3);
        t.gt(5, -1);
        t.gte(5, 5);
        t.gte(6, 5);
        t.lt(3, 5);
        t.lt(-1, 0);
        t.lte(5, 5);
        t.lte(4, 5);
    });

    t.it("approxEq", fn() {
        t.approxEq(3.14159, 3.14, 0.01);
        t.approxEq(1.0, 1.0, 0.0);
        t.approxEq(-1.5, -1.5, 0.001);
    });

    t.it("contains", fn() {
        t.contains("hello world", "world");
        t.contains("flaris-lang", "-");
        t.contains("abc", "abc");
    });

    t.it("startsWith", fn() {
        t.startsWith("hello world", "hello");
        t.startsWith("test.fls", "test");
    });

    t.it("endsWith", fn() {
        t.endsWith("hello world", "world");
        t.endsWith("test.fls", ".fls");
    });

    t.it("throws", fn() {
        t.throws(fn() { throw(1, "expected"); });
    });

    t.it("notThrows", fn() {
        t.notThrows(fn() { let x = 1 + 1; });
    });

    // An async function's call only returns its fiber; the assertion has to
    // await it to see what it throws.
    t.it("throws awaits an async function", fn() {
        t.throws(fn async () { Fiber.Sleep(1); throw(5, "async"); });
    });

    t.it("notThrows awaits an async function", fn() {
        var fired = false;
        try { t.notThrows(fn async () { Fiber.Sleep(1); throw(5, "async"); }); } catch (e) { fired = true; }
        t.ok(fired);
    });

    t.it("label appears in failure message", fn() {
        var msg = "";
        try { t.eq(1, 2, "my label"); } catch (e) { msg = str(e.Error); }
        t.contains(msg, "my label");
        t.contains(msg, "eq:");
    });

    let f1 = t.run();

    // ── Suite 2: verify each assertion fires correctly on bad input ────────

    let t2 = Test.Suite("Failure detection");

    t2.it("eq throws on mismatch", fn() {
        var fired = false;
        try { t2.eq(1, 99); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("neq throws on match", fn() {
        var fired = false;
        try { t2.neq(5, 5); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("ok throws on false", fn() {
        var fired = false;
        try { t2.ok(false); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("notOk throws on true", fn() {
        var fired = false;
        try { t2.notOk(true); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("isNil throws on non-nil", fn() {
        var fired = false;
        try { t2.isNil(42); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("notNil throws on nil", fn() {
        var fired = false;
        try { t2.notNil(nil); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("gt throws when not greater", fn() {
        var fired = false;
        try { t2.gt(3, 5); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("lt throws when not less", fn() {
        var fired = false;
        try { t2.lt(5, 3); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("approxEq throws when outside eps", fn() {
        var fired = false;
        try { t2.approxEq(1.0, 2.0, 0.5); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("contains throws when missing", fn() {
        var fired = false;
        try { t2.contains("hello", "xyz"); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("throws fires when fn does NOT throw", fn() {
        var fired = false;
        try { t2.throws(fn() { let x = 1; }); } catch (e) { fired = true; }
        t2.ok(fired);
    });

    t2.it("notThrows fires when fn DOES throw", fn() {
        var fired = false;
        try { t2.notThrows(fn() { throw(1, "oops"); }); } catch (e) { fired = true; }
        t2.ok(fired, "notThrows should fire");
    });

    let f2 = t2.run();

    // ── Suite 3: approxEq, deepEq, throwsCode, matches and hooks ─────────

    let t3 = Test.Suite("approxEq, deepEq, throwsCode, matches, hooks");

    // approxEq with default epsilon
    t3.it("approxEq default eps", fn() {
        t3.approxEq(1.0, 1.0, nil);
        t3.approxEq(1.0, 1.0 + 1e-10, nil);
    });

    // deepEq for arrays
    t3.it("deepEq equal arrays", fn() {
        t3.deepEq([1, 2, 3], [1, 2, 3]);
    });

    t3.it("deepEq nested arrays", fn() {
        t3.deepEq([[1,2],[3,4]], [[1,2],[3,4]]);
    });

    t3.it("deepEq fires on mismatch", fn() {
        var fired = false;
        try { t3.deepEq([1, 2], [1, 9]); } catch (e) { fired = true; }
        t3.ok(fired);
    });

    t3.it("deepEq fires on length mismatch", fn() {
        var fired = false;
        try { t3.deepEq([1, 2], [1, 2, 3]); } catch (e) { fired = true; }
        t3.ok(fired);
    });

    // throwsCode
    t3.it("throwsCode passes on correct code", fn() {
        t3.throwsCode(fn() { throw(42, "msg"); }, 42);
    });

    t3.it("throwsCode fires on wrong code", fn() {
        var fired = false;
        try { t3.throwsCode(fn() { throw(1, "msg"); }, 99); } catch (e) { fired = true; }
        t3.ok(fired);
    });

    t3.it("throwsCode fires when nothing thrown", fn() {
        var fired = false;
        try { t3.throwsCode(fn() { let x = 1; }, 1); } catch (e) { fired = true; }
        t3.ok(fired);
    });

    t3.it("throwsCode awaits an async function", fn() {
        t3.throwsCode(fn async () { Fiber.Sleep(1); throw(42, "msg"); }, 42);
    });

    // matches
    t3.it("matches passes on matching pattern", fn() {
        t3.matches("hello123", "[0-9]+");
    });

    t3.it("matches fires on non-matching pattern", fn() {
        var fired = false;
        try { t3.matches("hello", "^[0-9]+$"); } catch (e) { fired = true; }
        t3.ok(fired);
    });

    // skip - just verify it doesn't error and is counted
    t3.skip("this test is pending", fn() {
        t3.ok(false);  // should never run
    });

    // beforeEach / afterEach
    var hookLog = [];
    let th = Test.Suite("hook suite");
    th.beforeEach(fn() { hookLog = Array.Append(hookLog, "before"); });
    th.afterEach(fn()  { hookLog = Array.Append(hookLog, "after");  });
    th.it("test A", fn() { hookLog = Array.Append(hookLog, "A"); });
    th.it("test B", fn() { hookLog = Array.Append(hookLog, "B"); });
    th.run();

    t3.it("beforeEach ran before each test", fn() {
        t3.eq(hookLog[0], "before");
        t3.eq(hookLog[3], "before");
    });

    t3.it("afterEach ran after each test", fn() {
        t3.eq(hookLog[2], "after");
        t3.eq(hookLog[5], "after");
    });

    t3.it("hook order is before→test→after", fn() {
        t3.eq(hookLog[0], "before");
        t3.eq(hookLog[1], "A");
        t3.eq(hookLog[2], "after");
        t3.eq(hookLog[3], "before");
        t3.eq(hookLog[4], "B");
        t3.eq(hookLog[5], "after");
    });

    // error vs failure categorization
    t3.it("unexpected error counted as failure", fn() {
        let bad = Test.Suite("bad");
        bad.it("runtime error", fn() { throw(999, "unexpected"); });
        let failed = bad.run();
        t3.eq(failed, 1);
    });

    let f3 = t3.run();

    // ── deepEq on objects, arrays and instances ───────────────────────────

    let td = Test.Suite("deepEq structure");

    td.it("deepEq equal objects, any key order", fn() {
        td.deepEq({ a: 1, b: [1, { c: nil }], s: "x" }, { s: "x", b: [1, { c: nil }], a: 1 });
    });

    td.it("deepEq equal instances", fn() {
        td.deepEq(new DeepPoint(), new DeepPoint());
    });

    td.it("deepEq typed array equals plain array", fn() {
        let ia:[int] = [1, 2, 3];
        td.deepEq(ia, [1, 2, 3]);
    });

    td.it("deepEq names an unexpected key", fn() {
        td.eq(deepEqMessage(td, { a: 1 }, { b: 2 }), "deepEq: a: unexpected key (value 1)");
    });

    td.it("deepEq names a missing key", fn() {
        td.eq(deepEqMessage(td, { a: 1 }, { a: 1, z: 2 }), "deepEq: z: missing (expected 2)");
    });

    td.it("deepEq names the nested path of a differing value", fn() {
        td.eq(deepEqMessage(td, { a: { x: 1 } }, { a: { x: 2 } }), "deepEq: a.x: 1 != 2");
        td.eq(deepEqMessage(td, { user: { tags: ["a", "a"] } }, { user: { tags: ["a", "b"] } }),
              "deepEq: user.tags[1]: \"a\" != \"b\"");
    });

    td.it("deepEq reports an array length difference", fn() {
        td.eq(deepEqMessage(td, { list: [1, 2] }, { list: [1, 2, 3] }), "deepEq: list: length 2 != 3");
    });

    td.it("deepEq compares instances by class and fields", fn() {
        td.eq(deepEqMessage(td, new DeepPoint(), new DeepOther()), "deepEq: DeepPoint instance != DeepOther instance");
        let moved = new DeepPoint();
        moved.y = 5;
        td.eq(deepEqMessage(td, new DeepPoint(), moved), "deepEq: y: 2 != 5");
    });

    td.it("deepEq label prefixes the message", fn() {
        var msg = "";
        try { td.deepEq({ a: 1 }, { a: 2 }, "config"); } catch (e) { msg = str(e.Error); }
        td.eq(msg, "config: deepEq: a: 1 != 2");
    });

    let fd = td.run();

    // ── Async bodies, failing hooks and run()'s result ────────────────────

    let seen = { asyncDone: false, bodyRan: false, afterRan: 0 };

    let ta = Test.Suite("async bodies (2 of 3 must fail)");
    ta.it("async body that finishes", fn async () { Fiber.Sleep(2); seen.asyncDone = true; });
    ta.it("async body that throws", fn async () { Fiber.Sleep(1); throw(9, "async failure"); });
    ta.it("async body whose assertion fails", fn async () { Fiber.Sleep(1); ta.eq(1, 2); });
    let asyncResult = ta.run();

    let tbe = Test.Suite("throwing beforeEach (its test must fail)");
    tbe.beforeEach(fn() { throw(3, "fixture could not open db"); });
    tbe.afterEach(fn() { seen.afterRan += 1; });
    tbe.it("body behind a failing beforeEach", fn() { seen.bodyRan = true; });
    let beforeResult = tbe.run();

    let tf = Test.Suite("throwing afterEach (its test must fail)");
    tf.afterEach(fn() { throw(4, "teardown failed"); });
    tf.it("passing body, failing afterEach", fn() { tf.ok(true); });
    let afterResult = tf.run();

    let tm = Test.Suite("three failures (run() must return 1)");
    tm.it("fail 1", fn() { tm.ok(false); });
    tm.it("fail 2", fn() { tm.ok(false); });
    tm.it("fail 3", fn() { tm.ok(false); });
    let manyResult = tm.run();

    let tr = Test.Suite("Async, hooks and results");
    tr.it("an async body runs to completion", fn() { tr.ok(seen.asyncDone); });
    tr.it("async failures are counted", fn() {
        tr.eq(ta._passed, 1);
        tr.eq(ta._failed, 2);
        tr.eq(asyncResult, 1);
    });
    tr.it("a throwing beforeEach fails the test and skips its body", fn() {
        tr.eq(tbe._failed, 1);
        tr.eq(beforeResult, 1);
        tr.notOk(seen.bodyRan);
    });
    tr.it("afterEach still runs after a failing beforeEach", fn() { tr.eq(seen.afterRan, 1); });
    tr.it("a throwing afterEach fails the test", fn() {
        tr.eq(tf._failed, 1);
        tr.eq(afterResult, 1);
    });
    tr.it("run() returns 1 for any number of failures", fn() {
        tr.eq(tm._failed, 3);
        tr.eq(manyResult, 1);
    });
    tr.it("run() returns 0 when everything passed", fn() { tr.eq(f1, 0); tr.eq(fd, 0); });
    let f5 = tr.run();

    // ── RunAll aggregator ─────────────────────────────────────────────────

    let ra1 = Test.Suite("RunAll A");
    ra1.it("pass", fn() { ra1.eq(1, 1); });
    let ra2 = Test.Suite("RunAll B");
    ra2.it("pass", fn() { ra2.ok(true); });

    let aggFailed = Test.RunAll([ra1, ra2]);

    let rb1 = Test.Suite("RunAll C");
    rb1.it("pass", fn() { rb1.ok(true); });
    let rb2 = Test.Suite("RunAll D (2 must fail)");
    rb2.it("fail 1", fn() { rb2.ok(false); });
    rb2.it("fail 2", fn() { rb2.ok(false); });
    let aggMixed = Test.RunAll([rb1, rb2]);

    let tAgg = Test.Suite("RunAll");
    tAgg.it("RunAll returns 0 when all pass", fn() { tAgg.eq(aggFailed, 0); });
    tAgg.it("RunAll returns 1 when any test fails", fn() { tAgg.eq(aggMixed, 1); });
    let f4 = tAgg.run();

    // ── only, filter, each, timeouts, beforeAll / afterAll ────────────────

    let ran = { a: 0, b: 0, c: 0, all: [], body: false, after: 0, rows: [] };

    let to = Test.Suite("only (2 of 3 run)");
    to.it("not chosen", fn() { ran.a += 1; });
    to.only("chosen 1", fn() { ran.b += 1; });
    to.only("chosen 2", fn() { ran.b += 1; });
    let onlyResult = to.run();

    let ro1 = Test.Suite("RunAll with only: suite without (nothing runs)");
    ro1.it("left out", fn() { ran.c += 1; });
    let ro2 = Test.Suite("RunAll with only: suite with");
    ro2.only("chosen", fn() { ran.c += 10; });
    ro2.it("left out", fn() { ran.c += 100; });
    let onlyAll = Test.RunAll([ro1, ro2]);

    Test.Configure({ filter: "keep" });
    let tfl = Test.Suite("filter");
    tfl.it("keep me", fn() { ran.a += 10; });
    tfl.it("drop me", fn() { ran.a += 100; });
    tfl.skip("keep, skipped", fn() { });
    let filterResult = tfl.run();
    let tfs = Test.Suite("filter keeps a whole suite by its name");
    tfs.it("any label", fn() { ran.a += 1000; });
    tfs.run();
    Test.Configure({ filter: nil });

    let te = Test.Suite("each");
    te.each("{a} + {b} = {sum}", [{ a: 1, b: 2, sum: 3 }, { a: 2, b: 2, sum: 4 }], fn(row) {
        te.eq(row.a + row.b, row.sum);
        Array.Append(ran.rows, row.sum);
    });
    te.each("pair {0}/{1}", [[1, "x"], [2, "y"]], fn(row) { Array.Append(ran.rows, row[1]); });
    te.each("square of {0}", [3, 4], fn(n) { te.eq(n * n > 0, true); });
    te.each("no placeholder", [7, 8], fn(n) { Array.Append(ran.rows, n); });
    te.each("{a} fails", [{ a: "row" }], fn(row) { te.eq(row.a, "other"); });
    let eachLabels = [];
    foreach (entry in te._tests) { Array.Append(eachLabels, entry.label); }
    let eachResult = te.run();

    let tt = Test.Suite("timeouts (2 of 4 must fail)");
    tt.timeout(100);
    tt.it("async body in time", fn async () { Fiber.Sleep(5); });
    tt.it("async body too slow", fn async () { Fiber.Sleep(300); }, { timeout: 30 });
    tt.it("sync body in time", fn() { tt.ok(true); }, { timeout: 50 });
    tt.it("suite limit applies", fn async () { Fiber.Sleep(400); }, { timeout: 0 });
    let slowStart = Time.Millis();
    let timeoutResult = tt.run();
    let timeoutMs = Time.Millis() - slowStart;

    let tba = Test.Suite("beforeAll / afterAll");
    tba.beforeAll(fn() { Array.Append(ran.all, "beforeAll"); });
    tba.beforeEach(fn() { Array.Append(ran.all, "beforeEach"); });
    tba.afterEach(fn() { Array.Append(ran.all, "afterEach"); });
    tba.afterAll(fn async () { Fiber.Sleep(1); Array.Append(ran.all, "afterAll"); });
    tba.it("first", fn() { Array.Append(ran.all, "first"); });
    tba.it("second", fn() { Array.Append(ran.all, "second"); });
    let allResult = tba.run();

    let tbf = Test.Suite("throwing beforeAll (both tests must fail)");
    tbf.beforeAll(fn() { throw(5, "no server"); });
    tbf.afterAll(fn() { ran.after += 1; });
    tbf.it("one", fn() { ran.body = true; });
    tbf.it("two", fn() { ran.body = true; });
    let beforeAllResult = tbf.run();

    let taf = Test.Suite("throwing afterAll (adds a failure)");
    taf.afterAll(fn() { taf.ok(false, "cleanup"); });
    taf.it("passes", fn() { taf.ok(true); });
    let afterAllResult = taf.run();

    let tsk = Test.Suite("hooks of a suite with nothing to run");
    tsk.beforeAll(fn() { ran.after += 100; });
    tsk.skip("skipped", fn() { });
    tsk.run();

    // ── TAP and JUnit reports ─────────────────────────────────────────────

    let tmp = Directory.CreateTemp("flaris_test");
    let tapPath = tmp + "/report.tap";
    let xmlPath = tmp + "/report.xml";

    Test.Configure({ reporter: "tap", output: tapPath });
    let tp1 = Test.Suite("TAP <1>");
    tp1.it("passes", fn() { tp1.ok(true); });
    tp1.it("fails # here", fn() { tp1.eq(1, 2, "sum"); });
    tp1.skip("later", fn() { });
    let tp2 = Test.Suite("TAP 2");
    tp2.it("throws", fn() { throw(77, "bad \"input\""); });
    let tapResult = Test.RunAll([tp1, tp2]);
    let tp3 = Test.Suite("TAP 3");
    tp3.it("a later run", fn() { tp3.ok(true); });
    tp3.run();

    Test.Configure({ reporter: "junit", output: xmlPath });
    let tj = Test.Suite("JUnit & <xml>");
    tj.it("passes", fn() { tj.ok(true); });
    tj.it("fails <here>", fn() { tj.eq("a", "b"); });
    tj.it("errors", fn() { throw(12, "boom & bust"); });
    tj.it("control characters", fn() { throw(13, "bell\x07 and tab\t"); });
    tj.skip("skipped", fn() { });
    let junitResult = tj.run();
    let tj2 = Test.Suite("JUnit 2");
    tj2.it("a later run", fn() { tj2.ok(true); });
    tj2.run();
    Test.Configure({ reporter: "pretty", output: nil });

    let tapLines = File.ReadLines(tapPath);
    let xml = File.ReadText(xmlPath);
    Directory.DeleteAll(tmp);

    // ── The environment: a child VM run ───────────────────────────────────

    let child = Directory.CreateTemp("flaris_test_env");
    File.WriteText(child + "/env_suite.fls",
        "import { Test } from library(\"Test\", \"1.0\");\n" +
        "fn Main() {\n" +
        "    let t = Test.Suite(\"env\");\n" +
        "    t.it(\"alpha one\", fn() { t.ok(true); });\n" +
        "    t.it(\"beta two\", fn() { t.ok(true); });\n" +
        "    let r = t.run();\n" +
        "    Test.Bench(\"bench line\", fn() { }, 10);\n" +
        "    return r;\n" +
        "}\n");
    let vm = Os.GetEnv("FLARISVM") ?? "../flaris-lang/flarisvm";
    let envRun = Os.RunEx(vm, ["--libs=./libs", child + "/env_suite.fls"],
                          { Env: { FLARIS_TEST_FILTER: "alpha", FLARIS_TEST_REPORTER: "junit", FLARIS_TEST_OUTPUT: nil } });
    let plainRun = Os.RunEx(vm, ["--libs=./libs", child + "/env_suite.fls"],
                            { Env: { FLARIS_TEST_FILTER: nil, FLARIS_TEST_REPORTER: nil, FLARIS_TEST_OUTPUT: nil } });
    Directory.DeleteAll(child);
    let envOut = (envRun == nil) ? "" : envRun.Stdout;
    let plainOut = (plainRun == nil) ? "" : plainRun.Stdout;
    var benchLine = "";
    foreach (line in String.SplitLines(plainOut)) {
        if (String.StartsWith(line, "bench line")) { benchLine = line; }
    }

    let tn = Test.Suite("only, filter, each, timeouts, hooks, reports");
    tn.it("only runs the chosen tests", fn() {
        tn.eq(ran.b, 2);
        tn.eq(to._passed, 2);
        tn.eq(onlyResult, 0);
    });
    tn.it("only in one suite of RunAll leaves the others out", fn() {
        tn.eq(ran.c, 10);
        tn.eq(ro1._passed, 0);
        tn.eq(onlyAll, 0);
    });
    tn.it("the filter matches suite name and label", fn() {
        tn.eq(ran.a, 1010);
        tn.eq(tfl._passed, 1);
        tn.eq(tfl._skipped, 1);
        tn.eq(filterResult, 0);
    });
    tn.it("each fills labels from the rows", fn() {
        tn.deepEq(eachLabels, ["1 + 2 = 3", "2 + 2 = 4", "pair 1/x", "pair 2/y", "square of 3",
                               "square of 4", "no placeholder [0]", "no placeholder [1]", "row fails"]);
        tn.deepEq(ran.rows, [3, 4, "x", "y", 7, 8]);
        tn.eq(te._passed, 8);
        tn.eq(te._failed, 1);
        tn.eq(eachResult, 1);
    });
    tn.it("a test past its limit fails, the others pass", fn() {
        tn.eq(tt._passed, 2);
        tn.eq(tt._failed, 2);
        tn.eq(timeoutResult, 1);
        tn.lt(timeoutMs, 380);
    });
    tn.it("beforeAll and afterAll run once around the tests", fn() {
        tn.deepEq(ran.all, ["beforeAll", "beforeEach", "first", "afterEach",
                            "beforeEach", "second", "afterEach", "afterAll"]);
        tn.eq(allResult, 0);
    });
    tn.it("a throwing beforeAll fails every test, afterAll still runs", fn() {
        tn.eq(tbf._failed, 2);
        tn.notOk(ran.body);
        tn.eq(ran.after, 1);
        tn.eq(beforeAllResult, 1);
    });
    tn.it("a throwing afterAll adds a failure", fn() {
        tn.eq(taf._passed, 1);
        tn.eq(taf._failed, 1);
        tn.eq(afterAllResult, 1);
    });
    tn.it("TAP report, carried on by a later run to the same file", fn() {
        tn.eq(tapResult, 1);
        tn.deepEq(tapLines, [
            "TAP version 14",
            "ok 1 - TAP <1> > passes",
            "not ok 2 - TAP <1> > fails \\# here",
            "  ---",
            "  message: \"sum: eq: expected=2 got=1\"",
            "  severity: fail",
            "  ...",
            "ok 3 - TAP <1> > later # SKIP",
            "not ok 4 - TAP 2 > throws",
            "  ---",
            "  message: \"ERROR [77]: bad \\\"input\\\"\"",
            "  severity: error",
            "  ...",
            "ok 5 - TAP 3 > a later run",
            "1..5"]);
    });
    tn.it("JUnit report, carried on by a later run to the same file", fn() {
        tn.eq(junitResult, 1);
        tn.startsWith(xml, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<testsuites tests=\"6\" failures=\"1\" errors=\"2\" skipped=\"1\"");
        tn.contains(xml, "<testsuite name=\"JUnit 2\" tests=\"1\" failures=\"0\" errors=\"0\" skipped=\"0\"");
        tn.contains(xml, "<testsuite name=\"JUnit &amp; &lt;xml&gt;\" tests=\"5\" failures=\"1\" errors=\"2\" skipped=\"1\"");
        tn.contains(xml, "><error message=\"ERROR [13]: bell and tab\t\">");
        tn.contains(xml, "name=\"passes\" time=\"");
        tn.contains(xml, "><failure message=\"eq: expected=b got=a\">eq: expected=b got=a</failure></testcase>");
        tn.contains(xml, "name=\"fails &lt;here&gt;\"");
        tn.contains(xml, "><error message=\"ERROR [12]: boom &amp; bust\">");
        tn.contains(xml, "name=\"skipped\" time=\"0.000\"><skipped/></testcase>");
        tn.endsWith(xml, "  </testsuite>\n</testsuites>\n");
    });
    tn.it("FLARIS_TEST_FILTER and FLARIS_TEST_REPORTER from the environment", fn() {
        tn.notNil(envRun);
        tn.contains(envOut, "<testcase classname=\"env\" name=\"alpha one\"");
        tn.notOk(String.Contains(envOut, "beta two"));
        tn.contains(envOut, "<testsuites tests=\"1\" failures=\"0\" errors=\"0\" skipped=\"0\"");
    });
    tn.it("Bench prints the standard benchmark line", fn() {
        tn.matches(benchLine, "^bench line {38}\\s*[0-9]+\\.[0-9]{2} ms  \\s*[0-9]+\\.[0-9]{4} µs/call$");
        tn.eq(len(String.Left(benchLine, 48)), 48);
        tn.contains(plainOut, "beta two");
    });
    let f6 = tn.run();

    // ── Benchmarks: assertion throughput ──────────────────────────────────

    Console.WriteLine("=== Test framework benchmarks ===");

    let tb = Test.Suite("bench");
    let bIters = 5000;

    let b0 = Time.Ticks();
    iter (i from 0 to bIters) {
        tb.eq(i, i);
        tb.ok(true);
        tb.lt(i, bIters + 1);
        tb.notNil(i);
    }
    Console.WriteLine("scalar assertions x", bIters * 4, ": ",
                      String.FormatArray("{0:.2f}", [Time.TicksToMs(Time.Ticks() - b0)]), " ms");

    let b1 = Time.Ticks();
    iter (i from 0 to bIters) {
        tb.contains("hello world", "world");
        tb.startsWith("hello world", "hello");
        tb.endsWith("hello world", "world");
    }
    Console.WriteLine("string assertions x", bIters * 3, ": ",
                      String.FormatArray("{0:.2f}", [Time.TicksToMs(Time.Ticks() - b1)]), " ms");

    Console.WriteLine("=== benchmarks done ===");

    return (f1 + f2 + f3 + f4 + f5 + f6) > 0 ? 1 : 0;
}
