import { Complex } from library("./libs/Complex", "1.0");

global fails = 0;
global _sink = 0;

fn bench(name: string, f: fn, n: int) {
    f(); f(); f();
    let t0: int = Time.Ticks();
    iter (i from 0 to n - 1) { f(); }
    let dt: int = Time.Ticks() - t0;
    let ms: float = Time.TicksToMs(dt);
    let us: float = Time.TicksToUs(dt) / float(n);
    Console.WriteLine(
        String.PadRight(name, 48),
        String.PadLeft(String.FormatArray("{0:.2f}", [ms]),   9), " ms  ",
        String.PadLeft(String.FormatArray("{0:.4f}", [us]),  11), " µs/call"
    );
}

fn benchSep() { Console.WriteLine(String.Repeat("-", 74)); }

fn assertClose(name:string, a:float|int, b:float|int, tol:float) {
    if (Math.AbsF(a - b) <= tol) {
        Console.WriteLine("[PASS] " + name);
    } else {
        Console.WriteLine("[FAIL] " + name + " got " + str(a) + " expected " + str(b));
        fails++;
    }
}

fn assert(name:string, cond:bool) {
    if (cond) {
        Console.WriteLine("[PASS] " + name);
    } else {
        Console.WriteLine("[FAIL] " + name);
        fails++;
    }
}

fn Main() {
    let a = new Complex(3, 4);
    let b = new Complex(1, -2);

    // ToString
    assert("ToString 3+4i",      a.ToString() == "3+4i");
    assert("ToString 1-2i",      b.ToString() == "1-2i");
    assert("ToString real only", new Complex(5, 0).ToString() == "5");
    assert("ToString imag only", new Complex(0, 3).ToString() == "3i");

    // Arithmetic
    assert("Add",  a.Add(b).ToString() == "4+2i");
    assert("Sub",  a.Sub(b).ToString() == "2+6i");
    assert("Mul",  a.Mul(b).ToString() == "11-2i");
    assert("Neg",  a.Neg().ToString() == "-3-4i");
    assert("Conj", a.Conj().ToString() == "3-4i");

    // Div: (3+4i)/(1-2i) = (3+4i)(1+2i)/5 = (-5+10i)/5 = -1+2i
    let divResult = a.Div(b);
    assertClose("Div real", float(divResult.real), -1.0, 1e-9);
    assertClose("Div imag", float(divResult.imag),  2.0, 1e-9);

    // Faulty area: division by zero throws (documented behavior in Div/Reciprocal).
    let divThrew = false;
    try {
        a.Div(Complex.Zero());
    } catch (e) {
        divThrew = true;
    }
    assert("Div by zero throws", divThrew);

    let recThrew = false;
    try {
        Complex.Zero().Reciprocal();
    } catch (e) {
        recThrew = true;
    }
    assert("Reciprocal(0) throws", recThrew);

    // Scale
    let scaled = a.Scale(2);
    assert("Scale", scaled.ToString() == "6+8i");

    // Magnitude and Norm
    assertClose("Magnitude", float(a.Magnitude()), 5.0,  1e-9);
    assertClose("Norm",      float(a.Norm()),      25.0, 1e-9);

    // Arg
    assertClose("Arg", float(a.Arg()), Math.Atan2(4, 3), 1e-9);

    // Equals / Clone
    assert("Equals true",  a.Equals(new Complex(3, 4)));
    assert("Equals false", !a.Equals(b));
    assert("Clone equals", a.Clone().Equals(a));

    // Exp: e^(iπ) ≈ -1 (Euler)
    let euler = new Complex(0, Math.PI);
    let eResult = euler.Exp();
    assertClose("Exp Euler real", float(eResult.real), -1.0, 1e-9);
    assertClose("Exp Euler imag", float(eResult.imag),  0.0, 1e-9);

    // Pow int
    let onePlusI = new Complex(1, 1);
    let powered = onePlusI.Pow(2);
    assertClose("Pow(2) real", float(powered.real), 0.0, 1e-9);
    assertClose("Pow(2) imag", float(powered.imag), 2.0, 1e-9);
    assert("Pow(0) = One", a.Pow(0).Equals(Complex.One()));
    let invA  = a.Pow(-1);
    let check = a.Mul(invA);
    assertClose("Pow(-1) real", check.real, 1,   1e-9);
    assertClose("Pow(-1) imag", check.imag, 0.0, 1e-9);

    // Sqrt
    let negOne = new Complex(-1, 0);
    assertClose("Sqrt(-1) imag", Math.AbsF(negOne.Sqrt().imag), 1.0, 1e-9);
    let four = new Complex(4, 0);
    assertClose("Sqrt(4) real",  four.Sqrt().real,              2.0, 1e-9);
    assertClose("Sqrt(4) imag",  Math.AbsF(four.Sqrt().imag),   0.0, 1e-9);

    // Log
    let e = new Complex(Math.E, 0);
    assertClose("Log(e) real", e.Log().real, 1.0, 1e-9);
    assertClose("Log(e) imag", e.Log().imag, 0.0, 1e-9);

    // FromPolar
    let p = Complex.FromPolar(5, 0);
    assertClose("FromPolar real", p.real, 5.0, 1e-9);
    assertClose("FromPolar imag", p.imag, 0.0, 1e-9);
    let rt = Complex.FromPolar(a.Magnitude(), a.Arg());
    assertClose("Polar round-trip real", rt.real, 3.0, 1e-9);
    assertClose("Polar round-trip imag", rt.imag, 4.0, 1e-9);

    // Static constructors
    assert("Zero", Complex.Zero().Equals(new Complex(0, 0)));
    assert("One",  Complex.One().Equals(new Complex(1, 0)));
    assert("I",    Complex.I().Equals(new Complex(0, 1)));

    // ---- new functions ----

    // IsReal / IsImaginary
    assert("IsReal true",       new Complex(5, 0).IsReal());
    assert("IsReal false",      !new Complex(5, 1).IsReal());
    assert("IsImaginary true",  new Complex(0, 3).IsImaginary());
    assert("IsImaginary false", !new Complex(1, 3).IsImaginary());

    // ApproxEquals
    assert("ApproxEquals within",  new Complex(1.0, 2.0).ApproxEquals(new Complex(1.0 + 1e-10, 2.0 - 1e-10), 1e-9));
    assert("ApproxEquals outside", !new Complex(1.0, 2.0).ApproxEquals(new Complex(1.1, 2.0), 1e-9));

    // Reciprocal: 1/(2+0i) = 0.5
    let rec = new Complex(2.0, 0.0).Reciprocal();
    assertClose("Reciprocal real", float(rec.real), 0.5, 1e-9);
    assertClose("Reciprocal imag", float(rec.imag), 0.0, 1e-9);

    // Reciprocal identity: z * (1/z) = 1
    let zInv = a.Reciprocal();
    let prod = a.Mul(zInv);
    assertClose("Reciprocal identity real", float(prod.real), 1.0, 1e-9);
    assertClose("Reciprocal identity imag", float(prod.imag), 0.0, 1e-9);

    // PowF: 4^0.5 = 2
    let pf = new Complex(4.0, 0.0).PowF(0.5);
    assertClose("PowF(0.5) real", float(pf.real),          2.0, 1e-6);
    assertClose("PowF(0.5) imag", Math.AbsF(float(pf.imag)), 0.0, 1e-6);

    // PowF: 2^3 = 8
    assertClose("PowF(3.0) real", float(new Complex(2.0, 0.0).PowF(3.0).real), 8.0, 1e-6);

    // Sin / Cos at 0
    assertClose("Sin(0) real", float(Complex.Zero().Sin().real), 0.0, 1e-9);
    assertClose("Sin(0) imag", float(Complex.Zero().Sin().imag), 0.0, 1e-9);
    assertClose("Cos(0) real", float(Complex.Zero().Cos().real), 1.0, 1e-9);
    assertClose("Cos(0) imag", float(Complex.Zero().Cos().imag), 0.0, 1e-9);

    // sin²(z) + cos²(z) = 1
    let zr = new Complex(1.2, 0.0);
    let id = zr.Sin().Mul(zr.Sin()).Add(zr.Cos().Mul(zr.Cos()));
    assertClose("sin²+cos²=1 real", float(id.real), 1.0, 1e-9);
    assertClose("sin²+cos²=1 imag", float(id.imag), 0.0, 1e-9);

    // Tan
    // tan(0) = 0
    assertClose("Tan(0) real", float(Complex.Zero().Tan().real), 0.0, 1e-9);
    assertClose("Tan(0) imag", float(Complex.Zero().Tan().imag), 0.0, 1e-9);
    // tan(z) = sin(z)/cos(z) identity
    let zt = new Complex(0.8, 0.3);
    let tanDirect = zt.Sin().Div(zt.Cos());
    let tanMethod = zt.Tan();
    assertClose("Tan real identity", float(tanMethod.real), float(tanDirect.real), 1e-9);
    assertClose("Tan imag identity", float(tanMethod.imag), float(tanDirect.imag), 1e-9);

    // ApproxEqualsMag
    assert("ApproxEqualsMag within",  new Complex(1.0, 0.0).ApproxEqualsMag(new Complex(1.0 + 1e-10, 0.0), 1e-9));
    assert("ApproxEqualsMag outside", !new Complex(1.0, 0.0).ApproxEqualsMag(new Complex(2.0, 0.0), 1e-9));
    // magnitude of difference: |(3+4i) - (3+4i)| = 0
    assert("ApproxEqualsMag self",    a.ApproxEqualsMag(a.Clone(), 1e-15));

    // IsNaN
    assert("IsNaN false on normal",    !a.IsNaN());
    assert("IsNaN true on NaN static", Complex.NaN().IsNaN());
    assert("IsNaN true real NaN",      new Complex(Math.NaN, 0.0).IsNaN());
    assert("IsNaN true imag NaN",      new Complex(0.0, Math.NaN).IsNaN());

    // IsInfinite
    assert("IsInfinite false on normal", !a.IsInfinite());
    let infPos = Math.Infinity;
    assert("IsInfinite true real inf",  new Complex(infPos, 0.0).IsInfinite());
    assert("IsInfinite true imag inf",  new Complex(0.0, infPos).IsInfinite());

    // PowC: (2+0i)^(3+0i) = 8
    let base2 = new Complex(2.0, 0.0);
    let exp3  = new Complex(3.0, 0.0);
    let pc = base2.PowC(exp3);
    assertClose("PowC (2^3) real", float(pc.real), 8.0, 1e-6);
    assertClose("PowC (2^3) imag", Math.AbsF(float(pc.imag)), 0.0, 1e-6);
    // i^i = e^(-π/2)  (classic result)
    let ii = Complex.I().PowC(Complex.I());
    assertClose("PowC i^i real", float(ii.real), Math.Exp(-Math.PI / 2.0), 1e-9);
    assertClose("PowC i^i imag", Math.AbsF(float(ii.imag)), 0.0, 1e-9);

    // NaN static constructor
    assert("NaN static IsNaN", Complex.NaN().IsNaN());

    if (fails > 0) {
        Console.WriteLine(fails + " tests failed.");
        return 1;
    }
    Console.Ok("All tests passed!");

    let cz  = Complex.Zero();
    let co  = new Complex(1.0, 0.0);
    let ci  = Complex.I();
    let cxy = new Complex(3.0, 4.0);
    let ca  = new Complex(1.5, 2.5);
    let cb  = new Complex(0.5, 1.0);

    Console.WriteLine("\n\n=== Complex Benchmarks ===");
    Console.WriteLine(String.PadRight("benchmark", 48), String.PadLeft("total", 9), "      ", String.PadLeft("µs/call", 11));
    benchSep();

    Console.WriteLine("\n[ Arithmetic ]");
    bench("Add   (1.5+2.5i) + (0.5+1.0i)", fn() {
        let r = ca.Add(cb); _sink = _sink + 1;
    }, 10000);
    bench("Mul   (1.5+2.5i) × (0.5+1.0i)", fn() {
        let r = ca.Mul(cb); _sink = _sink + 1;
    }, 10000);
    bench("Abs   |3+4i|", fn() {
        let r = cxy.Abs(); _sink = _sink + 1;
    }, 10000);
    bench("Neg   -(3+4i)", fn() {
        let r = cxy.Neg(); _sink = _sink + 1;
    }, 10000);
    bench("Conj  Conj(3+4i)", fn() {
        let r = cxy.Conj(); _sink = _sink + 1;
    }, 10000);

    Console.WriteLine("\n[ Power & transcendental ]");
    bench("Pow   (1.5+2.5i)^3  (int exp)", fn() {
        let r = ca.PowF(3.0); _sink = _sink + 1;
    }, 5000);
    bench("Sin   sin(1.5+2.5i)", fn() {
        let r = ca.Sin(); _sink = _sink + 1;
    }, 5000);
    bench("Cos   cos(1.5+2.5i)", fn() {
        let r = ca.Cos(); _sink = _sink + 1;
    }, 5000);
    bench("Exp   exp(1.5+2.5i)", fn() {
        let r = ca.Exp(); _sink = _sink + 1;
    }, 5000);
    bench("Log   log(3+4i)", fn() {
        let r = cxy.Log(); _sink = _sink + 1;
    }, 5000);

    benchSep();
    Console.WriteLine("_sink=" + str(_sink));
    return 0;
}
