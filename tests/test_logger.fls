// ============================================================
// 12. SetSyslog
// ============================================================

fn test_syslog() {
    Console.WriteLine("== SetSyslog ==");
    let log = new Logger();

    let ok = log.SetSyslog("", nil);
    check(ok, "SetSyslog('') disables cleanly");

    ok = log.SetSyslog("none", nil);
    check(ok, "SetSyslog('none') disables cleanly");

    ok = log.SetSyslog("255.255.255.255", 51400);
    check(ok == true || ok == false, "SetSyslog bad host returns bool");

    ok = log.SetSyslog("none", nil);
    check(ok, "SetSyslog('none') cleans up after bad host");
}

