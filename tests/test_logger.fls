// ============================================================
// 14. LevelName (static)
// ============================================================

fn test_level_name() {
    Console.WriteLine("== LevelName ==");
    checkEq(Logger.LevelName(0), "DEBUG",   "LevelName(0) = DEBUG");
    checkEq(Logger.LevelName(1), "INFO",    "LevelName(1) = INFO");
    checkEq(Logger.LevelName(2), "WARN",    "LevelName(2) = WARN");
    checkEq(Logger.LevelName(3), "ERROR",   "LevelName(3) = ERROR");
    checkEq(Logger.LevelName(4), "FATAL",   "LevelName(4) = FATAL");
    checkEq(Logger.LevelName(99), "UNKNOWN","LevelName(99) = UNKNOWN");
    checkEq(Logger.LevelName(-1), "UNKNOWN","LevelName(-1) = UNKNOWN");
}

// ============================================================
// 15. SetPrefix
// ============================================================

fn test_prefix() {
    Console.WriteLine("== SetPrefix ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_prefix.log");

    if (File.Exists(path)) { File.Delete(path); }

    let log = new Logger();
    log.SetLevel(Logger.DEBUG);
    log.SetOutput("file", path);
    log.SetPrefix("[MyService]");

    log.Info("hello");
    log.Warn("world");

    let contents = File.ReadText(path);
    check(String.Contains(contents, "[MyService] [INF] hello"), "prefix on info line");
    check(String.Contains(contents, "[MyService] [WRN] world"), "prefix on warn line");

    // Clearing prefix
    log.SetPrefix("");
    log.Debug("no prefix");
    let updated = File.ReadText(path);
    let lines = String.SplitLines(updated);
    let lastLine = lines[len(lines) - 1];
    check(String.StartsWith(lastLine, "[DBG]"), "cleared prefix: line starts with [DBG]");

    File.Delete(path);
}

// ============================================================
// 16. SetTimestamp
// ============================================================

fn test_timestamp() {
    Console.WriteLine("== SetTimestamp ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_ts.log");

    if (File.Exists(path)) { File.Delete(path); }

    let log = new Logger();
    log.SetLevel(Logger.DEBUG);
    log.SetOutput("file", path);
    log.SetTimestamp(true);

    log.Info("timestamped message");

    let contents = File.ReadText(path);
    // Timestamp format: YYYY-MM-DDThh:mm:ss
    check(String.Contains(contents, "T"), "timestamp contains T separator");
    check(String.Contains(contents, "[INF] timestamped message"), "message still present with timestamp");

    // Disabling timestamp
    log.SetTimestamp(false);
    log.Info("no timestamp");

    let lines = String.SplitLines(File.ReadText(path));
    // Last non-empty line should start with [INF]
    let last = "";
    iter (i from 0 to len(lines) - 1) {
        if (len(lines[i]) > 0) { last = lines[i]; }
    }
    check(String.StartsWith(last, "[INF]"), "disabled timestamp: line starts with [INF]");

    File.Delete(path);
}

