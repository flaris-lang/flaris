// 7. File sink
// ============================================================

fn test_file_sink() {
    Console.WriteLine("== File sink ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_verify.log");

    if (File.Exists(path)) { File.Delete(path); }

    let log = new Logger();
    log.SetLevel(Logger.DEBUG);
    log.SetOutput("file", path);

    log.Debug("debug message");
    log.Info("info message");
    log.Warn("warn message");
    log.Error("error message");

    check(File.Exists(path), "log file was created");

    let contents = File.ReadText(path);
    check(String.Contains(contents, "[DBG] debug message"), "file contains DBG line");
    check(String.Contains(contents, "[INF] info message"),  "file contains INF line");
    check(String.Contains(contents, "[WRN] warn message"),  "file contains WRN line");
    check(String.Contains(contents, "[ERR] error message"), "file contains ERR line");

    File.Delete(path);
}

// ============================================================
// 8. Level filtering
// ============================================================

fn test_level_filtering() {
    Console.WriteLine("== Level filtering ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_filter.log");

    if (File.Exists(path)) { File.Delete(path); }

    let log = new Logger();
    log.SetLevel(Logger.WARN);
    log.SetOutput("file", path);

    log.Debug("suppressed debug", nil);
    log.Info("suppressed info",   nil);
    log.Warn("should appear",     nil);
    log.Error("should appear",    nil);

    let contents = File.ReadText(path);
    check(!String.Contains(contents, "suppressed"),         "debug/info suppressed by WARN level");
    check(String.Contains(contents, "[WRN] should appear"), "warn passes WARN filter");
    check(String.Contains(contents, "[ERR] should appear"), "error passes WARN filter");

    File.Delete(path);
}

// ============================================================
// 9. Disabled suppresses all output
// ============================================================

fn test_disabled_suppresses() {
    Console.WriteLine("== Disabled suppresses output ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_disabled.log");

    if (File.Exists(path)) { File.Delete(path); }

    let log = new Logger();
    log.SetLevel(Logger.DEBUG);
    log.SetOutput("file", path);
    log.Disable();

    log.Debug("suppressed", nil);
    log.Info("suppressed",  nil);
    log.Error("suppressed", nil);

    if (File.Exists(path)) {
        let contents = File.ReadText(path);
        check(contents == "", "disabled logger writes nothing");
        File.Delete(path);
    } else {
        check(true, "disabled logger creates no file");
    }
}

