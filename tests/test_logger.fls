// ============================================================
// 18. SetColor (notThrows - writes to stdout)
// ============================================================

fn test_set_color() {
    Console.WriteLine("== SetColor ==");
    let log = new Logger();

    let threw = false;
    try {
        log.SetColor(true);
    } catch (e) {
        threw = true;
    }
    check(!threw, "SetColor(true) does not throw");

    threw = false;
    try {
        log.SetColor(false);
    } catch (e) {
        threw = true;
    }
    check(!threw, "SetColor(false) does not throw");

    // Verify color mode is recorded - write to file where color is suppressed,
    // output should still contain the plain level tag.
    let path = Path.Combine(Os.TempDir(), "_test_logger_color.log");
    if (File.Exists(path)) { File.Delete(path); }
    log.SetColor(true);
    log.SetOutput("file", path);
    log.SetLevel(Logger.DEBUG);
    log.Info("color-off-for-file");
    let contents = File.ReadText(path);
    check(String.Contains(contents, "[INF] color-off-for-file"), "file sink still writes plain tag when color=true");
    File.Delete(path);
}

// ============================================================
// 19. Child logger
// ============================================================

fn test_child() {
    Console.WriteLine("== Child ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_child.log");
    if (File.Exists(path)) { File.Delete(path); }

    let parent = new Logger();
    parent.SetLevel(Logger.DEBUG);
    parent.SetOutput("file", path);
    parent.SetPrefix("[Parent]");

    let child = parent.Child("Worker");

    // Child inherits level
    checkEq(child.GetLevel(), 0, "child inherits parent level");

    // Child has combined prefix
    child.Info("child message");
    let contents = File.ReadText(path);
    check(String.Contains(contents, "[Parent].Worker"), "child has combined prefix");
    check(String.Contains(contents, "[INF] child message"), "child writes INF line");

    // Parent and child are independent instances
    child.SetLevel(Logger.ERROR);
    checkEq(parent.GetLevel(), 0, "changing child level does not affect parent");
    checkEq(child.GetLevel(),  3, "child level updated independently");

    // Deeper nesting
    let grandchild = child.Child("Task");
    check(String.Contains(grandchild._prefix, "Worker"), "grandchild prefix contains Worker");
    check(String.Contains(grandchild._prefix, "Task"),   "grandchild prefix contains Task");

    File.Delete(path);

    // A child writes through the parent's sink: whichever of them rotates the
    // file, the other follows to the new one and no line is lost.
    let rpath = Path.Combine(Os.TempDir(), "_test_logger_child_rot.log");
    let files = [rpath, rpath + ".1", rpath + ".2", rpath + ".3", rpath + ".4"];
    foreach (f in files) { if (File.Exists(f)) { File.Delete(f); } }
    let rp = new Logger();
    rp.SetOutput("file", rpath);
    rp.SetRotation(200, 4);
    let rc = rp.Child("[db]");
    iter (i from 0 to 10) {
        rp.Info("parent line " + str(i));
        rc.Info("child line " + str(i));
    }
    rc.Close();
    rp.Info("parent after the child closed");
    rp.Close();
    var all = "";
    foreach (f in files) { if (File.Exists(f)) { all = all + File.ReadText(f); } }
    checkEq(len(String.Split(all, "parent line ")) - 1, 10, "rotation keeps every parent line");
    checkEq(len(String.Split(all, "child line ")) - 1, 10, "rotation keeps every child line");
    check(String.Contains(all, "parent after the child closed"), "a child's Close leaves the shared sink open");
    foreach (f in files) { if (File.Exists(f)) { File.Delete(f); } }

    // SetOutput on a child gives it a destination of its own.
    let opath = Path.Combine(Os.TempDir(), "_test_logger_child_own.log");
    let cpath = Path.Combine(Os.TempDir(), "_test_logger_child_own2.log");
    foreach (f in [opath, cpath]) { if (File.Exists(f)) { File.Delete(f); } }
    let op = new Logger();
    op.SetOutput("file", opath);
    let oc = op.Child("own");
    oc.SetOutput("file", cpath);
    oc.Info("to the child's file");
    op.Info("to the parent's file");
    oc.Close();
    op.Close();
    check(String.Contains(File.ReadText(cpath), "to the child's file"), "a child's SetOutput redirects the child");
    check(!String.Contains(File.ReadText(opath), "to the child's file"), "  and not the parent");
    check(String.Contains(File.ReadText(opath), "to the parent's file"), "  which keeps its own file");
    foreach (f in [opath, cpath]) { if (File.Exists(f)) { File.Delete(f); } }

    // A child sends to the parent's syslog too.
    let udp = Stream.Listen("udp", 0, nil, "127.0.0.1");
    let addr = Stream.LocalAddr(udp);
    let sp = new Logger();
    sp.SetOutput("file", Path.Combine(Os.TempDir(), "_test_logger_child_sys.log"));
    sp.SetSyslog("127.0.0.1", Convert.ParseInt(String.Substr(addr, String.LastIndexOf(addr, ":") + 1)));
    sp.Child("sub").Warn("from the child");
    let dg = (Stream.WaitReadable(udp, 2000) == true) ? Stream.ReadBytes(udp, 2048) : nil;
    check(dg != nil && String.Contains(Buffer.ToString(dg), "from the child"), "a child keeps the parent's syslog");
    sp.Close();
    Stream.Close(udp);
    File.Delete(Path.Combine(Os.TempDir(), "_test_logger_child_sys.log"));
}

// ============================================================
// 20. InfoWith / DebugWith / WarnWith / ErrorWith / _formatFields
// ============================================================

fn test_with_methods() {
    Console.WriteLine("== InfoWith / DebugWith / WarnWith / ErrorWith ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_with.log");
    if (File.Exists(path)) { File.Delete(path); }

    let log = new Logger();
    log.SetLevel(Logger.DEBUG);
    log.SetOutput("file", path);

    log.InfoWith("startup",  { port: 8080, env: "prod" });
    log.DebugWith("trace",   { step: 1 });
    log.WarnWith("slow",     { latency: 250 });
    log.ErrorWith("failure", { code: 500 });

    let contents = File.ReadText(path);

    // InfoWith
    check(String.Contains(contents, "[INF] startup"),  "InfoWith writes INF line");
    check(String.Contains(contents, "port=8080"),      "InfoWith includes port field");
    check(String.Contains(contents, "env=prod"),       "InfoWith includes env field");

    // DebugWith
    check(String.Contains(contents, "[DBG] trace"),    "DebugWith writes DBG line");
    check(String.Contains(contents, "step=1"),         "DebugWith includes step field");

    // WarnWith
    check(String.Contains(contents, "[WRN] slow"),     "WarnWith writes WRN line");
    check(String.Contains(contents, "latency=250"),    "WarnWith includes latency field");

    // ErrorWith
    check(String.Contains(contents, "[ERR] failure"),  "ErrorWith writes ERR line");
    check(String.Contains(contents, "code=500"),       "ErrorWith includes code field");

    File.Delete(path);
}

fn test_format_fields() {
    Console.WriteLine("== _formatFields ==");
    let log = new Logger();

    let result = log._formatFields({ a: 1, b: "hello" });
    check(String.Contains(result, "a=1"),       "_formatFields includes a=1");
    check(String.Contains(result, "b=hello"),   "_formatFields includes b=hello");
    check(String.StartsWith(result, " "),       "_formatFields starts with space separator");

    let empty = log._formatFields({});
    checkEq(empty, "", "_formatFields empty object returns empty string");
}

fn test_json_output() {
    Console.WriteLine("== JSON output ==");
    let path = Path.Combine(Os.TempDir(), "flaris_test_logger_json.log");
    if (File.Exists(path)) File.Delete(path);

    let log = new Logger();
    log.SetJson(true);
    log.SetOutput("file", path);
    log.SetPrefix("svc");
    log.Info("hello", { userId: 42, ok: true });
    log.Error("boom", { code: 500 });
    log.InfoWith("metric", { latencyMs: 12 });

    let lines = String.Split(String.Trim(File.ReadText(path)), "\n");
    checkEq(len(lines), 3, "JSON: one object per log call");

    let e0 = Json.Parse(lines[0]);
    checkEq(e0.level, "INFO", "JSON level");
    checkEq(e0.msg, "hello", "JSON msg");
    checkEq(e0.userId, 42, "JSON merged field userId");
    checkEq(e0.ok, true, "JSON merged field ok");
    checkEq(e0.logger, "svc", "JSON logger prefix");
    check(Object.HasKey(e0, "time"), "JSON has time");

    let e1 = Json.Parse(lines[1]);
    checkEq(e1.level, "ERROR", "JSON error level");
    checkEq(e1.code, 500, "JSON error field");

    let e2 = Json.Parse(lines[2]);
    checkEq(e2.latencyMs, 12, "JSON InfoWith carries fields structurally");

    File.Delete(path);
}

fn test_rotation() {
    Console.WriteLine("== File rotation ==");
    let path = Path.Combine(Os.TempDir(), "flaris_test_logger_rot.log");
    var c = 0;
    while (c <= 5) { if (File.Exists(path + "." + str(c))) File.Delete(path + "." + str(c)); c += 1; }
    if (File.Exists(path)) File.Delete(path);

    let log = new Logger();
    log.SetOutput("file", path);
    log.SetRotation(200, 3);     // rotate ~every 200 bytes, keep 3 backups

    var i = 0;
    while (i < 60) { log.Info("rotation line " + str(i) + " with some padding"); i += 1; }

    check(File.Exists(path),        "active log exists after rotation");
    check(File.Exists(path + ".1"), "backup .1 created");
    check(File.Exists(path + ".2"), "backup .2 created");
    check(File.Exists(path + ".3"), "backup .3 created");
    check(!File.Exists(path + ".4"), "no .4 (maxFiles=3 respected)");

    // cleanup
    File.Delete(path);
    var k = 1;
    while (k <= 3) { if (File.Exists(path + "." + str(k))) File.Delete(path + "." + str(k)); k += 1; }
}

// ============================================================
// Main
// ============================================================


// ============================================================
// Log-line forgery
//
// Every assertion here reads the file sink rather than the console: the
// console is not a reliable witness for this, since Console.Write expands a
// backslash escape back into the character it stands for.
// ============================================================

fn test_line_forgery() {
    Console.WriteLine("== Log-line forgery ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_forge.log");
    if (File.Exists(path)) { File.Delete(path); }

    let log = new Logger();
    log.SetOutput("file", path);

    // A username straight off a request, carrying a newline and a fake level.
    log.Info("login for bob" + "\n" + "[ERR] payment refunded to attacker");
    log.InfoWith("audit", { actor: "carol" + "\r" + "[ERR] deleted all records" });
    let forgedKey = { };
    forgedKey["k" + "\n" + "[ERR] forged"] = "v";
    log.InfoWith("audit", forgedKey);
    log.Info("screen" + "\x1b" + "[2J");

    let lines = File.ReadLines(path);
    checkEq(len(lines), 4, "four calls produce exactly four lines");

    let all = File.ReadText(path);
    check(String.Contains(all, "bob\\n[ERR] payment"),   "message newline escaped, not emitted");
    check(String.Contains(all, "carol\\r[ERR] deleted"), "field value CR escaped");
    check(String.Contains(all, "k\\n[ERR] forged="),     "field name newline escaped");
    check(String.Contains(all, "screen\\e[2J"),          "ANSI escape neutralised");
    File.Delete(path);
}

fn test_forgery_via_prefix() {
    Console.WriteLine("== Prefix forgery ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_forge2.log");
    if (File.Exists(path)) { File.Delete(path); }

    let log = new Logger();
    log.SetOutput("file", path);
    log.SetPrefix("svc" + "\n" + "[ERR] forged by prefix");
    log.Info("hello");

    let child = log.Child("sub" + "\n" + "[ERR] forged by child");
    child.Info("world");

    checkEq(len(File.ReadLines(path)), 2, "two calls produce exactly two lines");
    File.Delete(path);
}

fn test_ordinary_text_untouched() {
    Console.WriteLine("== Escaping leaves ordinary text alone ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_plain.log");
    if (File.Exists(path)) { File.Delete(path); }

    let log = new Logger();
    log.SetOutput("file", path);
    let msg = "C:\\Users\\ada, 50% done, \"quoted\", tab->\tend";
    log.Info(msg);

    check(String.Contains(File.ReadText(path), msg), "a message with no CR/LF/ESC is written verbatim");
    File.Delete(path);
}

fn test_json_mode_still_structured() {
    Console.WriteLine("== JSON mode ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_json2.log");
    if (File.Exists(path)) { File.Delete(path); }

    let log = new Logger();
    log.SetOutput("file", path);
    log.SetJson(true);
    log.Info("a" + "\n" + "b", { k: "c" + "\n" + "d" });

    // JSON escaping is the reversible one, so the value must survive intact.
    checkEq(len(File.ReadLines(path)), 1, "one JSON record on one line");
    let obj = Json.Parse(File.ReadText(path));
    check(obj != nil, "record parses as JSON");
    if (obj != nil) {
        checkEq(obj.msg, "a" + "\n" + "b", "JSON keeps the real newline in the message");
        checkEq(obj.k,   "c" + "\n" + "d", "JSON keeps the real newline in the field");
    }
    File.Delete(path);
}

// ============================================================
// With: context fields
// ============================================================

fn test_with_context() {
    Console.WriteLine("== With (context fields) ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_ctx.log");
    if (File.Exists(path)) { File.Delete(path); }

    let log = new Logger();
    log.SetOutput("file", path);
    log.SetJson(true);
    let ctx = { request: "a1", user: 42 };
    let req = log.With(ctx);
    req.Info("served", { status: 200 });
    req.Info("override", { user: 7 });
    log.Info("plain");
    let deeper = req.With({ step: "db" }).Child("repo");
    deeper.Warn("slow");
    ctx.user = 99;
    req.Info("after the caller changed its object");

    let lines = File.ReadLines(path);
    checkEq(len(lines), 5, "With: one record per call");
    let e0 = Json.Parse(lines[0]);
    checkEq(e0.request, "a1", "With: context field in the record");
    checkEq(e0.user, 42, "With: second context field");
    checkEq(e0.status, 200, "With: the record's own field too");
    checkEq(Json.Parse(lines[1]).user, 7, "With: a record's field wins over the context");
    check(!Object.HasKey(Json.Parse(lines[2]), "request"), "With: the parent's records carry no context");
    let e3 = Json.Parse(lines[3]);
    check(e3.request == "a1" && e3.step == "db", "With: nested With keeps both sets of fields");
    checkEq(e3.logger, "repo", "With: a Child of a With logger keeps the fields");
    checkEq(Json.Parse(lines[4]).user, 42, "With: the fields are copied");

    // Text mode appends the fields as JSON; ...With methods still work.
    let tpath = Path.Combine(Os.TempDir(), "_test_logger_ctx_text.log");
    if (File.Exists(tpath)) { File.Delete(tpath); }
    let tl = new Logger();
    tl.SetOutput("file", tpath);
    let tr = tl.With({ job: 5 });
    tr.Info("start");
    tr.InfoWith("step", { n: 1 });
    checkEq(tr.GetLevel(), tl.GetLevel(), "With: inherits the level");
    let tlines = File.ReadLines(tpath);
    checkEq(tlines[0], "[INF] start {\"job\":5}", "With: text record ends in the context as JSON");
    check(String.Contains(tlines[1], "[INF] step n=1 {\"job\":5}"), "With: InfoWith pairs, then the context");

    log.Close();
    tl.Close();
    File.Delete(path);
    File.Delete(tpath);
}

// ============================================================
// AddSink: several destinations
// ============================================================

fn test_add_sink() {
    Console.WriteLine("== AddSink ==");
    let main  = Path.Combine(Os.TempDir(), "_test_logger_main.log");
    let debug = Path.Combine(Os.TempDir(), "_test_logger_debug.json");
    let fmt   = Path.Combine(Os.TempDir(), "_test_logger_fmt.log");
    foreach (f in [main, debug, fmt]) { if (File.Exists(f)) { File.Delete(f); } }

    let udp = Stream.Listen("udp", 0, nil, "127.0.0.1");
    let addr = Stream.LocalAddr(udp);
    let port = Convert.ParseInt(String.Substr(addr, String.LastIndexOf(addr, ":") + 1));

    let log = new Logger();
    log.SetOutput("file", main);
    log.SetLevel("warn");
    log.AddSink("file", { path: debug, level: "debug", format: "json" });
    log.AddSink("syslog", { host: "127.0.0.1", port: port, level: "error" });
    log.AddSink("file", { path: fmt, level: Logger.INFO, format: fn(r) { return r.levelName + "|" + r.msg; } });

    log.Debug("d1");
    log.Info("i1");
    log.Warn("w1", { k: 1 });
    let child = log.Child("kid");
    child.Debug("from the child");
    log.Error("e1");

    let dg = (Stream.WaitReadable(udp, 2000) == true) ? Stream.ReadBytes(udp, 2048) : nil;
    let dgText = (dg == nil) ? "" : Buffer.ToString(dg);
    check(String.StartsWith(dgText, "<11>flaris: [ERR] e1"), "AddSink: syslog sink gets the error record");
    check(Stream.WaitReadable(udp, 50) != true, "AddSink: syslog sink below its level gets nothing");

    let mainText = File.ReadText(main);
    check(String.Contains(mainText, "[WRN] w1 {\"k\":1}") && String.Contains(mainText, "[ERR] e1"), "AddSink: the logger's own sink keeps its level");
    check(!String.Contains(mainText, "i1") && !String.Contains(mainText, "d1"), "AddSink: the logger's own sink filters below warn");

    let dl = File.ReadLines(debug);
    checkEq(len(dl), 5, "AddSink: the debug sink gets every record");
    checkEq(Json.Parse(dl[0]).msg, "d1", "AddSink: a json sink writes JSON");
    checkEq(Json.Parse(dl[2]).k, 1, "AddSink: a json sink carries the fields");
    checkEq(Json.Parse(dl[3]).logger, "kid", "AddSink: children write to the added sinks");

    checkEq(File.ReadLines(fmt), ["INFO|i1", "WARN|w1", "ERROR|e1"], "AddSink: a sink with its own formatter and level");

    // RemoveSinks leaves the logger's own sink.
    log.RemoveSinks();
    log.Debug("gone");
    log.Error("still here");
    check(!String.Contains(File.ReadText(debug), "gone"), "RemoveSinks: the added sinks stop");
    check(String.Contains(File.ReadText(main), "still here"), "RemoveSinks: the logger's sink stays");

    // A child's SetOutput leaves the parent's added sinks behind.
    let own = Path.Combine(Os.TempDir(), "_test_logger_own.log");
    if (File.Exists(own)) { File.Delete(own); }
    log.AddSink("file", { path: debug, level: "debug" });
    let c2 = log.Child("own");
    c2.SetOutput("file", own);
    c2.Error("child only");
    log.Error("parent and sink");
    check(!String.Contains(File.ReadText(debug), "child only"), "AddSink: a child with its own output skips the parent's sinks");
    check(String.Contains(File.ReadText(debug), "parent and sink"), "AddSink: the parent still writes to them");
    check(String.Contains(File.ReadText(debug), "[ERR] parent and sink"), "AddSink: a sink without a format follows the logger (text)");
    c2.Close();

    var threw = 0;
    try { log.AddSink("pigeon"); } catch (e) { threw += 1; }
    try { log.AddSink("file"); } catch (e) { threw += 1; }
    try { log.AddSink("stdout", { format: "xml" }); } catch (e) { threw += 1; }
    try { log.AddSink("stdout", { level: "loud" }); } catch (e) { threw += 1; }
    try { log.AddSink("syslog", { }); } catch (e) { threw += 1; }
    checkEq(threw, 5, "AddSink: bad kind, path, format, level and host raise");

    log.Close();
    log.Error("after Close");
    check(!String.Contains(File.ReadText(debug), "after Close"), "Close: the added file sinks are closed too");
    Stream.Close(udp);
    foreach (f in [main, debug, fmt, own]) { if (File.Exists(f)) { File.Delete(f); } }

    // An added file sink rotates on its own.
    let rot = Path.Combine(Os.TempDir(), "_test_logger_sink_rot.log");
    foreach (f in [rot, rot + ".1", rot + ".2", rot + ".3"]) { if (File.Exists(f)) { File.Delete(f); } }
    let rl = new Logger();
    rl.Disable();
    rl.Enable();
    rl.SetOutput("file", Path.Combine(Os.TempDir(), "_test_logger_sink_rot_main.log"));
    rl.AddSink("file", { path: rot, maxBytes: 200, maxFiles: 2, timestamp: true });
    iter (i from 0 to 30) { rl.Info("rotating sink line " + str(i)); }
    rl.Close();
    check(File.Exists(rot + ".1") && File.Exists(rot + ".2") && !File.Exists(rot + ".3"), "AddSink: file sink rotation, maxFiles respected");
    check(Regex.IsMatch(File.ReadLines(rot + ".1")[0], "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2} \\[INF\\] rotating"), "AddSink: timestamp option");
    foreach (f in [rot, rot + ".1", rot + ".2", Path.Combine(Os.TempDir(), "_test_logger_sink_rot_main.log")]) { if (File.Exists(f)) { File.Delete(f); } }
}

// ============================================================
// SetFormatter
// ============================================================

fn test_formatter() {
    Console.WriteLine("== SetFormatter ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_formatter.log");
    if (File.Exists(path)) { File.Delete(path); }

    let log = new Logger();
    log.SetOutput("file", path);
    log.SetPrefix("api");
    let seen = { time: 0, level: -1 };
    log.SetFormatter(fn(r) {
        seen.time = r.time;
        seen.level = r.level;
        if (r.msg == "drop") { return nil; }
        if (r.msg == "own newline") { return "kept\n"; }
        let f = (r.fields == nil) ? "-" : Json.Stringify(r.fields);
        return r.levelName + "|" + r.logger + "|" + r.msg + "|" + f;
    });
    log.Info("one", { a: 1 });
    log.Info("drop");
    log.With({ ctx: true }).Warn("two");
    log.Child("sub").Error("three");
    log.Info("own newline");
    let lines = File.ReadLines(path);
    checkEq(lines, ["INFO|api|one|{\"a\":1}", "WARN|api|two|{\"ctx\":true}", "ERROR|api.sub|three|-", "kept"],
            "SetFormatter: renders, drops on nil, reaches children, adds a missing newline only");
    check(seen.time >= Time.Now() - 5 && seen.time <= Time.Now(), "SetFormatter: record time is Unix seconds");
    checkEq(seen.level, 1, "SetFormatter: record level is the number");

    log.SetFormatter(nil);
    log.Info("back to text");
    check(String.Contains(File.ReadText(path), "api [INF] back to text"), "SetFormatter(nil) restores the text format");
    var threw = false;
    try { log.SetFormatter("not a function"); } catch (e) { threw = true; }
    check(threw, "SetFormatter refuses a non-function");
    log.Close();
    File.Delete(path);
}

fn async Main() {
    Console.WriteLine("=== Logger test suite ===");

    test_constants();
    test_defaults();
    test_set_level();
    test_enable_disable();
    test_trace_notice_aliases();
    test_flush_and_close();
    test_instance_independence();
    test_set_output();
    test_file_sink();
    test_level_filtering();
    test_disabled_suppresses();
    test_log_generic();
    test_object_field();
    test_syslog();
    test_numeric_sink();
    test_level_name();
    test_prefix();
    test_timestamp();
    test_prefix_and_timestamp();
    test_set_color();
    test_child();
    test_with_methods();
    test_format_fields();
    test_json_output();
    test_rotation();
    test_line_forgery();
    test_forgery_via_prefix();
    test_ordinary_text_untouched();
    test_json_mode_still_structured();
    test_with_context();
    test_add_sink();
    test_formatter();

    Console.WriteLine("=== Done ===");
    Console.WriteLine("Tests run:", testsRun, " failed:", testsFailed);

    if (testsFailed > 0) {
        Console.Error("Some tests FAILED.");
        return testsFailed;
    }
    Console.Ok("All tests passed!");

    let bench_path = Path.Combine(Os.TempDir(), "_bench_logger.log");
    if (File.Exists(bench_path)) { File.Delete(bench_path); }

    let log_off  = new Logger();
    log_off.Disable();

    let log_filt = new Logger();
    log_filt.SetLevel("warn");

    let log_file = new Logger();
    log_file.SetOutput("file", bench_path);
    log_file.SetLevel("debug");

    Console.WriteLine("\n\n=== Logger Benchmarks ===");
    Console.WriteLine(String.PadRight("benchmark", 48), String.PadLeft("total", 9), "      ", String.PadLeft("µs/call", 11));
    benchSep();

    Console.WriteLine("\n[ No-output paths ]");
    bench("Info()  logger disabled  (Disable())", fn() {
        log_off.Info("msg"); _sink = _sink + 1;
    }, 20000);
    bench("Info()  level-filtered   (level=warn)", fn() {
        log_filt.Info("msg"); _sink = _sink + 1;
    }, 20000);
    bench("Debug() level-filtered   (level=warn)", fn() {
        log_filt.Debug("msg"); _sink = _sink + 1;
    }, 20000);

    Console.WriteLine("\n[ File I/O paths  (writes to /tmp/_bench_logger.log) ]");
    bench("Info()  to file  plain string", fn() {
        log_file.Info("benchmark message"); _sink = _sink + 1;
    }, 2000);
    bench("Warn()  to file  with object field", fn() {
        log_file.Warn("event", { id: _sink, ok: true }); _sink = _sink + 1;
    }, 1000);
    bench("Error() to file  plain string", fn() {
        log_file.Error("error message"); _sink = _sink + 1;
    }, 2000);

    Console.WriteLine("\n[ Context, several sinks, formatter ]");
    let bench_json = Path.Combine(Os.TempDir(), "_bench_logger.json");
    if (File.Exists(bench_json)) { File.Delete(bench_json); }
    let log_ctx = log_file.With({ request: "a1f3", user: 42 });
    bench("Info()  to file  through With() context", fn() {
        log_ctx.Info("benchmark message"); _sink = _sink + 1;
    }, 2000);
    let log_two = new Logger();
    log_two.SetOutput("file", bench_path);
    log_two.AddSink("file", { path: bench_json, format: "json" });
    bench("Info()  to file + a JSON file sink", fn() {
        log_two.Info("benchmark message"); _sink = _sink + 1;
    }, 1000);
    let log_dbg = new Logger();
    log_dbg.SetLevel("warn");
    log_dbg.AddSink("file", { path: bench_json, level: "error" });
    bench("Debug() filtered, an added sink at error", fn() {
        log_dbg.Debug("msg"); _sink = _sink + 1;
    }, 20000);
    let log_fmt = new Logger();
    log_fmt.SetOutput("file", bench_path);
    log_fmt.SetFormatter(fn(r) { return r.levelName + " " + r.msg; });
    bench("Info()  to file  custom formatter", fn() {
        log_fmt.Info("benchmark message"); _sink = _sink + 1;
    }, 2000);
    log_two.Close();
    log_dbg.Close();
    log_fmt.Close();

    benchSep();
    Console.WriteLine("_sink=" + str(_sink));
    if (File.Exists(bench_path)) { File.Delete(bench_path); }
    if (File.Exists(bench_json)) { File.Delete(bench_json); }
    return testsFailed;
}
