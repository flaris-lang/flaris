// ============================================================
// Log-line forgery
//
// Every assertion here reads the file sink rather than the console: the
// console is not a reliable witness for this, since Console.Write expands a
// backslash escape back into the character it stands for.
// ============================================================

fn test_line_forgery() {
    Console.WriteLine("== Log-line forgery ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_forge.log");
    if (File.Exists(path)) { File.Delete(path); }

    let log = new Logger();
    log.SetOutput("file", path);

    // A username straight off a request, carrying a newline and a fake level.
    log.Info("login for bob" + "\n" + "[ERR] payment refunded to attacker");
    log.InfoWith("audit", { actor: "carol" + "\r" + "[ERR] deleted all records" });
    let forgedKey = { };
    forgedKey["k" + "\n" + "[ERR] forged"] = "v";
    log.InfoWith("audit", forgedKey);
    log.Info("screen" + "\x1b" + "[2J");

    let lines = File.ReadLines(path);
    checkEq(len(lines), 4, "four calls produce exactly four lines");

    let all = File.ReadText(path);
    check(String.Contains(all, "bob\\n[ERR] payment"),   "message newline escaped, not emitted");
    check(String.Contains(all, "carol\\r[ERR] deleted"), "field value CR escaped");
    check(String.Contains(all, "k\\n[ERR] forged="),     "field name newline escaped");
    check(String.Contains(all, "screen\\e[2J"),          "ANSI escape neutralised");
    File.Delete(path);
}

fn test_forgery_via_prefix() {
    Console.WriteLine("== Prefix forgery ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_forge2.log");
    if (File.Exists(path)) { File.Delete(path); }

    let log = new Logger();
    log.SetOutput("file", path);
    log.SetPrefix("svc" + "\n" + "[ERR] forged by prefix");
    log.Info("hello");

    let child = log.Child("sub" + "\n" + "[ERR] forged by child");
    child.Info("world");

    checkEq(len(File.ReadLines(path)), 2, "two calls produce exactly two lines");
    File.Delete(path);
}

fn test_ordinary_text_untouched() {
    Console.WriteLine("== Escaping leaves ordinary text alone ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_plain.log");
    if (File.Exists(path)) { File.Delete(path); }

    let log = new Logger();
    log.SetOutput("file", path);
    let msg = "C:\\Users\\ada, 50% done, \"quoted\", tab->\tend";
    log.Info(msg);

    check(String.Contains(File.ReadText(path), msg), "a message with no CR/LF/ESC is written verbatim");
    File.Delete(path);
}

fn test_json_mode_still_structured() {
    Console.WriteLine("== JSON mode ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_json2.log");
    if (File.Exists(path)) { File.Delete(path); }

    let log = new Logger();
    log.SetOutput("file", path);
    log.SetJson(true);
    log.Info("a" + "\n" + "b", { k: "c" + "\n" + "d" });

    // JSON escaping is the reversible one, so the value must survive intact.
    checkEq(len(File.ReadLines(path)), 1, "one JSON record on one line");
    let obj = Json.Parse(File.ReadText(path));
    check(obj != nil, "record parses as JSON");
    if (obj != nil) {
        checkEq(obj.msg, "a" + "\n" + "b", "JSON keeps the real newline in the message");
        checkEq(obj.k,   "c" + "\n" + "d", "JSON keeps the real newline in the field");
    }
    File.Delete(path);
}

fn async Main() {
    Console.WriteLine("=== Logger test suite ===");

    test_constants();
    test_defaults();
    test_set_level();
    test_enable_disable();
    test_trace_notice_aliases();
    test_flush_and_close();
    test_instance_independence();
    test_set_output();
    test_file_sink();
    test_level_filtering();
    test_disabled_suppresses();
    test_log_generic();
    test_object_field();
    test_syslog();
    test_numeric_sink();
    test_level_name();
    test_prefix();
    test_timestamp();
    test_prefix_and_timestamp();
    test_set_color();
    test_child();
    test_with_methods();
    test_format_fields();
    test_json_output();
    test_rotation();
    test_line_forgery();
    test_forgery_via_prefix();
    test_ordinary_text_untouched();
    test_json_mode_still_structured();

    Console.WriteLine("=== Done ===");
    Console.WriteLine("Tests run:", testsRun, " failed:", testsFailed);

    if (testsFailed > 0) {
        Console.Error("Some tests FAILED.");
        return testsFailed;
    }
    Console.Ok("All tests passed!");

    let bench_path = Path.Combine(Os.TempDir(), "_bench_logger.log");
    if (File.Exists(bench_path)) { File.Delete(bench_path); }

    let log_off  = new Logger();
    log_off.Disable();

    let log_filt = new Logger();
    log_filt.SetLevel("warn");

    let log_file = new Logger();
    log_file.SetOutput("file", bench_path);
    log_file.SetLevel("debug");

    Console.WriteLine("\n\n=== Logger Benchmarks ===");
    Console.WriteLine(String.PadRight("benchmark", 48), String.PadLeft("total", 9), "      ", String.PadLeft("µs/call", 11));
    benchSep();

    Console.WriteLine("\n[ No-output paths ]");
    bench("Info()  logger disabled  (Disable())", fn() {
        log_off.Info("msg"); _sink = _sink + 1;
    }, 20000);
    bench("Info()  level-filtered   (level=warn)", fn() {
        log_filt.Info("msg"); _sink = _sink + 1;
    }, 20000);
    bench("Debug() level-filtered   (level=warn)", fn() {
        log_filt.Debug("msg"); _sink = _sink + 1;
    }, 20000);

    Console.WriteLine("\n[ File I/O paths  (writes to /tmp/_bench_logger.log) ]");
    bench("Info()  to file  plain string", fn() {
        log_file.Info("benchmark message"); _sink = _sink + 1;
    }, 2000);
    bench("Warn()  to file  with object field", fn() {
        log_file.Warn("event", { id: _sink, ok: true }); _sink = _sink + 1;
    }, 1000);
    bench("Error() to file  plain string", fn() {
        log_file.Error("error message"); _sink = _sink + 1;
    }, 2000);

    benchSep();
    Console.WriteLine("_sink=" + str(_sink));
    if (File.Exists(bench_path)) { File.Delete(bench_path); }
    return testsFailed;
}
