    check(String.Contains(contents, "[INF] via Log info"),   "Log(INFO) works");
    check(String.Contains(contents, "[WRN] via Log string"), "Log(string) works");

    let threw = false;
    try {
        log.Log("invalid", "msg", nil);
    } catch (e) {
        threw = true;
    }
    check(threw, "Log('invalid') throws");

    File.Delete(path);
}

