// ============================================================
// test_logger.fls - test suite for Logger.fls
// Run: flarisvm test_logger.fls
// ============================================================

import { Logger } from library("Logger", "1.0");

global testsRun    = 0;
global testsFailed = 0;
global _sink       = 0;

fn bench(name: string, f: fn, n: int) {
    f(); f(); f();
    let t0: int = Time.Ticks();
    iter (i from 0 to n - 1) { f(); }
    let dt: int = Time.Ticks() - t0;
    let ms: float = Time.TicksToMs(dt);
    let us: float = Time.TicksToUs(dt) / float(n);
    Console.WriteLine(
        String.PadRight(name, 48),
        String.PadLeft(String.FormatArray("{0:.2f}", [ms]),   9), " ms  ",
        String.PadLeft(String.FormatArray("{0:.4f}", [us]),  11), " µs/call"
    );
}

fn benchSep() { Console.WriteLine(String.Repeat("-", 74)); }

fn check(cond, msg) {
    testsRun += 1;
    if (!cond) {
        testsFailed += 1;
        Console.WriteLine("FAIL:", msg);
    }
}

fn checkEq(actual, expected, msg) {
    testsRun += 1;
    if (actual != expected) {
        testsFailed += 1;
        Console.WriteLine("FAIL:", msg, " expected=", expected, " got=", actual);
    }
}

// ============================================================
// 1. Level constants
// ============================================================

fn test_constants() {
    Console.WriteLine("== Level constants ==");
    checkEq(Logger.DEBUG, 0, "DEBUG == 0");
    checkEq(Logger.INFO,  1, "INFO  == 1");
    checkEq(Logger.WARN,  2, "WARN  == 2");
    checkEq(Logger.ERROR, 3, "ERROR == 3");
    checkEq(Logger.FATAL, 4, "FATAL == 4");
}

// ============================================================
// 2. Default state
// ============================================================

fn test_defaults() {
    Console.WriteLine("== Default state ==");
    let log = new Logger();
    checkEq(log.GetLevel(), 1, "default level is INFO (1)");
    check(log.IsEnabled(),     "default enabled");
}

// ============================================================
// 3. SetLevel / GetLevel - int and string
// ============================================================

fn test_set_level() {
    Console.WriteLine("== SetLevel / GetLevel ==");
    let log = new Logger();

    log.SetLevel(Logger.DEBUG);
    checkEq(log.GetLevel(), 0, "SetLevel(int 0) -> DEBUG");

    log.SetLevel(Logger.WARN);
    checkEq(log.GetLevel(), 2, "SetLevel(int 2) -> WARN");

    log.SetLevel("error");
    checkEq(log.GetLevel(), 3, "SetLevel(string 'error')");

    log.SetLevel("DEBUG");
    checkEq(log.GetLevel(), 0, "SetLevel(string 'DEBUG') case-insensitive");

    log.SetLevel("info");
    checkEq(log.GetLevel(), 1, "SetLevel(string 'info')");

    log.SetLevel("warn");
    checkEq(log.GetLevel(), 2, "SetLevel(string 'warn')");

    log.SetLevel("fatal");
    checkEq(log.GetLevel(), 4, "SetLevel(string 'fatal')");

    log.SetLevel("trace");
    checkEq(log.GetLevel(), 0, "SetLevel(string 'trace') -> DEBUG");

    log.SetLevel("notice");
    checkEq(log.GetLevel(), 2, "SetLevel(string 'notice') -> WARN");

    log.SetLevel(-99);
    checkEq(log.GetLevel(), 0, "SetLevel(-99) clamps to 0");

    log.SetLevel(99);
    checkEq(log.GetLevel(), 4, "SetLevel(99) clamps to 4");

    let threw = false;
    try {
        log.SetLevel("nonsense");
    } catch (e) {
        threw = true;
    }
    check(threw, "SetLevel('nonsense') throws");
}

// ============================================================
// 4. Enable / Disable / IsEnabled
// ============================================================

fn test_enable_disable() {
    Console.WriteLine("== Enable / Disable ==");
    let log = new Logger();

    check(log.IsEnabled(), "starts enabled");

    log.Disable();
    check(!log.IsEnabled(), "Disable() -> not enabled");

    log.Enable();
    check(log.IsEnabled(), "Enable() -> enabled again");
}

fn test_trace_notice_aliases() {
    Console.WriteLine("== Trace / Notice aliases ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_trace_notice.log");
    if (File.Exists(path)) { File.Delete(path); }

    let log = new Logger();
    log.SetLevel(Logger.DEBUG);
    log.SetOutput("file", path);

    log.Trace("trace message");
    log.Notice("notice message");

    let contents = File.ReadText(path);
    check(String.Contains(contents, "trace message"), "Trace() writes");
    check(String.Contains(contents, "notice message"), "Notice() writes");

    File.Delete(path);
}

fn test_flush_and_close() {
    Console.WriteLine("== Flush / Close ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_flush_close.log");
    if (File.Exists(path)) { File.Delete(path); }

    let log = new Logger();
    log.SetOutput("file", path);
    log.Info("before flush");
    log.Flush();
    log.Info("after flush");
    log.Close();

    let contents = File.ReadText(path);
    check(String.Contains(contents, "before flush"), "file contains pre-flush message");
    check(String.Contains(contents, "after flush"), "file contains post-flush message");

    let ok = false;
    try {
        log.SetOutput("file", path);
        ok = true;
    } catch (_e) {
        ok = false;
    }
    check(ok, "Close() leaves logger reusable");

    File.Delete(path);
}

// ============================================================
// 5. Instance independence
// ============================================================

fn test_instance_independence() {
    Console.WriteLine("== Instance independence ==");
    let a = new Logger();
    let b = new Logger();

    a.SetLevel(Logger.DEBUG);
    b.SetLevel(Logger.ERROR);

    checkEq(a.GetLevel(), 0, "a.level == DEBUG");
    checkEq(b.GetLevel(), 3, "b.level == ERROR");

    a.Disable();
    check(!a.IsEnabled(), "a disabled");
    check(b.IsEnabled(),  "b still enabled");
}

// ============================================================
// 6. SetOutput
// ============================================================

fn test_set_output() {
    Console.WriteLine("== SetOutput ==");
    let log = new Logger();

    let ok = log.SetOutput("stdout");
    check(ok, "SetOutput('stdout') returns true");

    ok = log.SetOutput("stderr");
    check(ok, "SetOutput('stderr') returns true");

    ok = log.SetOutput(0);
    check(ok, "SetOutput(0) returns true");

    ok = log.SetOutput(1);
    check(ok, "SetOutput(1) returns true");

    let threw = false;
    try {
        log.SetOutput("file", nil);
    } catch (e) {
        threw = true;
    }
    check(threw, "SetOutput('file', nil) throws");

    ok = log.SetOutput("file", Path.Combine(Os.TempDir(), "_test_logger.log"));
    check(ok, "SetOutput('file', path) returns true");

    threw = false;
    try {
        log.SetOutput("syslog", nil);
    } catch (e) {
        threw = true;
    }
    check(threw, "SetOutput('syslog') throws");
}

