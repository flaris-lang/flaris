// ============================================================
// 18. SetColor (notThrows - writes to stdout)
// ============================================================

fn test_set_color() {
    Console.WriteLine("== SetColor ==");
    let log = new Logger();

    let threw = false;
    try {
        log.SetColor(true);
    } catch (e) {
        threw = true;
    }
    check(!threw, "SetColor(true) does not throw");

    threw = false;
    try {
        log.SetColor(false);
    } catch (e) {
        threw = true;
    }
    check(!threw, "SetColor(false) does not throw");

    // Verify color mode is recorded - write to file where color is suppressed,
    // output should still contain the plain level tag.
    let path = Path.Combine(Os.TempDir(), "_test_logger_color.log");
    if (File.Exists(path)) { File.Delete(path); }
    log.SetColor(true);
    log.SetOutput("file", path);
    log.SetLevel(Logger.DEBUG);
    log.Info("color-off-for-file");
    let contents = File.ReadText(path);
    check(String.Contains(contents, "[INF] color-off-for-file"), "file sink still writes plain tag when color=true");
    File.Delete(path);
}

// ============================================================
// 19. Child logger
// ============================================================

fn test_child() {
    Console.WriteLine("== Child ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_child.log");
    if (File.Exists(path)) { File.Delete(path); }

    let parent = new Logger();
    parent.SetLevel(Logger.DEBUG);
    parent.SetOutput("file", path);
    parent.SetPrefix("[Parent]");

    let child = parent.Child("Worker");

    // Child inherits level
    checkEq(child.GetLevel(), 0, "child inherits parent level");

    // Child has combined prefix
    child.Info("child message");
    let contents = File.ReadText(path);
    check(String.Contains(contents, "[Parent].Worker"), "child has combined prefix");
    check(String.Contains(contents, "[INF] child message"), "child writes INF line");

    // Parent and child are independent instances
    child.SetLevel(Logger.ERROR);
    checkEq(parent.GetLevel(), 0, "changing child level does not affect parent");
    checkEq(child.GetLevel(),  3, "child level updated independently");

    // Deeper nesting
    let grandchild = child.Child("Task");
    check(String.Contains(grandchild._prefix, "Worker"), "grandchild prefix contains Worker");
    check(String.Contains(grandchild._prefix, "Task"),   "grandchild prefix contains Task");

    File.Delete(path);
}

// ============================================================
// 20. InfoWith / DebugWith / WarnWith / ErrorWith / _formatFields
// ============================================================

fn test_with_methods() {
    Console.WriteLine("== InfoWith / DebugWith / WarnWith / ErrorWith ==");
    let path = Path.Combine(Os.TempDir(), "_test_logger_with.log");
    if (File.Exists(path)) { File.Delete(path); }

    let log = new Logger();
    log.SetLevel(Logger.DEBUG);
    log.SetOutput("file", path);

    log.InfoWith("startup",  { port: 8080, env: "prod" });
    log.DebugWith("trace",   { step: 1 });
    log.WarnWith("slow",     { latency: 250 });
    log.ErrorWith("failure", { code: 500 });

    let contents = File.ReadText(path);

    // InfoWith
    check(String.Contains(contents, "[INF] startup"),  "InfoWith writes INF line");
    check(String.Contains(contents, "port=8080"),      "InfoWith includes port field");
    check(String.Contains(contents, "env=prod"),       "InfoWith includes env field");

    // DebugWith
    check(String.Contains(contents, "[DBG] trace"),    "DebugWith writes DBG line");
    check(String.Contains(contents, "step=1"),         "DebugWith includes step field");

    // WarnWith
    check(String.Contains(contents, "[WRN] slow"),     "WarnWith writes WRN line");
    check(String.Contains(contents, "latency=250"),    "WarnWith includes latency field");

    // ErrorWith
    check(String.Contains(contents, "[ERR] failure"),  "ErrorWith writes ERR line");
    check(String.Contains(contents, "code=500"),       "ErrorWith includes code field");

    File.Delete(path);
}

fn test_format_fields() {
    Console.WriteLine("== _formatFields ==");
    let log = new Logger();

    let result = log._formatFields({ a: 1, b: "hello" });
    check(String.Contains(result, "a=1"),       "_formatFields includes a=1");
    check(String.Contains(result, "b=hello"),   "_formatFields includes b=hello");
    check(String.StartsWith(result, " "),       "_formatFields starts with space separator");

    let empty = log._formatFields({});
    checkEq(empty, "", "_formatFields empty object returns empty string");
}

fn test_json_output() {
    Console.WriteLine("== JSON output ==");
    let path = Path.Combine(Os.TempDir(), "flaris_test_logger_json.log");
    if (File.Exists(path)) File.Delete(path);

    let log = new Logger();
    log.SetJson(true);
    log.SetOutput("file", path);
    log.SetPrefix("svc");
    log.Info("hello", { userId: 42, ok: true });
    log.Error("boom", { code: 500 });
    log.InfoWith("metric", { latencyMs: 12 });

    let lines = String.Split(String.Trim(File.ReadText(path)), "\n");
    checkEq(len(lines), 3, "JSON: one object per log call");

    let e0 = Json.Parse(lines[0]);
    checkEq(e0.level, "INFO", "JSON level");
    checkEq(e0.msg, "hello", "JSON msg");
    checkEq(e0.userId, 42, "JSON merged field userId");
    checkEq(e0.ok, true, "JSON merged field ok");
    checkEq(e0.logger, "svc", "JSON logger prefix");
    check(Object.HasKey(e0, "time"), "JSON has time");

    let e1 = Json.Parse(lines[1]);
    checkEq(e1.level, "ERROR", "JSON error level");
    checkEq(e1.code, 500, "JSON error field");

    let e2 = Json.Parse(lines[2]);
    checkEq(e2.latencyMs, 12, "JSON InfoWith carries fields structurally");

    File.Delete(path);
}

fn test_rotation() {
    Console.WriteLine("== File rotation ==");
    let path = Path.Combine(Os.TempDir(), "flaris_test_logger_rot.log");
    var c = 0;
    while (c <= 5) { if (File.Exists(path + "." + str(c))) File.Delete(path + "." + str(c)); c += 1; }
    if (File.Exists(path)) File.Delete(path);

    let log = new Logger();
    log.SetOutput("file", path);
    log.SetRotation(200, 3);     // rotate ~every 200 bytes, keep 3 backups

    var i = 0;
    while (i < 60) { log.Info("rotation line " + str(i) + " with some padding"); i += 1; }

    check(File.Exists(path),        "active log exists after rotation");
    check(File.Exists(path + ".1"), "backup .1 created");
    check(File.Exists(path + ".2"), "backup .2 created");
    check(File.Exists(path + ".3"), "backup .3 created");
    check(!File.Exists(path + ".4"), "no .4 (maxFiles=3 respected)");

    // cleanup
    File.Delete(path);
    var k = 1;
    while (k <= 3) { if (File.Exists(path + "." + str(k))) File.Delete(path + "." + str(k)); k += 1; }
}

