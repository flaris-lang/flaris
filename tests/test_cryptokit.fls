// test_cryptokit.fls
// Tests for CryptoKit.fls - Kdf (HKDF, PBKDF2), Otp (HOTP, TOTP), Password
// (Argon2id PHC), Envelope (sealed blobs) and Digest (streaming
// MD5/SHA-1/SHA-256/SHA-384/SHA-512).
//
// Vectors come from RFC 5869 (HKDF), RFC 6070 and the PBKDF2 test suite,
// RFC 4226 (HOTP), RFC 6238 (TOTP) and RFC 1321 (MD5). SHA-1, SHA-256 and
// SHA-512 are checked against the VM's own native digests over many lengths
// and chunkings; SHA-384 has no native counterpart, so it is checked against
// vectors computed independently plus cross-chunking consistency on a 1 MB
// message. SHA-384/512 need VM 1.0.3.0 or later (`>>>` and the JIT fix for
// [int] arrays outside the tagged range).

import { Kdf, Otp, Password, Envelope, Digest } from library("libs/CryptoKit", "1.0");
import { Util } from library("Util", "1.0");

global passed = 0;
global failed = 0;
global _sink  = 0;

fn bench(name: string, f: fn, n: int) {
    f(); f(); f();
    let t0: int = Time.Ticks();
    iter (i from 0 to n - 1) { f(); }
    let dt: int = Time.Ticks() - t0;
    let ms: float = Time.TicksToMs(dt);
    let us: float = Time.TicksToUs(dt) / float(n);
    Console.WriteLine(
        String.PadRight(name, 48),
        String.PadLeft(String.FormatArray("{0:.2f}", [ms]),   9), " ms  ",
        String.PadLeft(String.FormatArray("{0:.4f}", [us]),  11), " µs/call"
    );
}

fn benchSep() { Console.WriteLine(String.Repeat("-", 74)); }

fn assert(name: string, cond: bool) {
    if (cond) {
        Console.WriteLine("[PASS] " + name);
        passed += 1;
    } else {
        Console.WriteLine("[FAIL] " + name);
        failed += 1;
    }
}

fn assertEq(name: string, got, want) {
    if (got == want) {
        Console.WriteLine("[PASS] " + name);
        passed += 1;
    } else {
        Console.WriteLine("[FAIL] " + name + "\n       got:  " + str(got) + "\n       want: " + str(want));
        failed += 1;
    }
}

// n bytes of value v.
fn bytes(v: int, n: int): block {
    let b = Buffer.Create(n, 1);
    Buffer.Fill(b, v);
    return b;
}

// n bytes counting up from `from`.
fn counting(from: int, n: int): block {
    let b = Buffer.Create(n, 1);
    let i = 0;
    while (i < n) { b[i] = (from + i) & 255; i = i + 1; }
    return b;
}

// n bytes of a fixed pseudo-random pattern.
fn pattern(n: int): block {
    let b = Buffer.Create(n, 1);
    let i = 0;
    while (i < n) { b[i] = (i * 7 + (i >> 3) * 13 + 3) & 255; i = i + 1; }
    return b;
}

fn hex(b): string {
    if (b == nil) { return "nil"; }
    return Util.BinToHex(b);
}

// ============================================================
//  Kdf
// ============================================================

fn testKdf() {
    Console.WriteLine("\n--- Kdf: HKDF (RFC 5869) ---");
    let ikm  = bytes(0x0b, 22);
    let salt = counting(0, 13);
    let info = counting(0xf0, 10);

    let prk1 = Kdf.HkdfExtract(salt, ikm);
    assertEq("HKDF TC1 PRK", hex(prk1), "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5");
    assertEq("HKDF TC1 OKM", hex(Kdf.HkdfExpand(prk1, info, 42)),
        "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865");
    assertEq("HKDF TC1 one-call", hex(Kdf.Hkdf(ikm, salt, info, 42)),
        "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865");

    let prk2 = Kdf.HkdfExtract(counting(0x60, 80), counting(0, 80));
    assertEq("HKDF TC2 PRK (80-byte inputs)", hex(prk2), "06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244");
    assertEq("HKDF TC2 OKM (82 bytes, 3 blocks)", hex(Kdf.HkdfExpand(prk2, counting(0xb0, 80), 82)),
        "b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71cc30c58179ec3e87c14c01d5c1f3434f1d87");

    assertEq("HKDF TC3 PRK (nil salt)", hex(Kdf.HkdfExtract(nil, ikm)), "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04");
    assertEq("HKDF TC3 OKM (nil salt, nil info)", hex(Kdf.Hkdf(ikm, nil, nil, 42)),
        "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8");
    assertEq("HKDF TC3 with empty strings", hex(Kdf.Hkdf(ikm, "", "", 42)),
        "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8");

    assertEq("HKDF TC4 PRK (SHA-1)", hex(Kdf.HkdfExtract(salt, bytes(0x0b, 11), "sha1")), "9b6c18c432a7bf8f0e71c8eb88f4b30baa2ba243");
    assertEq("HKDF TC4 OKM (SHA-1)", hex(Kdf.Hkdf(bytes(0x0b, 11), salt, info, 42, "SHA-1")),
        "085a01ea1b10f36933068b56efa5ad81a4f14b822f5b091568a9cdd4f155fda2c22e422478d305f3f896");

    assertEq("HKDF SHA-512 PRK is 64 bytes", len(Kdf.HkdfExtract(salt, ikm, "sha512")), 64);
    assertEq("HKDF length 1", len(Kdf.Hkdf(ikm, salt, info, 1)), 1);
    assertEq("HKDF max length 255*32", len(Kdf.Hkdf(ikm, salt, info, 255 * 32)), 8160);
    assert("HKDF length 0 -> nil", Kdf.Hkdf(ikm, salt, info, 0) == nil);
    assert("HKDF length > 255*HashLen -> nil", Kdf.Hkdf(ikm, salt, info, 255 * 32 + 1) == nil);
    assert("HKDF unknown hash -> nil", Kdf.Hkdf(ikm, salt, info, 32, "md5") == nil);
    assert("HKDF empty ikm -> nil", Kdf.Hkdf("", salt, info, 32) == nil);
    assert("HKDF non-bytes ikm -> nil", Kdf.Hkdf(42, salt, info, 32) == nil);

    Console.WriteLine("\n--- Kdf: PBKDF2 (RFC 6070 / RFC 7914 vectors) ---");
    assertEq("PBKDF2-SHA1 c=1",    hex(Kdf.Pbkdf2("password", "salt", 1, 20, "sha1")),    "0c60c80f961f0e71f3a9b524af6012062fe037a6");
    assertEq("PBKDF2-SHA1 c=2",    hex(Kdf.Pbkdf2("password", "salt", 2, 20, "sha1")),    "ea6c014dc72d6f8ccd1ed92ace1d41f0d8de8957");
    assertEq("PBKDF2-SHA1 c=4096", hex(Kdf.Pbkdf2("password", "salt", 4096, 20, "sha1")), "4b007901b765489abead49d926f721d065a429c1");
    assertEq("PBKDF2-SHA1 c=4096 dkLen=25 (2 blocks)",
        hex(Kdf.Pbkdf2("passwordPASSWORDpassword", "saltSALTsaltSALTsaltSALTsaltSALTsalt", 4096, 25, "sha1")),
        "3d2eec4fe41c849b80c8d83662c0e44a8b291a964cf2f07038");
    assertEq("PBKDF2-SHA256 c=1 (default hash)", hex(Kdf.Pbkdf2("password", "salt", 1, 32)),
        "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b");
    assertEq("PBKDF2-SHA256 c=4096", hex(Kdf.Pbkdf2("password", "salt", 4096, 32, "sha256")),
        "c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a");
    assertEq("PBKDF2-SHA256 c=4096 dkLen=40 (2 blocks)",
        hex(Kdf.Pbkdf2("passwordPASSWORDpassword", "saltSALTsaltSALTsaltSALTsaltSALTsalt", 4096, 40)),
        "348c89dbcbd32b2f32d814b8116e84cf2b17347ebc1800181c4e2a1fb8dd53e1c635518c7dac47e9");
    assertEq("PBKDF2-SHA512 c=1 dkLen=64", hex(Kdf.Pbkdf2("password", "salt", 1, 64, "sha512")),
        "867f70cf1ade02cff3752599a3a53dc4af34c7a669815ae5d513554e1c8cf252c02d470a285a0501bad999bfe943c08f050235d7d68b1da55e63f73b60a57fce");

    // Password and salt with embedded NUL bytes, given as blocks.
    let pw = Buffer.FromString("passXword"); pw[4] = 0;
    let sa = Buffer.FromString("saXlt");     sa[2] = 0;
    assertEq("PBKDF2-SHA256 with NUL bytes in password and salt (blocks)",
        hex(Kdf.Pbkdf2(pw, sa, 4096, 16)), "89b69d0516f829893c696226650a8687");
    assertEq("PBKDF2 block password == string password",
        hex(Kdf.Pbkdf2(Buffer.FromString("password"), Buffer.FromString("salt"), 1, 32)),
        hex(Kdf.Pbkdf2("password", "salt", 1, 32)));

    assert("PBKDF2 iterations 0 -> nil", Kdf.Pbkdf2("password", "salt", 0, 32) == nil);
    assert("PBKDF2 length 0 -> nil",     Kdf.Pbkdf2("password", "salt", 1, 0) == nil);
    assert("PBKDF2 bad hash -> nil",     Kdf.Pbkdf2("password", "salt", 1, 32, "blake2") == nil);
    assertEq("PBKDF2 empty salt allowed", len(Kdf.Pbkdf2("password", "", 1, 32)), 32);

    Console.WriteLine("\n--- Kdf: hex helpers ---");
    assertEq("HexToBytes",        hex(Kdf.HexToBytes("0aFF10")), "0aff10");
    assert("HexToBytes odd length -> nil", Kdf.HexToBytes("abc") == nil);
    assert("HexToBytes non-hex -> nil",    Kdf.HexToBytes("zz") == nil);
    assert("HexToBytes empty -> nil",      Kdf.HexToBytes("") == nil);
    assertEq("BytesToHex", Kdf.BytesToHex(counting(250, 6)), "fafbfcfdfeff");
    let ss = Kdf.HexToBytes(Crypto.HmacSha256("k", "v"));
    assertEq("HexToBytes on a native MAC gives 32 bytes", len(ss), 32);
}

// ============================================================
//  Otp
// ============================================================

fn testOtp() {
    Console.WriteLine("\n--- Otp: HOTP (RFC 4226) ---");
    let secret = "12345678901234567890";
    let want = ["755224", "287082", "359152", "969429", "338314", "254676", "287922", "162583", "399871", "520489"];
    let allOk = true;
    let c = 0;
    while (c < 10) {
        if (Otp.Hotp(secret, c) != want[c]) { allOk = false; Console.WriteLine("   counter " + str(c) + ": " + str(Otp.Hotp(secret, c)) + " != " + want[c]); }
        c = c + 1;
    }
    assert("HOTP counters 0..9 match RFC 4226 Appendix D", allOk);
    assertEq("HOTP secret as block", Otp.Hotp(Buffer.FromString(secret), 0), "755224");
    assertEq("HOTP 8 digits", Otp.Hotp(secret, 0, 8), "84755224");
    assertEq("HOTP 7 digits", Otp.Hotp(secret, 0, 7), "4755224");
    assert("HOTP digits 5 -> nil",  Otp.Hotp(secret, 0, 5) == nil);
    assert("HOTP digits 9 -> nil",  Otp.Hotp(secret, 0, 9) == nil);
    assert("HOTP negative counter -> nil", Otp.Hotp(secret, -1) == nil);
    assert("HOTP empty secret -> nil", Otp.Hotp("", 0) == nil);
    assert("HOTP bad hash -> nil", Otp.Hotp(secret, 0, 6, "md5") == nil);

    Console.WriteLine("\n--- Otp: TOTP (RFC 6238 Appendix B) ---");
    let times = [59, 1111111109, 1111111111, 1234567890, 2000000000, 20000000000];
    let sha1Want   = ["94287082", "07081804", "14050471", "89005924", "69279037", "65353130"];
    let sha256Want = ["46119246", "68084774", "67062674", "91819424", "90698825", "77737706"];
    let sha512Want = ["90693936", "25091201", "99943326", "93441116", "38618901", "47863826"];
    let secret256 = "12345678901234567890123456789012";
    let secret512 = "1234567890123456789012345678901234567890123456789012345678901234";
    let ok1 = true; let ok256 = true; let ok512 = true;
    let i = 0;
    while (i < 6) {
        if (Otp.Totp(secret,    times[i], 30, 8)           != sha1Want[i])   { ok1 = false; }
        if (Otp.Totp(secret256, times[i], 30, 8, "sha256") != sha256Want[i]) { ok256 = false; }
        if (Otp.Totp(secret512, times[i], 30, 8, "sha512") != sha512Want[i]) { ok512 = false; }
        i = i + 1;
    }
    assert("TOTP SHA-1   6 timestamps", ok1);
    assert("TOTP SHA-256 6 timestamps", ok256);
    assert("TOTP SHA-512 6 timestamps", ok512);
    assertEq("TOTP default step/digits at T=59", Otp.Totp(secret, 59), "287082");   // counter 1 -> HOTP(1)
    assert("TOTP now returns 6 digits", len(Otp.Totp(secret)) == 6);
    assert("TOTP step 0 -> nil", Otp.Totp(secret, 59, 0) == nil);

    Console.WriteLine("\n--- Otp: TotpVerify ---");
    assert("verify exact step",              Otp.TotpVerify(secret, "94287082", 1, 59, 30, 8));
    assert("verify previous step (window 1)", Otp.TotpVerify(secret, "94287082", 1, 89, 30, 8));
    assert("verify next step (window 1)",     Otp.TotpVerify(secret, "94287082", 1, 29, 30, 8));
    assert("reject two steps away (window 1)", !Otp.TotpVerify(secret, "94287082", 1, 119, 30, 8));
    assert("accept two steps away (window 2)", Otp.TotpVerify(secret, "94287082", 2, 119, 30, 8));
    assert("reject with window 0 off-step",  !Otp.TotpVerify(secret, "94287082", 0, 89, 30, 8));
    assert("reject wrong code",              !Otp.TotpVerify(secret, "00000000", 1, 59, 30, 8));
    assert("reject wrong length",            !Otp.TotpVerify(secret, "9428708", 1, 59, 30, 8));
    assert("reject non-digit",               !Otp.TotpVerify(secret, "9428708a", 1, 59, 30, 8));
    assert("reject nil code",                !Otp.TotpVerify(secret, nil, 1, 59, 30, 8));
    assert("reject negative window",         !Otp.TotpVerify(secret, "94287082", -1, 59, 30, 8));
    assert("6-digit default verify",         Otp.TotpVerify(secret, "287082", 1, 59));

    Console.WriteLine("\n--- Otp: secrets and provisioning ---");
    let b32 = Otp.NewSecret();
    assertEq("NewSecret is 32 Base32 chars (20 bytes)", len(b32), 32);
    assert("NewSecret has no padding", String.IndexOf(b32, "=") < 0);
    let raw = Otp.SecretFromBase32(b32);
    assertEq("SecretFromBase32 gives 20 bytes", len(raw), 20);
    assertEq("Base32 roundtrip", String.Replace(Util.Base32Encode(raw), "=", ""), b32);
    assert("NewSecret differs per call", Otp.NewSecret() != b32);
    assertEq("NewSecret(32) -> 52 chars", len(Otp.NewSecret(32)), 52);
    assertEq("SecretFromBase32 lower case + spaces", hex(Otp.SecretFromBase32("jbsw y3dp ehpk 3pxp")), "48656c6c6f21deadbeef");
    assertEq("SecretFromBase32 8 chars = 5 bytes", hex(Otp.SecretFromBase32("JBSWY3DP")), "48656c6c6f");
    assertEq("SecretFromBase32 with padding", hex(Otp.SecretFromBase32("JBSWY3DPEE======")), "48656c6c6f21");
    assert("SecretFromBase32 empty -> nil", Otp.SecretFromBase32("") == nil);
    assert("SecretFromBase32 nil -> nil", Otp.SecretFromBase32(nil) == nil);

    assertEq("ProvisioningUri default",
        Otp.ProvisioningUri("Acme Co", "sam@acme.io", "jbswy3dpehpk3pxp"),
        "otpauth://totp/Acme%20Co:sam%40acme.io?secret=JBSWY3DPEHPK3PXP&issuer=Acme%20Co&algorithm=SHA1&digits=6&period=30");
    assertEq("ProvisioningUri with opts",
        Otp.ProvisioningUri("Acme", "sam", "JBSWY3DPEHPK3PXP", { digits: 8, step: 60, hash: "sha256" }),
        "otpauth://totp/Acme:sam?secret=JBSWY3DPEHPK3PXP&issuer=Acme&algorithm=SHA256&digits=8&period=60");
    assert("ProvisioningUri bad digits -> nil", Otp.ProvisioningUri("Acme", "sam", "JBSWY3DP", { digits: 4 }) == nil);
    assert("ProvisioningUri empty secret -> nil", Otp.ProvisioningUri("Acme", "sam", "") == nil);

    // Enrolment round trip: the secret the app scans verifies the code the app shows.
    let enrolled = Otp.SecretFromBase32(b32);
    let shown = Otp.Totp(enrolled);
    assert("enrolment round trip verifies", Otp.TotpVerify(enrolled, shown));
}

// ============================================================
//  Password
// ============================================================

fn testPassword() {
    Console.WriteLine("\n--- Password: Argon2id PHC strings ---");
    let fast = { memKiB: 1024, iterations: 1 };
    let phc = Password.Hash("correct horse battery staple", fast);
    assert("Hash returns a string", Type.Of(phc) == Type.String);
    assert("PHC prefix", String.StartsWith(phc, "$argon2id$v=19$m=1024,t=1,p=1$"));
    assertEq("PHC has 6 '$'-separated fields", len(String.Split(phc, "$")), 6);
    assert("Verify correct password", Password.Verify("correct horse battery staple", phc));
    assert("Verify wrong password", !Password.Verify("correct horse battery stapl", phc));
    assert("Verify wrong case", !Password.Verify("Correct horse battery staple", phc));
    assert("Verify block password", Password.Verify(Buffer.FromString("correct horse battery staple"), phc));
    assert("Two hashes of one password differ (random salt)", Password.Hash("x", fast) != Password.Hash("x", fast));

    let p = Password.Parse(phc);
    assert("Parse returns an object", p != nil);
    assertEq("Parse memKiB", p.memKiB, 1024);
    assertEq("Parse iterations", p.iterations, 1);
    assertEq("Parse parallelism", p.parallelism, 1);
    assertEq("Parse version", p.version, 19);
    assertEq("Parse salt is 16 bytes", len(p.salt), 16);
    assertEq("Parse hash is 32 bytes", len(p.hash), 32);
    assertEq("Parse hash == Argon2 of (password, salt)", hex(p.hash),
        Crypto.Argon2("correct horse battery staple", p.salt, 1, 1024));

    // A PHC string assembled by hand from the VM's own Argon2 output verifies.
    let salt = Kdf.HexToBytes("000102030405060708090a0b0c0d0e0f");
    let tagHex = Crypto.Argon2("hunter2", salt, 2, 2048);
    let handMade = "$argon2id$v=19$m=2048,t=2,p=1$" + String.Replace(Util.Base64Encode(salt), "=", "")
                 + "$" + String.Replace(Util.Base64Encode(Kdf.HexToBytes(tagHex)), "=", "");
    assert("hand-assembled PHC verifies", Password.Verify("hunter2", handMade));
    assert("PHC without v=19 segment parses", Password.Parse(String.Replace(handMade, "$v=19", "")) != nil);
    assert("PHC without v=19 verifies", Password.Verify("hunter2", String.Replace(handMade, "$v=19", "")));

    Console.WriteLine("\n--- Password: rejects ---");
    assert("Verify tampered hash char", !Password.Verify("hunter2", String.Substr(handMade, 0, len(handMade) - 1) + "A"));
    assert("Verify p=2 -> false",       !Password.Verify("hunter2", String.Replace(handMade, "p=1", "p=2")));
    assert("Verify argon2i -> false",   !Password.Verify("hunter2", String.Replace(handMade, "argon2id", "argon2i")));
    assert("Verify garbage -> false",   !Password.Verify("hunter2", "not a phc string"));
    assert("Verify nil -> false",       !Password.Verify("hunter2", nil));
    assert("Verify empty -> false",     !Password.Verify("hunter2", ""));
    assert("Verify m=abc -> false",     !Password.Verify("hunter2", String.Replace(handMade, "m=2048", "m=abc")));
    assert("Parse short salt -> nil",   Password.Parse("$argon2id$v=19$m=2048,t=2,p=1$YWJj$" + String.Substr(handMade, len(handMade) - 43)) == nil);
    assert("Hash memKiB below 8 -> nil", Password.Hash("x", { memKiB: 4 }) == nil);
    assert("Hash iterations 0 -> nil",   Password.Hash("x", { iterations: 0 }) == nil);
    assert("Hash non-int opt -> nil",    Password.Hash("x", { memKiB: "lots" }) == nil);
    assert("Hash non-bytes password -> nil", Password.Hash(12345) == nil);

    Console.WriteLine("\n--- Password: NeedsRehash ---");
    assert("same params -> false",          !Password.NeedsRehash(phc, fast));
    assert("higher memory wanted -> true",   Password.NeedsRehash(phc, { memKiB: 2048, iterations: 1 }));
    assert("higher iterations wanted -> true", Password.NeedsRehash(phc, { memKiB: 1024, iterations: 2 }));
    assert("defaults wanted, weak hash -> true", Password.NeedsRehash(phc));
    assert("garbage -> true",                Password.NeedsRehash("nope"));
    assert("p=2 -> true",                    Password.NeedsRehash(String.Replace(handMade, "p=1", "p=2"), { memKiB: 8, iterations: 1 }));
    let strong = Password.Hash("pw");
    assert("default-params hash verifies",   Password.Verify("pw", strong));
    assert("default-params hash needs no rehash", !Password.NeedsRehash(strong));
    assert("default PHC prefix", String.StartsWith(strong, "$argon2id$v=19$m=65536,t=3,p=1$"));
}

// ============================================================
//  Envelope
// ============================================================

fn testEnvelope() {
    Console.WriteLine("\n--- Envelope: key-sealed ---");
    let key = Envelope.NewKey();
    assertEq("NewKey is 32 bytes", len(key), 32);
    let blob = Envelope.Seal("attack at dawn", key);
    assert("Seal returns a block", Type.Of(blob) == Type.Block);
    assertEq("blob length = 1 + 24 + 16 + n", len(blob), 1 + 24 + 16 + 14);
    assertEq("version byte 1", blob[0], 1);
    let back = Envelope.Open(blob, key);
    assert("Open returns a block", Type.Of(back) == Type.Block);
    assertEq("Open gives the plaintext", Buffer.ToString(back), "attack at dawn");
    assert("Seal twice differs (fresh nonce)", !Buffer.Equals(blob, Envelope.Seal("attack at dawn", key)));
    assert("Open with wrong key -> nil", Envelope.Open(blob, Envelope.NewKey()) == nil);
    assert("Open with 31-byte key -> nil", Envelope.Open(blob, Buffer.Slice(key, 0, 31)) == nil);
    assert("Seal with 31-byte key -> nil", Envelope.Seal("x", Buffer.Slice(key, 0, 31)) == nil);
    assert("Seal empty plaintext -> nil", Envelope.Seal("", key) == nil);
    assert("Seal nil -> nil", Envelope.Seal(nil, key) == nil);
    assert("key as 32-char string works", Buffer.ToString(Envelope.Open(Envelope.Seal("hi", "01234567890123456789012345678901"), "01234567890123456789012345678901")) == "hi");

    let n = len(blob);
    let t1 = Buffer.Slice(blob, 0, n); t1[n - 1] = t1[n - 1] ^ 1;
    assert("flipped ciphertext bit -> nil", Envelope.Open(t1, key) == nil);
    let t2 = Buffer.Slice(blob, 0, n); t2[30] = t2[30] ^ 1;
    assert("flipped tag bit -> nil", Envelope.Open(t2, key) == nil);
    let t3 = Buffer.Slice(blob, 0, n); t3[5] = t3[5] ^ 1;
    assert("flipped nonce bit -> nil", Envelope.Open(t3, key) == nil);
    let t4 = Buffer.Slice(blob, 0, n); t4[0] = 2;
    assert("wrong version byte -> nil", Envelope.Open(t4, key) == nil);
    assert("truncated by one byte -> nil", Envelope.Open(Buffer.Slice(blob, 0, n - 1), key) == nil);
    assert("header only -> nil", Envelope.Open(Buffer.Slice(blob, 0, 41), key) == nil);
    assert("nil blob -> nil", Envelope.Open(nil, key) == nil);
    assert("string blob (bytes) works", Buffer.ToString(Envelope.Open(Buffer.ToString(blob), key)) == "attack at dawn");

    let big = pattern(1 << 20);
    let bigBlob = Envelope.Seal(big, key);
    assert("1 MB round trip", Buffer.Equals(Envelope.Open(bigBlob, key), big));

    Console.WriteLine("\n--- Envelope: password-sealed ---");
    let fast = { memKiB: 1024, iterations: 1 };
    let pblob = Envelope.SealWithPassword("attack at dusk", "open sesame", fast);
    assert("SealWithPassword returns a block", Type.Of(pblob) == Type.Block);
    assertEq("version byte 2", pblob[0], 2);
    assertEq("header records memKiB", Buffer.ReadU32At(pblob, 1, true), 1024);
    assertEq("header records iterations", pblob[5], 1);
    assertEq("blob length = 22 + 24 + 16 + n", len(pblob), 22 + 24 + 16 + 14);
    assertEq("OpenWithPassword gives the plaintext", Buffer.ToString(Envelope.OpenWithPassword(pblob, "open sesame")), "attack at dusk");
    assert("wrong password -> nil", Envelope.OpenWithPassword(pblob, "open sesamee") == nil);
    assert("key-sealed blob to OpenWithPassword -> nil", Envelope.OpenWithPassword(blob, "open sesame") == nil);
    assert("password blob to Open -> nil", Envelope.Open(pblob, key) == nil);
    let pn = len(pblob);
    let t5 = Buffer.Slice(pblob, 0, pn); t5[4] = t5[4] ^ 1;
    assert("tampered memKiB header -> nil", Envelope.OpenWithPassword(t5, "open sesame") == nil);
    let t6 = Buffer.Slice(pblob, 0, pn); t6[10] = t6[10] ^ 1;
    assert("tampered salt -> nil", Envelope.OpenWithPassword(t6, "open sesame") == nil);
    assert("SealWithPassword bad opts -> nil", Envelope.SealWithPassword("x", "pw", { memKiB: 1 }) == nil);
    assert("DeriveKey is 32 bytes", len(Envelope.DeriveKey("pw", "0123456789abcdef", fast)) == 32);
    assert("DeriveKey short salt -> nil", Envelope.DeriveKey("pw", "short", fast) == nil);
    assertEq("DeriveKey == Argon2", hex(Envelope.DeriveKey("pw", "0123456789abcdef", fast)), Crypto.Argon2("pw", "0123456789abcdef", 1, 1024));
    let dblob = Envelope.SealWithPassword("defaults", "pw");
    assertEq("default-cost password blob opens", Buffer.ToString(Envelope.OpenWithPassword(dblob, "pw")), "defaults");
}

