// Feed `data` to a fresh hasher in chunks of the given sizes, cycling.
fn chunkedHex(algo: string, data: block, sizes: array): string {
    let d = new Digest(algo);
    let n = len(data);
    let pos = 0;
    let k = 0;
    while (pos < n) {
        let sz = sizes[k % len(sizes)];
        if (sz > n - pos) { sz = n - pos; }
        d.Update(Buffer.Slice(data, pos, sz));
        pos = pos + sz;
        k = k + 1;
    }
    return d.Final();
}

fn testDigest() {
    Console.WriteLine("\n--- Digest: MD5 (RFC 1321) ---");
    assertEq("MD5 empty",          Digest.Md5(""), "d41d8cd98f00b204e9800998ecf8427e");
    assertEq("MD5 a",              Digest.Md5("a"), "0cc175b9c0f1b6a831c399e269772661");
    assertEq("MD5 abc",            Digest.Md5("abc"), "900150983cd24fb0d6963f7d28e17f72");
    assertEq("MD5 message digest", Digest.Md5("message digest"), "f96b697d7cb7938d525a2f31aaf161d0");
    assertEq("MD5 a..z",           Digest.Md5("abcdefghijklmnopqrstuvwxyz"), "c3fcd3d76192e4007dfb496cca67e13b");
    assertEq("MD5 1e6 x 'a'",      Digest.Md5(bytes(0x61, 1000000)), "7707d6ae4e027c70eea2a935c2296f21");
    assertEq("MD5 raw is 16 bytes", len(Digest.Md5("abc", true)), 16);
    assertEq("MD5 raw == hex",     hex(Digest.Md5("abc", true)), Digest.Md5("abc"));
    assertEq("MD5 55 bytes (pad boundary)", Digest.Md5(bytes(0x61, 55)), "ef1772b6dff9a122358552954ad0df65");
    assertEq("MD5 56 bytes (pad boundary)", Digest.Md5(bytes(0x61, 56)), "3b0c8ac703f828b04c6c197006d17218");
    assertEq("MD5 64 bytes (one block)",    Digest.Md5(bytes(0x61, 64)), "014842d480b571495a4a0363793f7367");
    assert("MD5 non-bytes -> nil", Digest.Md5(42) == nil);

    Console.WriteLine("\n--- Digest: SHA-1 / SHA-256 against the native digests ---");
    let algos = ["sha1", "sha256"];
    let a = 0;
    while (a < 2) {
        let algo = algos[a];
        let mismatches = 0;
        let n = 1;
        while (n <= 200) {
            let data = pattern(n);
            let want = (algo == "sha1") ? Hash.Sha1(data) : Hash.Sha256(data);
            let d = new Digest(algo);
            if (d.Update(data).Final() != want) { mismatches = mismatches + 1; }
            if (chunkedHex(algo, data, [1, 3, 7, 64, 63, 65, 100]) != want) { mismatches = mismatches + 1; }
            n = n + 1;
        }
        assert(algo + " lengths 1..200, whole and chunked: " + str(mismatches) + " mismatches", mismatches == 0);
        let emptyWant = (algo == "sha1") ? Hash.Sha1("") : Hash.Sha256("");
        assertEq(algo + " empty input", new Digest(algo).Final(), emptyWant);
        let big = pattern(1 << 20);
        let bigWant = (algo == "sha1") ? Hash.Sha1(big) : Hash.Sha256(big);
        assertEq(algo + " 1 MB whole", new Digest(algo).Update(big).Final(), bigWant);
        assertEq(algo + " 1 MB in 4 KB chunks", chunkedHex(algo, big, [4096]), bigWant);
        assertEq(algo + " 1 MB in odd chunks", chunkedHex(algo, big, [1000, 1, 4095, 64]), bigWant);
        a = a + 1;
    }
    assertEq("sha256 abc", new Digest("SHA-256").Update("abc").Final(), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    assertEq("sha1 abc",   new Digest("sha1").Update("abc").Final(), "a9993e364706816aba3e25717850c26c9cd0d89d");

    Console.WriteLine("\n--- Digest: SHA-512 against the native digest ---");
    let mismatches512 = 0;
    let n512 = 1;
    while (n512 <= 300) {
        let data = pattern(n512);
        let want = Hash.Sha512(data);
        if (new Digest("sha512").Update(data).Final() != want) { mismatches512 = mismatches512 + 1; }
        if (chunkedHex("sha512", data, [1, 17, 127, 128, 129, 256, 200]) != want) { mismatches512 = mismatches512 + 1; }
        n512 = n512 + 1;
    }
    assert("sha512 lengths 1..300, whole and chunked: " + str(mismatches512) + " mismatches", mismatches512 == 0);
    assertEq("sha512 empty", new Digest("sha512").Final(), Hash.Sha512(""));
    assertEq("sha512 abc", new Digest("sha512").Update("abc").Final(),
        "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
    let big512 = pattern(1 << 20);
    let big512Want = Hash.Sha512(big512);
    assertEq("sha512 1 MB whole", new Digest("sha512").Update(big512).Final(), big512Want);
    assertEq("sha512 1 MB in 4 KB chunks", chunkedHex("sha512", big512, [4096]), big512Want);
    assertEq("sha512 1 MB in odd chunks (exercises the 128-byte block boundary)", chunkedHex("sha512", big512, [1000, 1, 4095, 127, 128, 129]), big512Want);
    assertEq("sha512 raw is 64 bytes", len(new Digest("sha512").Update("abc").Final(true)), 64);

    Console.WriteLine("\n--- Digest: SHA-384 against precomputed vectors (no native oracle) ---");
    // No Hash.Sha384 exists in the VM, so correctness at the padding boundaries
    // (bufLen 111/112, whole 128/256-byte messages) is checked against vectors
    // computed independently (Python's hashlib). Larger-input correctness is
    // then established by consistency: many chunkings of a 1 MB message must
    // all agree with the one-shot Update, which they can only do if the
    // buffering and 128-byte block math are right end to end.
    let mismatches384 = 0;
    let k384 = 0;
    while (k384 < len(SHA384_TEST_LENS)) {
        let n384 = SHA384_TEST_LENS[k384];
        let want384 = SHA384_TEST_HEX[k384];
        let data384 = pattern(n384);
        if (new Digest("sha384").Update(data384).Final() != want384) {
            mismatches384 = mismatches384 + 1;
            Console.WriteLine("   sha384 len " + str(n384) + " mismatch");
        }
        if (chunkedHex("sha384", data384, [1, 17, 111, 112, 113, 128]) != want384) { mismatches384 = mismatches384 + 1; }
        k384 = k384 + 1;
    }
    assert("sha384 " + str(len(SHA384_TEST_LENS)) + " boundary lengths, whole and chunked: " + str(mismatches384) + " mismatches", mismatches384 == 0);
    assertEq("sha384 abc", new Digest("sha384").Update("abc").Final(),
        "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7");
    assert("sha384 != sha512 (different IV, not a truncation relationship a test could fake)",
        new Digest("sha384").Update("abc").Final() != String.Substr(new Digest("sha512").Update("abc").Final(), 0, 96));
    assertEq("sha384 raw is 48 bytes", len(new Digest("sha384").Update("abc").Final(true)), 48);
    let big384 = pattern(1 << 20);
    let big384Whole = new Digest("sha384").Update(big384).Final();
    assertEq("sha384 1 MB in 4 KB chunks agrees with whole", chunkedHex("sha384", big384, [4096]), big384Whole);
    assertEq("sha384 1 MB in odd chunks (127/128/129-byte, crossing every block boundary) agrees with whole",
        chunkedHex("sha384", big384, [1000, 1, 4095, 127, 128, 129]), big384Whole);
    assertEq("sha384 1 MB byte-at-a-time agrees with whole (slow but exhaustive)",
        chunkedHex("sha384", pattern(2000), [1]), new Digest("sha384").Update(pattern(2000)).Final());

    Console.WriteLine("\n--- Digest: SHA-384/512 streaming semantics ---");
    let d512 = new Digest("sha512");
    assertEq("sha512 Algorithm()", d512.Algorithm(), "sha512");
    assertEq("sha384 Algorithm()", new Digest("sha384").Algorithm(), "sha384");
    assertEq("sha512 chained pieces == whole", d512.Update("mess").Update("age ").Update("digest").Final(), Hash.Sha512("message digest"));
    assertEq("sha512 Final is idempotent", d512.Final(), Hash.Sha512("message digest"));
    assert("sha512 Update after Final -> nil", d512.Update("x") == nil);
    assertEq("sha512 Reset then reuse", d512.Reset().Update("abc").Final(), Hash.Sha512("abc"));

    Console.WriteLine("\n--- Digest: streaming semantics ---");
    let d = new Digest("md5");
    assertEq("Algorithm()", d.Algorithm(), "md5");
    assert("Update returns this (chainable)", d.Update("mess") == d);
    assertEq("chained pieces == whole", d.Update("age ").Update("digest").Final(), "f96b697d7cb7938d525a2f31aaf161d0");
    assertEq("Final is idempotent", d.Final(), "f96b697d7cb7938d525a2f31aaf161d0");
    assert("Update after Final -> nil", d.Update("x") == nil);
    assertEq("Reset then reuse", d.Reset().Update("abc").Final(), "900150983cd24fb0d6963f7d28e17f72");
    assert("Update(nil) is a no-op", d.Reset().Update(nil) == d);
    assert("Update(\"\") is a no-op", d.Update("") == d);
    assertEq("no-op updates then Final == empty digest", d.Final(), "d41d8cd98f00b204e9800998ecf8427e");
    assert("Update(42) -> nil", d.Reset().Update(42) == nil);
    let bad = new Digest("whirlpool");
    assert("unknown algorithm: Algorithm() nil", bad.Algorithm() == nil);
    assert("unknown algorithm: Update nil", bad.Update("x") == nil);
    assert("unknown algorithm: Final nil", bad.Final() == nil);
    assertEq("Algorithms()", String.Join(Digest.Algorithms(), ","), "md5,sha1,sha256,sha384,sha512,sha3-224,sha3-256,sha3-384,sha3-512,keccak256,shake128,shake256");
    assertEq("raw sha256 is 32 bytes", len(new Digest("sha256").Update("abc").Final(true)), 32);
}

fn testKeccakFamily() {
    Console.WriteLine("\n--- Digest: SHA3-224/256/384/512 and Keccak-256 (no native oracle) ---");
    // None of these have a native counterpart in the VM, so every boundary
    // length is checked against vectors computed independently (a from-scratch
    // Keccak-f[1600] sponge, cross-checked byte-for-byte against Python's
    // built-in hashlib.sha3_* for four rates and against the well-known
    // EIP-1052 constant for Keccak-256(""), before a single vector here was
    // generated). Lengths straddle the sponge's rate boundary for each
    // algorithm - one byte under, exactly at, and one byte over the rate,
    // and again at twice the rate - since that boundary (not 55/56 as for
    // Merkle-Damgard hashes) is where this padding scheme could go wrong.
    let families = [
        ["sha3-224",   SHA3_224_LENS,   SHA3_224_HEX,   28],
        ["sha3-256",   SHA3_256_LENS,   SHA3_256_HEX,   32],
        ["sha3-384",   SHA3_384_LENS,   SHA3_384_HEX,   48],
        ["sha3-512",   SHA3_512_LENS,   SHA3_512_HEX,   64],
        ["keccak256",  KECCAK256_LENS,  KECCAK256_HEX,  32],
    ];
    let f = 0;
    while (f < len(families)) {
        let algo = families[f][0];
        let lens = families[f][1];
        let hexes = families[f][2];
        let outBytes = families[f][3];
        let mismatches = 0;
        let k = 0;
        while (k < len(lens)) {
            let n = lens[k];
            let want = hexes[k];
            let data = pattern(n);
            if (new Digest(algo).Update(data).Final() != want) { mismatches = mismatches + 1; Console.WriteLine("   " + algo + " len " + str(n) + " whole mismatch"); }
            if (chunkedHex(algo, data, [1, 7, 31, 64, 65, 100]) != want) { mismatches = mismatches + 1; Console.WriteLine("   " + algo + " len " + str(n) + " chunked mismatch"); }
            k = k + 1;
        }
        assert(algo + " " + str(len(lens)) + " boundary lengths, whole and chunked: " + str(mismatches) + " mismatches", mismatches == 0);
        assertEq(algo + " raw output length", len(new Digest(algo).Update("x").Final(true)), outBytes);
        let big = pattern(1 << 20);
        let bigWhole = new Digest(algo).Update(big).Final();
        assertEq(algo + " 1 MB in 4 KB chunks agrees with whole", chunkedHex(algo, big, [4096]), bigWhole);
        assertEq(algo + " 1 MB in odd chunks (crossing the rate boundary) agrees with whole",
            chunkedHex(algo, big, [1000, 1, 4095, 63, 64, 65]), bigWhole);
        f = f + 1;
    }

    Console.WriteLine("\n--- Digest: SHA3-256 vs Keccak-256 are genuinely different hashes ---");
    // The only difference between them is one padding byte (0x06 vs 0x01) -
    // exactly the kind of typo that would make them silently identical.
    let sameInput = pattern(500);
    assert("differ on a 500-byte input", new Digest("sha3-256").Update(sameInput).Final() != new Digest("keccak256").Update(sameInput).Final());
    assert("differ on empty input", new Digest("sha3-256").Final() != new Digest("keccak256").Final());
    assertEq("Digest.Keccak256 static helper matches the class", Digest.Keccak256("abc"), new Digest("keccak256").Update("abc").Final());
    assertEq("Keccak256('') matches the EIP-1052 constant", Digest.Keccak256(""),
        "c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470");

    Console.WriteLine("\n--- Digest: SHAKE128/256 (extendable output) ---");
    let shakeFamilies = [
        ["shake128", SHAKE128_IN, SHAKE128_OUT, SHAKE128_HEX],
        ["shake256", SHAKE256_IN, SHAKE256_OUT, SHAKE256_HEX],
    ];
    f = 0;
    while (f < len(shakeFamilies)) {
        let algo = shakeFamilies[f][0];
        let ins = shakeFamilies[f][1];
        let outs = shakeFamilies[f][2];
        let hexes = shakeFamilies[f][3];
        let mismatches = 0;
        let k = 0;
        while (k < len(ins)) {
            let data = pattern(ins[k]);
            let got = new Digest(algo).Update(data).Squeeze(outs[k]);
            if (got != hexes[k]) { mismatches = mismatches + 1; Console.WriteLine("   " + algo + " in=" + str(ins[k]) + " out=" + str(outs[k]) + " mismatch"); }
            k = k + 1;
        }
        assert(algo + " " + str(len(ins)) + " (input, output-length) cases: " + str(mismatches) + " mismatches", mismatches == 0);
        f = f + 1;
    }
    assertEq("Digest.Shake128 static helper matches the class", Digest.Shake128("abc", 32), new Digest("shake128").Update("abc").Squeeze(32));
    assertEq("Digest.Shake256 static helper matches the class", Digest.Shake256("abc", 64), new Digest("shake256").Update("abc").Squeeze(64));
    assertEq("Shake128 raw is exactly outLen bytes", len(new Digest("shake128").Update("abc").Squeeze(1000, true)), 1000);
    // The XOF output is one continuous stream: squeezing 500 bytes must give
    // the same bytes as the first 500 of a 1000-byte squeeze, even though
    // 500 and 1000 both cross the 136-byte rate multiple times and so need
    // several internal permutations - this is what actually exercises the
    // squeeze loop's "permute again for more output" path, not just a
    // single-block squeeze.
    let shortSqueeze = new Digest("shake256").Update("").Squeeze(500, true);
    let longSqueeze  = new Digest("shake256").Update("").Squeeze(1000, true);
    assertEq("Shake256 output is a prefix-consistent stream across multiple permutations",
        Util.BinToHex(shortSqueeze), Util.BinToHex(Buffer.Slice(longSqueeze, 0, 500)));

    Console.WriteLine("\n--- Digest: sponge streaming semantics and misuse ---");
    let dk = new Digest("sha3-256");
    assertEq("sha3-256 Algorithm()", dk.Algorithm(), "sha3-256");
    assertEq("chained pieces == whole", dk.Update("hello ").Update("world").Final(), new Digest("sha3-256").Update("hello world").Final());
    assertEq("Final is idempotent", dk.Final(), new Digest("sha3-256").Update("hello world").Final());
    assert("Update after Final -> nil", dk.Update("x") == nil);
    assertEq("Reset then reuse", dk.Reset().Update("abc").Final(), "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532");
    assert("Squeeze on a fixed-output algorithm -> nil", new Digest("sha3-256").Update("x").Squeeze(32) == nil);
    assert("Final on a XOF algorithm -> nil", new Digest("shake128").Update("x").Final() == nil);
    let sk = new Digest("shake256");
    sk.Update("first squeeze only");
    let first = sk.Squeeze(16);
    assert("first Squeeze succeeds", first != nil);
    assert("Update after Squeeze -> nil", sk.Update("x") == nil);
    assert("second Squeeze -> nil (one-shot; Reset() to squeeze again)", sk.Squeeze(16) == nil);
    assert("Squeeze outLen 0 -> nil", new Digest("shake128").Update("x").Squeeze(0) == nil);
    assert("Squeeze outLen negative -> nil", new Digest("shake128").Update("x").Squeeze(-1) == nil);
    assert("Squeeze non-int outLen -> nil", new Digest("shake128").Update("x").Squeeze(1.5) == nil);
    assert("Squeeze nil outLen -> nil", new Digest("shake128").Update("x").Squeeze(nil) == nil);
}

// ============================================================
//  Benchmarks
// ============================================================

fn benchmarks() {
    Console.WriteLine("\n--- Benchmarks ---");
    benchSep();
    let mb = pattern(1 << 20);
    let key = Envelope.NewKey();
    let secret = "12345678901234567890";
    let fourK = pattern(4096);
    let sealed = Envelope.Seal(fourK, key);
    let phc = Password.Hash("pw");

    bench("Digest.Md5  1 MB (script, JIT leaf)", fn() { _sink = _sink + len(Digest.Md5(mb)); }, 10);
    bench("Digest sha1  1 MB streaming (script)", fn() { _sink = _sink + len(new Digest("sha1").Update(mb).Final()); }, 10);
    bench("Digest sha256  1 MB streaming (script)", fn() { _sink = _sink + len(new Digest("sha256").Update(mb).Final()); }, 10);
    bench("Digest sha384  1 MB streaming (script, needs >>>)", fn() { _sink = _sink + len(new Digest("sha384").Update(mb).Final()); }, 10);
    bench("Digest sha512  1 MB streaming (script, needs >>>)", fn() { _sink = _sink + len(new Digest("sha512").Update(mb).Final()); }, 10);
    bench("Digest sha3-256  1 MB streaming (script)", fn() { _sink = _sink + len(new Digest("sha3-256").Update(mb).Final()); }, 10);
    bench("Digest keccak256  1 MB streaming (script)", fn() { _sink = _sink + len(new Digest("keccak256").Update(mb).Final()); }, 10);
    bench("Digest shake256  1 MB in, 32 bytes out (script)", fn() { _sink = _sink + len(new Digest("shake256").Update(mb).Squeeze(32)); }, 10);
    bench("Hash.Sha256  1 MB (native, reference)", fn() { _sink = _sink + len(Hash.Sha256(mb)); }, 10);
    bench("Hash.Sha1  1 MB (native, reference)", fn() { _sink = _sink + len(Hash.Sha1(mb)); }, 10);
    bench("Hash.Sha512  1 MB (native, reference)", fn() { _sink = _sink + len(Hash.Sha512(mb)); }, 10);
    benchSep();
    bench("Kdf.Hkdf  32 bytes out (sha256)", fn() { _sink = _sink + len(Kdf.Hkdf(secret, "salt", "info", 32)); }, 2000);
    bench("Kdf.Pbkdf2  sha256, 10 000 iterations", fn() { _sink = _sink + len(Kdf.Pbkdf2("password", "salt", 10000, 32)); }, 5);
    bench("Kdf.Pbkdf2  sha1, 10 000 iterations", fn() { _sink = _sink + len(Kdf.Pbkdf2("password", "salt", 10000, 20, "sha1")); }, 5);
    benchSep();
    bench("Otp.Hotp", fn() { _sink = _sink + len(Otp.Hotp(secret, 1)); }, 5000);
    bench("Otp.TotpVerify  window 1 (3 HMACs)", fn() { if (Otp.TotpVerify(secret, "287082", 1, 59)) { _sink = _sink + 1; } }, 2000);
    benchSep();
    bench("Password.Hash  defaults (64 MiB, t=3)", fn() { _sink = _sink + len(Password.Hash("pw")); }, 5);
    bench("Password.Verify  defaults", fn() { if (Password.Verify("pw", phc)) { _sink = _sink + 1; } }, 5);
    benchSep();
    bench("Envelope.Seal  4 KB", fn() { _sink = _sink + len(Envelope.Seal(fourK, key)); }, 2000);
    bench("Envelope.Open  4 KB", fn() { _sink = _sink + len(Envelope.Open(sealed, key)); }, 2000);
    bench("Envelope.Seal  1 MB", fn() { _sink = _sink + len(Envelope.Seal(mb, key)); }, 10);
    benchSep();
    Console.WriteLine("_sink=" + str(_sink));
}

fn Main(): int {
    testKdf();
    testOtp();
    testPassword();
    testEnvelope();
    testDigest();
    testKeccakFamily();
    benchmarks();

    Console.WriteLine("");
    Console.WriteLine("Tests run: " + str(passed + failed) + "  passed: " + str(passed) + "  failed: " + str(failed));
    if (failed > 0) { return 1; }
    Console.WriteLine("✅ All CryptoKit tests passed!");
    return 0;
}
