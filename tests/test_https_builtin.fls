// test_https_builtin.fls - Built-in TLS (no FFI, no -u) smoke test.
//
//   flarisvm tests/test_https_builtin.fls --libs='./libs'
//
// Verifies that HTTPS works through the built-in Tls module (OS-native TLS:
// Secure Transport on macOS, dlopen'd OpenSSL on Linux) with no unsafe flag and
// no compiled plugin. This is the test the Linux Docker image runs.
//
// Hard checks (gate the exit code) cover the TLS path only: backend present, a
// response comes back, its body is well-formed JSON, the async handles work.
// api.github.com rate-limits unauthenticated callers at 60 requests/hour per
// source IP and CI runners share addresses, so its status code is not something
// this build controls - a 403 there still proves TLS end to end. Status codes
// and cert-verification behaviour are printed, not gated.

import { Https, Status } from library("Https", "1.0");

global fails = 0;

fn check(cond, msg) {
    if (!cond) { fails += 1; Console.WriteLine("FAIL: ", msg); }
    else       { Console.WriteLine("ok:   ", msg); }
}

fn note(cond, msg) {
    Console.WriteLine(cond ? "ok:   " : "WARN: ", msg);
}

fn async Main() {
    Console.WriteLine("=== built-in TLS smoke test (no -u) ===");

    check(Tls.Available(), "built-in TLS backend available");

    let r = Https.Get("https://api.github.com/", { "User-Agent": "flaris-builtin-test" });
    check(r != nil, "GET https://api.github.com/ returns a response");
    if (r != nil) {
        // Only a 2xx is required to carry a JSON body. Rate limiting (403/429)
        // and edge failures (5xx) both answer with HTML, and neither says
        // anything about the TLS layer - the response arrived over a completed
        // handshake either way, which is what this test exists to prove.
        note(r.status == Status.OK, "GET status == 200 (got " + Convert.ToString(r.status) + ")");
        if (r.status >= 200 && r.status < 300) {
            let j = Json.Parse(r.body);
            check(j != nil, "response body parses as JSON (status " + Convert.ToString(r.status) + ")");
            note(j != nil && Object.HasKey(j, "current_user_url"), "body is the API root payload");
        } else {
            Console.WriteLine("      (api.github.com answered " + Convert.ToString(r.status) +
                              " - unauthenticated callers get 60 requests/hour per IP and CI " +
                              "runners share one; edge 5xx happens too. TLS itself is fine.)");
        }
    }

    // Object body must arrive as JSON over TLS.
    let p = Https.Post("https://postman-echo.com/post", { name: "Linux", n: 3 });
    if (p != nil) {
        let pj = Json.Parse(p.body);
        note(pj != nil && pj.json != nil && pj.json.name == "Linux", "POST object body round-trips as JSON");
    } else {
        note(false, "POST round-trip (no network?)");
    }

    // Certificate + hostname verification (informational; needs badssl.com).
    let bad = Https.Get("https://wrong.host.badssl.com/");
    note(bad == nil, "verified GET rejects wrong-hostname cert");
    let ins = Https.GetInsecure("https://wrong.host.badssl.com/");
    note(ins != nil, "insecure GET accepts wrong-hostname cert");

    // Async transport round-trip (io-pool offload): ConnectAsync -> WriteAsync ->
    // ReadLineAsync -> ReadAllAsync directly against a real server.
    let ah = await Tls.ConnectAsync("api.github.com", 443);
    check(ah != 0, "ConnectAsync opens a TLS connection");
    if (ah != 0) {
        let sent = await Tls.WriteAsync(ah,
            "GET / HTTP/1.1\r\nHost: api.github.com\r\nUser-Agent: flaris\r\nConnection: close\r\n\r\n");
        check(sent > 0, "WriteAsync sends the request");
        let line = await Tls.ReadLineAsync(ah);
        check(line != nil && String.StartsWith(line, "HTTP/1."), "ReadLineAsync reads the status line");
        if (line != nil) {
            note(String.Contains(line, " 200 "), "async status line == 200 (got " + String.Trim(line) + ")");
        }
        let body = await Tls.ReadAllAsync(ah);
        check(body != nil, "ReadAllAsync reads the body to EOF");
        Tls.Close(ah);
    }

    // PeerCert exposes a pinnable fingerprint + subject.
    let ph = Tls.Connect("api.github.com", 443);
    if (ph != 0) {
        let cert = Tls.PeerCert(ph);
        check(cert != nil && len(cert.sha256) == 64, "PeerCert returns a 64-hex sha256");
        check(cert != nil && cert.subject != "",     "PeerCert returns a subject");
        Tls.Close(ph);
    }
    // SNI override: a wrong SNI must fail hostname verification.
    let wrong = Tls.Connect("api.github.com", 443, false, 15000, { sni: "wrong.host.example" });
    check(wrong == 0, "wrong SNI override rejected by verification");

    // Https.GetAsync drives the async HTTP engine over async TLS: resolves to a
    // real response, and two started together run concurrently (overlapping I/O).
    let ar = await Https.GetAsync("https://api.github.com/");
    check(ar != nil, "Https.GetAsync resolves to a response");
    note(ar != nil && ar.status == Status.OK, "Https.GetAsync status == 200");
    let ca = Https.GetAsync("https://api.github.com/");
    let cb = Https.GetAsync("https://api.github.com/");
    Scheduler.Schedule(ca);
    Scheduler.Schedule(cb);
    let cra = await ca;
    let crb = await cb;
    check(cra != nil && crb != nil, "two Https.GetAsync requests run concurrently");
    note(cra != nil && crb != nil && cra.status == Status.OK && crb.status == Status.OK,
         "both concurrent responses are 200");

    Console.WriteLine(fails == 0 ? "=== ALL HARD CHECKS PASSED ===" :
                                   ("=== FAILURES: " + Convert.ToString(fails) + " ==="));
    return fails;
}
