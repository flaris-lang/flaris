// test_httputil.fls
// Run: flarisvm test_httputil.fls
//
// Covers URL parsing, percent codecs, query strings, header blocks and route
// patterns, including UTF-8 round-trips and IPv6 literals.

import { HttpUtil } from library("HttpUtil", "1.0");

global passed = 0;
global failed = 0;

fn pk(name: string, cond) {
    if (cond) { passed = passed + 1; Console.WriteLine("[PASS] ", name); }
    else      { failed = failed + 1; Console.WriteLine("[FAIL] ", name); }
}
fn pkEq(name: string, a, b) {
    if (a == b) { passed = passed + 1; Console.WriteLine("[PASS] ", name); }
    else { failed = failed + 1; Console.WriteLine("[FAIL] ", name, " expected=", b, " got=", a); }
}

fn test_url() {
    let u = HttpUtil.ParseUrl("https://api.example.com:8443/v1/users/42?active=true#frag");
    pkEq("scheme",   u.scheme, "https");
    pkEq("host",     u.host,   "api.example.com");
    pkEq("port",     u.port,   8443);
    pkEq("path",     u.path,   "/v1/users/42");
    pkEq("query",    u.query,  "active=true");
    pkEq("fragment", u.fragment, "frag");

    // Defaults: no scheme -> http, no port -> 80/443, no path -> "/"
    pkEq("default scheme", HttpUtil.ParseUrl("example.com/a").scheme, "http");
    pkEq("default port80", HttpUtil.ParseUrl("http://example.com/a").port, 80);
    pkEq("default port443", HttpUtil.ParseUrl("https://example.com").port, 443);
    pkEq("default path",   HttpUtil.ParseUrl("https://example.com").path, "/");

    // IPv6 literals keep their brackets out of the host and parse the port.
    let v6 = HttpUtil.ParseUrl("http://[::1]:9000/a?b=1");
    pkEq("ipv6 host", v6.host, "::1");
    pkEq("ipv6 port", v6.port, 9000);
    pkEq("ipv6 path", v6.path, "/a");

    pkEq("empty url -> nil", HttpUtil.ParseUrl(""), nil);
}

fn test_codecs() {
    pkEq("encode reserved", HttpUtil.UrlEncode("a b/c"), "a%20b%2Fc");
    pkEq("encode unreserved passthrough", HttpUtil.UrlEncode("Plain-Text_1.0~"), "Plain-Text_1.0~");
    pkEq("decode percent", HttpUtil.UrlDecode("a%20b"), "a b");
    pkEq("decode plus",    HttpUtil.UrlDecode("a+b"),   "a b");
    // A malformed escape is left literal rather than dropped.
    pkEq("decode bad escape", HttpUtil.UrlDecode("100%ZZ"), "100%ZZ");
    pkEq("decode empty",   HttpUtil.UrlDecode(""), "");
    pkEq("decode untouched", HttpUtil.UrlDecode("/plain/path"), "/plain/path");

    // Non-ASCII is percent-encoded per UTF-8 byte, not per character.
    pkEq("encode utf8 two-byte", HttpUtil.UrlEncode("ä"), "%C3%A4");
    pkEq("decode utf8 two-byte", HttpUtil.UrlDecode("%C3%A4"), "ä");
    pkEq("utf8 round trip",   HttpUtil.UrlDecode(HttpUtil.UrlEncode("äöü")), "äöü");
    pkEq("cjk round trip",    HttpUtil.UrlDecode(HttpUtil.UrlEncode("日本語")), "日本語");
    pkEq("reserved round trip",
         HttpUtil.UrlDecode(HttpUtil.UrlEncode(":/?#[]@!$&'()*+,;=")), ":/?#[]@!$&'()*+,;=");
}

fn test_query() {
    let q = HttpUtil.ParseQuery("active=true&sort=name&q=hello+world");
    pkEq("query active", q["active"], "true");
    pkEq("query plus decoded", q["q"], "hello world");
    pkEq("query count", len(Object.Keys(q)), 3);
    pkEq("empty query", len(Object.Keys(HttpUtil.ParseQuery(""))), 0);

    // EncodeQuery round-trips through ParseQuery.
    let enc = HttpUtil.EncodeQuery({ name: "ada lovelace", n: 42, ok: true });
    let back = HttpUtil.ParseQuery(enc);
    pkEq("roundtrip name", back["name"], "ada lovelace");
    pkEq("roundtrip int",  back["n"],    "42");
    pkEq("roundtrip bool", back["ok"],   "true");
}

fn test_headers() {
    let h = HttpUtil.ParseHeaders("Host: example.com\r\nContent-Type: application/json\r\n" +
                                  "X-Empty:\r\nCookie: a=1; b=2\r\n");
    pkEq("header lowercased key", h["host"], "example.com");
    pkEq("header value trimmed",  h["content-type"], "application/json");
    pkEq("header with semicolons", h["cookie"], "a=1; b=2");
    pkEq("empty header block", len(Object.Keys(HttpUtil.ParseHeaders(""))), 0);
}

fn test_routes() {
    let r = { method: "GET", path: "/v1/users/42/profile" };
    pk("route matches", HttpUtil.RouteMatch(r, "GET", "/v1/users/:id/profile"));
    pkEq("route captured param", r.params["id"], "42");

    let r2 = { method: "GET", path: "/v1/users/42/profile" };
    pk("route rejects other pattern", !HttpUtil.RouteMatch(r2, "GET", "/v1/orders/:id"));

    let r3 = { method: "POST", path: "/a/b" };
    pk("route rejects method mismatch", !HttpUtil.RouteMatch(r3, "GET", "/a/b"));

    let r4 = { method: "GET", path: "/a" };
    pk("route rejects short path", !HttpUtil.RouteMatch(r4, "GET", "/a/:id"));

    let r5 = { method: "GET", path: "/static/css/site.css" };
    pk("wildcard matches", HttpUtil.RouteMatch(r5, "GET", "/static/*"));
    pkEq("wildcard captures rest", r5.params["*"], "css/site.css");
}

global streamPeer = nil;

// [client, accepted] over loopback; the accepted end reads non-blocking, so a
// read takes what has arrived and the rest can come later.
fn tcpPair() {
    // Where the client connects: a dual-stack port 0 can be one held on 127.0.0.1 alone.
    let srv = Stream.Listen("tcp", 0, 128, "127.0.0.1");
    let a: string = Stream.LocalAddr(srv);
    let port = Convert.ParseInt(String.Substr(a, String.LastIndexOf(a, ":") + 1, 10));
    let cli = Stream.Connect("tcp", "127.0.0.1", port);
    Stream.WaitReadable(srv, 2000);
    let acc = Stream.Accept(srv);
    Stream.Close(srv);
    Stream.WaitReadable(acc, 1);
    return [cli, acc];
}

fn sendLater(text: string) {
    Fiber.Run(fn () { Fiber.Sleep(50); Stream.WriteString(streamPeer, text); });
}

fn test_stream_reads() {
    let p = tcpPair();
    streamPeer = p[0];

    Stream.WriteString(p[0], "abc");
    sendLater("def");
    let ex = HttpUtil.ReadExact(p[1], 6);
    pkEq("ReadExact waits for the rest", ex == nil ? "nil" : Buffer.ToString(ex), "abcdef");

    // A trailer after the last chunk is read too, so the next line is in step.
    Stream.WriteString(p[0], "5\r\nhello\r\n6\r\n world\r\n0\r\nX-Sum: 1\r\n\r\nNEXT\n");
    let body = HttpUtil.DecodeChunked(p[1]);
    pkEq("DecodeChunked", body == nil ? "nil" : Buffer.ToString(body), "hello world");
    pkEq("... reads the trailer", Stream.ReadLine(p[1]), "NEXT");

    Stream.WriteString(p[0], "8\r\nchun");
    sendLater("ked!\r\n0\r\n\r\n");
    let split = HttpUtil.DecodeChunked(p[1]);
    pkEq("a chunk that arrives in two parts", split == nil ? "nil" : Buffer.ToString(split), "chunked!");

    Stream.WriteString(p[0], "3\r\nabcXX\r\n0\r\n\r\n");
    pk("anything but CRLF after the chunk data is malformed", HttpUtil.DecodeChunked(p[1]) == nil);

    Stream.Close(p[0]);
    Stream.Close(p[1]);
}

fn Main() {
    test_url();
    test_codecs();
    test_query();
    test_headers();
    test_routes();
    test_stream_reads();
    Console.WriteLine("Results: ", passed, " passed, ", failed, " failed");
    if (failed > 0) { return 1; }
    return 0;
}
