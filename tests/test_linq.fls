// Runner
// ============================================================

fn Main() {
    Console.WriteLine("=== Linq test suite ===");

    test_factories();
    test_where();
    test_select();
    test_flatten();
    test_select_many();
    test_order_by();
    test_distinct();
    test_concat();
    test_zip();
    test_set_ops();
    test_take_skip();
    test_append_prepend_chunk();
    test_index_of();
    test_aggregation();
    test_element_access();
    test_existence();
    test_for_each();
    test_group_by();
    test_to_hash_map();
    test_chaining();
    test_edge_cases();
    test_empty_aggregations();
    test_partition();
    test_scan();
    test_default_if_empty();
    test_to_hash_map_strict();
    test_empty_factory();
    test_repeat_factory();
    test_select_many_extra();
    test_flatten_extra();
    test_zip_extra();
    test_take_skip_while_extra();
    test_element_at_extra();
    test_index_of_extra();
    test_aggregate_extra();
    test_for_each_extra();
    test_group_by_extra();
    test_to_hash_map_extra();
    test_chunk_extra();
    test_stats_new();
    test_benchmarks();

    Console.WriteLine("=== Linq tests done ===");
    Console.WriteLine("Tests run:", testsRun, "  failed:", testsFailed);

    Debug.Assert(testsFailed, 0);
    Console.Ok("All Linq tests passed!");
    return testsFailed;
}
