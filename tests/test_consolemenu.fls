// ConsoleMenuTest.fls
// Interactive test of all ConsoleMenu widgets.
// Run: flarisvm ConsoleMenuTest.fls --libs='./libs'

import { ConsoleMenu } from library("./ConsoleMenu", "1.0");

const CLR_DEFAULT = 0;
const CLR_RED     = 31;
const CLR_GREEN   = 32;
const CLR_BLUE    = 34;
const CLR_YELLOW  = 33;
const CLR_CYAN    = 36;

const MAIN_ITEMS   = ["New Game", "Load Game", "Settings", "Quit"];
const LANG_ITEMS   = ["Flaris", "Python", "JavaScript", "C"];
const COLOR_ITEMS  = ["Red", "Green", "Blue", "Yellow", "Cyan"];
const COLOR_VALUES = [31, 32, 34, 33, 36];  // ANSI: Red Green Blue Yellow Cyan
const THEME_ITEMS  = ["Option A", "Option B", "Option C"];

fn printSelected(items, index) {
    if (index < 0) {
        Console.SetColor(CLR_YELLOW);
        Console.WriteLine("  - (cancelled)");
    } else {
        Console.SetColor(CLR_GREEN);
        Console.Write("  - ");
        Console.SetColor(CLR_DEFAULT);
        Console.WriteLine("[" + str(index) + "] " + items[index]);
    }
    Console.SetColor(CLR_DEFAULT);
}

fn printBool(label, val) {
    Console.SetColor(CLR_GREEN);
    Console.Write("  - " + label + ": ");
    if (val) {
        Console.SetColor(CLR_GREEN);
        Console.WriteLine("Yes ✓");
    } else {
        Console.SetColor(CLR_RED);
        Console.WriteLine("No ✗");
    }
    Console.SetColor(CLR_DEFAULT);
}

fn printText(label, val) {
    Console.SetColor(CLR_GREEN);
    Console.Write("  - " + label + ": ");
    Console.SetColor(CLR_DEFAULT);
    if (val == nil) {
        Console.SetColor(CLR_YELLOW);
        Console.WriteLine("(cancelled)");
    } else {
        Console.WriteLine("\"" + val + "\"");
    }
    Console.SetColor(CLR_DEFAULT);
}

fn separator(label) {
    Console.WriteLine("");
    Console.SetColor(CLR_CYAN);
    Console.WriteLine("── " + label + " ──────────────────────────────");
    Console.SetColor(CLR_DEFAULT);
}

fn Main() {
    let cm = new ConsoleMenu();

    Console.Clear();
    Console.SetCursor(1, 1);
    Console.SetColor(CLR_YELLOW);
    Console.WriteLine("  ConsoleMenu Test Suite");
    Console.SetColor(CLR_DEFAULT);
    Console.WriteLine("  Arrows to navigate · Enter to select · Esc to cancel");
    Console.WriteLine("");

    // ── 1. Basic menu ──────────────────────────────────────────────────────

    separator("1 - Basic Menu");
    let choice = cm.Menu(MAIN_ITEMS, { title: "Main Menu" });
    printSelected(MAIN_ITEMS, choice);

    // ── 2. Menu - no title, custom width ──────────────────────────────────

    separator("2 - Menu (no title, width=32)");
    let lang = cm.Menu(LANG_ITEMS, { width: 32 });
    printSelected(LANG_ITEMS, lang);

    // ── 3. Color menu ─────────────────────────────────────────────────────

    separator("3 - Color Menu (initial=2 Blue)");
    let colorIdx = cm.Menu(COLOR_ITEMS, { title: "Pick a color", initial: 2 });
    if (colorIdx >= 0) {
        Console.SetColor(COLOR_VALUES[colorIdx]);
        Console.Write("  - ██ ");
        Console.WriteLine(COLOR_ITEMS[colorIdx]);
        Console.SetColor(CLR_DEFAULT);
    } else {
        Console.SetColor(CLR_YELLOW);
        Console.WriteLine("  - (cancelled)");
        Console.SetColor(CLR_DEFAULT);
    }

    // ── 4. Alert ──────────────────────────────────────────────────────────

    separator("4 - Alert");
    cm.Alert("Information", "Your settings have been saved\nsuccessfully.");
    Console.SetColor(CLR_GREEN);
    Console.WriteLine("  - (dismissed)");
    Console.SetColor(CLR_DEFAULT);

    // ── 5. Alert - multiline ──────────────────────────────────────────────

    separator("5 - Alert (multiline)");
    cm.Alert("About ConsoleMenu", "A lightweight ncurses-inspired\nUI toolkit for Flaris.\n\nVersion 1.0");
    Console.SetColor(CLR_GREEN);
    Console.WriteLine("  - (dismissed)");
    Console.SetColor(CLR_DEFAULT);

    // ── 6. Confirm ────────────────────────────────────────────────────────

    separator("6 - Confirm  [Tab/←/- to switch · Y/N shortcut]");
    let confirmed = cm.Confirm("Delete File", "Are you sure you want to\ndelete config.fls?");
    printBool("Delete", confirmed);

    // ── 7. Confirm ────────────────────────────────────────────────────────

    separator("7 - Confirm  [try pressing N]");
    let save = cm.Confirm("Unsaved Changes", "Save changes before closing?");
    printBool("Save", save);

    // ── 8. Input - basic ──────────────────────────────────────────────────

    separator("8 - Input");
    let name = cm.Input("New Project", "Project name:", nil);
    printText("name", name);

    // ── 9. Input - pre-filled ─────────────────────────────────────────────

    separator("9 - Input (pre-filled)");
    let host = cm.Input("Connect", "Host:", { "default": "localhost" });
    printText("host", host);

    // ── 10. Input - masked ────────────────────────────────────────────────

    separator("10 - Input (masked password)");
    let pwd = cm.Input("Authentication", "Password:", { mask: true, width: 24 });
    if (pwd == nil) {
        printText("password", nil);
    } else {
        let stars = String.Repeat("*", String.Length(pwd));
        printText("password", stars + "  (" + str(String.Length(pwd)) + " chars)");
    }

    // ── 11. Custom theme ──────────────────────────────────────────────────

    separator("11 - Custom theme (green border)");
    let savedBorder   = cm.border;
    let savedTitleClr = cm.titleClr;
    let savedSelBg    = cm.selBg;
    cm.border   = CLR_GREEN;
    cm.titleClr = CLR_CYAN;
    cm.selBg    = CLR_GREEN;
    let themed = cm.Menu(THEME_ITEMS, { title: "Green Theme" });
    cm.border   = savedBorder;
    cm.titleClr = savedTitleClr;
    cm.selBg    = savedSelBg;
    printSelected(THEME_ITEMS, themed);

    // ── 12. Benchmarks - pure string-building helpers only (no key input) ─

    separator("12 - Benchmarks");
    Console.WriteLine("=== ConsoleMenu benchmarks ===");

    let bIters = 5000;

    let b0 = Time.Ticks();
    iter (i from 0 to bIters - 1) {
        let _s = cm._center(cm._fit("ConsoleMenu bench item " + str(i), 24), 32);
    }
    Console.WriteLine("_fit+_center x", bIters, ": ",
                      String.FormatArray("{0:.2f}", [Time.TicksToMs(Time.Ticks() - b0)]), " ms");

    let b1 = Time.Ticks();
    iter (i from 0 to bIters - 1) {
        let _hr = cm._rep("─", 32) + cm._rep(" ", 32);
    }
    Console.WriteLine("_rep x", bIters, ": ",
                      String.FormatArray("{0:.2f}", [Time.TicksToMs(Time.Ticks() - b1)]), " ms");

    Console.WriteLine("=== benchmarks done ===");

    // ── Done ──────────────────────────────────────────────────────────────

    Console.WriteLine("");
    Console.SetColor(CLR_GREEN);
    Console.WriteLine("  All tests complete.");
    Console.SetColor(CLR_DEFAULT);
    Console.WriteLine("");

    return 0;
}
