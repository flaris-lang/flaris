// test_http.fls - Test suite for Http.fls stdlib
//
// The network checks run against a local server, not the internet: the test
// starts this same file a second time with "serve" (the Http client blocks the
// scheduler, so client and server need two processes). The server answers the
// httpbin.org endpoints the checks use - /get, /headers, /post, /put, /patch,
// /delete, /anything, /status/<code>, /redirect/<n> and /json, plus
// /delay/<ms>, /peer (the client address it sees, which names the
// connection), /trickle, /ndjson, /sse and /blob/<n> for the streaming
// checks, and /limited (429 with Retry-After every other time) - on an
// ephemeral port, and again on a second port where an
// idle connection is closed after 100 ms. When openssl can make a self-signed
// certificate it serves the same endpoints over https on a third port. It
// prints "PORT=<n>", "IDLEPORT=<n>" (and "TLSPORT=<n>") and stops when the
// test closes its stdin.
//
// The proxy checks start the file a third time with "proxy": a forward proxy
// that passes absolute-form requests on to the server and opens CONNECT
// tunnels to it. Names ending in .invalid stand for the server, so the proxy
// is what makes them reachable. It prints "PROXYPORT=<n>", reports what it
// saw at its own /seen, and stops when its stdin closes.
//
// Run: flarisvm tests/test_http.fls --libs=./libs

import { HttpServer } from library("HttpServer", "1.0");
import { Http, Status, ContentType, HttpUnsupportedError } from library("Http", "1.0");
import { HttpUtil } from library("HttpUtil", "1.0");

const TLS_PASSWORD = "testpass";

global testsRun    = 0;
global testsFailed = 0;

global base    = "";    // http://127.0.0.1:<port>
global idleBase = "";   // the same, closing idle connections after 100 ms
global tlsBase = nil;   // https://127.0.0.1:<port>, nil without a certificate
global tmpDir  = "";    // certificate, wgetrc and wget downloads
global server  = nil;   // the server child: { Pid, Stdin, Stdout, Stderr }

fn check(cond, msg) {
    testsRun = testsRun + 1;
    if (!cond) {
        testsFailed = testsFailed + 1;
        Console.WriteLine("FAIL: " + msg);
    }
    return 0;
}

fn checkEq(actual, expected, msg) {
    testsRun = testsRun + 1;
    if (actual != expected) {
        testsFailed = testsFailed + 1;
        Console.WriteLine("FAIL: " + msg + "  expected=" + Convert.ToString(expected) + "  got=" + Convert.ToString(actual));
    }
    return 0;
}

fn statusOf(res)  { if (res == nil) { return -1; } return res.status; }
fn bodyOf(res)    { if (res == nil) { return ""; } return res.body;   }
fn headersOf(res) { if (res == nil) { return {}; } return res.headers; }

// --------------------------------------------------------
//  Server half: the httpbin endpoints the checks use
// --------------------------------------------------------

// "x-test-header" -> "X-Test-Header", the spelling httpbin reports.
fn canonName(k: string): string {
    let parts = String.Split(k, "-");
    var out = "";
    iter (i from 0 to len(parts)) {
        let p = parts[i];
        if (i > 0) { out += "-"; }
        if (len(p) > 0) { out += String.ToUpper(String.Left(p, 1)) + String.Substr(p, 1); }
    }
    return out;
}

// What httpbin echoes back: the request as the server saw it.
fn echo(req) {
    let hdrs = {};
    foreach (v, k in req.headers) { hdrs[canonName(k)] = v; }
    return {
        method:  req.method,
        url:     (req.secure ? "https://" : "http://") + req.Header("host", "") + req.rawPath,
        args:    req.query,
        headers: hdrs,
        json:    req.Json()
    };
}

fn sendEcho(req, res)    { res.Json(echo(req)); }
fn sendHeaders(req, res) { res.Json({ headers: echo(req).headers }); }
fn sendStatus(req, res)  { res.Text("", Convert.ParseInt(req.Param("code")) ?? 400); }
fn sendJson(_req, res)   { res.Json({ slideshow: { title: "Sample Slide Show", slides: 2 } }); }

// /bytes: the request body exactly as it arrived, one number per byte.
fn sendBytes(req, res) {
    let out = [];
    let b = req.body;
    if (b != nil) {
        iter (i from 0 to len(b)) { Array.Append(out, Buffer.ReadU8At(b, i)); }
    }
    res.Json({ bytes: out, contentType: req.Header("content-type", "") });
}

// /redirect/<n>: n hops of 302, the last one landing on /get.
fn sendRedirect(req, res) {
    let n = Convert.ParseInt(req.Param("n")) ?? 1;
    res.Redirect(n > 1 ? "/redirect/" + str(n - 1) : "/get");
}

// /delay/<ms>: answer after ms milliseconds; only this connection waits.
fn sendDelayed(req, res) {
    Fiber.Sleep(Convert.ParseInt(req.Param("ms")) ?? 0);
    res.Json(echo(req));
}

// /trickle: ten chunks of one byte, 20 ms apart.
fn sendTrickle(_req, res) {
    res.StartChunked("text/plain");
    iter (i from 0 to 10) {
        Fiber.Sleep(20);
        if (!res.WriteChunk("x")) { break; }
    }
    res.EndChunked();
}

// /ndjson: NDJSON lines, one split across two chunks.
fn sendNdjson(_req, res) {
    res.StartChunked("application/x-ndjson");
    res.WriteChunk("{\"a\":1}\n{\"b\":");
    res.WriteChunk("22}\n\nnot json\n");
    res.EndChunked();
}

// /sse: two events, the second after a pause.
fn sendSse(_req, res) {
    res.StartChunked("text/event-stream");
    res.WriteChunk(": hello\nid: 1\ndata: one\n\n");
    Fiber.Sleep(20);
    res.WriteChunk("event: up\ndata: two\ndata: 2\n\n");
    res.EndChunked();
}

// /limited: every other request is refused with 429 and Retry-After: 0.
global limitedCalls = 0;

fn sendLimited(_req, res) {
    limitedCalls += 1;
    if (limitedCalls % 2 == 1) { res.Header("Retry-After", "0").Text("slow down", 429); }
    else { res.Text("ok"); }
}

// /blob/<n>: n bytes with a Content-Length.
fn sendBlob(req, res) {
    res.Text(String.Repeat("z", Convert.ParseInt(req.Param("n")) ?? 0));
}

fn addRoutes(srv) {
    srv.Get("/get", sendEcho);              // HEAD /get is answered by the same route
    srv.Get("/headers", sendHeaders);
    srv.Post("/post", sendEcho);
    srv.Post("/bytes", sendBytes);
    srv.Put("/put", sendEcho);
    srv.Patch("/patch", sendEcho);
    srv.Delete("/delete", sendEcho);
    foreach (m in ["GET", "POST", "PUT", "PATCH", "DELETE", "QUERY"]) {
        srv.Route(m, "/anything", sendEcho);
    }
    srv.Get("/status/:code", sendStatus);
    srv.Post("/status/:code", sendStatus);
    srv.Get("/redirect/:n", sendRedirect);
    srv.Get("/json", sendJson);
    srv.Get("/delay/:ms", sendDelayed);
    srv.Get("/peer", fn(req, res) { res.Json({ peer: req.peer }); });
    srv.Get("/trickle", sendTrickle);
    srv.Get("/ndjson", sendNdjson);
    srv.Post("/ndjson", sendNdjson);
    srv.Get("/sse", sendSse);
    srv.Get("/blob/:n", sendBlob);
    srv.Get("/limited", sendLimited);
    return srv;
}

fn async serve(p12) {
    let plain = addRoutes(new HttpServer({ port: 0, host: "127.0.0.1" }));
    Console.WriteLine("PORT=" + str(plain.ListenAsync()));
    let brief = addRoutes(new HttpServer({ port: 0, host: "127.0.0.1", idleTimeoutMs: 100 }));
    Console.WriteLine("IDLEPORT=" + str(brief.ListenAsync()));

    let secure = nil;
    if (p12 != nil) {
        var tlsPort = 0;
        try {
            secure = addRoutes(new HttpServer({ port: 0, host: "127.0.0.1",
                                                tls: { pkcs12File: p12, password: TLS_PASSWORD } }));
            tlsPort = secure.ListenAsync();
        } catch (e) {
            secure = nil;   // this build cannot terminate TLS
        }
        Console.WriteLine("TLSPORT=" + str(tlsPort));
    }

    let stdin = Stream.Stdin();
    var line = await Stream.ReadLineAsync(stdin);
    while (line != nil) { line = await Stream.ReadLineAsync(stdin); }
    plain.Stop(1000);
    brief.Stop(1000);
    if (secure != nil) { secure.Stop(1000); }
    return 0;
}

// --------------------------------------------------------
//  Proxy half
// --------------------------------------------------------

global proxySeen     = [];      // "<request line> | <Proxy-Authorization or ->"
global proxyTunnels  = 0;       // CONNECT tunnels opened
global proxyForwards = 0;       // client connections that carried forwarded requests
global proxyRunning  = true;

// A request or response head: the first line, the header lines, and the
// Proxy-Authorization and Content-Length found among them.
fn readHead(c) {
    let first = Fiber.Await(Stream.ReadLineAsync(c, 10000));
    if (first == nil) { return nil; }
    let lines = [];
    var auth = nil;
    var length = 0;
    var h = Fiber.Await(Stream.ReadLineAsync(c, 10000));
    while (h != nil && len(h) > 0) {
        Array.Append(lines, h);
        let lh = String.ToLower(h);
        if (String.StartsWith(lh, "proxy-authorization:")) { auth = String.Trim(String.Substr(h, 20)); }
        if (String.StartsWith(lh, "content-length:")) { length = Convert.ParseInt(String.Trim(String.Substr(h, 15))) ?? 0; }
        h = Fiber.Await(Stream.ReadLineAsync(c, 10000));
    }
    return { first: first, lines: lines, auth: auth, length: length };
}

fn readBody(c, n: int): string {
    if (n <= 0) { return ""; }
    let b = Fiber.Await(Stream.ReadAsync(c, n, 10000));
    return b == nil ? "" : Buffer.ToString(b);
}

// Copy a to b until a ends, then close both.
fn pipe(a, b) {
    while (Stream.WaitReadable(a, 10000) == true) {
        let d = Stream.ReadBytes(a, 65536);
        if (d == nil) { break; }
        if (Fiber.Await(Stream.WriteAsync(b, d)) == nil) { break; }
    }
    Stream.Close(a);
    Stream.Close(b);
    return 0;
}

fn proxyPort(host: string, port: int, ports, tunnel: bool): int {
    if (String.EndsWith(host, ".invalid")) { return tunnel ? ports.tls : ports.plain; }
    return port;
}

fn proxyConnection(c, ports) {
    var up = nil;
    while (true) {
        let head = readHead(c);
        if (head == nil) { break; }
        let parts = String.Split(head.first, " ");
        if (parts[1] == "/seen") {
            let seen = Json.Stringify({ seen: proxySeen, tunnels: proxyTunnels, forwards: proxyForwards });
            Fiber.Await(Stream.WriteAsync(c, "HTTP/1.1 200 OK\r\nContent-Length: " + str(len(seen)) + "\r\n\r\n" + seen));
            continue;
        }
        Array.Append(proxySeen, head.first + " | " + (head.auth ?? "-"));
        if (head.auth == "Basic ZGVueTp4") {     // deny:x
            Fiber.Await(Stream.WriteAsync(c, "HTTP/1.1 407 Proxy Authentication Required\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"));
            break;
        }
        if (parts[0] == "CONNECT") {
            let colon = String.LastIndexOf(parts[1], ":");
            let host = String.Left(parts[1], colon);
            let port = Convert.ParseInt(String.Substr(parts[1], colon + 1)) ?? 443;
            let o = Fiber.Await(Stream.ConnectAsync("tcp", "127.0.0.1", proxyPort(host, port, ports, true), 5000));
            if (o == nil) {
                Fiber.Await(Stream.WriteAsync(c, "HTTP/1.1 502 Bad Gateway\r\nContent-Length: 0\r\n\r\n"));
                break;
            }
            proxyTunnels += 1;
            Fiber.Await(Stream.WriteAsync(c, "HTTP/1.1 200 Connection established\r\n\r\n"));
            Fiber.Run(fn() { pipe(o, c); });
            pipe(c, o);
            return 0;
        }
        // An absolute-form request goes on in origin form, over one
        // connection to the server for as long as the client keeps its own.
        let u = HttpUtil.ParseUrl(parts[1]);
        if (up == nil) {
            up = Fiber.Await(Stream.ConnectAsync("tcp", "127.0.0.1", proxyPort(u.host, u.port, ports, false), 5000));
            if (up == nil) { break; }
            proxyForwards += 1;
        }
        var out = parts[0] + " " + u.path + (len(u.query) > 0 ? "?" + u.query : "") + " " + parts[2] + "\r\n";
        foreach (h in head.lines) {
            if (!String.StartsWith(String.ToLower(h), "proxy-")) { out += h + "\r\n"; }
        }
        Fiber.Await(Stream.WriteAsync(up, out + "\r\n" + readBody(c, head.length)));
        let res = readHead(up);
        if (res == nil) { break; }
        var back = res.first + "\r\n";
        foreach (h in res.lines) { back += h + "\r\n"; }
        Fiber.Await(Stream.WriteAsync(c, back + "\r\n" + readBody(up, res.length)));
    }
    Stream.Close(c);
    if (up != nil) { Stream.Close(up); }
    return 0;
}

fn async proxyAccept(l, ports) {
    while (proxyRunning) {
        if (Stream.WaitReadable(l, 200) == true) {
            let c = Stream.Accept(l);
            if (c != nil) { Fiber.Run(fn() { proxyConnection(c, ports); }); }
        }
    }
    return 0;
}

fn async proxyMain(plainPort: int, tlsPort: int) {
    let l = Stream.Listen("tcp", 0, 128, "127.0.0.1");
    let a: string = Stream.LocalAddr(l);
    Console.WriteLine("PROXYPORT=" + String.Substr(a, String.LastIndexOf(a, ":") + 1));
    Scheduler.Schedule(proxyAccept(l, { plain: plainPort, tls: tlsPort }));
    let stdin = Stream.Stdin();
    var line = await Stream.ReadLineAsync(stdin);
    while (line != nil) { line = await Stream.ReadLineAsync(stdin); }
    proxyRunning = false;
    Fiber.Sleep(300);
    Stream.Close(l);
    return 0;
}

// --------------------------------------------------------
//  Test half: start and stop the server child
// --------------------------------------------------------

fn vmPath(): string {
    let vm = Os.GetEnv("FLARISVM");
    return (vm == nil || vm == "") ? "flarisvm" : vm;
}

// A self-signed certificate for the https server. Returns the PKCS#12 path,
// or nil when openssl is not available.
fn makeCertificate(): string {
    if (Os.Which("openssl") == nil) { return nil; }
    let key  = Path.Combine(tmpDir, "key.pem");
    let cert = Path.Combine(tmpDir, "cert.pem");
    let p12  = Path.Combine(tmpDir, "server.p12");
    Os.RunEx("openssl", ["req", "-x509", "-newkey", "rsa:2048", "-keyout", key, "-out", cert,
                         "-days", "2", "-nodes", "-subj", "/CN=localhost",
                         "-addext", "subjectAltName=DNS:localhost,IP:127.0.0.1"], { Stdin: "" });
    Os.RunEx("openssl", ["pkcs12", "-export", "-out", p12, "-inkey", key, "-in", cert,
                         "-passout", "pass:" + TLS_PASSWORD], { Stdin: "" });
    return File.Exists(p12) ? p12 : nil;
}

// Start the server child and set base (and tlsBase). Returns false if it never
// reported its port.
fn async startServer(): bool {
    let p12 = makeCertificate();
    let args = ["--libs=./libs", "tests/test_http.fls", "serve"];
    if (p12 != nil) { Array.Append(args, p12); }
    server = Os.Spawn(vmPath(), args);
    if (server == nil) { return false; }

    var port = 0;
    var idlePort = 0;
    var tlsPort = (p12 == nil) ? 0 : -1;
    let deadline = Time.Millis() + 10000;
    while ((port == 0 || idlePort == 0 || tlsPort < 0) && Time.Millis() < deadline) {
        let line = await Stream.ReadLineAsync(server.Stdout, deadline - Time.Millis());
        if (line == nil) { break; }
        if (String.StartsWith(line, "PORT="))     { port     = Convert.ParseInt(String.Substr(line, 5)) ?? 0; }
        if (String.StartsWith(line, "IDLEPORT=")) { idlePort = Convert.ParseInt(String.Substr(line, 9)) ?? 0; }
        if (String.StartsWith(line, "TLSPORT="))  { tlsPort  = Convert.ParseInt(String.Substr(line, 8)) ?? 0; }
    }
    if (port <= 0 || idlePort <= 0) { return false; }
    base = "http://127.0.0.1:" + str(port);
    idleBase = "http://127.0.0.1:" + str(idlePort);
    if (tlsPort > 0) { tlsBase = "https://127.0.0.1:" + str(tlsPort); }
    return true;
}

// Closing its stdin stops the server; reap it either way.
fn async stopServer() {
    if (server == nil) { return 0; }
    Stream.Close(server.Stdin);
    let w = await Os.WaitAsync(server.Pid, 5000);
    if (w == nil || w.Alive) {
        Os.KillChild(server.Pid, 9);
        await Os.WaitAsync(server.Pid);
    }
    Stream.Close(server.Stdout);
    Stream.Close(server.Stderr);
    server = nil;
    return 0;
}

// --------------------------------------------------------
//  Constants (no network)
// --------------------------------------------------------

fn test_constants() {
    Console.WriteLine("== Constants ==");

    checkEq(Status.OK,                 200, "Status.OK");
    checkEq(Status.Created,            201, "Status.Created");
    checkEq(Status.NoContent,          204, "Status.NoContent");
    checkEq(Status.BadRequest,         400, "Status.BadRequest");
    checkEq(Status.Unauthorized,       401, "Status.Unauthorized");
    checkEq(Status.Forbidden,          403, "Status.Forbidden");
    checkEq(Status.NotFound,           404, "Status.NotFound");
    checkEq(Status.Conflict,           409, "Status.Conflict");
    checkEq(Status.InternalError,      500, "Status.InternalError");
    checkEq(Status.NotImplemented,     501, "Status.NotImplemented");
    checkEq(Status.BadGateway,         502, "Status.BadGateway");
    checkEq(Status.ServiceUnavailable, 503, "Status.ServiceUnavailable");

    checkEq(ContentType.JSON,          "application/json",                  "ContentType.JSON");
    checkEq(ContentType.HTML,          "text/html",                         "ContentType.HTML");
    checkEq(ContentType.Text,          "text/plain",                        "ContentType.Text");
    checkEq(ContentType.FormEncoded,   "application/x-www-form-urlencoded", "ContentType.FormEncoded");
    checkEq(ContentType.MultipartForm, "multipart/form-data",               "ContentType.MultipartForm");
    checkEq(ContentType.XML,           "application/xml",                   "ContentType.XML");
    checkEq(ContentType.Binary,        "application/octet-stream",          "ContentType.Binary");
    checkEq(ContentType.Javascript,    "application/javascript",            "ContentType.Javascript");
    checkEq(ContentType.CSV,           "text/csv",                          "ContentType.CSV");
    return 0;
}

// --------------------------------------------------------
//  ParseUrl (no network)
// --------------------------------------------------------

fn test_parse_url() {
    Console.WriteLine("== ParseUrl ==");

    let p1 = HttpUtil.ParseUrl("http://example.com/path?q=1");
    checkEq(p1.scheme, "http",        "scheme basic");
    checkEq(p1.host,   "example.com", "host basic");
    checkEq(p1.port,   80,            "port default http");
    checkEq(p1.path,   "/path",       "path basic");
    checkEq(p1.query,  "q=1",         "query basic");

    let p2 = HttpUtil.ParseUrl("http://example.com:8080/api");
    checkEq(p2.port,  8080,   "explicit port");
    checkEq(p2.path,  "/api", "path with port");

    let p3 = HttpUtil.ParseUrl("http://example.com");
    checkEq(p3.path,  "/", "path defaults to /");
    checkEq(p3.query, "",  "query empty");

    let p4 = HttpUtil.ParseUrl("http://[::1]:9000/v1");
    checkEq(p4.host, "::1",  "IPv6 literal host");
    checkEq(p4.port, 9000,   "IPv6 literal port");
    checkEq(p4.path, "/v1",  "IPv6 literal path");

    let p5 = HttpUtil.ParseUrl("https://secure.example.com/");
    checkEq(p5.scheme, "https", "https scheme");
    checkEq(p5.port,   443,     "port default https");

    check(HttpUtil.ParseUrl("") == nil, "empty url returns nil");
    return 0;
}

// --------------------------------------------------------
//  GET
// --------------------------------------------------------

fn test_get() {
    Console.WriteLine("== GET ==");

    let res = Http.Get(base + "/get", nil);
    check(res != nil,                 "get: response not nil");
    checkEq(statusOf(res), Status.OK, "get: status 200");
    check(headersOf(res) != nil,      "get: headers present");
    check(bodyOf(res) != nil,         "get: body present");

    if (res != nil) {
        let json = Json.Parse(res.body);
        check(json != nil,                        "get: body is valid JSON");
        checkEq(json.url, base + "/get", "get: url echoed");
    }

    // Optional headers - omit second arg entirely
    let res2 = Http.Get(base + "/get");
    check(res2 != nil,                  "get: omitted headers not nil");
    checkEq(statusOf(res2), Status.OK,  "get: omitted headers status 200");
    return 0;
}

// --------------------------------------------------------
//  GET with custom headers
// --------------------------------------------------------

fn test_get_headers() {
    Console.WriteLine("== GET custom headers ==");

    let hdrs = { "X-Test-Header": "flaris123", "Accept": "application/json" };
    let res  = Http.Get(base + "/headers", hdrs);
    check(res != nil,                 "get headers: response not nil");
    checkEq(statusOf(res), Status.OK, "get headers: status 200");

    if (res != nil) {
        let json = Json.Parse(res.body);
        check(json != nil, "get headers: valid JSON");
        if (json != nil) {
            checkEq(json.headers["X-Test-Header"], "flaris123", "custom header echoed");
        }
    }
    return 0;
}

// --------------------------------------------------------
//  POST
// --------------------------------------------------------

fn test_post() {
    Console.WriteLine("== POST ==");

    let payload = Json.Stringify({ name: "flaris", value: 42 });
    let res     = Http.Post(base + "/post", payload, nil);
    check(res != nil,                 "post: response not nil");
    checkEq(statusOf(res), Status.OK, "post: status 200");

    if (res != nil) {
        let json = Json.Parse(res.body);
        check(json != nil, "post: valid JSON response");
        if (json != nil) {
            checkEq(json.json.name,  "flaris", "post: body.name echoed");
            checkEq(json.json.value, 42,       "post: body.value echoed");
        }
    }
    return 0;
}

// --------------------------------------------------------
//  Binary body: a block goes out as its bytes
// --------------------------------------------------------

fn test_block_body() {
    Console.WriteLine("== Block body ==");

    let b = Buffer.Create(5, 1);
    b[0] = 0; b[1] = 1; b[2] = 255; b[3] = 65; b[4] = 0;
    let res = Http.Request("POST", base + "/bytes", b, ContentType.Binary);
    checkEq(statusOf(res), Status.OK, "block body: status 200");
    if (res != nil) {
        let j = Json.Parse(res.body);
        checkEq(Json.Stringify(j.bytes), "[0,1,255,65,0]", "block body: every byte arrives, NULs included");
        checkEq(j.contentType, ContentType.Binary, "block body: content type sent");
    }

    let r2 = Http.Post(base + "/bytes", Buffer.FromString("hello"));
    if (r2 != nil) {
        checkEq(Json.Stringify(Json.Parse(r2.body).bytes), "[104,101,108,108,111]",
                "block body via Post: the bytes, not the text \"[block]\"");
    } else {
        check(false, "block body via Post: response");
    }
    return 0;
}

// --------------------------------------------------------
//  Credentials in a URL
// --------------------------------------------------------

fn test_url_credentials() {
    Console.WriteLine("== URL credentials ==");

    // user:pw@ is not part of the host: the request reaches the server, and
    // neither the connect nor the Host header sees the credentials.
    let hostPort = String.Substr(base, String.Length("http://"));
    let res = Http.Get("http://user:pw@" + hostPort + "/headers");
    checkEq(statusOf(res), Status.OK, "userinfo url: request reaches the server");
    if (res != nil) {
        let h = Json.Parse(res.body).headers;
        checkEq(h["Host"], hostPort, "userinfo url: Host header carries no credentials");
        check(h["Authorization"] == nil, "userinfo url: credentials are not sent");
    }
    return 0;
}

// --------------------------------------------------------
//  PUT
// --------------------------------------------------------

fn test_put() {
    Console.WriteLine("== PUT ==");

    let payload = Json.Stringify({ id: 1, updated: true });
    let res     = Http.Put(base + "/put", payload, nil);
    check(res != nil,                 "put: response not nil");
    checkEq(statusOf(res), Status.OK, "put: status 200");

    if (res != nil) {
        let json = Json.Parse(res.body);
        if (json != nil) {
            check(json.json.updated == true, "put: body echoed");
        }
    }
    return 0;
}

// --------------------------------------------------------
//  PATCH
// --------------------------------------------------------

fn test_patch() {
    Console.WriteLine("== PATCH ==");

    let payload = Json.Stringify({ field: "value", partial: true });
    let res     = Http.Patch(base + "/patch", payload, nil);
    check(res != nil,                 "patch: response not nil");
    checkEq(statusOf(res), Status.OK, "patch: status 200");

    if (res != nil) {
        let json = Json.Parse(res.body);
        check(json != nil, "patch: valid JSON response");
        if (json != nil) {
            check(json.json.partial == true, "patch: body echoed");
        }
    }

    // Omit headers
    let res2 = Http.Patch(base + "/patch", payload);
    check(res2 != nil,                  "patch: omitted headers not nil");
    checkEq(statusOf(res2), Status.OK,  "patch: omitted headers status 200");
    return 0;
}

// --------------------------------------------------------
//  QUERY (HTTP QUERY method - safe/idempotent request with a body)
// --------------------------------------------------------

fn test_query_method() {
    Console.WriteLine("== QUERY ==");

    // QUERY is a newer method that many servers still reject with 405. The
    // client must TRANSMIT a QUERY request with a body and get a real HTTP
    // response back; the local server echoes it, so the method and body
    // round-trip is verified as well.
    let payload = Json.Stringify({ filter: "status:open", limit: 10 });
    let res     = Http.Query(base + "/anything", payload, nil);
    check(res != nil,          "query: response not nil");
    check(statusOf(res) > 0,   "query: got a real HTTP status");

    let json = (statusOf(res) == Status.OK) ? Json.Parse(res.body) : nil;
    check(json != nil, "query: valid JSON response");
    if (json != nil) {
        checkEq(json.method, "QUERY", "query: method echoed as QUERY");
        check(json.json.limit == 10, "query: body echoed");
    }

    // Omit headers - still completes end-to-end.
    let res2 = Http.Query(base + "/anything", payload);
    check(res2 != nil,        "query: omitted headers not nil");
    check(statusOf(res2) > 0, "query: omitted headers got a status");
    return 0;
}

// --------------------------------------------------------
//  HEAD
// --------------------------------------------------------

fn test_head() {
    Console.WriteLine("== HEAD ==");

    let res = Http.Head(base + "/get");
    check(res != nil,                 "head: response not nil");
    checkEq(statusOf(res), Status.OK, "head: status 200");

    if (res != nil) {
        // HEAD must return headers but no body
        check(res.headers != nil, "head: headers present");
        check(!("body" in res) || res.body == nil || len(res.body) == 0,
              "head: body is empty");
    }

    // 404 via HEAD
    let r404 = Http.Head(base + "/status/404");
    checkEq(statusOf(r404), Status.NotFound, "head: 404 status");
    return 0;
}

