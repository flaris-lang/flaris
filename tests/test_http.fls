}

// --------------------------------------------------------
//  Non-200 status codes
// --------------------------------------------------------

fn test_status_codes() {
    Console.WriteLine("== Status codes ==");

    let r404 = Http.Get(base + "/status/404", nil);
    check(r404 != nil,                            "404: response not nil");
    checkEq(statusOf(r404), Status.NotFound,      "404: status returned");

    let r500 = Http.Get(base + "/status/500", nil);
    check(r500 != nil,                            "500: response not nil");
    checkEq(statusOf(r500), Status.InternalError, "500: status returned");

    let r401 = Http.Get(base + "/status/401", nil);
    check(r401 != nil,                            "401: response not nil");
    checkEq(statusOf(r401), Status.Unauthorized,  "401: status returned");
    return 0;
}

// --------------------------------------------------------
//  Redirect following
// --------------------------------------------------------

fn test_redirect() {
    Console.WriteLine("== Redirect ==");

    let res = Http.Get(base + "/redirect/1", nil);
    check(res != nil,                 "redirect: response not nil");
    checkEq(statusOf(res), Status.OK, "redirect: followed to 200");

    if (res != nil) {
        let json = Json.Parse(res.body);
        check(json != nil, "redirect: final response is JSON");
    }

    // Multi-hop: 3 hops, still within the 5-hop limit
    let r3 = Http.Get(base + "/redirect/3", nil);
    check(r3 != nil,                   "redirect 3-hop: response not nil");
    checkEq(statusOf(r3), Status.OK,   "redirect 3-hop: followed to 200");

    // Exceeds limit (> 5 hops) - should return nil
    let r6 = Http.Get(base + "/redirect/6", nil);
    check(r6 == nil, "redirect 6-hop: exceeds limit returns nil");

    return 0;
}

