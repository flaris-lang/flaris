// --------------------------------------------------------

fn async test_async_concurrent() {
    Console.WriteLine("== Async concurrent ==");

    let f1 = Http.GetAsync(base + "/get",     nil);
    let f2 = Http.GetAsync(base + "/get?n=2", nil);
    let f3 = Http.GetAsync(base + "/get?n=3", nil);

    let r1 = await f1;
    let r2 = await f2;
    let r3 = await f3;

    check(r1 != nil,                 "concurrent: r1 not nil");
    check(r2 != nil,                 "concurrent: r2 not nil");
    check(r3 != nil,                 "concurrent: r3 not nil");
    checkEq(statusOf(r1), Status.OK, "concurrent: r1 200");
    checkEq(statusOf(r2), Status.OK, "concurrent: r2 200");
    checkEq(statusOf(r3), Status.OK, "concurrent: r3 200");

    if (r2 != nil) {
        let j2 = Json.Parse(r2.body);
        if (j2 != nil) { checkEq(j2.args.n, "2", "concurrent: r2 args.n=2"); }
    }
    if (r3 != nil) {
        let j3 = Json.Parse(r3.body);
        if (j3 != nil) { checkEq(j3.args.n, "3", "concurrent: r3 args.n=3"); }
    }

    return 0;
}

// --------------------------------------------------------
//  Connection reuse
// --------------------------------------------------------

fn peerOf(res) {
    if (res == nil || res.status != Status.OK) { return "-"; }
    return Json.Parse(res.body).peer;
}

fn async test_pool() {
    Console.WriteLine("== Connection reuse ==");
    Http.CloseIdle();

    let first = peerOf(Http.Get(base + "/peer"));
    var same = 0;
    iter (i from 0 to 20) {
        if (peerOf(Http.Get(base + "/peer")) == first) { same += 1; }
    }
    checkEq(same, 20, "sequential GETs share one connection");
    checkEq(peerOf(await Http.GetAsync(base + "/peer")), first, "an async GET takes the same pooled connection");
    let p = Http.Post(base + "/post", Json.Stringify({ n: 1 }));
    checkEq(statusOf(p), Status.OK, "POST on a pooled connection");
    checkEq(peerOf(Http.Get(base + "/peer")), first, "... and the connection stays in step");
    checkEq(statusOf(Http.Get(base + "/redirect/2")), Status.OK, "a redirect chain reuses its connection");
    checkEq(peerOf(Http.Get(base + "/peer")), first, "... and hands it back");

    // A server that closes idle connections: the request goes out again.
    let a = peerOf(Http.Get(idleBase + "/peer"));
    Fiber.Sleep(200);
    let b = Http.Get(idleBase + "/peer");
    checkEq(statusOf(b), Status.OK, "a GET on a connection the server closed is sent again");
    check(peerOf(b) != a && a != "-", "... on a fresh connection");

    if (tlsBase != nil) {
        let opts = { insecure: true };
        let t1 = peerOf(Http.Request("GET", tlsBase + "/peer", nil, nil, nil, opts));
        let t2 = peerOf(Http.Request("GET", tlsBase + "/peer", nil, nil, nil, { insecure: true }));
        let t3 = peerOf(await Http.RequestAsync("GET", tlsBase + "/peer", nil, nil, nil, opts));
        check(t1 != "-" && t1 == t2 && t2 == t3, "https requests with equal options share a connection");
        let t4 = peerOf(Http.Request("GET", tlsBase + "/peer", nil, nil, nil, { insecure: true, timeoutMs: 20000 }));
        check(t4 != "-" && t4 != t1, "other options get a connection of their own");
    }
    Http.CloseIdle();
    checkEq(Http.PoolStats().idle, 0, "CloseIdle empties the pool");
    return 0;
}

// --------------------------------------------------------
//  Deadline
// --------------------------------------------------------

fn async test_deadline() {
    Console.WriteLine("== Deadline ==");
    Http.CloseIdle();

    var t0 = Time.Millis();
    let late = Http.Request("GET", base + "/delay/1000", nil, nil, nil, { deadlineMs: 100 });
    var took = Time.Millis() - t0;
    check(late == nil, "a response slower than deadlineMs gives nil");
    check(took < 800, "... once the deadline passes (" + str(took) + " ms)");

    t0 = Time.Millis();
    let lateAsync = await Http.RequestAsync("GET", base + "/delay/1000", nil, nil, nil, { deadlineMs: 100 });
    took = Time.Millis() - t0;
    check(lateAsync == nil && took < 800, "the same for an async request");

    let viaTransport = Http.Request("GET", base + "/delay/1000", nil, nil, nil, Http.Transport({ deadlineMs: 100 }));
    check(viaTransport == nil, "a transport's deadlineMs");

    // Each chunk arrives well within the read timeout; the whole body does not
    // arrive within the deadline.
    checkEq(bodyOf(Http.Get(base + "/trickle")), "xxxxxxxxxx", "a slow chunked body completes without a deadline");
    t0 = Time.Millis();
    let cut = Http.Request("GET", base + "/trickle", nil, nil, nil, { deadlineMs: 80 });
    took = Time.Millis() - t0;
    check(cut == nil && took < 180, "the deadline ends a body that keeps trickling (" + str(took) + " ms)");

    // A request that meets its deadline leaves the connection with the
    // transport's own read timeout for the next request.
    let first = peerOf(Http.Request("GET", base + "/peer", nil, nil, nil, { deadlineMs: 100 }));
    checkEq(statusOf(Http.Get(base + "/delay/200")), Status.OK, "a later request may take longer than an earlier deadline");
    checkEq(peerOf(Http.Get(base + "/peer")), first, "... on the same connection");
    Http.CloseIdle();
    return 0;
}

// --------------------------------------------------------
//  Streaming responses
// --------------------------------------------------------

global streamed = [];

fn readLines(st) {
    let out = [];
    var line = st.Line();
    while (line != nil) { Array.Append(out, line); line = st.Line(); }
    st.Close();
    return String.Join(out, "|");
}

fn readEvents(st) {
    let out = [];
    var ev = st.Event();
    while (ev != nil) { Array.Append(out, ev.event + "=" + ev.data + "#" + ev.id); ev = st.Event(); }
    st.Close();
    return String.Join(out, "|");
}

fn test_streaming() {
    Console.WriteLine("== Streaming ==");
    Http.CloseIdle();

    streamed = [];
    let sp = Http.StreamPost(base + "/ndjson", "{}", fn(line) { Array.Append(streamed, line); });
    checkEq(sp, Status.OK, "StreamPost status");
    checkEq(String.Join(streamed, "|"), "{\"a\":1}|{\"b\":22}", "StreamPost: the JSON lines, one split across chunks");

    let st = Http.Open("GET", base + "/ndjson");
    checkEq(st?.status, Status.OK, "Open status");
    checkEq(readLines(st), "{\"a\":1}|{\"b\":22}||not json", "Open + Line");

    checkEq(readEvents(Http.Open("GET", base + "/sse")), "message=one#1|up=two\n2#1", "Open + Event");

    let blob = Http.Open("GET", base + "/blob/300000");
    var total = 0;
    var pieces = 0;
    var c = blob.Chunk();
    while (c != nil) { total += len(c); pieces += 1; c = blob.Chunk(); }
    checkEq(total, 300000, "Chunk: every byte of a Content-Length body");
    check(pieces > 1, "... in pieces of at most 64 KB");
    check(blob.IsDone() && blob.Error() == nil, "... done without error");

    checkEq(len(bodyOf(Http.Request("GET", base + "/blob/1000", nil, nil, nil, { maxBodyBytes: 1000 }))), 1000,
            "maxBodyBytes: a body that fits");
    check(Http.Request("GET", base + "/blob/5000", nil, nil, nil, { maxBodyBytes: 1000 }) == nil,
          "maxBodyBytes: a larger body fails the request");
    check(Http.Request("GET", base + "/ndjson", nil, nil, nil, { maxBodyBytes: 10 }) == nil,
          "maxBodyBytes: a chunked body past it fails too");

    let seen = [];
    let r = Http.Sse(base + "/sse", fn(ev) { Array.Append(seen, ev.data); return ev.event != "up"; });
    checkEq(String.Join(seen, ","), "one,two\n2", "Http.Sse delivers each event until onEvent returns false");
    checkEq(r.lastEventId, "1", "... and the id to resume from");

    if (tlsBase != nil) {
        let opts = { insecure: true };
        streamed = [];
        let tsp = Http.StreamPost(tlsBase + "/ndjson", "{}", fn(line) { Array.Append(streamed, line); }, nil,
                                  { insecure: true, readTimeoutMs: 0 });
        checkEq(tsp, Status.OK, "StreamPost over https");
        checkEq(len(streamed), 2, "... the JSON lines");
        checkEq(readLines(Http.Open("GET", tlsBase + "/ndjson", nil, nil, nil, opts)), "{\"a\":1}|{\"b\":22}||not json",
                "Open + Line over https");
        checkEq(readEvents(Http.Open("GET", tlsBase + "/sse", nil, nil, nil, opts)), "message=one#1|up=two\n2#1",
                "Open + Event over https");
    }
    Http.CloseIdle();
    return 0;
}

fn async test_streaming_async() {
    Console.WriteLine("== Streaming async ==");
    let st = await Http.OpenAsync("GET", base + "/ndjson");
    checkEq(readLines(st), "{\"a\":1}|{\"b\":22}||not json", "OpenAsync + Line");
    if (tlsBase != nil) {
        let es = await Http.OpenAsync("GET", tlsBase + "/sse", nil, nil, nil, { insecure: true });
        checkEq(readEvents(es), "message=one#1|up=two\n2#1", "OpenAsync + Event over https");
    }
    Http.CloseIdle();
    return 0;
}

// --------------------------------------------------------
//  Retry-After
// --------------------------------------------------------

fn test_retry_after() {
    Console.WriteLine("== Retry-After ==");
    var refused = Http.Get(base + "/limited");
    if (statusOf(refused) == Status.OK) { refused = Http.Get(base + "/limited"); }
    checkEq(statusOf(refused), 429, "the refusal");
    checkEq(Http.RetryAfterMs(refused), 0, "... carries Retry-After: 0");
    checkEq(statusOf(Http.Get(base + "/limited")), Status.OK, "the next one is let through");
    let t0 = Time.Millis();
    let r = Http.Retry(fn() { return Http.Get(base + "/limited"); }, { attempts: 3, delayMs: 2000 });
    checkEq(statusOf(r), Status.OK, "Http.Retry gets past a refusal");
    check(Time.Millis() - t0 < 1500, "... waiting what Retry-After asked, not delayMs");
    return 0;
}

// --------------------------------------------------------
//  Proxies
// --------------------------------------------------------

global proxy = nil;         // the proxy child
global proxyUrl = "";

fn async startProxy(): bool {
    let plainPort = String.Substr(base, String.LastIndexOf(base, ":") + 1);
    let tlsPort = tlsBase == nil ? "0" : String.Substr(tlsBase, String.LastIndexOf(tlsBase, ":") + 1);
    proxy = Os.Spawn(vmPath(), ["--libs=./libs", "tests/test_http.fls", "proxy", plainPort, tlsPort]);
    if (proxy == nil) { return false; }
    let line = await Stream.ReadLineAsync(proxy.Stdout, 10000);
    if (line == nil || !String.StartsWith(line, "PROXYPORT=")) { return false; }
    proxyUrl = "http://127.0.0.1:" + String.Substr(line, 10);
    return true;
}

fn async stopProxy() {
    if (proxy == nil) { return 0; }
    Stream.Close(proxy.Stdin);
    let w = await Os.WaitAsync(proxy.Pid, 5000);
    if (w == nil || w.Alive) {
        Os.KillChild(proxy.Pid, 9);
        await Os.WaitAsync(proxy.Pid);
    }
    Stream.Close(proxy.Stdout);
    Stream.Close(proxy.Stderr);
    proxy = nil;
    return 0;
}

// What the proxy has seen: { seen: [lines], tunnels, forwards }.
fn proxyLog() {
    let r = Http.Request("GET", proxyUrl + "/seen", nil, nil, nil, { proxy: false, keepAlive: false });
    return r == nil ? { seen: [], tunnels: -1, forwards: -1 } : Json.Parse(r.body);
}

fn sawLine(prefix: string): bool {
    foreach (l in proxyLog().seen) {
        if (String.StartsWith(l, prefix)) { return true; }
    }
    return false;
}

fn async test_proxy() {
    Console.WriteLine("== Proxy ==");
    foreach (v in ["http_proxy", "HTTP_PROXY", "https_proxy", "HTTPS_PROXY", "no_proxy", "NO_PROXY"]) { Os.UnsetEnv(v); }
    if (!(await startProxy())) {
        check(false, "proxy child reports its port");
        return 0;
    }
    Http.CloseIdle();
    let px = { proxy: proxyUrl };

    let r1 = Http.Request("GET", base + "/peer", nil, nil, nil, px);
    let r2 = Http.Request("GET", base + "/peer", nil, nil, nil, px);
    checkEq(statusOf(r1), Status.OK, "http through an explicit proxy");
    check(sawLine("GET " + base + "/peer HTTP/1.1 | -"), "... sent in absolute form");
    checkEq(peerOf(r2), peerOf(r1), "... and the proxy connection is pooled");
    checkEq(proxyLog().forwards, 1, "... one connection to the proxy for both");

    let authed = Http.Request("GET", base + "/get", nil, nil, nil,
                              { proxy: "http://user:p%40ss@" + String.Substr(proxyUrl, 7) });
    checkEq(statusOf(authed), Status.OK, "a proxy URL with credentials");
    check(sawLine("GET " + base + "/get HTTP/1.1 | Basic dXNlcjpwQHNz"), "... sends them as Proxy-Authorization");
    let denied = Http.Request("GET", base + "/get", nil, nil, nil, { proxy: "http://deny:x@" + String.Substr(proxyUrl, 7) });
    checkEq(statusOf(denied), 407, "the proxy's own refusal comes back as the response");

    let direct = Http.Request("GET", base + "/peer", nil, nil, nil, { proxy: proxyUrl, noProxy: "localhost, 127.0.0.1" });
    checkEq(statusOf(direct), Status.OK, "noProxy sends a request direct");

    var threw = false;
    try { Http.Request("GET", base + "/get", nil, nil, nil, { proxy: "socks5://127.0.0.1:1" }); }
    catch (e) { threw = e is HttpUnsupportedError; }
    check(threw, "a proxy that is not http:// raises HttpUnsupportedError");

    if (tlsBase != nil) {
        let tpx = { proxy: proxyUrl, insecure: true };
        let t1 = Http.Request("GET", tlsBase + "/peer", nil, nil, nil, tpx);
        let t2 = Http.Request("GET", tlsBase + "/peer", nil, nil, nil, tpx);
        checkEq(statusOf(t1), Status.OK, "https through a CONNECT tunnel");
        check(sawLine("CONNECT " + String.Substr(tlsBase, 8) + " HTTP/1.1"), "... the proxy saw CONNECT host:port");
        checkEq(peerOf(t2), peerOf(t1), "... and the tunnel is pooled");
        checkEq(proxyLog().tunnels, 1, "... one tunnel for both");
        let ta = await Http.RequestAsync("GET", tlsBase + "/peer", nil, nil, nil, { proxy: proxyUrl, insecure: true, timeoutMs: 9000 });
        checkEq(statusOf(ta), Status.OK, "an async request through a tunnel");
        checkEq(Http.Request("GET", tlsBase + "/get", nil, nil, nil,
                             { proxy: "http://deny:x@" + String.Substr(proxyUrl, 7), insecure: true }), nil,
                "a refused CONNECT gives nil");
    }

    // From the environment: never for this machine, not for no_proxy hosts.
    Os.SetEnv("http_proxy", proxyUrl);
    let e1 = Http.Get("http://flaris-proxy-test.invalid/get");
    checkEq(statusOf(e1), Status.OK, "http_proxy from the environment");
    check(sawLine("GET http://flaris-proxy-test.invalid/get HTTP/1.1"), "... the proxy carried it");
    let before = proxyLog().forwards;
    checkEq(statusOf(Http.Get(base + "/get")), Status.OK, "a loopback host goes direct");
    checkEq(proxyLog().forwards, before, "... without the proxy");
    Os.SetEnv("no_proxy", "example.org, .invalid");
    check(Http.Get("http://flaris-proxy-test.invalid/get") == nil, "no_proxy names the host: direct, and it does not resolve");
    Os.UnsetEnv("no_proxy");
    check(Http.Request("GET", "http://flaris-proxy-test.invalid/get", nil, nil, nil, { proxy: false }) == nil,
          "proxy: false ignores the environment");
    Os.UnsetEnv("http_proxy");
    if (tlsBase != nil) {
        Os.SetEnv("https_proxy", proxyUrl);
        let e2 = Http.Request("GET", "https://flaris-proxy-test.invalid/get", nil, nil, nil, { insecure: true });
        checkEq(statusOf(e2), Status.OK, "https_proxy from the environment");
        check(sawLine("CONNECT flaris-proxy-test.invalid:443 HTTP/1.1"), "... through a tunnel to the named host");
        Os.UnsetEnv("https_proxy");
    }
    Http.CloseIdle();
    await stopProxy();
    return 0;
}

// --------------------------------------------------------
//  Main
// --------------------------------------------------------

fn async Main() {
    let args = Os.Args();
    if (len(args) > 0 && args[0] == "serve") {
        return await serve(len(args) > 1 ? args[1] : nil);
    }
    if (len(args) > 2 && args[0] == "proxy") {
        return await proxyMain(Convert.ParseInt(args[1]) ?? 0, Convert.ParseInt(args[2]) ?? 0);
    }

    Console.WriteLine("=== Http.fls test suite ===");

    test_constants();
    test_parse_url();

    tmpDir = Directory.CreateTemp("flaris_http");
    if (await startServer()) {
        test_get();
        test_get_headers();
        test_post();
        test_block_body();
        test_url_credentials();
        test_put();
        test_patch();
        test_query_method();
        test_head();
        test_delete();
        test_status_codes();
        test_redirect();
        test_query_string();
        test_error_paths();
        test_curl();
        test_wget();
        await test_async();
        await test_async_concurrent();
        await test_pool();
        await test_deadline();
        test_streaming();
        await test_streaming_async();
        test_retry_after();
        await test_proxy();
    } else {
        check(false, "local server did not report its port");
    }
    await stopServer();
    Directory.DeleteAll(tmpDir);

    Console.WriteLine("");
    Console.WriteLine("Results: " + Convert.ToString(testsRun) + " run, " + Convert.ToString(testsFailed) + " failed.");
    if (testsFailed == 0) { Console.WriteLine("All tests passed."); }
    return testsFailed > 0 ? 1 : 0;
}
