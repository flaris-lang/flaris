// Test suite for Zip.fls
//
// Run: ./flarisvm ./tests/test_zip.fls --unsafe

import { Archive, ZipReader, ZipWriter } from library("Zip", "1.0");
import { Inflate, Deflate } from library("Deflate", "1.0");

global testsRun    = 0;
global testsFailed = 0;
// NTFS has no POSIX mode bits (every file stats as 0666) and reserves
// symlink creation for privileged accounts, so the checks that assert on
// either are skipped rather than asserting something Windows cannot do.
global isWindows   = Os.Name() == "Windows";

fn check(cond, msg) {
    testsRun = testsRun + 1;
    if (!cond) { testsFailed = testsFailed + 1; Console.WriteLine("FAIL: " + msg); }
}

fn checkEq(actual, expected, msg) {
    testsRun = testsRun + 1;
    if (actual != expected) {
        testsFailed = testsFailed + 1;
        Console.WriteLine("FAIL: " + msg + "  expected=" + str(expected) + " got=" + str(actual));
    }
}

fn sameBytes(a: block, b: block): bool {
    if (a == nil || b == nil) return false;
    if (len(a) != len(b)) return false;
    for (let i = 0; i < len(a); i += 1) { if (a[i] != b[i]) return false; }
    return true;
}

// ============================================================
//  Round-trip
// ============================================================

fn test_roundtrip() {
    let w = Archive.Create();
    w.Add("hello.txt", "Hello, World!");
    w.Add("sub/nums.txt", "1\n2\n3");
    let zipped = w.Build();
    check(len(zipped) > 0, "Build returns non-empty block");

    let r = Archive.Open(zipped);
    let listed = r.List();
    checkEq(len(listed), 2, "List count = 2");

    checkEq(listed[0].Name,  "hello.txt", "List[0].Name");
    checkEq(listed[0].Size,  13,          "List[0].Size");
    checkEq(listed[0].IsDir, false,       "List[0].IsDir");
    checkEq(listed[1].Name,  "sub/nums.txt", "List[1].Name");
    checkEq(listed[1].Size,  5,              "List[1].Size");

    checkEq(str(r.Read("hello.txt")),    "Hello, World!", "Read hello.txt");
    checkEq(str(r.Read("sub/nums.txt")), "1\n2\n3",       "Read sub/nums.txt");
    check(r.Read("nope.txt") == nil, "Read missing -> nil");
    checkEq(r.Count(), 2, "Count()");
}

fn test_block_and_empty() {
    // A pre-compressed (incompressible) block must survive unchanged - this is
    // the path where deflate loses and the entry is stored instead.
    let blockData = Deflate.Zlib("binary data here");
    let w2 = Archive.Create();
    w2.Add("compressed.bin", blockData);
    let r2 = Archive.Open(w2.Build());
    checkEq(len(r2.List()), 1, "block data: 1 entry");
    checkEq(r2.List()[0].Name, "compressed.bin", "block entry Name");
    check(sameBytes(r2.Read("compressed.bin"), blockData), "block entry bytes survive");

    let w3 = Archive.Create();
    let empty = w3.Build();
    check(len(empty) > 0, "empty Build -> valid bytes");
    checkEq(len(Archive.Open(empty).List()), 0, "empty archive -> 0 entries");

    // Zero-length entry.
    let w4 = Archive.Create();
    w4.Add("zero.bin", Buffer.Create(0, 1));
    let r4 = Archive.Open(w4.Build());
    checkEq(r4.List()[0].Size, 0, "zero-length entry Size");
    checkEq(len(r4.Read("zero.bin")), 0, "zero-length entry Read");
}

fn test_directories() {
    let w = Archive.Create();
    w.Add("d/", "");
    w.Add("d/f.txt", "x");
    let r = Archive.Open(w.Build());
    let l = r.List();
    checkEq(len(l), 2, "dir + file = 2 entries");
    check(l[0].IsDir,  "trailing slash -> IsDir true");
    check(!l[1].IsDir, "regular file -> IsDir false");
    checkEq(l[0].Size, 0, "directory entry Size = 0");
}

fn test_large_payload() {
    // Big enough to exercise real deflate rather than a stored entry. Built
    // in-process: the suite runs this file from the VM repo, so no path into
    // the library repo can be assumed.
    let text = "";
    iter (i from 0 to 399) {
        text = text + "line " + str(i) + " of repetitive but not trivial content; deflate should win here.\n";
    }
    let src = Buffer.FromString(text);
    let w = Archive.Create();
    w.Add("Zip.fls", src);
    let bytes = w.Build();
    let r = Archive.Open(bytes);
    let e = r.List()[0];
    check(e.CompressedSize < e.Size, "large text entry actually compresses");
    check(sameBytes(r.Read("Zip.fls"), src), "large entry round-trips byte-exact");
}

fn test_malformed() {
    checkEq(len(Archive.Open(Buffer.FromString("not a zip at all")).List()), 0, "garbage -> 0 entries");
    checkEq(len(Archive.Open(Buffer.Create(4, 1)).List()), 0, "too short -> 0 entries");
    check(Archive.Open(nil) == nil, "Open(nil) -> nil");

    // A valid archive truncated mid-payload must not hand back bad bytes.
    let w = Archive.Create();
    w.Add("a.txt", "some content here");
    let good = w.Build();
    let cut = Buffer.Slice(good, 0, len(good) - 10);
    checkEq(len(Archive.Open(cut).List()), 0, "truncated central dir -> 0 entries");
}

fn test_disk_io() {
    let path = "/tmp/flaris_test_zip.zip";
    let w = Archive.Create();
    w.Add("a.txt", "disk round trip");
    w.Add("n/b.txt", "nested");
    check(w.Save(path), "Save writes the archive");

    let r = Archive.OpenFile(path);
    check(r != nil, "OpenFile opens it back");
    checkEq(len(r.List()), 2, "OpenFile entry count");
    checkEq(str(r.Read("a.txt")), "disk round trip", "OpenFile Read");

    check(r.Extract("n/b.txt", "/tmp/flaris_test_zip_out/b.txt"), "Extract creates dirs and writes");
    checkEq(File.ReadText("/tmp/flaris_test_zip_out/b.txt"), "nested", "Extract content");

    checkEq(r.ExtractAll("/tmp/flaris_test_zip_all"), 2, "ExtractAll returns file count");
    checkEq(File.ReadText("/tmp/flaris_test_zip_all/a.txt"), "disk round trip", "ExtractAll content");

    check(Archive.OpenFile("/tmp/definitely_missing_zip.zip") == nil, "OpenFile missing -> nil");

    File.Delete(path);
    Directory.DeleteAll("/tmp/flaris_test_zip_out");
    Directory.DeleteAll("/tmp/flaris_test_zip_all");
}

// ============================================================
//  Benchmarks
// ============================================================

fn test_benchmarks() {
    Console.WriteLine("=== Zip benchmarks ===");
    let text = "";
    iter (i from 0 to 4999) {
        text = text + "benchmark line " + str(i) + " with some filler so the payload compresses realistically.\n";
    }
    let src = Buffer.FromString(text);
    let n = len(src);

    let t = Time.Millis();
    let w = Archive.Create();
    w.Add("reference.md", src);
    let bytes = w.Build();
    let build = Time.Millis() - t;

    t = Time.Millis();
    let r = Archive.Open(bytes);
    let list = r.List();
    let open = Time.Millis() - t;

    t = Time.Millis();
    let back = r.Read("reference.md");
    let read = Time.Millis() - t;

    Console.WriteLine("  Build  " + str(n) + " B -> " + str(len(bytes)) + " B : " + str(build) + " ms");
    Console.WriteLine("  Open + List                      : " + str(open) + " ms");
    Console.WriteLine("  Read (inflate)                   : " + str(read) + " ms");

    // Many small entries: exercises central-directory build/parse, not deflate.
    t = Time.Millis();
    let mw = Archive.Create();
    iter (i from 0 to 999) { mw.Add("f" + str(i) + ".txt", "entry number " + str(i)); }
    let mb = mw.Build();
    let manyBuild = Time.Millis() - t;
    t = Time.Millis();
    let mr = Archive.Open(mb);
    let cnt = len(mr.List());
    let manyOpen = Time.Millis() - t;
    Console.WriteLine("  Build 1000 entries               : " + str(manyBuild) + " ms (" + str(len(mb)) + " B)");
    Console.WriteLine("  Open + List 1000 entries         : " + str(manyOpen) + " ms (" + str(cnt) + ")");

    check(sameBytes(back, src), "benchmark payload round-trips");
    checkEq(cnt, 1000, "benchmark 1000 entries listed");
}


// ============================================================
//  Entry-name containment  (Zip Slip)
// ============================================================

fn test_path_containment() {
    let root = "/tmp/flaris_zip_slip";
    Directory.DeleteAll(root);
    Directory.Ensure(root + "/dest");

    let w = Archive.Create();
    w.Add("../escaped.txt",      "traversal");
    w.Add("..\\win_escaped.txt", "windows traversal");
    w.Add("/tmp/abs_escaped.txt", "absolute");
    w.Add("./ok/./fine.txt",     "normalised");
    let r = Archive.Open(w.Build());

    checkEq(r.ExtractAll(root + "/dest"), 1, "only the safe entry is written");
    checkEq(r.SkippedUnsafe(), 3, "three escaping names refused");
    checkEq(File.ReadText(root + "/dest/ok/fine.txt"), "normalised", "safe entry landed, path normalised");
    check(!File.Exists(root + "/escaped.txt"),     "no relative traversal escape");
    check(!File.Exists(root + "/win_escaped.txt"), "no backslash traversal escape");
    check(!File.Exists("/tmp/abs_escaped.txt"),    "no absolute-path escape");

    // SafeName exposes the same judgement without writing anything.
    checkEq(ZipReader.SafeName("a/b.txt"),  "a/b.txt", "SafeName passes an ordinary name");
    checkEq(ZipReader.SafeName("./a/./b"),  "a/b",     "SafeName normalises . segments");
    check(ZipReader.SafeName("../x")   == nil, "SafeName rejects ..");
    check(ZipReader.SafeName("/etc/x") == nil, "SafeName rejects absolute");
    check(ZipReader.SafeName("C:/x")   == nil, "SafeName rejects drive-relative");
    check(ZipReader.SafeName("")       == nil, "SafeName rejects empty");

    // A symlinked directory already on disk redirects an innocent-looking name.
    if (!isWindows) {
        Directory.Ensure(root + "/outside");
        Directory.Ensure(root + "/dest2");
        File.CreateSymlink(root + "/outside", root + "/dest2/logs");
        let w2 = Archive.Create();
        w2.Add("logs/app.txt", "through a symlink");
        let r2 = Archive.Open(w2.Build());
        checkEq(r2.ExtractAll(root + "/dest2"), 0, "symlinked parent blocks the write");
        checkEq(r2.SkippedUnsafe(), 1, "symlink traversal counted as unsafe");
        check(!File.Exists(root + "/outside/app.txt"), "nothing written through the symlink");
    }

    Directory.DeleteAll(root);
}

// ============================================================
//  Payload verification
// ============================================================

fn test_crc_verification() {
    let w = Archive.Create();
    w.Add("a.txt", "the quick brown fox");
    let z = w.Build();
    checkEq(str(Archive.Open(z).Read("a.txt")), "the quick brown fox", "clean payload reads back");

    // Corrupt one payload byte; the stored CRC no longer matches.
    let at = Buffer.IndexOf(z, "quick");
    check(at > 0, "payload located for tampering");
    Buffer.WriteU8At(z, at, 88);
    check(Archive.Open(z).Read("a.txt") == nil, "tampered payload reads as nil, not as wrong bytes");
}

// ============================================================
//  Entry metadata: timestamps and modes
// ============================================================

fn test_metadata() {
    let stamp = 1577975045;            // 2020-01-02T14:24:05Z

    let w = Archive.Create();
    w.Add("plain.txt", "x", { modified: stamp });
    w.Add("script.sh", "#!/bin/sh\n", { modified: stamp, mode: 33261 });   // 0100755
    w.Add("packed.bin", String.Repeat("a", 2000), { store: true });
    let r = Archive.Open(w.Build());

    let byName = { };
    foreach (e in r.List()) { byName[e.Name] = e; }

    // Two-second DOS resolution: the stored value is the timestamp rounded down.
    checkEq(byName["plain.txt"].Modified, stamp - (stamp % 2), "timestamp round-trips at DOS resolution");
    checkEq(byName["script.sh"].Mode, 33261, "unix mode round-trips");
    checkEq(byName["plain.txt"].Mode, 0, "no mode stored when none was given");

    // { store: true } must leave the payload uncompressed even when it would
    // compress well - 2000 identical bytes otherwise deflate to almost nothing.
    check(byName["packed.bin"].CompressedSize == 2000, "store:true skips compression");
    checkEq(str(r.Read("packed.bin")), String.Repeat("a", 2000), "stored payload round-trips");

    // Extraction restores what it safely can.
    let out = "/tmp/flaris_zip_meta";
    Directory.DeleteAll(out);
    checkEq(r.ExtractAll(out), 3, "all three entries extracted");
    let st = File.Stat(out + "/script.sh");
    check(st != nil, "extracted script stat");
    if (st != nil && !isWindows) { checkEq(st.Mode & 511, 493, "executable bit restored as 0755"); }
    let st2 = File.Stat(out + "/plain.txt");
    if (st2 != nil) { checkEq(st2.Modified, stamp - (stamp % 2), "mtime restored on disk"); }
    Directory.DeleteAll(out);
}

fn test_mode_sanitising() {
    // Modes an archive must not be allowed to hand out verbatim.
    let w = Archive.Create();
    w.Add("suid",  "x", { mode: 35309 });   // 0104755  setuid + rwxr-xr-x
    w.Add("ww",    "x", { mode: 33206 });   // 0100666  world-writable
    w.Add("tight", "x", { mode: 33152 });   // 0100600  owner-only
    let r = Archive.Open(w.Build());

    let out = "/tmp/flaris_zip_modes";
    Directory.DeleteAll(out);
    checkEq(r.ExtractAll(out), 3, "all entries extracted");

    let a = File.Stat(out + "/suid");
    let b = File.Stat(out + "/ww");
    let c = File.Stat(out + "/tight");
    if (!isWindows) {
        if (a != nil) { checkEq(a.Mode & 4095, 493, "setuid stripped, exec kept (0755)"); }
        if (b != nil) { checkEq(b.Mode & 4095, 420, "group/other write dropped (0644)"); }
        if (c != nil) { checkEq(c.Mode & 4095, 384, "restrictive 0600 preserved"); }
    }
    Directory.DeleteAll(out);
}

// ============================================================
//  Directory packaging and archive comment
// ============================================================

fn test_add_directory() {
    let src = "/tmp/flaris_zip_tree";
    Directory.DeleteAll(src);
    Directory.Ensure(src + "/bin");
    Directory.Ensure(src + "/docs/deep");
    File.WriteText(src + "/top.txt",            "top");
    File.WriteText(src + "/bin/run.sh",         "#!/bin/sh\n");
    File.WriteText(src + "/docs/readme.md",     "readme");
    File.WriteText(src + "/docs/deep/note.txt", "note");
    File.WriteText(src + "/skip.tmp",           "temporary");
    File.SetMode(src + "/bin/run.sh", 493);

    let w = Archive.Create();
    let added = w.AddDirectory(src, { prefix: "app/",
                    filter: fn(rel, _st) { return !String.EndsWith(rel, ".tmp"); } });
    checkEq(added, 4, "AddDirectory walks the tree and honours the filter");
    w.SetComment("built by the test suite");

    let r = Archive.Open(w.Build());
    checkEq(r.Comment(), "built by the test suite", "archive comment round-trips");
    checkEq(len(r.List()), 4, "four entries in the archive");
    checkEq(str(r.Read("app/docs/deep/note.txt")), "note", "nested entry name carries the prefix");
    check(r.Read("app/skip.tmp") == nil, "filtered file is absent");

    var exec = 0;
    foreach (e in r.List()) { if ((e.Mode & 73) != 0) { exec = exec + 1; } }
    if (!isWindows) { checkEq(exec, 1, "only the executable file carries an exec bit"); }

    // Extract into a destination that does not exist yet, nested two deep.
    let out = "/tmp/flaris_zip_tree_out/nested";
    Directory.DeleteAll("/tmp/flaris_zip_tree_out");
    checkEq(r.ExtractAll(out), 4, "ExtractAll creates missing parent directories");
    checkEq(File.ReadText(out + "/app/docs/deep/note.txt"), "note", "deep file extracted");

    Directory.DeleteAll(src);
    Directory.DeleteAll("/tmp/flaris_zip_tree_out");
}

fn test_empty_comment() {
    let w = Archive.Create();
    w.Add("a.txt", "x");
    checkEq(Archive.Open(w.Build()).Comment(), "", "no comment reads as empty string");
}

// ============================================================

fn Main() {
    Console.WriteLine("=== Zip tests ===");
    test_roundtrip();
    test_block_and_empty();
    test_directories();
    test_large_payload();
    test_malformed();
    test_disk_io();
    test_path_containment();
    test_crc_verification();
    test_metadata();
    test_mode_sanitising();
    test_add_directory();
    test_empty_comment();
    test_benchmarks();

    Console.WriteLine("");
    Console.WriteLine("Tests run:" + str(testsRun) + "  failed:" + str(testsFailed));
    if (testsFailed > 0) { return 1; }
    Console.WriteLine("✅ All Zip tests passed!");
    return 0;
}
