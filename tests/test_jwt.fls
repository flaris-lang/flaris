fn Main() {
    let jwt    = new Jwt();
    let secret = "super-secret";
    let now    = Time.Now();

    // ============================================================
    //  Base64Url helpers
    // ============================================================

    assert("B64Url encode hello",
        jwt.Base64UrlEncodeString("hello") == "aGVsbG8");

    assert("B64Url decode hello",
        jwt.Base64UrlDecodeToString("aGVsbG8") == "hello");

    let rt = jwt.Base64UrlDecodeToString(jwt.Base64UrlEncodeString("Man"));
    assert("B64Url round-trip 'Man'", rt == "Man");

    // ============================================================
    //  Encode / Decode
    // ============================================================

    let payload = { sub: "user-123", role: "admin" };
    let token = jwt.EncodeHS256(payload, secret, { iat: now, exp: now + 3600 });

    assert("EncodeHS256 returns string", token != nil);
    assert("Token has 3 parts", len(String.Split(token, ".")) == 3);

    let decoded = jwt.Decode(token);
    assert("Decode not nil",          decoded != nil);
    assert("Decode sub",              decoded.payload.sub == "user-123");
    assert("Decode role",             decoded.payload.role == "admin");
    assert("Decode exp present",      decoded.payload.exp == now + 3600);
    assert("Decode header alg",       decoded.header.alg == "HS256");
    assert("Decode header typ",       decoded.header.typ == "JWT");
    assert("Decode signingInput",     len(decoded.signingInput) > 0);
    assert("Decode signatureHex len", len(decoded.signatureHex) == 64);

    // Claims containing JSON-special characters must be escaped in the
    // canonical payload and survive an encode -> decode round-trip.
    let special = "say \"hi\"\\path\nline\ttab";
    let specialToken = jwt.EncodeHS256({ sub: special }, secret, { exp: now + 3600 });
    assert("Special-char claim encodes",        specialToken != nil);
    assert("Special-char claim verifies",       jwt.VerifyHS256(specialToken, secret));
    let specialDecoded = jwt.Decode(specialToken);
    assert("Special-char claim decodes",        specialDecoded != nil);
    assert("Special-char claim round-trips",    specialDecoded != nil && specialDecoded.payload.sub == special);

    // EncodeHS256 with omitted options
    let tokenNoOpts = jwt.EncodeHS256({ sub: "bare" }, secret);
    assert("EncodeHS256 omitted options", tokenNoOpts != nil);
    assert("EncodeHS256 omitted options verifies", jwt.VerifyHS256(tokenNoOpts, secret));

    // ============================================================
    //  VerifyHS256
    // ============================================================

    assert("Verify own token",        jwt.VerifyHS256(token, secret));
    assert("Verify wrong secret",     !jwt.VerifyHS256(token, "wrong-secret"));
    assert("Verify tampered token",   !jwt.VerifyHS256(token + "x", secret));
    assert("Verify empty string",     !jwt.VerifyHS256("", secret));
    assert("Verify malformed",        !jwt.VerifyHS256("a.b", secret));

    let knownToken  = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiYWRtaW4iOnRydWUsImlhdCI6MTUxNjIzOTAyMn0.KMUFsIDTnFmyG3nMiGM6H9FNFUROf3wh7SmqJp-QV30";
    let knownSecret = "a-string-secret-at-least-256-bits-long";
    assert("Verify jwt.io known token", jwt.VerifyHS256(knownToken, knownSecret));

    let knownDecoded = jwt.Decode(knownToken);
    assert("Known token sub",   knownDecoded.payload.sub == "1234567890");
    assert("Known token name",  knownDecoded.payload.name == "John Doe");
    assert("Known token admin", knownDecoded.payload.admin == true);

    // ============================================================
    //  VerifyHS256WithClaims - valid token
    // ============================================================

    assert("WithClaims basic",
        jwt.VerifyHS256WithClaims(token, secret, { now: now }));

    assert("WithClaims with leeway",
        jwt.VerifyHS256WithClaims(token, secret, { now: now, leeway: 30 }));

    assert("WithClaims requireExp present",
        jwt.VerifyHS256WithClaims(token, secret, { now: now, requireExp: true }));

    assert("WithClaims requireIat present",
        jwt.VerifyHS256WithClaims(token, secret, { now: now, requireIat: true }));

    // VerifyHS256WithClaims with omitted options
    assert("WithClaims omitted options",
        jwt.VerifyHS256WithClaims(token, secret));

    // ============================================================
    //  VerifyHS256WithClaims - expired token
    // ============================================================

    let expiredToken = jwt.EncodeHS256(
        { sub: "old-user" },
        secret,
        { iat: now - 7200, exp: now - 3600 }
    );
    assert("Expired token fails", !jwt.VerifyHS256WithClaims(expiredToken, secret, { now: now }));

    assert("Expired token passes with large leeway",
        jwt.VerifyHS256WithClaims(expiredToken, secret, { now: now, leeway: 7200 }));

    // ============================================================
    //  VerifyHS256WithClaims - nbf (not before)
    // ============================================================

    let nbfToken = jwt.EncodeHS256(
        { sub: "future-user" },
        secret,
        { iat: now, nbf: now + 600, exp: now + 3600 }
    );

    assert("nbf in future fails",
        !jwt.VerifyHS256WithClaims(nbfToken, secret, { now: now }));

    assert("nbf in future passes with leeway",
        jwt.VerifyHS256WithClaims(nbfToken, secret, { now: now, leeway: 600 }));

    assert("nbf passes when now is past nbf",
        jwt.VerifyHS256WithClaims(nbfToken, secret, { now: now + 601 }));

    // ============================================================
    //  VerifyHS256WithClaims - requireExp on token without exp
    // ============================================================

    let noExpToken = jwt.EncodeHS256(
        { sub: "no-exp" },
        secret,
        { iat: now }
    );

    assert("No exp passes without requireExp",
        jwt.VerifyHS256WithClaims(noExpToken, secret, { now: now }));

    assert("No exp fails with requireExp",
        !jwt.VerifyHS256WithClaims(noExpToken, secret, { now: now, requireExp: true }));

    // ============================================================
    //  VerifyHS256WithClaims - wrong secret still fails claims check
    // ============================================================

    assert("Wrong secret fails even with valid claims",
        !jwt.VerifyHS256WithClaims(token, "wrong", { now: now }));

    // ============================================================
    //  IsExpired
    // ============================================================

    assert("IsExpired: valid token is not expired",    !jwt.IsExpired(token));
    assert("IsExpired: expired token is expired",       jwt.IsExpired(expiredToken));
    assert("IsExpired: no exp token is not expired",   !jwt.IsExpired(noExpToken));
    assert("IsExpired: malformed token returns true",   jwt.IsExpired("not.a.token"));

    // ============================================================
    //  ExpiresAt
    // ============================================================

    assert("ExpiresAt: returns exp",        jwt.ExpiresAt(token) == now + 3600);
    assert("ExpiresAt: expired token",      jwt.ExpiresAt(expiredToken) == now - 3600);
    assert("ExpiresAt: no exp returns nil", jwt.ExpiresAt(noExpToken) == nil);
    assert("ExpiresAt: malformed nil",      jwt.ExpiresAt("bad") == nil);

    // ============================================================
    //  GetClaim
    // ============================================================

    assert("GetClaim: sub",          jwt.GetClaim(token, "sub") == "user-123");
    assert("GetClaim: role",         jwt.GetClaim(token, "role") == "admin");
    assert("GetClaim: exp",          jwt.GetClaim(token, "exp") == now + 3600);
    assert("GetClaim: missing key",  jwt.GetClaim(token, "nonexistent") == nil);
    assert("GetClaim: malformed",    jwt.GetClaim("bad.token", "sub") == nil);

    // GetClaim on known token
    assert("GetClaim known name",    jwt.GetClaim(knownToken, "name") == "John Doe");
    assert("GetClaim known admin",   jwt.GetClaim(knownToken, "admin") == true);

    // ============================================================
    //  Garbage / malformed tokens
    // ============================================================

    // No dots at all
    assert("Decode garbage no-dots",   jwt.Decode("notajwt") == nil);
    assert("Verify garbage no-dots",   !jwt.VerifyHS256("notajwt", secret));
    assert("GetClaim garbage no-dots", jwt.GetClaim("notajwt", "sub") == nil);
    assert("IsExpired garbage",        jwt.IsExpired("notajwt"));

    // Valid 3-part structure but payload is not JSON
    // parts[1] = base64url("this is not json")
    let nonJsonToken = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dGhpcyBpcyBub3QganNvbg.fakeSig";
    assert("Decode non-JSON payload nil",   jwt.Decode(nonJsonToken) == nil);
    assert("Verify non-JSON payload false", !jwt.VerifyHS256(nonJsonToken, secret));
    assert("GetClaim non-JSON nil",         jwt.GetClaim(nonJsonToken, "sub") == nil);

    // Invalid base64url characters in signature
    let badB64Token = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ0ZXN0In0.!!invalid!!";
    assert("Decode bad-base64 sig nil",   jwt.Decode(badB64Token) == nil);
    assert("Verify bad-base64 sig false", !jwt.VerifyHS256(badB64Token, secret));

    // ============================================================
    //  GetClaimFromDecoded
    // ============================================================

    let decodedForClaim = jwt.Decode(token);
    assert("GetClaimFromDecoded: sub",
        jwt.GetClaimFromDecoded(decodedForClaim, "sub") == "user-123");
    assert("GetClaimFromDecoded: role",
        jwt.GetClaimFromDecoded(decodedForClaim, "role") == "admin");
    assert("GetClaimFromDecoded: exp",
        jwt.GetClaimFromDecoded(decodedForClaim, "exp") == now + 3600);
    assert("GetClaimFromDecoded: missing key returns nil",
        jwt.GetClaimFromDecoded(decodedForClaim, "nonexistent") == nil);
    assert("GetClaimFromDecoded: nil decoded returns nil",
        jwt.GetClaimFromDecoded(nil, "sub") == nil);

    let decodedKnown = jwt.Decode(knownToken);
    assert("GetClaimFromDecoded: known token name",
        jwt.GetClaimFromDecoded(decodedKnown, "name") == "John Doe");
    assert("GetClaimFromDecoded: known token admin",
        jwt.GetClaimFromDecoded(decodedKnown, "admin") == true);

    // ============================================================
    //  Refresh
    // ============================================================

    // Success: refreshing a valid token returns a new valid token
    let refreshed = Jwt.Refresh(token, secret, 7200);
    assert("Refresh: returns non-nil on valid token", refreshed != nil);
    assert("Refresh: result verifies with same secret",
        jwt.VerifyHS256(refreshed, secret));
    assert("Refresh: new exp is approximately now+7200",
        jwt.GetClaim(refreshed, "exp") >= Time.Now() + 7199 &&
        jwt.GetClaim(refreshed, "exp") <= Time.Now() + 7201);
    assert("Refresh: sub claim is preserved",
        jwt.GetClaim(refreshed, "sub") == "user-123");

    // Failure: wrong secret → nil
    let refreshedBadSecret = Jwt.Refresh(token, "wrong-secret", 3600);
    assert("Refresh: wrong secret returns nil", refreshedBadSecret == nil);

    // Failure: malformed token → nil
    let refreshedMalformed = Jwt.Refresh("not.a.jwt", secret, 3600);
    assert("Refresh: malformed token returns nil", refreshedMalformed == nil);

    // Failure: empty token → nil
    let refreshedEmpty = Jwt.Refresh("", secret, 3600);
    assert("Refresh: empty token returns nil", refreshedEmpty == nil);

    // ============================================================
    //  HS512 (HMAC-SHA512)
    // ============================================================

    let t512 = jwt.EncodeHS512(payload, secret, { iat: now, exp: now + 3600 });
    assert("EncodeHS512 returns string",   t512 != nil);
    assert("HS512 header alg is HS512",    jwt.Decode(t512).header.alg == "HS512");
    assert("HS512 verifies own token",     jwt.VerifyHS512(t512, secret));
    assert("HS512 rejects wrong secret",   !jwt.VerifyHS512(t512, "wrong-secret"));
    assert("HS512 rejects tampered token", !jwt.VerifyHS512(t512 + "x", secret));
    assert("HS512 HS256 verifier rejects HS512 sig", !jwt.VerifyHS256(t512, secret));
    assert("HS512 WithClaims valid",       jwt.VerifyHS512WithClaims(t512, secret, { now: now }));
    let t512exp = jwt.EncodeHS512({ sub: "x" }, secret, { exp: now - 10 });
    assert("HS512 WithClaims expired fails", !jwt.VerifyHS512WithClaims(t512exp, secret, { now: now }));

    // ============================================================
    //  EdDSA (Ed25519) - asymmetric
    // ============================================================

    let kp  = Crypto.Ed25519KeyPair();
    let kp2 = Crypto.Ed25519KeyPair();
    let ted = jwt.EncodeEdDSA(payload, kp.SecretKey, { iat: now, exp: now + 3600 });
    assert("EncodeEdDSA returns string",   ted != nil);
    assert("EdDSA header alg is EdDSA",    jwt.Decode(ted).header.alg == "EdDSA");
    assert("EdDSA payload preserved",      jwt.Decode(ted).payload.sub == "user-123");
    assert("EdDSA verifies with public key", jwt.VerifyEdDSA(ted, kp.PublicKey));
    assert("EdDSA rejects wrong public key", !jwt.VerifyEdDSA(ted, kp2.PublicKey));
    assert("EdDSA rejects tampered token",   !jwt.VerifyEdDSA(ted + "x", kp.PublicKey));
    assert("EdDSA WithClaims valid",         jwt.VerifyEdDSAWithClaims(ted, kp.PublicKey, { now: now }));
    let tedExp = jwt.EncodeEdDSA({ sub: "x" }, kp.SecretKey, { exp: now - 10 });
    assert("EdDSA WithClaims expired fails", !jwt.VerifyEdDSAWithClaims(tedExp, kp.PublicKey, { now: now }));

    // ============================================================
    //  Every documented method is callable on the class
    // ============================================================

    assert("static Base64UrlEncodeString",   Jwt.Base64UrlEncodeString("hello") == "aGVsbG8");
    assert("static Base64UrlDecodeToString", Jwt.Base64UrlDecodeToString("aGVsbG8") == "hello");
    let s256 = Jwt.EncodeHS256({ sub: "s" }, secret, { exp: now + 60 });
    let s512 = Jwt.EncodeHS512({ sub: "s" }, secret, { exp: now + 60 });
    let sEd  = Jwt.EncodeEdDSA({ sub: "s" }, kp.SecretKey, { exp: now + 60 });
    assert("static EncodeHS256/VerifyHS256",           Jwt.VerifyHS256(s256, secret));
    assert("static VerifyHS256WithClaims",             Jwt.VerifyHS256WithClaims(s256, secret, { now: now }));
    assert("static VerifyDecodedHS256",                Jwt.VerifyDecodedHS256(Jwt.Decode(s256), secret, { now: now }));
    assert("static EncodeHS512/VerifyHS512",           Jwt.VerifyHS512(s512, secret));
    assert("static VerifyHS512WithClaims",             Jwt.VerifyHS512WithClaims(s512, secret, { now: now }));
    assert("static EncodeEdDSA/VerifyEdDSA",           Jwt.VerifyEdDSA(sEd, kp.PublicKey));
    assert("static VerifyEdDSAWithClaims",             Jwt.VerifyEdDSAWithClaims(sEd, kp.PublicKey, { now: now }));
    assert("static ValidateClaims",                    Jwt.ValidateClaims({ exp: now + 60 }, { now: now }));
    assert("static IsExpired",                         !Jwt.IsExpired(s256));
    assert("static ExpiresAt",                         Jwt.ExpiresAt(s256) == now + 60);
    assert("static GetClaim",                          Jwt.GetClaim(s512, "sub") == "s");
    assert("static GetClaimFromDecoded",               Jwt.GetClaimFromDecoded(Jwt.Decode(sEd), "sub") == "s");
    assert("static Refresh",                           Jwt.VerifyHS256(Jwt.Refresh(s256, secret, 120), secret));

    // ============================================================
    //  Encode never writes the caller's payload
    // ============================================================

    let mine = { sub: "keep" };
    let tm1 = Jwt.EncodeHS256(mine, secret, { iat: now, exp: now + 60, nbf: now });
    let tm2 = Jwt.EncodeHS512(mine, secret, { iat: now, exp: now + 60 });
    let tm3 = Jwt.EncodeEdDSA(mine, kp.SecretKey, { exp: now + 60 });
    assert("Encode leaves payload keys unchanged", len(Object.Keys(mine)) == 1 && mine.sub == "keep");
    assert("Encode leaves no exp/iat/nbf on payload", mine.exp == nil && mine.iat == nil && mine.nbf == nil);
    assert("Encode copy still carries the claims",
        Jwt.GetClaim(tm1, "nbf") == now && Jwt.GetClaim(tm2, "iat") == now && Jwt.GetClaim(tm3, "exp") == now + 60);
    assert("Encode copy keeps the payload's own claims", Jwt.GetClaim(tm1, "sub") == "keep");
    let preset = { sub: "p", exp: 5 };
    let tm4 = Jwt.EncodeHS256(preset, secret, { exp: 9 });
    assert("Option exp overrides payload exp in the token only", Jwt.GetClaim(tm4, "exp") == 9 && preset.exp == 5);

    // ============================================================
    //  aud / iss (checked only when the options ask)
    // ============================================================

    let tAud  = Jwt.EncodeHS256({ sub: "a", aud: "api", iss: "auth.example" }, secret, { exp: now + 60 });
    let tAuds = Jwt.EncodeHS256({ sub: "a", aud: ["web", "api"] }, secret, { exp: now + 60 });
    let tNone = Jwt.EncodeHS256({ sub: "a" }, secret, { exp: now + 60 });
    assert("aud string matches string",        Jwt.VerifyHS256WithClaims(tAud, secret, { now: now, aud: "api" }));
    assert("aud string mismatch fails",        !Jwt.VerifyHS256WithClaims(tAud, secret, { now: now, aud: "other" }));
    assert("aud string in accepted array",     Jwt.VerifyHS256WithClaims(tAud, secret, { now: now, aud: ["x", "api"] }));
    assert("aud string not in accepted array", !Jwt.VerifyHS256WithClaims(tAud, secret, { now: now, aud: ["x", "y"] }));
    assert("aud array contains expected",      Jwt.VerifyHS256WithClaims(tAuds, secret, { now: now, aud: "api" }));
    assert("aud array lacks expected",         !Jwt.VerifyHS256WithClaims(tAuds, secret, { now: now, aud: "admin" }));
    assert("aud array overlaps accepted array", Jwt.VerifyHS256WithClaims(tAuds, secret, { now: now, aud: ["admin", "web"] }));
    assert("aud arrays disjoint fails",        !Jwt.VerifyHS256WithClaims(tAuds, secret, { now: now, aud: ["admin", "cli"] }));
    assert("aud required but token has none",  !Jwt.VerifyHS256WithClaims(tNone, secret, { now: now, aud: "api" }));
    assert("iss matches",                      Jwt.VerifyHS256WithClaims(tAud, secret, { now: now, iss: "auth.example" }));
    assert("iss mismatch fails",               !Jwt.VerifyHS256WithClaims(tAud, secret, { now: now, iss: "evil.example" }));
    assert("iss required but token has none",  !Jwt.VerifyHS256WithClaims(tNone, secret, { now: now, iss: "auth.example" }));
    assert("aud + iss both match",             Jwt.VerifyHS256WithClaims(tAud, secret, { now: now, aud: "api", iss: "auth.example" }));
    assert("aud ok but iss wrong fails",       !Jwt.VerifyHS256WithClaims(tAud, secret, { now: now, aud: "api", iss: "x" }));
    assert("token aud ignored without option", Jwt.VerifyHS256WithClaims(tAud, secret, { now: now }));
    assert("token aud ignored, no options",    Jwt.VerifyHS256WithClaims(tAud, secret));
    assert("VerifyDecodedHS256 checks aud",    !Jwt.VerifyDecodedHS256(Jwt.Decode(tAud), secret, { aud: "other" }));
    assert("ValidateClaims checks iss",        !Jwt.ValidateClaims({ iss: "a" }, { iss: "b" }));
    let t512Aud = Jwt.EncodeHS512({ aud: "api", iss: "me" }, secret);
    assert("HS512 WithClaims aud match",       Jwt.VerifyHS512WithClaims(t512Aud, secret, { aud: "api", iss: "me" }));
    assert("HS512 WithClaims aud mismatch",    !Jwt.VerifyHS512WithClaims(t512Aud, secret, { aud: "web" }));
    let tEdAud = Jwt.EncodeEdDSA({ aud: ["api"], iss: "me" }, kp.SecretKey);
    assert("EdDSA WithClaims aud match",       Jwt.VerifyEdDSAWithClaims(tEdAud, kp.PublicKey, { aud: "api", iss: "me" }));
    assert("EdDSA WithClaims iss mismatch",    !Jwt.VerifyEdDSAWithClaims(tEdAud, kp.PublicKey, { iss: "you" }));

    // ============================================================
    //  Algorithm pinning on the HMAC verifiers
    // ============================================================

    // A token with its own header but an HS256 MAC over it.
    let hsPayload = Jwt.Base64UrlEncodeString("{\"sub\":\"pin\"}");
    let as512  = macToken("{\"alg\":\"HS512\",\"typ\":\"JWT\"}", hsPayload, secret);
    let asNone = macToken("{\"alg\":\"none\",\"typ\":\"JWT\"}", hsPayload, secret);
    let asCrit = macToken("{\"alg\":\"HS256\",\"crit\":[\"exp\"]}", hsPayload, secret);
    let asOk   = macToken("{\"alg\":\"HS256\",\"typ\":\"JWT\"}", hsPayload, secret);
    assert("HS256 MAC under a hand-made header verifies", Jwt.VerifyHS256(asOk, secret));
    assert("HS256 verifier rejects a header naming HS512", !Jwt.VerifyHS256(as512, secret));
    assert("HS256 verifier rejects alg none",              !Jwt.VerifyHS256(asNone, secret));
    assert("HS256 verifier rejects a crit header",         !Jwt.VerifyHS256(asCrit, secret));
    assert("VerifyDecodedHS256 rejects alg none",          !Jwt.VerifyDecodedHS256(Jwt.Decode(asNone), secret));
    assert("HS512 verifier rejects an HS256 header",       !Jwt.VerifyHS512(withAlgHeader(t512, "HS256"), secret));
    assert("EdDSA verifier rejects an HS256 token",        !Jwt.VerifyEdDSA(token, kp.PublicKey));
    assert("HS256 verifier refuses a non-string secret",   !Jwt.VerifyHS256(token, 42));
    let pemSigned = Jwt.EncodeHS256({ sub: "admin" }, RSA_PEM);
    assert("HS256 verifier refuses a PEM key as secret",   !Jwt.VerifyHS256(pemSigned, RSA_PEM));

    // ============================================================
    //  RS256 / ES256 test vectors of RFC 7515
    // ============================================================

    let rfcRsa = Jwt.KeyFromJwk({ kty: "RSA", n: RFC_RSA_N, e: "AQAB" });
    let rfcEc  = Jwt.KeyFromJwk({ kty: "EC", crv: "P-256", x: RFC_EC_X, y: RFC_EC_Y });
    assert("RFC 7515 A.2 RSA key reads",          rfcRsa != nil);
    assert("RFC 7515 A.3 EC key reads",           rfcEc != nil);
    assert("RFC 7515 A.2 RS256 token verifies",   Jwt.VerifyRS256(RFC_RS256, rfcRsa));
    assert("RFC 7515 A.3 ES256 token verifies",   Jwt.VerifyES256(RFC_ES256, rfcEc));
    assert("RFC 7515 A.2 claims before exp",      Jwt.VerifyRS256WithClaims(RFC_RS256, rfcRsa, { now: 1300819000, iss: "joe" }));
    assert("RFC 7515 A.2 claims after exp",       !Jwt.VerifyRS256WithClaims(RFC_RS256, rfcRsa, { now: 1300819400 }));
    assert("RFC 7515 A.3 claims before exp",      Jwt.VerifyES256WithClaims(RFC_ES256, rfcEc, { now: 1300819000 }));
    assert("RFC 7515 A.3 claims after exp",       !Jwt.VerifyES256WithClaims(RFC_ES256, rfcEc, { now: 1300819400 }));
    assert("RFC 7515 A.2 with the A.3 key fails", !Jwt.VerifyRS256(RFC_RS256, rfcEc));
    assert("RFC 7515 A.3 with the A.2 key fails", !Jwt.VerifyES256(RFC_ES256, rfcRsa));
    assert("RFC 7515 A.2 key as a plain JWK",     Jwt.VerifyRS256(RFC_RS256, { kty: "RSA", n: RFC_RSA_N, e: "AQAB" }));
    assert("RFC 7515 A.3 key as JWK JSON text",
        Jwt.VerifyES256(RFC_ES256, "{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"" + RFC_EC_X + "\",\"y\":\"" + RFC_EC_Y + "\"}"));

    // ============================================================
    //  RS256 / RS384 / RS512 / PS256 / ES256 from openssl
    // ============================================================

    let rsaKey = Jwt.KeyFromJwk(RSA_JWK);
    let ecKey  = Jwt.KeyFromJwk(EC_JWK);
    let at     = { now: 1700000100 };
    assert("RS256 verifies",                  Jwt.VerifyRS256(T_RS256, rsaKey));
    assert("RS384 verifies",                  Jwt.VerifyRS384(T_RS384, rsaKey));
    assert("RS512 verifies",                  Jwt.VerifyRS512(T_RS512, rsaKey));
    assert("PS256 verifies",                  Jwt.VerifyPS256(T_PS256, rsaKey));
    assert("ES256 verifies",                  Jwt.VerifyES256(T_ES256, ecKey));
    assert("ES256 verifies twice with a key", Jwt.VerifyES256(T_ES256, ecKey));
    assert("RS256 with a 4096-bit key",       Jwt.VerifyRS256(T_RS256_4096, RSA4096_JWK));
    assert("RS256 WithClaims",                Jwt.VerifyRS256WithClaims(T_RS256, rsaKey, { now: 1700000100, aud: "api", iss: "auth.example" }));
    assert("RS384 WithClaims",                Jwt.VerifyRS384WithClaims(T_RS384, rsaKey, at));
    assert("RS512 WithClaims",                Jwt.VerifyRS512WithClaims(T_RS512, rsaKey, at));
    assert("PS256 WithClaims",                Jwt.VerifyPS256WithClaims(T_PS256, rsaKey, at));
    assert("ES256 WithClaims",                Jwt.VerifyES256WithClaims(T_ES256, ecKey, { now: 1700000100, aud: "api" }));
    assert("RS256 WithClaims expired",        !Jwt.VerifyRS256WithClaims(T_RS256, rsaKey, { now: 1800000000 }));
    assert("ES256 WithClaims wrong aud",      !Jwt.VerifyES256WithClaims(T_ES256, ecKey, { now: 1700000100, aud: "web" }));
    assert("RS256 WithClaims wrong iss",      !Jwt.VerifyRS256WithClaims(T_RS256, rsaKey, { now: 1700000100, iss: "evil" }));

    // Keys from PEM files.
    assert("SubjectPublicKeyInfo RSA PEM",    Jwt.VerifyRS256(T_RS256, Jwt.KeyFromPem(RSA_PEM)));
    assert("PKCS #1 RSA PEM",                 Jwt.VerifyPS256(T_PS256, Jwt.KeyFromPem(RSA_PKCS1_PEM)));
    assert("SubjectPublicKeyInfo P-256 PEM",  Jwt.VerifyES256(T_ES256, Jwt.KeyFromPem(EC_PEM)));
    assert("PEM text as the key",             Jwt.VerifyRS512(T_RS512, RSA_PEM));
    assert("PEM without its end line",        Jwt.KeyFromPem(String.Substr(RSA_PEM, 0, 60)) == nil);
    assert("PEM with a damaged body",         Jwt.KeyFromPem(String.Replace(RSA_PEM, "MIIB", "MIIC")) == nil);
    assert("PEM of something else",           Jwt.KeyFromPem("-----BEGIN CERTIFICATE-----\nAAAA\n-----END CERTIFICATE-----") == nil);

    // The call pins the algorithm.
    assert("RS384 verifier rejects RS256",    !Jwt.VerifyRS384(T_RS256, rsaKey));
    assert("RS256 verifier rejects PS256",    !Jwt.VerifyRS256(T_PS256, rsaKey));
    assert("PS256 verifier rejects RS256",    !Jwt.VerifyPS256(T_RS256, rsaKey));
    assert("ES256 verifier rejects RS256",    !Jwt.VerifyES256(T_RS256, rsaKey));
    assert("RS256 verifier with an EC key",   !Jwt.VerifyRS256(T_RS256, ecKey));
    assert("ES256 verifier with an RSA key",  !Jwt.VerifyES256(T_ES256, rsaKey));
    assert("RS256 with the other RSA key",    !Jwt.VerifyRS256(T_RS256_KEY2, rsaKey));

    // Tampering.
    let rsParts = String.Split(T_RS256, ".");
    let esParts = String.Split(T_ES256, ".");
    let otherPayload = Jwt.Base64UrlEncodeString("{\"sub\":\"admin\",\"iat\":1700000000,\"exp\":1700003600,\"aud\":\"api\",\"iss\":\"auth.example\"}");
    assert("RS256 tampered payload",          !Jwt.VerifyRS256(rsParts[0] + "." + otherPayload + "." + rsParts[2], rsaKey));
    assert("ES256 tampered payload",          !Jwt.VerifyES256(esParts[0] + "." + otherPayload + "." + esParts[2], ecKey));
    assert("RS256 tampered signature",        !Jwt.VerifyRS256(rsParts[0] + "." + rsParts[1] + "." + flipChar(rsParts[2], 40), rsaKey));
    assert("PS256 tampered signature",        !Jwt.VerifyPS256(flipLast(T_PS256, 50), rsaKey));
    assert("ES256 tampered r",                !Jwt.VerifyES256(esParts[0] + "." + esParts[1] + "." + flipChar(esParts[2], 10), ecKey));
    assert("ES256 tampered s",                !Jwt.VerifyES256(esParts[0] + "." + esParts[1] + "." + flipChar(esParts[2], 60), ecKey));
    assert("RS256 truncated signature",       !Jwt.VerifyRS256(rsParts[0] + "." + rsParts[1] + "." + String.Substr(rsParts[2], 0, 300), rsaKey));
    assert("ES256 signature of zeros",        !Jwt.VerifyES256(esParts[0] + "." + esParts[1] + "." + Jwt.Base64UrlEncodeString(String.Repeat("\x01", 64)), ecKey));
    let rsAsRs512 = Jwt.Base64UrlEncodeString("{\"alg\":\"RS512\",\"typ\":\"JWT\",\"kid\":\"rsa-1\"}");
    let rsAsNone  = Jwt.Base64UrlEncodeString("{\"alg\":\"none\",\"typ\":\"JWT\"}");
    assert("RS256 signature under an RS512 header", !Jwt.VerifyRS512(rsAsRs512 + "." + rsParts[1] + "." + rsParts[2], rsaKey));
    assert("alg none with an empty signature",      !Jwt.VerifyWithKey(rsAsNone + "." + rsParts[1] + ".", rsaKey, at));
    assert("alg none with the RS256 signature",     !Jwt.VerifyWithKey(rsAsNone + "." + rsParts[1] + "." + rsParts[2], rsaKey, at));
    assert("HS256 MAC keyed with the RSA PEM",      !Jwt.VerifyWithKey(pemSigned, rsaKey));
    assert("HS256 MAC keyed with the RSA PEM text", !Jwt.VerifyWithKey(pemSigned, RSA_PEM));
    assert("not a token",                           !Jwt.VerifyES256("a.b", ecKey) && !Jwt.VerifyRS256(nil, rsaKey));
    assert("no key",                                !Jwt.VerifyRS256(T_RS256, nil) && !Jwt.VerifyES256(T_ES256, "junk"));

    // VerifyWithKey takes the algorithm from the header when the key allows it.
    assert("VerifyWithKey RS256",             Jwt.VerifyWithKey(T_RS256, rsaKey, at));
    assert("VerifyWithKey RS384",             Jwt.VerifyWithKey(T_RS384, rsaKey, at));
    assert("VerifyWithKey PS256",             Jwt.VerifyWithKey(T_PS256, RSA_JWK, at));
    assert("VerifyWithKey ES256",             Jwt.VerifyWithKey(T_ES256, EC_PEM, at));
    assert("VerifyWithKey checks claims",     !Jwt.VerifyWithKey(T_RS256, rsaKey, { now: 1800000000 }));
    assert("VerifyWithKey honours algs",      !Jwt.VerifyWithKey(T_PS256, rsaKey, { now: 1700000100, algs: ["RS256"] }));
    assert("VerifyWithKey algs allows",       Jwt.VerifyWithKey(T_PS256, rsaKey, { now: 1700000100, algs: ["RS256", "PS256"] }));
    let pinned = Jwt.KeyFromJwk({ kty: "RSA", n: RSA_JWK.n, e: RSA_JWK.e, alg: "RS256" });
    assert("a JWK alg pins the key",          Jwt.VerifyWithKey(T_RS256, pinned, at) && !Jwt.VerifyWithKey(T_RS512, pinned, at));
    assert("a pinned key refuses its other algs", !Jwt.VerifyPS256(T_PS256, pinned));

    // ============================================================
    //  JWK and JWK Set handling
    // ============================================================

    let set = Jwt.KeySet({ keys: [RSA_JWK, RSA2_JWK, EC_JWK, RSA1024_JWK, { kty: "oct", k: "c2VjcmV0" }] });
    assert("KeySet keeps the usable keys",    len(set) == 3);
    assert("JWKS picks rsa-1 by kid",         Jwt.VerifyWithJwks(T_RS256, set, at));
    assert("JWKS picks rsa-2 by kid",         Jwt.VerifyWithJwks(T_RS256_KEY2, set, at));
    assert("JWKS picks ec-1 by kid",          Jwt.VerifyWithJwks(T_ES256, set, at));
    assert("JWKS PS256 by kid",               Jwt.VerifyWithJwks(T_PS256, set, at));
    assert("JWKS checks claims",              !Jwt.VerifyWithJwks(T_RS256, set, { now: 1700000100, aud: "web" }));
    assert("JWKS as JSON text",
        Jwt.VerifyWithJwks(T_ES256, "{\"keys\":[" + Json.Stringify(EC_JWK) + "," + Json.Stringify(RSA_JWK) + "]}", at));
    assert("JWKS as an array of JWKs",        Jwt.VerifyWithJwks(T_RS256, [RSA2_JWK, RSA_JWK], at));
    assert("JWKS unknown kid",                !Jwt.VerifyWithJwks(T_RS256, [RSA2_JWK, EC_JWK], at));
    assert("JWKS kid of the wrong type",      !Jwt.VerifyWithJwks(T_RS256, [{ kty: "EC", crv: "P-256", kid: "rsa-1", x: EC_JWK.x, y: EC_JWK.y }], at));
    assert("JWKS without kid, one RSA key",   Jwt.VerifyWithJwks(T_RS256_NOKID, [RSA_JWK, EC_JWK], at));
    assert("JWKS without kid, two RSA keys",  !Jwt.VerifyWithJwks(T_RS256_NOKID, [RSA_JWK, RSA2_JWK], at));
    assert("JWKS skips use:enc keys",
        !Jwt.VerifyWithJwks(T_RS256, [{ kty: "RSA", kid: "rsa-1", use: "enc", n: RSA_JWK.n, e: RSA_JWK.e }], at));
    assert("JWKS honours key_ops",
        Jwt.VerifyWithJwks(T_RS256, [{ kty: "RSA", kid: "rsa-1", key_ops: ["verify"], n: RSA_JWK.n, e: RSA_JWK.e }], at)
        && !Jwt.VerifyWithJwks(T_RS256, [{ kty: "RSA", kid: "rsa-1", key_ops: ["encrypt"], n: RSA_JWK.n, e: RSA_JWK.e }], at));
    assert("JWKS that is not one",            !Jwt.VerifyWithJwks(T_RS256, "not json", at) && len(Jwt.KeySet(42)) == 0);

    assert("JWK: RSA below 2048 bits",        Jwt.KeyFromJwk(RSA1024_JWK) == nil);
    assert("JWK: even exponent",              Jwt.KeyFromJwk({ kty: "RSA", n: RSA_JWK.n, e: "AQAA" }) == nil);
    assert("JWK: exponent 1",                 Jwt.KeyFromJwk({ kty: "RSA", n: RSA_JWK.n, e: "AQ" }) == nil);
    assert("JWK: RSA alg that is not RSA",    Jwt.KeyFromJwk({ kty: "RSA", n: RSA_JWK.n, e: "AQAB", alg: "ES256" }) == nil);
    assert("JWK: EC point off the curve",     Jwt.KeyFromJwk({ kty: "EC", crv: "P-256", x: EC_JWK.x, y: RFC_EC_Y }) == nil);
    assert("JWK: EC coordinate too short",    Jwt.KeyFromJwk({ kty: "EC", crv: "P-256", x: "AQID", y: EC_JWK.y }) == nil);
    assert("JWK: P-384 is not supported",     Jwt.KeyFromJwk({ kty: "EC", crv: "P-384", x: EC_JWK.x, y: EC_JWK.y }) == nil);
    assert("JWK: EC alg that is not ES256",   Jwt.KeyFromJwk({ kty: "EC", crv: "P-256", x: EC_JWK.x, y: EC_JWK.y, alg: "RS256" }) == nil);
    assert("JWK: symmetric key",              Jwt.KeyFromJwk({ kty: "oct", k: "c2VjcmV0" }) == nil);
    assert("JWK: not a JWK",                  Jwt.KeyFromJwk("nonsense") == nil && Jwt.KeyFromJwk(7) == nil && Jwt.KeyFromJwk({ kty: "RSA" }) == nil);

    // ============================================================
    //  Summary
    // ============================================================

    Console.WriteLine("");
    Console.WriteLine("Results: " + str(passed) + " passed, " + str(failed) + " failed.");
    if (failed > 0) {
        Console.Error("Some JWT tests FAILED.");
        return 1;
    }
    Console.Ok("All JWT tests passed!");

    let bJwt    = new Jwt();
    let bSecret = "super-secret-bench-key";
    let bPay    = { sub: "user-42", role: "admin", uid: 1234 };
    let bToken  = bJwt.EncodeHS256(bPay, bSecret, { iat: 1700000000, exp: 1700086400 });
    let bStr    = "Hello, World! This is a base64 encoding test.";

    Console.WriteLine("\n\n=== JWT Benchmarks ===");
    Console.WriteLine(String.PadRight("benchmark", 48), String.PadLeft("total", 9), "      ", String.PadLeft("µs/call", 11));
    benchSep();

    Console.WriteLine("\n[ Base64Url helpers ]");
    bench("Base64UrlEncodeString  (45-char input)", fn() {
        let s = bJwt.Base64UrlEncodeString(bStr); _sink = _sink + 1;
    }, 5000);
    bench("Base64UrlDecodeToString  (base64url - str)", fn() {
        let s = bJwt.Base64UrlDecodeToString(bJwt.Base64UrlEncodeString(bStr));
        _sink = _sink + 1;
    }, 3000);

    Console.WriteLine("\n[ Token lifecycle ]");
    bench("EncodeHS256  (sign + encode)", fn() {
        let t = bJwt.EncodeHS256(bPay, bSecret, nil); _sink = _sink + 1;
    }, 500);
    bench("Decode  (base64+JSON, no verify)", fn() {
        let d = bJwt.Decode(bToken); _sink = _sink + 1;
    }, 2000);
    bench("VerifyHS256  (HMAC-SHA256 check)", fn() {
        let ok = bJwt.VerifyHS256(bToken, bSecret); _sink = _sink + 1;
    }, 500);
    bench("GetClaim  (re-decodes token each call)", fn() {
        let v = bJwt.GetClaim(bToken, "sub"); _sink = _sink + 1;
    }, 2000);
    let bDecoded = bJwt.Decode(bToken);
    bench("GetClaimFromDecoded  (pre-decoded, O(1))", fn() {
        let v = bJwt.GetClaimFromDecoded(bDecoded, "sub"); _sink = _sink + 1;
    }, 2000);


    Console.WriteLine("\n[ Public-key verification ]");
    let bRsa  = Jwt.KeyFromJwk(RSA_JWK);
    let bRsa4 = Jwt.KeyFromJwk(RSA4096_JWK);
    let bEc   = Jwt.KeyFromJwk(EC_JWK);
    let bSet  = Jwt.KeySet({ keys: [RSA_JWK, RSA2_JWK, EC_JWK] });
    bench("VerifyRS256  (2048-bit key)", fn() {
        if (Jwt.VerifyRS256(T_RS256, bRsa)) { _sink = _sink + 1; }
    }, 50);
    bench("VerifyPS256  (2048-bit key)", fn() {
        if (Jwt.VerifyPS256(T_PS256, bRsa)) { _sink = _sink + 1; }
    }, 50);
    bench("VerifyRS256  (4096-bit key)", fn() {
        if (Jwt.VerifyRS256(T_RS256_4096, bRsa4)) { _sink = _sink + 1; }
    }, 20);
    bench("VerifyES256  (P-256)", fn() {
        if (Jwt.VerifyES256(T_ES256, bEc)) { _sink = _sink + 1; }
    }, 10);
    bench("VerifyWithJwks  (RS256, 3-key set, claims)", fn() {
        if (Jwt.VerifyWithJwks(T_RS256, bSet, { now: 1700000100 })) { _sink = _sink + 1; }
    }, 50);
    bench("KeyFromJwk  (RSA 2048)", fn() {
        if (Jwt.KeyFromJwk(RSA_JWK) != nil) { _sink = _sink + 1; }
    }, 200);
    bench("KeyFromJwk  (EC P-256, on-curve check)", fn() {
        if (Jwt.KeyFromJwk(EC_JWK) != nil) { _sink = _sink + 1; }
    }, 200);
    bench("KeyFromPem  (RSA 2048)", fn() {
        if (Jwt.KeyFromPem(RSA_PEM) != nil) { _sink = _sink + 1; }
    }, 200);

    benchSep();
    Console.WriteLine("_sink=" + str(_sink));
    return 0;
}
