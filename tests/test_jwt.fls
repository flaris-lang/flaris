// test_jwt.fls
// Tests for Jwt.fls - encode, decode, verify (HMAC, EdDSA, RSA, ECDSA), JWK
// and JWK Set keys, and claims validation.

import { Jwt } from library("libs/Jwt", "1.0");
import { Util } from library("libs/Util", "1.0");

global passed = 0;
global failed = 0;
global _sink  = 0;

fn bench(name: string, f: fn, n: int) {
    f(); f(); f();
    let t0: int = Time.Ticks();
    iter (i from 0 to n) { f(); }
    let dt: int = Time.Ticks() - t0;
    let ms: float = Time.TicksToMs(dt);
    let us: float = Time.TicksToUs(dt) / float(n);
    Console.WriteLine(
        String.PadRight(name, 48),
        String.PadLeft(String.FormatArray("{0:.2f}", [ms]),   9), " ms  ",
        String.PadLeft(String.FormatArray("{0:.4f}", [us]),  11), " µs/call"
    );
}

fn benchSep() { Console.WriteLine(String.Repeat("-", 74)); }

fn assert(name:string, cond:bool) {
    if (cond) {
        Console.WriteLine("[PASS] " + name);
        passed += 1;
    } else {
        Console.WriteLine("[FAIL] " + name);
        failed += 1;
    }
}

// A token with header JSON headerJson over payload part payloadB64, MAC'ed
// with HS256 under secret.
fn macToken(headerJson: string, payloadB64: string, secret: string): string {
    let si = Jwt.Base64UrlEncodeString(headerJson) + "." + payloadB64;
    return si + "." + Util.Base64UrlEncode(Util.HexToBin(Crypto.HmacSha256(secret, si)));
}

// Token t with its header replaced by one naming alg.
fn withAlgHeader(t: string, alg: string): string {
    let p = String.Split(t, ".");
    return Jwt.Base64UrlEncodeString("{\"alg\":\"" + alg + "\",\"typ\":\"JWT\"}") + "." + p[1] + "." + p[2];
}

// s with the base64url character at i changed.
fn flipChar(s: string, i: int): string {
    let c = (s[i] == 'A' ? "B" : "A");
    return String.Substr(s, 0, i) + c + String.Substr(s, i + 1);
}

// Token t with the character n places from its end changed.
fn flipLast(t: string, n: int): string {
    return flipChar(t, len(t) - n);
}

