// ============================================================
fn Main() {
    Console.WriteLine("=== TreeMap test suite ===");

    test_basic();
    test_sorted_order();
    test_minmax();
    test_range();
    test_floor_ceil_prev_next();
    test_pop();
    test_foreach();
    test_rank_select();
    test_head_tail();
    test_int_keys();
    test_clear_clone_equals();
    test_put_replace();
    test_utility_methods();
    test_keyset();
    test_merge();
    test_count_range();
    test_from_entries();
    test_type_enforcement();
    test_benchmark();
    test_foreach_obj_pattern();
    test_lower_higher_key();
    test_clone_independence();
    test_equals_edge_cases();
    test_getor_edge_cases();
    test_put_replace_extended();
    test_pop_extended();
    test_merge_extended();
    test_count_range_extended();
    test_from_entries_extended();
    test_utility_extended();
    test_rank_select_extended();
    test_head_tail_extended();

    Console.WriteLine("");
    Console.WriteLine("Results: " + str(passed) + " passed, " + str(failed) + " failed.");
    if (failed == 0) {
        Console.Ok("All tests passed!");
        return 0;
    }
    Console.Error("Some tests FAILED.");
    return 1;
}