// test_treemap.fls - Test suite for Treemap.fls
// Run: flarisvm test_treemap.fls

import { TreeMap } from library("./libs/Treemap", "1.0");

global passed = 0;
global failed = 0;

fn check(label:string, cond:bool) {
    if (cond) {
        Console.WriteLine("[PASS] " + label);
        passed += 1;
    } else {
        Console.WriteLine("[FAIL] " + label);
        failed += 1;
    }
}

fn checkEq(label:string, actual, expected) {
    if (actual == expected) {
        Console.WriteLine("[PASS] " + label);
        passed += 1;
    } else {
        Console.WriteLine("[FAIL] " + label + "  expected=" + str(expected) + "  got=" + str(actual));
        failed += 1;
    }
}

// ============================================================
// 1. Basic insert / get / has / delete
// ============================================================
fn test_basic() {
    Console.WriteLine("== Basic ==");
    let m = new TreeMap();
    check("empty IsEmpty",  m.IsEmpty());
    checkEq("empty Size",   m.Size(), 0);

    m.Set("b", 2);
    m.Set("a", 1);
    m.Set("c", 3);

    checkEq("Size 3",      m.Size(), 3);
    check("not IsEmpty",   !m.IsEmpty());
    checkEq("Get a",       m.Get("a"), 1);
    checkEq("Get b",       m.Get("b"), 2);
    checkEq("Get c",       m.Get("c"), 3);
    check("Has b",         m.Has("b"));
    check("Has z false",   !m.Has("z"));
    checkEq("GetOr z",     m.GetOr("z", -1), -1);
    checkEq("GetOr a",     m.GetOr("a", -1), 1);

    m.Set("b", 99);
    checkEq("Update b",    m.Get("b"), 99);
    checkEq("Size after update", m.Size(), 3);

    check("Delete b true", m.Delete("b"));
    check("Delete z false",!m.Delete("z"));
    check("Has b false",   !m.Has("b"));
    checkEq("Size after delete", m.Size(), 2);
}

// ============================================================
// 2. Keys sorted
// ============================================================
fn test_sorted_order() {
    Console.WriteLine("== Sorted order ==");
    let m = new TreeMap();
    m.Set("d", 4);
    m.Set("a", 1);
    m.Set("c", 3);
    m.Set("b", 2);

    let ks = m.Keys();
    checkEq("Keys[0]", ks[0], "a");
    checkEq("Keys[1]", ks[1], "b");
    checkEq("Keys[2]", ks[2], "c");
    checkEq("Keys[3]", ks[3], "d");

    let vs = m.Values();
    checkEq("Values[0]", vs[0], 1);
    checkEq("Values[3]", vs[3], 4);

    let es = m.Entries();
    checkEq("Entries[0].Key",   es[0].Key,   "a");
    checkEq("Entries[0].Value", es[0].Value, 1);
    checkEq("Entries[3].Key",   es[3].Key,   "d");
}

// ============================================================
// 3. Min / Max / aliases
// ============================================================
fn test_minmax() {
    Console.WriteLine("== Min/Max ==");
    let m = new TreeMap();
    checkEq("MinKey empty", m.MinKey(), nil);
    checkEq("MaxKey empty", m.MaxKey(), nil);
    checkEq("MinEntry empty", m.MinEntry(), nil);
    checkEq("MaxEntry empty", m.MaxEntry(), nil);

    m.Set("b", 2); m.Set("a", 1); m.Set("c", 3);
    checkEq("MinKey", m.MinKey(), "a");
    checkEq("MaxKey", m.MaxKey(), "c");
    checkEq("FirstKey", m.FirstKey(), "a");
    checkEq("LastKey", m.LastKey(), "c");
    checkEq("MinEntry.Key",   m.MinEntry().Key,   "a");
    checkEq("MinEntry.Value", m.MinEntry().Value, 1);
    checkEq("MaxEntry.Key",   m.MaxEntry().Key,   "c");
    checkEq("MaxEntry.Value", m.MaxEntry().Value, 3);
    checkEq("FirstEntry.Key", m.FirstEntry().Key, "a");
    checkEq("LastEntry.Key",  m.LastEntry().Key,  "c");
}

// ============================================================
// 4. Range
// ============================================================
fn test_range() {
    Console.WriteLine("== Range ==");
    let m = new TreeMap();
    m.Set("a", 1); m.Set("b", 2); m.Set("c", 3); m.Set("d", 4);

    let rc = m.Range("a", "c", true, true);
    checkEq("Range closed len", len(rc), 3);
    checkEq("Range closed[0]",  rc[0].Key, "a");
    checkEq("Range closed[2]",  rc[2].Key, "c");

    let ro = m.Range("a", "c", false, false);
    checkEq("Range open len",   len(ro), 1);
    checkEq("Range open[0]",    ro[0].Key, "b");

    let rh = m.Range("b", "d", true, false);
    checkEq("Range half-open len", len(rh), 2);
    checkEq("Range half-open[0]",  rh[0].Key, "b");
    checkEq("Range half-open[1]",  rh[1].Key, "c");

    let rx = m.Range("e", "z", true, true);
    checkEq("Range out-of-range", len(rx), 0);

    let ry = m.Range("z", "a", true, true);
    checkEq("Range reversed empty", len(ry), 0);
}

// ============================================================
// 5. Floor / Ceil / Prev / Next / aliases
// ============================================================
fn test_floor_ceil_prev_next() {
    Console.WriteLine("== Floor/Ceil/Prev/Next ==");
    let m = new TreeMap();
    m.Set("a", 1); m.Set("b", 2); m.Set("c", 3);

    checkEq("FloorKey a",   m.FloorKey("a"),  "a");
    checkEq("FloorKey b",   m.FloorKey("b"),  "b");
    checkEq("FloorKey aa",  m.FloorKey("aa"), "a");
    checkEq("FloorKey z",   m.FloorKey("z"),  "c");
    checkEq("FloorKey 0",   m.FloorKey("0"),  nil);

    checkEq("CeilKey a",    m.CeilKey("a"),   "a");
    checkEq("CeilKey b",    m.CeilKey("b"),   "b");
    checkEq("CeilKey aa",   m.CeilKey("aa"),  "b");
    checkEq("CeilKey 0",    m.CeilKey("0"),   "a");
    checkEq("CeilKey z",    m.CeilKey("z"),   nil);

    checkEq("PrevKey b",    m.PrevKey("b"),   "a");
    checkEq("PrevKey a",    m.PrevKey("a"),   nil);
    checkEq("PrevKey c",    m.PrevKey("c"),   "b");

    checkEq("NextKey b",    m.NextKey("b"),   "c");
    checkEq("NextKey c",    m.NextKey("c"),   nil);
    checkEq("NextKey a",    m.NextKey("a"),   "b");

    checkEq("LowerKey",     m.LowerKey("c"),  "b");
    checkEq("HigherKey",    m.HigherKey("a"), "b");
}

// ============================================================
// 6. Pop / delete min max
// ============================================================
fn test_pop() {
    Console.WriteLine("== PopMin/PopMax ==");
    let m = new TreeMap();
    m.Set("b", 2); m.Set("a", 1); m.Set("c", 3);

    let pmin = m.PopMin();
    checkEq("PopMin Key",   pmin.Key,   "a");
    checkEq("PopMin Value", pmin.Value, 1);
    checkEq("Size after PopMin", m.Size(), 2);

    let pmax = m.PopMax();
    checkEq("PopMax Key",   pmax.Key,   "c");
    checkEq("PopMax Value", pmax.Value, 3);
    checkEq("Size after PopMax", m.Size(), 1);

    m.PopMin();
    checkEq("PopMin on empty", m.PopMin(), nil);
    checkEq("PopMax on empty", m.PopMax(), nil);

    let m2 = new TreeMap();
    m2.Set("a", 1); m2.Set("b", 2); m2.Set("c", 3);
    check("DeleteMin true", m2.DeleteMin());
    checkEq("DeleteMin Size", m2.Size(), 2);
    checkEq("DeleteMin MinKey", m2.MinKey(), "b");
    check("DeleteMax true", m2.DeleteMax());
    checkEq("DeleteMax Size", m2.Size(), 1);
    checkEq("DeleteMax MaxKey", m2.MaxKey(), "b");
}

// ============================================================
// 7. ForEach / EachKey / EachValue
// ============================================================
fn test_foreach() {
    Console.WriteLine("== ForEach ==");
    let m = new TreeMap();
    m.Set("b", 2); m.Set("a", 1); m.Set("c", 3);

    global fe_count  = 0;
    global fe_keys_s = "";
    global fe_val_sum = 0;
    m.ForEach(fn(k, v) {
        fe_count  += 1;
        fe_keys_s  = fe_keys_s + k;
        fe_val_sum += v;
    });

    checkEq("ForEach count",    fe_count,   3);
    checkEq("ForEach keys asc", fe_keys_s,  "abc");
    checkEq("ForEach val sum",  fe_val_sum, 6);

    global ek = "";
    m.EachKey(fn(k) { ek = ek + k; });
    checkEq("EachKey", ek, "abc");

    global ev = 0;
    m.EachValue(fn(v) { ev += v; });
    checkEq("EachValue", ev, 6);

    let m2 = new TreeMap();
    m2.Set("x", 10).Set("y", 20);
    checkEq("Set chaining", m2.Size(), 2);
}

// ============================================================
// 8. Rank / Select
// ============================================================
fn test_rank_select() {
    Console.WriteLine("== Rank/Select ==");
    let m = new TreeMap();
    m.Set("a", 1); m.Set("b", 2); m.Set("c", 3); m.Set("d", 4);

    checkEq("Rank a",  m.Rank("a"), 0);
    checkEq("Rank b",  m.Rank("b"), 1);
    checkEq("Rank c",  m.Rank("c"), 2);
    checkEq("Rank d",  m.Rank("d"), 3);
    checkEq("Rank z",  m.Rank("z"), -1);

    checkEq("Select 0",  m.Select(0), "a");
    checkEq("Select 1",  m.Select(1), "b");
    checkEq("Select 3",  m.Select(3), "d");
    checkEq("Select -1", m.Select(-1), nil);
    checkEq("Select 99", m.Select(99), nil);

    checkEq("SelectEntry 0 Key", m.SelectEntry(0).Key, "a");
    checkEq("SelectEntry 0 Value", m.SelectEntry(0).Value, 1);
    checkEq("SelectEntry bad", m.SelectEntry(99), nil);
}

// ============================================================
// 9. HeadEntries / TailEntries
// ============================================================
fn test_head_tail() {
    Console.WriteLine("== HeadEntries/TailEntries ==");
    let m = new TreeMap();
    m.Set("a", 1); m.Set("b", 2); m.Set("c", 3); m.Set("d", 4);

    let h1 = m.HeadEntries("b", true);
    checkEq("HeadEntries b incl len",  len(h1), 2);
    checkEq("HeadEntries b incl[0]",   h1[0].Key, "a");
    checkEq("HeadEntries b incl[1]",   h1[1].Key, "b");

    let h2 = m.HeadEntries("b", false);
    checkEq("HeadEntries b excl len",  len(h2), 1);
    checkEq("HeadEntries b excl[0]",   h2[0].Key, "a");

    let t1 = m.TailEntries("c", true);
    checkEq("TailEntries c incl len",  len(t1), 2);
    checkEq("TailEntries c incl[0]",   t1[0].Key, "c");
    checkEq("TailEntries c incl[1]",   t1[1].Key, "d");

    let t2 = m.TailEntries("c", false);
    checkEq("TailEntries c excl len",  len(t2), 1);
    checkEq("TailEntries c excl[0]",   t2[0].Key, "d");

    let h3 = m.HeadEntries("z", true);
    checkEq("HeadEntries beyond all",  len(h3), 4);

    let t3 = m.TailEntries("0", true);
    checkEq("TailEntries before all",  len(t3), 4);
}

// ============================================================
// 10. Int keys
// ============================================================
fn test_int_keys() {
    Console.WriteLine("== Int keys ==");
    let m = new TreeMap();
    m.Set(5, "e"); m.Set(1, "a"); m.Set(3, "c"); m.Set(2, "b"); m.Set(4, "d");

    let ks = m.Keys();
    checkEq("int keys sorted[0]", ks[0], 1);
    checkEq("int keys sorted[4]", ks[4], 5);
    checkEq("int MinKey", m.MinKey(), 1);
    checkEq("int MaxKey", m.MaxKey(), 5);
    checkEq("int FloorKey 3", m.FloorKey(3), 3);
    checkEq("int CeilKey 2",  m.CeilKey(2),  2);
    checkEq("int PrevKey 3",  m.PrevKey(3),  2);
    checkEq("int NextKey 3",  m.NextKey(3),  4);
    checkEq("int Rank 3",     m.Rank(3),     2);
    checkEq("int Select 2",   m.Select(2),   3);
}

// ============================================================
// 11. Clear / Clone / Equals
// ============================================================
fn test_clear_clone_equals() {
    Console.WriteLine("== Clear/Clone/Equals ==");
    let m = new TreeMap();
    m.Set("a", 1); m.Set("b", 2);

    let c = m.Clone();
    check("Clone equals original", m.Equals(c));
    checkEq("Clone size", c.Size(), 2);

    c.Set("c", 3);
    check("Clone diverges", !m.Equals(c));
    checkEq("Original unchanged", m.Size(), 2);

    m.Clear();
    checkEq("Clear Size",    m.Size(),    0);
    check("Clear IsEmpty",   m.IsEmpty());
    checkEq("Clear MinKey",  m.MinKey(),  nil);

    m.Set("x", 99);
    checkEq("Re-use after clear", m.Get("x"), 99);
}

// ============================================================
// 12. PutIfAbsent / Replace
// ============================================================
fn test_put_replace() {
    Console.WriteLine("== PutIfAbsent/Replace ==");
    let m = new TreeMap();

    check("PutIfAbsent first", m.PutIfAbsent("a", 1));
    checkEq("PutIfAbsent value", m.Get("a"), 1);
    check("PutIfAbsent second false", !m.PutIfAbsent("a", 99));
    checkEq("PutIfAbsent unchanged", m.Get("a"), 1);

    check("Replace existing", m.Replace("a", 7));
    checkEq("Replace value", m.Get("a"), 7);
    check("Replace missing false", !m.Replace("z", 1));
}

// ============================================================
// 13. ReverseEntries / CountWhere / Find / ToString
// ============================================================
fn test_utility_methods() {
    Console.WriteLine("== Utility methods ==");
    let m = new TreeMap();
    m.Set("a", 1); m.Set("b", 2); m.Set("c", 3); m.Set("d", 4);

    let rev = m.ReverseEntries();
    checkEq("ReverseEntries[0]", rev[0].Key, "d");
    checkEq("ReverseEntries[3]", rev[3].Key, "a");

    let cnt = m.CountWhere(fn(k, v) {
        return v % 2 == 0;
    });
    checkEq("CountWhere even", cnt, 2);

    let found = m.Find(fn(k, v) {
        return v == 3;
    });
    checkEq("Find key", found.Key, "c");
    checkEq("Find value", found.Value, 3);

    let notFound = m.Find(fn(k, v) {
        return v == 99;
    });
    checkEq("Find missing", notFound, nil);

    let s = m.ToString();
    check("ToString has a", String.Contains(s, "a"));
    check("ToString has 4", String.Contains(s, "4"));
}

// ============================================================
// 14. KeySet
// ============================================================
fn test_keyset() {
    Console.WriteLine("== KeySet ==");
    let m = new TreeMap();
    m.Set("c", 3); m.Set("a", 1); m.Set("b", 2);

    let ks = m.KeySet();
    checkEq("KeySet len",    len(ks), 3);
    checkEq("KeySet[0]",     ks[0],   "a");
    checkEq("KeySet[1]",     ks[1],   "b");
    checkEq("KeySet[2]",     ks[2],   "c");

    // KeySet returns a copy - mutating it must not affect the map
    Array.Append(ks, "z");
    checkEq("KeySet copy independent", m.Size(), 3);

    let empty = new TreeMap();
    checkEq("KeySet empty len", len(empty.KeySet()), 0);
}

// ============================================================
// 15. Merge
// ============================================================
fn test_merge() {
    Console.WriteLine("== Merge ==");
    let base = new TreeMap();
    base.Set("a", 1); base.Set("b", 2);

    let other = new TreeMap();
    other.Set("c", 3); other.Set("d", 4);

    let result = base.Merge(other);
    checkEq("Merge returns self",   result.Size(), 4);
    checkEq("Merge has a",         base.Get("a"),  1);
    checkEq("Merge has b",         base.Get("b"),  2);
    checkEq("Merge has c",         base.Get("c"),  3);
    checkEq("Merge has d",         base.Get("d"),  4);

    // Merge with overlapping keys - other's value wins
    let m1 = new TreeMap();
    m1.Set("x", 10); m1.Set("y", 20);

    let m2 = new TreeMap();
    m2.Set("x", 99); m2.Set("z", 30);

    m1.Merge(m2);
    checkEq("Merge overwrite x",  m1.Get("x"), 99);
    checkEq("Merge keeps y",      m1.Get("y"), 20);
    checkEq("Merge adds z",       m1.Get("z"), 30);

    // Merge with empty source - base unchanged
    let m3 = new TreeMap();
    m3.Set("a", 1);
    m3.Merge(new TreeMap());
    checkEq("Merge empty source", m3.Size(), 1);

    // Merge into empty base
    let m4 = new TreeMap();
    let m5 = new TreeMap();
    m5.Set("p", 7); m5.Set("q", 8);
    m4.Merge(m5);
    checkEq("Merge into empty size", m4.Size(), 2);
    checkEq("Merge into empty p",    m4.Get("p"), 7);
}

// ============================================================
// 16. CountRange
// ============================================================
fn test_count_range() {
    Console.WriteLine("== CountRange ==");
    let m = new TreeMap();
    m.Set("a", 1); m.Set("b", 2); m.Set("c", 3); m.Set("d", 4); m.Set("e", 5);

    checkEq("CountRange full",          m.CountRange("a", "e"), 5);
    checkEq("CountRange middle",        m.CountRange("b", "d"), 3);
    checkEq("CountRange single",        m.CountRange("c", "c"), 1);
    checkEq("CountRange none below",    m.CountRange("f", "z"), 0);
    checkEq("CountRange none above",    m.CountRange("0", "0"), 0);
    checkEq("CountRange one endpoint",  m.CountRange("a", "a"), 1);

    // int keys
    let mi = new TreeMap();
    mi.Set(1, "a"); mi.Set(3, "c"); mi.Set(5, "e"); mi.Set(7, "g"); mi.Set(9, "i");
    checkEq("CountRange int all",    mi.CountRange(1, 9), 5);
    checkEq("CountRange int middle", mi.CountRange(3, 7), 3);
    checkEq("CountRange int gap",    mi.CountRange(2, 4), 1);
    checkEq("CountRange int none",   mi.CountRange(10, 20), 0);
}

// ============================================================
// 17. FromEntries
// ============================================================
fn test_from_entries() {
    Console.WriteLine("== FromEntries ==");

    let m = TreeMap.FromEntries([["a", 1], ["b", 2], ["c", 3]]);
    checkEq("FromEntries size",    m.Size(),    3);
    checkEq("FromEntries get a",   m.Get("a"),  1);
    checkEq("FromEntries get b",   m.Get("b"),  2);
    checkEq("FromEntries get c",   m.Get("c"),  3);
    checkEq("FromEntries MinKey",  m.MinKey(),  "a");
    checkEq("FromEntries MaxKey",  m.MaxKey(),  "c");

    // Insertion order should not matter - keys end up sorted
    let m2 = TreeMap.FromEntries([["d", 4], ["b", 2], ["a", 1], ["c", 3]]);
    let ks = m2.Keys();
    checkEq("FromEntries sorted[0]", ks[0], "a");
    checkEq("FromEntries sorted[3]", ks[3], "d");

    // Empty entries array produces an empty map
    let empty = TreeMap.FromEntries([]);
    check("FromEntries empty IsEmpty", empty.IsEmpty());
    checkEq("FromEntries empty Size",  empty.Size(), 0);

    // Integer keys
    let mi = TreeMap.FromEntries([[3, "c"], [1, "a"], [2, "b"]]);
    checkEq("FromEntries int MinKey", mi.MinKey(), 1);
    checkEq("FromEntries int MaxKey", mi.MaxKey(), 3);
    checkEq("FromEntries int get 2",  mi.Get(2),   "b");
}

// ============================================================
// 18a. ForEach / EachKey / EachValue - object-accumulator pattern
// ============================================================
fn test_foreach_obj_pattern() {
    Console.WriteLine("== ForEach/EachKey/EachValue object-accumulator ==");
    let m = new TreeMap();
    m.Set("c", 30); m.Set("a", 10); m.Set("b", 20);

    // ForEach: count visits and accumulate keys + values
    let acc = {n: 0, keys: "", sum: 0};
    m.ForEach(fn(k, v) {
        acc.n   += 1;
        acc.keys = acc.keys + k;
        acc.sum  += v;
    });
    checkEq("ForEach obj n",    acc.n,    3);
    checkEq("ForEach obj keys", acc.keys, "abc");
    checkEq("ForEach obj sum",  acc.sum,  60);

    // ForEach returns self (chainable)
    let ret = {v: nil};
    ret.v = m.ForEach(fn(k, v) {});
    check("ForEach returns self", ret.v == m);

    // EachKey object accumulator
    let ek = {s: "", n: 0};
    m.EachKey(fn(k) {
        ek.s = ek.s + k;
        ek.n += 1;
    });
    checkEq("EachKey obj s",  ek.s, "abc");
    checkEq("EachKey obj n",  ek.n, 3);

    // EachKey returns self
    let ekret = {v: nil};
    ekret.v = m.EachKey(fn(k) {});
    check("EachKey returns self", ekret.v == m);

    // EachValue object accumulator
    let ev = {sum: 0, n: 0};
    m.EachValue(fn(v) {
        ev.sum += v;
        ev.n   += 1;
    });
    checkEq("EachValue obj sum", ev.sum, 60);
    checkEq("EachValue obj n",   ev.n,   3);

    // EachValue returns self
    let evret = {v: nil};
    evret.v = m.EachValue(fn(v) {});
    check("EachValue returns self", evret.v == m);

    // Single-element map
    let m1 = new TreeMap();
    m1.Set("x", 7);
    let one = {n: 0, k: "", v: 0};
    m1.ForEach(fn(k, v) { one.n += 1; one.k = k; one.v = v; });
    checkEq("ForEach single n", one.n, 1);
    checkEq("ForEach single k", one.k, "x");
    checkEq("ForEach single v", one.v, 7);

    // Empty map - callback never called
    let empty = new TreeMap();
    let emp = {n: 0};
    empty.ForEach(fn(k, v) { emp.n += 1; });
    checkEq("ForEach empty n", emp.n, 0);
    empty.EachKey(fn(k)    { emp.n += 1; });
    checkEq("EachKey empty n", emp.n, 0);
    empty.EachValue(fn(v)  { emp.n += 1; });
    checkEq("EachValue empty n", emp.n, 0);
}

// ============================================================
// 18b. LowerKey / HigherKey - extended edge cases
// ============================================================
fn test_lower_higher_key() {
    Console.WriteLine("== LowerKey/HigherKey extended ==");
    let m = new TreeMap();
    m.Set("a", 1); m.Set("b", 2); m.Set("c", 3); m.Set("d", 4);

    // LowerKey = strict predecessor (same as PrevKey)
    checkEq("LowerKey a (no prev)",  m.LowerKey("a"),  nil);
    checkEq("LowerKey b",            m.LowerKey("b"),  "a");
    checkEq("LowerKey d",            m.LowerKey("d"),  "c");
    checkEq("LowerKey aa (between)", m.LowerKey("aa"), "a");
    checkEq("LowerKey z (beyond)",   m.LowerKey("z"),  "d");
    checkEq("LowerKey 0 (before)",   m.LowerKey("0"),  nil);

    // HigherKey = strict successor (same as NextKey)
    checkEq("HigherKey d (no next)", m.HigherKey("d"),  nil);
    checkEq("HigherKey a",           m.HigherKey("a"),  "b");
    checkEq("HigherKey c",           m.HigherKey("c"),  "d");
    checkEq("HigherKey aa (between)",m.HigherKey("aa"), "b");
    checkEq("HigherKey 0 (before)",  m.HigherKey("0"),  "a");
    checkEq("HigherKey z (beyond)",  m.HigherKey("z"),  nil);

    // Int keys
    let mi = new TreeMap();
    mi.Set(10, "x"); mi.Set(20, "y"); mi.Set(30, "z");
    checkEq("LowerKey int 10",  mi.LowerKey(10),  nil);
    checkEq("LowerKey int 20",  mi.LowerKey(20),  10);
    checkEq("LowerKey int 25",  mi.LowerKey(25),  20);
    checkEq("HigherKey int 30", mi.HigherKey(30), nil);
    checkEq("HigherKey int 20", mi.HigherKey(20), 30);
    checkEq("HigherKey int 15", mi.HigherKey(15), 20);
}

// ============================================================
// 18c. Clone - deep independence
// ============================================================
fn test_clone_independence() {
    Console.WriteLine("== Clone independence ==");
    let m = new TreeMap();
    m.Set("a", 1); m.Set("b", 2); m.Set("c", 3);

    let c = m.Clone();

    // Deleting from clone does not affect original
    c.Delete("b");
    checkEq("Clone delete: original still has b", m.Get("b"), 2);
    checkEq("Clone delete: clone size",           c.Size(),   2);

    // Updating value in clone does not affect original
    c.Set("a", 999);
    checkEq("Clone update: original a unchanged", m.Get("a"),   1);
    checkEq("Clone update: clone a updated",      c.Get("a"), 999);

    // Adding to clone does not affect original
    c.Set("z", 26);
    check("Clone add: original no z",    !m.Has("z"));
    checkEq("Clone add: clone has z",     c.Get("z"), 26);

    // Clone of empty
    let empty = new TreeMap();
    let cempty = empty.Clone();
    check("Clone empty IsEmpty", cempty.IsEmpty());
    cempty.Set("x", 1);
    check("Clone empty original still empty", empty.IsEmpty());

    // Clone preserves sorted order
    let m2 = new TreeMap();
    m2.Set("d", 4); m2.Set("b", 2); m2.Set("a", 1); m2.Set("c", 3);
    let c2 = m2.Clone();
    let ks = c2.Keys();
    checkEq("Clone sorted[0]", ks[0], "a");
    checkEq("Clone sorted[1]", ks[1], "b");
    checkEq("Clone sorted[2]", ks[2], "c");
    checkEq("Clone sorted[3]", ks[3], "d");
}

// ============================================================
// 18d. Equals - edge cases
// ============================================================
fn test_equals_edge_cases() {
    Console.WriteLine("== Equals edge cases ==");

    // Empty maps are equal
    let e1 = new TreeMap();
    let e2 = new TreeMap();
    check("Equals both empty", e1.Equals(e2));

    // Empty vs non-empty
    e1.Set("a", 1);
    check("Equals empty vs non-empty false", !e1.Equals(e2));

    // Same keys different values
    let m1 = new TreeMap();
    let m2 = new TreeMap();
    m1.Set("a", 1); m1.Set("b", 2);
    m2.Set("a", 1); m2.Set("b", 99);
    check("Equals same keys diff values false", !m1.Equals(m2));

    // Same keys same values
    m2.Set("b", 2);
    check("Equals same keys same values true", m1.Equals(m2));

    // Superset is not equal
    m2.Set("c", 3);
    check("Equals superset false", !m1.Equals(m2));

    // Reflexive
    let m3 = new TreeMap();
    m3.Set("x", 10); m3.Set("y", 20);
    check("Equals reflexive", m3.Equals(m3));

    // nil argument
    check("Equals nil false", !m3.Equals(nil));

    // Int-keyed maps
    let mi1 = new TreeMap();
    let mi2 = new TreeMap();
    mi1.Set(1, "a"); mi1.Set(2, "b");
    mi2.Set(1, "a"); mi2.Set(2, "b");
    check("Equals int keys equal", mi1.Equals(mi2));
    mi2.Set(2, "X");
    check("Equals int keys diff values false", !mi1.Equals(mi2));
}

// ============================================================
// 18e. GetOr - extended edge cases
// ============================================================
fn test_getor_edge_cases() {
    Console.WriteLine("== GetOr extended ==");
    let m = new TreeMap();
    m.Set("a", 0);   // value is falsy zero
    m.Set("b", false);
    m.Set("c", "");

    // GetOr must return the stored value even when falsy
    checkEq("GetOr zero stored",    m.GetOr("a", -1), 0);
    checkEq("GetOr false stored",   m.GetOr("b", -1), false);
    checkEq("GetOr empty str",      m.GetOr("c", "X"), "");

    // Missing keys return the default
    checkEq("GetOr missing int",    m.GetOr("z", 42),    42);
    checkEq("GetOr missing string", m.GetOr("z", "def"), "def");
    checkEq("GetOr missing nil",    m.GetOr("z", nil),   nil);

    // GetOr on empty map
    let empty = new TreeMap();
    checkEq("GetOr empty map", empty.GetOr("k", 99), 99);
}

// ============================================================
// 18f. PutIfAbsent / Replace - extended edge cases
// ============================================================
fn test_put_replace_extended() {
    Console.WriteLine("== PutIfAbsent/Replace extended ==");

    // PutIfAbsent: multiple keys, only new ones inserted
    let m = new TreeMap();
    m.Set("a", 1); m.Set("b", 2); m.Set("c", 3);

    check("PutIfAbsent new key d", m.PutIfAbsent("d", 4));
    checkEq("PutIfAbsent d size",  m.Size(), 4);
    checkEq("PutIfAbsent d value", m.Get("d"), 4);

    check("PutIfAbsent existing a false", !m.PutIfAbsent("a", 999));
    checkEq("PutIfAbsent a unchanged",     m.Get("a"), 1);

    // PutIfAbsent on empty map
    let empty = new TreeMap();
    check("PutIfAbsent on empty", empty.PutIfAbsent("x", 7));
    checkEq("PutIfAbsent on empty value", empty.Get("x"), 7);

    // Replace: updates value and returns true; missing returns false
    let m2 = new TreeMap();
    m2.Set("p", 10); m2.Set("q", 20);

    check("Replace existing p",    m2.Replace("p", 100));
    checkEq("Replace p new value", m2.Get("p"), 100);
    checkEq("Replace q unchanged", m2.Get("q"), 20);

    check("Replace missing false", !m2.Replace("z", 1));
    checkEq("Replace size unchanged", m2.Size(), 2);

    // Replace after Delete (key gone) returns false
    m2.Delete("q");
    check("Replace deleted key false", !m2.Replace("q", 5));
}

// ============================================================
// 18g. PopMin / PopMax - extended edge cases
// ============================================================
fn test_pop_extended() {
    Console.WriteLine("== PopMin/PopMax extended ==");

    // Pop from single-element map empties it
    let m1 = new TreeMap();
    m1.Set("only", 42);
    let p = m1.PopMin();
    checkEq("PopMin single Key",   p.Key,   "only");
    checkEq("PopMin single Value", p.Value, 42);
    check("PopMin single IsEmpty", m1.IsEmpty());

    let m2 = new TreeMap();
    m2.Set("only", 42);
    let p2 = m2.PopMax();
    checkEq("PopMax single Key",   p2.Key,   "only");
    checkEq("PopMax single Value", p2.Value, 42);
    check("PopMax single IsEmpty", m2.IsEmpty());

    // Successive pops remove in min/max order
    let m3 = new TreeMap();
    m3.Set("b", 2); m3.Set("a", 1); m3.Set("c", 3); m3.Set("d", 4);

    let r1 = m3.PopMin();
    checkEq("PopMin seq 1 key", r1.Key, "a");
    checkEq("PopMin seq size",  m3.Size(), 3);

    let r2 = m3.PopMax();
    checkEq("PopMax seq 1 key", r2.Key, "d");
    checkEq("PopMax seq size",  m3.Size(), 2);

    let r3 = m3.PopMin();
    checkEq("PopMin seq 2 key", r3.Key, "b");

    let r4 = m3.PopMax();
    checkEq("PopMax seq 2 key", r4.Key, "c");
    check("Pop all IsEmpty", m3.IsEmpty());

    // Pop on empty returns nil
    checkEq("PopMin on empty2", m3.PopMin(), nil);
    checkEq("PopMax on empty2", m3.PopMax(), nil);

    // Int keys
    let mi = new TreeMap();
    mi.Set(5, "e"); mi.Set(1, "a"); mi.Set(3, "c");
    let pi = mi.PopMin();
    checkEq("PopMin int Key",  pi.Key,   1);
    checkEq("PopMin int size", mi.Size(), 2);
    checkEq("PopMin int new min", mi.MinKey(), 3);
}

// ============================================================
// 18h. Merge - extended edge cases
// ============================================================
fn test_merge_extended() {
    Console.WriteLine("== Merge extended ==");

    // Merge self into self (should work - all keys already present, values overwritten with same)
    let m = new TreeMap();
    m.Set("a", 1); m.Set("b", 2);
    m.Merge(m);
    checkEq("Merge self size",  m.Size(), 2);
    checkEq("Merge self a",     m.Get("a"), 1);
    checkEq("Merge self b",     m.Get("b"), 2);

    // Merge preserves sort order
    let m1 = new TreeMap();
    m1.Set("c", 3); m1.Set("a", 1);
    let m2 = new TreeMap();
    m2.Set("d", 4); m2.Set("b", 2);
    m1.Merge(m2);
    let ks = m1.Keys();
    checkEq("Merge sorted[0]", ks[0], "a");
    checkEq("Merge sorted[1]", ks[1], "b");
    checkEq("Merge sorted[2]", ks[2], "c");
    checkEq("Merge sorted[3]", ks[3], "d");

    // Merge returns self for chaining
    let base = new TreeMap();
    base.Set("x", 1);
    let other = new TreeMap();
    other.Set("y", 2);
    let ret = base.Merge(other);
    check("Merge returns self", ret == base);
}

// ============================================================
// 18i. CountRange - edge cases
// ============================================================
fn test_count_range_extended() {
    Console.WriteLine("== CountRange extended ==");
    let m = new TreeMap();
    m.Set("b", 2); m.Set("d", 4); m.Set("f", 6);

    // Keys between existing ones (gaps)
    checkEq("CountRange gap low",    m.CountRange("a", "c"), 1);
    checkEq("CountRange gap mid",    m.CountRange("c", "e"), 1);
    checkEq("CountRange gap high",   m.CountRange("e", "g"), 1);
    checkEq("CountRange spans all",  m.CountRange("a", "z"), 3);
    checkEq("CountRange empty map",  new TreeMap().CountRange("a", "z"), 0);

    // Single key range where key absent
    checkEq("CountRange absent key", m.CountRange("a", "a"), 0);
    checkEq("CountRange present key single", m.CountRange("b", "b"), 1);
}

// ============================================================
// 18j. FromEntries - extended edge cases
// ============================================================
fn test_from_entries_extended() {
    Console.WriteLine("== FromEntries extended ==");

    // Duplicate keys - last write wins (same as Set)
    let m = TreeMap.FromEntries([["a", 1], ["a", 99], ["b", 2]]);
    checkEq("FromEntries dup key size",  m.Size(), 2);
    checkEq("FromEntries dup key value", m.Get("a"), 99);


    // Large input - sorted correctly
    let entries = [];
    let i = 9;
    while (i >= 0) {
        Array.Append(entries, [i, i * 10]);
        i -= 1;
    }
    let big = TreeMap.FromEntries(entries);
    checkEq("FromEntries large size",   big.Size(), 10);
    checkEq("FromEntries large MinKey", big.MinKey(), 0);
    checkEq("FromEntries large MaxKey", big.MaxKey(), 9);
    checkEq("FromEntries large get 5",  big.Get(5), 50);
}

// ============================================================
// 18k. ReverseEntries / CountWhere / Find - extended
// ============================================================
fn test_utility_extended() {
    Console.WriteLine("== Utility extended ==");

    // ReverseEntries on empty
    let empty = new TreeMap();
    checkEq("ReverseEntries empty len", len(empty.ReverseEntries()), 0);

    // ReverseEntries on single
    let m1 = new TreeMap();
    m1.Set("z", 99);
    let rev1 = m1.ReverseEntries();
    checkEq("ReverseEntries single len",   len(rev1),       1);
    checkEq("ReverseEntries single Key",   rev1[0].Key,     "z");
    checkEq("ReverseEntries single Value", rev1[0].Value,   99);

    // ReverseEntries values match in reversed order
    let m = new TreeMap();
    m.Set("a", 10); m.Set("b", 20); m.Set("c", 30); m.Set("d", 40);
    let rev = m.ReverseEntries();
    checkEq("ReverseEntries[0] Key",   rev[0].Key,   "d");
    checkEq("ReverseEntries[0] Value", rev[0].Value, 40);
    checkEq("ReverseEntries[1] Key",   rev[1].Key,   "c");
    checkEq("ReverseEntries[3] Key",   rev[3].Key,   "a");

    // CountWhere: all match
    checkEq("CountWhere all", m.CountWhere(fn(k, v) { return true; }), 4);

    // CountWhere: none match
    checkEq("CountWhere none", m.CountWhere(fn(k, v) { return false; }), 0);

    // CountWhere: key-based predicate
    let cnt = m.CountWhere(fn(k, v) { return k > "b"; });
    checkEq("CountWhere key > b", cnt, 2);

    // Find: first match in key order
    let found = m.Find(fn(k, v) { return v >= 20; });
    checkEq("Find first >= 20 Key", found.Key, "b");

    // Find: no match
    checkEq("Find no match", m.Find(fn(k, v) { return v > 1000; }), nil);

    // Find on empty
    checkEq("Find empty", empty.Find(fn(k, v) { return true; }), nil);

    // CountWhere on empty
    checkEq("CountWhere empty", empty.CountWhere(fn(k, v) { return true; }), 0);
}

// ============================================================
// 18l. Select / Rank - extended
// ============================================================
fn test_rank_select_extended() {
    Console.WriteLine("== Rank/Select extended ==");
    let m = new TreeMap();
    m.Set("e", 5); m.Set("a", 1); m.Set("c", 3); m.Set("b", 2); m.Set("d", 4);

    // Rank covers all positions
    checkEq("Rank a=0", m.Rank("a"), 0);
    checkEq("Rank b=1", m.Rank("b"), 1);
    checkEq("Rank c=2", m.Rank("c"), 2);
    checkEq("Rank d=3", m.Rank("d"), 3);
    checkEq("Rank e=4", m.Rank("e"), 4);

    // Rank of absent key
    checkEq("Rank absent",  m.Rank("z"), -1);
    checkEq("Rank absent2", m.Rank("0"), -1);

    // Select covers all positions
    checkEq("Select 0", m.Select(0), "a");
    checkEq("Select 4", m.Select(4), "e");

    // Select OOB
    checkEq("Select -1",  m.Select(-1), nil);
    checkEq("Select 5",   m.Select(5),  nil);
    checkEq("Select 100", m.Select(100),nil);

    // SelectEntry OOB
    checkEq("SelectEntry -1",  m.SelectEntry(-1),  nil);
    checkEq("SelectEntry 100", m.SelectEntry(100), nil);

    // Rank/Select consistent after delete
    m.Delete("c");
    checkEq("Rank after delete b", m.Rank("b"), 1);
    checkEq("Rank after delete d", m.Rank("d"), 2);
    checkEq("Select after delete 2", m.Select(2), "d");

    // Single-element map
    let m1 = new TreeMap();
    m1.Set("x", 0);
    checkEq("Rank single 0", m1.Rank("x"), 0);
    checkEq("Select single 0", m1.Select(0), "x");
    checkEq("Rank single absent", m1.Rank("z"), -1);
    checkEq("Select single OOB",  m1.Select(1), nil);
}

// ============================================================
// 18m. HeadEntries / TailEntries - extended
// ============================================================
fn test_head_tail_extended() {
    Console.WriteLine("== HeadEntries/TailEntries extended ==");
    let m = new TreeMap();
    m.Set("a", 1); m.Set("b", 2); m.Set("c", 3); m.Set("d", 4); m.Set("e", 5);

    // HeadEntries up to first key (inclusive/exclusive)
    let h0i = m.HeadEntries("a", true);
    checkEq("HeadEntries first incl len", len(h0i), 1);
    checkEq("HeadEntries first incl key", h0i[0].Key, "a");

    let h0e = m.HeadEntries("a", false);
    checkEq("HeadEntries first excl len", len(h0e), 0);

    // HeadEntries beyond last key - all entries
    let hall = m.HeadEntries("z", true);
    checkEq("HeadEntries beyond all len", len(hall), 5);

    // HeadEntries key before all - empty
    let hnone = m.HeadEntries("0", true);
    checkEq("HeadEntries before all len", len(hnone), 0);

    // TailEntries from last key
    let tlast_i = m.TailEntries("e", true);
    checkEq("TailEntries last incl len", len(tlast_i), 1);
    checkEq("TailEntries last incl key", tlast_i[0].Key, "e");

    let tlast_e = m.TailEntries("e", false);
    checkEq("TailEntries last excl len", len(tlast_e), 0);

    // TailEntries before all - all entries
    let tall = m.TailEntries("0", true);
    checkEq("TailEntries before all len", len(tall), 5);

    // TailEntries after all - empty
    let tnone = m.TailEntries("z", true);
    checkEq("TailEntries after all len", len(tnone), 0);

    // HeadEntries / TailEntries on empty map
    let empty = new TreeMap();
    checkEq("HeadEntries empty len", len(empty.HeadEntries("a", true)), 0);
    checkEq("TailEntries empty len", len(empty.TailEntries("a", true)), 0);
}

// ============================================================
// 19. Type enforcement
// ============================================================
fn test_type_enforcement() {
    Console.WriteLine("== Type enforcement ==");
    let m = new TreeMap();
    m.Set("a", 1);

    let threw = false;
    try {
        m.Set(1, "mixed");
    } catch (e) {
        threw = true;
    }
    check("Mixed key types throws", threw);

    let threw2 = false;
    try {
        m.Set({}, "bad");
    } catch (e) {
        threw2 = true;
    }
    check("Invalid key type throws", threw2);
}


// ============================================================
// 20. Benchmark
// ============================================================
fn _bench_fill(map:instance, n:int) {
    let i = 0;
    while (i < n) {
        map.Set(i, i * 2);
        i += 1;
    }
}

fn _bench_reads(map:instance, n:int) {
    let sum = 0;
    let i = 0;
    while (i < n) {
        sum += map.Get(i);
        i += 1;
    }
    return sum;
}

fn _bench_rank_select(map:instance, n:int) {
    let sum = 0;
    let i = 0;
    while (i < n) {
        sum += map.Rank(i);
        let k = map.Select(i);
        if (k != nil) { sum += k; }
        i += 1;
    }
    return sum;
}

fn _bench_range(map:instance, n:int, window:int) {
    let sum = 0;
    let i = 0;
    while (i < n) {
        let r = map.Range(i, i + window, true, false);
        sum += len(r);
        i += window;
    }
    return sum;
}

fn test_benchmark() {
    Console.WriteLine("== Benchmark ==");

    let n = 4000;

    let t0 = Time.Millis();
    let m = new TreeMap();
    _bench_fill(m, n);
    let t1 = Time.Millis();

    let readSum = _bench_reads(m, n);
    let t2 = Time.Millis();

    let rsSum = _bench_rank_select(m, n);
    let t3 = Time.Millis();

    let rangeSum = _bench_range(m, n, 50);
    let t4 = Time.Millis();

    // Sanity checks so benchmark still validates behavior
    checkEq("Benchmark size", m.Size(), n);
    checkEq("Benchmark min", m.MinKey(), 0);
    checkEq("Benchmark max", m.MaxKey(), n - 1);
    check("Benchmark read sum positive", readSum > 0);
    check("Benchmark rank/select sum positive", rsSum > 0);
    check("Benchmark range sum positive", rangeSum > 0);

    Console.WriteLine("Benchmark N=" + str(n));
    Console.WriteLine("  Fill         : " + str(t1 - t0) + " ms");
    Console.WriteLine("  Read         : " + str(t2 - t1) + " ms");
    Console.WriteLine("  Rank+Select  : " + str(t3 - t2) + " ms");
    Console.WriteLine("  Range scans  : " + str(t4 - t3) + " ms");
}

