// Test suite for Tiff.fls
//
// Round-trips through every encoder option, decoding of fixtures written by
// libtiff's own tools (tests/tiff, regenerated by tests/tiff/make_fixtures.sh)
// across codecs, layouts, byte orders, bit depths and photometric
// interpretations, multi-page files, and rejection of malformed input.
// Pixels are 32-bit 0xAARRGGBB elements, so a w*h image is a block of w*h
// elements of size 4.
//
// Run from the repository root: flarisvm ./tests/test_tiff.fls

import { Tiff } from library("Tiff", "1.0");

const FIX = "./tests/tiff/";

global testsRun    = 0;
global testsFailed = 0;

fn check(cond, msg) {
    testsRun = testsRun + 1;
    if (!cond) { testsFailed = testsFailed + 1; Console.WriteLine("FAIL: " + msg); }
}

fn checkEq(actual, expected, msg) {
    testsRun = testsRun + 1;
    if (actual != expected) {
        testsFailed = testsFailed + 1;
        Console.WriteLine("FAIL: " + msg + "  expected=" + str(expected) + " got=" + str(actual));
    }
}

fn hex(v:int):string { return "0x" + Convert.ToRadixString(v, 16); }

// ------------------------------------------------------------------
// Images for round-trips
// ------------------------------------------------------------------

fn mkImage(w: int, h: int, mode: int): block {
    let px = Buffer.Create(w * h, 4);
    iter (i from 0 to w * h) {
        let x = i % w;
        let y = i / w;
        let v = 0;
        // Shifts and bitwise operators share one precedence level: parenthesize.
        if (mode == 0)      { v = 0xFF000000 | ((x & 255) << 16) | ((y & 255) << 8) | 120; }   // gradient
        else if (mode == 1) { v = 0xFF808080; }                                              // flat
        else if (mode == 2) { v = 0xFF000000 | ((x * 2654435761 + y * 40503) & 0xFFFFFF); }  // noisy
        else {                                                                               // alpha
            v = ((((x + y * 3) * 5) & 255) << 24) | (((x * 7) & 255) << 16) | (((y * 11) & 255) << 8) | 77;
        }
        px[i] = v;
    }
    return px;
}

fn samePixels(a: block, b: block, n: int): bool {
    if (a == nil || b == nil) return false;
    if (len(a) < n || len(b) < n) return false;
    iter (i from 0 to n) { if (a[i] != b[i]) return false; }
    return true;
}

global MODES = nil;

fn modes() {
    if (MODES == nil) {
        MODES = [["default (LZW)", nil],
                 ["none",          { compression: Tiff.COMPRESSION_NONE }],
                 ["LZW no pred",   { compression: Tiff.COMPRESSION_LZW, predictor: false }],
                 ["Deflate",       { compression: Tiff.COMPRESSION_DEFLATE }],
                 ["Deflate no pred", { compression: Tiff.COMPRESSION_DEFLATE, predictor: false }],
                 ["PackBits",      { compression: Tiff.COMPRESSION_PACKBITS }]];
    }
    return MODES;
}

fn roundtrip(name: string, w: int, h: int, mode: int) {
    let px = mkImage(w, h, mode);
    let ms = modes();
    iter (k from 0 to len(ms)) {
        let label = name + " / " + ms[k][0];
        let bytes = Tiff.Encode(px, w, h, ms[k][1]);
        check(bytes != nil, label + " encodes");
        if (bytes == nil) continue;
        check(Tiff.IsTiff(bytes), label + " has a TIFF header");
        let img = Tiff.Decode(bytes);
        check(img != nil, label + " decodes");
        if (img == nil) continue;
        checkEq(img.Width,  w, label + " width");
        checkEq(img.Height, h, label + " height");
        check(samePixels(img.Pixels, px, w * h), label + " pixels survive the round-trip");
    }
    return 0;
}

fn test_roundtrips() {
    roundtrip("gradient 64x64", 64, 64, 0);
    roundtrip("flat 32x16",     32, 16, 1);
    roundtrip("noisy 40x40",    40, 40, 2);
    roundtrip("alpha 37x23",    37, 23, 3);
    roundtrip("1x1",             1,  1, 0);
    roundtrip("1xN column",      1, 97, 0);
    roundtrip("Nx1 row",        97,  1, 3);
    // Several 64 KiB strips, and LZW streams long enough to reset the table.
    roundtrip("noisy 300x200", 300, 200, 2);
    // One row is wider than a strip's 64 KiB budget: a strip per row.
    roundtrip("wide 6000x3", 6000, 3, 2);
    return 0;
}

// ------------------------------------------------------------------
// What the encoder writes
// ------------------------------------------------------------------

fn test_encoder_choices() {
    let opaque = mkImage(20, 10, 0);
    let alpha  = mkImage(20, 10, 3);

    let i1 = Tiff.Info(Tiff.Encode(opaque, 20, 10));
    check(i1 != nil, "Info on an encoded image");
    if (i1 != nil) {
        checkEq(i1.SamplesPerPixel, 3, "opaque image is written as RGB");
        checkEq(i1.BitsPerSample, 8, "8 bits per sample");
        checkEq(i1.Photometric, 2, "photometric RGB");
        checkEq(i1.Compression, Tiff.COMPRESSION_LZW, "LZW by default");
        checkEq(i1.Predictor, 2, "predictor on by default for LZW");
        checkEq(i1.Pages, 1, "one page");
        check(!i1.Tiled && !i1.Planar && !i1.BigTiff && !i1.BigEndian, "strips, chunky, classic, little-endian");
        check(i1.Supported, "Supported");
    }

    let i2 = Tiff.Info(Tiff.Encode(alpha, 20, 10));
    check(i2 != nil && i2.SamplesPerPixel == 4, "image with alpha is written as RGBA");

    let i3 = Tiff.Info(Tiff.Encode(opaque, 20, 10, { compression: Tiff.COMPRESSION_DEFLATE, predictor: false }));
    check(i3 != nil && i3.Compression == 8 && i3.Predictor == 1, "Deflate without predictor");
    let i4 = Tiff.Info(Tiff.Encode(opaque, 20, 10, { compression: Tiff.COMPRESSION_PACKBITS, predictor: true }));
    check(i4 != nil && i4.Compression == 32773 && i4.Predictor == 1, "predictor ignored for PackBits");

    // Predictor exists to shrink smooth images; it must pay on a gradient.
    let g = mkImage(128, 128, 0);
    let withPred = Tiff.Encode(g, 128, 128);
    let noPred   = Tiff.Encode(g, 128, 128, { predictor: false });
    let raw      = Tiff.Encode(g, 128, 128, { compression: Tiff.COMPRESSION_NONE });
    check(len(withPred) < len(noPred), "predictor makes LZW smaller on a gradient");
    check(len(noPred) < len(raw), "LZW is smaller than uncompressed on a gradient");
    check(len(raw) >= 128 * 128 * 3, "uncompressed holds every byte");
    return 0;
}

// ------------------------------------------------------------------
// libtiff fixtures
// ------------------------------------------------------------------

// The formulas tests/tiff/mkraw.fls generated the fixture samples from.
fn R(x:int, _y:int):int { return (x * 7) & 255; }
fn G(_x:int, y:int):int { return (y * 11) & 255; }
fn B(x:int, y:int):int { return (x * y + 13) & 255; }
fn A(x:int, y:int):int { return ((x + y * 3) * 5) & 255; }
fn Gray(x:int, y:int):int { return (x * 5 + y * 3) & 255; }
fn grayPx(g:int):int { return 0xFF000000 | (g << 16) | (g << 8) | g; }
fn palPx(i:int, n:int):int {
    return 0xFF000000 | ((i * 255 / (n - 1)) << 16) | (((n - 1 - i) * 255 / (n - 1)) << 8) | (((i * 5) % n) * 255 / (n - 1));
}
// What un-premultiplying the rounded, premultiplied channel gives back.
fn unpremul(c:int, a:int):int {
    if (a == 0) return 0;
    let p = (c * a + 127) / 255;
    let v = (p * 255 + (a >> 1)) / a;
    return v > 255 ? 255 : v;
}

fn expected(kind:string, x:int, y:int):int {
    if (kind == "rgb")   return 0xFF000000 | (R(x, y) << 16) | (G(x, y) << 8) | B(x, y);
    if (kind == "rgba")  return (A(x, y) << 24) | (R(x, y) << 16) | (G(x, y) << 8) | B(x, y);
    if (kind == "assoc") {
        let a = A(x, y);
        return (a << 24) | (unpremul(R(x, y), a) << 16) | (unpremul(G(x, y), a) << 8) | unpremul(B(x, y), a);
    }
    if (kind == "gray")  return grayPx(Gray(x, y));
    if (kind == "white") return grayPx(255 - Gray(x, y));
    if (kind == "gray4") return grayPx(((x + y) & 15) * 17);
    if (kind == "gray2") return grayPx(((x ^ y) & 3) * 85);
    if (kind == "pal4")  return palPx((x * 3 + y) & 15, 16);
    if (kind == "pal8")  return palPx((x * 3 + y * 5) & 255, 256);
    if (kind == "bits")  return ((((x / 3) + (y / 2)) & 1) == 1) ? 0xFF000000 : 0xFFFFFFFF;
    if (kind == "cmyk") {
        // libtiff's own CMYK -> RGB, truncating.
        let k = 255 - (((x + y) * 4) & 255);
        return 0xFF000000 | (((k * (255 - R(x, y))) / 255) << 16) |
               (((k * (255 - G(x, y))) / 255) << 8) | ((k * (255 - ((x * y) & 255))) / 255);
    }
    if (kind == "big") {
        return 0xFF000000 | (((x * y) & 255) << 16) | ((((x ^ y) * 3) & 255) << 8) | (((x * x + y * y) >> 3) & 255);
    }
    return -1;
}

fn checkFixture(name:string, img, kind:string, w:int, h:int) {
    check(img != nil, name + " decodes (" + str(Tiff.LastError()) + ")");
    if (img == nil) return 0;
    checkEq(img.Width, w, name + " width");
    checkEq(img.Height, h, name + " height");
    if (img.Width != w || img.Height != h) return 0;
    var bad = 0;
    var first = "";
    iter (y from 0 to h) {
        iter (x from 0 to w) {
            let got = img.Pixels[y * w + x];
            let want = expected(kind, x, y);
            if (got != want) {
                if (bad == 0) { first = " first at (" + str(x) + "," + str(y) + "): " + hex(got) + " want " + hex(want); }
                bad += 1;
            }
        }
    }
    check(bad == 0, name + " pixels match libtiff's input (" + str(bad) + " differ)" + first);
    return 0;
}

fn fixture(f:string, kind:string) {
    return checkFixture(f, Tiff.Load(FIX + f), kind, 37, 23);
}

fn test_libtiff_fixtures() {
    // Every codec, strips and tiles, chunky and planar, both byte orders,
    // classic and BigTIFF, both FillOrders.
    fixture("rgb8_none_strips.tif",       "rgb");
    fixture("rgb8_lzw.tif",               "rgb");
    fixture("rgb8_lzw_pred.tif",          "rgb");
    fixture("rgb8_zip_pred.tif",          "rgb");
    fixture("rgb8_packbits.tif",          "rgb");
    fixture("rgb8_tiled_lzw.tif",         "rgb");
    fixture("rgb8_tiled_planar_zip.tif",  "rgb");
    fixture("rgb8_planar_lzw_pred.tif",   "rgb");
    fixture("rgb8_be_zip.tif",            "rgb");
    fixture("rgb8_bigtiff_lzw.tif",       "rgb");
    fixture("rgb8_bigtiff_be_tiled.tif",  "rgb");
    fixture("rgb8_fill2_lzw_pred.tif",    "rgb");
    // 16-bit, predictor summed at 16 bits in each byte order; high byte kept.
    fixture("rgb16_le_zip_pred.tif",      "rgb");
    fixture("gray16_be_lzw_pred.tif",     "gray");
    // A fourth sample with no ExtraSamples tag is not alpha.
    fixture("rgba8_noextra_lzw_pred.tif", "rgb");
    fixture("rgba8_unassoc_lzw_pred.tif", "rgba");
    fixture("rgba8_assoc_lzw.tif",        "assoc");
    fixture("gray8_packbits.tif",         "gray");
    fixture("gray8_white_none.tif",       "white");
    fixture("gray4_lzw.tif",              "gray4");
    fixture("gray2_none.tif",             "gray2");
    fixture("bits1_packbits.tif",         "bits");
    fixture("pal8_lzw.tif",               "pal8");
    fixture("pal4_packbits.tif",          "pal4");
    // A ColorMap of 8-bit values (no entry above 255) is read as 8-bit.
    fixture("pal8_cmap8_none.tif",        "pal8");
    fixture("cmyk8_lzw.tif",              "cmyk");
    // Past 4094 codes: 12-bit codes and a table reset in libtiff's stream.
    checkFixture("big8_lzw.tif", Tiff.Load(FIX + "big8_lzw.tif"), "big", 64, 40);

    let info = Tiff.Info(File.ReadAllBytes(FIX + "rgb8_bigtiff_be_tiled.tif"));
    check(info != nil && info.BigTiff && info.BigEndian && info.Tiled, "Info sees BigTIFF, big-endian, tiled");
    let pinfo = Tiff.Info(File.ReadAllBytes(FIX + "rgb8_planar_lzw_pred.tif"));
    check(pinfo != nil && pinfo.Planar && pinfo.Predictor == 2, "Info sees planar + predictor");
    return 0;
}

fn test_unsupported() {
    let jpeg = File.ReadAllBytes(FIX + "rgb8_jpeg.tif");
    check(Tiff.Decode(jpeg) == nil, "JPEG-compressed TIFF -> nil");
    let err = Tiff.LastError();
    check(err != nil && String.Contains(err, "JPEG"), "LastError names JPEG: " + str(err));
    let info = Tiff.Info(jpeg);
    check(info != nil, "Info still reads a page Decode refuses");
    if (info != nil) {
        check(!info.Supported, "Info.Supported is false for JPEG");
        checkEq(info.Compression, 7, "Info.Compression is 7");
        checkEq(info.Width, 37, "Info.Width of the JPEG page");
    }
    check(Tiff.Decode(File.ReadAllBytes(FIX + "rgb8_lzw.tif")) != nil && Tiff.LastError() == nil,
          "LastError is nil after a successful decode");
    return 0;
}

// ------------------------------------------------------------------
// Multi-page
// ------------------------------------------------------------------

fn test_multipage() {
    let m = File.ReadAllBytes(FIX + "multi3.tif");
    checkEq(Tiff.PageCount(m), 3, "libtiff multi-page: 3 pages");
    checkFixture("multi3 page 0", Tiff.Decode(m), "rgb", 37, 23);
    checkFixture("multi3 page 1", Tiff.Decode(m, { page: 1 }), "gray", 37, 23);
    checkFixture("multi3 page 2", Tiff.Decode(m, { page: 2 }), "pal8", 37, 23);
    check(Tiff.Decode(m, { page: 3 }) == nil, "page past the end -> nil");
    check(Tiff.LastError() != nil && String.Contains(Tiff.LastError(), "3"), "LastError reports the page count");
    check(Tiff.Decode(m, { page: -1 }) == nil, "negative page -> nil");
    check(Tiff.Decode(m, { page: "1" }) == nil, "non-int page -> nil");

    let a = mkImage(30, 20, 0);
    let b = mkImage(17, 9, 3);
    let c = mkImage(300, 200, 2);
    let pages = [{ Width: 30, Height: 20, Pixels: a }, { Width: 17, Height: 9, Pixels: b },
                 { Width: 300, Height: 200, Pixels: c }];
    let ms = modes();
    iter (k from 0 to len(ms)) {
        let label = "EncodePages / " + ms[k][0];
        let bytes = Tiff.EncodePages(pages, ms[k][1]);
        check(bytes != nil, label + " encodes");
        if (bytes == nil) continue;
        checkEq(Tiff.PageCount(bytes), 3, label + " has 3 pages");
        let p0 = Tiff.Decode(bytes, { page: 0 });
        let p1 = Tiff.Decode(bytes, { page: 1 });
        let p2 = Tiff.Decode(bytes, { page: 2 });
        check(p0 != nil && p0.Width == 30 && samePixels(p0.Pixels, a, 30 * 20), label + " page 0");
        check(p1 != nil && p1.Width == 17 && samePixels(p1.Pixels, b, 17 * 9), label + " page 1 (alpha)");
        check(p2 != nil && p2.Height == 200 && samePixels(p2.Pixels, c, 300 * 200), label + " page 2");
    }
    // A decoded page is valid input for the encoder.
    let again = Tiff.EncodePages([Tiff.Decode(m, { page: 2 }), Tiff.Decode(m, { page: 0 })]);
    check(again != nil && Tiff.PageCount(again) == 2, "decoded pages re-encode");
    if (again != nil) { checkFixture("re-encoded palette page", Tiff.Decode(again), "pal8", 37, 23); }
    return 0;
}

// ------------------------------------------------------------------
// Malformed input
// ------------------------------------------------------------------

fn copyOf(b: block): block { return Buffer.Slice(b, 0, len(b)); }

// Byte offset of the value field of tag `tag` in the first IFD of a classic
// little-endian file, or -1.
fn tagValueAt(b: block, tag: int): int {
    let ifd = Buffer.ReadU32At(b, 4);
    let n = Buffer.ReadU16At(b, ifd);
    iter (i from 0 to n) {
        let e = ifd + 2 + i * 12;
        if (Buffer.ReadU16At(b, e) == tag) return e + 8;
    }
    return -1;
}

fn test_malformed() {
    check(Tiff.Decode(nil) == nil,                               "Decode(nil) -> nil");
    check(Tiff.Decode(Buffer.FromString("")) == nil,             "Decode(empty) -> nil");
    check(Tiff.Decode(Buffer.FromString("not a tiff at all")) == nil, "Decode(garbage) -> nil");
    check(Tiff.Decode("II*") == nil,                             "Decode(string) -> nil");
    checkEq(Tiff.PageCount(nil), 0,                              "PageCount(nil) -> 0");
    check(!Tiff.IsTiff(Buffer.FromString("\x89PNG\r\n\x1a\nxxxxxxxx")), "IsTiff(PNG signature) -> false");
    check(Tiff.Info(nil) == nil,                                 "Info(nil) -> nil");

    let px = mkImage(16, 16, 2);
    let good = Tiff.Encode(px, 16, 16, nil);
    check(Tiff.Decode(Buffer.Slice(good, 0, 7)) == nil,          "truncated header -> nil");
    check(Tiff.Decode(Buffer.Slice(good, 0, 40)) == nil,         "truncated IFD -> nil");
    check(Tiff.Decode(Buffer.Slice(good, 0, len(good) - 100)) == nil, "truncated strip data -> nil");

    // Damage inside the compressed data must fail or stay consistent, never raise.
    iter (k from 0 to 8) {
        let bad = copyOf(good);
        let at = len(bad) - 1 - k * 37;
        bad[at] = (u8)(bad[at] ^ 0x5A);
        let img = Tiff.Decode(bad);
        check(img == nil || (img.Width == 16 && len(img.Pixels) == 256), "corrupt LZW byte " + str(k) + " fails or stays consistent");
    }
    let pb = Tiff.Encode(px, 16, 16, { compression: Tiff.COMPRESSION_PACKBITS });
    iter (k from 0 to 8) {
        let bad = copyOf(pb);
        let at = len(bad) - 1 - k * 41;
        bad[at] = (u8)(bad[at] ^ 0xA5);
        let img = Tiff.Decode(bad);
        check(img == nil || img.Width == 16, "corrupt PackBits byte " + str(k) + " fails or stays consistent");
    }

    // Header fields patched to values the decoder must refuse with a reason.
    let big = copyOf(good);
    Buffer.WriteU32At(big, tagValueAt(big, 256), 100000);
    check(Tiff.Decode(big) == nil, "width over MAX_DIM -> nil");
    check(String.Contains(str(Tiff.LastError()), "limit"), "LastError explains the size limit");

    let jpeg = copyOf(good);
    Buffer.WriteU16At(jpeg, tagValueAt(jpeg, 259), 7);
    check(Tiff.Decode(jpeg) == nil, "compression 7 -> nil");
    check(String.Contains(str(Tiff.LastError()), "JPEG"), "LastError names JPEG");

    let ycc = copyOf(good);
    Buffer.WriteU16At(ycc, tagValueAt(ycc, 262), 6);
    check(Tiff.Decode(ycc) == nil, "photometric YCbCr -> nil");
    check(String.Contains(str(Tiff.LastError()), "YCbCr"), "LastError names YCbCr");

    let pred3 = copyOf(good);
    Buffer.WriteU16At(pred3, tagValueAt(pred3, 317), 3);
    check(Tiff.Decode(pred3) == nil, "floating-point predictor -> nil");

    let offs = copyOf(good);
    Buffer.WriteU32At(offs, tagValueAt(offs, 273), len(offs) + 1000);
    check(Tiff.Decode(offs) == nil, "strip offset past the end -> nil");

    // An IFD chain that points back at itself must not loop forever.
    let loop = copyOf(good);
    let ifd = Buffer.ReadU32At(loop, 4);
    Buffer.WriteU32At(loop, ifd + 2 + Buffer.ReadU16At(loop, ifd) * 12, ifd);
    checkEq(Tiff.PageCount(loop), 1, "self-referencing IFD chain counts once");
    check(Tiff.Decode(loop, { page: 1 }) == nil, "page 1 of a looping chain -> nil");
    check(Tiff.Decode(loop) != nil, "page 0 of a looping chain still decodes");

    // Encoder argument checks.
    check(Tiff.Encode(nil, 8, 8) == nil,                         "Encode(nil) -> nil");
    check(Tiff.Encode(px, 0, 8) == nil,                          "Encode(zero width) -> nil");
    check(Tiff.Encode(px, 8, 0) == nil,                          "Encode(zero height) -> nil");
    check(Tiff.Encode(px, Tiff.MAX_DIM + 1, 1) == nil,           "Encode(over MAX_DIM) -> nil");
    check(Tiff.Encode(px, 4096, 4096) == nil,                    "Encode(pixels too few for w*h) -> nil");
    check(Tiff.Encode(px, 16, 16, { compression: 7 }) == nil,    "Encode(JPEG) -> nil");
    check(String.Contains(str(Tiff.LastError()), "7"),           "LastError names the compression");
    check(Tiff.Encode(px, 1.5, 16) == nil,                       "Encode(float width) -> nil");
    check(Tiff.EncodePages(nil) == nil,                          "EncodePages(nil) -> nil");
    check(Tiff.EncodePages([]) == nil,                           "EncodePages([]) -> nil");
    check(Tiff.EncodePages([42]) == nil,                         "EncodePages([not an object]) -> nil");
    return 0;
}

// ------------------------------------------------------------------
// Files
// ------------------------------------------------------------------

fn test_disk() {
    let path = Os.TempDir() + "/flaris_test_tiff_" + str(Time.Millis()) + ".tif";
    let w = 24; let h = 18;
    let px = mkImage(w, h, 3);
    check(Tiff.Save(path, px, w, h), "Save writes a file");
    let img = Tiff.Load(path);
    check(img != nil, "Load reads it back");
    if (img != nil) {
        checkEq(img.Width, w, "Load width");
        check(samePixels(img.Pixels, px, w * h), "Load pixels match");
    }
    check(Tiff.Save(path, px, w, h, { compression: Tiff.COMPRESSION_DEFLATE }), "Save with options");
    let again = Tiff.Load(path);
    check(again != nil && samePixels(again.Pixels, px, w * h), "Deflate file reads back");

    let px2 = mkImage(10, 30, 0);
    check(Tiff.SavePages(path, [{ Width: w, Height: h, Pixels: px }, { Width: 10, Height: 30, Pixels: px2 }]),
          "SavePages writes a file");
    let p1 = Tiff.Load(path, { page: 1 });
    check(p1 != nil && p1.Width == 10 && samePixels(p1.Pixels, px2, 300), "Load page 1 of a saved multi-page file");
    File.Delete(path);

    check(Tiff.Load("/tmp/definitely_missing_image.tif") == nil, "Load missing -> nil");
    check(Tiff.LastError() != nil, "Load missing sets LastError");
    check(!Tiff.Save(Path.Combine(path + "_nodir", "x.tif"), px, w, h), "Save to a missing directory -> false");
    return 0;
}

// ------------------------------------------------------------------
// Benchmarks
// ------------------------------------------------------------------

fn test_benchmarks() {
    Console.WriteLine("=== Tiff benchmarks ===");
    let w = 512; let h = 512;
    let px = mkImage(w, h, 0);
    let names = ["none    ", "LZW     ", "Deflate ", "PackBits"];
    let opts = [{ compression: Tiff.COMPRESSION_NONE }, nil,
                { compression: Tiff.COMPRESSION_DEFLATE }, { compression: Tiff.COMPRESSION_PACKBITS }];
    iter (k from 0 to 4) {
        var t = Time.Millis();
        let bytes = Tiff.Encode(px, w, h, opts[k]);
        let enc = Time.Millis() - t;
        t = Time.Millis();
        let img = Tiff.Decode(bytes);
        let dec = Time.Millis() - t;
        Console.WriteLine("  " + names[k] + " " + str(w) + "x" + str(h) + " -> " + str(len(bytes)) + " B"
                          + "   encode " + str(enc) + " ms   decode " + str(dec) + " ms");
        check(img != nil && samePixels(img.Pixels, px, w * h), "benchmark image round-trips (" + names[k] + ")");
    }
    return 0;
}

fn Main() {
    Console.WriteLine("=== Tiff tests ===");
    test_roundtrips();
    test_encoder_choices();
    test_libtiff_fixtures();
    test_unsupported();
    test_multipage();
    test_malformed();
    test_disk();
    test_benchmarks();
    Console.WriteLine("");
    Console.WriteLine("Tests run:" + str(testsRun) + "  failed:" + str(testsFailed));
    if (testsFailed > 0) { return 1; }
    Console.WriteLine("✅ All Tiff tests passed!");
    return 0;
}
