// test_ai_extra.fls
// Offline tests for AI helpers that do NOT need an Ollama server: the tool
// (function-calling) definition builders, the image base64 helper, the request
// payload and the reply timeout.
// The live tool-calling loop (AI.RunTools) and Vision are exercised by
// test_ai.fls when a capable model is available.
//
//   flarisvm ./tests/test_ai_extra.fls --libs='./libs'

import { AI } from library("AI", "1.0");

global testsRun    = 0;
global testsFailed = 0;

fn check(cond, msg) {
    testsRun += 1;
    if (!cond) { testsFailed += 1; Console.WriteLine("FAIL: ", msg); }
}
fn checkEq(actual, expected, msg) {
    testsRun += 1;
    if (actual != expected) {
        testsFailed += 1;
        Console.WriteLine("FAIL: ", msg, " expected=", expected, " got=", actual);
    }
}

fn test_tool_builder() {
    Console.WriteLine("-- AI.Tool");

    let params = {
        type: "object",
        properties: { city: { type: "string", description: "City name" } },
        required: ["city"]
    };
    let tool = AI.Tool("get_weather", "Get weather for a city", params);

    checkEq(tool.type, "function", "tool type");
    checkEq(tool.function.name, "get_weather", "tool function name");
    checkEq(tool.function.description, "Get weather for a city", "tool description");
    checkEq(tool.function.parameters.required[0], "city", "tool parameters carried through");

    // Round-trips through JSON (this is how it is sent to Ollama).
    let json = Json.Stringify(tool);
    check(String.Contains(json, "\"name\":\"get_weather\""), "tool serialises name");
    check(String.Contains(json, "\"type\":\"function\""), "tool serialises type");
}

fn test_tool_result() {
    Console.WriteLine("-- AI.ToolResult");

    let r = AI.ToolResult("get_weather", "sunny, 21C");
    checkEq(r.role, "tool", "tool result role");
    checkEq(r.tool_name, "get_weather", "tool result name");
    checkEq(r.content, "sunny, 21C", "tool result content");

    // Non-string content is stringified.
    let r2 = AI.ToolResult("calc", 42);
    checkEq(r2.content, "42", "non-string content stringified");
}

fn test_image_file() {
    Console.WriteLine("-- AI.ImageFile");

    let path = "/tmp/flaris_ai_img_test.bin";
    File.WriteText(path, "hi");                  // 2 bytes
    let b64 = AI.ImageFile(path);
    checkEq(b64, "aGk=", "ImageFile base64-encodes file bytes");

    checkEq(AI.ImageFile("/tmp/no_such_file_xyz.bin"), nil, "missing file -> nil");

    File.Delete(path);
}

fn test_model_options() {
    Console.WriteLine("-- model options");

    let c = AI.Client("http://127.0.0.1:1");
    let p = c._chatPayload("m", [], false,
        { temperature: 0.0, seed: 7, top_p: 0.9, num_ctx: 32768, think: true, timeoutMs: 5 });
    checkEq(p.options.temperature, 0.0, "temperature");
    checkEq(p.options.seed, 7, "seed together with temperature and top_p");
    checkEq(p.options.top_p, 0.9, "top_p together with temperature and seed");
    checkEq(p.options.num_ctx, 32768, "num_ctx reaches options");
    checkEq(p.think, true, "think stays top-level");
    check(!("think" in p.options), "think is not a model option");
    check(!("timeoutMs" in p.options), "timeoutMs is not sent to Ollama");

    let g = c._genPayload("m", "hi", false, { num_predict: 64, stop: ["\n\n"] });
    checkEq(g.options.num_predict, 64, "generate: num_predict");
    checkEq(g.options.stop[0], "\n\n", "generate: stop");

    check(!("options" in c._chatPayload("m", [], false, { think: false })),
          "no model option -> no options object");
}

// A server that never answers: the per-call timeoutMs ends the request.
fn test_reply_timeout() {
    Console.WriteLine("-- reply timeout");

    // Where the client connects: a dual-stack port 0 can be one held on 127.0.0.1 alone.
    let srv = Stream.Listen("tcp", 0, 128, "127.0.0.1");
    let a: string = Stream.LocalAddr(srv);
    let port = Convert.ParseInt(String.Substr(a, String.LastIndexOf(a, ":") + 1, 10));
    let c = AI.Client("http://127.0.0.1:" + Convert.ToString(port));

    let t0 = Time.Ticks();
    let reply = c.Chat("m", [{ role: "user", content: "hi" }], { timeoutMs: 300 });
    let ms = Time.TicksToMs(Time.Ticks() - t0);
    checkEq(reply, nil, "no answer -> nil");
    check(ms < 5000, "timeoutMs ended the wait");
    Stream.Close(srv);
}

// A server that answers once with `reply`, then hangs up.
fn oneShotServer(reply: string): int {
    let srv = Stream.Listen("tcp", 0, 16, "127.0.0.1");
    let a: string = Stream.LocalAddr(srv);
    Fiber.Run(fn() {
        if (Stream.WaitReadable(srv, 3000) != nil) {
            let c = Stream.Accept(srv);
            Stream.WaitReadable(c, 2000);
            Stream.ReadBytes(c, 65536);
            Stream.WriteAll(c, reply);
            Fiber.Sleep(50);
            Stream.Close(c);
        }
        Stream.Close(srv);
    });
    return Convert.ParseInt(String.Substr(a, String.LastIndexOf(a, ":") + 1, 10)) ?? 0;
}

fn test_streams_and_system() {
    Console.WriteLine("-- streams, System()");
    // An Ollama error line ends the stream with that error, not nil tokens.
    let body = "{\"error\":\"model 'nope' not found\"}\n";
    let port = oneShotServer("HTTP/1.1 404 Not Found\r\nContent-Type: application/x-ndjson\r\nContent-Length: "
                             + str(len(body)) + "\r\nConnection: close\r\n\r\n" + body);
    let c = AI.Client("http://127.0.0.1:" + str(port));
    let tokens = [];
    let r = c.ChatStream("nope", [{ role: "user", content: "hi" }], fn(t) { Array.Append(tokens, t); }, { timeoutMs: 2000 });
    check(r != nil && !r.ok && String.Contains(str(r.error), "not found"), "an error line is reported as the error");
    checkEq(len(tokens), 0, "... and no nil token reaches the callback");

    // timeoutMs bounds a stream that never answers.
    let silent = Stream.Listen("tcp", 0, 16, "127.0.0.1");
    let sa: string = Stream.LocalAddr(silent);
    let sc = AI.Client("http://127.0.0.1:" + String.Substr(sa, String.LastIndexOf(sa, ":") + 1, 10));
    let t0 = Time.Millis();
    sc.GenerateStream("m", "hi", fn(_t) { return 0; }, { timeoutMs: 300 });
    check(Time.Millis() - t0 < 5000, "timeoutMs ends a silent stream");
    Stream.Close(silent);

    // System() after other messages still goes first.
    let conv = AI.Conversation("m");
    conv._messages = [{ role: "user", content: "earlier" }];
    conv.System("be brief");
    checkEq(conv._messages[0].role, "system", "System() prepends");
}

fn test_benchmarks() {
    Console.WriteLine("=== AI helper benchmarks ===");
    let iters = 20000;

    let t0 = Time.Ticks();
    iter (i from 0 to iters) {
        let _t = AI.Tool("f", "d", { type: "object", properties: { x: { type: "number" } } });
    }
    Console.WriteLine("AI.Tool build (", iters, " iters): ",
                      String.FormatArray("{0:.2f}", [Time.TicksToMs(Time.Ticks() - t0)]), " ms");
    Console.WriteLine("=== benchmarks done ===");
}

fn Main() {
    Console.WriteLine("=== AI extra (offline) test suite ===");

    test_tool_builder();
    test_tool_result();
    test_image_file();
    test_model_options();
    test_reply_timeout();
    test_streams_and_system();
    test_benchmarks();

    Console.WriteLine("Tests run:", testsRun, " failed:", testsFailed);
    if (testsFailed == 0) {
        Console.WriteLine("✅ All AI extra tests passed!");
    } else {
        Console.WriteLine("❌ Some AI extra tests failed");
    }
}
